%description:
Observe TXOP admission between non-HT peers with Basic Block Ack.
This diagnostic records invalid exchanges. It does not change a production decision.
All runs use positive 1024-microsecond TXOPs without aggregation.

%file: Probe.cc
#include <iostream>
#include <map>
#include <tuple>
#include "inet/common/Simsignals.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211DataSequenceTag_m.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreement.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

namespace inet::ieee80211 {
class ProbeHcf : public Hcf {
    struct Scope {
        simtime_t start;
        simtime_t bound;
        int count;
        bool agreement;
        bool aggregate;
        bool retry;
        bool exception;
        simtime_t exchangeStart;
    };
    std::map<int64_t, Scope> scopes;
    std::map<std::tuple<MacAddress, int, int, int>, b> lengths;
    std::map<int64_t, simtime_t> protectedStarts;
    simtime_t start = -1;
    int count = 0;
    const char *node() const { return getParentModule()->getParentModule()->getParentModule()->getFullName(); }
    void observe(Packet *packet, const char *boundary) {
        auto tag = packet->findTag<Ieee80211DataSequenceTag>();
        if (!tag)
            return;
        auto entry = scopes.find(tag->getAllocationIndex());
        if (entry == scopes.end())
            return;
        const auto& scope = entry->second;
        if (simTime() <= scope.bound || scope.exception)
            return;
        invalid++;
        std::cout << "INVALID boundary=" << boundary << " node=" << node()
            << " allocation=" << tag->getAllocationIndex()
            << " time=" << simTime() << " txopStart=" << scope.start << " bound=" << scope.bound
            << " excess=" << simTime() - scope.bound << " count=" << scope.count
            << " agreement=" << scope.agreement << " aggregate=" << scope.aggregate
            << " retry=" << scope.retry << "\n";
        std::cout << "EXCHANGE node=" << node() << " allocation=" << tag->getAllocationIndex()
            << " firstHolderStart=" << scope.exchangeStart << " boundary=" << boundary
            << " costThroughBoundary=" << simTime() - scope.exchangeStart << "\n";
    }
  public:
    int invalid = 0;
    int agreedData = 0;
    int outsideData = 0;
    int aggregates = 0;
  protected:
    bool transmitFrame(Packet *packet, simtime_t ifs) override {
        bool accepted = Hcf::transmitFrame(packet, ifs);
        if (!accepted)
            return false;
        auto header = packet->peekAtFront<Ieee80211MacHeader>();
        auto owner = edca->getChannelOwner();
        if (!owner)
            return true;
        auto txop = owner->getTxopProcedure();
        if (header->getType() == ST_RTS) {
            auto context = frameSequenceHandler->getContext();
            auto rts = check_and_cast<RtsTransmitStep *>(context->getLastStep());
            protectedStarts[rts->getProtectedFrame()->getId()] = simTime() + ifs;
        }
        if (txop->getStart() != start) {
            start = txop->getStart();
            count = 0;
        }
        if (dynamicPtrCast<const Ieee80211DataOrMgmtHeader>(header))
            count++;
        if (auto data = dynamicPtrCast<const Ieee80211DataHeader>(header)) {
            auto agreement = originatorBlockAckAgreementHandler ?
                originatorBlockAckAgreementHandler->getAgreement(data->getReceiverAddress(), data->getTid()) : nullptr;
            bool agreed = agreement && agreement->getIsAddbaResponseReceived();
            auto key = std::make_tuple(data->getReceiverAddress(), int(data->getTid()),
                data->getSequenceNumber().get(), int(data->getFragmentNumber()));
            auto prior = lengths.find(key);
            bool sameSizeRetry = data->getRetry() && prior != lengths.end() && prior->second == packet->getDataLength();
            lengths.insert_or_assign(key, packet->getDataLength());
            bool exception = count == 1 && ((agreed && !data->getAMsduPresent() && !data->getRetry()) || sameSizeRetry);
            scopes.insert_or_assign(packet->getTag<Ieee80211DataSequenceTag>()->getAllocationIndex(), Scope{start, start + txop->getLimit(), count,
                agreed, data->getAMsduPresent(), data->getRetry(), exception,
                protectedStarts.count(packet->getId()) ? protectedStarts.at(packet->getId()) : simTime() + ifs});
            agreedData += agreed;
            outsideData += !agreed;
            aggregates += data->getAMsduPresent();
            auto mode = packet->getTag<physicallayer::Ieee80211ModeReq>()->getMode();
            std::cout << "DATA node=" << node() << " decision=" << simTime() << " ifs=" << ifs
                << " allocation=" << packet->getTag<Ieee80211DataSequenceTag>()->getAllocationIndex()
                << " bitrate=" << mode->getDataMode()->getNetBitrate()
                << " airtime=" << mode->getDuration(packet->getDataLength()) << " bytes=" << packet->getByteLength()
                << " txopStart=" << start << " bound=" << start + txop->getLimit()
                << " count=" << count << " agreement=" << agreed << " aggregate=" << data->getAMsduPresent()
                << " retry=" << data->getRetry() << " exception=" << exception
                << " ackPolicy=" << int(data->getAckPolicy()) << "\n";
        }
        return true;
    }
    void transmissionComplete(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override {
        if (dynamicPtrCast<const Ieee80211DataHeader>(header))
            observe(packet, "DATA-complete");
        Hcf::transmissionComplete(packet, header);
    }
    void originatorProcessReceivedFrame(Packet *packet, Packet *transmitted) override {
        if (packet->peekAtFront<Ieee80211MacHeader>()->getType() == ST_ACK)
            observe(transmitted, "ACK-complete");
        Hcf::originatorProcessReceivedFrame(packet, transmitted);
    }
};
Define_Module(ProbeHcf);

class ProbeTest : public cSimpleModule, public cListener {
    int received = 0;
  protected:
    void initialize() override { scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("subscribe")); }
    void receiveSignal(cComponent *, simsignal_t, cObject *, cObject *) override { received++; }
    void handleMessage(cMessage *message) override {
        if (message->isName("subscribe")) {
            delete message;
            getModuleByPath("^.sta2.app[0]")->subscribe(packetReceivedSignal, this);
            scheduleAt(SimTime(1200, SIMTIME_MS), new cMessage("verify"));
            return;
        }
        delete message;
        for (const char *path : {"^.sta1.wlan[0].mac.hcf", "^.ap.wlan[0].mac.hcf"}) {
            auto hcf = check_and_cast<ProbeHcf *>(getModuleByPath(path));
            std::cout << "SUMMARY node=" << path << " invalidBoundaries=" << hcf->invalid
                << " agreedData=" << hcf->agreedData << " outsideData=" << hcf->outsideData
                << " aggregates=" << hcf->aggregates << " delivered=" << received << "\n";
        }
        endSimulation();
    }
};
Define_Module(ProbeTest);
}

%file: test.ned
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.inet.WirelessHost;
import inet.node.wireless.AccessPoint;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
module ProbeHcf extends Hcf { parameters: @class(::inet::ieee80211::ProbeHcf); }
simple ProbeTest { parameters: @class(::inet::ieee80211::ProbeTest); }
network ProbeNetwork {
    submodules:
        configurator: Ipv4NetworkConfigurator;
        radioMedium: Ieee80211ScalarRadioMedium;
        ap: AccessPoint;
        sta1: WirelessHost;
        sta2: WirelessHost;
        test: ProbeTest;
}

%inifile: omnetpp.ini
[General]
network = ProbeNetwork
sim-time-limit = 1.3s
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.radioMedium.propagation.typename = "ConstantTimePropagation"
*.radioMedium.propagation.propagationTime = 0s
*.radioMedium.sameTransmissionStartTimeCheck = "ignore"
*.sta1.numApps = 1
*.sta1.app[0].typename = "UdpBasicApp"
*.sta1.app[0].destAddresses = "sta2"
*.sta1.app[0].destPort = 1000
*.sta1.app[0].messageLength = 700B
*.sta1.app[0].startTime = 1s
*.sta1.app[0].stopTime = 1.00295s
*.sta1.app[0].sendInterval = 100us
*.sta2.numApps = 1
*.sta2.app[0].typename = "UdpSink"
*.sta2.app[0].localPort = 1000
*.sta*.ipv4.arp.typename = "GlobalArp"
**.wlan[*].opMode = "g(erp)"
**.wlan[*].bitrate = ${rate=6,24}Mbps
**.bandName = "2.4 GHz"
**.wlan[*].radio.antenna.numAntennas = 2
**.wlan[*].classifier.typename = "QosClassifier"
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "ProbeHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = true
**.wlan[*].mac.hcf.blockAckVariant = "basic"
**.originatorAckPolicy.blockAckReqThreshold = 5
**.originatorAckPolicy.maxBlockAckPolicyFrameLength = 10000B
**.originatorMacDataService.msduAggregationPolicy.typename = ""
**.originatorMacDataService.mpduAggregationPolicy.typename = ""
**.originatorMacDataService.msduAggregationPolicy.subframeNumThreshold = 2
**.originatorMacDataService.msduAggregationPolicy.maxAMsduSize = 1600
**.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 2346B
**.rtsPolicy.rtsThreshold = 500B
**.txopProcedure.protectionMechanism = ${protection="single","multiple"}
**.txopProcedure.txopLimit = 1024us
**.wlan[*].radio.receiver.energyDetection = -105dBm
**.wlan[*].radio.receiver.sensitivity = -105dBm
**.wlan[*].radio.receiver.snirThreshold = 0dB
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.sta1.mobility.initialX = 0m
*.ap.mobility.initialX = 5m
*.sta2.mobility.initialX = 10m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m
