digraph g {
  newrank=true; rankdir="TB"; nodesep=0.3; ranksep=0.25
  node [shape=box, fontsize=10, fontname="Helvetica"]
  edge [fontsize=9, fontname="Helvetica"]

  cf [label="coordination function (Dcf, Hcf)", style=bold]

  // every band is a 2 x 2 grid; p1..p4 are invisible placeholders that keep the grid regular
  node [style=invis, label="", width=1.2, height=0.5]
  p1; p2
  node [style=solid, label="\N", width=0.75, height=0.5]

  subgraph cluster_access {
    label="access"; fontsize=10; fontname="Helvetica"; style=dashed
    ca [label="channel access\n(Dcaf, Edcaf)"]; contention [label="contention"]
    txop [label="TXOP procedure"]; p1
  }
  subgraph cluster_exchange {
    label="exchange"; fontsize=10; fontname="Helvetica"; style=dashed
    handler [label="frame sequence\nhandler"]; sequence [label="frame sequence\n(DcfFs, HcfFs)"]
    procedures [label="control frame\nprocedures"]; p2
  }
  subgraph cluster_transform {
    label="transformation"; fontsize=10; fontname="Helvetica"; style=dashed
    inprogress [label="in-progress\nframes"]; dataservice [label="originator\ndata service"]
    recipient [label="recipient\ndata service"]; queue [label="pending queue"]
  }
  subgraph cluster_reliability {
    label="reliability"; fontsize=10; fontname="Helvetica"; style=dashed
    ackhandler [label="ack handler"]; policies [label="policies"]
    recovery [label="recovery\nprocedure"]; agreements [label="block ack\nagreements"]
  }
  subgraph cluster_rate {
    label="rate and protection"; fontsize=10; fontname="Helvetica"; style=dashed
    rate [label="rate selection,\nrate control"]; protection [label="protection\nmechanism"]
  }

  { rank=same; ca; contention }        { rank=same; txop; p1 }
  { rank=same; handler; sequence }     { rank=same; procedures; p2 }
  { rank=same; inprogress; dataservice } { rank=same; recipient; queue }
  { rank=same; ackhandler; policies }  { rank=same; recovery; agreements }
  { rank=same; rate; protection }

  // column chains (invisible) keep the bands aligned
  edge [style=invis, weight=50]
  ca -> txop -> handler -> procedures -> inprogress -> recipient -> ackhandler -> recovery -> rate
  contention -> p1 -> sequence -> p2 -> dataservice -> queue -> policies -> agreements -> protection
  edge [style=solid, weight=1]

  cf -> ca [label="request, granted", dir=both]
  cf -> handler [label="start, step events", dir=both]
  ca -> contention [label="start, granted", dir=both, constraint=false]
  handler -> sequence [label="next step", constraint=false]
  sequence -> inprogress [label="frame to transmit"]
  inprogress -> dataservice [label="extract", constraint=false]
  dataservice -> queue [label="dequeue"]
  inprogress -> ackhandler [label="eligible?"]
  sequence -> policies [label="RTS? ack policy?"]
  procedures -> policies [label="CTS? ACK?"]
}
