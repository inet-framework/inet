        </chart>
        <chart id="7" type="MATPLOTLIB" name="Movement detection versus router advertisement interval" template="linechart_mpl" icon="icons/full/obj/linechart.png">
            <script>
<![CDATA[# The handover outage against the foreign router's advertisement interval.
#
# Three configurations differ in one parameter pair and in nothing else:
#   MobilityTunedRouterAdvertisements  0.3 s - 0.7 s   a rate only a router serving
#                                                      mobile nodes may use
#   FrequentRouterAdvertisements       3 s   - 7 s     ordinary IPv6, as fast as the
#                                                      neighbour-discovery standard allows
#   Tunnelled                          200 s - 600 s   the deployed default
#
# The outage is the largest gap in pingRxSeq:vector at cnRouteOptimized.app[0]. The bar
# is the median of the five seed sets and the whisker is the min-to-max range.
#
# The three points are drawn at equal spacing, NOT on a numeric interval axis: only
# three intervals were measured and a continuous axis would invite the reader to read
# values between them that were never run.

import numpy as np
import matplotlib.pyplot as plt
from omnetpp.scave import results, chart, utils

props = chart.get_properties()
utils.preconfigure_plot(props)

df = results.get_vectors(props["filter"], include_attrs=True, include_runattrs=True)
if df.empty:
    raise chart.ChartScriptError("The result filter returned no data.")

POINTS = [("MobilityTunedRouterAdvertisements", "0.3 - 0.7 s\nmobility-tuned"),
          ("FrequentRouterAdvertisements", "3 - 7 s\nordinary IPv6,\nas fast as it may go"),
          ("Tunnelled", "200 - 600 s\nthe deployed default")]

med, lo, hi, labels = [], [], [], []
for configname, label in POINTS:
    gaps = []
    for _, row in df[df["configname"] == configname].iterrows():
        t = np.asarray(row["vectime"], dtype=float)
        gaps.append(float(np.max(np.diff(t))))
    if not gaps:
        raise chart.ChartScriptError("No data for configuration '%s'." % configname)
    labels.append(label)
    med.append(float(np.median(gaps))); lo.append(min(gaps)); hi.append(max(gaps))

x = np.arange(len(med))
colors = [props.get("color_other") or "#1f77b4",
          props.get("color_worst") or "#d62728",
          props.get("color_other") or "#1f77b4"]
ax = plt.gca()
ax.bar(x, med, width=0.5, color=colors, zorder=3)
ax.errorbar(x, med, yerr=[np.array(med) - np.array(lo), np.array(hi) - np.array(med)],
            fmt="none", ecolor="0.25", elinewidth=1.4, capsize=8, capthick=1.4, zorder=4)
for xi, m, l, h in zip(x, med, lo, hi):
    ax.text(xi, h + 0.12, "median %.3f s" % m, ha="center", va="bottom",
            fontsize=9, fontweight="bold", zorder=5)
    ax.text(xi, m / 2.0, "%.3f - %.3f s\nover five seed sets" % (l, h),
            ha="center", va="center", fontsize=8, color="white", zorder=5)

utils.set_plot_title(props["title"])
utils.postconfigure_plot(props)
ax.set_xticks(x)
ax.set_xticklabels(labels)
if props.get("xaxis_title"):
    ax.set_xlabel(props["xaxis_title"])
if props.get("yaxis_title"):
    ax.set_ylabel(props["yaxis_title"])
ax.grid(False)
ax.grid(True, axis="y", zorder=0)
utils.export_image_if_needed(props)
]]>                

            </script>
            <dialogPage id="INPUT" label="Input">
<![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xswt xmlns:x="http://sweet_swt.sf.net/xswt">
  <import xmlns="http://sweet_swt.sf.net/xswt">
    <package name="java.lang" />
    <package name="org.eclipse.swt.widgets" />
    <package name="org.eclipse.swt.graphics" />
    <package name="org.eclipse.swt.layout" />
    <package name="org.eclipse.swt.custom" />
  </import>
  <layout x:class="GridLayout" numColumns="1" />
  <x:children>
    <label text="Filter expression:" />
    <styledText x:id="filter" x:style="BORDER|V_SCROLL|H_SCROLL" x:id.contentAssist="filter" x:id.resultType="vector">
      <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="true" />
    </styledText>

    <composite>
      <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" />
      <layout x:class="GridLayout" numColumns="2" makeColumnsEqualWidth="false" marginWidth="0" />
      <x:children>
        <button x:id="omit_empty_vectors" x:style="CHECK" x:id.default="false" text="Omit empty vectors">
          <layoutData x:class="GridData" horizontalAlignment="BEGINNING" verticalAlignment="BEGINNING" />
        </button>
        <button x:id="simplify" x:style="PUSH" text="Simplify" x:id.role="simplify" x:id.targetControl="filter">
          <layoutData x:class="GridData" horizontalAlignment="END" grabExcessHorizontalSpace="true"/>
        </button>
      </x:children>
    </composite>
    <composite>
      <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" />
      <layout x:class="GridLayout" numColumns="2" makeColumnsEqualWidth="false" />
      <x:children>
        <group text="Crop interval">
          <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="false" verticalAlignment="FILL" grabExcessVerticalSpace="true" />
          <layout x:class="GridLayout" numColumns="2" />
          <x:children>
            <label text="Start time (sec):" />
            <text x:id="vector_start_time" x:style="BORDER">
              <layoutData x:class="GridData" widthHint="180" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="false" />
            </text>
            <label text="End time (sec):" />
            <text x:id="vector_end_time" x:style="BORDER">
              <layoutData x:class="GridData" widthHint="180" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="false" />
            </text>
          </x:children>
        </group>
        <group text="Vector operations (one per line)">
          <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="true" />
          <layout x:class="GridLayout" numColumns="1" />
          <x:children>
            <text x:id="vector_operations" x:style="BORDER|MULTI|V_SCROLL|H_SCROLL" x:id.contentAssist="vectorops">
              <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="true" />
            </text>
          </x:children>
        </group>
      </x:children>
    </composite>
  </x:children>
</xswt>
]]>                

