            <property name="image_export_width" value="8"/>
            <property name="image_export_height" value="6"/>
            <property name="data_export_filename" value=""/>
        
            <property name="end_time" value="45"/>
            <property name="label_off" value="Mobile IPv6 off"/>
            <property name="label_on" value="Mobile IPv6 on"/>
            <property name="color_off" value="#d62728"/>
            <property name="color_on" value="#1f77b4"/>
        </chart>
        <chart id="3" type="MATPLOTLIB" name="Handover budget" template="barchart_mpl" icon="icons/full/obj/barchart.png">
            <script>
<![CDATA[# Where the handover time goes: the five terms of one representative handover,
# grouped in three by which layer is responsible.
#
# PROVENANCE. These five durations are consecutive intervals of ONE run and they sum
# exactly to that run's measured outage, with no residual. They are read from the event
# banners of the run below, not from a recorded statistic -- Mobile IPv6 records no
# measurement statistics, so there is nothing in the .sca/.vec files to plot here.
#
#   config Tunnelled, run 0 (seed set 1), the MEDIAN seed of the five (gap 4.010048 s)
#   opp_run -u Cmdenv -c Tunnelled -r 0 --cmdenv-express-mode=false
#           --cmdenv-event-banners=true --cmdenv-log-level=info
#
#   28.910419451735  last echo reply before the outage
#   29.257119314267  Ieee80211Prim_ScanRequest  at mn.wlan[0].mgmt
#   29.908202919212  AssocResp-OK               at mn.wlan[0].mgmt
#   30.304007237774  RouterAdvertisement        at mn.ipv6.neighbourDiscovery
#   31.813121475276  dadTimeout + sendPeriodicBU
#   32.920467334000  first echo reply after the outage
#
# To re-derive after any change, take those six instants and difference them.

import numpy as np
import matplotlib.pyplot as plt
from omnetpp.scave import chart, utils

props = chart.get_properties()
utils.preconfigure_plot(props)

TERMS = [
    ("IEEE 802.11 link layer", [
        ("the mobile node notices the\nold access point is gone", 0.346700),
        ("scan, authenticate, associate\nwith the new access point", 0.651084)]),
    ("IPv6 neighbour discovery and address autoconfiguration", [
        ("router discovery - the new link's router\nmay not repeat its advertisement yet", 0.395804),
        ("address configuration - the duplicate-address\ncheck runs on the link-local address", 1.509114)]),
    ("Mobile IPv6 home registration", [
        ("binding update, the home agent's\ncheck, binding acknowledgement", 1.107346)]),
]

group_colors = [props.get("color_l2") or "#7f7f7f",
                props.get("color_nd") or "#1f77b4",
                props.get("color_mip") or "#d62728"]
total = sum(d for _, terms in TERMS for _, d in terms)

ax = plt.gca()
left = 0.0
for gi, (gname, terms) in enumerate(TERMS):
    gdur = sum(d for _, d in terms)
    gstart = left
    for ti, (tname, d) in enumerate(terms):
        ax.barh([0], [d], left=[left], height=0.42,
                color=group_colors[gi], edgecolor="white", linewidth=1.6,
                alpha=1.0 if ti == 0 else 0.55, zorder=3)
        ax.text(left + d / 2.0, 0.235, "%.3f s" % d, ha="center", va="bottom",
                fontsize=9, zorder=5)
        ax.annotate(tname, xy=(left + d / 2.0, -0.21),
                    xytext=(left + d / 2.0, -0.40 - 0.30 * (ti % 2)),
                    ha="center", va="top", fontsize=7.5, color="0.15",
                    arrowprops=dict(arrowstyle="-", lw=0.7, color="0.55"), zorder=5)
        left += d
    ax.plot([gstart + 0.02, left - 0.02], [0.40, 0.40], color=group_colors[gi],
            lw=2.5, solid_capstyle="butt", zorder=5)
    ax.text((gstart + left) / 2.0, 0.45,
            "%s\n%.3f s  (%.1f %%)" % (gname, gdur, 100.0 * gdur / total),
            ha="center", va="bottom", fontsize=9, fontweight="bold",
            color=group_colors[gi], zorder=5)

utils.set_plot_title(props["title"])
utils.postconfigure_plot(props)
ax.set_yticks([])
ax.set_ylim(-1.30, 1.00)
ax.set_xlim(0, total)
if props.get("xaxis_title"):
    ax.set_xlabel(props["xaxis_title"])
ax.grid(False)
ax.grid(True, axis="x", zorder=0)
utils.export_image_if_needed(props)
]]>                

            </script>
            <dialogPage id="INPUT" label="Input">
<![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xswt xmlns:x="http://sweet_swt.sf.net/xswt">
  <import xmlns="http://sweet_swt.sf.net/xswt">
    <package name="java.lang" />
    <package name="org.eclipse.swt.widgets" />
    <package name="org.eclipse.swt.graphics" />
    <package name="org.eclipse.swt.layout" />
    <package name="org.eclipse.swt.custom" />
  </import>
  <layout x:class="GridLayout" numColumns="2" />
  <x:children>
    <label text="Filter expression:" >
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

    <styledText x:id="filter" x:style="BORDER|V_SCROLL|H_SCROLL" x:id.contentAssist="filter" x:id.resultType="scalar">
      <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="true" />
    </styledText>
    
    <button x:id="include_fields" x:style="CHECK" text="Include fields">
      <layoutData x:class="GridData" horizontalAlignment="END" />
    </button>
    
    <button x:id="simplify" x:style="PUSH" text="Simplify" x:id.role="simplify" x:id.targetControl="filter">
      <layoutData x:class="GridData" horizontalAlignment="END" />
    </button>

    <label text="Multiple attributes can be selected in both fields below, separated by commas.">
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

    <label text="Groups:"/>
    <combo x:id="groups" x:style="BORDER" x:id.content="module,name,experiment,module+name,$itervarnames,$runattrnames">
        <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </combo>

    <label text="Series:"/>
    <combo x:id="series" x:style="BORDER" x:id.content="module,name,experiment,module+name,$itervarnames,$runattrnames">
        <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </combo>

    <label text="Scalar values will be averaged across all attributes not selected above.">
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

  </x:children>
</xswt>
]]>                

