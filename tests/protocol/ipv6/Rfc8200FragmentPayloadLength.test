%description:

RFC 8200 — every fragment packet carries the payload length of that fragment packet, not of
the original packet.

Checks the payload-length halves of RFC8200-FRAG-4 and RFC8200-FRAG-5 (description) and
RFC8200-HDR-2 for a fragment, from doc/project/evidence/standard/rfc8200/catalog.md. The
English procedure is in doc/project/evidence/protocol/ipv6/checks/fragmentation.md#fragment-payload-length;
the program steps below map one to one onto its expected observations. Host A's interface
to link 1 has MTU 1280; the 1500-octet packet splits into pieces of 1232 and 228 octets, so
the fragment packets have payload lengths 1240 and 236. Mapping of the mockup: host A =
hostA, router R = router, host B = hostB.

Defect. This test FAILS and the failure is NOT declared expected, because the model claims the
behaviour: Ipv6::fragmentAndSend builds every fragment and sets its header, and the payload length
it writes is the one it copied rather than the one the fragment carries. A field the code sets to a
wrong value is a defect.

What the run shows: The model copies the original header into every fragment and never
rewrites its payload length (Ipv6::fragmentAndSend), so both fragments carry 1460, and
expected observation 2 misses its deadline. The destination still reassembles the packet,
because the model's reassembly measures the fragment rather than reading the field; see
doc/project/evidence/model/ipv6/results.md.

Deviations: one event can be examined by one step only, so the payload length of the first
fragment is recorded by a typed capture at observation 1 and asserted together with the
payload length of the last fragment at observation 2. Both payload lengths are read from the
base header by a typed reader, because on a fragment the generic "ipv6.payloadLength" field
lookup can land on the fragment header, which has no such field.

%includes:
#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc8200_fragment_payload_length")
        // Expected observation 1: the first fragment on link 1 (offset 0, M = 1, the UDP header to
        // port 5000 inside) -- the stimulus. Record its identification and its payload length.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("ipv6.protocolId == 44 && Ipv6FragmentHeader.fragmentOffset == 0 && Ipv6FragmentHeader.moreFragments == true")
                  .match([](const MatchContext& c) { return udpDestinationPortInFragment(c.event.packet) == 5000; })
                  .capture("id", "Ipv6FragmentHeader.identification")
                  .capture("pl1", [](const PacketEvent& e) { return (intval_t)ipv6PayloadLength(e.packet); })
                  .describe("the first fragment on link 1")
                  .within(6.0))
        // Expected observation 2: the last fragment carries payload length 236, and the first
        // carried 1240 (RFC8200-FRAG-4, FRAG-5, HDR-2).
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("Ipv6FragmentHeader.identification == {id} && Ipv6FragmentHeader.moreFragments == false")
                  .match([](const MatchContext& c) { return ipv6PayloadLength(c.event.packet) == 236 && c.get("pl1").intValue() == 1240; })
                  .describe("the last fragment on link 1 with payload length 236, after a first fragment with payload length 1240")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc8200_fragment_payload_length compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;

// The common mockup of doc/project/evidence/protocol/ipv6/checks.md: hostA -- router -- hostB, IPv6 only.
network Rfc8200Net
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=250,100"); }
        router: Router6 { @display("p=400,100"); }
        hostB: StandardHost6 { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1]
}

%inifile: omnetpp.ini

[General]
network = Rfc8200Net
sim-time-limit = 10s
seed-set = 0

# One UDP datagram from host A to host B. The applications start at 5 s, after router
# discovery, address configuration and duplicate address detection have run.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 1452B
*.hostA.app[0].timeToLive = 64
*.hostA.app[0].startTime = 5s
*.hostA.app[0].sendInterval = 10s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

# Host A must fragment: its interface to link 1 has the minimum IPv6 link MTU.
*.hostA.eth[0].mac.mtu = 1280B

%contains: stdout
PROTOCOLTEST rfc8200_fragment_payload_length: PASS
