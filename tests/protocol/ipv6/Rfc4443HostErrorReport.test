%description:

RFC 4443 — a host reports a datagram to a closed port with Destination Unreachable code 4,
from the address the datagram was sent to, to the source, quoting the whole datagram.

Checks RFC4443-DU-4 (should), RFC4443-ERR-1 (must), RFC4443-ERR-2 (description) and
RFC4443-SRC-1 (must) from doc/project/evidence/standard/rfc4443/catalog.md. The English procedure is in
doc/project/evidence/protocol/ipv6/checks/error-report.md#host-error-report; the program steps below map one
to one onto its expected observations. Mapping of the mockup: host A = hostA, router R =
router, host B = hostB.

%includes:
#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4443_host_error_report")
        // Expected observation 1: the datagram to the closed port 5001 on link 1; record the addresses.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5001")
                  .capture("src", [](const PacketEvent& e) { return ipv6Address(e.packet, "ipv6.srcAddress"); })
                  .capture("dst", [](const PacketEvent& e) { return ipv6Address(e.packet, "ipv6.destAddress"); })
                  .describe("the datagram to the closed port 5001 on link 1")
                  .within(6.0))
        // Expected observation 2: host B's UDP finds no program for port 5001.
        .once(on("hostB.udp").signal("packetDropped")
                  .match([](const MatchContext& c) { return udpDestinationPort(c.event.packet) == 5001; })
                  .describe("host B's UDP discards the datagram for want of a port")
                  .within(0.5))
        // Expected observation 3: host A receives Destination Unreachable type 1 code 4, from the
        // datagram's destination, to the datagram's source, quoting the whole datagram
        // (RFC4443-DU-4, SRC-1, ERR-2, ERR-1).
        .once(on("hostA.eth[0].mac").signal("packetReceivedFromLower")
                  .packet("icmpv6.type == 1 && Icmpv6DestUnreachableMsg.code == 4 && ipv6.payloadLength == 156B")
                  .match([](const MatchContext& c) {
                      return ipv6Address(c.event.packet, "ipv6.srcAddress") == c.get("dst").stdstringValue()
                          && ipv6Address(c.event.packet, "ipv6.destAddress") == c.get("src").stdstringValue();
                  })
                  .describe("the Destination Unreachable (port unreachable) at host A, from host B's address to host A's, with the whole datagram quoted")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4443_host_error_report compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;

// The common mockup of doc/project/evidence/protocol/ipv6/checks.md: hostA -- router -- hostB, IPv6 only.
network Rfc8200Net
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=250,100"); }
        router: Router6 { @display("p=400,100"); }
        hostB: StandardHost6 { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1]
}

%inifile: omnetpp.ini

[General]
network = Rfc8200Net
sim-time-limit = 10s
seed-set = 0

# One UDP datagram from host A to port 5001 on host B, where no program listens. The applications start at 5 s, after router
# discovery, address configuration and duplicate address detection have run.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5001
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].timeToLive = 64
*.hostA.app[0].startTime = 5s
*.hostA.app[0].sendInterval = 10s
*.hostB.numApps = 0

%contains: stdout
PROTOCOLTEST rfc4443_host_error_report: PASS
