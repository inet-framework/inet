%description:

RFC 8504 / RFC 8200 — a receiver processes an atomic fragment (offset 0, M = 0) as a fully
reassembled packet.

Checks RFC8504-NR-4, the receiver half (should), which governs RFC8200-REASM-6, from the
catalogs under doc/project/evidence/standard/. The English procedure is in
doc/project/evidence/protocol/ipv6/checks/fragmentation.md#atomic-fragment; the program steps below map one
to one onto its expected observations. Host A fragments a 1500-octet packet for its
1280-octet link; the relay clears the M flag of the first fragment, which then is a whole
datagram by the definition of RFC 8200 §4.5. Mapping of the mockup with a relay: host A =
hostA, router R = router, relay T = tap, host B = hostB.

Expected result: PASS, since 2026-09-14.

It failed until then, as a defect. `Ipv6FragBuf::addFragment` looked the buffer up before it
created it, so on a datagram that completes from one fragment it erased a stale `end()`
iterator and a C++ assertion stopped the run. The buffer keeps the iterator of the entry it
creates now.

One repair uncovered a second defect and a fault in this test.

The second defect: the reassembled packet carried the base header of the first fragment
unchanged, so its payload length described that fragment and not the datagram, and
`Ipv6::decapsulate` asserted. `Ipv6FragBuf` computes the payload length of the reassembled
datagram now. That repair also turned `Rfc8200OverlappingFragments.test` green.

The fault in this test: expected observation 2 used to filter on `udp.destPort == 5000`, and
that filter can never match here. The vehicle is the first of two fragments with its M flag
cleared, so the datagram this host reassembles is a UDP datagram whose header claims 1460
octets and whose body holds 1232. It is truncated by construction, the dissector will not
read it, and UDP discards it as a bit error, which is correct of UDP. The step therefore
could not have been decisive about the port even with the model repaired; the crash hid that.
The step reads the length of the packet handed up instead, which is what the rule is about:
the content went up as one whole packet.

See doc/project/evidence/model/ipv6/results.md.

%includes:
#include <csignal>

#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

// The model aborts on this input, through an assertion of the standard library, and the
// verdict of this test is the missing verdict line that follows. The runtime installs a
// handler for SIGABRT that prints a stack trace annotated with source lines
// (backward::SignalHandling, in OMNeT++'s common library), and resolving 25 frames against a
// debug build of the whole of INET costs several minutes. The trace adds nothing here: the
// cause is named in the description above and in the results document, with the file and the
// line. This restores the default handler, so the process ends at once. The check is
// untouched, and so is its verdict.
//
// Remove this line to get the trace back while working on the gap.
static const int restoreDefaultAbortHandler = (signal(SIGABRT, SIG_DFL), 0);

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc8200_atomic_fragment")
        // The relay clears the M flag of the first fragment.
        .intercept(tap("tap").filterPacket("Ipv6FragmentHeader.fragmentOffset == 0 && Ipv6FragmentHeader.moreFragments == true").nth(1)
                     .mutate([](Packet *frame) { rewriteHeader<Ipv6FragmentHeader>(frame, [](Ipv6FragmentHeader& fh) { fh.setMoreFragments(false); }); })
                     .describe("the first fragment (clear its M flag: an atomic fragment)"))
        // Expected observation 1: at host B's interface an atomic fragment arrives.
        .once(on("hostB.eth[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("Ipv6FragmentHeader.fragmentOffset == 0 && Ipv6FragmentHeader.moreFragments == false")
                  .capture("id", "Ipv6FragmentHeader.identification")
                  .describe("an atomic fragment at host B's interface: offset 0, M = 0")
                  .within(6.0))
        // Expected observation 2: host B's internet layer hands its content to UDP as a whole
        // packet (RFC8504-NR-4, RFC8200-REASM-6).
        // The packet is read by length and not by field. The atomic fragment carries 1232
        // octets of a datagram whose UDP header claims 1460, so no field of it can be
        // dissected. 1232 is the whole content of the fragment: 1280 on the wire, less the
        // 40-octet base header and the 8-octet fragment header.
        .once(on("hostB.ipv6.ipv6").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { return c.event.packet->getByteLength() == 1232; })
                  .describe("the content of the atomic fragment handed to UDP at host B as a whole packet")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc8200_atomic_fragment compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;
import inet.protocoltest.PacketTap;

// The mockup with a relay of doc/project/evidence/protocol/ipv6/checks.md: hostA -- router -- tap -- hostB, IPv6 only.
network Rfc8200TapNet
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=200,100"); }
        router: Router6 { @display("p=350,100"); }
        tap: PacketTap { @display("p=500,100"); }
        hostB: StandardHost6 { @display("p=650,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> tap.a;        // link 2 = router.eth[1], before the relay
        tap.b <--> Eth100M <--> hostB.ethg++;         // link 2, after the relay
}

%inifile: omnetpp.ini

[General]
network = Rfc8200TapNet
sim-time-limit = 10s
seed-set = 0

# One UDP datagram from host A to host B. The applications start at 5 s, after router
# discovery, address configuration and duplicate address detection have run.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 1452B
*.hostA.app[0].timeToLive = 64
*.hostA.app[0].startTime = 5s
*.hostA.app[0].sendInterval = 10s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

# Host A must fragment: its interface to link 1 has the minimum IPv6 link MTU.
*.hostA.eth[0].mac.mtu = 1280B

%contains: stdout
PROTOCOLTEST rfc8200_atomic_fragment: PASS
