%description:

RFC 4443 — no ICMPv6 error message is originated about a packet destined to a multicast
address.

Checks RFC4443-MPR-6 (must not) from doc/project/evidence/standard/rfc4443/catalog.md. The English procedure
is in doc/project/evidence/protocol/ipv6/checks/error-report.md#no-error-for-a-multicast-destination; the
program steps below map one to one onto its expected observations. The mockup is the
one-link variant: host A = hostA and host B = hostB share link 1, and host A sends to the
all-nodes multicast address ff02::1 and to a port that no program opened at host B.

%includes:
#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4443_no_error_for_multicast")
        // Expected observation 1: the datagram to ff02::1, port 5001, on link 1.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5001")
                  .match([](const MatchContext& c) { return ipv6AddressOf(c.event.packet, "ipv6.destAddress")->isMulticast(); })
                  .describe("the datagram to the all-nodes multicast address and the closed port 5001")
                  .within(6.0))
        // Expected observation 2: host B's UDP finds no program for port 5001.
        .once(on("hostB.udp").signal("packetDropped")
                  .match([](const MatchContext& c) { return udpDestinationPort(c.event.packet) == 5001; })
                  .describe("host B's UDP discards the multicast datagram for want of a port")
                  .within(0.5))
        // Expected observation 3: from then on, host B sends no ICMPv6 error message (RFC4443-MPR-6).
        .never(on("hostB.eth[0].mac").signal("packetSentToLower")
                  .packet("icmpv6.type < 128")
                  .describe("any ICMPv6 error message from host B")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4443_no_error_for_multicast compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;

// The one-link variant of the mockup: hostA -- hostB, IPv6 only.
network Rfc8200LanNet
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=250,100"); }
        hostB: StandardHost6 { @display("p=450,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> hostB.ethg++; // link 1
}

%inifile: omnetpp.ini

[General]
network = Rfc8200LanNet
sim-time-limit = 10s
seed-set = 0

# One UDP datagram from host A to the all-nodes multicast address, port 5001; no program
# listens at host B. The application starts at 5 s, after address configuration has run.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "ff02::1"
*.hostA.app[0].multicastInterface = "eth0"
*.hostA.app[0].destPort = 5001
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].timeToLive = 64
*.hostA.app[0].startTime = 5s
*.hostA.app[0].sendInterval = 10s
*.hostB.numApps = 0

%contains: stdout
PROTOCOLTEST rfc4443_no_error_for_multicast: PASS
