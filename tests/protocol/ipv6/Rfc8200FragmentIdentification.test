%description:

RFC 8200 — two packets fragmented by one source for one destination carry different
identifications.

Checks RFC8200-FRAG-2 (must) from doc/project/evidence/standard/rfc8200/catalog.md. The
English procedure is in doc/project/evidence/protocol/ipv6/checks.md#fragment-identification;
the program steps below map one to one onto its expected observations. Host A's interface
to link 1 has MTU 1280, and two applications send a 1452-octet datagram each at the same
time, to ports 5000 and 5001 of host B. Mapping of the mockup: host A = hostA, router R =
router, host B = hostB.

Deviation: the UDP port that tells the two first fragments apart is read from the chunk
sequence by a typed predicate, because a fragment is not dissected beyond its fragment
header.

%includes:
#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc8200_fragment_identification")
        // Expected observation 1: the first fragment of datagram 1 (port 5000); record ID1.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("Ipv6FragmentHeader.fragmentOffset == 0 && Ipv6FragmentHeader.moreFragments == true")
                  .match([](const MatchContext& c) { return udpDestinationPortInFragment(c.event.packet) == 5000; })
                  .capture("id1", "Ipv6FragmentHeader.identification")
                  .describe("the first fragment of datagram 1 on link 1")
                  .within(6.0))
        // Expected observation 2: the first fragment of datagram 2 (port 5001) with another
        // identification (RFC8200-FRAG-2).
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("Ipv6FragmentHeader.fragmentOffset == 0 && Ipv6FragmentHeader.moreFragments == true && Ipv6FragmentHeader.identification != {id1}")
                  .match([](const MatchContext& c) { return udpDestinationPortInFragment(c.event.packet) == 5001; })
                  .describe("the first fragment of datagram 2 on link 1 with a different identification")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc8200_fragment_identification compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;

// The common mockup of doc/project/evidence/protocol/ipv6/checks.md: hostA -- router -- hostB, IPv6 only.
network Rfc8200Net
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=250,100"); }
        router: Router6 { @display("p=400,100"); }
        hostB: StandardHost6 { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1]
}

%inifile: omnetpp.ini

[General]
network = Rfc8200Net
sim-time-limit = 10s
seed-set = 0

# Two UDP datagrams of 1452 octets at the same time, to two ports of host B; the
# applications start at 5 s, after router discovery, address configuration and duplicate
# address detection have run.
*.hostA.numApps = 2
*.hostA.app[*].typename = "UdpBasicApp"
*.hostA.app[*].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[1].destPort = 5001
*.hostA.app[0].localPort = 4000
*.hostA.app[1].localPort = 4001
*.hostA.app[*].messageLength = 1452B
*.hostA.app[*].timeToLive = 64
*.hostA.app[*].startTime = 5s
*.hostA.app[*].sendInterval = 10s
*.hostB.numApps = 2
*.hostB.app[*].typename = "UdpSink"
*.hostB.app[0].localPort = 5000
*.hostB.app[1].localPort = 5001

# Host A must fragment: its interface to link 1 has the minimum IPv6 link MTU.
*.hostA.eth[0].mac.mtu = 1280B

%contains: stdout
PROTOCOLTEST rfc8200_fragment_identification: PASS
