%description:

Mobile IPv6 registration observed at the network interface (RFC 6275).

The same message sequence as Mipv6Registration.test, but observed one layer down, at the
mobile node's wireless interface -- the frames actually sent and received on the air. The
Mobility Header is encapsulated in IPv6 and 802.11 here, and the packet filter still
descends to its fields, so the same assertions hold. Only the observation point differs.

%includes:
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    auto tx = [](const char *expr, double w) {
        return on("MN[0].wlan[0]").signal("packetSentToLower").packet(expr).within(w);
    };
    auto rx = [](const char *expr, double w) {
        return on("MN[0].wlan[0]").signal("packetReceivedFromLower").packet(expr).within(w);
    };

    return ProtocolTest("mipv6_registration_and_ro_interface")
        .once(tx("BindingUpdate.homeRegistrationFlag == true && BindingUpdate.ackFlag == true", 72))
        .once(rx("BindingAcknowledgement.status == 0", 6))
        .unordered({
            tx("HomeTestInit.homeInitCookie >= 0", 7).capture("hoCookie", "HomeTestInit.homeInitCookie"),
            tx("CareOfTestInit.careOfInitCookie >= 0", 7).capture("coCookie", "CareOfTestInit.careOfInitCookie")
        })
        .unordered({
            rx("HomeTest.homeInitCookie == {hoCookie}", 4),
            rx("CareOfTest.careOfInitCookie == {coCookie}", 4)
        })
        .once(tx("BindingUpdate.homeRegistrationFlag == false", 5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "mipv6_registration_and_ro_interface compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;
import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.Router6;
import inet.node.wireless.AccessPoint;
import inet.node.mipv6.CorrespondentNode6;
import inet.node.mipv6.HomeAgent6;
import inet.node.mipv6.WirelessHost6;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

channel ethernetline extends ned.DatarateChannel
{
    parameters:
        delay = 0.1us;
        datarate = 100Mbps;
}

// A minimal Mobile IPv6 handover topology (one mobile node, one correspondent node, one
// home agent), modelled on INET's Mipv6Network so the handover and the return-routability
// exchange fire deterministically. The mobile node MN[0] roams from the home link behind
// the Home Agent to a foreign link behind R_1. NO tester module here.
network Mipv6Net
{
    parameters:
        int total_mn;
        int total_cn;
        **.mgmt.numChannels = 5;
        @display("bgb=799,698");
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,100;is=s"); }
        ipv6Configurator: Ipv6NetworkConfigurator { @display("p=100,150;is=s"); }
        radioMedium: Ieee80211ScalarRadioMedium { @display("p=100,200;is=s"); }
        Home_Agent: HomeAgent6 { @display("p=249,229;i=abstract/router"); }
        R_1: Router6 { @display("p=566,227"); }
        R_2: Router6 { @display("p=406,355"); }
        MN[total_mn]: WirelessHost6 { @display("p=220,404"); }
        CN[total_cn]: CorrespondentNode6 { @display("p=405,595,r,50"); }
        AP_Home: AccessPoint { @display("p=249,172;i=device/accesspoint_s"); }
        AP_1: AccessPoint { @display("p=566,172;i=device/accesspoint_s"); }
        switch: EthernetSwitch { @display("p=405,467;i=device/hub_s"); }
    connections allowunconnected:
        R_1.ethg++ <--> ethernetline <--> R_2.ethg++;
        Home_Agent.ethg++ <--> ethernetline <--> R_2.ethg++;
        for i=0..total_cn-1 {
            CN[i].ethg++ <--> ethernetline <--> switch.ethg++;
        }
        switch.ethg++ <--> ethernetline <--> R_2.ethg++;
        AP_Home.ethg++ <--> ethernetline <--> Home_Agent.ethg++;
        AP_1.ethg++ <--> ethernetline <--> R_1.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Mipv6Net
sim-time-limit = 85s
seed-set = 1
num-rngs = 3
**.mobility.rng-0 = 2
*.total_mn = 1
*.total_cn = 1

# RA-based movement detection
**.neighbourDiscovery.minIntervalBetweenRAs = 3s
**.neighbourDiscovery.maxIntervalBetweenRAs = 7s
**.neighbourDiscovery.detectL2Movement = false

# radio medium
*.radioMedium.mediumLimitCache.maxTransmissionPower = 2.0mW
*.radioMedium.mediumLimitCache.minReceptionPower = -82dBm
*.radioMedium.mediumLimitCache.minInterferencePower = -82dBm
**.analogModel.ignorePartialInterference = true

# access points
**.wlan*.mgmt.numAuthSteps = 4
**.AP*.wlan*.mgmt.beaconInterval = 0.1s
**.AP_Home.wlan*.mgmt.ssid = "HOME"
**.AP_Home.wlan*.address = "10:AA:00:00:00:01"
**.AP_Home.eth[0].address = "10:AE:00:00:00:02"
**.AP_Home.eth[0].duplexMode = true
**.AP_1.wlan*.mgmt.ssid = "AP1"
**.AP_1.wlan*.address = "10:AA:00:00:A1:01"
**.AP_1.eth[0].address = "10:AE:00:00:A1:02"
**.AP_1.eth[0].duplexMode = true

# mobile node movement (rectangle: dwells in each AP's coverage; handover completes < t=70)
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxZ = 0m
**.MN[0].mobility.typename = "RectangleMobility"
**.MN[0].mobility.constraintAreaMinX = 180m
**.MN[0].mobility.constraintAreaMinY = 170m
**.MN[0].mobility.constraintAreaMaxX = 630m
**.MN[0].mobility.constraintAreaMaxY = 180m
**.MN[0].mobility.startPos = 0
**.MN[0].mobility.speed = 5mps
**.MN*.mobility.updateInterval = 0.1s

# CN sends sparse pings to the MN's home address; tunneled traffic triggers route optimization
**.MN*.numApps = 0
**.CN*.numApps = 1
**.CN*.app[*].typename = "PingApp"
**.CN[0].app[0].destAddr = "aaaa:0:66:0:8aa:ff:fe00:8"
**.CN*.app[0].packetSize = 56B
**.CN*.app[*].sendInterval = 2s
**.CN*.app[0].hopLimit = 32
**.CN[0].app[0].count = 5
**.CN[0].app[0].startTime = 71s

**.forwarding = false

# Ethernet NICs
**.eth[*].queue.typename = "EthernetQosQueue"
**.eth[*].queue.dataQueue.typename = "DropTailQueue"
**.eth[*].queue.dataQueue.packetCapacity = 10
**.eth*.duplexMode = true

# wireless channels
**.AP_Home.wlan*.radio.channelNumber = 1
**.AP_1.wlan*.radio.channelNumber = 2
**.MN*.wlan*.radio.channelNumber = 0
**.wlan*.agent.activeScan = true
**.wlan*.agent.defaultSsid = ""
**.wlan*.agent.channelsToScan = "1 2"
**.wlan*.agent.probeDelay = 0.1s
**.wlan*.agent.minChannelTime = 0.15s
**.wlan*.agent.maxChannelTime = 0.3s
**.wlan*.agent.authenticationTimeout = 5s
**.wlan*.agent.associationTimeout = 5s
**.wlan*.bitrate = 2Mbps
**.wlan*.mac.dcf.channelAccess.cwMin = 7
**.radio.transmitter.power = 2.0mW

**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMaxX = 850m
**.constraintAreaMaxY = 850m

%contains: stdout
PROTOCOLTEST mipv6_registration_and_ro_interface: PASS
