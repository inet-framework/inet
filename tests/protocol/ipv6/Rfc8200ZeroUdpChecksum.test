%description:

RFC 8200 — an IPv6 receiver discards a UDP datagram whose checksum is zero.

Checks RFC8200-CKSUM-1, the discard half (must), from doc/project/evidence/standard/rfc8200/catalog.md. The
English procedure is in doc/project/evidence/protocol/ipv6/checks/input-validation.md#zero-udp-checksum; the
program steps below map one to one onto its expected observations. Every node computes UDP
checksums; the relay rewrites the checksum field of the datagram to 0. The port is open, so
only the checksum can be the reason for a discard. Mapping of the mockup with a relay: host
A = hostA, router R = router, relay T = tap, host B = hostB.

Deviation: the discard record of UDP (expected observation 2) is matched without a content
filter, because UDP removes the protocol tag and has moved past the header when it records
a checksum discard.

%includes:
#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc8200_zero_udp_checksum")
        // The relay rewrites the UDP checksum to 0.
        .intercept(intercept("tap").match("udp.destPort == 5000").nth(1)
                     .mutate([](Packet *frame) { rewriteHeader<UdpHeader>(frame, [](UdpHeader& h) { h.setChecksum(0); }); })
                     .describe("the datagram (set its UDP checksum to 0)"))
        // Expected observation 1: at host B's interface the datagram carries a zero UDP checksum.
        .once(on("hostB.eth[0].mac").signal("packetReceivedFromLower")
                  .packet("udp.destPort == 5000 && udp.checksum == 0")
                  .describe("the datagram at host B's interface with a zero UDP checksum")
                  .within(6.0))
        // Expected observation 2: host B's UDP discards it (RFC8200-CKSUM-1).
        .once(on("hostB.udp").signal("packetDropped")
                  .describe("host B's UDP discards the datagram")
                  .within(0.5))
        // Expected observation 3: the program never receives the data.
        .never(on("hostB.udp").signal("packetSentToUpper")
                  .describe("data handed up from host B's UDP toward the program")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc8200_zero_udp_checksum compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;
import inet.protocoltest.PacketTap;

// The mockup with a relay of doc/project/evidence/protocol/ipv6/checks.md: hostA -- router -- tap -- hostB, IPv6 only.
network Rfc8200TapNet
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=200,100"); }
        router: Router6 { @display("p=350,100"); }
        tap: PacketTap { @display("p=500,100"); }
        hostB: StandardHost6 { @display("p=650,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> tap.a;        // link 2 = router.eth[1], before the relay
        tap.b <--> Eth100M <--> hostB.ethg++;         // link 2, after the relay
}

%inifile: omnetpp.ini

[General]
network = Rfc8200TapNet
sim-time-limit = 10s
seed-set = 0

# One UDP datagram from host A to host B. The applications start at 5 s, after router
# discovery, address configuration and duplicate address detection have run.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].timeToLive = 64
*.hostA.app[0].startTime = 5s
*.hostA.app[0].sendInterval = 10s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

# Every node computes the UDP checksum; the relay's zero is the only wrong value.
**.udp.checksumMode = "computed"

%contains: stdout
PROTOCOLTEST rfc8200_zero_udp_checksum: PASS
