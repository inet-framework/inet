%description:

RFC 8200 — a non-final fragment whose length is not a multiple of 8 octets is discarded and
reported with Parameter Problem code 0.

Checks RFC8200-REASM-4 (must discard; should report) from
doc/project/evidence/standard/rfc8200/catalog.md. The English procedure is in
doc/project/evidence/protocol/ipv6/checks/fragmentation.md#short-fragment; the program steps below map one to
one onto its expected observations. Host A fragments a 1500-octet packet for its 1280-octet
link; the relay shortens the first fragment by 4 octets, to a piece of 1228 octets and a
payload length of 1236, with M still 1. Mapping of the mockup with a relay: host A = hostA,
router R = router, relay T = tap, host B = hostB.

Deviation: the payload length of the crafted fragment is read from the base header by a
typed reader, because on a fragment the generic field lookup can land on the fragment
header.

%includes:
#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc8200_short_fragment")
        // The relay shortens the first fragment by 4 octets.
        .intercept(intercept("tap").match("Ipv6FragmentHeader.fragmentOffset == 0 && Ipv6FragmentHeader.moreFragments == true").nth(1)
                     .mutate([](Packet *frame) { shortenFrame(frame, B(4)); })
                     .describe("the first fragment (shorten it by 4 octets: a piece of 1228)"))
        // Expected observation 1: at host B's interface a first fragment with payload length 1236.
        .once(on("hostB.eth[0].mac").signal("packetReceivedFromLower")
                  .packet("Ipv6FragmentHeader.fragmentOffset == 0 && Ipv6FragmentHeader.moreFragments == true")
                  .match([](const MatchContext& c) { return ipv6PayloadLength(c.event.packet) == 1236; })
                  .capture("id", "Ipv6FragmentHeader.identification")
                  .describe("a first fragment at host B's interface with payload length 1236, not a multiple of 8 plus 8")
                  .within(6.0))
        // Expected observation 2: host A receives Parameter Problem, type 4 code 0.
        .once(on("hostA.eth[0].mac").signal("packetReceivedFromLower")
                  .packet("icmpv6.type == 4 && Icmpv6ParamProblemMsg.code == 0")
                  .describe("the Parameter Problem message, code 0, at host A")
                  .within(0.5))
        // Expected observation 3: nothing of the datagram reaches UDP at host B (RFC8200-REASM-4).
        .never(on("hostB")
                  .match([](const MatchContext& c) { return deliveredToUdp(c.event, "hostB", "udp.destPort == 5000"); })
                  .describe("the datagram at host B's UDP")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc8200_short_fragment compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;
import inet.protocoltest.PacketTap;

// The mockup with a relay of doc/project/evidence/protocol/ipv6/checks.md: hostA -- router -- tap -- hostB, IPv6 only.
network Rfc8200TapNet
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=200,100"); }
        router: Router6 { @display("p=350,100"); }
        tap: PacketTap { @display("p=500,100"); }
        hostB: StandardHost6 { @display("p=650,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> tap.a;        // link 2 = router.eth[1], before the relay
        tap.b <--> Eth100M <--> hostB.ethg++;         // link 2, after the relay
}

%inifile: omnetpp.ini

[General]
network = Rfc8200TapNet
sim-time-limit = 10s
seed-set = 0

# One UDP datagram from host A to host B. The applications start at 5 s, after router
# discovery, address configuration and duplicate address detection have run.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 1452B
*.hostA.app[0].timeToLive = 64
*.hostA.app[0].startTime = 5s
*.hostA.app[0].sendInterval = 10s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

# Host A must fragment: its interface to link 1 has the minimum IPv6 link MTU.
*.hostA.eth[0].mac.mtu = 1280B

%contains: stdout
PROTOCOLTEST rfc8200_short_fragment: PASS
