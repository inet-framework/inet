%description:

RFC 4443 — the MTU field of a Packet Too Big message carries the MTU of the next-hop link.

Checks RFC4443-PTB-2 (description; the field definition of a mandatory message) from
doc/project/evidence/standard/rfc4443/catalog.md. The English procedure is in
doc/project/evidence/protocol/ipv6/checks.md#packet-too-big-the-mtu-field; the program steps
below map one to one onto its expected observations. Link 2 has MTU 1280 and host A sends a
1500-octet packet; the message must say 1280. Mapping of the mockup: host A = hostA, router R
= router, host B = hostB.

Expected result: FAIL. The model sends the message with an MTU field of 0
(Icmpv6::sendErrorMessage calls createPacketTooBigMsg(0), marked "TODO implement MTU
support"), so expected observation 2 misses its deadline. See
doc/project/evidence/model/ipv6/results.md.

%includes:
#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4443_packet_too_big_mtu")
        // Expected observation 1: the packet on link 1, whole, payload length 1460.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5000 && ipv6.protocolId == 17 && ipv6.payloadLength == 1460B")
                  .describe("the 1500-octet packet on link 1, whole")
                  .within(6.0))
        // Expected observation 2: host A receives Packet Too Big, type 2 code 0, with MTU 1280
        // (RFC4443-PTB-2).
        .once(on("hostA.eth[0].mac").signal("packetReceivedFromLower")
                  .packet("icmpv6.type == 2 && Icmpv6PacketTooBigMsg.code == 0 && Icmpv6PacketTooBigMsg.MTU == 1280")
                  .describe("the Packet Too Big message at host A with the next-hop MTU 1280")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4443_packet_too_big_mtu compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;

// The common mockup of doc/project/evidence/protocol/ipv6/checks.md: hostA -- router -- hostB, IPv6 only.
network Rfc8200Net
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=250,100"); }
        router: Router6 { @display("p=400,100"); }
        hostB: StandardHost6 { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1]
}

%inifile: omnetpp.ini

[General]
network = Rfc8200Net
sim-time-limit = 10s
seed-set = 0

# One UDP datagram from host A to host B. The applications start at 5 s, after router
# discovery, address configuration and duplicate address detection have run.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 1452B
*.hostA.app[0].timeToLive = 64
*.hostA.app[0].startTime = 5s
*.hostA.app[0].sendInterval = 10s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

# Link 2 has the minimum IPv6 link MTU; the router cannot forward the 1500-octet packet.
*.router.eth[1].mac.mtu = 1280B

%# expected-result: FAIL
%contains: stdout
PROTOCOLTEST rfc4443_packet_too_big_mtu: PASS
