%description:

RFC 4861 Section 7.2.4 — a solicited Neighbor Advertisement that carries a Target Link-Layer
Address option has the Override flag set, whatever options the solicitation carried.

Host A learns the router from a Router Advertisement, so its Neighbor Cache entry for the
router starts STALE. The first datagram host A sends to host B moves that entry through DELAY
to PROBE, and Neighbor Unreachability Detection sends a unicast Neighbor Solicitation to the
router. INET's createAndSendNsPacket() adds no Source Link-Layer Address option to a unicast
solicitation. The router answers
with a solicited Neighbor Advertisement that carries a Target Link-Layer Address option. The
target is an ordinary unicast address of the router and no proxy service is involved, so the
Override flag must be set.

Mapping: host A = hostA, router R = router, host B = hostB; link 1 = hostA-router, link 2 =
router-hostB.

%includes:
#include "ProtocolTest.h"
#include "Ipv6Fields.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4861_solicited_na_override")
        // Observation 1: host A sends a unicast Neighbor Solicitation to the router, which
        // carries no Source Link-Layer Address option.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) {
                      return matchesExpression(c.event.packet, "icmpv6.type == 135")
                          && !ipv6AddressOf(c.event.packet, "ipv6.destAddress")->isMulticast();
                  })
                  .describe("a unicast Neighbor Solicitation from host A to the router")
                  .within(15.0))
        // Observation 2: the router answers with a solicited Neighbor Advertisement that has
        // the Override flag set.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterPacket("icmpv6.type == 136 && icmpv6.solicitedFlag == true && icmpv6.overrideFlag == true")
                  .describe("the router's solicited Neighbor Advertisement with the Override flag set")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4861_solicited_na_override compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;

// The common mockup of doc/project/evidence/protocol/ipv6/checks.md: hostA -- router -- hostB, IPv6 only.
network Rfc4861Net
{
    submodules:
        configurator: Ipv6FlatNetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost6 { @display("p=250,100"); }
        router: Router6 { @display("p=400,100"); }
        hostB: StandardHost6 { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1]
}

%inifile: omnetpp.ini

[General]
network = Rfc4861Net
sim-time-limit = 20s
seed-set = 0

# One UDP datagram from host A to host B at 6 s, after router discovery.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 6s
*.hostA.app[0].sendInterval = 20s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST rfc4861_solicited_na_override: PASS
