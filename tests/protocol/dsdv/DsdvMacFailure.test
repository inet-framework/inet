**.app[0].payloadBudget = 128B
**.ipv4.routingTable.netmaskRoutes = ""
*.enabled[2].mobility.typename = "TurtleMobility"
*.disabled[2].mobility.typename = "TurtleMobility"
*.dcf[2].mobility.typename = "TurtleMobility"
*.*.mobility.typename = "StationaryMobility"
