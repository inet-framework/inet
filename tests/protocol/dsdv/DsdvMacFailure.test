*.disabled[2].mobility.turtleScript = xml("<movement><set x='1300' y='100'/><wait t='3'/><moveto x='1300' y='500' t='0.1'/><wait t='10'/></movement>")
*.dcf[2].mobility.turtleScript = xml("<movement><set x='2300' y='100'/><wait t='3'/><moveto x='2300' y='500' t='0.1'/><wait t='10'/></movement>")
**.mobility.initFromDisplayString = false
