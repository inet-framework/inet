%description:
PB94-SELECT/DUMPS: production UDP control and real IPv4 forwarding on a four-node
line and pair, plus disconnected node and an otherwise identical disabled line.
Static addresses, local ARP and no connected/configurator routes eliminate bypasses.
The observer checks owned next hops, intermediate ICMP traversal and echo replies.

%file: test.ned
import inet.node.inet.AdhocHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.physicallayer.wireless.common.medium.UnitDiskRadioMedium;

simple DsdvForwardingObserver { parameters: @class(DsdvForwardingObserver); }
network DsdvForwardingNetwork
{
    submodules:
        radioMedium: UnitDiskRadioMedium;
        configurator: Ipv4NetworkConfigurator;
        observer: DsdvForwardingObserver;
        line[4]: AdhocHost;
        disabled[4]: AdhocHost;
        pair[2]: AdhocHost;
        isolated: AdhocHost;
}

%file: Observer.cc
#include "inet/common/SimpleModule.h"
#include "inet/common/ModuleAccess.h"
#include "inet/networklayer/contract/IRoutingTable.h"
#include "inet/networklayer/ipv4/Ipv4Header_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/ProtocolTag_m.h"
using namespace inet;
namespace DsdvForwarding {

class DsdvForwardingObserver : public SimpleModule, public cListener
{
    int lineReplies = 0;
    int pairReplies = 0;
    int disabledReplies = 0;
    std::set<std::string> traversed;
    int controls = 0;
  protected:
    int numInitStages() const override { return NUM_INIT_STAGES; }
    void initialize(int stage) override {
        if (stage == INITSTAGE_LOCAL) {
            getParentModule()->subscribe("pingRxSeq",this);
            getParentModule()->subscribe("updateAccepted",this);
            getParentModule()->subscribe("packetReceivedFromLower",this);
        }
    }
    void receiveSignal(cComponent *source,simsignal_t signal,intval_t,cObject *) override {
        std::string path=source->getFullPath();
        if (signal==registerSignal("updateAccepted")) controls++;
        else if (path.find(".line[0].")!=std::string::npos) lineReplies++;
        else if (path.find(".pair[0].")!=std::string::npos) pairReplies++;
        else if (path.find(".disabled[0].")!=std::string::npos) disabledReplies++;
    }
    void receiveSignal(cComponent *source,simsignal_t,cObject *value,cObject *) override {
        auto packet=dynamic_cast<Packet *>(value);
        std::string path=source->getFullPath();
        if (!packet || (path.find(".line[1].ipv4.ip") == std::string::npos &&
                path.find(".line[2].ipv4.ip") == std::string::npos)) return;
        auto protocol=packet->findTag<PacketProtocolTag>();
        if (!protocol || protocol->getProtocol()!=&Protocol::ipv4) return;
        auto header=packet->peekAtFront<Ipv4Header>();
        if (header->getProtocolId()==IP_PROT_ICMP && header->getDestAddress()==Ipv4Address("10.0.0.4"))
            traversed.insert(path);
    }
    void finish() override {
        std::cout << "DSDV observed controls=" << controls << " line=" << lineReplies
                  << " pair=" << pairReplies << " disabled=" << disabledReplies
                  << " intermediate=" << traversed.size() << "\n";
        ASSERT(controls > 0 && lineReplies > 0 && pairReplies > 0 && disabledReplies == 0);
        ASSERT(traversed.size()==2);
        for (int source=0;source<4;source++) {
            auto node=getParentModule()->getSubmodule("line",source);
            auto table=check_and_cast<IRoutingTable *>(node->getSubmodule("ipv4")->getSubmodule("routingTable"));
            for (int destination=0;destination<4;destination++) if (source!=destination) {
                auto route=table->findBestMatchingRoute(Ipv4Address(0x0a000001U+destination));
                ASSERT(route && route->getSource()==node->getSubmodule("app",0));
                ASSERT(route->getPrefixLength()==32 && route->getSourceType()==IRoute::MANET);
                ASSERT(route->getMetric()==abs(source-destination));
                int next=source+(destination>source?1:-1);
                ASSERT(route->getNextHopAsGeneric()==Ipv4Address(0x0a000001U+next));
            }
        }
        auto isolated=getParentModule()->getSubmodule("isolated");
        auto table=check_and_cast<IRoutingTable *>(isolated->getSubmodule("ipv4")->getSubmodule("routingTable"));
        for (int i=0;i<table->getNumRoutes();i++) ASSERT(table->getRoute(i)->getSource()!=isolated->getSubmodule("app",0));
        auto disabled=getParentModule()->getSubmodule("disabled",0);
        auto disabledTable=check_and_cast<IRoutingTable *>(disabled->getSubmodule("ipv4")->getSubmodule("routingTable"));
        ASSERT(disabledTable->findBestMatchingRoute(Ipv4Address("10.0.1.4"))==nullptr);
        std::cout << "DSDV forwarding PASS: owned routes, local ARP, two intermediate traversals, disabled control\n";
    }
};
Define_Module(DsdvForwardingObserver);
}

%inifile: omnetpp.ini
[General]
network = DsdvForwardingNetwork
sim-time-limit = 10s
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
**.scalar-recording = false
**.vector-recording = false
*.configurator.addStaticRoutes = false
*.configurator.addDefaultRoutes = false
*.configurator.addSubnetRoutes = false
*.configurator.optimizeRoutes = false
*.radioMedium.sameTransmissionStartTimeCheck = "ignore"
*.configurator.config = xml("<config><interface hosts='line[0]' names='wlan0' address='10.0.0.1' netmask='255.255.255.0'/><interface hosts='line[1]' names='wlan0' address='10.0.0.2' netmask='255.255.255.0'/><interface hosts='line[2]' names='wlan0' address='10.0.0.3' netmask='255.255.255.0'/><interface hosts='line[3]' names='wlan0' address='10.0.0.4' netmask='255.255.255.0'/><interface hosts='disabled[0]' names='wlan0' address='10.0.1.1' netmask='255.255.255.0'/><interface hosts='disabled[1]' names='wlan0' address='10.0.1.2' netmask='255.255.255.0'/><interface hosts='disabled[2]' names='wlan0' address='10.0.1.3' netmask='255.255.255.0'/><interface hosts='disabled[3]' names='wlan0' address='10.0.1.4' netmask='255.255.255.0'/><interface hosts='pair[0]' names='wlan0' address='10.0.2.1' netmask='255.255.255.0'/><interface hosts='pair[1]' names='wlan0' address='10.0.2.2' netmask='255.255.255.0'/><interface hosts='isolated' names='wlan0' address='10.0.3.1' netmask='255.255.255.0'/></config>")
*.*.numApps = 2
*.line[*].app[0].typename = "Dsdv"
*.pair[*].app[0].typename = "Dsdv"
*.isolated.app[0].typename = "Dsdv"
*.disabled[*].app[0].typename = "UdpSink"
*.disabled[*].app[0].localPort = 26999
*.*.app[1].typename = "PingApp"
*.line[0].app[1].destAddr = "10.0.0.4"
*.pair[0].app[1].destAddr = "10.0.2.2"
*.disabled[0].app[1].destAddr = "10.0.1.4"
**.app[1].startTime = 6s
**.app[1].sendInterval = 500ms
**.app[0].fullDumpInterval = 500ms
**.app[0].periodicJitter = 50ms
**.app[0].neighborTimeout = 3s
**.app[0].routeTimeout = 4s
**.app[0].settlingCap = 100ms
**.app[0].payloadBudget = 64B
**.ipv4.routingTable.netmaskRoutes = ""
*.*.mobility.typename = "StationaryMobility"
**.mobility.initFromDisplayString = false
**.mobility.updateFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 3000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initialZ = 0m
**.mobility.initialY = 100m
*.line[0].mobility.initialX = 100m
*.line[1].mobility.initialX = 200m
*.line[2].mobility.initialX = 300m
*.line[3].mobility.initialX = 400m
*.disabled[0].mobility.initialX = 1000m
*.disabled[1].mobility.initialX = 1100m
*.disabled[2].mobility.initialX = 1200m
*.disabled[3].mobility.initialX = 1300m
*.pair[0].mobility.initialX = 2000m
*.pair[1].mobility.initialX = 2100m
*.isolated.mobility.initialX = 2700m
**.wlan[*].typename = "AckingWirelessInterface"
**.wlan[*].radio.typename = "GenericUnitDiskRadio"
**.wlan[*].radio.transmitter.analogModel.communicationRange = 110m
**.wlan[*].radio.transmitter.headerLength = 4b
**.wlan[*].bitrate = 2Mbps
**.wlan[*].mac.address = "auto"
**.wlan[*].mac.headerLength = 20B

%contains: stdout
DSDV forwarding PASS: owned routes, local ARP, two intermediate traversals, disabled control
