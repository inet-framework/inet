%description:

Fragments of a protected datagram (IPv4).

Checks RFC4301-IN-5, SA-44, SA-45, SA-46, RFC4302-FRAG-1, REAS-2, RFC4303-FRAG-1, FRAG-2, REAS-1,
RFC4302-FRAG-2 and RFC4303-FRAG-3 from the catalogs under doc/project/evidence/standard/. The
English procedure is in
doc/project/evidence/protocol/ipsec/checks/fragmentation.md#fragments-of-a-protected-datagram;
the program steps below map onto its expected observations. The guards are observations 2 to 4;
the steps are observations 1, 3 and 4.

%includes:
#include "ProtocolTest.h"
#include "IpsecChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4301_fragments")
        // Expected observation 2: B delivers the five datagrams of flow 2000 ...
        .meanwhile(exactlyTimes(5, on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2000; })
                  .describe("a datagram that B delivers on port 2000")
                  .within(10.0)))
        // ... each with 3000 octets of payload.
        .meanwhile(never(on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2000 && p->getByteLength() != 3000; })
                  .describe("a datagram on port 2000 that B delivers with other than 3000 octets")
                  .within(10.0)))
        // ... and of flow 2001.
        .meanwhile(exactlyTimes(5, on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2001; })
                  .describe("a datagram that B delivers on port 2001")
                  .within(10.0)))
        // ... each with 3000 octets of payload.
        .meanwhile(never(on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2001 && p->getByteLength() != 3000; })
                  .describe("a datagram on port 2001 that B delivers with other than 3000 octets")
                  .within(10.0)))
        // Expected observation 4: no fragment after the first one holds an AH or ESP header of its own.
        .meanwhile(never(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isFragment(p) && fragmentOffsetOf(p) > 0 && ipsecHeaderFirst(p); })
                  .describe("a fragment with an offset that begins with an AH or ESP header: IPsec applied to a fragment (RFC4301-SA-45, SA-46, RFC4302-FRAG-1, RFC4303-FRAG-1, FRAG-2)")
                  .within(10.0)))
        // Expected observation 3: B delivers the datagrams of flows 2002 and 2003, which R fragmented ...
        .meanwhile(exactlyTimes(5, on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2002; })
                  .describe("a datagram that B delivers on port 2002")
                  .within(10.0)))
        // ... each with 1400 octets of payload.
        .meanwhile(never(on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2002 && p->getByteLength() != 1400; })
                  .describe("a datagram on port 2002 that B delivers with other than 1400 octets")
                  .within(10.0)))
        // ...
        .meanwhile(exactlyTimes(5, on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2003; })
                  .describe("a datagram that B delivers on port 2003")
                  .within(10.0)))
        // ... each with 1400 octets of payload.
        .meanwhile(never(on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2003 && p->getByteLength() != 1400; })
                  .describe("a datagram on port 2003 that B delivers with other than 1400 octets")
                  .within(10.0)))
        // Expected observations 1 and 4: the first fragment of a protected datagram, with the ESP header right after the IP header.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isFragment(p) && fragmentOffsetOf(p) == 0 && fragmentProtocolOf(p) == PROTO_ESP; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(ipsecHeaderFirst(p) && isEsp(p, 101), "the first fragment holds " + chunkNames(wireChunks(p)) + " (RFC4301-SA-45, SA-46, RFC4303-FRAG-1, FRAG-2)"); })
                  .describe("the first fragment of an ESP packet from A")
                  .within(3.0))
        // ... and of an AH packet.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isFragment(p) && fragmentOffsetOf(p) == 0 && fragmentProtocolOf(p) == PROTO_AH; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(ipsecHeaderFirst(p) && isAh(p, 103), "the first fragment holds " + chunkNames(wireChunks(p)) + " (RFC4301-SA-45, SA-46, RFC4302-FRAG-1)"); })
                  .describe("the first fragment of an AH packet from A")
                  .within(1.5))
        // Expected observation 3: R fragments the protected packets of flows 2002 and 2003 for L2.
        .once(on("router.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isFragment(p) && (fragmentProtocolOf(p) == PROTO_ESP || fragmentProtocolOf(p) == PROTO_AH); })
                  .describe("a fragment of a protected packet from R onto L2")
                  .within(3.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4301_fragments compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;

// the path: host A on L1, router R, host B on L2 (IPv4).
network IpsecPath
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='router' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='router' names='eth1' address='10.0.2.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='eth0' address='10.0.2.11' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        hostA: StandardHost { @display("p=100,250"); }
        router: Router { @display("p=300,250"); }
        hostB: StandardHost { @display("p=500,250"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++;
        router.ethg++ <--> Eth100M <--> hostB.ethg++;
}

%inifile: omnetpp.ini

[General]
network = IpsecPath
sim-time-limit = 11s
seed-set = 0
*.host*.ipv4.hasIpsec = true
*.hostA.numApps = 4
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].localPort = 1000
*.hostA.app[0].destAddresses = "10.0.2.11"
*.hostA.app[0].destPort = 2000
*.hostA.app[0].messageLength = 3000B
*.hostA.app[0].startTime = 1s
*.hostA.app[0].stopTime = 5.5s
*.hostA.app[0].sendInterval = 1s
*.hostA.app[1].typename = "UdpBasicApp"
*.hostA.app[1].localPort = 1001
*.hostA.app[1].destAddresses = "10.0.2.11"
*.hostA.app[1].destPort = 2001
*.hostA.app[1].messageLength = 3000B
*.hostA.app[1].startTime = 1s
*.hostA.app[1].stopTime = 5.5s
*.hostA.app[1].sendInterval = 1s
*.hostA.app[2].typename = "UdpBasicApp"
*.hostA.app[2].localPort = 1002
*.hostA.app[2].destAddresses = "10.0.2.11"
*.hostA.app[2].destPort = 2002
*.hostA.app[2].messageLength = 1400B
*.hostA.app[2].startTime = 1s
*.hostA.app[2].stopTime = 5.5s
*.hostA.app[2].sendInterval = 1s
*.hostA.app[3].typename = "UdpBasicApp"
*.hostA.app[3].localPort = 1003
*.hostA.app[3].destAddresses = "10.0.2.11"
*.hostA.app[3].destPort = 2003
*.hostA.app[3].messageLength = 1400B
*.hostA.app[3].startTime = 1s
*.hostA.app[3].stopTime = 5.5s
*.hostA.app[3].sendInterval = 1s
*.hostB.numApps = 4
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 2000
*.hostB.app[1].typename = "UdpSink"
*.hostB.app[1].localPort = 2001
*.hostB.app[2].typename = "UdpSink"
*.hostB.app[2].localPort = 2002
*.hostB.app[3].typename = "UdpSink"
*.hostB.app[3].localPort = 2003
*.hostA.ipv4.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>UDP</Protocol><RemotePort>2000</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>101</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><RemotePort>2001</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>AH</Protection><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>103</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><RemotePort>2002</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>102</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><RemotePort>2003</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>AH</Protection><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>104</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")
*.hostB.ipv4.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2000</LocalPort></Selector><Direction>IN</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>101</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2001</LocalPort></Selector><Direction>IN</Direction><Action>PROTECT</Action><Protection>AH</Protection><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>103</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2002</LocalPort></Selector><Direction>IN</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>102</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2003</LocalPort></Selector><Direction>IN</Direction><Action>PROTECT</Action><Protection>AH</Protection><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>104</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")
*.router.eth[1].mac.mtu = 1000B

%contains: stdout
PROTOCOLTEST rfc4301_fragments: PASS
