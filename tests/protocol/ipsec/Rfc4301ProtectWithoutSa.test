%description:

A PROTECT entry without an SA.

Checks RFC4301-OUT-10 from the catalogs under doc/project/evidence/standard/. The English
procedure is in
doc/project/evidence/protocol/ipsec/checks/security-associations.md#a-protect-entry-without-an-sa;
the program steps below map onto its expected observations. The guards are observations 2 and 3;
step 1 is observation 1.

Model gap: IPsec::protectDatagram applies every SA of the PROTECT entry that matches the packet,
and with no SA it passes the packet on without protection
(src/inet/networklayer/ipsec/IPsec.cc:732-778). Flow 2000 leaves A in clear.

%includes:
#include "ProtocolTest.h"
#include "IpsecChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4301_protect_without_sa")
        // Expected observation 2: no packet of flow 2000 on L1.
        .meanwhile(never(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return flowOf(p) == 2000; })
                  .describe("a packet of flow 2000 from A, protected or in clear (RFC4301-OUT-10)")
                  .within(10.0)))
        // Expected observation 3: B delivers none of flow 2000.
        .meanwhile(never(on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2000; })
                  .describe("a datagram that B delivers on port 2000")
                  .within(10.0)))
        // Expected observation 1: flow 2001 leaves without IPsec.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isPlainUdp(p, 2001); })
                  .describe("a plain UDP datagram of flow 2001 from A")
                  .within(3.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4301_protect_without_sa compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.inet.StandardHost;

// the link: A, B on L1 through a switch (IPv4).
network IpsecLink
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='eth0' address='10.0.1.11' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        sw: EthernetSwitch { @display("p=300,100"); }
        hostA: StandardHost { @display("p=150,250"); }
        hostB: StandardHost { @display("p=300,250"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> sw.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw.ethg++;
}

%inifile: omnetpp.ini

[General]
network = IpsecLink
sim-time-limit = 11s
seed-set = 0
*.host*.ipv4.hasIpsec = true
*.hostA.numApps = 2
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].localPort = 1000
*.hostA.app[0].destAddresses = "10.0.1.11"
*.hostA.app[0].destPort = 2000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 1s
*.hostA.app[0].stopTime = 5.5s
*.hostA.app[0].sendInterval = 1s
*.hostA.app[1].typename = "UdpBasicApp"
*.hostA.app[1].localPort = 1001
*.hostA.app[1].destAddresses = "10.0.1.11"
*.hostA.app[1].destPort = 2001
*.hostA.app[1].messageLength = 100B
*.hostA.app[1].startTime = 1s
*.hostA.app[1].stopTime = 5.5s
*.hostA.app[1].sendInterval = 1s
*.hostB.numApps = 2
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 2000
*.hostB.app[1].typename = "UdpSink"
*.hostB.app[1].localPort = 2001
*.hostA.ipv4.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>1000</LocalPort><RemotePort>2000</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><RemotePort>2001</RemotePort></Selector><Direction>OUT</Direction><Action>BYPASS</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")
*.hostB.ipv4.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2000-2001</LocalPort></Selector><Direction>IN</Direction><Action>BYPASS</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")

%contains: stdout
PROTOCOLTEST rfc4301_protect_without_sa: PASS
