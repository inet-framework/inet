%description:

One SA for each direction.

Checks RFC4301-SA-1, SA-2 and SA-5 from the catalogs under doc/project/evidence/standard/. The
English procedure is in
doc/project/evidence/protocol/ipsec/checks/security-associations.md#one-sa-for-each-direction;
the program steps below map onto its expected observations. The guards are observations 2 and 3;
steps 1 and 2 are observations 1 and 2.

%includes:
#include "ProtocolTest.h"
#include "IpsecChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4301_sa_per_direction")
        // Expected observation 2: B sends no packet with SPI 101.
        .meanwhile(never(on("hostB.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isEsp(p, 101); })
                  .describe("an ESP packet with SPI 101 from B, where 101 is the SA from A to B (RFC4301-SA-2)")
                  .within(10.0)))
        // Expected observation 3: A delivers the five answers on port 1000.
        .meanwhile(exactlyTimes(5, on("hostA.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 1000; })
                  .describe("a datagram that A delivers on port 1000")
                  .within(10.0)))
        // ... each with 100 octets of payload.
        .meanwhile(never(on("hostA.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 1000 && p->getByteLength() != 100; })
                  .describe("a datagram on port 1000 that A delivers with other than 100 octets")
                  .within(10.0)))
        // Expected observation 1: ESP packets with SPI 101 from A to B.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isEsp(p, 101) && flowOf(p) == 2000; })
                  .describe("an ESP packet with SPI 101 from A")
                  .within(3.0))
        // Expected observation 2: the answers of B use SA 201.
        .once(on("hostB.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isEsp(p, 201) && flowOf(p) == 1000; })
                  .describe("an ESP packet with SPI 201 from B to A (RFC4301-SA-2, SA-5)")
                  .within(1.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4301_sa_per_direction compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.inet.StandardHost;

// the link: A, B on L1 through a switch (IPv4).
network IpsecLink
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='eth0' address='10.0.1.11' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        sw: EthernetSwitch { @display("p=300,100"); }
        hostA: StandardHost { @display("p=150,250"); }
        hostB: StandardHost { @display("p=300,250"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> sw.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw.ethg++;
}

%inifile: omnetpp.ini

[General]
network = IpsecLink
sim-time-limit = 11s
seed-set = 0
*.host*.ipv4.hasIpsec = true
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].localPort = 1000
*.hostA.app[0].destAddresses = "10.0.1.11"
*.hostA.app[0].destPort = 2000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 1s
*.hostA.app[0].stopTime = 5.5s
*.hostA.app[0].sendInterval = 1s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpEchoApp"
*.hostB.app[0].localPort = 2000
*.hostA.ipv4.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>1000</LocalPort><RemotePort>2000</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>101</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>1000</LocalPort><RemotePort>2000</RemotePort></Selector><Direction>IN</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>201</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")
*.hostB.ipv4.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2000</LocalPort><RemotePort>1000</RemotePort></Selector><Direction>IN</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>101</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2000</LocalPort><RemotePort>1000</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>ESP</Protection><EspMode>COMBINED</EspMode><EncryptionAlg>AES_CBC_128</EncryptionAlg><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>201</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")

%contains: stdout
PROTOCOLTEST rfc4301_sa_per_direction: PASS
