%description:

The place of the AH ICV (IPv6).

Checks RFC4302-FMT-2, ICV-1, ICV-2, ICV-4 and LEN-2 from the catalogs under
doc/project/evidence/standard/. The English procedure is in
doc/project/evidence/protocol/ipsec/checks/ah.md#ah-format-in-transport-mode; the program steps
below map onto its expected observations. Step 1 is observation 1, and step 2 observation 5.

%includes:
#include "ProtocolTest.h"
#include "IpsecChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4302_ah_icv_position_ipv6")
        // Expected observation 1: an AH packet of flow 2003.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isAh(p, 103) && flowOf(p) == 2003; })
                  .describe("an AH packet of flow 2003 from A")
                  .within(3.0))
        // Expected observation 5: the 20 octets after the Sequence Number are the ICV, and the UDP header follows them.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isAh(p, 103) && flowOf(p) == 2003; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; auto ch = wireChunks(p); int a = indexOf<IPsecAuthenticationHeader>(ch); bool ok = a >= 0 && a + 2 < (int)ch.size() && B(ch[a + 1]->getChunkLength()).get() == 20 && dynamicPtrCast<const UdpHeader>(ch[a + 2]) != nullptr; return require(ok, "after the 12 octets of the AH header up to the Sequence Number come " + chunkNames(std::vector<Ptr<const Chunk>>(ch.begin() + a + 1, ch.end())) + ", where the ICV field of 20 octets is part of the AH header (RFC4302-FMT-2, ICV-1, ICV-2, ICV-4, LEN-2)"); })
                  .describe("the next AH packet of flow 2003")
                  .within(1.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4302_ah_icv_position_ipv6 compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.inet.StandardHost;

// the link: A, B on L1 through a switch (IPv6).
network IpsecLink6
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='2001:db8:1::10'/>" +
                         "<interface hosts='hostB' names='eth0' address='2001:db8:1::11'/>" +
                         "</config>");
            @display("p=50,50");
        }
        sw: EthernetSwitch { @display("p=300,100"); }
        hostA: StandardHost { hasIpv4 = false; hasIpv6 = true; @display("p=150,250"); }
        hostB: StandardHost { hasIpv4 = false; hasIpv6 = true; @display("p=300,250"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> sw.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw.ethg++;
}

%inifile: omnetpp.ini

[General]
network = IpsecLink6
sim-time-limit = 11s
seed-set = 0
*.host*.ipv6.hasIpsec = true
**.ipv6.configurator.networkConfiguratorModule = "configurator"
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].localPort = 1003
*.hostA.app[0].destAddresses = "2001:db8:1::11"
*.hostA.app[0].destPort = 2003
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 1s
*.hostA.app[0].stopTime = 5.5s
*.hostA.app[0].sendInterval = 1s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 2003
*.hostA.ipv6.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>58</Protocol></Selector><Direction>OUT</Direction><Action>BYPASS</Action></SecurityPolicy><SecurityPolicy><Selector><Protocol>58</Protocol></Selector><Direction>IN</Direction><Action>BYPASS</Action></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><RemotePort>2003</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>AH</Protection><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>103</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")
*.hostB.ipv6.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>58</Protocol></Selector><Direction>OUT</Direction><Action>BYPASS</Action></SecurityPolicy><SecurityPolicy><Selector><Protocol>58</Protocol></Selector><Direction>IN</Direction><Action>BYPASS</Action></SecurityPolicy><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2003</LocalPort></Selector><Direction>IN</Direction><Action>PROTECT</Action><Protection>AH</Protection><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>103</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")

%contains: stdout
PROTOCOLTEST rfc4302_ah_icv_position_ipv6: PASS
