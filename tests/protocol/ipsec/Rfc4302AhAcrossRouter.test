%description:

AH across a router (IPv4).

Checks RFC4302-OICV-1, OICV-5, OICV-13 and OICV-19 from the catalogs under
doc/project/evidence/standard/. The English procedure is in
doc/project/evidence/protocol/ipsec/checks/ah.md#ah-across-a-router; the program steps below map
onto its expected observations. Steps 1 and 2 are observation 1; the guard is observation 2.

%includes:
#include "ProtocolTest.h"
#include "IpsecChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;
static int ttlA = -1;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4302_ah_across_router")
        // Expected observation 2: B delivers the five datagrams: the ICV does not cover the fields that R changed.
        .meanwhile(exactlyTimes(5, on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2003; })
                  .describe("a datagram that B delivers on port 2003")
                  .within(10.0)))
        // ... each with 100 octets of payload.
        .meanwhile(never(on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2003 && p->getByteLength() != 100; })
                  .describe("a datagram on port 2003 that B delivers with other than 100 octets")
                  .within(10.0)))
        // Expected observation 1: an AH packet with SPI 103 on L1 ...
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isAh(p, 103); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; ttlA = ttlOf(p); return true; })
                  .describe("an AH packet with SPI 103 from A")
                  .within(3.0))
        // ... and on L2, with a TTL or Hop Limit one lower.
        .once(on("router.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isAh(p, 103); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(ttlOf(p) == ttlA - 1, "R forwarded the AH packet with TTL or Hop Limit " + num(ttlOf(p)) + ", where A sent " + num(ttlA)); })
                  .describe("the AH packet with SPI 103 from R onto L2")
                  .within(0.1));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4302_ah_across_router compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;

// the path: host A on L1, router R, host B on L2 (IPv4).
network IpsecPath
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='router' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='router' names='eth1' address='10.0.2.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='eth0' address='10.0.2.11' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        hostA: StandardHost { @display("p=100,250"); }
        router: Router { @display("p=300,250"); }
        hostB: StandardHost { @display("p=500,250"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++;
        router.ethg++ <--> Eth100M <--> hostB.ethg++;
}

%inifile: omnetpp.ini

[General]
network = IpsecPath
sim-time-limit = 11s
seed-set = 0
*.host*.ipv4.hasIpsec = true
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].localPort = 1003
*.hostA.app[0].destAddresses = "10.0.2.11"
*.hostA.app[0].destPort = 2003
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 1s
*.hostA.app[0].stopTime = 5.5s
*.hostA.app[0].sendInterval = 1s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 2003
*.hostA.ipv4.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>UDP</Protocol><RemotePort>2003</RemotePort></Selector><Direction>OUT</Direction><Action>PROTECT</Action><Protection>AH</Protection><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>103</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")
*.hostB.ipv4.ipsec.spdConfig = xml("<spd><SecurityPolicy><Selector><Protocol>UDP</Protocol><LocalPort>2003</LocalPort></Selector><Direction>IN</Direction><Action>PROTECT</Action><Protection>AH</Protection><AuthenticationAlg>HMAC_SHA2_256_128</AuthenticationAlg><SecurityAssociation><SPI>103</SPI></SecurityAssociation></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>OUT</Direction><Action>DISCARD</Action></SecurityPolicy><SecurityPolicy><Selector></Selector><Direction>IN</Direction><Action>DISCARD</Action></SecurityPolicy></spd>")

%contains: stdout
PROTOCOLTEST rfc4302_ah_across_router: PASS
