%description:
IEEE 802.1CB-2017 7.5 and 7.4.3.4: individual recovery reloads on duplicate and rogue numbered drops.
The frame trace is a declared input. Production VectorStreamMerger receives it through its gate.
The protocol observer verifies all input contents/times and the exact output order and cardinality.
See vector-recovery.md, VRA-2, for the requirement, before/after behavior and limits.

%includes:
#include "ProtocolTest.h"
#include "FrameSource.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::frertest;

Define_ProtocolTestProgram()
{
    ProtocolTest test("vector_recovery_individual_timeout");
    test.meanwhile(exactlyTimes(5, on("merger").signal("packetPushedIn").within(0.06)));
    test.meanwhile(exactlyTimes(2, on("merger").signal("packetPushedOut").within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "first"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "first", "a", 50000, 1000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "duplicate"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "duplicate", "a", 50000, 9000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "rogueReload"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "rogueReload", "a", 0, 15000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "stillRogue"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "stillRogue", "a", 0, 20000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "afterTimeout"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "afterTimeout", "a", 0, 30000);
        }).within(0.06)));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "first", "merged", 50000, 1000);
        }).within(0.06));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "afterTimeout", "merged", 0, 30000);
        }).within(0.06));
    return test;
}

%activity:
// The framework attaches its observer to the network after initialization.

%file: test.ned
import inet.protocolelement.redundancy.VectorStreamMerger;
import inet.queueing.sink.PassivePacketSink;
simple FrameSource {
    parameters:
        @class(::inet::frertest::FrameSource);
        object frames;
    gates:
        output out;
}
network VectorRecoveryNet {
    submodules:
        source: FrameSource;
        merger: VectorStreamMerger;
        sink: PassivePacketSink;
    connections:
        source.out --> merger.in;
        merger.out --> sink.in;
}

%inifile: omnetpp.ini
[General]
network = VectorRecoveryNet
sim-time-limit = 70ms
seed-set = 0
cmdenv-event-banners = false
**.cmdenv-log-level = off
*.merger.historyLength = 5
*.merger.mapping = {a: "merged"}
*.merger.resetTimeout = 10ms
*.merger.individualRecovery = true
*.source.frames = ["1000,a,50000,first", "9000,a,50000,duplicate", "15000,a,0,rogueReload", "20000,a,0,stillRogue", "30000,a,0,afterTimeout"]

%contains: stdout
PROTOCOLTEST vector_recovery_individual_timeout: PASS
