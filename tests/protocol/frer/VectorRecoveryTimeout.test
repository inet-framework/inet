%description:
IEEE 802.1CB-2017 7.4.3.1-.4: accepted frames reload, ordinary numbered drops do not reload, expiration permits a new initial number.
The frame trace is a declared input. Production VectorStreamMerger receives it through its gate.
The protocol observer verifies all input contents/times and the exact output order and cardinality.
See vector-recovery.md, VRA-2, for the requirement, before/after behavior and limits.

%includes:
#include "ProtocolTest.h"
#include "FrameSource.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::frertest;

Define_ProtocolTestProgram()
{
    ProtocolTest test("vector_recovery_timeout");
    test.meanwhile(exactlyTimes(7, on("merger").signal("packetPushedIn").within(0.06)));
    test.meanwhile(exactlyTimes(4, on("merger").signal("packetPushedOut").within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "first"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "first", "a", 50000, 1000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "duplicate"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "duplicate", "b", 50000, 9000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "restart"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "restart", "a", 0, 11000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "restartDuplicate"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "restartDuplicate", "b", 0, 12000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "acceptedReload"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "acceptedReload", "a", 1, 20000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "rogue"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "rogue", "a", 50000, 29000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "afterTimeout"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "afterTimeout", "b", 50000, 30000);
        }).within(0.06)));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "first", "merged", 50000, 1000);
        }).within(0.06));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "restart", "merged", 0, 11000);
        }).within(0.06));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "acceptedReload", "merged", 1, 20000);
        }).within(0.06));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "afterTimeout", "merged", 50000, 30000);
        }).within(0.06));
    return test;
}

%activity:
// The framework attaches its observer to the network after initialization.

%file: test.ned
import inet.protocolelement.redundancy.VectorStreamMerger;
import inet.queueing.sink.PassivePacketSink;
simple FrameSource {
    parameters:
        @class(::inet::frertest::FrameSource);
        object frames;
    gates:
        output out;
}
network VectorRecoveryNet {
    submodules:
        source: FrameSource;
        merger: VectorStreamMerger;
        sink: PassivePacketSink;
    connections:
        source.out --> merger.in;
        merger.out --> sink.in;
}

%inifile: omnetpp.ini
[General]
network = VectorRecoveryNet
sim-time-limit = 70ms
seed-set = 0
cmdenv-event-banners = false
**.cmdenv-log-level = off
*.merger.historyLength = 5
*.merger.mapping = {a: "merged", b: "merged"}
*.merger.resetTimeout = 10ms
*.source.frames = ["1000,a,50000,first", "9000,b,50000,duplicate", "11000,a,0,restart", "12000,b,0,restartDuplicate", "20000,a,1,acceptedReload", "29000,a,50000,rogue", "30000,b,50000,afterTimeout"]

%contains: stdout
PROTOCOLTEST vector_recovery_timeout: PASS
