%description:
IEEE 802.1CB-2017 7.4.3.4 and 10.4.1.9: accepted tagless frames preserve first-number acceptance and reload the timer without marking numbered history.
The frame trace is a declared input. Production VectorStreamMerger receives it through its gate.
The protocol observer verifies all input contents/times and the exact output order and cardinality.
See vector-recovery.md, VRA-2, for the requirement, before/after behavior and limits.

%includes:
#include "ProtocolTest.h"
#include "FrameSource.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::frertest;

Define_ProtocolTestProgram()
{
    ProtocolTest test("vector_recovery_tagless_accept");
    test.meanwhile(exactlyTimes(6, on("merger").signal("packetPushedIn").within(0.06)));
    test.meanwhile(exactlyTimes(4, on("merger").signal("packetPushedOut").within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "taglessFirst"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "taglessFirst", "a", -1, 1000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "firstNumbered"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "firstNumbered", "a", 50000, 2000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "taglessReload"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "taglessReload", "b", -1, 10000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "duplicate"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "duplicate", "a", 50000, 15000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "stillDuplicate"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "stillDuplicate", "b", 50000, 19000);
        }).within(0.06)));
    test.meanwhile(exactlyTimes(1, on("merger").signal("packetPushedIn")
        .filterEvent([](const MatchContext& c) { return !strcmp(c.event.packet->getName(), "afterTimeout"); })
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "afterTimeout", "a", 0, 20000);
        }).within(0.06)));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "taglessFirst", "merged", -1, 1000);
        }).within(0.06));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "firstNumbered", "merged", 50000, 2000);
        }).within(0.06));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "taglessReload", "merged", -1, 10000);
        }).within(0.06));
    test.once(on("merger").signal("packetPushedOut").first()
        .assertEvent([](const MatchContext& c) {
            return frameMatches(c.event.packet, c.event.time, "afterTimeout", "merged", 0, 20000);
        }).within(0.06));
    return test;
}

%activity:
// The framework attaches its observer to the network after initialization.

%file: test.ned
import inet.protocolelement.redundancy.VectorStreamMerger;
import inet.queueing.sink.PassivePacketSink;
simple FrameSource {
    parameters:
        @class(::inet::frertest::FrameSource);
        object frames;
    gates:
        output out;
}
network VectorRecoveryNet {
    submodules:
        source: FrameSource;
        merger: VectorStreamMerger;
        sink: PassivePacketSink;
    connections:
        source.out --> merger.in;
        merger.out --> sink.in;
}

%inifile: omnetpp.ini
[General]
network = VectorRecoveryNet
sim-time-limit = 70ms
seed-set = 0
cmdenv-event-banners = false
**.cmdenv-log-level = off
*.merger.historyLength = 5
*.merger.mapping = {a: "merged", b: "merged"}
*.merger.resetTimeout = 10ms
*.merger.takeNoSequence = true
*.source.frames = ["1000,a,-1,taglessFirst", "2000,a,50000,firstNumbered", "10000,b,-1,taglessReload", "15000,a,50000,duplicate", "19000,b,50000,stillDuplicate", "20000,a,0,afterTimeout"]

%contains: stdout
PROTOCOLTEST vector_recovery_tagless_accept: PASS
