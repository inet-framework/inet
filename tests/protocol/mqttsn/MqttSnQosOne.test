%description:
Production client retransmits QoS 1 with the original id and DUP after lost PUBACK, then releases the queued second publication.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    return ProtocolTest("MqttSnQosOne").once(on("gateway.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
}

%activity:
EV << "MQTT-SN deterministic scenario compiled\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnScriptedPeer"
*.gateway.app[0].script = xml("<script><expect type='4'/><send type='5'/><expect type='12' qos='1' messageId='1' dup='0' payload='41'/><expect type='12' qos='1' messageId='1' dup='1' payload='41'/><send type='13' topicId='29812' messageId='1'/><expect type='12' qos='1' messageId='2' payload='42'/><send type='13' topicId='29812' messageId='2'/></script>")
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnClient"
*.sensor.app[0].gatewayAddress = "gateway"
*.sensor.app[0].startTime = 0.1s
*.sensor.app[0].keepAlive = 0s
*.sensor.app[0].retryInterval = 100ms
*.sensor.app[0].retryCount = 2
*.sensor.app[0].workload = xml("<mqttsn><publish at='0s' topic='tt' topicKind='2' qos='1' payload='41'/><publish at='0s' topic='tt' topicKind='2' qos='1' payload='42'/></mqttsn>")

%contains: stdout
PROTOCOLTEST MqttSnQosOne: PASS
