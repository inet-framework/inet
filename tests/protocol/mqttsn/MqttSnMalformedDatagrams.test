%description:
Malformed datagrams before and after acceptance do not allocate topics or prevent the next valid request.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    return ProtocolTest("MqttSnMalformedDatagrams")
        .once(on("sensor.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
}

%activity:
EV << "MQTT-SN bounded fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnScriptedPeer"
*.sensor.app[0].script = xml("<script><send after='100ms' raw='01000404'/><send raw='070c0300010000'/><send type='4' flags='4' duration='30' clientId='script'/><expect type='5'/><send raw='080c0000010000'/><send type='10' messageId='1' topic='healthy'/><expect type='11' messageId='1' topicId='1' code='0'/><send type='24'/><expect type='24'/></script>")
*.sensor.app[0].remoteAddress = "gateway"
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnGateway"
*.gateway.app[0].brokerAddress = "broker"
*.gateway.app[0].advertise = false
*.gateway.app[0].retryInterval = 100ms
*.gateway.app[0].retryCount = 2

%contains: stdout
PROTOCOLTEST MqttSnMalformedDatagrams: PASS
