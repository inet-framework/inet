%description:
QoS 2 accepts error PUBACK before PUBREC, repairs registration, ignores accepted PUBACK and a late old-phase error, and completes PUBREL.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    ProtocolTest test("MqttSnQosTwoErrors");
    test.once(on("gateway.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
    return test;
}

%activity:
EV << "MQTT-SN deterministic fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnScriptedPeer"
*.gateway.app[0].script = xml("<script><expect type='4'/><send type='5'/><expect type='10' messageId='1' topic='value'/><send type='11' messageId='1' topicId='5'/><expect type='12' messageId='2' topicId='5' qos='2'/><send type='13' messageId='2' topicId='5' code='2'/><expect type='10' messageId='3' topic='value'/><send type='11' messageId='3' topicId='6'/><expect type='12' messageId='4' topicId='6'/><send type='13' messageId='4' topicId='6' code='0'/><wait timeout='20ms' forbidType='16'/><send type='15' messageId='4'/><expect type='16' messageId='4'/><send type='13' messageId='4' topicId='6' code='2'/><wait timeout='20ms' forbidType='10'/><send type='14' messageId='4'/></script>")
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnClient"
*.sensor.app[0].gatewayAddress = "gateway"
*.sensor.app[0].startTime = 0.1s
*.sensor.app[0].keepAlive = 0s
*.sensor.app[0].retryInterval = 100ms
*.sensor.app[0].retryCount = 2
*.sensor.app[0].workload = xml("<mqttsn><publish at='0s' topic='value' qos='2' payload='41'/></mqttsn>")

%contains: stdout
PROTOCOLTEST MqttSnQosTwoErrors: PASS
