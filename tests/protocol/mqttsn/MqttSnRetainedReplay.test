%description:
Duplicate SUBSCRIBE replays only SUBACK; a new DUP=0 request replays retained data. Empty retained publication deletes replay state.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    return ProtocolTest("MqttSnRetainedReplay")
        .once(on("sensor.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
}

%activity:
EV << "MQTT-SN session boundary fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnScriptedPeer"
*.sensor.app[0].remoteAddress = "gateway"
*.sensor.app[0].script = xml("<script><send after='100ms' type='4' flags='4' duration='30' clientId='script'/><expect type='5'/><send type='10' messageId='1' topic='data'/><expect type='11' messageId='1' topicId='1'/><send type='12' flags='48' messageId='1' topicId='1' payload='41'/><expect type='13' messageId='1'/><send type='18' flags='32' messageId='2' topic='data'/><expect type='19' messageId='2' topicId='1'/><expect type='12' messageId='1' topicId='1' payload='41'/><send type='13' messageId='1' topicId='1'/><send type='18' flags='160' messageId='2' topic='data'/><expect type='19' messageId='2'/><wait timeout='200ms' forbidType='12'/><send type='18' flags='32' messageId='2' topic='data'/><expect type='19' messageId='2'/><expect type='12' messageId='2' payload='41'/><send type='13' messageId='2' topicId='1'/><send type='12' flags='48' messageId='3' topicId='1'/><expect type='13' messageId='3'/><expect type='12' messageId='3' payload=''/><send type='13' messageId='3' topicId='1'/><send type='20' messageId='4' topic='data'/><expect type='21' messageId='4'/><send type='18' flags='32' messageId='5' topic='data'/><expect type='19' messageId='5'/><wait timeout='200ms' forbidType='12'/><send type='24'/><expect type='24'/></script>")
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnGateway"
*.gateway.app[0].brokerAddress = "broker"
*.gateway.app[0].advertise = false
*.gateway.app[0].retryInterval = 100ms

%contains: stdout
PROTOCOLTEST MqttSnRetainedReplay: PASS
