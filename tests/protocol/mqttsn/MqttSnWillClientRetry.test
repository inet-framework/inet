%description:
Client repeats Will replies and retries each independent Will update after a missing response.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    return ProtocolTest("MqttSnWillClientRetry")
        .once(on("gateway.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
}

%activity:
EV << "MQTT-SN bounded fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnScriptedPeer"
*.gateway.app[0].script = xml("<script><expect type='4'/><send type='6'/><expect type='7' topic='w'/><send type='6'/><expect type='7' topic='w'/><send type='8'/><expect type='9' payload='41'/><send type='8'/><expect type='9' payload='41'/><send type='5'/><expect type='26' topic='w2'/><expect type='26' topic='w2'/><send type='27'/><expect type='28' payload='42'/><expect type='28' payload='42'/><send type='29'/></script>")
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnClient"
*.sensor.app[0].gatewayAddress = "gateway"
*.sensor.app[0].startTime = 0.1s
*.sensor.app[0].keepAlive = 0s
*.sensor.app[0].retryInterval = 100ms
*.sensor.app[0].retryCount = 2
*.sensor.app[0].workload = xml("<mqttsn><willTopic at='0s' topic='w2'/><willMessage at='0s' payload='42'/></mqttsn>")
*.sensor.app[0].willTopic = "w"
*.sensor.app[0].willPayload = "41"

%contains: stdout
PROTOCOLTEST MqttSnWillClientRetry: PASS
