%description:
An invalid normal-topic QoS 0 error repairs registration before later data.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    ProtocolTest test("MqttSnQosZeroRepair");
    test.once(on("gateway.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
    return test;
}

%activity:
EV << "MQTT-SN deterministic fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnScriptedPeer"
*.gateway.app[0].script = xml("<script><expect type='4'/><send type='5'/><expect type='10' messageId='1'/><send type='11' topicId='1' messageId='1'/><expect type='12' topicId='1' messageId='0' payload='41'/><send type='13' messageId='0' topicId='1' code='2'/><expect type='10' messageId='2'/><send type='11' topicId='2' messageId='2'/><expect type='12' topicId='2' messageId='0' payload='42'/></script>")
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnClient"
*.sensor.app[0].gatewayAddress = "gateway"
*.sensor.app[0].startTime = 0.1s
*.sensor.app[0].keepAlive = 0s
*.sensor.app[0].retryInterval = 100ms
*.sensor.app[0].retryCount = 2
*.sensor.app[0].workload = xml("<mqttsn><publish at='0s' topic='normal' payload='41'/><publish at='100ms' topic='normal' payload='42'/></mqttsn>")
*.sensor.app[0].congestionWait = 500ms


%contains: stdout
PROTOCOLTEST MqttSnQosZeroRepair: PASS
