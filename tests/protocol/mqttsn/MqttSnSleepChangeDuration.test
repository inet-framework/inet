%description:
A changed sleep duration replaces the old deadline; ordinary disconnect ends the retained relationship.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    ProtocolTest test("MqttSnSleepChangeDuration");
    test.once(on("sensor.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
    return test;
}

%activity:
EV << "MQTT-SN deterministic fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnScriptedPeer"
*.sensor.app[0].script = xml("<script><send after='100ms' type='4' flags='4' duration='1' clientId='script'/><expect type='5'/><send type='24' duration='1'/><expect type='24'/><send after='500ms' type='24' duration='3'/><expect type='24'/><wait timeout='1700ms' forbidType='12'/><send type='22' clientId='script'/><expect type='23'/><send type='24'/><expect type='24'/></script>")
*.sensor.app[0].remoteAddress = "gateway"
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnGateway"
*.gateway.app[0].brokerAddress = "broker"
*.gateway.app[0].advertise = false
*.gateway.app[0].retryInterval = 100ms
*.gateway.app[0].retryCount = 2
*.observer.numApps = 1
*.observer.app[0].typename = "MqttClient"
*.observer.app[0].connectAddress = "broker"
*.observer.app[0].clientIdentifier = "publisher"
*.observer.app[0].workload = xml("<mqtt/>")


%contains: stdout
PROTOCOLTEST MqttSnSleepChangeDuration: PASS
