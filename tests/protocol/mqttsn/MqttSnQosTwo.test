%description:
Production client retries PUBLISH, transitions to PUBREL, repeats PUBREL for duplicate PUBREC and timeout, and releases a later publication.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    return ProtocolTest("MqttSnQosTwo").once(on("gateway.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
}

%activity:
EV << "MQTT-SN deterministic scenario compiled\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnScriptedPeer"
*.gateway.app[0].script = xml("<script><expect type='4'/><send type='5'/><expect type='12' qos='2' messageId='1' dup='0'/><expect type='12' qos='2' messageId='1' dup='1'/><send type='15' messageId='1'/><expect type='16' messageId='1'/><send type='15' messageId='1'/><expect type='16' messageId='1'/><expect type='16' messageId='1'/><send type='14' messageId='1'/><expect type='12' messageId='2'/><send type='15' messageId='2'/><expect type='16' messageId='2'/><send type='14' messageId='2'/></script>")
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnClient"
*.sensor.app[0].gatewayAddress = "gateway"
*.sensor.app[0].startTime = 0.1s
*.sensor.app[0].keepAlive = 0s
*.sensor.app[0].retryInterval = 100ms
*.sensor.app[0].retryCount = 2
*.sensor.app[0].workload = xml("<mqttsn><publish at='0s' topic='tt' topicKind='2' qos='2' payload='41'/><publish at='0s' topic='tt' topicKind='2' qos='2' payload='42'/></mqttsn>")

%contains: stdout
PROTOCOLTEST MqttSnQosTwo: PASS
