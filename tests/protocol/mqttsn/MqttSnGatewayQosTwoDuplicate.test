%description:
Gateway downlink QoS 2 receiver suppresses duplicate PUBLISH handoff, answers repeated PUBREL and permits completed identifier reuse.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    ProtocolTest test("MqttSnGatewayQosTwoDuplicate");
    test.meanwhile(exactlyTimes(2,on("observer.app[0]").signal("packetSentToUpper").within(2.5)));
    test.meanwhile(exactlyTimes(1,on("observer.app[0]").signal("packetSentToUpper").filterEvent([](const MatchContext& c) {
        return c.event.packet->peekDataAsBytes()->getBytes() == std::vector<uint8_t>({65});
    }).within(2.5)));
    test.meanwhile(exactlyTimes(1,on("observer.app[0]").signal("packetSentToUpper").filterEvent([](const MatchContext& c) {
        return c.event.packet->peekDataAsBytes()->getBytes() == std::vector<uint8_t>({66});
    }).within(2.5)));
    test.once(on("sensor.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
    return test;
}

%activity:
EV << "MQTT-SN deterministic fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnScriptedPeer"
*.sensor.app[0].script = xml("<script><send after='100ms' type='4' flags='4' duration='30' clientId='script'/><expect type='5'/><send type='12' flags='66' topicId='29812' messageId='7' payload='41'/><expect type='15' messageId='7'/><send type='12' flags='194' topicId='29812' messageId='7' payload='41'/><expect type='15' messageId='7'/><send type='16' messageId='7'/><expect type='14' messageId='7'/><send type='16' messageId='7'/><expect type='14' messageId='7'/><send type='12' flags='66' topicId='29812' messageId='7' payload='42'/><expect type='15' messageId='7'/><send type='16' messageId='7'/><expect type='14' messageId='7'/><send type='24'/><expect type='24'/></script>")
*.sensor.app[0].remoteAddress = "gateway"
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnGateway"
*.gateway.app[0].brokerAddress = "broker"
*.gateway.app[0].advertise = false
*.gateway.app[0].retryInterval = 100ms
*.gateway.app[0].retryCount = 2
*.observer.numApps = 1
*.observer.app[0].typename = "MqttClient"
*.observer.app[0].connectAddress = "broker"
*.observer.app[0].clientIdentifier = "publisher"
*.observer.app[0].workload = xml("<mqtt><subscribe at='0s' filter='tt' qos='2'/></mqtt>")

%contains: stdout
PROTOCOLTEST MqttSnGatewayQosTwoDuplicate: PASS
