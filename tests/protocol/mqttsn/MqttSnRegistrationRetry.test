%description:
An unfamiliar downlink topic waits behind REGISTER/REGACK, including a lost first REGACK.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    ProtocolTest test("MqttSnRegistrationRetry");
    test.once(on("sensor.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
    return test;
}

%activity:
EV << "MQTT-SN deterministic fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnScriptedPeer"
*.sensor.app[0].script = xml("<script><send after='100ms' type='4' flags='4' duration='30' clientId='script'/><expect type='5'/><send type='18' flags='32' messageId='1' topic='data/+'/><expect type='19' messageId='1' topicId='0'/><expect type='10' topicId='1' messageId='1' topic='data/one'/><expect type='10' topicId='1' messageId='1' topic='data/one'/><send type='11' topicId='1' messageId='1'/><expect type='12' topicId='1' messageId='2' payload='41'/><send type='13' topicId='1' messageId='2'/><send type='24'/><expect type='24'/></script>")
*.sensor.app[0].remoteAddress = "gateway"
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnGateway"
*.gateway.app[0].brokerAddress = "broker"
*.gateway.app[0].advertise = false
*.gateway.app[0].retryInterval = 100ms
*.gateway.app[0].retryCount = 2
*.observer.numApps = 1
*.observer.app[0].typename = "MqttClient"
*.observer.app[0].connectAddress = "broker"
*.observer.app[0].clientIdentifier = "publisher"
*.observer.app[0].workload = xml("<mqtt><publish at='500ms' topic='data/one' qos='1' payload='41'/></mqtt>")


%contains: stdout
PROTOCOLTEST MqttSnRegistrationRetry: PASS
