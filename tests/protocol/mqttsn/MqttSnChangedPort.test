%description:
A ClientId reconnects from a new UDP port; the obsolete endpoint cannot mutate its topic table.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    return ProtocolTest("MqttSnChangedPort")
        .once(on("sensor.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
}

%activity:
EV << "MQTT-SN session boundary fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnScriptedPeer"
*.sensor.app[0].remoteAddress = "gateway"
*.sensor.app[0].script = xml("<script><send after='100ms' type='4' duration='30' clientId='same'/><expect type='5'/><wait timeout='600ms'/><send type='10' messageId='1' topic='obsolete'/><expect type='24'/></script>")
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnGateway"
*.gateway.app[0].brokerAddress = "broker"
*.gateway.app[0].advertise = false
*.gateway.app[0].retryInterval = 100ms
*.secondSensor.numApps = 1
*.secondSensor.app[0].typename = "MqttSnScriptedPeer"
*.secondSensor.app[0].localPort = 1885
*.secondSensor.app[0].remoteAddress = "gateway"
*.secondSensor.app[0].script = xml("<script><send after='500ms' type='4' duration='30' clientId='same'/><expect type='5'/><send type='10' messageId='1' topic='current'/><expect type='11' topicId='1' messageId='1' code='0'/><send type='24'/><expect type='24'/></script>")

%contains: stdout
PROTOCOLTEST MqttSnChangedPort: PASS
