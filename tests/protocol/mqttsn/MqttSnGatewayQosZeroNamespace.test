%description:
A predefined QoS 0 error at the gateway cannot erase a normal binding with the same numeric id.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    ProtocolTest test("MqttSnGatewayQosZeroNamespace");
    test.once(on("sensor.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
    return test;
}

%activity:
EV << "MQTT-SN deterministic fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnScriptedPeer"
*.sensor.app[0].script = xml("<script><send after='100ms' type='4' flags='4' duration='30' clientId='script'/><expect type='5'/><send type='10' messageId='1' topic='normal'/><expect type='11' topicId='1' messageId='1'/><send type='18' messageId='2' topic='#'/><expect type='19' messageId='2' topicId='0'/><expect type='12' topicId='1' flags='1' payload='41'/><send type='13' topicId='1' messageId='0' code='2'/><expect type='12' topicId='1' flags='0' payload='42'/><send type='24'/><expect type='24'/></script>")
*.sensor.app[0].remoteAddress = "gateway"
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnGateway"
*.gateway.app[0].brokerAddress = "broker"
*.gateway.app[0].advertise = false
*.gateway.app[0].retryInterval = 100ms
*.gateway.app[0].retryCount = 2
*.observer.numApps = 1
*.observer.app[0].typename = "MqttClient"
*.observer.app[0].connectAddress = "broker"
*.observer.app[0].clientIdentifier = "publisher"
*.observer.app[0].workload = xml("<mqtt><publish at='500ms' topic='predefined' payload='41'/><publish at='700ms' topic='normal' payload='42'/></mqtt>")

*.gateway.app[0].predefinedTopics = xml("<topics><topic id='1' name='predefined'/></topics>")
%contains: stdout
PROTOCOLTEST MqttSnGatewayQosZeroNamespace: PASS
