%description:
Client retry exhaustion: original CONNECT plus exactly two retransmissions, then a quiet interval before reconnection.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    return ProtocolTest("MqttSnConnectRetry").once(on("gateway.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
}

%activity:
EV << "MQTT-SN deterministic scenario compiled\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 0.46s
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnScriptedPeer"
*.gateway.app[0].script = xml("<script><expect type='4'/><expect type='4'/><expect type='4'/><wait timeout='150ms' forbidType='4'/></script>")
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnClient"
*.sensor.app[0].gatewayAddress = "gateway"
*.sensor.app[0].startTime = 0.1s
*.sensor.app[0].keepAlive = 0s
*.sensor.app[0].retryInterval = 100ms
*.sensor.app[0].retryCount = 2
*.sensor.app[0].workload = xml("<mqttsn></mqttsn>")

%contains: stdout
PROTOCOLTEST MqttSnConnectRetry: PASS
