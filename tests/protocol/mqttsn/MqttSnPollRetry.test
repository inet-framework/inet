%description:
A missing drain PINGRESP causes bounded polling retry without a second QoS2 application handoff.

%includes:
#include "ProtocolTest.h"

%file: peer.cc
#include "../../../../networks/mqttsn/MqttSnScriptedPeer.cc"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram() {
    ProtocolTest test("MqttSnPollRetry");
    test.meanwhile(exactlyTimes(1,on("sensor.app[0]").signal("packetSentToUpper").within(2.5)));
    test.once(on("gateway.app[0]").signal("scenarioComplete").filterValue(1).within(2.9));
    return test;
}

%activity:
EV << "MQTT-SN deterministic fault fixture\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqttsn.MqttSnTestNetwork
seed-set = 0
sim-time-limit = 3s
*.gateway.numApps = 1
*.gateway.app[0].typename = "MqttSnScriptedPeer"
*.gateway.app[0].script = xml("<script><expect type='4'/><send type='5'/><expect type='24'/><send type='24'/><expect type='22' clientId='sensor'/><send type='12' flags='66' topicId='29812' messageId='7' payload='41'/><expect type='15' messageId='7'/><send type='16' messageId='7'/><expect type='14' messageId='7'/><expect type='22' clientId='sensor'/><send type='23'/><wait timeout='200ms' forbidType='22'/></script>")
*.sensor.numApps = 1
*.sensor.app[0].typename = "MqttSnClient"
*.sensor.app[0].gatewayAddress = "gateway"
*.sensor.app[0].startTime = 0.1s
*.sensor.app[0].keepAlive = 0s
*.sensor.app[0].retryInterval = 100ms
*.sensor.app[0].retryCount = 2
*.sensor.app[0].workload = xml("<mqttsn><sleep at='0s' duration='3s'/><poll at='200ms'/></mqttsn>")
*.sensor.app[0].congestionWait = 500ms


%contains: stdout
PROTOCOLTEST MqttSnPollRetry: PASS
