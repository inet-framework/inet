%description:

RFC 7252 Sections 4.2, 4.3, 4.8.2, 5.3.2, 5.4.1 -- CoAP client response matching:
token mismatch -> RST, source IP/port mismatch -> RST, unrecognized critical
option in NON/CON response, pending NON timeout at EXCHANGE_LIFETIME (247s),
and token wrap/exhaustion & MID reservation exhaustion seams.

%includes:
#include <limits>
#include "inet/applications/coap/CoapClient.h"
#include "inet/networklayer/common/L3AddressResolver.h"
#include "CoapChecks.h"
#include "CoapTestPeer.h"
#include "CoapTestPeer.cc"
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::coap;
using namespace inet::protocoltest;

class TestSeamCoapClient : public CoapClient
{
  public:
    void setTokenTestParams(uint64_t initialVal, uint64_t remaining) {
        configureTokenGeneratorForTest(initialVal, remaining);
    }

    void setMidExhaustedForTest(uint16_t initialMid, simtime_t dur) {
        configureMidGeneratorForTest(initialMid, true, dur);
    }

    uint64_t sendManualGet(const std::string& host, int port, const std::string& uri) {
        return submitCoapRequest(L3AddressResolver().resolve(host.c_str()), port,
                COAP_CODE_GET, false, uri, {});
    }
};

Define_Module(TestSeamCoapClient);

Define_ProtocolTest(coap_response_matching)
{
    return ProtocolTest("coap_response_matching")
        // Scenario A: Client app[0] sends NON GET -> peer sends wrong token (gets RST) and wrong port (gets RST),
        // then matching token from real port 5683 completes request.
        .once(on("hostB.app[0]").signal("packetReceivedFromLower")
                  .capture("reqToken", [](const PacketEvent& ev) {
                      RawCoapMessage raw;
                      decodeRawCoap(ev.packet->peekDataAsBytes()->getBytes(), raw);
                      return cValue(bytesToHexString(raw.token).c_str());
                  })
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      if (!decodeRawCoap(ctx.event.packet->peekDataAsBytes()->getBytes(), raw))
                          return false;
                      // Inject bad token NON response from port 5683 and matching token from wrong port 5684.
                      auto *peerWrongPort = check_and_cast<CoapTestPeer *>(getSimulation()->getModuleByPath("hostB.app[1]"));
                      auto *peerRight = check_and_cast<CoapTestPeer *>(getSimulation()->getModuleByPath("hostB.app[0]"));
                      auto *srcCli = getSimulation()->getModuleByPath("hostA.app[0]");
                      (void)srcCli;
                      const auto& last = peerRight->getReceivedDatagrams().back();

                      RawCoapMessage wrongTok;
                      wrongTok.type = 1; wrongTok.code = COAP_CODE_CONTENT; wrongTok.messageId = 0x6001;
                      wrongTok.token = {0xFF, 0xEE, 0xDD, 0xCC, 0xBB, 0xAA, 0x99, 0x88};
                      wrongTok.payload = asciiBytes("wrong-tok");
                      peerRight->sendRawNow(last.srcAddr, last.srcPort, encodeRawCoap(wrongTok), "WrongTokResp");

                      RawCoapMessage wrongPortResp;
                      wrongPortResp.type = 1; wrongPortResp.code = COAP_CODE_CONTENT; wrongPortResp.messageId = 0x6002;
                      wrongPortResp.token = last.bytes.size() >= 12 ? std::vector<uint8_t>(last.bytes.begin() + 4, last.bytes.begin() + 12) : std::vector<uint8_t>();
                      wrongPortResp.payload = asciiBytes("wrong-port");
                      peerWrongPort->scheduleRawSend(simTime() + 0.05, "hostA", last.srcPort, encodeRawCoap(wrongPortResp), "WrongPortResp");

                      RawCoapMessage goodResp;
                      goodResp.type = 1; goodResp.code = COAP_CODE_CONTENT; goodResp.messageId = 0x6003;
                      goodResp.token = wrongPortResp.token;
                      goodResp.payload = asciiBytes("matched-ok");
                      peerRight->scheduleRawSend(simTime() + 0.12, "hostA", last.srcPort, encodeRawCoap(goodResp), "GoodResp");
                      return true;
                  })
                  .within(2.0))

        // Expect RST at hostB.app[0] for wrong token, RST at hostB.app[1] for wrong port, then completion.
        .once(on("hostB.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      return decodeRawCoap(ctx.event.packet->peekDataAsBytes()->getBytes(), raw)
                              && raw.type == 3 && raw.code == 0 && raw.messageId == 0x6001;
                  })
                  .within(0.5))
        .once(on("hostB.app[1]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      return decodeRawCoap(ctx.event.packet->peekDataAsBytes()->getBytes(), raw)
                              && raw.type == 3 && raw.code == 0 && raw.messageId == 0x6002;
                  })
                  .within(0.5))
        .once(on("hostA.app[0]").signal("requestCompleted").within(0.5))
        .act(action().after(0.01).run<TestSeamCoapClient>("hostA.app[0]", [](TestSeamCoapClient& cli) {
            const auto& resps = cli.getCompletedResponses();
            if (resps.size() != 1 || std::string(resps[0].payload.begin(), resps[0].payload.end()) != "matched-ok")
                throw cRuntimeError("Client did not record expected matched response");
        }))

        // Scenario B: Critical option in CON response -> client sends RST and fails request.
        .act(action().at(2.0).run<TestSeamCoapClient>("hostA.app[0]", [](TestSeamCoapClient& cli) {
            cli.sendManualGet("hostB", 5683, "/crit-test");
        }))
        .once(on("hostB.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      auto *peer = check_and_cast<CoapTestPeer *>(getSimulation()->getModuleByPath("hostB.app[0]"));
                      const auto& last = peer->getReceivedDatagrams().back();
                      RawCoapMessage critResp;
                      critResp.type = 0; // CON response
                      critResp.code = COAP_CODE_CONTENT;
                      critResp.messageId = 0x7001;
                      critResp.token.assign(last.bytes.begin() + 4, last.bytes.begin() + 12);
                      critResp.options.push_back({99, {0x01}}); // Unknown critical option
                      critResp.payload = asciiBytes("bad");
                      peer->sendRawNow(last.srcAddr, last.srcPort, encodeRawCoap(critResp), "CritConResp");
                      return true;
                  })
                  .within(0.5))
        .once(on("hostB.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      return decodeRawCoap(ctx.event.packet->peekDataAsBytes()->getBytes(), raw)
                              && raw.type == 3 && raw.code == 0 && raw.messageId == 0x7001;
                  })
                  .within(0.5))
        .act(action().after(0.01).run<TestSeamCoapClient>("hostA.app[0]", [](TestSeamCoapClient& cli) {
            if (cli.getFailedCount() != 1)
                throw cRuntimeError("Expected failedCount=1 after bad critical option in response");
        }))

        // Scenario C: Pending NON request times out after EXCHANGE_LIFETIME (247s).
        .act(action().at(3.0).run<TestSeamCoapClient>("hostA.app[0]", [](TestSeamCoapClient& cli) {
            cli.sendManualGet("hostB", 5683, "/timeout-test");
        }))
        .once(on("hostA.app[0]").signal("requestFailed").within(250.0))
        .act(action().after(0.01).run<TestSeamCoapClient>("hostA.app[0]", [](TestSeamCoapClient& cli) {
            if (cli.getFailedCount() != 2 || simTime() < 249.5)
                throw cRuntimeError("Expected timeout around 250s, got t=%s", simTime().str().c_str());
        }))

        // Scenario D: Token wrap (UINT64_MAX -> 0 -> exhausted) & MID exhaustion reject cleanly via capacityRejected.
        .meanwhile(exactlyTimes(2, on("hostA.app[0]").signal("capacityRejected").within(7.0)))
        .act(action().at(255.0).run<TestSeamCoapClient>("hostA.app[0]", [](TestSeamCoapClient& cli) {
            cli.setTokenTestParams(std::numeric_limits<uint64_t>::max(), 2);
            if (cli.sendManualGet("hostB", 5683, "/wrap1") == 0)
                throw cRuntimeError("Expected wrap1 token allocation to succeed");
            if (cli.sendManualGet("hostB", 5683, "/wrap2") == 0)
                throw cRuntimeError("Expected wrap2 (wrapped to 0) allocation to succeed");
            if (cli.sendManualGet("hostB", 5683, "/exhaust") != 0)
                throw cRuntimeError("Expected token exhaustion to return 0 cleanly");
        }))
        .act(action().at(256.0).run<TestSeamCoapClient>("hostA.app[0]", [](TestSeamCoapClient& cli) {
            cli.setTokenTestParams(1000, 100);
            cli.setMidExhaustedForTest(0x1234, 10.0);
            if (cli.sendManualGet("hostB", 5683, "/mid-exhaust") != 0)
                throw cRuntimeError("Expected MID exhaustion to return 0 cleanly");
        }))
        // Let the 2s meanwhile guard close cleanly after both actions run.
        .never(on("hostA.app[0]").signal("requestAborted").within(1.5));
}

%activity:
EV << "coap_response_matching compiled\n";

%file: TestSeamCoapClient.ned
import inet.applications.coap.CoapClient;

simple TestSeamCoapClient extends CoapClient
{
    parameters:
        @class(TestSeamCoapClient);
}

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.coap.CoapPairNetwork
sim-time-limit = 270s
seed-set = 0
*.tester.testName = "coap_response_matching"

*.hostA.numApps = 1
*.hostA.app[0].typename = "TestSeamCoapClient"
*.hostA.app[0].peerAddress = "hostB"
*.hostA.app[0].confirmable = false
*.hostA.app[0].requestUri = "/hello"
*.hostA.app[0].startTime = 0.5s
*.hostA.app[0].numRequests = 1

*.hostB.numApps = 2
*.hostB.app[0].typename = "CoapTestPeer"
*.hostB.app[0].localPort = 5683
*.hostB.app[1].typename = "CoapTestPeer"
*.hostB.app[1].localPort = 5684

%contains: stdout
PROTOCOLTEST coap_response_matching: PASS
