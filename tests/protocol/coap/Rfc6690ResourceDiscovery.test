%description:

RFC 6690 Section 4 -- CoRE Link Format resource discovery at /.well-known/core,
Content-Format 40, attribute formatting (rt, if, ct, title, obs), href/rt/if
prefix and space-delimited token filtering, deleted resource omission, 4.06
Accept check, and 4.05 method restriction.

%includes:
#include "inet/applications/coap/CoapClient.h"
#include "inet/applications/coap/CoapServer.h"
#include "CoapChecks.h"
#include "CoapTestPeer.h"
#include "CoapTestPeer.cc"
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::coap;
using namespace inet::protocoltest;

Define_ProtocolTest(coap_resource_discovery)
{
    return ProtocolTest("coap_resource_discovery")
        // 1. Unfiltered GET /.well-known/core -> Content-Format=40, existing resources only (with ;obs)
        .act(action().at(1.0).run<CoapTestPeer>("hostA.app[0]", [](CoapTestPeer& peer) {
            RawCoapMessage req;
            req.type = 0; req.code = COAP_CODE_GET; req.messageId = 0x3001; req.token = {0x01};
            req.options.push_back({COAP_OPT_URI_PATH, asciiBytes(".well-known")});
            req.options.push_back({COAP_OPT_URI_PATH, asciiBytes("core")});
            peer.sendRawNow("hostB", 5683, encodeRawCoap(req), "GetCoreAll");
        }))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      if (!extractRawCoapFromAppEvent(ctx.event, raw))
                          return false;
                      auto cts = getRawOptionValues(raw, COAP_OPT_CONTENT_FORMAT);
                      std::string body = rawPayloadString(raw);
                      return raw.code == COAP_CODE_CONTENT && raw.messageId == 0x3001
                              && cts.size() == 1 && coapDecodedUint(cts[0]) == 40
                              && body.find("</sensors/temp>;rt=\"temperature-c\";if=\"sensor core.s\";ct=0;title=\"Temperature\";obs") != std::string::npos
                              && body.find("</actuators/led>;rt=\"light-lux\";if=\"actuator\";ct=0") != std::string::npos
                              && body.find("/actuators/absent") == std::string::npos;
                  })
                  .within(0.5))

        // 2. Filter queries: rt=temperature-c, if=core.*, href=/actuators/*, and non-matching rt=nonexistent
        .act(action().after(0.05).run<CoapTestPeer>("hostA.app[0]", [](CoapTestPeer& peer) {
            auto sendCoreQuery = [&](uint16_t mid, uint8_t tok, const std::string& q, const char *name) {
                RawCoapMessage req;
                req.type = 0; req.code = COAP_CODE_GET; req.messageId = mid; req.token = {tok};
                req.options.push_back({COAP_OPT_URI_PATH, asciiBytes(".well-known")});
                req.options.push_back({COAP_OPT_URI_PATH, asciiBytes("core")});
                req.options.push_back({COAP_OPT_URI_QUERY, asciiBytes(q)});
                peer.sendRawNow("hostB", 5683, encodeRawCoap(req), name);
            };
            sendCoreQuery(0x3002, 0x02, "rt=temperature-c", "QueryRtExact");
            sendCoreQuery(0x3003, 0x03, "if=core.*", "QueryIfTokenPrefix");
            sendCoreQuery(0x3004, 0x04, "href=/actuators/*", "QueryHrefPrefix");
            sendCoreQuery(0x3005, 0x05, "rt=nonexistent", "QueryEmpty");
        }))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      if (!extractRawCoapFromAppEvent(ctx.event, raw))
                          return false;
                      std::string body = rawPayloadString(raw);
                      return raw.code == COAP_CODE_CONTENT && raw.messageId == 0x3002
                              && body.find("</sensors/temp>") != std::string::npos
                              && body.find("</actuators/led>") == std::string::npos;
                  }).within(0.5))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      if (!extractRawCoapFromAppEvent(ctx.event, raw))
                          return false;
                      std::string body = rawPayloadString(raw);
                      return raw.code == COAP_CODE_CONTENT && raw.messageId == 0x3003
                              && body.find("</sensors/temp>") != std::string::npos
                              && body.find("</actuators/led>") == std::string::npos;
                  }).within(0.5))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      if (!extractRawCoapFromAppEvent(ctx.event, raw))
                          return false;
                      std::string body = rawPayloadString(raw);
                      return raw.code == COAP_CODE_CONTENT && raw.messageId == 0x3004
                              && body.find("</actuators/led>") != std::string::npos
                              && body.find("</sensors/temp>") == std::string::npos;
                  }).within(0.5))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      if (!extractRawCoapFromAppEvent(ctx.event, raw))
                          return false;
                      auto cts = getRawOptionValues(raw, COAP_OPT_CONTENT_FORMAT);
                      return raw.code == COAP_CODE_CONTENT && raw.messageId == 0x3005
                              && cts.size() == 1 && coapDecodedUint(cts[0]) == 40
                              && raw.payload.empty();
                  }).within(0.5))

        // 3. Accept mismatch (4.06), POST /.well-known/core (4.05), DELETE /actuators/led -> omitted from /.well-known/core
        .act(action().after(0.05).run<CoapTestPeer>("hostA.app[0]", [](CoapTestPeer& peer) {
            RawCoapMessage rBadAcc;
            rBadAcc.type = 0; rBadAcc.code = COAP_CODE_GET; rBadAcc.messageId = 0x3006; rBadAcc.token = {0x06};
            rBadAcc.options.push_back({COAP_OPT_URI_PATH, asciiBytes(".well-known")});
            rBadAcc.options.push_back({COAP_OPT_URI_PATH, asciiBytes("core")});
            rBadAcc.options.push_back({COAP_OPT_ACCEPT, coapUintBytes(0)});
            peer.sendRawNow("hostB", 5683, encodeRawCoap(rBadAcc), "CoreAccept0");

            RawCoapMessage rPost;
            rPost.type = 0; rPost.code = COAP_CODE_POST; rPost.messageId = 0x3007; rPost.token = {0x07};
            rPost.options.push_back({COAP_OPT_URI_PATH, asciiBytes(".well-known")});
            rPost.options.push_back({COAP_OPT_URI_PATH, asciiBytes("core")});
            peer.sendRawNow("hostB", 5683, encodeRawCoap(rPost), "CorePost");

            RawCoapMessage rDel;
            rDel.type = 0; rDel.code = COAP_CODE_DELETE; rDel.messageId = 0x3008; rDel.token = {0x08};
            rDel.options.push_back({COAP_OPT_URI_PATH, asciiBytes("actuators")});
            rDel.options.push_back({COAP_OPT_URI_PATH, asciiBytes("led")});
            peer.sendRawNow("hostB", 5683, encodeRawCoap(rDel), "DeleteLed");
        }))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      return extractRawCoapFromAppEvent(ctx.event, raw) && raw.code == COAP_CODE_NOT_ACCEPTABLE && raw.messageId == 0x3006;
                  }).within(0.5))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      return extractRawCoapFromAppEvent(ctx.event, raw) && raw.code == COAP_CODE_METHOD_NOT_ALLOWED && raw.messageId == 0x3007;
                  }).within(0.5))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      return extractRawCoapFromAppEvent(ctx.event, raw) && raw.code == COAP_CODE_DELETED && raw.messageId == 0x3008;
                  }).within(0.5))
        .act(action().after(0.05).run<CoapTestPeer>("hostA.app[0]", [](CoapTestPeer& peer) {
            RawCoapMessage req;
            req.type = 0; req.code = COAP_CODE_GET; req.messageId = 0x3009; req.token = {0x09};
            req.options.push_back({COAP_OPT_URI_PATH, asciiBytes(".well-known")});
            req.options.push_back({COAP_OPT_URI_PATH, asciiBytes("core")});
            peer.sendRawNow("hostB", 5683, encodeRawCoap(req), "GetCoreAfterDelete");
        }))
        .once(on("hostA.app[0]").signal("packetReceivedFromLower")
                  .assertEvent([](const MatchContext& ctx) {
                      RawCoapMessage raw;
                      if (!extractRawCoapFromAppEvent(ctx.event, raw))
                          return false;
                      std::string body = rawPayloadString(raw);
                      return raw.code == COAP_CODE_CONTENT && raw.messageId == 0x3009
                              && body.find("</sensors/temp>") != std::string::npos
                              && body.find("/actuators/led") == std::string::npos;
                  }).within(0.5));
}

%activity:
EV << "coap_resource_discovery compiled\n";

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.coap.CoapPairNetwork
sim-time-limit = 10s
seed-set = 0
*.tester.testName = "coap_resource_discovery"

*.hostA.numApps = 1
*.hostA.app[0].typename = "CoapTestPeer"
*.hostA.app[0].localPort = 16000

*.hostB.numApps = 1
*.hostB.app[0].typename = "CoapServer"
*.hostB.app[0].localPort = 5683
*.hostB.app[0].resources = xml("<resources><resource path='/sensors/temp' methods='GET' contentFormat='0' rt='temperature-c' if='sensor core.s' title='Temperature' obs='true'>22C</resource><resource path='/actuators/led' methods='GET,PUT,DELETE' contentFormat='0' rt='light-lux' if='actuator'>off</resource><resource path='/actuators/absent' exists='false' creatable='true' rt='absent'/></resources>")

%contains: stdout
PROTOCOLTEST coap_resource_discovery: PASS
