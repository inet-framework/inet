%description:

Protocol Test Framework self test -- the shared network TapRouterNetwork.

host1 opens a connection to host2 through the router. The tap, which is between host1 and
the router, sets the TTL of the first SYN to 1, so the router discards it and answers host1
with a real ICMP Time Exceeded. host1 then sends the SYN again, and host2 answers it across
the second link of the router.

%includes:
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("tap_router_network")
        .intercept(tap("tap").from("host1").filterPacket("tcp.synBit == true").nth(1)
                     .set("ipv4.timeToLive", "1")
                     .describe("the first SYN of host1"))
        .once(on("host1.eth[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("icmpv4.type == 11")
                  .describe("the Time Exceeded of the router at host1")
                  .within(0.5))
        .once(on("host2.tcp").signal("packetSentToLower")
                  .filterPacket("tcp.synBit == true && tcp.ackBit == true")
                  .describe("the SYN-ACK of host2 to the second SYN")
                  .within(5.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "tap_router_network compiled\n";

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.TapRouterNetwork
sim-time-limit = 6s
seed-set = 0

*.host1.numApps = 1
*.host1.app[0].typename = "TcpSessionApp"
*.host1.app[0].connectAddress = "host2"
*.host1.app[0].connectPort = 1000
*.host1.app[0].tOpen = 0.1s
*.host1.app[0].tSend = 0.2s
*.host1.app[0].sendBytes = 100B
*.host1.app[0].tClose = -1s
*.host2.numApps = 1
*.host2.app[0].typename = "TcpEchoApp"
*.host2.app[0].localPort = 1000
*.host2.app[0].echoFactor = 0

%contains: stdout
PROTOCOLTEST tap_router_network: PASS
