%description:

Redirect of a large packet.

Checks RFC6980-FRAG-1 and RFC4861-RDM-17, RDR-8, OPT-42 from
doc/project/evidence/standard/rfc6980/catalog.md and
doc/project/evidence/standard/rfc4861/catalog.md. The English procedure is in
doc/project/evidence/protocol/nd/checks/redirect.md#redirect-of-a-large-packet;
the program steps below map onto its expected observations. Step 1 is the stimulus, and step 2
observations 1 to 4.

A takes the link MTU from the MTU option of R1 when there is one, so the echo request can leave
A in fragments; the Redirect that the first fragment causes is still larger than 1280 octets if
the router does not cut the packet.

%includes:
#include "ProtocolTest.h"
#include "NdChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv6Address PREFIX1("2001:db8:1::");
static const Ipv6Address R_GLOBAL("2001:db8:1::1");
static const Ipv6Address A_LL("fe80::800:ff:fe00:a");
static const Ipv6Address B_LL("fe80::800:ff:fe00:b");
static const Ipv6Address A_GLOBAL("2001:db8:1::800:ff:fe00:a");
static const Ipv6Address B_GLOBAL("2001:db8:1::800:ff:fe00:b");
static const Ipv6Address C_GLOBAL("2001:db8:2::800:ff:fe00:c");
static const Ipv6Address NOBODY("2001:db8:1::99");
static const Ipv6Address NOBODY_B("2001:db8:1::b");

static MacAddress ethDest(const Packet *p) { auto e = ethOf(p); return e != nullptr ? e->getDest() : MacAddress::UNSPECIFIED_ADDRESS; }
static std::string num(long v) { return std::to_string(v); }

// The header fields of an ND message, for a message that reports them.
static std::string ndHeader(const Packet *p)
{
    return "hop limit " + num(hopLimitOf(p)) + ", code " + num(ndOf(p)->getCode()) + ", Reserved field "
           + (ndReservedZero(p) ? "zero" : "not zero") + ", source " + srcOf(p).str();
}

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc6980_redirect_large_packet")
        // The stimulus: the large echo request of A to C, whole or in fragments.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return destOf(p) == C_GLOBAL; })
                  .describe("the echo request of A to C")
                  .within(20.0))
        // Expected observations 1 to 4: the Redirect of R1 is not fragmented and is 1273 to 1280 octets.
        .once(on("r1.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isRedirect(p); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(!isFragmented(p), std::string("the Redirect of R1 has a Fragment header (RFC6980-FRAG-1)")); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(ipv6LengthOf(p) <= 1280, "the Redirect of R1 is " + num(ipv6LengthOf(p)) + " octets, more than 1280 (RFC4861-RDR-8, OPT-42)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(ipv6LengthOf(p) >= 1273, "the Redirect of R1 is " + num(ipv6LengthOf(p)) + " octets: it does not hold as much of the echo request as fits in 1280 (RFC4861-RDM-17, RDR-8)"); })
                  .describe("a Redirect of R1 on L1")
                  .within(1.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc6980_redirect_large_packet compiled\n";

%file: test.ned

import inet.common.scenario.ScenarioManager;
import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;

// the two routers: R1, R2 and host A on link L1 (r1.eth0, r2.eth0, hostA.eth0 through the switch sw); R2 and host C on link L2 (r2.eth1, hostC.eth0).
network NdTwoRouters
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // the routers only: the hosts configure themselves from the Router Advertisements,
            // and learn their routers and on-link prefixes from them, so the configurator adds
            // no route of its own; the routers get their routes from the <route> elements
            assignAddressesToHosts = false;
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='r1' names='eth0' address='2001:db8:1::1'/>" +
                         "<interface hosts='r2' names='eth0' address='2001:db8:1::2' advDefaultLifetime='0'/>" +
                         "<interface hosts='r2' names='eth1' address='2001:db8:2::1'/>" +
                         "<route hosts='r1' destination='2001:db8:1::' prefixLength='64' interface='eth0'/>" +
                         "<route hosts='r2' destination='2001:db8:1::' prefixLength='64' interface='eth0'/>" +
                         "<route hosts='r2' destination='2001:db8:2::' prefixLength='64' interface='eth1'/>" +
                         "<route hosts='r1' destination='2001:db8:2::' prefixLength='64' gateway='fe80::800:ff:fe00:2' interface='eth0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        r1: Router6 { @display("p=150,100"); }
        sw: EthernetSwitch { @display("p=350,100"); }
        r2: Router6 { @display("p=550,100"); }
        hostA: StandardHost6 { @display("p=350,250"); }
        hostC: StandardHost6 { @display("p=750,100"); }
        scenarioManager: ScenarioManager {
            script = xml("<scenario><at t='5'><startup module='r2'/><startup module='hostC'/></at></scenario>");
            @display("p=50,150");
        }
    connections:
        r1.ethg++ <--> Eth100M <--> sw.ethg++;
        hostA.ethg++ <--> Eth100M <--> sw.ethg++;
        r2.ethg++ <--> Eth100M <--> sw.ethg++;
        r2.ethg++ <--> Eth100M <--> hostC.ethg++;
}

%inifile: omnetpp.ini

[General]
network = NdTwoRouters
sim-time-limit = 22s
seed-set = 0
**.ipv6.configurator.networkConfiguratorModule = "configurator"
*.r1.eth[0].address = "0A-00-00-00-00-01"
*.r2.eth[0].address = "0A-00-00-00-00-02"
*.r2.eth[1].address = "0A-00-00-00-00-03"
*.hostA.eth[0].address = "0A-00-00-00-00-0A"
*.hostC.eth[0].address = "0A-00-00-00-00-0C"
**.hasStatus = true

*.r2.status.initialStatus = "down"
*.hostC.status.initialStatus = "down"
*.hostA.numApps = 1
*.hostA.app[0].typename = "PingApp"
*.hostA.app[0].destAddr = "2001:db8:2::800:ff:fe00:c"
*.hostA.app[0].startTime = 10s
*.hostA.app[0].count = 1
*.hostA.app[0].packetSize = 1400B

%contains: stdout
PROTOCOLTEST rfc6980_redirect_large_packet: PASS
