%description:

Neighbor Solicitation and Advertisement fields.

Checks RFC4861-NS-4, NS-6 to NS-8, NS-10, NS-13, NA-3, NA-6 to NA-8, NA-12, NA-18, NA-19,
NA-23, AR-35, AR-37 and AR-39 from
doc/project/evidence/standard/rfc4861/catalog.md. The English procedure is in
doc/project/evidence/protocol/nd/checks/address-resolution.md#neighbor-solicitation-and-advertisement-fields;
the program steps below map onto its expected observations. Step 1 is observations 1 and 2, and
step 2 observations 3 to 6.

%includes:
#include "ProtocolTest.h"
#include "NdChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv6Address PREFIX1("2001:db8:1::");
static const Ipv6Address R_GLOBAL("2001:db8:1::1");
static const Ipv6Address A_LL("fe80::800:ff:fe00:a");
static const Ipv6Address B_LL("fe80::800:ff:fe00:b");
static const Ipv6Address A_GLOBAL("2001:db8:1::800:ff:fe00:a");
static const Ipv6Address B_GLOBAL("2001:db8:1::800:ff:fe00:b");
static const Ipv6Address C_GLOBAL("2001:db8:2::800:ff:fe00:c");
static const Ipv6Address NOBODY("2001:db8:1::99");
static const Ipv6Address NOBODY_B("2001:db8:1::b");

static MacAddress ethDest(const Packet *p) { auto e = ethOf(p); return e != nullptr ? e->getDest() : MacAddress::UNSPECIFIED_ADDRESS; }
static std::string num(long v) { return std::to_string(v); }

// The header fields of an ND message, for a message that reports them.
static std::string ndHeader(const Packet *p)
{
    return "hop limit " + num(hopLimitOf(p)) + ", code " + num(ndOf(p)->getCode()) + ", Reserved field "
           + (ndReservedZero(p) ? "zero" : "not zero") + ", source " + srcOf(p).str();
}

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4861_ns_na_fields")
        // Expected observations 1 and 2: the Neighbor Solicitation of A for B and its header fields.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isNs(p) && nsOf(p)->getTargetAddress() == B_GLOBAL; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(hopLimitOf(p) == 255 && ndOf(p)->getCode() == 0 && ndReservedZero(p) && !nsOf(p)->getTargetAddress().isMulticast() && (srcOf(p) == A_LL || srcOf(p) == A_GLOBAL), "the solicitation of A has " + ndHeader(p) + " and target " + nsOf(p)->getTargetAddress().str() + " (RFC4861-NS-4, NS-6, NS-7, NS-8, NS-10, NS-13)"); })
                  .describe("the Neighbor Solicitation of A for the global address of B")
                  .within(20.0))
        // Expected observations 3 to 6: the Neighbor Advertisement of B, its header fields, and its S, R and O flags.
        .once(on("hostB.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isNa(p) && naOf(p)->getTargetAddress() == B_GLOBAL; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(hopLimitOf(p) == 255 && ndOf(p)->getCode() == 0 && ndReservedZero(p) && !naOf(p)->getTargetAddress().isMulticast() && (srcOf(p) == B_LL || srcOf(p) == B_GLOBAL), "the advertisement of B has " + ndHeader(p) + " and target " + naOf(p)->getTargetAddress().str() + " (RFC4861-NA-3, NA-6, NA-7, NA-8, NA-19, NA-23)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(naOf(p)->getSolicitedFlag(), std::string("the advertisement of B has the Solicited flag clear (RFC4861-AR-39, NA-12)")); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(!naOf(p)->getRouterFlag(), std::string("the advertisement of B, a host, has the Router flag set (RFC4861-AR-35)")); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(naOf(p)->getOverrideFlag(), std::string("the advertisement of B has the Override flag clear (RFC4861-AR-37, NA-18)")); })
                  .describe("the Neighbor Advertisement of B for its global address")
                  .within(1.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4861_ns_na_fields compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;

// the link: router R, host A and host B on one Ethernet (router.eth0, hostA.eth0, hostB.eth0 through the switch sw).
network NdLink
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // the routers only: the hosts configure themselves from the Router Advertisements,
            // and learn their routers and on-link prefixes from them, so the configurator adds
            // no route of its own; the routers get their routes from the <route> elements
            assignAddressesToHosts = false;
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='router' names='eth0' address='2001:db8:1::1'/>" +
                         "<route hosts='router' destination='2001:db8:1::' prefixLength='64' interface='eth0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        router: Router6 { @display("p=150,100"); }
        sw: EthernetSwitch { @display("p=350,100"); }
        hostA: StandardHost6 { @display("p=250,250"); }
        hostB: StandardHost6 { @display("p=450,250"); }
    connections:
        router.ethg++ <--> Eth100M <--> sw.ethg++;
        hostA.ethg++ <--> Eth100M <--> sw.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw.ethg++;
}

%inifile: omnetpp.ini

[General]
network = NdLink
sim-time-limit = 22s
seed-set = 0
**.ipv6.configurator.networkConfiguratorModule = "configurator"
*.router.eth[0].address = "0A-00-00-00-00-01"
*.hostA.eth[0].address = "0A-00-00-00-00-0A"
*.hostB.eth[0].address = "0A-00-00-00-00-0B"

*.hostA.numApps = 1
*.hostA.app[0].typename = "PingApp"
*.hostA.app[0].destAddr = "2001:db8:1::800:ff:fe00:b"
*.hostA.app[0].startTime = 10s
*.hostA.app[0].count = 1

%contains: stdout
PROTOCOLTEST rfc4861_ns_na_fields: PASS
