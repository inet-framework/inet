%description:

Address resolution failure.

Checks RFC4861-AR-11, AR-19 to AR-23, HOST-7 and RCFG-23 from
doc/project/evidence/standard/rfc4861/catalog.md. The English procedure is in
doc/project/evidence/protocol/nd/checks/address-resolution.md#address-resolution-failure;
the program steps below map onto its expected observations. The guards are observations 3 and
5; steps 1 to 3 are observations 1, 2 and 4; step 4 is observation 6.

%includes:
#include "ProtocolTest.h"
#include "NdChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv6Address PREFIX1("2001:db8:1::");
static const Ipv6Address R_GLOBAL("2001:db8:1::1");
static const Ipv6Address A_LL("fe80::800:ff:fe00:a");
static const Ipv6Address B_LL("fe80::800:ff:fe00:b");
static const Ipv6Address A_GLOBAL("2001:db8:1::800:ff:fe00:a");
static const Ipv6Address B_GLOBAL("2001:db8:1::800:ff:fe00:b");
static const Ipv6Address C_GLOBAL("2001:db8:2::800:ff:fe00:c");
static const Ipv6Address NOBODY("2001:db8:1::99");
static const Ipv6Address NOBODY_B("2001:db8:1::b");

static MacAddress ethDest(const Packet *p) { auto e = ethOf(p); return e != nullptr ? e->getDest() : MacAddress::UNSPECIFIED_ADDRESS; }
static std::string num(long v) { return std::to_string(v); }

// The header fields of an ND message, for a message that reports them.
static std::string ndHeader(const Packet *p)
{
    return "hop limit " + num(hopLimitOf(p)) + ", code " + num(ndOf(p)->getCode()) + ", Reserved field "
           + (ndReservedZero(p) ? "zero" : "not zero") + ", source " + srcOf(p).str();
}
static int nsCount;
static simtime_t prevAt;

Define_ProtocolTestProgram()
{
    nsCount = 0;
    return ProtocolTest("rfc4861_address_resolution_failure")
        // Expected observation 5: no Neighbor Advertisement for 2001:db8:1::99 on L1.
        .meanwhile(never(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isNa(p) && naOf(p)->getTargetAddress() == NOBODY; })
                  .describe("a Neighbor Advertisement of A for 2001:db8:1::99 (RFC4861-AR-23)")
                  .within(20.0)))
        .meanwhile(never(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isNa(p) && naOf(p)->getTargetAddress() == NOBODY; })
                  .describe("a Neighbor Advertisement of R for 2001:db8:1::99 (RFC4861-AR-23)")
                  .within(20.0)))
        // Expected observation 3: no fourth solicitation.
        .meanwhile(never(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isNs(p) && nsOf(p)->getTargetAddress() == NOBODY && ++nsCount > 3; })
                  .describe("a fourth Neighbor Solicitation of R for 2001:db8:1::99 (RFC4861-AR-21)")
                  .within(20.0)))
        // Expected observations 1 and 2: a Neighbor Solicitation of R on L1 for 2001:db8:1::99, from an address of R.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isNs(p) && nsOf(p)->getTargetAddress() == NOBODY; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(destOf(p) == solicitedNodeOf(NOBODY), "the solicitation of R went to " + destOf(p).str() + ", not to the solicited-node address of 2001:db8:1::99"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(srcOf(p) == linkLocalOf("router", "eth0") || srcOf(p) == R_GLOBAL, "the solicitation of R came from " + srcOf(p).str() + ", not from an address of R on L1 (RFC4861-AR-11)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; prevAt = c.event.time; return true; })
                  .describe("a Neighbor Solicitation of R on L1 for 2001:db8:1::99")
                  .within(20.0))
        // Expected observation 4: the second, 1 to 1.5 s after the first ...
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isNs(p) && nsOf(p)->getTargetAddress() == NOBODY; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; simtime_t gap = c.event.time - prevAt; prevAt = c.event.time; return require(gap >= 1 && gap <= 1.5, "a solicitation for 2001:db8:1::99 came " + gap.str() + " s after the one before it, outside 1 to 1.5 s (RFC4861-AR-19, AR-20, HOST-7, RCFG-23)"); })
                  .describe("a second Neighbor Solicitation of R for 2001:db8:1::99")
                  .within(1.5))
        // ... and the third, 1 to 1.5 s after the second.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isNs(p) && nsOf(p)->getTargetAddress() == NOBODY; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; simtime_t gap = c.event.time - prevAt; prevAt = c.event.time; return require(gap >= 1 && gap <= 1.5, "a solicitation for 2001:db8:1::99 came " + gap.str() + " s after the one before it, outside 1 to 1.5 s (RFC4861-AR-19, AR-20, HOST-7, RCFG-23)"); })
                  .describe("a third Neighbor Solicitation of R for 2001:db8:1::99")
                  .within(1.5))
        // Expected observation 6: on L2, an ICMPv6 Destination Unreachable with code 3 to C, at least 1 s after the third solicitation.
        .once(on("router.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return icmpv6TypeOf(p) == ICMPv6_DESTINATION_UNREACHABLE && destOf(p) == C_GLOBAL; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(dynamicPtrCast<const Icmpv6DestUnreachableMsg>(icmpv6Of(p))->getCode() == 3, "the Destination Unreachable of R has code " + num(dynamicPtrCast<const Icmpv6DestUnreachableMsg>(icmpv6Of(p))->getCode()) + ", not 3 (RFC4861-AR-22)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(findChunks<Ipv6Header>(p).size() >= 2 && findChunks<Ipv6Header>(p)[1]->getDestAddress() == NOBODY, std::string("the Destination Unreachable of R does not hold the start of the echo request (RFC4861-AR-22)")); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(c.event.time - prevAt >= 1, "the Destination Unreachable left R " + (c.event.time - prevAt).str() + " s after the third solicitation, less than 1 s (RFC4861-AR-21)"); })
                  .describe("an ICMPv6 Destination Unreachable of R on L2 to C")
                  .within(5.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4861_address_resolution_failure compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;

// the path: host A on link L1 (hostA.eth0, router.eth0), router R, host C on link L2 (router.eth1, hostC.eth0).
network NdPath
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // the routers only: the hosts configure themselves from the Router Advertisements,
            // and learn their routers and on-link prefixes from them, so the configurator adds
            // no route of its own; the routers get their routes from the <route> elements
            assignAddressesToHosts = false;
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='router' names='eth0' address='2001:db8:1::1'/>" +
                         "<interface hosts='router' names='eth1' address='2001:db8:2::1'/>" +
                         "<route hosts='router' destination='2001:db8:1::' prefixLength='64' interface='eth0'/>" +
                         "<route hosts='router' destination='2001:db8:2::' prefixLength='64' interface='eth1'/>" +
                         "</config>");
            @display("p=50,50");
        }
        hostA: StandardHost6 { @display("p=150,200"); }
        router: Router6 { @display("p=350,200"); }
        hostC: StandardHost6 { @display("p=550,200"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++;
        router.ethg++ <--> Eth100M <--> hostC.ethg++;
}

%inifile: omnetpp.ini

[General]
network = NdPath
sim-time-limit = 25s
seed-set = 0
**.ipv6.configurator.networkConfiguratorModule = "configurator"
*.router.eth[0].address = "0A-00-00-00-00-01"
*.router.eth[1].address = "0A-00-00-00-00-02"
*.hostA.eth[0].address = "0A-00-00-00-00-0A"
*.hostC.eth[0].address = "0A-00-00-00-00-0C"

*.hostC.numApps = 1
*.hostC.app[0].typename = "PingApp"
*.hostC.app[0].destAddr = "2001:db8:1::99"
*.hostC.app[0].startTime = 10s
*.hostC.app[0].count = 1

%contains: stdout
PROTOCOLTEST rfc4861_address_resolution_failure: PASS
