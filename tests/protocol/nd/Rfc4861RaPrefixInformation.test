%description:

Prefix Information option.

Checks RFC4861-ADV-12 to ADV-16, OPT-15, OPT-16, OPT-22, OPT-28, OPT-29, OPT-32, OPT-34, RA-27
and RCFG-14 to RCFG-16, RCFG-18, RCFG-19, RCFG-21, RCFG-22 from
doc/project/evidence/standard/rfc4861/catalog.md. The English procedure is in
doc/project/evidence/protocol/nd/checks/router-discovery.md#prefix-information-option;
the program steps below map onto its expected observations. Step 1 is observations 1 to 7, in
order.

%includes:
#include "ProtocolTest.h"
#include "NdChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv6Address PREFIX1("2001:db8:1::");
static const Ipv6Address R_GLOBAL("2001:db8:1::1");
static const Ipv6Address A_LL("fe80::800:ff:fe00:a");
static const Ipv6Address B_LL("fe80::800:ff:fe00:b");
static const Ipv6Address A_GLOBAL("2001:db8:1::800:ff:fe00:a");
static const Ipv6Address B_GLOBAL("2001:db8:1::800:ff:fe00:b");
static const Ipv6Address C_GLOBAL("2001:db8:2::800:ff:fe00:c");
static const Ipv6Address NOBODY("2001:db8:1::99");
static const Ipv6Address NOBODY_B("2001:db8:1::b");

static MacAddress ethDest(const Packet *p) { auto e = ethOf(p); return e != nullptr ? e->getDest() : MacAddress::UNSPECIFIED_ADDRESS; }
static std::string num(long v) { return std::to_string(v); }

// The header fields of an ND message, for a message that reports them.
static std::string ndHeader(const Packet *p)
{
    return "hop limit " + num(hopLimitOf(p)) + ", code " + num(ndOf(p)->getCode()) + ", Reserved field "
           + (ndReservedZero(p) ? "zero" : "not zero") + ", source " + srcOf(p).str();
}
static const Ipv6NdPrefixInformation *pio(const Packet *p) { return prefixInfoOf(p, PREFIX1, 64); }

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc4861_ra_prefix_information")
        // Expected observations 1 to 7: the first Router Advertisement of R and its Prefix Information option.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isRa(p); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(pio(p) != nullptr && pio(p)->getType() == 3 && pio(p)->getOptionLength() == 4, "the advertisement of R carries " + (pio(p) == nullptr ? std::string("no Prefix Information option for 2001:db8:1::/64") : "a Prefix Information option of type " + num(pio(p)->getType()) + " and length " + num(pio(p)->getOptionLength())) + " (RFC4861-ADV-12, RA-27, RCFG-14, OPT-15, OPT-16)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(prefixInfoOf(p, Ipv6Address("fe80::"), 64) == nullptr, std::string("the advertisement of R carries a Prefix Information option for fe80::/64 (RFC4861-OPT-34, RCFG-15)")); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(pio(p)->getOnlinkFlag() && pio(p)->getAutoAddressConfFlag(), "the option for 2001:db8:1::/64 has L " + num(pio(p)->getOnlinkFlag()) + " and A " + num(pio(p)->getAutoAddressConfFlag()) + " (RFC4861-ADV-13, ADV-15, RCFG-18, RCFG-22)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; auto o = ndOptionBytes(p, IPv6ND_PREFIX_INFORMATION); bool zero = o.size() == 32 && (o[3] & 0x3f) == 0; for (int i = 12; zero && i < 16; i++) zero = o[i] == 0; for (int i = 24; zero && i < 32; i++) zero = o[i] == 0; return require(zero, std::string("the option for 2001:db8:1::/64 has a Reserved field, or a bit of the prefix after the first 64, that is not zero (RFC4861-OPT-22, OPT-29, OPT-32)")); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(pio(p)->getPreferredLifetime() <= pio(p)->getValidLifetime(), "the option for 2001:db8:1::/64 has Preferred Lifetime " + num(pio(p)->getPreferredLifetime()) + " above Valid Lifetime " + num(pio(p)->getValidLifetime()) + " (RFC4861-OPT-28, RCFG-21)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(pio(p)->getValidLifetime() == 2592000 && pio(p)->getPreferredLifetime() == 604800, "the option for 2001:db8:1::/64 has Valid Lifetime " + num(pio(p)->getValidLifetime()) + " and Preferred Lifetime " + num(pio(p)->getPreferredLifetime()) + ", not 2592000 and 604800 (RFC4861-ADV-14, ADV-16, RCFG-16, RCFG-19)"); })
                  .describe("the first Router Advertisement of R")
                  .within(30.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc4861_ra_prefix_information compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;

// the link: router R, host A and host B on one Ethernet (router.eth0, hostA.eth0, hostB.eth0 through the switch sw).
network NdLink
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // the routers only: the hosts configure themselves from the Router Advertisements,
            // and learn their routers and on-link prefixes from them, so the configurator adds
            // no route of its own; the routers get their routes from the <route> elements
            assignAddressesToHosts = false;
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='router' names='eth0' address='2001:db8:1::1'/>" +
                         "<route hosts='router' destination='2001:db8:1::' prefixLength='64' interface='eth0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        router: Router6 { @display("p=150,100"); }
        sw: EthernetSwitch { @display("p=350,100"); }
        hostA: StandardHost6 { @display("p=250,250"); }
        hostB: StandardHost6 { @display("p=450,250"); }
    connections:
        router.ethg++ <--> Eth100M <--> sw.ethg++;
        hostA.ethg++ <--> Eth100M <--> sw.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw.ethg++;
}

%inifile: omnetpp.ini

[General]
network = NdLink
sim-time-limit = 32s
seed-set = 0
**.ipv6.configurator.networkConfiguratorModule = "configurator"
*.router.eth[0].address = "0A-00-00-00-00-01"
*.hostA.eth[0].address = "0A-00-00-00-00-0A"
*.hostB.eth[0].address = "0A-00-00-00-00-0B"

%contains: stdout
PROTOCOLTEST rfc4861_ra_prefix_information: PASS
