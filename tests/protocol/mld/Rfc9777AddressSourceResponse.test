%description:

Response to a Multicast Address and Source Specific Query.

Checks RFC9777-LTIM-7, LTIM-8 and LTIM-10 from
doc/project/evidence/standard/rfc9777/catalog.md. The English procedure is in
doc/project/evidence/protocol/mld/checks/query-response.md#response-to-a-multicast-address-and-source-specific-query;
the program steps below map onto its expected observations. The guard is the second half of
observation 5; step 1 is observation 1, step 2 observations 2 and 3, step 3 observation 4, and
step 4 the first half of observation 5.

The test sets the Unsolicited Report Interval of the model to 1 second, the default of RFC 9777
section 9.11; Rfc9777StartRepeated.test checks the default itself.

Defect: the answer to a Multicast Address and Source Specific Query holds a MODE_IS_INCLUDE
record with no sources when the host wants none of the queried sources.
Mldv2::processHostGroupQueryTimer builds IS_IN(A * B) and sends it without a look at its size
(src/inet/networklayer/icmpv6/Mldv2.cc:632-637); RFC 9777 section 6.3 sends no record with an
empty source list. Observations 1 to 4 hold; observation 5 fails with the answer of A at 55.96
s. This test FAILS, and the failure is deliberately NOT declared expected: the model has the
mechanism, and the mechanism does the wrong thing, which is a defect. See results.md.

%includes:
#include "ProtocolTest.h"
#include "MldChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv6Address G("ff0e::1:1"), H("ff0e::1:2"), K("ff0e::1:3");
static const Ipv6Address S1("2001:db8:2::10"), S2("2001:db8:2::11");
static const Ipv6Address ALL_NODES("ff02::1"), ALL_ROUTERS("ff02::2"), V2_ROUTERS("ff02::16");

static std::string num(double v) { std::ostringstream s; s << v; return s.str(); }
static std::set<Ipv6Address> sset(std::initializer_list<Ipv6Address> l) { return std::set<Ipv6Address>(l); }

// A State-Change Report: a Version 2 Report with a Filter-Mode-Change or Source-List-Change record for the address.
static bool isStateChange(const Packet *p, const Ipv6Address& g)
{
    return hasRecordOf(p, g, MLD_CHANGE_TO_INCLUDE_MODE) || hasRecordOf(p, g, MLD_CHANGE_TO_EXCLUDE_MODE) || hasRecordOf(p, g, MLD_ALLOW_NEW_SOURCES) || hasRecordOf(p, g, MLD_BLOCK_OLD_SOURCES);
}
// A Current-State Report for the address.
static bool isCurrentState(const Packet *p, const Ipv6Address& g) { return hasRecordOf(p, g, MLD_MODE_IS_INCLUDE) || hasRecordOf(p, g, MLD_MODE_IS_EXCLUDE); }
// A Query for the address: Multicast Address Specific with no sources, Multicast Address and Source Specific with sources.
static bool isAddressQuery(const Packet *p, const Ipv6Address& g) { return isQuery(p) && queryAddress(p) == g && querySources(p) == 0; }
static bool isSourceQuery(const Packet *p, const Ipv6Address& g) { return isQuery(p) && queryAddress(p) == g && querySources(p) > 0; }
static std::set<Ipv6Address> querySourceSet(const Packet *p)
{
    std::set<Ipv6Address> out;
    if (auto q = v2QueryOf(p))
        for (auto& a : q->getSourceList())
            out.insert(a);
    return out;
}
static bool isFwd(const Packet *p, const Ipv6Address& s) { return isDatagram(p, s, G); }

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc9777_address_source_response")
        // Expected observation 5: no Current-State Record of A for G without sources.
        .meanwhile(never(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return (hasRecordOf(p, G, MLD_MODE_IS_INCLUDE) && sourcesOfRecord(p, G, MLD_MODE_IS_INCLUDE).empty()); })
                  .describe("a MODE_IS_INCLUDE record of A for G without sources (RFC9777-LTIM-10)")
                  .within(65.0)))
        // Expected observation 1: after 50 s, a Multicast Address and Source Specific Query for G with S1.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return c.event.time >= 50 && isSourceQuery(p, G) && querySourceSet(p) == sset({S1}); })
                  .describe("after 50 s, a Multicast Address and Source Specific Query for G with S1")
                  .within(55.0))
        // Expected observations 2 and 3: within 1 s, the answer of A with IS_IN(S1).
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isCurrentState(p, G); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(sourcesOfRecord(p, G, MLD_MODE_IS_INCLUDE) == sset({S1}), "the answer of A holds " + recordsText(p) + ", not MODE_IS_INCLUDE with S1 only (RFC9777-LTIM-8)"); })
                  .describe("within 1 s, a Current-State Report of A for G (RFC9777-LTIM-7)")
                  .within(1.0))
        // Expected observation 4: after 55 s, a Multicast Address and Source Specific Query for G with S2.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return c.event.time >= 55 && isSourceQuery(p, G) && querySourceSet(p) == sset({S2}); })
                  .describe("after 55 s, a Multicast Address and Source Specific Query for G with S2")
                  .within(6.0))
        // Expected observation 5: no answer of A within 1 s of it.
        .never(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isCurrentState(p, G); })
                  .describe("a Current-State Report of A for G after the Query for S2 alone (RFC9777-LTIM-10)")
                  .within(1.1));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc9777_address_source_response compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;

// The requests of a host, as its sockets would make them (tests/protocol/mld/MldChecks.h).
simple MldRequests
{
    parameters:
        @class(::inet::protocoltest::MldRequests);
        string node;
        string interfaceName = default("eth0");
        string script;
}

// the link: router R, host A and host B on L1 (router.eth0, hostA.eth0, hostB.eth0 through the switch sw1).
network MldLink
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // every node gets the address of the mockup; the configurator adds no route,
            // and the multicast route of R comes from routeR
            assignAddressesToHosts = true;
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='router' names='eth0' address='2001:db8:1::1'/>" +
                         "<interface hosts='hostA' names='eth0' address='2001:db8:1::10'/>" +
                         "<interface hosts='hostB' names='eth0' address='2001:db8:1::11'/>" +
                         "</config>");
            @display("p=50,50");
        }
        router: Router6 { @display("p=150,100"); }
        sw1: EthernetSwitch { @display("p=350,100"); }
        hostA: StandardHost6 { @display("p=250,250"); }
        hostB: StandardHost6 { @display("p=450,250"); }
        requestsA: MldRequests {
            node = "hostA";
            script = "10 a ff0e::1:1 INCLUDE 2001:db8:2::10";
            @display("p=50,500");
        }
        requestsB: MldRequests {
            node = "hostB";
            script = "10 b ff0e::1:1 INCLUDE 2001:db8:2::10; 10 c ff0e::1:1 INCLUDE 2001:db8:2::11; 50 b ff0e::1:1 INCLUDE; 55 c ff0e::1:1 INCLUDE";
            @display("p=150,500");
        }
    connections:
        router.ethg++ <--> Eth100M <--> sw1.ethg++;
        hostA.ethg++ <--> Eth100M <--> sw1.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw1.ethg++;
}

%inifile: omnetpp.ini

[General]
network = MldLink
sim-time-limit = 67s
seed-set = 0
**.mld.unsolicitedReportInterval = 1s

**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.ipv6.hasMld = true
**.ipv6.mld.typename = "Mldv2"
**.mld.checksumMode = "computed"
*.router.multicastForwarding = true
*.r1.multicastForwarding = true
*.r2.multicastForwarding = true
*.router.eth[0].address = "0A-00-00-00-00-01"
*.hostA.eth[0].address = "0A-00-00-00-00-0A"
*.hostB.eth[0].address = "0A-00-00-00-00-0B"

%contains: stdout
PROTOCOLTEST rfc9777_address_source_response: PASS
