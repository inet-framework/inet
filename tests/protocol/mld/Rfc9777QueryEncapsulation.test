%description:

Multicast Listener Query encapsulation.

Checks RFC9777-GEN-5, VER-1, QRY-2, QRY-7, QRY-8, QRY-10, QRY-13, QRY-15, QRY-17, QRY-22,
QRY-23, QRY-28 and TIMER-5 from
doc/project/evidence/standard/rfc9777/catalog.md. The English procedure is in
doc/project/evidence/protocol/mld/checks/message-format.md#multicast-listener-query-encapsulation;
the program steps below map onto its expected observations. Step 1 is observations 1, 2, the
destination and fields of observation 3, 4, the Code and Reserved fields of observation 6, and
last 5: the QRV and the QQIC come last. The source of observation 3 is in
Rfc9777QuerySource.test, and the checksum of observation 6 in Rfc9777QueryChecksum.test.

Defect: the QRV and the QQIC of every Query are 0. Mldv2::sendGeneralQuery sets the Maximum
Response Code and the length, and nothing else
(src/inet/networklayer/icmpv6/Mldv2.cc:1291-1298), and the specific Queries are built the same
way. Observations 1 to 4 and 6 hold; observation 5 fails with QRV 0 and QQIC 0. This test
FAILS, and the failure is deliberately NOT declared expected: the model has the mechanism, and
the mechanism does the wrong thing, which is a defect. See results.md.

%includes:
#include "ProtocolTest.h"
#include "MldChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv6Address G("ff0e::1:1"), H("ff0e::1:2"), K("ff0e::1:3");
static const Ipv6Address S1("2001:db8:2::10"), S2("2001:db8:2::11");
static const Ipv6Address ALL_NODES("ff02::1"), ALL_ROUTERS("ff02::2"), V2_ROUTERS("ff02::16");

static std::string num(double v) { std::ostringstream s; s << v; return s.str(); }
static std::set<Ipv6Address> sset(std::initializer_list<Ipv6Address> l) { return std::set<Ipv6Address>(l); }

// A State-Change Report: a Version 2 Report with a Filter-Mode-Change or Source-List-Change record for the address.
static bool isStateChange(const Packet *p, const Ipv6Address& g)
{
    return hasRecordOf(p, g, MLD_CHANGE_TO_INCLUDE_MODE) || hasRecordOf(p, g, MLD_CHANGE_TO_EXCLUDE_MODE) || hasRecordOf(p, g, MLD_ALLOW_NEW_SOURCES) || hasRecordOf(p, g, MLD_BLOCK_OLD_SOURCES);
}
// A Current-State Report for the address.
static bool isCurrentState(const Packet *p, const Ipv6Address& g) { return hasRecordOf(p, g, MLD_MODE_IS_INCLUDE) || hasRecordOf(p, g, MLD_MODE_IS_EXCLUDE); }
// A Query for the address: Multicast Address Specific with no sources, Multicast Address and Source Specific with sources.
static bool isAddressQuery(const Packet *p, const Ipv6Address& g) { return isQuery(p) && queryAddress(p) == g && querySources(p) == 0; }
static bool isSourceQuery(const Packet *p, const Ipv6Address& g) { return isQuery(p) && queryAddress(p) == g && querySources(p) > 0; }
static std::set<Ipv6Address> querySourceSet(const Packet *p)
{
    std::set<Ipv6Address> out;
    if (auto q = v2QueryOf(p))
        for (auto& a : q->getSourceList())
            out.insert(a);
    return out;
}
static bool isFwd(const Packet *p, const Ipv6Address& s) { return isDatagram(p, s, G); }

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc9777_query_encapsulation")
        // Expected observations 1 to 6: the first Multicast Listener Query of R.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isQuery(p); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(mldLength(p) >= 28 && mldLength(p) == 28 + 16 * querySources(p), "the Query of R is " + num(mldLength(p)) + " octets (RFC9777-VER-1, QRY-22)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(destOf(p) == ALL_NODES && queryAddress(p).isUnspecified() && querySources(p) == 0, "the Query of R went to " + destOf(p).str() + " with the address " + queryAddress(p).str() + " and " + num(querySources(p)) + " sources (RFC9777-QRY-10, QRY-17, QRY-23, QRY-28)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(maxRespCode(p) == 10000, "the Query of R has Maximum Response Code " + num(maxRespCode(p)) + ", not 10000 (RFC9777-QRY-7, TIMER-5)"); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(v2QueryOf(p)->getCode() == 0 && v2QueryOf(p)->getReserved() == 0 && v2QueryOf(p)->getResv() == 0, std::string("the Query of R has a Code or Reserved field that is not zero (RFC9777-QRY-2, QRY-8)")); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(v2QueryOf(p)->getRobustnessVariable() == 2 && v2QueryOf(p)->getQueryIntervalCode() == 125, "the Query of R has QRV " + num(v2QueryOf(p)->getRobustnessVariable()) + " and QQIC " + num(v2QueryOf(p)->getQueryIntervalCode()) + ", not 2 and 125 (RFC9777-QRY-13, QRY-15)"); })
                  .describe("the first Multicast Listener Query of R (RFC9777-GEN-5)")
                  .within(10.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc9777_query_encapsulation compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;

// the link: router R, host A and host B on L1 (router.eth0, hostA.eth0, hostB.eth0 through the switch sw1).
network MldLink
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // every node gets the address of the mockup; the configurator adds no route,
            // and the multicast route of R comes from routeR
            assignAddressesToHosts = true;
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='router' names='eth0' address='2001:db8:1::1'/>" +
                         "<interface hosts='hostA' names='eth0' address='2001:db8:1::10'/>" +
                         "<interface hosts='hostB' names='eth0' address='2001:db8:1::11'/>" +
                         "</config>");
            @display("p=50,50");
        }
        router: Router6 { @display("p=150,100"); }
        sw1: EthernetSwitch { @display("p=350,100"); }
        hostA: StandardHost6 { @display("p=250,250"); }
        hostB: StandardHost6 { @display("p=450,250"); }
    connections:
        router.ethg++ <--> Eth100M <--> sw1.ethg++;
        hostA.ethg++ <--> Eth100M <--> sw1.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw1.ethg++;
}

%inifile: omnetpp.ini

[General]
network = MldLink
sim-time-limit = 12s
seed-set = 0
**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.ipv6.hasMld = true
**.ipv6.mld.typename = "Mldv2"
**.mld.checksumMode = "computed"
*.router.multicastForwarding = true
*.r1.multicastForwarding = true
*.r2.multicastForwarding = true
*.router.eth[0].address = "0A-00-00-00-00-01"
*.hostA.eth[0].address = "0A-00-00-00-00-0A"
*.hostB.eth[0].address = "0A-00-00-00-00-0B"

%contains: stdout
PROTOCOLTEST rfc9777_query_encapsulation: PASS
