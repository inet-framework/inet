%description:

Listener back to MLDv2: the Older Version Querier Present Interval.

Checks RFC9777-TIMER-17 from
doc/project/evidence/standard/rfc9777/catalog.md. The English procedure is in
doc/project/evidence/protocol/mld/checks/compatibility.md#listener-back-to-mldv2;
the program steps below map onto its expected observations. Step 1 is the last MLDv1 Query of
R, and step 2 observation 2. Observations 1 and 3 are in Rfc9777ListenerBackToV2.test.

The test sets the Unsolicited Report Interval of the model to 1 second, the default of RFC 9777
section 9.11; Rfc9777StartRepeated.test checks the default itself.

A node joins or leaves L1 through its link: the ScenarioManager enables or disables the channel
between the node and the switch (the rules of checks.md).

Defect: the Older-Version-Querier-Present Timer of a host runs for the Other Querier Present
Interval, 255 s (src/inet/networklayer/icmpv6/Mldv2.cc:1116,
src/inet/networklayer/icmpv6/Mldv2.ned:77), not for [Robustness Variable] x [Query Interval] +
[Query Response Interval], 260 s (RFC 9777 section 9.12). A is in MLDv2 mode again at 286.25 s,
so its Report at 290 s is a Version 2 Report. This test FAILS, and the failure is deliberately
NOT declared expected: the model has the mechanism, and the mechanism does the wrong thing,
which is a defect. See results.md.

%includes:
#include "ProtocolTest.h"
#include "MldChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv6Address G("ff0e::1:1"), H("ff0e::1:2"), K("ff0e::1:3");
static const Ipv6Address S1("2001:db8:2::10"), S2("2001:db8:2::11");
static const Ipv6Address ALL_NODES("ff02::1"), ALL_ROUTERS("ff02::2"), V2_ROUTERS("ff02::16");

static std::string num(double v) { std::ostringstream s; s << v; return s.str(); }
static std::set<Ipv6Address> sset(std::initializer_list<Ipv6Address> l) { return std::set<Ipv6Address>(l); }

// A State-Change Report: a Version 2 Report with a Filter-Mode-Change or Source-List-Change record for the address.
static bool isStateChange(const Packet *p, const Ipv6Address& g)
{
    return hasRecordOf(p, g, MLD_CHANGE_TO_INCLUDE_MODE) || hasRecordOf(p, g, MLD_CHANGE_TO_EXCLUDE_MODE) || hasRecordOf(p, g, MLD_ALLOW_NEW_SOURCES) || hasRecordOf(p, g, MLD_BLOCK_OLD_SOURCES);
}
// A Current-State Report for the address.
static bool isCurrentState(const Packet *p, const Ipv6Address& g) { return hasRecordOf(p, g, MLD_MODE_IS_INCLUDE) || hasRecordOf(p, g, MLD_MODE_IS_EXCLUDE); }
// A Query for the address: Multicast Address Specific with no sources, Multicast Address and Source Specific with sources.
static bool isAddressQuery(const Packet *p, const Ipv6Address& g) { return isQuery(p) && queryAddress(p) == g && querySources(p) == 0; }
static bool isSourceQuery(const Packet *p, const Ipv6Address& g) { return isQuery(p) && queryAddress(p) == g && querySources(p) > 0; }
static std::set<Ipv6Address> querySourceSet(const Packet *p)
{
    std::set<Ipv6Address> out;
    if (auto q = v2QueryOf(p))
        for (auto& a : q->getSourceList())
            out.insert(a);
    return out;
}
static bool isFwd(const Packet *p, const Ipv6Address& s) { return isDatagram(p, s, G); }

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc9777_older_querier_interval")
        // The MLDv1 General Query of R at 31.25 s, the last one before R leaves L1.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isV1Query(p) && c.event.time > 31; })
                  .describe("the MLDv1 General Query of 31.25 s")
                  .within(32.0))
        // Expected observation 2: at 290 s, the Report of A for G is an MLDv1 Report.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return c.event.time >= 290 && (isV1Report(p) || hasRecord(p, G)); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(isV1Report(p), std::string("A sent a Version 2 Report at 290 s: it left MLDv1 mode less than 258.75 s after the last MLDv1 Query, not 260 s (RFC9777-TIMER-17)")); })
                  .describe("at 290 s, a Report of A for G (RFC9777-TIMER-17)")
                  .within(260.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc9777_older_querier_interval compiled\n";

%file: test.ned

import inet.common.scenario.ScenarioManager;
import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;

// The requests of a host, as its sockets would make them (tests/protocol/mld/MldChecks.h).
simple MldRequests
{
    parameters:
        @class(::inet::protocoltest::MldRequests);
        string node;
        string interfaceName = default("eth0");
        string script;
}

// The multicast routing of R: one route from L2 to L1 with L1 as a leaf (MldChecks.h).
simple MulticastLeafRoute6
{
    parameters:
        @class(::inet::protocoltest::MulticastLeafRoute6);
        string node;
        string origin;
        int prefixLength;
        string group;
        string inInterface;
        string outInterface;
}

// the link with a source: R, A and B on L1 (router.eth0 through sw1); R, S1 and S2 on L2 (router.eth1 through sw2).
network MldSource
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // every node gets the address of the mockup; the configurator adds no route,
            // and the multicast route of R comes from routeR
            assignAddressesToHosts = true;
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='router' names='eth0' address='2001:db8:1::1'/>" +
                         "<interface hosts='router' names='eth1' address='2001:db8:2::1'/>" +
                         "<interface hosts='hostA' names='eth0' address='2001:db8:1::10'/>" +
                         "<interface hosts='hostB' names='eth0' address='2001:db8:1::11'/>" +
                         "<interface hosts='S1' names='eth0' address='2001:db8:2::10'/>" +
                         "<interface hosts='S2' names='eth0' address='2001:db8:2::11'/>" +
                         "</config>");
            @display("p=50,50");
        }
        router: Router6 { @display("p=350,200"); }
        sw1: EthernetSwitch { @display("p=350,330"); }
        hostA: StandardHost6 { @display("p=250,450"); }
        hostB: StandardHost6 { @display("p=450,450"); }
        sw2: EthernetSwitch { @display("p=350,80"); }
        S1: StandardHost6 { @display("p=250,20"); }
        S2: StandardHost6 { @display("p=450,20"); }
        requestsA: MldRequests {
            node = "hostA";
            script = "290 a ff0e::1:1 EXCLUDE";
            @display("p=50,500");
        }
        scenarioManager: ScenarioManager {
            script = xml("<scenario><at t='100'><set-channel-param src-module='router' src-gate='ethg[0]' par='disabled' value='true'/></at></scenario>");
            @display("p=50,150");
        }
        routeR: MulticastLeafRoute6 {
            node = "router";
            origin = "2001:db8:2::";
            prefixLength = 64;
            group = "::";
            inInterface = "eth1";
            outInterface = "eth0";
            @display("p=50,250");
        }
    connections:
        router.ethg++ <--> Eth100M <--> sw1.ethg++;
        router.ethg++ <--> Eth100M <--> sw2.ethg++;
        hostA.ethg++ <--> Eth100M <--> sw1.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw1.ethg++;
        S1.ethg++ <--> Eth100M <--> sw2.ethg++;
        S2.ethg++ <--> Eth100M <--> sw2.ethg++;
}

%inifile: omnetpp.ini

[General]
network = MldSource
sim-time-limit = 302s
seed-set = 0
**.mld.unsolicitedReportInterval = 1s
*.router.ipv6.mld.typename = "Mldv1"

**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.ipv6.hasMld = true
**.ipv6.mld.typename = "Mldv2"
**.mld.checksumMode = "computed"
*.router.multicastForwarding = true
*.r1.multicastForwarding = true
*.r2.multicastForwarding = true
*.router.eth[0].address = "0A-00-00-00-00-01"
*.router.eth[1].address = "0A-00-00-00-00-02"
*.hostA.eth[0].address = "0A-00-00-00-00-0A"
*.hostB.eth[0].address = "0A-00-00-00-00-0B"
*.S1.eth[0].address = "0A-00-00-00-00-10"
*.S2.eth[0].address = "0A-00-00-00-00-11"
*.S1.numApps = 1
*.S1.app[0].typename = "UdpBasicApp"
*.S1.app[0].destAddresses = "ff0e::1:1"
*.S1.app[0].destPort = 5000
*.S1.app[0].messageLength = 100B
*.S1.app[0].sendInterval = 0.5s
*.S1.app[0].startTime = 0.5s
*.S1.app[0].timeToLive = 16
*.S1.app[0].multicastInterface = "eth0"

%contains: stdout
PROTOCOLTEST rfc9777_older_querier_interval: PASS
