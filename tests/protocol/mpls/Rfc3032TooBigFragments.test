%description:

A labeled datagram too big for the next link.

Checks RFC3032-FRAG-8, FRAG-9, FRAG-11 and FRAG-12 from the catalogs under
doc/project/evidence/standard/. The English procedure is in
doc/project/evidence/protocol/mpls/checks/fragmentation.md#a-labeled-datagram-too-big-for-the-next-link;
the program steps below map onto its expected observations. The guards are observations 3 to 5;
step 1 is observation 2, on the first datagram of flow 2000, and step 2 observation 1.

Expected result FAIL, missing feature: the MPLS module has no MTU check and no fragmentation.
Mpls::processMplsPacketFromL2 sends a labeled packet to the link whatever its length
(src/inet/networklayer/mpls/Mpls.cc:217-285), and PPP sends a frame longer than its mtu
parameter. See results.md.

%# expected-result: FAIL

%includes:
#include "ProtocolTest.h"
#include "MplsChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc3032_too_big_fragments")
        // Expected observation 3: no labeled packet longer than 500 octets on L3.
        .meanwhile(never(on("R2.ppp[1].ppp").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isLabeled(p) && payloadLength(p) > 500; })
                  .describe("a labeled packet of more than 500 octets from R2 onto L3 (RFC3032-FRAG-8, FRAG-11)")
                  .within(10.0)))
        // Expected observation 4: each fragment carries one entry with the label 200.
        .meanwhile(never(on("R2.ppp[1].ppp").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isFragment(p) && !(labelStack(p).size() == 1 && topLabel(p) == 200); })
                  .describe("a fragment from R2 onto L3 without the one entry of label 200 (RFC3032-FRAG-12)")
                  .within(10.0)))
        // Expected observation 5: B delivers flow 2001 whole or not at all.
        .meanwhile(never(on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2001 && p->getByteLength() != 1000; })
                  .describe("a datagram on port 2001 that B delivers with other than 1000 octets")
                  .within(10.0)))
        // Expected observation 2: the datagrams of flow 2000 go whole.
        .once(on("R2.ppp[1].ppp").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return flowOf(p) == 2000; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(!isFragment(p), "the datagram of flow 2000 on L3 is a fragment (RFC3032-FRAG-9)"); })
                  .describe("a datagram of flow 2000 from R2 onto L3")
                  .within(3.0))
        // Expected observation 1: a labeled packet of 1032 octets of flow 2001 on L2.
        .once(on("R1.ppp[1].ppp").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return flowOf(p) == 2001; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(isLabeled(p) && payloadLength(p) == 1032, "the datagram of flow 2001 on L2 is " + num(payloadLength(p)) + " octets with " + stackStr(p) + ", where the stimulus needs a labeled packet of 1032 octets"); })
                  .describe("a datagram of flow 2001 from R1 onto L2")
                  .within(3.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc3032_too_big_fragments compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.StandardHost;
import inet.node.mpls.RsvpMplsRouter;
import ned.DatarateChannel;

channel Link extends DatarateChannel
{
    datarate = 10Mbps;
    delay = 1us;
}

// the path: host A on L1, the LSRs R1, R2 and R3, host B on L4, on PPP links.
network MplsPath
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='hostA' names='ppp0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='ppp0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='ppp1' address='10.0.12.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='ppp0' address='10.0.12.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='ppp1' address='10.0.23.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R3' names='ppp0' address='10.0.23.3' netmask='255.255.255.0'/>" +
                         "<interface hosts='R3' names='ppp1' address='10.0.2.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='ppp0' address='10.0.2.10' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        hostA: StandardHost { @display("p=100,200"); }
        R1: RsvpMplsRouter { @display("p=250,200"); }
        R2: RsvpMplsRouter { @display("p=400,200"); }
        R3: RsvpMplsRouter { @display("p=550,200"); }
        hostB: StandardHost { @display("p=700,200"); }
    connections:
        hostA.pppg++ <--> Link <--> R1.pppg++;
        R1.pppg++ <--> Link <--> R2.pppg++;
        R2.pppg++ <--> Link <--> R3.pppg++;
        R3.pppg++ <--> Link <--> hostB.pppg++;
}

%inifile: omnetpp.ini

[General]
network = MplsPath
sim-time-limit = 11s
seed-set = 0
*.R*.rsvp.helloInterval = 0s
*.R*.rsvp.helloTimeout = 0s
# The LSP: the FTN of R1 maps the FEC of B to an internal handle, and the LIB entry of the
# handle holds the NHLFE of the FEC; R2 and R3 hold the ILM of the labels from the link before.
*.R1.classifier.config = xml("<fectable><fecentry><id>1</id><destination>10.0.2.10</destination><label>1000</label></fecentry></fectable>")
*.R1.libTable.config = xml("<libtable><libentry><inLabel>1000</inLabel><inInterface>any</inInterface><outInterface>ppp1</outInterface><outLabel><op code='push' value='100'/></outLabel></libentry></libtable>")
*.R2.libTable.config = xml("<libtable><libentry><inLabel>100</inLabel><inInterface>ppp0</inInterface><outInterface>ppp1</outInterface><outLabel><op code='swap' value='200'/></outLabel></libentry></libtable>")
*.R3.libTable.config = xml("<libtable><libentry><inLabel>200</inLabel><inInterface>ppp0</inInterface><outInterface>ppp1</outInterface><outLabel><op code='pop'/></outLabel></libentry></libtable>")
*.hostA.numApps = 2
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].localPort = 1000
*.hostA.app[0].destAddresses = "10.0.2.10"
*.hostA.app[0].destPort = 2000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 1s
*.hostA.app[0].stopTime = 5.5s
*.hostA.app[0].sendInterval = 1s
*.hostA.app[0].timeToLive = 32
*.hostA.app[1].typename = "UdpBasicApp"
*.hostA.app[1].localPort = 1001
*.hostA.app[1].destAddresses = "10.0.2.10"
*.hostA.app[1].destPort = 2001
*.hostA.app[1].messageLength = 1000B
*.hostA.app[1].startTime = 1s
*.hostA.app[1].stopTime = 5.5s
*.hostA.app[1].sendInterval = 1s
*.hostA.app[1].timeToLive = 32
*.hostB.numApps = 2
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 2000
*.hostB.app[1].typename = "UdpSink"
*.hostB.app[1].localPort = 2001
*.R2.ppp[1].ppp.mtu = 500B
*.R3.ppp[0].ppp.mtu = 500B

%contains: stdout
PROTOCOLTEST rfc3032_too_big_fragments: PASS
