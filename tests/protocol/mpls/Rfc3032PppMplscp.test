%description:

The MPLS Control Protocol.

Checks RFC3032-PPP-1, PPP-5 and PPP-11 from the catalogs under doc/project/evidence/standard/.
The English procedure is in
doc/project/evidence/protocol/mpls/checks/links.md#the-mpls-control-protocol; the program steps
below map onto its expected observations. The guard notes each MPLS Control Protocol frame on L2;
step 1 is observations 1 and 2.

Expected result FAIL, missing feature: the PPP model has no LCP and no network control protocol;
Ppp.cc sends a frame of any protocol from the start (src/inet/linklayer/ppp/Ppp.cc), so no frame
with the PPP Protocol 8281 hex goes before the first labeled packet. See results.md.

%# expected-result: FAIL

%includes:
#include "ProtocolTest.h"
#include "MplsChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc3032_ppp_mplscp")
        // (notes each frame with the PPP Protocol 8281 hex on L2)
        .meanwhile(never(on("R1.ppp[1].ppp").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return pppProtocol(p) == PPP_MPLSCP && !(seenProtocol(PPP_MPLSCP) = true); })
                  .describe("(notes each MPLS Control Protocol frame from R1 onto L2)")
                  .within(10.0)))
        // Expected observations 1 and 2: an MPLS Control Protocol frame before the first labeled packet.
        .once(on("R1.ppp[1].ppp").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return pppProtocol(p) == PPP_MPLS_UNICAST; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(seenProtocol(PPP_MPLSCP), "R1 sends the first labeled packet onto L2 with no frame of the PPP Protocol 8281 hex before it (RFC3032-PPP-1, PPP-5, PPP-11)"); })
                  .describe("the first labeled packet from R1 onto L2")
                  .within(3.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc3032_ppp_mplscp compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.StandardHost;
import inet.node.mpls.RsvpMplsRouter;
import ned.DatarateChannel;

channel Link extends DatarateChannel
{
    datarate = 10Mbps;
    delay = 1us;
}

// the path: host A on L1, the LSRs R1, R2 and R3, host B on L4, on PPP links.
network MplsPath
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='hostA' names='ppp0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='ppp0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='ppp1' address='10.0.12.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='ppp0' address='10.0.12.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='ppp1' address='10.0.23.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R3' names='ppp0' address='10.0.23.3' netmask='255.255.255.0'/>" +
                         "<interface hosts='R3' names='ppp1' address='10.0.2.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='ppp0' address='10.0.2.10' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        hostA: StandardHost { @display("p=100,200"); }
        R1: RsvpMplsRouter { @display("p=250,200"); }
        R2: RsvpMplsRouter { @display("p=400,200"); }
        R3: RsvpMplsRouter { @display("p=550,200"); }
        hostB: StandardHost { @display("p=700,200"); }
    connections:
        hostA.pppg++ <--> Link <--> R1.pppg++;
        R1.pppg++ <--> Link <--> R2.pppg++;
        R2.pppg++ <--> Link <--> R3.pppg++;
        R3.pppg++ <--> Link <--> hostB.pppg++;
}

%inifile: omnetpp.ini

[General]
network = MplsPath
sim-time-limit = 11s
seed-set = 0
*.R*.rsvp.helloInterval = 0s
*.R*.rsvp.helloTimeout = 0s
# The LSP: the FTN of R1 maps the FEC of B to an internal handle, and the LIB entry of the
# handle holds the NHLFE of the FEC; R2 and R3 hold the ILM of the labels from the link before.
*.R1.classifier.config = xml("<fectable><fecentry><id>1</id><destination>10.0.2.10</destination><label>1000</label></fecentry></fectable>")
*.R1.libTable.config = xml("<libtable><libentry><inLabel>1000</inLabel><inInterface>any</inInterface><outInterface>ppp1</outInterface><outLabel><op code='push' value='100'/></outLabel></libentry></libtable>")
*.R2.libTable.config = xml("<libtable><libentry><inLabel>100</inLabel><inInterface>ppp0</inInterface><outInterface>ppp1</outInterface><outLabel><op code='swap' value='200'/></outLabel></libentry></libtable>")
*.R3.libTable.config = xml("<libtable><libentry><inLabel>200</inLabel><inInterface>ppp0</inInterface><outInterface>ppp1</outInterface><outLabel><op code='pop'/></outLabel></libentry></libtable>")
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].localPort = 1000
*.hostA.app[0].destAddresses = "10.0.2.10"
*.hostA.app[0].destPort = 2000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 1s
*.hostA.app[0].stopTime = 5.5s
*.hostA.app[0].sendInterval = 1s
*.hostA.app[0].timeToLive = 32
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 2000

%contains: stdout
PROTOCOLTEST rfc3032_ppp_mplscp: PASS
