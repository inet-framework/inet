%description:

The IPv4 Explicit NULL label.

Checks RFC3032-ENC-11 from the catalogs under doc/project/evidence/standard/. The English
procedure is in
doc/project/evidence/protocol/mpls/checks/reserved-labels.md#the-ipv4-explicit-null-label; the
program steps below map onto its expected observations. The guards are observation 3; steps 1 and
2 are observations 1 and 2, on one datagram.

Expected result FAIL, missing feature: the model gives the reserved label values no meaning.
Mpls.cc has no code for a label below 16, and the LIB treats 3 as an ordinary label. The LIB
refuses the label 0 in its configuration: LibTable::readTableFromXML asserts that the value of a
swap is above 0 (src/inet/networklayer/mpls/LibTable.cc:142), so the run stops at initialization
and no step gets a verdict. See results.md.

%# expected-result: FAIL

%includes:
#include "ProtocolTest.h"
#include "MplsChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc3032_explicit_null")
        // Expected observation 3: B delivers the five datagrams of flow 2000 ...
        .meanwhile(exactlyTimes(5, on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2000; })
                  .describe("a datagram that B delivers on port 2000")
                  .within(10.0)))
        // ... each with 100 octets of payload.
        .meanwhile(never(on("hostB.udp").signal("packetSentToUpper")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return deliveredPort(p) == 2000 && p->getByteLength() != 100; })
                  .describe("a datagram on port 2000 that B delivers with other than 100 octets")
                  .within(10.0)))
        // Expected observation 1: R2 replaces the label 100 with 0.
        .once(on("R2.ppp[1].ppp").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return flowOf(p) == 2000; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(labelStack(p).size() == 1 && labelStack(p)[0].label == 0 && labelStack(p)[0].s == true, "the frame holds " + stackStr(p) + ", where the rule gives label 0 with the S bit on the last entry only (the stimulus)"); })
                  .describe("a datagram of flow 2000 from R2 onto L3")
                  .within(3.0))
        // Expected observation 2: R3 pops the label 0 and forwards the IPv4 datagram.
        .once(on("R3.ppp[1].ppp").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return flowOf(p) == 2000; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(!isLabeled(p) && pppProtocol(p) == PPP_IPV4, "the frame holds " + stackStr(p) + " and the PPP Protocol " + num(pppProtocol(p)) + ", where the rule gives an IPv4 datagram with no label stack entry and the PPP Protocol 0021 hex = 33 (RFC3032-ENC-11)"); })
                  .describe("the same datagram from R3 onto L4")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc3032_explicit_null compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.StandardHost;
import inet.node.mpls.RsvpMplsRouter;
import ned.DatarateChannel;

channel Link extends DatarateChannel
{
    datarate = 10Mbps;
    delay = 1us;
}

// the path: host A on L1, the LSRs R1, R2 and R3, host B on L4, on PPP links.
network MplsPath
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='hostA' names='ppp0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='ppp0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='ppp1' address='10.0.12.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='ppp0' address='10.0.12.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='ppp1' address='10.0.23.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R3' names='ppp0' address='10.0.23.3' netmask='255.255.255.0'/>" +
                         "<interface hosts='R3' names='ppp1' address='10.0.2.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='ppp0' address='10.0.2.10' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        hostA: StandardHost { @display("p=100,200"); }
        R1: RsvpMplsRouter { @display("p=250,200"); }
        R2: RsvpMplsRouter { @display("p=400,200"); }
        R3: RsvpMplsRouter { @display("p=550,200"); }
        hostB: StandardHost { @display("p=700,200"); }
    connections:
        hostA.pppg++ <--> Link <--> R1.pppg++;
        R1.pppg++ <--> Link <--> R2.pppg++;
        R2.pppg++ <--> Link <--> R3.pppg++;
        R3.pppg++ <--> Link <--> hostB.pppg++;
}

%inifile: omnetpp.ini

[General]
network = MplsPath
sim-time-limit = 11s
seed-set = 0
*.R*.rsvp.helloInterval = 0s
*.R*.rsvp.helloTimeout = 0s
# The LSP: the FTN of R1 maps the FEC of B to an internal handle, and the LIB entry of the
# handle holds the NHLFE of the FEC; R2 and R3 hold the ILM of the labels from the link before.
*.R1.classifier.config = xml("<fectable><fecentry><id>1</id><destination>10.0.2.10</destination><label>1000</label></fecentry></fectable>")
*.R1.libTable.config = xml("<libtable><libentry><inLabel>1000</inLabel><inInterface>any</inInterface><outInterface>ppp1</outInterface><outLabel><op code='push' value='100'/></outLabel></libentry></libtable>")
*.R2.libTable.config = xml("<libtable><libentry><inLabel>100</inLabel><inInterface>ppp0</inInterface><outInterface>ppp1</outInterface><outLabel><op code='swap' value='0'/></outLabel></libentry></libtable>")
*.R3.libTable.config = xml("<libtable></libtable>")
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].localPort = 1000
*.hostA.app[0].destAddresses = "10.0.2.10"
*.hostA.app[0].destPort = 2000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 1s
*.hostA.app[0].stopTime = 5.5s
*.hostA.app[0].sendInterval = 1s
*.hostA.app[0].timeToLive = 32
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 2000

%contains: stdout
PROTOCOLTEST rfc3032_explicit_null: PASS
