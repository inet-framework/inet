%description:

RFC 1122 — a host accepts a datagram that arrives with TTL 1; only a gateway discards an
expired datagram.

Checks RFC1122-TTL-2 (must not) from doc/project/evidence/standard/rfc1122/catalog.md; also
covers RFC1122-TTL-3 and RFC791-TTL-1. The English procedure is in
doc/project/evidence/protocol/ipv4/checks/ttl.md#ttl-1-at-the-destination; the program
steps below map one to one onto its expected observations. Host A sends with TTL 2, exactly
the hop count of the path, so host B receives the datagram with TTL 1 and must deliver it.
Mapping of the mockup: host A = hostA, gateway R = router, host B = hostB; link 1 =
hostA-router, link 2 = router-hostB.

%includes:
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc1122_ttl_one_at_destination")
        // Expected observation 1: link 1 shows the datagram with TTL = 2 -- confirms the
        // stimulus and the sender's control of the field (RFC1122-TTL-3).
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5000 && ipv4.timeToLive == 2")
                  .capture("id", "ipv4.identification")
                  .describe("the datagram on link 1 with TTL 2")
                  .within(0.5))
        // Expected observation 2: link 2 shows the same datagram with TTL = 1 (RFC791-TTL-1).
        .once(on("router.eth[1].mac").signal("packetSentToLower")
                  .packet("ipv4.identification == {id} && ipv4.timeToLive == 1")
                  .describe("the same datagram on link 2 with TTL 1")
                  .within(0.1))
        // Expected observation 3: host B's UDP receives the datagram (RFC1122-TTL-2).
        .once(on("hostB.udp").signal("packetReceivedFromLower")
                  .packet("udp.destPort == 5000 && udp.totalLengthField == 108B")
                  .describe("the datagram at host B's UDP, delivered although it arrived with TTL 1")
                  .within(0.1))
        // Expected observation 4: host A receives no Time Exceeded message.
        .never(on("hostA.eth[0].mac").signal("packetReceivedFromLower")
                  .packet("icmpv4.type == 11")
                  .describe("a Time Exceeded message at host A")
                  .within(0.2));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc1122_ttl_one_at_destination compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The common mockup: hostA -- router -- hostB.
network Rfc791Net
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost { @display("p=250,100"); }
        router: Router { @display("p=400,100"); }
        hostB: StandardHost { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1]
}

%inifile: omnetpp.ini

[General]
network = Rfc791Net
sim-time-limit = 1s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
**.ipv4.arp.typename = "GlobalArp"

# One UDP datagram, 100 octets of application data, sender TTL 2: it arrives at host B with TTL 1.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].timeToLive = 2
*.hostA.app[0].startTime = 0.1s
*.hostA.app[0].sendInterval = 1s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST rfc1122_ttl_one_at_destination: PASS
