%description:

RFC 791 / RFC 792 — a gateway discards a too-large datagram that carries the don't
fragment flag, and it reports the drop to the source.

Checks RFC791-FRAG-5 (must) and RFC792-DU-4 (must + may) from rfc/rfc791-checklist.md. The English
procedure and the mockup are in rfc/rfc791-checks.md#dont-fragment. The 1028-octet DF datagram
meets a 576-octet MTU on link 2: the gateway must not fragment it, so nothing of it may
appear on link 2, and a cooperative gateway returns ICMP destination unreachable, code 4.
Mapping of the mockup: host A = hostA, gateway R = router, host B = hostB.

The ICMP step asserts a "may" clause of RFC 792. A silent discard also conforms to the
RFCs. If this step fails on some implementation, record an implementation gap against the
"may" clause, not a specification violation (see rfc/rfc791-checks.md#dont-fragment, Notes).

%includes:
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc791_dont_fragment")
        // Expected observation 1: the DF datagram on link 1 confirms the stimulus.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5000 && ipv4.dontFragment == true")
                  .capture("id", "ipv4.identification")
                  .describe("the DF datagram on link 1")
                  .within(0.5))
        // Expected observation 2: ICMP destination unreachable, code 4, toward host A
        // (RFC792-DU-4).
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .packet("icmpv4.type == 3 && icmpv4.code == 4") // the dissector protocol name is icmpv4
                  .describe("ICMP 'fragmentation needed and DF set' toward host A")
                  .within(0.1))
        // Expected observation 3: nothing of the datagram on link 2 (RFC791-FRAG-5).
        // A gateway that fragments despite DF would also skip the ICMP error, so the
        // step above already fails in that case; this step guards the time after it.
        .never(on("router.eth[1].mac").signal("packetSentToLower")
                  .packet("ipv4.identification == {id}")
                  .describe("any part of the DF datagram on link 2")
                  .within(0.3));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc791_dont_fragment compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The mockup of rfc/rfc791-checks.md#dont-fragment: hostA -- router -- hostB.
network Rfc791Net
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost { @display("p=250,100"); }
        router: Router { @display("p=400,100"); }
        hostB: StandardHost { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0], MTU 1500
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1], MTU 576
}

%inifile: omnetpp.ini

[General]
network = Rfc791Net
sim-time-limit = 1s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
*.ipv4.arp.typename = "GlobalArp"

# Link 2 would need fragmentation, but DF prohibits it.
# The MTU parameter lives on the MAC module of the interface.
*.router.eth[1].mac.mtu = 576B

# One UDP datagram with 1000 octets of application data and the DF flag set.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 1000B
*.hostA.app[0].dontFragment = true
*.hostA.app[0].startTime = 0.1s
*.hostA.app[0].sendInterval = 1s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST rfc791_dont_fragment: PASS
