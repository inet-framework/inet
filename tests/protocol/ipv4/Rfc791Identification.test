%description:

RFC 791 — the sender does not reuse an identification value for two consecutive datagrams to
the same destination and protocol.

Checks RFC791-ID-1 (must) from doc/project/evidence/standard/rfc791/catalog.md. The English procedure and the mockup
are in doc/project/evidence/protocol/ipv4/checks/identification.md#identification; the program steps below map one to one onto its
expected observations. Mapping of the mockup: host A = hostA, gateway R = router, host B =
hostB; link 1 = hostA-router, link 2 = router-hostB (this check only observes link 1; the
gateway and host B play no active part in it).

%includes:
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc791_identification")
        // Expected observation 1: the first datagram appears on link 1 -- confirms the
        // stimulus. Record its identification as ID1.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5000")
                  .capture("id1", "ipv4.identification")
                  .describe("the first datagram on link 1")
                  .within(0.5))
        // Expected observation 2: the second datagram appears on link 1 with an
        // identification that differs from ID1 (RFC791-ID-1). notBefore keeps this step
        // from ever being satisfied by the first datagram's own send event.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5000 && ipv4.identification != {id1}")
                  .describe("the second datagram on link 1 with a different identification")
                  .notBefore(0.05)
                  .within(0.2));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc791_identification compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The mockup of doc/project/evidence/protocol/ipv4/checks/identification.md#identification: hostA -- router -- hostB.
network Rfc791Net
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost { @display("p=250,100"); }
        router: Router { @display("p=400,100"); }
        hostB: StandardHost { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1]
}

%inifile: omnetpp.ini

[General]
network = Rfc791Net
sim-time-limit = 1s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
**.ipv4.arp.typename = "GlobalArp"

# Two UDP datagrams, 100 octets of application data each, 0.1 s apart, same source and
# destination port.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 0.1s
*.hostA.app[0].sendInterval = 0.1s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST rfc791_identification: PASS
