%description:

RFC 791 — a gateway fragments a large datagram and the destination reassembles it.

Checks RFC791-FRAG-1, RFC791-FRAG-2, RFC791-FRAG-3, RFC791-FRAG-4, and RFC791-REASM-1 from
rfc/rfc791-checklist.md. The English procedure, the mockup, and the size arithmetic are in
rfc/rfc791-checks.md#fragment-and-reassembly. A 1028-octet datagram meets a 576-octet MTU on link 2:
the expected split is 552 + 456 data octets, so the last fragment sits at octet offset 552.
Mapping of the mockup: host A = hostA, gateway R = router, host B = hostB.

Note: expected observation 4 of the check document ("no further part after the last
fragment") maps to the final never step only in part. The never window opens after the
reassembled datagram reaches host B, some tens of microseconds after the last fragment
left the router. An extra fragment inside that short gap would escape the step. See
rfc/results.md for this sharpening candidate.

%includes:
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc791_fragment_reassembly")
        // Expected observation 1: the complete datagram on link 1 carries zero
        // fragmentation information (RFC791-FRAG-1).
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5000 && ipv4.moreFragments == false && ipv4.fragmentOffset == 0")
                  .describe("the complete datagram on link 1 with zero fragmentation information")
                  .within(0.5))
        // Expected observation 2: the first fragment on link 2 -- offset 0, MF = 1;
        // record the identification (RFC791-FRAG-4).
        .once(on("router.eth[1].mac").signal("packetSentToLower")
                  .packet("ipv4.fragmentOffset == 0 && ipv4.moreFragments == true")
                  .capture("id", "ipv4.identification")
                  .describe("the first fragment on link 2")
                  .within(0.1))
        // Expected observation 3: the last fragment -- same identification, octet offset
        // 552, MF = 0 (RFC791-FRAG-2, RFC791-FRAG-3, RFC791-FRAG-4).
        .once(on("router.eth[1].mac").signal("packetSentToLower")
                  .packet("ipv4.identification == {id} && ipv4.fragmentOffset == 552 && ipv4.moreFragments == false")
                  .describe("the last fragment on link 2 at octet offset 552")
                  .within(0.1))
        // Expected observation 5: host B delivers one complete 1008-octet UDP datagram
        // above IP (RFC791-REASM-1).
        .once(on("hostB.udp").signal("packetReceivedFromLower")
                  .packet("udp.destPort == 5000 && udp.totalLengthField == 1008B") // the field carries a byte unit
                  .describe("the reassembled 1008-octet UDP datagram above IP at host B")
                  .within(0.1))
        // Expected observation 4 (partial; see the note in the description): no further
        // part of the datagram on link 2.
        .never(on("router.eth[1].mac").signal("packetSentToLower")
                  .packet("ipv4.identification == {id}")
                  .describe("a further part of the datagram on link 2")
                  .within(0.2));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc791_fragment_reassembly compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The mockup of rfc/rfc791-checks.md#fragment-and-reassembly: hostA -- router -- hostB.
network Rfc791Net
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost { @display("p=250,100"); }
        router: Router { @display("p=400,100"); }
        hostB: StandardHost { @display("p=550,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0], MTU 1500
        router.ethg++ <--> Eth100M <--> hostB.ethg++; // link 2 = router.eth[1], MTU 576
}

%inifile: omnetpp.ini

[General]
network = Rfc791Net
sim-time-limit = 1s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
*.ipv4.arp.typename = "GlobalArp"

# Link 2 forces fragmentation at the gateway (link 1 keeps the default 1500-octet MTU).
# The MTU parameter lives on the MAC module of the interface.
*.router.eth[1].mac.mtu = 576B

# One UDP datagram with 1000 octets of application data: total length 1028 octets.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 1000B
*.hostA.app[0].startTime = 0.1s
*.hostA.app[0].sendInterval = 1s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST rfc791_fragment_reassembly: PASS
