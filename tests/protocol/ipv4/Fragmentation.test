%description:

IPv4 fragmentation (RFC 791).

A 4000 byte datagram is larger than the 1500 byte Ethernet MTU, so host1 sends it as
several IPv4 fragments. A non-final fragment carries the more-fragments flag, and a
later fragment sits at a non-zero fragment offset.

%includes:
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("ipv4_fragmentation")
        .once(on("host1.eth[0].mac").signal("packetSentToLower")
                  .packet("ipv4.moreFragments == true")
                  .describe("an IPv4 fragment with the more-fragments flag set").within(0.2))
        .once(on("host1.eth[0].mac").signal("packetSentToLower")
                  .packet("ipv4.fragmentOffset > 0")
                  .describe("a later fragment at a non-zero offset").within(0.2));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "ipv4_fragmentation compiled\n";

%file: test.ned

import inet.node.inet.StandardHost;
import inet.node.ethernet.Eth100M;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// An ordinary two-host network -- note: NO tester module. The framework attaches a
// ProtocolTester at runtime because this build defines a Define_ProtocolTestProgram.
network SelfTestNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        host1: StandardHost { @display("p=300,100"); }
        host2: StandardHost { @display("p=500,100"); }
    connections:
        host1.ethg++ <--> Eth100M <--> host2.ethg++;
}

%inifile: omnetpp.ini

[General]
network = SelfTestNet
sim-time-limit = 1s
seed-set = 0

*.host1.numApps = 1
*.host1.app[0].typename = "UdpBasicApp"
*.host1.app[0].destAddresses = "host2"
*.host1.app[0].destPort = 5000
*.host1.app[0].localPort = 4000
*.host1.app[0].messageLength = 4000B
*.host1.app[0].sendInterval = 0.2s
*.host1.app[0].startTime = 0.1s
*.host2.numApps = 1
*.host2.app[0].typename = "UdpSink"
*.host2.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST ipv4_fragmentation: PASS
