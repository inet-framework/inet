%description:

RFC 1122 — no ICMP error message is sent about a datagram whose source address does not name
a single host.

Checks RFC1122-ICMP-9 (must not) from doc/project/evidence/standard/rfc1122/catalog.md. The
English procedure is in
doc/project/evidence/protocol/ipv4/checks/error-report.md#no-error-for-an-invalid-source;
the program steps below map one to one onto its expected observations. Mapping of the
mockup with a relay: host A = hostA, gateway R = router, relay T = tap, host B = hostB. The
relay rewrites the source address to 255.255.255.255 and keeps the checksum valid; the
datagram goes to port 5001, on which no program listens, so a report would otherwise be due.

%includes:
#include "ProtocolTest.h"
#include "Ipv4Mutations.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc1122_no_error_for_invalid_source")
        // The relay rewrites the source address and keeps the checksum valid.
        .intercept(intercept("tap").match("udp.destPort == 5001").nth(1)
                     .mutate([](Packet *frame) { rewriteIpv4Header(frame, [](Ipv4Header& h) { h.setSrcAddress(Ipv4Address::ALLONES_ADDRESS); }); })
                     .describe("the datagram (set its source to 255.255.255.255)"))
        // Expected observation 1: at host B's interface the datagram carries the broadcast source.
        .once(on("hostB.eth[0].mac").signal("packetReceivedFromLower")
                  .packet("udp.destPort == 5001")
                  .match([](const MatchContext& c) { return ipv4Address(c.event.packet, "ipv4.srcAddress") == "255.255.255.255"; })
                  .capture("id", "ipv4.identification")
                  .describe("the datagram at host B's interface with source 255.255.255.255, to the closed port 5001")
                  .within(0.5))
        // Expected observation 2: host B records a discard, at the network layer or at UDP.
        .anyOf({ on("hostB.ipv4.ip").signal("packetDropped")
                     .packet("ipv4.identification == {id}")
                     .describe("host B's network layer discards the datagram")
                     .within(0.1),
                 on("hostB.udp").signal("packetDropped")
                     .match([](const MatchContext& c) { return udpDestinationPort(c.event.packet) == 5001; }) // the drop record carries no protocol tag; read the header
                     .describe("host B's UDP discards the datagram for want of a port")
                     .within(0.1) })
        // Expected observation 3: from then on, host B sends no ICMP message (RFC1122-ICMP-9).
        .never(on("hostB.eth[0].mac").signal("packetSentToLower")
                  .packet("icmpv4.type >= 0")
                  .describe("any ICMP message from host B")
                  .within(0.2));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc1122_no_error_for_invalid_source compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.protocoltest.PacketTap;

// The mockup with a relay: hostA -- router -- tap -- hostB.
network Rfc791TapNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost { @display("p=200,100"); }
        router: Router { @display("p=350,100"); }
        tap: PacketTap { @display("p=500,100"); }
        hostB: StandardHost { @display("p=650,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> router.ethg++; // link 1 = router.eth[0]
        router.ethg++ <--> Eth100M <--> tap.a;        // link 2 = router.eth[1], before the relay
        tap.b <--> Eth100M <--> hostB.ethg++;         // link 2, after the relay
}

%inifile: omnetpp.ini

[General]
network = Rfc791TapNet
sim-time-limit = 1s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
**.ipv4.arp.typename = "GlobalArp"

# Every node computes the IPv4 header checksum; the relay's rewrite is the only wrong value.
**.ipv4.ip.checksumMode = "computed"

# One UDP datagram, 100 octets, to port 5001 on host B. No program listens there.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5001
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 0.1s
*.hostA.app[0].sendInterval = 1s
*.hostB.numApps = 0

%contains: stdout
PROTOCOLTEST rfc1122_no_error_for_invalid_source: PASS
