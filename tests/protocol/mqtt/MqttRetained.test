%description:
A retained publication is replayed to a late subscriber; a zero-byte retained
publication clears it and is forwarded live with RETAIN false. A still later
subscriber receives no stale value.

%includes:
#include "ProtocolTest.h"
#include "inet/applications/mqtt/MqttPacket_m.h"

%global:
using namespace inet;
using namespace inet::mqtt;
using namespace inet::protocoltest;
Define_ProtocolTestProgram()
{
    return ProtocolTest("mqtt_retained")
        .once(on("subscriber.app[0]").signal("packetReceivedFromLower")
            .filterEvent([](const MatchContext& c) { return c.event.packet->peekAtFront<MqttPacket>()->getType()==PUBLISH; })
            .assertEvent([](const MatchContext& c) { auto p=c.event.packet->peekAtFront<MqttPacket>(); return p->getRetain() && p->getPayloadArraySize()==1 && p->getPayload(0)==65; }).within(2))
        .once(on("subscriber.app[0]").signal("packetReceivedFromLower")
            .filterEvent([](const MatchContext& c) { return c.event.packet->peekAtFront<MqttPacket>()->getType()==PUBLISH; })
            .assertEvent([](const MatchContext& c) { auto p=c.event.packet->peekAtFront<MqttPacket>(); return !p->getRetain() && p->getPayloadArraySize()==0; }).within(2))
        .never(on("observer.app[0]").signal("packetSentToUpper").within(2));
}

%activity:
EV << "MQTT retained fixture compiled\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqtt.MqttTestNetwork
seed-set = 0
sim-time-limit = 5s
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.publisher.numApps = 1
*.publisher.app[0].typename = "MqttClient"
*.publisher.app[0].clientIdentifier = "publisher"
*.publisher.app[0].connectAddress = "broker"
*.publisher.app[0].startTime = 0.1s
*.publisher.app[0].workload = xml("<mqtt><publish at='0.1s' topic='factory/value' retain='true' payload='41'/><publish at='2s' topic='factory/value' retain='true' payload=''/></mqtt>")
*.subscriber.numApps = 1
*.subscriber.app[0].typename = "MqttClient"
*.subscriber.app[0].clientIdentifier = "subscriber"
*.subscriber.app[0].connectAddress = "broker"
*.subscriber.app[0].startTime = 1s
*.subscriber.app[0].workload = xml("<mqtt><subscribe at='0s' filter='factory/#'/></mqtt>")
*.observer.numApps = 1
*.observer.app[0].typename = "MqttClient"
*.observer.app[0].clientIdentifier = "observer"
*.observer.app[0].connectAddress = "broker"
*.observer.app[0].startTime = 3s
*.observer.app[0].workload = xml("<mqtt><subscribe at='0s' filter='factory/#'/></mqtt>")

%contains: stdout
PROTOCOLTEST mqtt_retained: PASS
