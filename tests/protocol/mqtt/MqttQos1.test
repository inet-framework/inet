%description:
Production QoS 1 publication is acknowledged on both independently identified legs.
The subscriber receives one exact binary payload in this fault-free case.

%includes:
#include "ProtocolTest.h"
#include "inet/applications/mqtt/MqttPacket_m.h"
#include "inet/common/packet/chunk/BytesChunk.h"

%global:
using namespace inet;
using namespace inet::mqtt;
using namespace inet::protocoltest;
Define_ProtocolTestProgram()
{
    return ProtocolTest("mqtt_qos1")
        .once(on("subscriber.app[0]").signal("packetSentToUpper")
            .assertEvent([](const MatchContext& c) { return c.event.packet->peekDataAsBytes()->getBytes() == std::vector<uint8_t>({0,255,65}); }).within(2))
        .once(on("subscriber.app[0]").signal("packetSentToLower")
            .filterEvent([](const MatchContext& c) { return c.event.packet->peekAtFront<MqttPacket>()->getType() == PUBACK; }).within(0.1))
        .never(on("subscriber.app[0]").signal("packetSentToUpper").within(1));
}

%activity:
EV << "MQTT QoS 1 fixture compiled\n";

%inifile: omnetpp.ini
[General]
network = inet.tests.mqtt.MqttTestNetwork
seed-set = 0
sim-time-limit = 4s
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.publisher.numApps = 1
*.publisher.app[0].typename = "MqttClient"
*.publisher.app[0].clientIdentifier = "publisher"
*.publisher.app[0].connectAddress = "broker"
*.publisher.app[0].startTime = 0.1s
*.publisher.app[0].workload = xml("<mqtt><publish at='0.5s' topic='factory/line1/temperature' qos='1' payload='00ff41'/></mqtt>")
*.subscriber.numApps = 1
*.subscriber.app[0].typename = "MqttClient"
*.subscriber.app[0].clientIdentifier = "subscriber"
*.subscriber.app[0].connectAddress = "broker"
*.subscriber.app[0].startTime = 0.1s
*.subscriber.app[0].workload = xml("<mqtt><subscribe at='0s' filter='factory/+/temperature' qos='1'/></mqtt>")

%contains: stdout
PROTOCOLTEST mqtt_qos1: PASS
