%description:
Closing a TCP connection without DISCONNECT causes the production broker to
publish its stored binary Will. A subscribed production client receives it once.

%includes:
#include "ProtocolTest.h"
#include "MqttScriptedPeer.h"

%file: peer.cc
#include "../../MqttScriptedPeer.cc"

%global:
using namespace inet;
using namespace inet::mqtt;
using namespace inet::mqtttest;
using namespace inet::protocoltest;
Define_ProtocolTestProgram()
{
    return ProtocolTest("mqtt_will")
        .act(action().at(0.3).run<MqttScriptedPeer>("publisher.app[0]",[](auto& app) { app.socket().connect(app.addressOf("broker"),1883); }))
        .once(on("publisher.app[0]").signal("socketEstablished").within(1))
        .act(action().run<MqttScriptedPeer>("publisher.app[0]",[](auto& app) {
            auto p=makeShared<MqttPacket>(); p->setType(CONNECT); p->setClientIdentifier("willClient"); p->setWill(true);
            p->setWillTopic("factory/status"); p->setWillPayloadArraySize(1); p->setWillPayload(0,255);
            app.sendMqtt(app.socket(),p);
        }))
        .once(on("publisher.app[0]").signal("packetReceivedFromLower")
            .filterEvent([](const MatchContext& c) { return c.event.packet->peekAtFront<MqttPacket>()->getType()==CONNACK; }).within(1))
        .act(action().after(0.1).run<MqttScriptedPeer>("publisher.app[0]",[](auto& app) { app.socket().close(); }))
        .once(on("subscriber.app[0]").signal("packetReceivedFromLower")
            .filterEvent([](const MatchContext& c) { return c.event.packet->peekAtFront<MqttPacket>()->getType()==PUBLISH; })
            .assertEvent([](const MatchContext& c) {
                auto p=c.event.packet->peekAtFront<MqttPacket>();
                return std::string(p->getTopic())=="factory/status" && p->getPayloadArraySize()==1 && p->getPayload(0)==255 && !p->getRetain();
            }).within(1))
        .once(on("subscriber.app[0]").signal("packetSentToUpper").within(0.1))
        .never(on("subscriber.app[0]").signal("packetSentToUpper").within(1));
}

%activity:
EV << "MQTT Will fixture compiled\n";

%file: test.ned
import inet.protocoltest.TcpTestApp;
simple MqttScriptedPeer extends TcpTestApp { parameters: @class(::inet::mqtttest::MqttScriptedPeer); }

%inifile: omnetpp.ini
[General]
network = inet.tests.mqtt.MqttTestNetwork
seed-set = 0
sim-time-limit = 4s
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.publisher.numApps = 1
*.publisher.app[0].typename = "MqttScriptedPeer"
*.subscriber.numApps = 1
*.subscriber.app[0].typename = "MqttClient"
*.subscriber.app[0].clientIdentifier = "subscriber"
*.subscriber.app[0].connectAddress = "broker"
*.subscriber.app[0].startTime = 0.1s
*.subscriber.app[0].workload = xml("<mqtt><subscribe at='0s' filter='factory/#'/></mqtt>")

%contains: stdout
PROTOCOLTEST mqtt_will: PASS
