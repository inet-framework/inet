%description:
Atomic protocolelement test: time-based lifetime (stale packet dropped).

SendWithLifetime stamps each packet's creation time. A PacketDelayer holds every packet for 0.2s,
which is longer than the receiver's 0.1s maxLifetime, so by the time the packet reaches
ReceiveWithLifetime it is too old and gets dropped -- it never reaches the sink. This exercises the
expiry path, the time-based counterpart of the hop-limit-expired test.

Note: the delayer is declared before the sender so it initializes (and caches its gates) first;
otherwise the sender's protocol registration can reach the delayer before its gates are set.

%file: PeLifetimeExpired.cc

#include "ProtocolTest.h"

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTest(pe_lifetime_expired)
{
    return ProtocolTest("pe_lifetime_expired")
        // the aged-out packet is dropped at the receiver ...
        .once(on("receiver").signal("packetDropped")
                  .describe("the receiver dropping the stale packet").within(1.5))
        // ... and nothing is ever delivered
        .never(on("sink").signal("packetPushed")
                  .describe("any delivery to the sink").within(1.5));
}

%inifile: omnetpp.ini

[General]
network = PeLifetimeExpiredNet
sim-time-limit = 3s
cmdenv-express-mode = true
*.tester.testName = "pe_lifetime_expired"
*.source.packetLength = 100B
*.source.productionInterval = 1s
*.receiver.maxLifetime = 0.1s
*.delayer.delay = 0.2s

%file: test.ned

import inet.queueing.source.ActivePacketSource;
import inet.queueing.sink.PassivePacketSink;
import inet.queueing.common.PacketDelayer;
import inet.protocolelement.lifetime.SendWithLifetime;
import inet.protocolelement.lifetime.ReceiveWithLifetime;
import inet.protocoltest.ProtocolTester;

network PeLifetimeExpiredNet
{
    submodules:
        tester: ProtocolTester { @display("p=50,50"); }
        delayer: PacketDelayer { @display("p=200,250"); } // declared early so it initializes before the sender
        source: ActivePacketSource { @display("p=100,100"); }
        sender: SendWithLifetime { @display("p=100,200"); }
        receiver: ReceiveWithLifetime { @display("p=100,300"); }
        sink: PassivePacketSink { @display("p=100,400"); }
    connections:
        source.out --> sender.in;
        sender.out --> delayer.in;
        delayer.out --> receiver.in;
        receiver.out --> sink.in;
}

%contains: stdout
PROTOCOLTEST pe_lifetime_expired: PASS
