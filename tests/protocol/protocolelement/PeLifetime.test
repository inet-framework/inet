%description:
Atomic protocolelement test: time-based lifetime (fresh packet passes).

SendWithLifetime stamps each packet with its creation time. ReceiveWithLifetime drops packets older
than maxLifetime (1s here). With a direct (zero-delay) connection the packet's age at the receiver is
0, well under the limit, so it passes through and reaches the sink. This is the time-based analogue
of the hop-limit element.

%file: PeLifetime.cc

#include "ProtocolTest.h"

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTest(pe_lifetime)
{
    return ProtocolTest("pe_lifetime")
        .once(on("sink").signal("packetPushed")
                  .describe("the fresh packet delivered to the sink").within(1.5));
}

%inifile: omnetpp.ini

[General]
network = PeLifetimeNet
sim-time-limit = 3s
cmdenv-express-mode = true
*.tester.testName = "pe_lifetime"
*.source.packetLength = 100B
*.source.productionInterval = 1s
*.receiver.maxLifetime = 1s

%file: test.ned

import inet.queueing.source.ActivePacketSource;
import inet.queueing.sink.PassivePacketSink;
import inet.protocolelement.lifetime.SendWithLifetime;
import inet.protocolelement.lifetime.ReceiveWithLifetime;
import inet.protocoltest.ProtocolTester;

network PeLifetimeNet
{
    submodules:
        tester: ProtocolTester { @display("p=50,50"); }
        source: ActivePacketSource { @display("p=100,100"); }
        sender: SendWithLifetime { @display("p=100,200"); }
        receiver: ReceiveWithLifetime { @display("p=100,300"); }
        sink: PassivePacketSink { @display("p=100,400"); }
    connections:
        source.out --> sender.in;
        sender.out --> receiver.in;
        receiver.out --> sink.in;
}

%contains: stdout
PROTOCOLTEST pe_lifetime: PASS
