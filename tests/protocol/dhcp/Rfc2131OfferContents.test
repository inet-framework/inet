%description:

RFC 2131 -- what a DHCPOFFER carries: the server identifier and the lease time it must hold,
the options it must not hold, and the fields it copies from the DHCPDISCOVER.

Checks RFC2131-OFF-2 (description), OFF-3 (must), OFF-4 (must), OFF-5 (must not), OFF-6
(description, in part), OFF-8 (description), RFC2132-LEASE-1 and RFC2132-SRVID-1, from
doc/project/evidence/standard/rfc2131/catalog.md and
doc/project/evidence/standard/rfc2132/catalog.md. The English procedure is in
doc/project/evidence/protocol/dhcp/checks/exchange.md#offer-contents; the program steps below
map onto its expected observations. Mapping of the plain mockup: server S = server,
client C = hostA.

Two rows of RFC 2131 table 3 are not part of this check. The client identifier row is
overridden by RFC 6842; see Rfc6842ClientIdentifierEchoed.test. The ciaddr and giaddr rows have
a check of their own, Rfc2131ReplyAddressFields.test, so that a wrong address field cannot stop
this program before it reads the options.

Step 0 records the fields that the DHCPOFFER must copy, and it observes the DHCPDISCOVER at the
client transport module, so that step 1 can read the answer without the two steps competing for
one event.

An absent option is read through hasOption, which follows the rule the serializer uses to
decide whether an option reaches the octets; see DhcpChecks.h.

%includes:
#include "ProtocolTest.h"
#include "DhcpChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

// The fields the DHCPOFFER must copy from the DHCPDISCOVER, kept between the two steps.
struct DiscoverFields {
    uint32_t xid = 0;
    bool broadcast = false;
    MacAddress chaddr;
    bool recorded = false;
};

static DiscoverFields discoverFields;

Define_ProtocolTestProgram()
{
    discoverFields = DiscoverFields();
    return ProtocolTest("rfc2131_offer_contents")
        // Expected observation 1: the DHCPDISCOVER; record the fields the answer must copy.
        .once(on("hostA.udp").signal("packetSentToLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      if (dhcp == nullptr || dhcp->getOptions().getMessageType() != DHCPDISCOVER)
                          return false;
                      discoverFields.xid = dhcp->getXid();
                      discoverFields.broadcast = dhcp->getBroadcast();
                      discoverFields.chaddr = dhcp->getChaddr();
                      discoverFields.recorded = true;
                      return true;
                  })
                  .describe("a DHCPDISCOVER from the client, whose xid, flags and chaddr are recorded")
                  .within(1.0))
        // Expected observations 2 to 6, on the DHCPOFFER that answers it.
        .once(on("server.eth[0].mac").signal("packetSentToLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      if (dhcp == nullptr || dhcp->getOptions().getMessageType() != DHCPOFFER)
                          return false;
                      if (!discoverFields.recorded)
                          return false;
                      const DhcpOptions& o = dhcp->getOptions();
                      // observation 2: the recorded transaction identifier
                      bool sameXid = dhcp->getXid() == discoverFields.xid;
                      // observation 3: a server identifier option holding the sending address
                      bool serverId = hasOption(dhcp, SERVER_ID)
                              && quad(o.getServerIdentifier()) == ipv4Source(c.event.packet);
                      // observation 4: a lease time option of 300
                      bool lease = hasOption(dhcp, LEASE_TIME) && o.getLeaseTime() == SimTime(300, SIMTIME_S);
                      // observation 5: no requested IP address and no parameter request list
                      bool prohibited = !hasOption(dhcp, REQUESTED_IP) && !hasOption(dhcp, PARAM_LIST);
                      // observation 6: hops 0, secs 0, and the recorded flags and chaddr
                      bool fixedPart = dhcp->getHops() == 0 && dhcp->getSecs() == 0
                              && dhcp->getBroadcast() == discoverFields.broadcast
                              && dhcp->getChaddr() == discoverFields.chaddr;
                      return sameXid && serverId && lease && prohibited && fixedPart;
                  })
                  .describe("the DHCPOFFER: the recorded xid; a server identifier option holding the sending address; a lease time of 300; no requested IP address and no parameter request list; hops 0, secs 0, and the recorded flags and chaddr")
                  .within(1.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2131_offer_contents compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The plain mockup: one server and one client on one link.
network Rfc2131PlainNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config><interface hosts='server' address='192.168.1.1' netmask='255.255.255.0'/></config>");
            @display("p=100,50");
        }
        server: StandardHost { @display("p=250,100"); }
        hostA: StandardHost { @display("p=450,100"); }
    connections:
        server.ethg++ <--> Eth100M <--> hostA.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Rfc2131PlainNet
sim-time-limit = 2s
seed-set = 0

# Static address resolution keeps the wire free of request and reply noise.
**.ipv4.arp.typename = "GlobalArp"

# The server holds 192.168.1.1 and gives out addresses from 192.168.1.100, with a lease of
# 300 seconds.
*.server.numApps = 1
*.server.app[0].typename = "DhcpServer"
*.server.app[0].interface = "eth0"
*.server.app[0].numReservedAddresses = 100
*.server.app[0].maxNumClients = 100
*.server.app[0].leaseTime = 300s

*.hostA.numApps = 1
*.hostA.app[0].typename = "DhcpClient"
*.hostA.app[0].interface = "eth0"

%contains: stdout
PROTOCOLTEST rfc2131_offer_contents: PASS
