%description:

RFC 2131 -- when the renewal at T1 stays unanswered, the client broadcasts a DHCPREQUEST at T2.

Checks RFC2131-LEASE-6 (description) and REQ-7 (must) and RFC2132-T2-1, and covers LEASE-3,
from doc/project/evidence/standard/rfc2131/catalog.md and
doc/project/evidence/standard/rfc2132/catalog.md. The English procedure is in
doc/project/evidence/protocol/dhcp/checks/lease.md#rebinding-at-t2; the program steps below map
onto its expected observations. Mapping of the mockup with a relay: server S = server,
relay T = tap, client C = hostA.

Level 3: the relay drops the second DHCPACK of the run, which is the one that answers the
renewal at T1. Without that drop the client returns to BOUND and never reaches T2.

The lease is 120 seconds, so T1 falls at 60 seconds, T2 at 105 and the expiry at 120. RFC 2131
section 4.4.3 names 60 seconds as a reasonable period for a client to wait for a DHCPACK before
it starts again, so T2 must fall inside that period after T1 or no client can be observed to
rebind at all. The gap T2 minus T1 is 0.375 of the lease, and 45 seconds here.

%includes:
#include "ProtocolTest.h"
#include "DhcpChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static Ipv4Address leasedAddress;

Define_ProtocolTestProgram()
{
    leasedAddress = Ipv4Address();
    return ProtocolTest("rfc2131_rebind_at_t2")
        // The relay drops the DHCPACK that answers the renewal: the second of the run.
        .intercept(intercept("tap").match("DhcpMessage.options.messageType == 5").nth(2).drop()
                     .describe("the second DHCPACK, which answers the renewal at T1"))
        // Expected observation 1, first half: the client gets a lease of 120 seconds.
        .once(on("hostA.eth[0].mac").signal("packetReceivedFromLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      if (dhcp == nullptr || dhcp->getOptions().getMessageType() != DHCPACK)
                          return false;
                      if (!hasOption(dhcp, LEASE_TIME) || dhcp->getOptions().getLeaseTime() != SimTime(120, SIMTIME_S))
                          return false;
                      leasedAddress = dhcp->getYiaddr();
                      return !leasedAddress.isUnspecified();
                  })
                  .describe("a DHCPACK reaching the client with a lease time of 120 and an address in yiaddr")
                  .within(5.0))
        // Expected observation 1, second half: the renewal leaves at T1, 60 seconds later.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      return dhcp != nullptr && dhcp->getOptions().getMessageType() == DHCPREQUEST
                             && dhcp->getCiaddr() == leasedAddress
                             && !isLinkBroadcast(c.event.packet);
                  })
                  .describe("the unicast renewal DHCPREQUEST at T1")
                  .notBefore(59.0).within(61.0))
        // Expected observation 2, first half: the server answers it.
        .once(on("server.eth[0].mac").signal("packetSentToLower")
                  .match([](const MatchContext& c) { return isDhcp(c.event.packet, DHCPACK); })
                  .describe("the DHCPACK the server sends in answer to the renewal")
                  .within(1.0))
        // Expected observation 2, second half: it does not reach the client. The window closes
        // just before T2, so the absence covers the whole time the client waits.
        .never(on("hostA.eth[0].mac").signal("packetReceivedFromLower")
                  .match([](const MatchContext& c) { return isDhcp(c.event.packet, DHCPACK); })
                  .describe("a DHCPACK reaching the client between the renewal and T2")
                  .within(44.0))
        // Expected observations 3 to 6: the rebinding at T2.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      if (dhcp == nullptr || dhcp->getOptions().getMessageType() != DHCPREQUEST)
                          return false;
                      // observation 4: broadcast at both layers
                      bool broadcast = ipv4Destination(c.event.packet) == "255.255.255.255"
                              && isLinkBroadcast(c.event.packet);
                      // observation 5: ciaddr holds the leased address, and neither option is there
                      bool fields = dhcp->getCiaddr() == leasedAddress
                              && !hasOption(dhcp, SERVER_ID) && !hasOption(dhcp, REQUESTED_IP);
                      return broadcast && fields;
                  })
                  .describe("a broadcast DHCPREQUEST at T2 whose ciaddr holds the leased address and which carries neither a server identifier nor a requested IP address option")
                  .within(3.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2131_rebind_at_t2 compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.protocoltest.PacketTap;

// The mockup with a relay on the path: server -- relay -- client.
network Rfc2131TapNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config><interface hosts='server' address='192.168.1.1' netmask='255.255.255.0'/></config>");
            @display("p=100,50");
        }
        server: StandardHost { @display("p=250,100"); }
        tap: PacketTap { @display("p=350,100"); }
        hostA: StandardHost { @display("p=500,100"); }
    connections:
        server.ethg++ <--> Eth100M <--> tap.a;
        tap.b <--> Eth100M <--> hostA.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Rfc2131TapNet
sim-time-limit = 115s
seed-set = 0

# Static address resolution keeps the wire free of request and reply noise.
**.ipv4.arp.typename = "GlobalArp"

*.server.numApps = 1
*.server.app[0].typename = "DhcpServer"
*.server.app[0].interface = "eth0"
*.server.app[0].numReservedAddresses = 100
*.server.app[0].maxNumClients = 100
*.server.app[0].leaseTime = 120s

*.hostA.numApps = 1
*.hostA.app[0].typename = "DhcpClient"
*.hostA.app[0].interface = "eth0"

%contains: stdout
PROTOCOLTEST rfc2131_rebind_at_t2: PASS
