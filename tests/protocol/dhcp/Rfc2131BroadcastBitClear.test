%description:

RFC 2131 -- a reply to a client that cleared the BROADCAST bit is a unicast to the yiaddr and the
chaddr of that reply.

Checks RFC2131-BCAST-5 (description) and the clear half of BCAST-6 (should) from
doc/project/evidence/standard/rfc2131/catalog.md. The English procedure is in
doc/project/evidence/protocol/dhcp/checks/reply-delivery.md#reply-to-a-client-that-clears-the-broadcast-bit;
the program steps below map onto its expected observations. Mapping of the plain mockup:
server S = server, client C = hostA.

Expected result FAIL, model gap: DhcpServer::sendOffer and DhcpServer::sendAck broadcast the
reply in this case as well. The code has the four branches of RFC 2131 section 4.1 and the fourth
one carries a TODO and the wrong action -- "TODO should send it to client's hardware address and
yiaddr address, but the application can not set the destination MacAddress." followed by
"destAddr = Ipv4Address::ALLONES_ADDRESS;" over a commented-out "destAddr = lease->ip;"
(src/inet/applications/dhcp/DhcpServer.cc:478 to 482). So the server broadcasts whatever the bit
says, which also passes Rfc2131BroadcastBitSet.test: the pair of checks is what shows that the
server is not reading the bit but doing one thing always.

The reply still reaches the client, so nothing in the mockup stops working. What the rule buys,
and what is lost here, is that a message addressed to one client does not reach every host of the
subnet. The assertion stays as the standard states it; see results.md.

%# expected-result: FAIL

%includes:
#include "ProtocolTest.h"
#include "DhcpChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc2131_broadcast_bit_clear")
        // Expected observation 1: the client clears the bit, with ciaddr and giaddr zero.
        .once(on("hostA.udp").signal("packetSentToLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      return dhcp != nullptr && dhcp->getOptions().getMessageType() == DHCPDISCOVER
                             && !dhcp->getBroadcast()
                             && dhcp->getCiaddr().isUnspecified() && dhcp->getGiaddr().isUnspecified();
                  })
                  .describe("a DHCPDISCOVER from the client with the BROADCAST bit clear and ciaddr and giaddr 0.0.0.0")
                  .within(1.0))
        // Expected observations 2 and 4: the DHCPOFFER is a unicast at both layers, to the yiaddr
        // and the chaddr it carries, and its own bit is clear.
        .once(on("server.eth[0].mac").signal("packetSentToLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      return dhcp != nullptr && dhcp->getOptions().getMessageType() == DHCPOFFER
                             && !dhcp->getBroadcast()                                        // observation 4
                             && ipv4Destination(c.event.packet) == quad(dhcp->getYiaddr())    // observation 2
                             && macDestination(c.event.packet) == dhcp->getChaddr().str()     // observation 2
                             && !isLinkBroadcast(c.event.packet);
                  })
                  .describe("a DHCPOFFER unicast to the yiaddr and the chaddr it carries, with the BROADCAST bit clear")
                  .within(1.0))
        // Expected observations 3 and 4: the DHCPACK is a unicast in the same way.
        .once(on("server.eth[0].mac").signal("packetSentToLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      return dhcp != nullptr && dhcp->getOptions().getMessageType() == DHCPACK
                             && !dhcp->getBroadcast()
                             && ipv4Destination(c.event.packet) == quad(dhcp->getYiaddr())
                             && macDestination(c.event.packet) == dhcp->getChaddr().str()
                             && !isLinkBroadcast(c.event.packet);
                  })
                  .describe("a DHCPACK unicast to the yiaddr and the chaddr it carries, with the BROADCAST bit clear")
                  .within(1.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2131_broadcast_bit_clear compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The plain mockup: one server and one client on one link.
network Rfc2131PlainNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config><interface hosts='server' address='192.168.1.1' netmask='255.255.255.0'/></config>");
            @display("p=100,50");
        }
        server: StandardHost { @display("p=250,100"); }
        hostA: StandardHost { @display("p=450,100"); }
    connections:
        server.ethg++ <--> Eth100M <--> hostA.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Rfc2131PlainNet
sim-time-limit = 2s
seed-set = 0

# Static address resolution keeps the wire free of request and reply noise.
**.ipv4.arp.typename = "GlobalArp"

# The server holds 192.168.1.1 and gives out addresses from 192.168.1.100, with a lease of
# 300 seconds.
*.server.numApps = 1
*.server.app[0].typename = "DhcpServer"
*.server.app[0].interface = "eth0"
*.server.app[0].numReservedAddresses = 100
*.server.app[0].maxNumClients = 100
*.server.app[0].leaseTime = 300s

*.hostA.numApps = 1
*.hostA.app[0].typename = "DhcpClient"
*.hostA.app[0].interface = "eth0"

%contains: stdout
PROTOCOLTEST rfc2131_broadcast_bit_clear: PASS
