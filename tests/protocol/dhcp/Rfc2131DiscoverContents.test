%description:

RFC 2131 -- what a DHCPDISCOVER carries: a broadcast from 0.0.0.0, ciaddr zero, the client's
hardware address in chaddr, and no server identifier.

Checks RFC2131-DISC-2 (description), DISC-3 (must), DISC-5 (must not) and MSG-9 (must), and
covers DISC-1, from doc/project/evidence/standard/rfc2131/catalog.md. The English procedure is
in doc/project/evidence/protocol/dhcp/checks/exchange.md#discover-contents; the program steps
below map onto its expected observations. Mapping of the plain mockup: server S = server,
client C = hostA.

The ini gives hostA a fixed MAC address so that the check can compare chaddr against a known
value and not only against "some address".

Observations 2 to 6 read one message, so the program reads them in one step and names them in
one description. A step per field would need six frames, and the engine offers each event to
one step only.

For the same reason the stimulus of observation 1 is observed where the message leaves the
client's transport module, and the fields of observations 2 to 6 where the frame leaves the
client's interface. The two are two events of one message, and the first one comes first.

%includes:
#include "ProtocolTest.h"
#include "DhcpChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc2131_discover_contents")
        // Expected observation 1: a DHCPDISCOVER leaves the client's transport module.
        .once(on("hostA.udp").signal("packetSentToLower")
                  .match([](const MatchContext& c) { return isDhcp(c.event.packet, DHCPDISCOVER); })
                  .describe("a DHCPDISCOVER from the client")
                  .within(1.0))
        // Expected observations 2 to 6, on that same message: it is a broadcast at both layers,
        // its IP source address is 0.0.0.0, its ciaddr is 0.0.0.0, its chaddr and hlen name the
        // sending interface, and it carries no server identifier option.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .match([](const MatchContext& c) {
                      auto dhcp = dhcpOf(c.event.packet);
                      if (dhcp == nullptr || dhcp->getOptions().getMessageType() != DHCPDISCOVER)
                          return false;
                      return ipv4Destination(c.event.packet) == "255.255.255.255"      // observation 2
                             && isLinkBroadcast(c.event.packet)                        // observation 2
                             && ipv4Source(c.event.packet) == "0.0.0.0"                // observation 3
                             && dhcp->getCiaddr().isUnspecified()                      // observation 4
                             && dhcp->getChaddr() == MacAddress("0A-AA-00-00-00-01")   // observation 5
                             && dhcp->getHlen() == 6                                   // observation 5
                             && !hasOption(dhcp, SERVER_ID);                           // observation 6
                  })
                  .describe("that DHCPDISCOVER: broadcast at both layers, IP source 0.0.0.0, ciaddr 0.0.0.0, chaddr and hlen of the sending interface, and no server identifier option")
                  .within(0.001));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2131_discover_contents compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The plain mockup: one server and one client on one link.
network Rfc2131PlainNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config><interface hosts='server' address='192.168.1.1' netmask='255.255.255.0'/></config>");
            @display("p=100,50");
        }
        server: StandardHost { @display("p=250,100"); }
        hostA: StandardHost { @display("p=450,100"); }
    connections:
        server.ethg++ <--> Eth100M <--> hostA.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Rfc2131PlainNet
sim-time-limit = 2s
seed-set = 0

**.ipv4.arp.typename = "GlobalArp"

# A fixed hardware address, so that the check can name the value it expects in chaddr.
*.hostA.eth[0].address = "0A-AA-00-00-00-01"

*.server.numApps = 1
*.server.app[0].typename = "DhcpServer"
*.server.app[0].interface = "eth0"
*.server.app[0].numReservedAddresses = 100
*.server.app[0].maxNumClients = 100
*.server.app[0].leaseTime = 300s

*.hostA.numApps = 1
*.hostA.app[0].typename = "DhcpClient"
*.hostA.app[0].interface = "eth0"

%contains: stdout
PROTOCOLTEST rfc2131_discover_contents: PASS
