#!/bin/sh
#
# Runs one script of the packetdrill TCP corpus in INET, for a wrapper in this folder:
#
#   %testprog: "$INET_ROOT/tests/protocol/tcp/packetdrill/run" <corpus:script_id>
#
# The scripts, the packetdrill parser and the comparison of packets live in the inet-gpl
# project, which is GPL licensed; this folder holds only the wrappers that name the scripts.
# inet-gpl is found through INETGPL_ROOT, which its setenv sets. Without it the test is
# skipped, never passed.
#
# The command is leg I of the inet-gpl TCP oracle for one script (tests/oracle/oracle.py
# inet-one). It prints the simulation output and ends with one line that the wrapper matches:
#
#   PACKETDRILL <corpus:script_id>: PASS
#   PACKETDRILL <corpus:script_id>: FAIL (<verdict>: <detail>)
#
# The wrapper names this file through INET_ROOT: INET's test runner and opp_repl start a test in
# different folders, so no relative path works for both, and both INET's runner and the oracle
# need INET_ROOT anyway.
#
# A test runner appends its own simulation arguments to the command; they are ignored.

if [ -z "$1" ]; then
    echo "usage: run <corpus:script_id>" >&2
    exit 2
fi
if [ -z "$INETGPL_ROOT" ] || [ ! -f "$INETGPL_ROOT/tests/oracle/oracle.py" ]; then
    echo "#SKIPPED: inet-gpl not found -- source the setenv of an inet-gpl checkout to set INETGPL_ROOT"
    exit 0
fi
exec "${PYTHON:-python3}" "$INETGPL_ROOT/tests/oracle/oracle.py" inet-one "$1"
