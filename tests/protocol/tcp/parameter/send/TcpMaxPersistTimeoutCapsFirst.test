%description:

Tcp.maxPersistTimeout:caps-first -- a value below the RTO limits the first interval of the probes too.

The claim (Tcp.ned): "it limits the first interval too; more than 0".

The classes: caps-growth (a value above the RTO; 60s is the default, 120s the value of
LinuxTcp): the interval of the probes starts at the RTO, doubles, and stops at the value;
caps-first (a value below the RTO): the first interval is the value too; invalid (0 and
less). The code: TcpAlgorithmBase::startPersistTimer() and processPersistTimer(); the
check in TcpAlgorithm::initialize(). This test separates "caps-first" from "caps-growth".

Host under test: host1, with 0.5 s; its RTO is 1 s. Peer: host2, whose application reads
nothing. Observation: level 1, the probes of host1 come 0.5 s apart from the start.

%# parameter: Tcp.maxPersistTimeout
%# class: caps-first
%# value: 0.5s
%# key: *.host1.tcp.maxPersistTimeout
%# expected-result: PASS

%includes:
#include "ProtocolTest.h"
#include "TcpTestApp.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("TcpMaxPersistTimeoutCapsFirst")
        .act(action().at(0.0).run<TcpTestApp>("host2.app[0]", [](TcpTestApp& app) {
            app.socket().setAutoRead(false);
            app.socket().bind(1000);
            app.socket().listen();
        }))
        .once(on("host2.tcp").signal("packetSentToLower")
             .filterPacket("tcp.ackBit == true && tcp.window == 0")
             .capture("una", "tcp.ackNo")
             .describe("the ACK of host2 that closes the window")
             .within(2.0))
        .never(on("host1.tcp").signal("packetSentToLower")
              .filterPacket("tcp.synBit == false")
              .describe("an early first probe, 0.5 s after the window closes")
              .within(0.45))
        .once(on("host1.tcp").signal("packetSentToLower")
             .filterPacket("tcp.synBit == false")
             .describe("first probe, 0.5 s after the window closes")
             .within(0.1))
        .never(on("host1.tcp").signal("packetSentToLower")
              .filterPacket("tcp.synBit == false")
              .describe("an early second probe, 0.5 s later")
              .within(0.45))
        .once(on("host1.tcp").signal("packetSentToLower")
             .filterPacket("tcp.synBit == false")
             .describe("second probe, 0.5 s later")
             .within(0.1))
        .never(on("host1.tcp").signal("packetSentToLower")
              .filterPacket("tcp.synBit == false")
              .describe("an early third probe, 0.5 s later")
              .within(0.45))
        .once(on("host1.tcp").signal("packetSentToLower")
             .filterPacket("tcp.synBit == false")
             .describe("third probe, 0.5 s later")
             .within(0.1));
}

%activity:
EV << "TcpMaxPersistTimeoutCapsFirst compiled\n";

%inifile: omnetpp.ini

[General]
*.host1.tcp.maxPersistTimeout = 0.5s    # the parameter under test
*.host1.app[0].sendBytes = 100000B
*.host2.app[0].typename = "TcpTestApp"
include ../../parameter/ini/_bulk.ini
include ../../parameter/ini/_base.ini

%contains: stdout
PROTOCOLTEST TcpMaxPersistTimeoutCapsFirst: PASS
