%description:

Tcp.maxRexmitTimeout:free -- below the maximum, the backoff doubles.

The claim (Tcp.ned): "the upper limit of the retransmission timeout".

The classes: caps (a value that the backoff reaches) and free (a value that it does not
reach; 240s is the default, 120s the value of LinuxTcp). The code: the backoff of the data
(TcpAlgorithmBase::processRexmitTimer()) and of a SYN (TcpConnection::process_TIMEOUT_SYN_REXMIT()). This test separates "free" from "caps".

Host under test: host1, with 240 s; the tap drops each SYN. Observation: level 1, the SYNs of
host1 come 1, 2 and 4 s apart.

%# parameter: Tcp.maxRexmitTimeout
%# class: free
%# value: 240s
%# key: *.host1.tcp.maxRexmitTimeout
%# expected-result: PASS

%includes:
#include "ProtocolTest.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("TcpMaxRexmitTimeoutFree")
        .intercept(tap("tap").from("host1").filterPacket("tcp.synBit == true").drop()
                     .describe("every SYN of host1"))
        .once(on("host1.tcp").signal("packetSentToLower")
             .filterPacket("tcp.synBit == true && tcp.ackBit == false")
             .describe("the first SYN of host1")
             .within(0.5))
        .never(on("host1.tcp").signal("packetSentToLower")
              .filterPacket("tcp.synBit == true && tcp.ackBit == false")
              .describe("an early second SYN, 1 s later")
              .within(0.9))
        .once(on("host1.tcp").signal("packetSentToLower")
             .filterPacket("tcp.synBit == true && tcp.ackBit == false")
             .describe("second SYN, 1 s later")
             .within(0.2))
        .never(on("host1.tcp").signal("packetSentToLower")
              .filterPacket("tcp.synBit == true && tcp.ackBit == false")
              .describe("an early third SYN, 2 s later")
              .within(1.9))
        .once(on("host1.tcp").signal("packetSentToLower")
             .filterPacket("tcp.synBit == true && tcp.ackBit == false")
             .describe("third SYN, 2 s later")
             .within(0.2))
        .never(on("host1.tcp").signal("packetSentToLower")
              .filterPacket("tcp.synBit == true && tcp.ackBit == false")
              .describe("an early fourth SYN, 4 s later")
              .within(3.9))
        .once(on("host1.tcp").signal("packetSentToLower")
             .filterPacket("tcp.synBit == true && tcp.ackBit == false")
             .describe("fourth SYN, 4 s later")
             .within(0.2));
}

%activity:
EV << "TcpMaxRexmitTimeoutFree compiled\n";

%inifile: omnetpp.ini

[General]
*.host1.tcp.maxRexmitTimeout = 240s    # the parameter under test
include ../../parameter/ini/_bulk.ini
include ../../parameter/ini/_base.ini

%contains: stdout
PROTOCOLTEST TcpMaxRexmitTimeoutFree: PASS
