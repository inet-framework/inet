%description:

RFC 6582 -- after a retransmission timeout, TcpReno starts no fast retransmit in the go-back, before the
cumulative acknowledgment covers more than the highest octet that it had sent at the timeout.

RFC 6582 section 6 names the problem: after a timeout, the sender goes back and sends again segments
that the receiver can already have, and their duplicate acknowledgments must not start a fast
retransmit. Its guard is the variable recover: at a timeout, recover is the highest sequence number
sent, and the third duplicate acknowledgment starts a fast retransmit only when the cumulative
acknowledgment covers more than recover. TcpNewReno has it. TcpReno had no guard: a fast retransmit in
the go-back took ssthresh from the FlightSize of before the timeout, so cwnd jumped and the go-back sent
a burst of segments at once (BD-14 of the defect list).

The relay removes every data segment of host A for 50 ms, from its 301st segment on, so host A gets no
acknowledgment for them and its retransmission timer expires. In the go-back, the relay removes the
12th data segment of host A, so the later segments of the go-back bring duplicate acknowledgments. An
observer marks a fast retransmit: a segment that host A sends again while it holds three duplicates of
one acknowledgment. The guard forbids it while the cumulative acknowledgment does not cover more than
the highest octet that host A had sent at the timeout. The run must end with the acknowledgment of all
data.

The scenario runs TcpReno without SACK, as examples/inet/tcpwindowscale does.

%includes:
#include <algorithm>
#include "ProtocolTest.h"
#include "PacketField.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

// What host A has sent and what host B has acknowledged, kept by observers that run beside the
// ordered steps. The engine offers every event to the running guards first and to the ordered
// step after them, so a step reads values that already include its own event.
static long highestSent = -1;   // one past the highest octet host A has sent
static long cumulativeAck = -1; // the highest acknowledgment host A has received
static int duplicates = 0;      // consecutive duplicates of cumulativeAck
static long recoverPoint = -1;  // highestSent at the last timeout: RFC 6582 recover + 1
static int timeouts = 0;        // the retransmission timeouts of host A

static long fieldOf(const Packet *packet, const char *path)
{
    try {
        return (long)evalPacketField(packet, path).intValue();
    }
    catch (const std::exception&) {
        return -1;
    }
}

// At host A's TCP a segment starts with its TCP header, so the data is what follows it.
static long dataLengthOf(const Packet *packet)
{
    return (long)(packet->getByteLength() - evalPacketField(packet, "tcp.headerLength").doubleValueInUnit("B"));
}

// Observer: every acknowledgment host A receives. RFC 5681 section 2 counts an acknowledgment
// as a duplicate when it carries no data and repeats the highest acknowledgment number. Never a
// match.
static bool recordAck(const MatchContext& context)
{
    const Packet *packet = context.event.packet;
    if (packet == nullptr || fieldOf(packet, "tcp.srcPort") != 1000)
        return false;
    long ack = fieldOf(packet, "tcp.ackNo");
    if (ack < 0)
        return false;
    if (ack > cumulativeAck) {
        cumulativeAck = ack;
        duplicates = 0;
    }
    else if (ack == cumulativeAck && dataLengthOf(packet) == 0)
        duplicates++;
    return false;
}

// Observer: the counter of retransmission timeouts of host A. At each timeout, RFC 6582 sets
// recover to the highest sequence number sent. Never a match.
static bool recordTimeout(const MatchContext&)
{
    timeouts++;
    recoverPoint = highestSent;
    return false;
}

// True for a segment that host A sends again while it holds three duplicates, a fast
// retransmit, after a timeout and before the cumulative acknowledgment covers more than the
// highest octet that host A had sent at the timeout. It keeps highestSent for each segment.
static bool fastRetransmitBeforeRecover(const MatchContext& context)
{
    const Packet *packet = context.event.packet;
    if (packet == nullptr || fieldOf(packet, "tcp.destPort") != 1000)
        return false;
    long length = dataLengthOf(packet);
    if (length <= 0)
        return false;
    long sequenceNumber = fieldOf(packet, "tcp.sequenceNo");
    bool retransmission = sequenceNumber + length <= highestSent;
    highestSent = std::max(highestSent, sequenceNumber + length);
    if (!retransmission || duplicates != 3 || recoverPoint < 0 || cumulativeAck > recoverPoint)
        return false;
    EV_INFO << "fast retransmit of " << sequenceNumber << " after a timeout, with the cumulative acknowledgment "
            << cumulativeAck << ", recover + 1 = " << recoverPoint << "\n";
    return true;
}

static bool atLeastOneTimeout(const MatchContext&)
{
    return timeouts >= 1;
}

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc6582_reno_no_fast_retransmit_after_timeout")
        .meanwhile(never(on("host1.tcp").signal("packetReceivedFromLower")
                             .filterEvent(recordAck)
                             .describe("every acknowledgment host A receives")
                             .within(30.0)))
        .meanwhile(never(on("host1.tcp").signal("numRtos")
                             .filterEvent(recordTimeout)
                             .describe("every retransmission timeout of host A")
                             .within(30.0)))
        .meanwhile(never(on("host1.tcp").signal("packetSentToLower")
                             .filterEvent(fastRetransmitBeforeRecover)
                             .describe("a fast retransmit after a timeout before the cumulative acknowledgment covers more than recover")
                             .within(30.0)))
        .once(on("host1.tcp").signal("packetSentToLower")
                  .filterPacket("tcp.synBit == true && tcp.ackBit == false")
                  .capture("isn", "tcp.sequenceNo")
                  .describe("the SYN of host A")
                  .within(0.5))
        .once(on("host1.tcp").signal("packetSentToLower")
                  .filterPacket("tcp.destPort == 1000 && tcp.sequenceNo >= {isn} + 1 + 300 * 1448")
                  .first()
                  .describe("host A sends its 301st data segment")
                  .within(5.0))
        // Remove every data segment of host A for 50 ms, so that its retransmission timer expires.
        .meanwhile(tap("relay").from("host1").filterPacket("tcp.destPort == 1000 && ipv4.totalLengthField > 100B")
                       .drop().within(0.05).describe("every data segment of host A for 50 ms"))
        .once(on("host1.tcp").signal("numRtos")
                  .first()
                  .describe("the retransmission timeout of host A")
                  .within(5.0))
        // In the go-back, remove one segment, so that the later ones bring duplicate acknowledgments.
        .meanwhile(tap("relay").from("host1").filterPacket("tcp.destPort == 1000 && ipv4.totalLengthField > 100B")
                       .nth(12).drop().describe("the 12th data segment of host A after the timeout"))
        .once(on("host1.tcp").signal("packetReceivedFromLower")
                  .filterPacket("tcp.ackNo >= {isn} + 1 + 1000000")
                  .first()
                  .assertEvent(atLeastOneTimeout)
                  .describe("the acknowledgment of the last byte, after at least one timeout")
                  .within(30.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc6582_reno_no_fast_retransmit_after_timeout compiled\n";

%file: test.ned

import inet.node.inet.StandardHost;
import inet.node.ethernet.Eth100M;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.protocoltest.PacketTap;

// Two hosts with a relay on the link -- note: NO tester (attached at runtime).
network RenoAfterTimeoutNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        host1: StandardHost { @display("p=300,100"); }
        relay: PacketTap { @display("p=400,100"); }
        host2: StandardHost { @display("p=500,100"); }
    connections:
        host1.ethg++ <--> Eth100M <--> relay.a;
        relay.b     <--> Eth100M <--> host2.ethg++;
}

%inifile: omnetpp.ini

[General]
network = RenoAfterTimeoutNet
sim-time-limit = 40s
seed-set = 0

**.ipv4.arp.typename = "GlobalArp"
# TcpReno without SACK, as examples/inet/tcpwindowscale; host B offers a large window
**.tcp.tcpAlgorithmClass = "TcpReno"
**.tcp.sackSupport = false
*.host2.tcp.advertisedWindow = 1000000

*.host1.numApps = 1
*.host1.app[0].typename = "TcpSessionApp"
*.host1.app[0].connectAddress = "host2"
*.host1.app[0].connectPort = 1000
*.host1.app[0].tOpen = 0.1s
*.host1.app[0].tSend = 0.2s
*.host1.app[0].sendBytes = 1000000B
*.host1.app[0].tClose = -1s
*.host2.numApps = 1
*.host2.app[0].typename = "TcpSinkApp"
*.host2.app[0].localPort = 1000

%contains: stdout
PROTOCOLTEST rfc6582_reno_no_fast_retransmit_after_timeout: PASS
