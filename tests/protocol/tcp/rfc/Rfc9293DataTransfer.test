%description:

RFC 9293 — the sender cuts the byte stream into segments no larger than the effective send
MSS, and the receiver's cumulative acknowledgment names the next octet it expects.

Checks RFC9293-DATA-1 and RFC9293-SEG-1 (must) and RFC9293-ACK-1 (description), and covers
RFC9293-ACK-2 (description) from doc/project/evidence/standard/rfc9293/catalog.md. The
English procedure and the mockup are in
doc/project/evidence/protocol/tcp/checks/data-transfer.md#data-transfer; the program steps below map one
to one onto its expected observations. Mapping of the mockup: host A = host1, host B =
host2, link L = host1-host2.

Replaces Rfc9293CumulativeAck.test: that file's own anchor (#cumulative-acknowledgment) no
longer exists in checks.md, which now organizes this material under "Data transfer" with a
fourth, SYN-anchored observation.

The data block is 5000 octets, so the stream occupies sequence numbers ISS_A + 1 to
ISS_A + 5000, and the acknowledgment of the whole stream is ISS_A + 5001. The effective send
MSS is read from the run, as RFC 9293 section 3.7.1 defines it: the MSS option of host B's
SYN+ACK less the options that host A's data segment carries. With the default options
that is 1460 - 12 = 1448 octets.

Deviation on observations 3 and 4: the data length (RFC9293-SEG-1's octet count) is
computed as ipv4.totalLengthField - ipv4.headerLength - tcp.headerLength, by the helper
tcpSegmentDataLength() of TcpMutations.h. The IPv4 fields are not there at host1.tcp's own
outbound signal, because the IPv4 header is added downstream, so these two observations
move to host1.eth[0].mac. Observations 1, 2 and 5 need no IPv4 field and stay at host1.tcp.

%includes:
#include "ProtocolTest.h"
#include "PacketField.h"
#include "TcpMutations.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

// RFC9293-SEG-1: a full segment carries the effective send MSS and not more, that is, host B's
// MSS option less the options of this segment (RFC 9293 section 3.7.1).
static bool oneEffectiveSendMss(const MatchContext& context)
{
    double effectiveSendMss = context.get("sendMss").intValue() - tcpOptionsLength(context.event.packet);
    return tcpSegmentDataLength(context.event.packet) == effectiveSendMss;
}

static bool carriesData(const MatchContext& context)
{
    return tcpSegmentDataLength(context.event.packet) > 0;
}

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc9293_data_transfer")
        // Observation 1: host A sends its SYN. Record ISS_A. Confirms the connection
        // stimulus.
        .once(on("host1.tcp").signal("packetSentToLower")
                  .filterPacket("tcp.synBit == true && tcp.ackBit == false")
                  .capture("issA", "tcp.sequenceNo")
                  .describe("host A's SYN, carrying ISS_A").within(0.5))
        // Observation 2: host A receives host B's SYN+ACK. Record the value of its MSS
        // option as SendMSS, the send MSS of host A (RFC 9293 section 3.7.1).
        .once(on("host1.tcp").signal("packetReceivedFromLower")
                  .filterPacket("tcp.synBit == true && tcp.ackBit == true")
                  .capture("sendMss", [](const PacketEvent& e) { return cValue((intval_t)tcpMssOptionOf(e.packet)); })
                  .describe("host B's SYN+ACK, whose MSS option is host A's send MSS").within(0.5))
        // Observation 3: after the send time, host A sends a segment with sequence number
        // ISS_A + 1 that carries exactly one effective send MSS of data and has ACK set
        // (RFC9293-SEG-1: a full segment is the effective send MSS and not more;
        // RFC9293-ACK-2). The handshake's own final ACK has the same sequence number but no
        // data, so the data condition picks the data segment, and the assertion then judges
        // its length.
        .once(on("host1.eth[0].mac").signal("packetSentToLower")
                  .filterPacket("tcp.sequenceNo == {issA} + 1 && tcp.ackBit == true")
                  .filterEvent(carriesData)
                  .assertEvent(oneEffectiveSendMss)
                  .capture("firstLength", [](const PacketEvent& e) { return cValue((intval_t)tcpSegmentDataLength(e.packet)); })
                  .describe("host A's first data segment at ISS_A + 1, one effective send MSS long, with ACK set")
                  .within(1.0))
        // Observation 4: host A sends a segment that carries data and starts where the first
        // one ended: the stream continues with no gap. The data condition is necessary: a
        // pure acknowledgment that host A sends at that point carries the same sequence
        // number and no data.
        .once(on("host1.eth[0].mac").signal("packetSentToLower")
                  .filterPacket("tcp.sequenceNo == {issA} + 1 + {firstLength}")
                  .filterEvent(carriesData)
                  .describe("host A's next data segment, continuing where the first one ended")
                  .within(1.0))
        // Observation 5: host A receives an acknowledgment of the whole stream, ISS_A +
        // 5001 (RFC9293-ACK-1, RFC9293-DATA-1: the receiver accepted the whole stream in
        // order). Decisive: a cumulative acknowledgment of the last octet cannot occur
        // unless every earlier octet was received in order.
        .once(on("host1.tcp").signal("packetReceivedFromLower")
                  .filterPacket("tcp.ackBit == true && tcp.ackNo == {issA} + 5001")
                  .describe("the cumulative acknowledgment of the whole 5000-octet stream, ISS_A + 5001")
                  .within(1.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc9293_data_transfer compiled\n";

%file: test.ned

import inet.node.inet.StandardHost;
import inet.node.ethernet.Eth100M;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The mockup of doc/project/evidence/protocol/tcp/checks.md#common-mockups:
// host A -- link L -- host B.
network Rfc9293TcpNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        host1: StandardHost { @display("p=300,100"); }
        host2: StandardHost { @display("p=500,100"); }
    connections:
        host1.ethg++ <--> Eth100M <--> host2.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Rfc9293TcpNet
sim-time-limit = 2s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise (also needed since observation 2
# reads ipv4 fields at the MAC layer).
**.ipv4.arp.typename = "GlobalArp"

# Every node computes real TCP checksums (checks.md's common mockup constant: the checksum
# is never optional, MUST-2).
**.checksumMode = "computed"

# The scenario constants of checks.md#common-mockups.
*.host1.numApps = 1
*.host1.app[0].typename = "TcpSessionApp"
*.host1.app[0].connectAddress = "host2"
*.host1.app[0].connectPort = 1000
*.host1.app[0].tOpen = 0.1s
*.host1.app[0].tSend = 0.2s
*.host1.app[0].sendBytes = 5000B
*.host1.app[0].tClose = 0.4s
*.host2.numApps = 1
*.host2.app[0].typename = "TcpEchoApp"
*.host2.app[0].localPort = 1000

%contains: stdout
PROTOCOLTEST rfc9293_data_transfer: PASS
