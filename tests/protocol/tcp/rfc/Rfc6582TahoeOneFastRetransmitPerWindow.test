%description:

RFC 6582 -- after a fast retransmit and its go-back, TcpTahoe starts no second fast retransmit
in the same window.

RFC 6582 section 6 names the problem: without SACK, a sender can not tell the duplicate
acknowledgment of a lost segment from the duplicate acknowledgment of a segment that it sent
again and the receiver already had. So the losses of one window can start several fast
retransmits, and Tahoe, which goes back after a fast retransmit, is the worst case. Its guard is
the variable recover: at a fast retransmit, recover is the highest sequence number sent, and the
third duplicate acknowledgment starts a fast retransmit only when the cumulative acknowledgment
covers more than recover. TcpNewReno has it; TcpTahoe and TcpWestwood test dupacks ==
dupthresh and nothing else (BD-39 of the defect list).

The relay removes three data segments of one window, the 40th, the 42nd and the 44th, once
each. The third duplicate acknowledgment starts the first fast retransmit; then TcpTahoe goes
back to slow start from the first unacknowledged segment and sends again segments that host B
already has. An observer marks a fast retransmit: a segment that host A sends again while it
holds three duplicates of one acknowledgment. Host A sends nothing else then, because Tahoe
sends after a duplicate only by limited transmit, which is new data. The guard forbids a second
fast retransmit while the cumulative acknowledgment does not cover more than the highest octet
that host A had sent at the first. The run must end with the acknowledgment of all data.

The scenario runs TcpTahoe without SACK.

%includes:
#include <algorithm>
#include "ProtocolTest.h"
#include "PacketField.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

// What host A has sent and what host B has acknowledged, kept by observers that run beside the
// ordered steps. The engine offers every event to the running guards first and to the ordered
// step after them, so a step reads values that already include its own event.
static long highestSent = -1;   // one past the highest octet host A has sent
static long cumulativeAck = -1; // the highest acknowledgment host A has received
static int duplicates = 0;      // consecutive duplicates of cumulativeAck
static long recoverPoint = -1;  // highestSent at the last fast retransmit: RFC 6582 recover + 1
static int fastRetransmits = 0; // the fast retransmits that host A started

static long fieldOf(const Packet *packet, const char *path)
{
    try {
        return (long)evalPacketField(packet, path).intValue();
    }
    catch (const std::exception&) {
        return -1;
    }
}

// At host A's TCP a segment starts with its TCP header, so the data is what follows it.
static long dataLengthOf(const Packet *packet)
{
    return (long)(packet->getByteLength() - evalPacketField(packet, "tcp.headerLength").doubleValueInUnit("B"));
}

// Observer: every acknowledgment host A receives. RFC 5681 section 2 counts an acknowledgment
// as a duplicate when it carries no data and repeats the highest acknowledgment number. Never a
// match.
static bool recordAck(const MatchContext& context)
{
    const Packet *packet = context.event.packet;
    if (packet == nullptr || fieldOf(packet, "tcp.srcPort") != 1000)
        return false;
    long ack = fieldOf(packet, "tcp.ackNo");
    if (ack < 0)
        return false;
    if (ack > cumulativeAck) {
        cumulativeAck = ack;
        duplicates = 0;
    }
    else if (ack == cumulativeAck && dataLengthOf(packet) == 0)
        duplicates++;
    return false;
}

// True for a segment that host A sends again while it holds three duplicates: a fast
// retransmit. It is a violation when the cumulative acknowledgment does not cover more than the
// highest octet of the last fast retransmit. It keeps the counts and the point of each fast
// retransmit that is no violation.
static bool secondFastRetransmitInWindow(const MatchContext& context)
{
    const Packet *packet = context.event.packet;
    if (packet == nullptr || fieldOf(packet, "tcp.destPort") != 1000)
        return false;
    long length = dataLengthOf(packet);
    if (length <= 0)
        return false;
    long sequenceNumber = fieldOf(packet, "tcp.sequenceNo");
    bool retransmission = sequenceNumber + length <= highestSent;
    highestSent = std::max(highestSent, sequenceNumber + length);
    if (!retransmission || duplicates != 3)
        return false;
    if (recoverPoint >= 0 && cumulativeAck <= recoverPoint) {
        EV_INFO << "second fast retransmit of " << sequenceNumber << " with the cumulative acknowledgment "
                << cumulativeAck << ", recover + 1 = " << recoverPoint << "\n";
        return true;
    }
    fastRetransmits++;
    recoverPoint = highestSent;
    return false;
}

static bool atLeastOneFastRetransmit(const MatchContext&)
{
    return fastRetransmits >= 1;
}

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc6582_tahoe_one_fast_retransmit_per_window")
        // Remove three segments of one window, once each.
        .intercept(tap("relay")
                       .filterPacket("tcp.destPort == 1000 && tcp.sequenceNo == {isn} + 1 + 39 * 1448 && ipv4.totalLengthField > 100B")
                       .nth(1).drop().describe("the 40th data segment of host A, the first time"))
        .intercept(tap("relay")
                       .filterPacket("tcp.destPort == 1000 && tcp.sequenceNo == {isn} + 1 + 41 * 1448 && ipv4.totalLengthField > 100B")
                       .nth(1).drop().describe("the 42nd data segment of host A, the first time"))
        .intercept(tap("relay")
                       .filterPacket("tcp.destPort == 1000 && tcp.sequenceNo == {isn} + 1 + 43 * 1448 && ipv4.totalLengthField > 100B")
                       .nth(1).drop().describe("the 44th data segment of host A, the first time"))
        .meanwhile(never(on("host1.tcp").signal("packetReceivedFromLower")
                             .filterEvent(recordAck)
                             .describe("every acknowledgment host A receives")
                             .within(20.0)))
        .meanwhile(never(on("host1.tcp").signal("packetSentToLower")
                             .filterEvent(secondFastRetransmitInWindow)
                             .describe("a second fast retransmit before the cumulative acknowledgment covers more than recover")
                             .within(20.0)))
        .once(on("host1.tcp").signal("packetSentToLower")
                  .filterPacket("tcp.synBit == true && tcp.ackBit == false")
                  .capture("isn", "tcp.sequenceNo")
                  .describe("the SYN of host A")
                  .within(0.5))
        .once(on("host1.tcp").signal("packetReceivedFromLower")
                  .filterPacket("tcp.ackNo >= {isn} + 1 + 300000")
                  .first()
                  .assertEvent(atLeastOneFastRetransmit)
                  .describe("the acknowledgment of the last byte, after at least one fast retransmit")
                  .within(20.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc6582_tahoe_one_fast_retransmit_per_window compiled\n";

%file: test.ned

import inet.node.inet.StandardHost;
import inet.node.ethernet.Eth100M;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.protocoltest.PacketTap;

// Two hosts with a relay on the link -- note: NO tester (attached at runtime).
network OneFastRetransmitNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        host1: StandardHost { @display("p=300,100"); }
        relay: PacketTap { @display("p=400,100"); }
        host2: StandardHost { @display("p=500,100"); }
    connections:
        host1.ethg++ <--> Eth100M <--> relay.a;
        relay.b     <--> Eth100M <--> host2.ethg++;
}

%inifile: omnetpp.ini

[General]
network = OneFastRetransmitNet
sim-time-limit = 30s
seed-set = 0

**.ipv4.arp.typename = "GlobalArp"
# TcpTahoe without SACK, the algorithm of BD-39.
**.tcp.tcpAlgorithmClass = "TcpTahoe"
**.tcp.sackSupport = false

*.host1.numApps = 1
*.host1.app[0].typename = "TcpSessionApp"
*.host1.app[0].connectAddress = "host2"
*.host1.app[0].connectPort = 1000
*.host1.app[0].tOpen = 0.1s
*.host1.app[0].tSend = 0.2s
*.host1.app[0].sendBytes = 300000B
*.host1.app[0].tClose = -1s
*.host2.numApps = 1
*.host2.app[0].typename = "TcpSinkApp"
*.host2.app[0].localPort = 1000

%contains: stdout
PROTOCOLTEST rfc6582_tahoe_one_fast_retransmit_per_window: PASS
