%description:

RFC 9293 — a duplicate of a segment that the receiver has already taken in is not delivered again; it draws an empty acknowledgment, and never a reset.

Checks RFC9293-SEGA-1 and RFC9293-SEGA-2 (description, as rules of the state machine) and RFC9293-RST-2 (must not) from doc/project/evidence/standard/rfc9293/catalog.md. The English procedure is in doc/project/evidence/protocol/tcp/checks/segment-acceptance.md#duplicate-segment; the program steps below map onto its expected observations. Mapping of the mockup with a relay: host A = host1, relay T = tap, host B = host2.

Host A sends 1000 octets, one segment, so the next sequence number that host B expects after it is known: ISS_A + 1001. The relay delivers that segment two times: the segment itself, and a copy 2 ms after it, so the copy lies wholly before the next sequence number expected. Host B has nothing else to acknowledge at that time, so a window of 1 ms after the copy separates the reply to the copy from any later acknowledgment.

Expected result: PASS.

%includes:
#include "ProtocolTest.h"
#include "TcpMutations.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    auto hasData = [](const MatchContext& c) { return tcpSegmentDataLength(c.event.packet) > 0; };
    return ProtocolTest("rfc9293_duplicate_segment")
        // The relay delivers the first data segment, and one copy of it 2 ms later.
        .intercept(tap("tap").from("host1").filterPacket("tcp.destPort == 1000 && ipv4.totalLengthField > 100B").nth(1)
                     .duplicate(0.002)
                     .describe("the first data segment, and one copy of it 2 ms later"))
        // Host A sends its SYN. Record ISS_A.
        .once(on("host1.tcp").signal("packetSentToLower")
                  .filterPacket("tcp.synBit == true && tcp.ackBit == false")
                  .capture("issA", "tcp.sequenceNo")
                  .describe("host A's SYN, carrying ISS_A").within(0.5))
        // Observation 1: the first data segment reaches host B, and its copy 2 ms later.
        .once(on("host2.eth[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("tcp.destPort == 1000 && tcp.sequenceNo == {issA} + 1")
                  .filterEvent(hasData)
                  .describe("the first data segment at host B's interface")
                  .within(0.5))
        .once(on("host2.eth[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("tcp.destPort == 1000 && tcp.sequenceNo == {issA} + 1")
                  .filterEvent(hasData)
                  .notBefore(0.002)
                  .describe("its copy at host B's interface, 2 ms later")
                  .within(0.0021))
        // Observation 3: host B passes no data of the copy to its user.
        .meanwhile(never(on("host2.tcp").signal("packetSentToUpper")
                             .describe("data from host B's TCP to its user")
                             .within(0.001)))
        // Observation 4: host B never answers with a reset (RFC9293-RST-2).
        .meanwhile(never(on("host2.tcp").signal("packetSentToLower")
                             .filterPacket("tcp.rstBit == true")
                             .describe("a reset from host B")
                             .within(0.5)))
        // Observation 2: host B answers the copy with an empty acknowledgment that names the
        // next sequence number expected, the octet after the transfer (RFC9293-SEGA-2).
        // The observation point is host B's interface: the emptiness of the segment is read
        // from the IPv4 total length.
        .once(on("host2.eth[0].mac").signal("packetSentToLower")
                  .filterPacket("tcp.ackBit == true && tcp.rstBit == false && tcp.ackNo == {issA} + 1001")
                  .filterEvent([](const MatchContext& c) { return tcpSegmentDataLength(c.event.packet) == 0; })
                  .describe("host B's empty acknowledgment, which names ISS_A + 1001")
                  .within(0.001))
        // Observation 5: the connection stays in the same state. Host B acknowledges the FIN
        // that host A sends when it closes.
        .once(on("host1.tcp").signal("packetReceivedFromLower")
                  .filterPacket("tcp.ackBit == true && tcp.ackNo == {issA} + 1002")
                  .describe("host B's acknowledgment of host A's FIN")
                  .within(1.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc9293_duplicate_segment compiled\n";

%file: test.ned

import inet.node.inet.StandardHost;
import inet.node.ethernet.Eth100M;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.protocoltest.PacketTap;

// The mockup with a relay of doc/project/evidence/protocol/tcp/checks.md#common-mockups:
// host A -- relay T -- host B.
network Rfc9293TapNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        host1: StandardHost { @display("p=250,100"); }
        tap: PacketTap { @display("p=400,100"); }
        host2: StandardHost { @display("p=550,100"); }
    connections:
        host1.ethg++ <--> Eth100M <--> tap.a;
        tap.b <--> Eth100M <--> host2.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Rfc9293TapNet
sim-time-limit = 10s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
**.ipv4.arp.typename = "GlobalArp"

# Every node computes real TCP checksums (checks.md's common mockup constant: the checksum
# is never optional, MUST-2). The relay computes them again after every change it makes.
**.checksumMode = "computed"

# The scenario constants of checks.md#common-mockups, with a transfer of 1000 octets in one
# segment (checks/segment-acceptance.md#duplicate-segment). Host B only receives: echoFactor = 0
# keeps the reverse direction free of data, so that the segments from host B are pure
# acknowledgments and an observation about them cannot be confused with an echo.
*.host1.numApps = 1
*.host1.app[0].typename = "TcpSessionApp"
*.host1.app[0].connectAddress = "host2"
*.host1.app[0].connectPort = 1000
*.host1.app[0].tOpen = 0.1s
*.host1.app[0].tSend = 0.2s
*.host1.app[0].sendBytes = 1000B
*.host1.app[0].tClose = 0.4s
*.host2.numApps = 1
*.host2.app[0].typename = "TcpEchoApp"
*.host2.app[0].localPort = 1000
*.host2.app[0].echoFactor = 0

%contains: stdout
PROTOCOLTEST rfc9293_duplicate_segment: PASS
