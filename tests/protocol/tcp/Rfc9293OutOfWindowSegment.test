%description:

RFC 9293 — a segment outside the receive window is not delivered; it draws an empty
acknowledgment, and never a reset.

Checks RFC9293-SEGA-1 and RFC9293-SEGA-2 (description, as rules of the state machine) and
RFC9293-RST-2 (must not) from doc/project/evidence/standard/rfc9293/catalog.md. The English
procedure is in
doc/project/evidence/protocol/tcp/checks/segment-acceptance.md#out-of-window-segment; the
program steps below map onto its expected observations. Mapping of the mockup with a relay:
host A = host1, relay T = tap, host B = host2.

The relay adds 100000 to the sequence number of the first data segment and computes the
checksum again, so that the sequence number is the only thing host B can object to. The
offset is far larger than any window either host advertises, so the segment falls outside
the window whichever edge it is measured against.

Expected result: PASS.

%includes:
#include "ProtocolTest.h"
#include "TcpMutations.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc9293_out_of_window_segment")
        // The relay moves the first data segment far above the window.
        .intercept(intercept("tap").match("tcp.destPort == 1000 && ipv4.totalLengthField > 100B").nth(1)
                     .mutate([](Packet *frame) {
                         rewriteTcpHeader(frame, [](TcpHeader& h) { h.setSequenceNo(h.getSequenceNo() + 100000); });
                     })
                     .describe("the first data segment (add 100000 to its sequence number)"))
        // Observation 1: host A sends its SYN. Record ISS_A.
        .once(on("host1.tcp").signal("packetSentToLower")
                  .packet("tcp.synBit == true && tcp.ackBit == false")
                  .capture("issA", "tcp.sequenceNo")
                  .describe("host A's SYN, carrying ISS_A").within(0.5))
        // Observation 2: the crafted segment reaches host B, carrying the moved sequence
        // number. This confirms the stimulus.
        .once(on("host2.tcp").signal("packetReceivedFromLower")
                  .packet("tcp.sequenceNo == {issA} + 100001")
                  .describe("the out-of-window segment at host B's TCP")
                  .within(1.0))
        // Observation 3: host B answers with an empty acknowledgment that repeats where the
        // stream stands, ISS_A + 1, and carries no data (RFC9293-SEGA-2).
        // The observation point is host B's interface and not its TCP module: the emptiness
        // of the segment is read from the IPv4 total length, and TCP hands a segment down
        // before the network layer adds that header.
        .once(on("host2.eth[0].mac").signal("packetSentToLower")
                  .packet("tcp.ackBit == true && tcp.ackNo == {issA} + 1 && tcp.rstBit == false")
                  .match([](const MatchContext& c) { return tcpSegmentDataLength(c.event.packet) == 0; })
                  .describe("host B's empty acknowledgment, still expecting ISS_A + 1")
                  .within(0.5))
        // Observation 4: host B never answers with a reset (RFC9293-RST-2).
        .never(on("host2.tcp").signal("packetSentToLower")
                  .packet("tcp.rstBit == true")
                  .describe("a reset from host B")
                  .within(0.5))
        // Observation 5: the connection stays in the same state and finishes. Host A receives
        // an acknowledgment of the whole stream after it retransmits the segment that host B
        // could not use.
        .once(on("host1.tcp").signal("packetReceivedFromLower")
                  .packet("tcp.ackBit == true && tcp.ackNo >= {issA} + 5001")
                  .describe("the cumulative acknowledgment of the whole 5000-octet stream")
                  .within(8.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc9293_out_of_window_segment compiled\n";

%file: test.ned

import inet.node.inet.StandardHost;
import inet.node.ethernet.Eth100M;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.protocoltest.PacketTap;

// The mockup with a relay of doc/project/evidence/protocol/tcp/checks.md#common-mockups:
// host A -- relay T -- host B.
network Rfc9293TapNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        host1: StandardHost { @display("p=250,100"); }
        tap: PacketTap { @display("p=400,100"); }
        host2: StandardHost { @display("p=550,100"); }
    connections:
        host1.ethg++ <--> Eth100M <--> tap.a;
        tap.b <--> Eth100M <--> host2.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Rfc9293TapNet
sim-time-limit = 10s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
**.ipv4.arp.typename = "GlobalArp"

# Every node computes real TCP checksums (checks.md's common mockup constant: the checksum
# is never optional, MUST-2). The relay computes them again after every change it makes.
**.checksumMode = "computed"

# The scenario constants of checks.md#common-mockups. Host B only receives: echoFactor = 0
# keeps the reverse direction free of data, so that the segments from host B are pure
# acknowledgments and an observation about them cannot be confused with an echo.
*.host1.numApps = 1
*.host1.app[0].typename = "TcpSessionApp"
*.host1.app[0].connectAddress = "host2"
*.host1.app[0].connectPort = 1000
*.host1.app[0].tOpen = 0.1s
*.host1.app[0].tSend = 0.2s
*.host1.app[0].sendBytes = 5000B
*.host1.app[0].tClose = 0.4s
*.host2.numApps = 1
*.host2.app[0].typename = "TcpEchoApp"
*.host2.app[0].localPort = 1000
*.host2.app[0].echoFactor = 0

%contains: stdout
PROTOCOLTEST rfc9293_out_of_window_segment: PASS
