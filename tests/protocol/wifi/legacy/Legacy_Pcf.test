%# expected-result: FAIL
%description:
Observe a data subtype carrying CF-Poll from the AP. PS-Poll is a different
control subtype and is not evidence for PCF. Ieee80211Mac explicitly excludes PCF.

%file: Legacy_Pcf.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_legacy_pcf)
{
    return ProtocolTest("wifi_legacy_pcf")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("(ieee80211mac.type & 48) == 32 && (ieee80211mac.type & 2) != 0")
                  .describe("a data subtype with CF-Poll from AP (PCF)").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_legacy_pcf"
include ../../ini/_legacy.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_legacy_pcf: PASS
