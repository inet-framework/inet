%# expected-result: FAIL
%description:
Expected failure by explicit maintainer decision: defer this nontrivial repair to future work.
Repair requires a supported PBCC selection path and verification of its transmitter and receiver support.
Evidence and deferred-repair decision: doc/project/evidence/model/wifi/results.md#deferred-repair-expectations.
This declaration records unresolved work, not supported behavior.

Observe one of the existing compliant PBCC mode objects. The default b mode set
contains CCK long-preamble entries only; no production selection path to PBCC is established.

%file: B_Pbcc.cc

#include "ProtocolTest.h"
#include "WifiTestSupport.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HrDsssMode.h"

namespace inet {
namespace protocoltest {

using namespace inet::physicallayer;

Define_ProtocolTest(wifi_11b_pbcc)
{
    return ProtocolTest("wifi_11b_pbcc")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 32 || ieee80211mac.type == 40")
                  .filterEvent([](const MatchContext& c) {
                      auto m = dynamic_cast<const Ieee80211HrDsssMode *>(txMode(c.event));
                      if (!m) return false;
                      return m == &Ieee80211HrDsssCompliantModes::hrDsssMode5_5MbpsPbccLongPreamble ||
                             m == &Ieee80211HrDsssCompliantModes::hrDsssMode11MbpsPbccLongPreamble ||
                             m == &Ieee80211HrDsssCompliantModes::hrDsssMode11MbpsPbccShortPreamble;
                  })
                  .describe("a data frame transmitted with PBCC coding").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11b_pbcc"
*.sta*.wlan[*].bitrate = 5.5Mbps
*.ap.wlan[*].bitrate = 5.5Mbps
include ../../ini/_b.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11b_pbcc: PASS
