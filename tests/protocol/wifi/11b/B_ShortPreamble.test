%# expected-result: FAIL
%description:
Expected failure by explicit maintainer decision: defer this nontrivial repair to future work.
Repair requires explicit short-preamble selection and compatible transmitter/receiver behavior.
Evidence and deferred-repair decision: doc/project/evidence/model/wifi/results.md#deferred-repair-expectations.
This declaration records unresolved work, not supported behavior.

Observe an HR/DSSS short-preamble transmission. PHY objects exist, but the
default b mode set contains long-preamble entries only. This exposes a selection gap.

%file: B_ShortPreamble.cc

#include "ProtocolTest.h"
#include "WifiTestSupport.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HrDsssMode.h"

namespace inet {
namespace protocoltest {

using namespace inet::physicallayer;

Define_ProtocolTest(wifi_11b_short_preamble)
{
    return ProtocolTest("wifi_11b_short_preamble")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 32 || ieee80211mac.type == 40")
                  .filterEvent([](const MatchContext& c) {
                      auto m = dynamic_cast<const Ieee80211HrDsssMode *>(txMode(c.event));
                      if (!m) return false;
                      auto pm = dynamic_cast<const Ieee80211HrDsssPreambleMode *>(m->getPreambleMode());
                      return pm != nullptr &&
                             pm->getPreambleType() == IEEE80211_HRDSSS_PREAMBLE_TYPE_SHORT;
                  })
                  .describe("a data frame with short-preamble HR/DSSS mode").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11b_short_preamble"
*.sta*.wlan[*].bitrate = 11Mbps
*.ap.wlan[*].bitrate = 11Mbps
include ../../ini/_b.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11b_short_preamble: PASS
