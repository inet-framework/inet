%# expected-result: FAIL
%description:
Observe the specific management action for WifiTpc. Match the generic action
wire representation, not a nonexistent specialized C++ chunk. See the Wi-Fi audit
evidence for the missing feature and stimulus limitations.

%file: WifiTpc.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_tpc)
{
    return ProtocolTest("wifi_tpc")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isManagementAction(c.event, 0, 3); })
                  .describe("a TPC Report action frame from AP").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_tpc"
include ../../ini/_a.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_tpc: PASS
