%# expected-result: FAIL
%description:
Observe a Beacon containing Country (element ID 7). The current model preserves
unknown received elements but does not generate a Country element in its Beacons.

%file: WifiCountryIe.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_country_ie)
{
    return ProtocolTest("wifi_country_ie")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 8")
                  .filterEvent([](const MatchContext& c) { return hasManagementElement(c.event, 7); })
                  .describe("a Beacon containing a Country IE").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_country_ie"
include ../../ini/_a.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_country_ie: PASS
