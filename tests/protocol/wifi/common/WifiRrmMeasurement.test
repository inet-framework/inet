%# expected-result: FAIL
%description:
Observe the specific management action for WifiRrmMeasurement. Match the generic action
wire representation, not a nonexistent specialized C++ chunk. See the Wi-Fi audit
evidence for the missing feature and stimulus limitations.

%file: WifiRrmMeasurement.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_rrm_measurement)
{
    return ProtocolTest("wifi_rrm_measurement")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isManagementAction(c.event, 5, 0); })
                  .describe("a Measurement Request action frame from AP").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_rrm_measurement"
include ../../ini/_n.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_rrm_measurement: PASS
