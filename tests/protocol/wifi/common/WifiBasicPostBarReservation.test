%description:
A Basic BAR that reserves only its Block Ack reply cannot authorize another DATA transmission within that TXOP.

%file: BasicPostBarReservation.cc
#include "BlockAckLifecycleTestSupport.h"

namespace inet::protocoltest {
Define_ProtocolTest(wifi_basic_post_bar_reservation)
{
    auto sent = [] { return on("sta1.wlan[0].mac").signal("packetSentToLower"); };
    auto txopStart = [](const PacketEvent&) {
        auto root = cSimulation::getActiveSimulation()->getSystemModule();
        auto txop = check_and_cast<TxopProcedure *>(root->getModuleByPath("sta1.wlan[0].mac.hcf.edca.edcaf[3].txopProcedure"));
        return cValue(txop->getStart().dbl());
    };
    return ProtocolTest("wifi_basic_post_bar_reservation")
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower").filterPacket("has(Ieee80211AddbaResponse)").within(1.02))
        .once(sent().filterEvent([](const MatchContext& context) {
            auto header = dynamicPtrCast<const Ieee80211DataHeader>(context.event.packet->peekAtFront<Ieee80211MacHeader>());
            return header && header->getAckPolicy() == BLOCK_ACK;
        }).capture("dataTxop", txopStart).describe("the station opens with Basic DATA").within(0.03))
        .once(sent().filterPacket("has(Ieee80211BasicBlockAckReq)")
            .assertEvent([=](const MatchContext& context) {
                return txopStart(context.event).doubleValue() == context.get("dataTxop").doubleValue();
            }).describe("the BAR uses this same TXOP").within(0.003))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower").filterPacket("has(Ieee80211BasicBlockAck)")
            .assertEvent([](const MatchContext& context) {
                return context.event.packet->peekAtFront<Ieee80211BasicBlockAck>()->getDurationField() == SIMTIME_ZERO;
            }).describe("the reply leaves no continuation reservation").within(0.001))
        .once(sent().filterPacket("has(Ieee80211DataHeader)").assertEvent([=](const MatchContext& context) {
            return txopStart(context.event).doubleValue() > context.get("dataTxop").doubleValue();
        }).describe("the next DATA waits for a new channel grant").within(0.01));
}
}

%inifile: test.ini
[General]
*.tester.testName = "wifi_basic_post_bar_reservation"
*.sta1.app[0].sendInterval = 0.1ms
*.sta1.app[0].stopTime = 1.003s
**.hcf.edca.edcaf[*].txopProcedure.txopLimit = 0.45ms
**.hcf.rtsPolicy.rtsThreshold = 100B
**.hcf.originatorAckPolicy.blockAckReqThreshold = 1
sim-time-limit = 1.1s
include ../../ini/_blockackLifecycle.ini

%contains: stdout
PROTOCOLTEST wifi_basic_post_bar_reservation: PASS
