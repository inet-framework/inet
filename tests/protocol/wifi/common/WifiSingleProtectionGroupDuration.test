%description:
IEEE Std 802.11-2024, 9.2.5.2 a) 9), sets Duration/ID to zero for the final group frame of a single-protection TXOP.
Use the model's fragmentation path to supply an already extracted successor and observe the transmitted frames.

%extraargs: -r 0..2

%file: GroupDuration.cc
#include <iostream>
#include <vector>

#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"

namespace inet::ieee80211 {

class GroupDurationHcf : public Hcf
{
  public:
    std::vector<Ptr<const Ieee80211DataHeader>> groupHeaders;
    int finishedSequences = 0;

    void injectGroupData()
    {
        Enter_Method("injectGroupData");
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setTid(0);
        header->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
        header->setTransmitterAddress(mac->getAddress());
        header->setAddress3(mac->getAddress());
        auto packet = new Packet("group-data", header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
    }

    void transmissionComplete(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override
    {
        auto data = dynamicPtrCast<const Ieee80211DataHeader>(header);
        if (!data || !data->getReceiverAddress().isBroadcast())
            throw cRuntimeError("Expected broadcast DATA");
        if (groupHeaders.size() != static_cast<size_t>(finishedSequences))
            throw cRuntimeError("The previous group frame's sequence must finish before the next transmission");
        groupHeaders.push_back(data);
        Hcf::transmissionComplete(packet, header);
    }

    void frameSequenceFinished() override
    {
        finishedSequences++;
        Hcf::frameSequenceFinished();
    }
};
Define_Module(GroupDurationHcf);

class GroupDurationTest : public cSimpleModule
{
  public:
    GroupDurationTest() : cSimpleModule(65536) {}

  protected:
    void activity() override
    {
        wait(SimTime(1, SIMTIME_MS));
        auto hcf = check_and_cast<GroupDurationHcf *>(getModuleByPath("^.sender.wlan[0].mac.hcf"));
        hcf->injectGroupData();
        wait(SimTime(2, SIMTIME_MS));
        if (hcf->groupHeaders.size() != 2 || hcf->finishedSequences != 2)
            throw cRuntimeError("Expected two group frames in separate frame sequences");
        const auto& first = hcf->groupHeaders[0];
        const auto& second = hcf->groupHeaders[1];
        if (first->getSequenceNumber() != second->getSequenceNumber() ||
            first->getFragmentNumber() != 0 || !first->getMoreFragments() ||
            second->getFragmentNumber() != 1 || second->getMoreFragments())
            throw cRuntimeError("Expected the two fragments of the submitted group packet");
        if (first->getDurationField() != SIMTIME_ZERO || second->getDurationField() != SIMTIME_ZERO)
            throw cRuntimeError("Group TXOPs advertised Duration/ID of %s and %s, expected zero for both",
                    first->getDurationField().str().c_str(), second->getDurationField().str().c_str());
        std::cout << "Single-protection group Duration/ID assertions passed.\n";
        endSimulation();
    }
};
Define_Module(GroupDurationTest);

} // namespace inet::ieee80211

%file: test.ned
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

module GroupDurationHcf extends Hcf { @class(::inet::ieee80211::GroupDurationHcf); }
simple GroupDurationTest { @class(::inet::ieee80211::GroupDurationTest); }

network GroupDurationNetwork
{
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        sender: WirelessHost;
        test: GroupDurationTest;
}

%inifile: test.ini
[General]
network = GroupDurationNetwork
sim-time-limit = 4ms
seed-set = 0
cmdenv-express-mode = true
cmdenv-stop-batch-on-error = false
record-vector-results = false
record-scalar-results = false
*.sender.mobility.initFromDisplayString = false
*.sender.mobility.initialX = 0m
*.sender.mobility.initialY = 0m
*.sender.mobility.initialZ = 0m
*.sender.wlan[0].address = "02:00:00:00:00:01"
*.sender.wlan[0].agent.typename = ""
*.sender.wlan[0].mgmt.typename = "Ieee80211MgmtAdhoc"
*.sender.wlan[0].opMode = "a"
*.sender.wlan[0].bitrate = 6Mbps
*.sender.wlan[0].mac.qosStation = true
*.sender.wlan[0].mac.hcf.typename = "GroupDurationHcf"
**.hcf.isBlockAckSupported = ${blockAck=false,true,true}
**.hcf.blockAckVariant = ${variant="basic","basic","compressed" ! blockAck}
**.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
**.hcf.originatorMacDataService.mpduAggregationPolicy.typename = ""
**.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 120B
**.hcf.edca.edcaf[*].cwMin = 0
**.hcf.edca.edcaf[*].cwMax = 0
**.hcf.edca.edcaf[*].txopProcedure.txopLimit = 1ms
**.hcf.edca.edcaf[*].txopProcedure.protectionMechanism = "single"

%contains: stdout
Single-protection group Duration/ID assertions passed.
