%description:
Send one unicast application packet after association. A test-only MAC receiver drops
one addressed ACK after 1s and emits proof of the fault. Production DCF must retransmit
the same sequence/fragment with Retry set, and the destination must deliver only once.

%file: WifiRetransmission.cc
#include "WifiTestSupport.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"

namespace inet {
namespace protocoltest {
using namespace ieee80211;

class OneAckLossMac : public Ieee80211Mac
{
  protected:
    bool suppressed = false;
    virtual void handleLowerPacket(Packet *packet) override
    {
        auto header = packet->peekAtFront<Ieee80211MacHeader>();
        if (!suppressed && simTime() >= SimTime(1) && header->getType() == ST_ACK &&
                header->getReceiverAddress() == mib->address) {
            suppressed = true;
            emit(registerSignal("ackSuppressed"), 1L);
            delete packet;
            return;
        }
        Ieee80211Mac::handleLowerPacket(packet);
    }
};
Define_Module(OneAckLossMac);

Define_ProtocolTest(wifi_retransmission)
{
    return ProtocolTest("wifi_retransmission")
        .meanwhile(exactlyTimes(1, on("sta2.udp").signal("packetSentToUpper")
                  .describe("one delivery from UDP to the application despite MAC retry").within(2.5)))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 32")
                  .assertEvent([](const MatchContext& c) { return !c.event.packet->peekAtFront<Ieee80211DataHeader>()->getRetry(); })
                  .capture("sequence", [](const PacketEvent& e) { return cValue(e.packet->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().get()); })
                  .capture("fragment", [](const PacketEvent& e) { return cValue(e.packet->peekAtFront<Ieee80211DataHeader>()->getFragmentNumber()); })
                  .describe("original data frame").within(2))
        .once(on("sta1.wlan[0].mac").signal("ackSuppressed").filterValue(1)
                  .describe("exactly one addressed ACK deliberately suppressed").within(0.1))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 32")
                  .assertEvent([](const MatchContext& c) {
                      auto header = c.event.packet->peekAtFront<Ieee80211DataHeader>();
                      return header->getRetry() && header->getSequenceNumber().get() == c.get("sequence").intValue() &&
                             header->getFragmentNumber() == c.get("fragment").intValue();
                  }).describe("same sequence and fragment retransmitted with Retry set").within(0.1));
}
} // namespace protocoltest
} // namespace inet

%file: WifiRetransmission.ned
@namespace(inet::protocoltest);
import inet.linklayer.ieee80211.mac.Ieee80211Mac;
module OneAckLossMac extends Ieee80211Mac
{
    parameters:
        @class(OneAckLossMac);
        @signal[ackSuppressed](type=long);
}

%inifile: test.ini
[General]
*.tester.testName = "wifi_retransmission"
*.sta1.wlan[*].mac.typename = "OneAckLossMac"
*.sta1.app[0].stopTime = 1.001s
include ../../ini/_g.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_retransmission: PASS

%contains: stdout
WifiInfraNetwork.sta2.app[0]: received 1 packets
