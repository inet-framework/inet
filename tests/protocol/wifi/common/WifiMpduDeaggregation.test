%description:
Check production MPDU extraction from complete and overlong-delimiter aggregates.
Recovery crosses typed MAC header bytes and retains the later bounded member.
Four seed-zero runs cover both layouts as typed chunks and reconstructed bytes.

%extraargs: -r 0..3

%file: WifiMpduDeaggregation.cc
#include "ProtocolTest.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/aggregation/MpduDeaggregation.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::protocoltest;

class WifiMpduDeaggregationDriver : public cSimpleModule
{
    bool checked = false;
  protected:
    std::vector<uint8_t> appendTypedMember(Packet& aggregate, int declaredLength) {
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(declaredLength);
        aggregate.insertAtBack(delimiter);
        auto header = makeShared<Ieee80211DataHeader>();
        header->setSequenceNumber(SequenceNumberCyclic(0));
        Packet member("typed-member", header);
        member.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(100 - header->getChunkLength().get<B>(), 0)));
        auto expected = member.peekAllAsBytes()->getBytes();
        aggregate.insertAtBack(member.peekData());
        return expected;
    }
    void initialize() override {
        scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("extract"));
    }
    void handleMessage(cMessage *message) override {
        delete message;
        bool recovery = par("recovery").boolValue();
        auto aggregate = new Packet("first+middle+last");
        const auto first = appendTypedMember(*aggregate, 100);
        const auto middle = appendTypedMember(*aggregate, recovery ? 2000 : 100);
        auto lastDelimiter = makeShared<Ieee80211MpduSubframeHeader>();
        lastDelimiter->setLength(20);
        aggregate->insertAtBack(lastDelimiter);
        const std::vector<uint8_t> last(20, 0);
        aggregate->insertAtBack(makeShared<BytesChunk>(last));
        ASSERT(aggregate->getDataLength() == B(232));
        if (par("rawBytes").boolValue()) {
            auto bytes = aggregate->peekAllAsBytes()->getBytes();
            delete aggregate;
            aggregate = new Packet("first+middle+last", makeShared<BytesChunk>(bytes));
        }
        MpduDeaggregation deaggregator;
        // The production method owns and deletes the input aggregate.
        auto frames = deaggregator.deaggregateFrame(aggregate);
        ASSERT(frames != nullptr && frames->size() == (recovery ? 2 : 3));
        ASSERT(frames->at(0)->getDataLength() == B(100));
        ASSERT(frames->at(0)->peekAllAsBytes()->getBytes() == first);
        if (!recovery) {
            ASSERT(frames->at(1)->getDataLength() == B(100));
            ASSERT(frames->at(1)->peekAllAsBytes()->getBytes() == middle);
        }
        ASSERT(frames->back()->getDataLength() == B(20));
        ASSERT(frames->back()->peekAllAsBytes()->getBytes() == last);
        for (auto frame : *frames)
            delete frame;
        delete frames;
        checked = true;
        emit(registerSignal("testMpduDeaggregation"), 1L);
    }
    void finish() override { ASSERT(checked); }
};
Define_Module(WifiMpduDeaggregationDriver);

Define_ProtocolTest(wifi_mpdu_deaggregation) {
    return ProtocolTest("wifi_mpdu_deaggregation")
        .once(on("driver").signal("testMpduDeaggregation").assertValue(1).within(0.01));
}

%file: test.ned
import inet.protocoltest.ProtocolTester;
simple WifiMpduDeaggregationDriver {
    parameters:
        @class(::WifiMpduDeaggregationDriver);
        bool recovery;
        bool rawBytes;
        @signal[testMpduDeaggregation](type=long);
}
network Test {
    submodules:
        tester: ProtocolTester;
        driver: WifiMpduDeaggregationDriver;
}

%inifile: omnetpp.ini
[General]
network = Test
sim-time-limit = 2ms
seed-set = 0
*.tester.testName = "wifi_mpdu_deaggregation"
*.tester.stateSignals = "testMpduDeaggregation"
*.driver.recovery = ${recovery=false,true}
*.driver.rawBytes = ${rawBytes=false,true}
**.vector-recording = false

%contains: stdout
PROTOCOLTEST wifi_mpdu_deaggregation: PASS
%contains: stdout
Run statistics: total 4, successful 4
%not-contains: stdout
PROTOCOLTEST wifi_mpdu_deaggregation: FAIL
