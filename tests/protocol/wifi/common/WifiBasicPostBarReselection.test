%description:
After a protected Basic BAR the sender may transmit the next eligible DATA using the
advertised continuation airtime. The radio tap reports the opening MPDU missing, repeats
that case with too little continuation duration in the reply, or removes the first queued source
as the reply arrives. The fixtures distinguish same-grant Retry from a fresh grant and
verify the fresh replacement receives the sequence number held for the removed source.

%extraargs: -r 0..2

%file: BasicPostBarReselection.cc
#include "BlockAckLifecycleTestSupport.h"

namespace inet::protocoltest {
enum class Reselection { RETRY_FITS, RETRY_TOO_LONG, FRESH };

static auto *senderEdcaf()
{
    auto network = cSimulation::getActiveSimulation()->getSystemModule();
    return check_and_cast<Edcaf *>(network->getModuleByPath("sta1.wlan[0].mac.hcf.edca.edcaf[3]"));
}

static ProtocolTest postBarReselection(const char *name, Reselection scenario)
{
    auto sent = [] { return on("sta1.wlan[0].mac").signal("packetSentToLower"); };
    auto data = [](const PacketEvent& event) {
        return dynamicPtrCast<const Ieee80211DataHeader>(event.packet->peekAtFront<Ieee80211MacHeader>());
    };
    auto txopStart = [](const PacketEvent&) { return cValue(senderEdcaf()->getTxopProcedure()->getStart().dbl()); };
    auto next = [] { return senderEdcaf()->getInProgressFrames()->peekFrameToTransmit(); };
    return ProtocolTest(name)
        .intercept(tap("radioMedium").from("ap").to("sta1")
            .filterPacket("has(Ieee80211BasicBlockAck) && ieee80211mac.receiverAddress.getInt() == 0x020000000003")
            .nth(1).mutate([=](Packet *packet) {
                if (scenario == Reselection::FRESH) {
                    auto queue = senderEdcaf()->getPendingQueue();
                    auto discarded = next();
                    ASSERT(discarded && !senderEdcaf()->getInProgressFrames()->containsFrame(discarded));
                    auto module = check_and_cast<cModule *>(queue);
                    cContextSwitcher queueContext(module);
                    queue->removePacket(discarded);
                    PacketDropDetails details;
                    details.setReason(QUEUE_OVERFLOW);
                    module->emit(cComponent::registerSignal("packetDropped"), discarded, &details);
                    delete discarded;
                    return;
                }
                std::vector<Ptr<Chunk>> prefix;
                while (!dynamicPtrCast<const Ieee80211MacHeader>(packet->peekAtFront<Chunk>()))
                    prefix.push_back(packet->removeAtFront<Chunk>(packet->peekAtFront<Chunk>()->getChunkLength()));
                auto response = packet->removeAtFront<Ieee80211BasicBlockAck>();
                auto bitmap = response->getBlockAckBitmap(0);
                bitmap.setBit(0, false);
                response->setBlockAckBitmap(0, bitmap);
                if (scenario == Reselection::RETRY_TOO_LONG)
                    response->setDurationField(SimTime(20, SIMTIME_US));
                packet->insertAtFront(response);
                for (auto it = prefix.rbegin(); it != prefix.rend(); ++it)
                    packet->insertAtFront(*it);
            }).describe("change the first feedback or withdraw the queued source"))
        .once(sent().filterEvent([=](const MatchContext& c) {
                auto header = data(c.event);
                return header && header->getAckPolicy() == BLOCK_ACK;
            }).capture("openingSequence", [=](const PacketEvent& event) { return cValue(data(event)->getSequenceNumber().get()); })
            .capture("grant", txopStart).describe("transmit the first DATA under Basic").within(1.05))
        .once(sent().filterPacket("has(Ieee80211BasicBlockAckReq)")
            .assertEvent([=](const MatchContext& c) {
                auto candidate = next();
                auto request = c.event.packet->peekAtFront<Ieee80211BasicBlockAckReq>();
                return txopStart(c.event) == c.get("grant") && request->getDurationField() > SimTime(88, SIMTIME_US) &&
                    candidate && !senderEdcaf()->getInProgressFrames()->containsFrame(candidate) &&
                    request->getStartingSequenceNumber().get() == c.get("openingSequence").intValue();
            })
            .capture("queuedName", [=](const PacketEvent&) { return cValue(next()->getName()); })
            .capture("queuedSequence", [=](const PacketEvent&) {
                return cValue(senderEdcaf()->getInProgressFrames()->getCandidateSequenceNumber(next()).get());
            })
            .describe("reserve airtime for the still-queued fresh DATA").within(0.001))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
            .filterPacket("has(Ieee80211BasicBlockAck)").describe("receive the Basic Block Ack").within(0.001))
        .once(sent().filterEvent([=](const MatchContext& c) { return data(c.event) != nullptr; })
            .assertEvent([=](const MatchContext& c) {
                auto header = data(c.event);
                auto sameGrant = txopStart(c.event) == c.get("grant");
                if (scenario == Reselection::FRESH)
                    return sameGrant && !header->getRetry() && header->getSequenceNumber().get() == c.get("queuedSequence").intValue() &&
                        std::string(c.event.packet->getName()) != c.get("queuedName").stringValue();
                return sameGrant == (scenario == Reselection::RETRY_FITS) &&
                    header->getRetry() && header->getSequenceNumber().get() == c.get("openingSequence").intValue();
            })
            .describe("send the selected DATA only under a reservation that covers it").within(0.01));
}

Define_ProtocolTest(wifi_basic_post_bar_retry_fits) { return postBarReselection("wifi_basic_post_bar_retry_fits", Reselection::RETRY_FITS); }
Define_ProtocolTest(wifi_basic_post_bar_retry_too_long) { return postBarReselection("wifi_basic_post_bar_retry_too_long", Reselection::RETRY_TOO_LONG); }
Define_ProtocolTest(wifi_basic_post_bar_fresh_replacement) { return postBarReselection("wifi_basic_post_bar_fresh_replacement", Reselection::FRESH); }
}

%inifile: test.ini
[General]
*.tester.testName = ${scenario=0..2} == 0 ? "wifi_basic_post_bar_retry_fits" : (${scenario} == 1 ? "wifi_basic_post_bar_retry_too_long" : "wifi_basic_post_bar_fresh_replacement")
*.radioMedium.typename = "Ieee80211ScalarTapRadioMedium"
*.sta1.app[0].sendInterval = 0.1ms
*.sta1.app[0].stopTime = 1.003s
**.originatorMacDataService.msduAggregationPolicy.typename = ""
**.hcf.edca.edcaf[*].txopProcedure.txopLimit = 4ms
**.hcf.rtsPolicy.rtsThreshold = 100B
**.hcf.originatorAckPolicy.blockAckReqThreshold = 1
sim-time-limit = 1.1s
include ../../ini/_blockackLifecycle.ini

%contains: stdout
PROTOCOLTEST wifi_basic_post_bar_retry_fits: PASS
%contains: stdout
PROTOCOLTEST wifi_basic_post_bar_retry_too_long: PASS
%contains: stdout
PROTOCOLTEST wifi_basic_post_bar_fresh_replacement: PASS
%not-contains: stdout
: FAIL
