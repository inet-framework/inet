%# expected-result: FAIL
%description:
Observe a management frame with the real protectedFrame flag set. The flag exists
but is unused by production management. This presence probe does not validate cryptography.

%file: WifiPmf.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_pmf)
{
    return ProtocolTest("wifi_pmf")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) {
                      if (!c.event.packet) return false;
                      auto header = c.event.packet->peekAtFront<ieee80211::Ieee80211MgmtHeader>(b(-1), Chunk::PF_ALLOW_NULLPTR);
                      return header && header->getProtectedFrame();
                  })
                  .describe("a PMF-protected management frame from AP").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_pmf"
include ../../ini/_n.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_pmf: PASS
