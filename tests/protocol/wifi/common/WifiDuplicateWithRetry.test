%description:
The radio medium sends a copy of the first DATA frame of sta1 on the air 1 ms after the original, and the copy carries the Retry bit. The AP must acknowledge the copy, and it must not deliver the data again: IEEE 802.11 rejects a frame with the Retry bit as a duplicate when its address, sequence number and fragment number match an earlier frame. So the AP sends two ACKs, and sta2 gets the datagram one time.

The AP also acknowledges the copy, so sta1 gets an ACK that no frame exchange of its own waits for. IEEE 802.11-2024 10.3.2.11 counts an ACK only when it starts within the AckTimeout after the frame that it answers, so sta1 must ignore this ACK, and the run must go on. The last step selects the ACK by its receiver address, because the radio of sta1 also hears the ACK that sta2 sends to the AP.

%file: WifiDuplicateWithRetry.cc
#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {
using namespace ieee80211;

static cValue sequenceOf(const PacketEvent& e) { return cValue(e.packet->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().get()); }
static cValue transmitterOf(const PacketEvent& e) { return cValue((intval_t)e.packet->peekAtFront<Ieee80211DataHeader>()->getTransmitterAddress().getInt()); }
static bool hasRetry(const PacketEvent& e) { return e.packet->peekAtFront<Ieee80211DataHeader>()->getRetry(); }

Define_ProtocolTest(wifi_duplicate_with_retry)
{
    return ProtocolTest("wifi_duplicate_with_retry")
        .intercept(tap("radioMedium").from("sta1").filterPacket("ieee80211mac.type == 32").nth(1).duplicate(0.001)
                     .describe("the first DATA frame of sta1, and one copy 1 ms later"))
        .intercept(tap("radioMedium").copiesOnly().mutate(setRetryBit)
                     .describe("the copy, with the Retry bit"))
        .meanwhile(exactlyTimes(1, on("sta2.udp").signal("packetSentToUpper")
                                    .describe("a datagram from UDP of sta2 to the application").within(2.5)))
        .once(on("ap.wlan[0].mac").signal("packetReceivedFromLower").filterPacket("ieee80211mac.type == 32")
                  .capture("sequence", sequenceOf)
                  .capture("sta1", transmitterOf)
                  .describe("the original DATA frame at the AP").within(2))
        .meanwhile(exactlyTimes(2, on("ap.wlan[0].mac").signal("packetSentToLower").filterPacket("ieee80211mac.type == 29")
                                    .describe("an ACK from the AP").within(0.002)))
        .once(on("ap.wlan[0].mac").signal("packetReceivedFromLower").filterPacket("ieee80211mac.type == 32")
                  .notBefore(0.001)
                  .assertEvent([](const MatchContext& c) {
                      return hasRetry(c.event) && sequenceOf(c.event).intValue() == c.get("sequence").intValue();
                  })
                  .describe("the copy at the AP, 1 ms after the original, with the Retry bit and the same sequence number").within(0.0011))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("ieee80211mac.type == 29 && ieee80211mac.receiverAddress.getInt() == {sta1}")
                  .describe("the ACK of the copy at sta1, which no exchange of sta1 waits for").within(0.0001));
}
} // namespace protocoltest
} // namespace inet

%inifile: test.ini
[General]
*.tester.testName = "wifi_duplicate_with_retry"
*.radioMedium.typename = "Ieee80211ScalarTapRadioMedium"
*.sta1.app[0].stopTime = 1.001s
include ../../ini/_g.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_duplicate_with_retry: PASS

%contains: stdout
WifiInfraNetwork.sta2.app[0]: received 1 packets
