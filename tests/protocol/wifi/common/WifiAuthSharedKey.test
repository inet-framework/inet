%description:
The modeled four-message authentication exchange: STA sends transactions 1 and 3,
AP sends transactions 2 and 4 with successful status. This observes the dummy
management exchange supported by numAuthSteps=4; it does not validate WEP cryptography.

%file: WifiAuthSharedKey.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_auth_sharedkey)
{
    return ProtocolTest("wifi_auth_sharedkey")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 11")
                  .assertEvent([](const MatchContext& c) {
                      auto body = managementBody<ieee80211::Ieee80211AuthenticationFrame>(c.event);
                      return body != nullptr && body->getSequenceNumber() == 1;
                  })
                  .describe("authentication transaction 1 from sta1").within(2.5))
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 11")
                  .assertEvent([](const MatchContext& c) {
                      auto body = managementBody<ieee80211::Ieee80211AuthenticationFrame>(c.event);
                      return body != nullptr && body->getSequenceNumber() == 2 &&
                             body->getStatusCode() == ieee80211::SC_SUCCESSFUL;
                  })
                  .describe("authentication transaction 2 from ap").within(0.5))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 11")
                  .assertEvent([](const MatchContext& c) {
                      auto body = managementBody<ieee80211::Ieee80211AuthenticationFrame>(c.event);
                      return body != nullptr && body->getSequenceNumber() == 3 &&
                             body->getStatusCode() == ieee80211::SC_SUCCESSFUL;
                  })
                  .describe("authentication transaction 3 from sta1").within(0.5))
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 11")
                  .assertEvent([](const MatchContext& c) {
                      auto body = managementBody<ieee80211::Ieee80211AuthenticationFrame>(c.event);
                      return body != nullptr && body->getSequenceNumber() == 4 &&
                             body->getStatusCode() == ieee80211::SC_SUCCESSFUL;
                  })
                  .describe("authentication transaction 4 from ap").within(0.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_auth_sharedkey"
*.ap.wlan[*].mgmt.numAuthSteps = 4
*.sta2.wlan[*].agent.startingTime = 2s
include ../../ini/_g.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_auth_sharedkey: PASS
