%# expected-result: FAIL
%description:
Observe EAPOL encapsulation (EtherType 0x888e) on the wireless link. This is a
necessary presence probe for RSN, not proof of the complete four-way handshake.

%file: WifiRsn4way.cc

#include "ProtocolTest.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_rsn_4way)
{
    return ProtocolTest("wifi_rsn_4way")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("Ieee8022LlcSnapHeader.protocolId == 34958")
                  .describe("an EAPOL frame from STA (RSN 4-way handshake)").within(2.0));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_rsn_4way"
include ../../ini/_ac.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_rsn_4way: PASS
