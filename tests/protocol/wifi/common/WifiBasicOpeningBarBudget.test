%description:
Size fresh Basic DATA so due feedback can fit the TXOP when possible. Otherwise the BAR contends again.

%extraargs: -r 0..2

%file: BasicOpeningBarBudget.cc
#include "BlockAckLifecycleTestSupport.h"
#include "inet/physicallayer/wireless/ieee80211/mode/IIeee80211Mode.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

namespace inet::protocoltest {
static ProtocolTest barBudget(const char *name, bool sameTxop, bool continuation = false)
{
    auto outbound = [] { return on("sta1.wlan[0].mac").signal("packetSentToLower"); };
    auto txopStart = [](const PacketEvent&) {
        auto network = cSimulation::getActiveSimulation()->getSystemModule();
        auto txop = check_and_cast<TxopProcedure *>(network->getModuleByPath("sta1.wlan[0].mac.hcf.edca.edcaf[3].txopProcedure"));
        return cValue(txop->getStart().dbl());
    };
    auto data = [&] { return outbound().filterEvent([](const MatchContext& context) {
        return context.event.time >= SimTime(1020, SIMTIME_MS) &&
            dynamicPtrCast<const Ieee80211DataHeader>(context.event.packet->peekAtFront<Ieee80211MacHeader>());
    }); };
    auto expectedNextFrame = [](const PacketEvent& event) {
        auto mode = event.packet->getTag<physicallayer::Ieee80211ModeReq>()->getMode();
        return cValue((event.time + mode->getDuration(event.packet->getDataLength()) + mode->getSifsTime()).dbl());
    };
    auto sifsError = [](const MatchContext& context, const char *capture) {
        return context.event.time - SimTime(context.get(capture).doubleValue());
    };
    auto test = ProtocolTest(name)
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
            .filterPacket("has(Ieee80211AddbaResponse)").describe("the station negotiates Basic Block Ack").within(1.019))
        .once(data().assertEvent([](const MatchContext& context) {
            return context.event.packet->peekAtFront<Ieee80211DataHeader>()->getAckPolicy() == BLOCK_ACK;
        }).capture("openingTxop", txopStart).capture("openingBytes", [](const PacketEvent& event) {
            return cValue(event.packet->getByteLength());
        }).capture("afterOpening", expectedNextFrame).describe("the station opens the second burst with Basic DATA").within(0.03));
    if (continuation)
        test.once(data().assertEvent([=](const MatchContext& context) {
            auto header = context.event.packet->peekAtFront<Ieee80211DataHeader>();
            auto delta = sifsError(context, "afterOpening");
            return header->getAckPolicy() == BLOCK_ACK && context.get("openingBytes").intValue() == 2132 &&
                txopStart(context.event).doubleValue() == context.get("openingTxop").doubleValue() &&
                delta >= SimTime(-2, SIMTIME_NS) && delta <= SimTime(2, SIMTIME_NS);
        }).capture("continuationBytes", [](const PacketEvent& event) {
            return cValue(event.packet->getByteLength());
        }).capture("afterContinuation", expectedNextFrame).describe("a second Basic DATA follows the opening after SIFS").within(0.004));
    return test.once(outbound().filterPacket("has(Ieee80211BasicBlockAckReq)").assertEvent([=](const MatchContext& context) {
            auto opening = context.get("openingTxop").doubleValue();
            auto current = txopStart(context.event).doubleValue();
            auto delta = sifsError(context, continuation ? "afterContinuation" : "afterOpening");
            if (context.get(continuation ? "continuationBytes" : "openingBytes").intValue() != 1066)
                return false;
            return sameTxop ? current == opening && delta >= SimTime(-2, SIMTIME_NS) && delta <= SimTime(2, SIMTIME_NS) :
                current > opening && delta > SimTime(2, SIMTIME_NS);
        }).describe(sameTxop ? "the BAR follows the smaller DATA after SIFS in the same TXOP" : "the BAR starts in a later TXOP").within(0.01))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
            .filterPacket("has(Ieee80211BasicBlockAck)").describe("the station receives the requested Block Ack").within(0.001));
}

Define_ProtocolTest(wifi_basic_opening_bar_same_txop)
{
    return barBudget("wifi_basic_opening_bar_same_txop", true);
}

Define_ProtocolTest(wifi_basic_opening_bar_later_txop)
{
    return barBudget("wifi_basic_opening_bar_later_txop", false);
}

Define_ProtocolTest(wifi_basic_continuation_bar_same_txop)
{
    return barBudget("wifi_basic_continuation_bar_same_txop", true, true);
}
}

%inifile: test.ini
[General]
*.radioMedium.sameTransmissionStartTimeCheck = "ignore"
*.tester.testName = ${limit=3.03ms,1.6ms,5.9ms} == 5.9ms ? "wifi_basic_continuation_bar_same_txop" : (${limit} == 3.03ms ? "wifi_basic_opening_bar_same_txop" : "wifi_basic_opening_bar_later_txop")
*.sta1.numApps = 3
*.sta1.app[0].stopTime = 1.008s
*.sta1.app[1].typename = "UdpBasicApp"
*.sta1.app[1].destAddresses = "sta2"
*.sta1.app[1].destPort = 5000
*.sta1.app[1].messageLength = 1000B
*.sta1.app[1].sendInterval = 0.05ms
*.sta1.app[1].startTime = 1.02s
*.sta1.app[1].stopTime = 1.0206s
*.sta1.app[2].typename = "UdpSink"
*.sta1.app[2].localPort = 5001
*.sta2.numApps = 2
*.sta2.app[1].typename = "UdpBasicApp"
*.sta2.app[1].destAddresses = "sta1"
*.sta2.app[1].destPort = 5001
*.sta2.app[1].messageLength = 1500B
*.sta2.app[1].sendInterval = 1ms
*.sta2.app[1].startTime = 1.0195s
*.sta2.app[1].stopTime = 1.0196s
*.sta2.wlan[*].mac.hcf.rateSelection.dataFrameBitrate = 6Mbps
*.sta1.wlan[*].mac.hcf.edca.edcaf[3].txopProcedure.txopLimit = ${limit}
**.hcf.edca.edcaf[*].txopProcedure.txopLimit = 4ms
*.sta1.wlan[*].mac.hcf.rateSelection.dataFrameBitrate = 6Mbps
*.sta1.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.subframeNumThreshold = 2
*.sta1.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.aggregationLengthThreshold = -1
*.sta1.wlan[*].mac.hcf.originatorAckPolicy.maxBlockAckPolicyFrameLength = ${limit} == 5.9ms ? 2500B : 10000B
*.sta1.wlan[*].mac.hcf.basicBlockAckReqMaxDelay = ${limit} == 5.9ms ? 4ms : 20ms
**.hcf.originatorAckPolicy.blockAckReqThreshold = ${limit} == 5.9ms ? 2 : 1
sim-time-limit = 1.1s
include ../../ini/_blockackLifecycle.ini

%contains: stdout
PROTOCOLTEST wifi_basic_opening_bar_same_txop: PASS

%contains: stdout
PROTOCOLTEST wifi_basic_opening_bar_later_txop: PASS

%contains: stdout
PROTOCOLTEST wifi_basic_continuation_bar_same_txop: PASS
