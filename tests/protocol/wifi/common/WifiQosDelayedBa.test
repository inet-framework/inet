%# expected-result: FAIL
%description:
Expected failure by explicit maintainer decision: defer this nontrivial repair to future work.
Repair requires coordinated delayed response, acknowledgement, timeout, and TXOP handling after accepted delayed-policy negotiation.
Evidence and deferred-repair decision: doc/project/evidence/model/wifi/results.md#deferred-repair-expectations.
This declaration records unresolved work, not supported behavior.

Negotiate delayed Block Ack explicitly, send a BAR, then observe its immediate ACK
and the later Block Ack response. A later TXOP is not a fixed SIFS+PIFS delay.
The model exposes delayed policy negotiation but recipient handling is unfinished.

%file: WifiQosDelayedBa.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_qos_delayed_ba)
{
    return ProtocolTest("wifi_qos_delayed_ba")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) {
                      return c.event.packet && c.event.packet->peekAtFront<ieee80211::Ieee80211AddbaRequest>(b(-1), Chunk::PF_ALLOW_NULLPTR) != nullptr;
                  }).assertEvent([](const MatchContext& c) {
                      return !c.event.packet->peekAtFront<ieee80211::Ieee80211AddbaRequest>()->getBlockAckPolicy();
                  }).describe("ADDBA requests delayed policy").within(2.5))
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) {
                      return c.event.packet && c.event.packet->peekAtFront<ieee80211::Ieee80211AddbaResponse>(b(-1), Chunk::PF_ALLOW_NULLPTR) != nullptr;
                  }).assertEvent([](const MatchContext& c) {
                      auto response = c.event.packet->peekAtFront<ieee80211::Ieee80211AddbaResponse>();
                      return !response->getBlockAckPolicy() && response->getStatusCode() == ieee80211::SC_SUCCESSFUL;
                  }).describe("ADDBA accepts delayed policy").within(0.1))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 24")
                  .capture("originator", [](const PacketEvent& e) { return cValue(e.packet->peekAtFront<ieee80211::Ieee80211BlockAckReq>()->getTransmitterAddress().str().c_str()); })
                  .describe("BlockAckReq from sta1").within(2.5))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
                  .filterEvent([](const MatchContext& c) {
                      if (!c.event.packet) return false;
                      auto h = c.event.packet->peekAtFront<ieee80211::Ieee80211MacHeader>();
                      return (h->getType() == ieee80211::ST_ACK || h->getType() == ieee80211::ST_BLOCKACK) &&
                             h->getReceiverAddress() == MacAddress(c.get("originator").stringValue());
                  })
                  .assertEvent([](const MatchContext& c) {
                      return c.event.packet->peekAtFront<ieee80211::Ieee80211MacHeader>()->getType() == ieee80211::ST_ACK;
                  })
                  .describe("immediate ACK of the BAReq (delayed BA)").within(0.01))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("ieee80211mac.type == 25")
                  .describe("Block Ack in a later TXOP").within(0.1));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_qos_delayed_ba"
**.hcf.originatorBlockAckAgreementPolicy.delayedAckPolicySupported = true
**.hcf.recipientBlockAckAgreementPolicy.delayedAckPolicySupported = true
*.sta*.wlan[*].mac.hcf.isBlockAckSupported = true
*.ap.wlan[*].mac.hcf.isBlockAckSupported = true
*.sta*.wlan[*].mac.hcf.originatorAckPolicy.blockAckReqThreshold = 5
*.sta1.app[0].sendInterval = 0.1ms
include ../../ini/_n.ini
**.wlan[*].radio.receiver.energyDetection = -105dBm
**.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 10000B
**.hcf.originatorMacDataService.msduAggregationPolicy.subframeNumThreshold = 100
**.hcf.originatorMacDataService.msduAggregationPolicy.aggregationLengthThreshold = 10000
*.sta*.wlan[*].mac.hcf.originatorAckPolicy.maxBlockAckPolicyFrameLength = 10000B
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_qos_delayed_ba: PASS
