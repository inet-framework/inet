%description:
Check reserved BAR Type rejection through the production serializer and MAC receive path.
Real association and ADDBA establish a Basic compatibility agreement.
The radio tap converts the first real BAR to independent octets and sets Type 4 or 12.
Neither reserved Type may elicit Block Ack. A later valid BAR must still obtain feedback.
The Type 0 control preserves an ordinary Basic exchange.

%extraargs: -r 0..2

%file: BlockAckWireType.cc
#include "BlockAckLifecycleTestSupport.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211MacHeaderSerializer.h"
#include "inet/common/MemoryInputStream.h"
#include "inet/common/MemoryOutputStream.h"

namespace inet::protocoltest {
using namespace ieee80211;
class WireTypeSerializer : public Ieee80211MacHeaderSerializer {
  public:
    using Ieee80211MacHeaderSerializer::serializeFields;
};
static bool isBar(const MatchContext& c) {
    return c.event.packet->peekAtFront<Ieee80211MacHeader>()->getType() == ST_BLOCKACK_REQ;
}
static bool isBa(const MatchContext& c) {
    return c.event.packet->peekAtFront<Ieee80211MacHeader>()->getType() == ST_BLOCKACK;
}
static ProtocolTest wireTypeProgram(bool reserved) {
    ProtocolTest test(reserved ? "wifi_block_ack_reserved_type" : "wifi_block_ack_wire_control");
    test.intercept(tap("radioMedium").to("ap").filterPacket("ieee80211mac.type == 24").nth(1)
        .mutate([](Packet *packet) {
            std::vector<Ptr<Chunk>> prefix;
            while (!dynamicPtrCast<const Ieee80211MacHeader>(packet->peekAtFront<Chunk>()))
                prefix.push_back(packet->removeAtFront<Chunk>(packet->peekAtFront<Chunk>()->getChunkLength()));
            auto header = packet->removeAtFront<Ieee80211MacHeader>();
            MemoryOutputStream output;
            WireTypeSerializer serializer;
            serializer.serializeFields(output, header);
            auto bytes = output.getData();
            int type = getSimulation()->getSystemModule()->par("barType");
            bytes.at(16) = (bytes.at(16) & ~0x1e) | (type << 1);
            MemoryInputStream input(bytes);
            auto decoded = dynamicPtrCast<Ieee80211MacHeader>(Chunk::deserialize(input, typeid(Ieee80211MacHeader)));
            ASSERT(decoded);
            packet->insertAtFront(decoded);
            for (auto it = prefix.rbegin(); it != prefix.rend(); ++it)
                packet->insertAtFront(*it);
        }));
    test.once(on("sta1.wlan[0].mac").signal("packetSentToLower").filterEvent(isBar).within(1.1));
    if (reserved) {
        test.meanwhile(never(on("ap.wlan[0].mac").signal("packetSentToLower").filterEvent(isBa)
            .describe("reserved BAR Type elicits no Block Ack").within(0.0002)));
        test.once(on("sta1.wlan[0].mac").signal("packetSentToLower").filterEvent(isBar)
            .describe("a valid BAR retries the unanswered request").within(0.02));
    }
    return test.once(on("ap.wlan[0].mac").signal("packetSentToLower").filterEvent(isBa)
        .describe("valid BAR still obtains Basic feedback").within(0.01));
}
Define_ProtocolTest(wifi_block_ack_reserved_type) { return wireTypeProgram(true); }
Define_ProtocolTest(wifi_block_ack_wire_control) { return wireTypeProgram(false); }
}

%file: BlockAckWireType.ned
import inet.protocoltest.wifi.WifiInfraNetwork;
network BlockAckWireTypeNetwork extends WifiInfraNetwork {
    parameters:
        int barType;
}

%inifile: test.ini
[General]
network = BlockAckWireTypeNetwork
*.barType = ${type=4,12,0}
*.tester.testName = ${type} == 0 ? "wifi_block_ack_wire_control" : "wifi_block_ack_reserved_type"
*.radioMedium.typename = "Ieee80211ScalarTapRadioMedium"
*.sta1.app[0].sendInterval = 0.1ms
*.sta1.app[0].stopTime = 1.02s
**.originatorMacDataService.msduAggregationPolicy.typename = ""
sim-time-limit = 1.1s
include ../../ini/_blockackLifecycle.ini

%contains: stdout
PROTOCOLTEST wifi_block_ack_reserved_type: PASS
%contains: stdout
PROTOCOLTEST wifi_block_ack_wire_control: PASS
%not-contains: stdout
PROTOCOLTEST wifi_block_ack_reserved_type: FAIL
%not-contains: stdout
PROTOCOLTEST wifi_block_ack_wire_control: FAIL
