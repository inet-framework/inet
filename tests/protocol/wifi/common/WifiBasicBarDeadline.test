%description:
An incomplete Basic Block Ack batch reaches the default 20 ms deadline without further arrivals.

%file: BasicBarDeadline.cc
#include "BlockAckLifecycleTestSupport.h"
#include "inet/physicallayer/wireless/ieee80211/mode/IIeee80211Mode.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

namespace inet::protocoltest {
Define_ProtocolTest(wifi_basic_bar_deadline)
{
    return ProtocolTest("wifi_basic_bar_deadline")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
            .filterEvent([](const MatchContext& context) {
                auto data = dynamicPtrCast<const Ieee80211DataHeader>(context.event.packet->peekAtFront<Ieee80211MacHeader>());
                return data && data->getAckPolicy() == BLOCK_ACK;
            })
            .capture("deadline", [](const PacketEvent& event) {
                auto mode = event.packet->getTag<physicallayer::Ieee80211ModeReq>()->getMode();
                return cValue((event.time + mode->getDuration(event.packet->getDataLength()) + SimTime(20, SIMTIME_MS)).dbl());
            })
            .describe("one DATA MPDU begins the outstanding Basic batch").within(1.02))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
            .filterPacket("has(Ieee80211BasicBlockAckReq)")
            .assertEvent([](const MatchContext& context) {
                auto afterDeadline = context.event.time - SimTime(context.get("deadline").doubleValue());
                return afterDeadline >= SimTime(-2, SIMTIME_NS) && afterDeadline < SimTime(5, SIMTIME_MS);
            })
            .describe("the deadline starts contention for BAR").within(0.035))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
            .filterPacket("has(Ieee80211BasicBlockAck)").describe("the recipient replies with Block Ack").within(0.002));
}
}

%inifile: test.ini
[General]
*.tester.testName = "wifi_basic_bar_deadline"
*.sta1.wlan[*].mac.hcf.basicBlockAckReqMaxDelay = 20ms
*.sta1.app[0].sendInterval = 0.1ms
*.sta1.app[0].stopTime = 1.00016s
**.hcf.edca.edcaf[*].txopProcedure.txopLimit = 4ms
**.hcf.rtsPolicy.rtsThreshold = 100B
sim-time-limit = 1.1s
include ../../ini/_blockackLifecycle.ini

%contains: stdout
PROTOCOLTEST wifi_basic_bar_deadline: PASS
