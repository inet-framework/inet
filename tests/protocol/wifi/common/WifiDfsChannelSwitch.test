%# expected-result: FAIL
%description:
Observe the specific management action for WifiDfsChannelSwitch. Match the generic action
wire representation, not a nonexistent specialized C++ chunk. See the Wi-Fi audit
evidence for the missing feature and stimulus limitations.

%file: WifiDfsChannelSwitch.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_dfs_channel_switch)
{
    return ProtocolTest("wifi_dfs_channel_switch")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isManagementAction(c.event, 0, 4); })
                  .describe("a Channel Switch Announcement action frame from AP").within(2.0));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_dfs_channel_switch"
include ../../ini/_ac.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_dfs_channel_switch: PASS
