%# expected-result: FAIL
%description:
Observe the specific management action for WifiQosAddts. Match the generic action
wire representation, not a nonexistent specialized C++ chunk. See the Wi-Fi audit
evidence for the missing feature and stimulus limitations.

%file: WifiQosAddts.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_qos_addts)
{
    return ProtocolTest("wifi_qos_addts")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isManagementAction(c.event, 1, 0); })
                  .describe("an ADDTS Request action frame from STA").within(2.0));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_qos_addts"
include ../../ini/_ac.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_qos_addts: PASS
