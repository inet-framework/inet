%description:
RTS/CTS opens an EDCA Basic burst.
DATA continues after its BAR and Block Ack when the actual successor is reserved.

%extraargs: -r 0..1

%file: BasicPostBarContinuation.cc
#include "BlockAckLifecycleTestSupport.h"
#include "inet/physicallayer/wireless/ieee80211/mode/IIeee80211Mode.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

namespace inet::protocoltest {
static ProtocolTest protectedContinuation(const char *name)
{
    auto blockAckData = [] {
        return on("sta1.wlan[0].mac").signal("packetSentToLower").filterEvent([](const MatchContext& context) {
            auto header = dynamicPtrCast<const Ieee80211DataHeader>(context.event.packet->peekAtFront<Ieee80211MacHeader>());
            return header && header->getAckPolicy() == BLOCK_ACK;
        });
    };
    return ProtocolTest(name)
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
            .filterPacket("has(Ieee80211AddbaResponse)").describe("the station obtains a Basic agreement").within(1.02))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
            .filterEvent([](const MatchContext& context) {
                auto header = context.event.packet->peekAtFront<Ieee80211MacHeader>();
                return header->getType() == ST_RTS || header->getType() == ST_DATA_WITH_QOS;
            }).assertPacket("has(Ieee80211RtsFrame)").describe("the first opening frame is RTS").within(0.01))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
            .filterPacket("has(Ieee80211CtsFrame)").describe("the station receives CTS").within(0.001))
        .once(blockAckData().capture("expectedBar", [](const PacketEvent& event) {
            auto mode = event.packet->getTag<physicallayer::Ieee80211ModeReq>()->getMode();
            return cValue((event.time + mode->getDuration(event.packet->getDataLength()) + mode->getSifsTime()).dbl());
        }).describe("the opening DATA uses Basic Block Ack").within(0.001))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
            .filterPacket("has(Ieee80211BasicBlockAckReq)")
            .assertEvent([](const MatchContext& context) {
                auto delta = context.event.time - SimTime(context.get("expectedBar").doubleValue());
                return delta >= SimTime(-2, SIMTIME_NS) && delta <= SimTime(2, SIMTIME_NS);
            })
            .describe("BAR follows DATA after SIFS").within(0.001))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
            .filterPacket("has(Ieee80211BasicBlockAck)").describe("the station receives Block Ack").within(0.001))
        .once(blockAckData().describe("the eager successor transmits after the reply and SIFS").within(0.00003));
}

Define_ProtocolTest(wifi_basic_post_bar_continuation)
{
    return protectedContinuation("wifi_basic_post_bar_continuation");
}

Define_ProtocolTest(wifi_basic_post_bar_continuation_default_rts)
{
    return protectedContinuation("wifi_basic_post_bar_continuation_default_rts");
}
}

%inifile: test.ini
[General]
*.tester.testName = ${threshold=100B,2346B} == 100B ? "wifi_basic_post_bar_continuation" : "wifi_basic_post_bar_continuation_default_rts"
*.sta1.app[0].sendInterval = 0.1ms
*.sta1.app[0].stopTime = 1.003s
**.hcf.edca.edcaf[*].txopProcedure.txopLimit = 4ms
**.hcf.rtsPolicy.rtsThreshold = ${threshold}
**.hcf.originatorAckPolicy.blockAckReqThreshold = 1
sim-time-limit = 1.1s
include ../../ini/_blockackLifecycle.ini

%contains: stdout
PROTOCOLTEST wifi_basic_post_bar_continuation: PASS

%contains: stdout
PROTOCOLTEST wifi_basic_post_bar_continuation_default_rts: PASS
