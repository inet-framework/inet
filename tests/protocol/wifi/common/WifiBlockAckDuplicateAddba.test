%description:
Production ADDBA setup with one lost request ACK. The recipient must acknowledge the retry of the request without a second agreement dispatch. Then the ADDBA Response reaches the originator, and the originator sends DATA with the Block Ack policy.

The radio medium drops the ACK of the original ADDBA Request for sta1 only; sta2 still decodes it, which shows that the AP sent it. sta1 then retransmits the request with the Retry bit, and the AP must treat the retry as a duplicate. The MAC removes a management duplicate without a signal, so the test observes the dispatch through its effect: each dispatch sends an ADDBA Response, and a second dispatch would send a second one, with a failure status, because the agreement already exists.

The AP must receive the retry before it sends its response. Management frames use AC_VO, and the ini sets the AIFSN of AC_VO at the AP to 15. So the AP starts its response at the earliest 2 SIFS + ACK + 15 slots after the request. sta1 starts its retry at the latest 2 SIFS + 10 slots + the PHY receive start delay after the request, with a contention window of 7 slots after the first failure. If the AP sent its response first, it would send no second one after the retry, and the step that waits for the response after the retry would miss its deadline.

%file: DuplicateAddba.cc
#include "BlockAckLifecycleTestSupport.h"

namespace inet::protocoltest {
using namespace ieee80211;

static cValue sequenceOf(const PacketEvent& e) { return cValue(e.packet->peekAtFront<Ieee80211AddbaRequest>()->getSequenceNumber().get()); }
static cValue transmitterOf(const PacketEvent& e) { return cValue((intval_t)e.packet->peekAtFront<Ieee80211AddbaRequest>()->getTransmitterAddress().getInt()); }

Define_ProtocolTest(wifi_block_ack_duplicate_addba)
{
    return ProtocolTest("wifi_block_ack_duplicate_addba")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("has(Ieee80211AddbaRequest) && Ieee80211AddbaRequest.retry == false")
                  .capture("token", "Ieee80211AddbaRequest.dialogToken")
                  .capture("tid", "Ieee80211AddbaRequest.tid")
                  .capture("seq", sequenceOf)
                  .capture("sta1", transmitterOf)
                  .describe("the original ADDBA Request").within(1.2))
        .meanwhile(tap("radioMedium").to("sta1").filterPacket("ieee80211mac.type == 29 && ieee80211mac.receiverAddress.getInt() == {sta1}").nth(1).drop()
                     .describe("the ACK of the original request, for sta1 only"))
        .meanwhile(exactlyTimes(1, on("ap.wlan[0].mac").signal("packetSentToLower")
                                    .filterPacket("has(Ieee80211AddbaResponse) && Ieee80211AddbaResponse.retry == false")
                                    .describe("an ADDBA Response, so a dispatch").within(0.02)))
        .meanwhile(never(on("ap.wlan[0].mac").signal("packetSentToLower")
                             .filterPacket("has(Ieee80211AddbaResponse) && Ieee80211AddbaResponse.statusCode != 0")
                             .describe("an ADDBA Response that refuses a second agreement").within(0.02)))
        .once(on("sta2.wlan[0].radio").signal("packetSentToUpper")
                  .filterPacket("ieee80211mac.type == 29 && ieee80211mac.receiverAddress.getInt() == {sta1}")
                  .describe("the first request ACK is on the air: sta2 decodes it").within(0.001))
        .once(on("ap.wlan[0].mac").signal("packetReceivedFromLower").filterPacket("has(Ieee80211AddbaRequest)")
                  .assertPacket("Ieee80211AddbaRequest.retry == true && Ieee80211AddbaRequest.dialogToken == {token}"
                                " && Ieee80211AddbaRequest.tid == {tid}")
                  .assertEvent([](const MatchContext& c) {
                      return sequenceOf(c.event).intValue() == c.get("seq").intValue() &&
                             transmitterOf(c.event).intValue() == c.get("sta1").intValue();
                  })
                  .describe("the retry of the same request at the AP").within(0.01))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("ieee80211mac.type == 29 && ieee80211mac.receiverAddress.getInt() == {sta1}")
                  .describe("the ACK of the retry at sta1").within(0.001))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower").filterPacket("has(Ieee80211AddbaResponse)")
                  .describe("the ADDBA Response, after the retry").within(0.01))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) {
                      auto data = dynamicPtrCast<const Ieee80211DataHeader>(c.event.packet->peekAtFront<Ieee80211MacHeader>());
                      return data && data->getAckPolicy() == BLOCK_ACK;
                  })
                  .describe("DATA with the Block Ack policy").within(0.02));
}
}

%inifile: test.ini
[General]
*.tester.testName = "wifi_block_ack_duplicate_addba"
*.radioMedium.typename = "Ieee80211ScalarTapRadioMedium"
# The ADDBA Response of the AP waits AIFS = SIFS + 15 slots, so the retry of sta1 starts
# first, and the AP receives the retry while its response is still in its queue.
*.ap.wlan[*].mac.hcf.edca.edcaf[3].aifsn = 15
*.sta1.app[0].sendInterval = 0.1ms
*.sta1.app[0].stopTime = 1.02s
sim-time-limit = 1.1s
include ../../ini/_blockackLifecycle.ini

%contains: stdout
PROTOCOLTEST wifi_block_ack_duplicate_addba: PASS
