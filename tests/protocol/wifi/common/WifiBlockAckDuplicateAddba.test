%description:
Production ADDBA setup encounters one lost request ACK and a held response queue.
The recipient must acknowledge the request retry without a second agreement dispatch.
The response hold ends after retry reception. Setup and Block Ack-policy DATA must follow.
The dispatch observer calls the production handler unchanged. All frames cross the radio.

%file: DuplicateAddba.cc
#include <set>
#include "BlockAckLifecycleTestSupport.h"

namespace inet::protocoltest {
class DuplicateAddbaMac : public Ieee80211Mac
{
    bool requestSent = false;
  public:
    int suppressed = 0;
  protected:
    void sendDownFrame(Packet *frame) override {
        if (dynamicPtrCast<const Ieee80211AddbaRequest>(frame->peekAtFront<Ieee80211MacHeader>()))
            requestSent = true;
        Ieee80211Mac::sendDownFrame(frame);
    }
    void handleLowerPacket(Packet *frame) override {
        auto header = frame->peekAtFront<Ieee80211MacHeader>();
        if (requestSent && suppressed == 0 && header->getType() == ST_ACK && header->getReceiverAddress() == mib->address) {
            suppressed++;
            emit(registerSignal("requestAckSuppressed"), 1L);
            delete frame;
        }
        else
            Ieee80211Mac::handleLowerPacket(frame);
    }
};
Define_Module(DuplicateAddbaMac);

class DuplicateAddbaHcf : public BlockAckLifecycleHcf
{
    Ptr<const Ieee80211AddbaRequest> original;
    int received = 0;
    int transmittedRequestAcks = 0;
    std::set<msgid_t> requestAckTreeIds;
    cMessage *release = nullptr;
  public:
    int dispatches = 0;
    int requestAcks = 0;
    bool responseHeld = false;
    ~DuplicateAddbaHcf() { cancelAndDelete(release); }
  protected:
    void processMgmtFrame(Packet *frame, const Ptr<const Ieee80211MgmtHeader>& header) override {
        if (dynamicPtrCast<const Ieee80211AddbaResponse>(header) && !responseHeld) {
            responseHeld = true;
            rx->setContentionBlocked(true);
        }
        Hcf::processMgmtFrame(frame, header);
    }
    void recipientProcessReceivedManagementFrame(const Ptr<const Ieee80211MgmtHeader>& header) override {
        if (dynamicPtrCast<const Ieee80211AddbaRequest>(header))
            dispatches++;
        Hcf::recipientProcessReceivedManagementFrame(header);
    }
    void transmitControlResponseFrame(Packet *response, const Ptr<const Ieee80211MacHeader>& responseHeader,
            Packet *receivedFrame, const Ptr<const Ieee80211MacHeader>& receivedHeader) override {
        if (dynamicPtrCast<const Ieee80211AddbaRequest>(receivedHeader) && responseHeader->getType() == ST_ACK) {
            requestAcks++;
            requestAckTreeIds.insert(response->getTreeId());
        }
        Hcf::transmitControlResponseFrame(response, responseHeader, receivedFrame, receivedHeader);
    }
    void processLowerFrame(Packet *frame, const Ptr<const Ieee80211MacHeader>& header) override {
        Enter_Method("processLowerFrame");
        auto request = dynamicPtrCast<const Ieee80211AddbaRequest>(header);
        Hcf::processLowerFrame(frame, header);
        if (request) {
            received++;
            if (received == 1) {
                ASSERT(!request->getRetry());
                original = request;
            }
            else {
                ASSERT(request->getRetry());
                ASSERT(request->getTransmitterAddress() == original->getTransmitterAddress());
                ASSERT(request->getReceiverAddress() == original->getReceiverAddress());
                ASSERT(request->getTid() == original->getTid());
                ASSERT(request->getDialogToken() == original->getDialogToken());
                ASSERT(request->getSequenceNumber() == original->getSequenceNumber());
                ASSERT(request->getFragmentNumber() == original->getFragmentNumber());
                ASSERT(release == nullptr);
                release = new cMessage("release-response");
                scheduleAfter(SimTime(1, SIMTIME_MS), release);
            }
            std::cout << "ADDBA reception at " << simTime() << ": received=" << received
                << ", dispatches=" << dispatches << ", ACK submissions=" << requestAcks << ".\n";
            emit(registerSignal("addbaReception"), long(received));
        }
    }
    void recipientProcessTransmittedControlResponseFrame(Packet *frame, const Ptr<const Ieee80211MacHeader>& header) override {
        if (header->getType() == ST_ACK && requestAckTreeIds.erase(frame->getTreeId()) != 0)
            transmittedRequestAcks++;
        Hcf::recipientProcessTransmittedControlResponseFrame(frame, header);
    }
    void handleMessage(cMessage *message) override {
        if (message == release) {
            delete release;
            release = nullptr;
            rx->setContentionBlocked(false);
            emit(registerSignal("requestAcksTransmitted"), long(transmittedRequestAcks));
            emit(registerSignal("responseReleased"), 1L);
        }
        else
            Hcf::handleMessage(message);
    }
};
Define_Module(DuplicateAddbaHcf);

Define_ProtocolTest(wifi_block_ack_duplicate_addba)
{
    return ProtocolTest("wifi_block_ack_duplicate_addba")
        .once(on("ap.wlan[0].mac.hcf").signal("addbaReception").filterValue(1)
            .describe("original ADDBA Request received").within(1.2))
        .once(on("sta1.wlan[0].mac").signal("requestAckSuppressed").filterValue(1)
            .describe("request ACK deliberately lost").within(0.01))
        .once(on("ap.wlan[0].mac.hcf").signal("addbaReception").filterValue(2)
            .assertEvent([](const MatchContext& c) {
                auto hcf = check_and_cast<DuplicateAddbaHcf *>(c.event.module);
                return hcf->dispatches == 1 && hcf->requestAcks == 2 && hcf->responseHeld;
            }).describe("retry acknowledged without duplicate agreement dispatch").within(0.01))
        .once(on("ap.wlan[0].mac.hcf").signal("requestAcksTransmitted").assertValue(2)
            .describe("both request ACKs completed physical transmission").within(0.01))
        .once(on("ap.wlan[0].mac.hcf").signal("responseReleased").filterValue(1)
            .describe("actual response queue released").within(0.01))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
            .filterEvent([](const MatchContext& c) {
                return dynamicPtrCast<const Ieee80211AddbaResponse>(c.event.packet->peekAtFront<Ieee80211MacHeader>()) != nullptr;
            }).describe("ADDBA Response received through the radio").within(0.01))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
            .filterEvent([](const MatchContext& c) {
                auto data = dynamicPtrCast<const Ieee80211DataHeader>(c.event.packet->peekAtFront<Ieee80211MacHeader>());
                return data && data->getAckPolicy() == BLOCK_ACK;
            }).assertEvent([](const MatchContext& c) {
                auto network = c.event.node->getParentModule();
                return lifecycleHcf(network, "sta1")->hasOriginator(MacAddress("02:00:00:00:00:01"), 6);
            }).describe("DATA uses the accepted agreement").within(0.02));
}
}

%file: DuplicateAddba.ned
@namespace(inet::protocoltest);
import inet.linklayer.ieee80211.mac.Ieee80211Mac;
import inet.protocoltest.wifi.BlockAckLifecycleHcf;
module DuplicateAddbaMac extends Ieee80211Mac {
    parameters:
        @class(DuplicateAddbaMac);
        @signal[requestAckSuppressed](type=long);
}
module DuplicateAddbaHcf extends BlockAckLifecycleHcf {
    parameters:
        @class(DuplicateAddbaHcf);
        @signal[addbaReception](type=long);
        @signal[responseReleased](type=long);
        @signal[requestAcksTransmitted](type=long);
}

%inifile: test.ini
[General]
*.tester.testName = "wifi_block_ack_duplicate_addba"
*.sta1.wlan[*].mac.typename = "DuplicateAddbaMac"
*.ap.wlan[*].mac.hcf.typename = "DuplicateAddbaHcf"
*.sta1.app[0].sendInterval = 0.1ms
*.sta1.app[0].stopTime = 1.02s
sim-time-limit = 1.1s
include ../../ini/_blockackLifecycle.ini

%contains: stdout
PROTOCOLTEST wifi_block_ack_duplicate_addba: PASS
