%description:
Testability gap: The MAC header exposes no HT Control RDG field; a reverse-direction grant cannot be observed.
This explicit failure is not a measurement of protocol behavior.

%file: N_ReverseDirection.cc

#include "ProtocolTest.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11n_reverse_direction)
{
    return ProtocolTest("wifi_11n_reverse_direction")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 40")
                  .assertEvent([](const MatchContext&) -> bool {
                      throw cRuntimeError("TESTABILITY GAP: The MAC header exposes no HT Control RDG field; a reverse-direction grant cannot be observed");
                  })
                  .describe("QoS data frame with HT Control RD Grant bit").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11n_reverse_direction"
include ../../ini/_n.ini
**.wlan[*].radio.receiver.energyDetection = -105dBm
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11n_reverse_direction: PASS
