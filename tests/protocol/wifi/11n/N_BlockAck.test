%description:
802.11n Block Ack session: ADDBA action (type 13), BlockAckReq (type 24), BlockAck (type 25). [Required]
Check explicit Basic, explicit Compressed, and the NED default with concrete BAR/BA types and positive receipt bits.
The third run uses the unquoted INI keyword default. OMNeT++ accepts the parameter's NED default for this keyword.

%extraargs: -r 0..2

%postrun-command: python3 check-default.py

%file: N_BlockAck.cc

#include "ProtocolTest.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"

namespace inet {
namespace protocoltest {

using namespace inet::ieee80211;

// Block Ack session flow: STA sends ADDBA Request (action frame, type 13),
// AP responds with ADDBA Response (type 13), then after enough frames are
// queued, STA sends BlockAckReq (type 24) and AP sends BlockAck (type 25).
Define_ProtocolTest(wifi_11n_block_ack)
{
    return ProtocolTest("wifi_11n_block_ack")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 13")
                  .describe("ADDBA action frame from sta1").within(2.5))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 24")
                  .filterEvent([](const MatchContext& c) {
                      return c.event.packet && c.event.packet->peekAtFront<Ieee80211BasicBlockAckReq>(b(-1), Chunk::PF_ALLOW_NULLPTR);
                  })
                  .describe("BlockAckReq from sta1").within(1.0))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("ieee80211mac.type == 25")
                  .filterEvent([](const MatchContext& c) {
                      if (!c.event.packet) return false;
                      auto ba = c.event.packet->peekAtFront<Ieee80211BasicBlockAck>(b(-1), Chunk::PF_ALLOW_NULLPTR);
                      if (!ba) return false;
                      for (int i = 0; i < 64; i++)
                          for (unsigned int j = 0; j < ba->getBlockAckBitmap(i).getSize(); j++)
                              if (ba->getBlockAckBitmap(i).getBit(j)) return true;
                      return false;
                  })
                  .describe("BlockAck received at sta1").within(0.02));
}

Define_ProtocolTest(wifi_11n_compressed_exchange)
{
    return ProtocolTest("wifi_11n_compressed_exchange")
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("ieee80211mac.type == 13")
                  .filterEvent([](const MatchContext& c) {
                      if (!c.event.packet) return false;
                      auto response = c.event.packet->peekAtFront<Ieee80211AddbaResponse>(b(-1), Chunk::PF_ALLOW_NULLPTR);
                      return response && response->getStatusCode() == 0 && response->getBlockAckPolicy();
                  })
                  .describe("successful immediate ADDBA response").within(2.5))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 24")
                  .filterEvent([](const MatchContext& c) {
                      return c.event.packet && c.event.packet->peekAtFront<Ieee80211CompressedBlockAckReq>(b(-1), Chunk::PF_ALLOW_NULLPTR);
                  })
                  .describe("Compressed BAR from sta1").within(1.0))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("ieee80211mac.type == 25")
                  .filterEvent([](const MatchContext& c) {
                      if (!c.event.packet) return false;
                      auto ba = c.event.packet->peekAtFront<Ieee80211CompressedBlockAck>(b(-1), Chunk::PF_ALLOW_NULLPTR);
                      if (!ba) return false;
                      for (unsigned int i = 0; i < ba->getBlockAckBitmap().getSize(); i++)
                          if (ba->getBlockAckBitmap().getBit(i)) return true;
                      return false;
                  })
                  .describe("Compressed Block Ack with positive receipt evidence").within(0.02));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = ${test="wifi_11n_block_ack","wifi_11n_compressed_exchange","wifi_11n_compressed_exchange"}
*.sta*.wlan[*].mac.hcf.isBlockAckSupported = true
**.wlan[*].mac.hcf.blockAckVariant = ${profile="basic","compressed",default ! test}
*.ap.wlan[*].mac.hcf.isBlockAckSupported = true
*.sta*.wlan[*].mac.hcf.originatorAckPolicy.blockAckReqThreshold = 5
*.sta1.app[0].sendInterval = 0.1ms
include ../../ini/_n.ini
include ../../ini/_base.ini
# Override radio settings after base.ini (last value wins in omnetpp ini):
**.wlan[*].radio.receiver.energyDetection = -105dBm
**.wlan[*].radio.receiver.sensitivity = -105dBm
**.wlan[*].radio.receiver.snirThreshold = 0dB
**.wlan[*].radio.transmitter.power = 0.12mW
**.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 10000B
**.hcf.originatorMacDataService.msduAggregationPolicy.subframeNumThreshold = 100
**.hcf.originatorMacDataService.msduAggregationPolicy.aggregationLengthThreshold = 10000
*.sta*.wlan[*].mac.hcf.originatorAckPolicy.maxBlockAckPolicyFrameLength = 10000B

%file: check-default.py
from pathlib import Path
import re

runs = re.split(r"Preparing for running configuration General, run #\d+\.\.\.", Path("test.out").read_text())[1:]
assert len(runs) == 3, len(runs)
for run, profile in zip(runs, ["basic", "compressed", "default"]):
    assert f'$profile={profile if profile == "default" else chr(34) + profile + chr(34)}' in run
    resolved = "basic" if profile == "basic" else "compressed"
    assert run.count(f"Block Ack profile: {resolved}") == 3
    test = "wifi_11n_block_ack" if profile == "basic" else "wifi_11n_compressed_exchange"
    assert f"PROTOCOLTEST {test}: PASS" in run
print("Basic, explicit Compressed, and NED default exchanges passed.")

%contains: stdout
PROTOCOLTEST wifi_11n_block_ack: PASS

%contains: stdout
PROTOCOLTEST wifi_11n_compressed_exchange: PASS
