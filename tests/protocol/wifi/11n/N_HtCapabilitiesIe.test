%description:
Observe the production Ieee80211AssociationRequestFrame and assert its HtCapabilities element is present.
The element is represented inside the management body, not as a standalone chunk.

%file: N_HtCapabilitiesIe.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11n_ht_capabilities_ie)
{
    return ProtocolTest("wifi_11n_ht_capabilities_ie")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 0")
                  .assertEvent([](const MatchContext& c) {
                      auto body = managementBody<ieee80211::Ieee80211AssociationRequestFrame>(c.event);
                      return body != nullptr && body->getHtCapabilitiesPresent();
                  })
                  .describe("an Association Request containing HT Capabilities IE").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11n_ht_capabilities_ie"
include ../../ini/_n.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11n_ht_capabilities_ie: PASS
