%# expected-result: FAIL
%description:
Expected failure by explicit maintainer decision: defer this nontrivial repair to future work.
Repair requires resolving greenfield mode selection/cache identity and transmitter/receiver integration.
Evidence and deferred-repair decision: doc/project/evidence/model/wifi/results.md#deferred-repair-expectations.
This declaration records unresolved work, not supported behavior.

Observe an HT greenfield transmission. PHY construction and timing code exist,
but the built-in mode set selects mixed preambles. This exposes an integration gap.

%file: N_Greenfield.cc

#include "ProtocolTest.h"
#include "WifiTestSupport.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HtMode.h"

namespace inet {
namespace protocoltest {

using namespace inet::physicallayer;

Define_ProtocolTest(wifi_11n_greenfield)
{
    return ProtocolTest("wifi_11n_greenfield")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 40")
                  .filterEvent([](const MatchContext& c) {
                      auto m = dynamic_cast<const Ieee80211HtMode *>(txMode(c.event));
                      return m != nullptr &&
                             m->getPreambleMode()->getPreambleFormat() ==
                                 Ieee80211HtPreambleMode::HT_PREAMBLE_GREENFIELD;
                  })
                  .describe("QoS data frame with HT greenfield preamble").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11n_greenfield"
include ../../ini/_n.ini
**.wlan[*].radio.receiver.energyDetection = -105dBm
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11n_greenfield: PASS
