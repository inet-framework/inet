%# expected-result: FAIL
%description:
Expected failure by explicit maintainer decision: defer this nontrivial repair to future work.
Repair requires production QoS aggregation selection, transmission, receive integration, and Block Ack progress.
Evidence and deferred-repair decision: doc/project/evidence/model/wifi/results.md#deferred-repair-expectations.
This declaration records unresolved work, not supported behavior.

Observe an HT A-MPDU subframe. Aggregation construction exists, but the production
originator invocation is commented out and the default policy never aggregates.

%file: N_Ampdu.cc

#include "ProtocolTest.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11n_ampdu)
{
    return ProtocolTest("wifi_11n_ampdu")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("Ieee80211MpduSubframeHeader.length >= 0")
                  .describe("a frame containing an A-MPDU subframe header").within(2.0));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11n_ampdu"
*.sta*.wlan[*].mac.hcf.isBlockAckSupported = true
*.ap.wlan[*].mac.hcf.isBlockAckSupported = true
*.sta1.app[0].sendInterval = 0.1ms
include ../../ini/_n.ini
**.wlan[*].radio.receiver.energyDetection = -105dBm
**.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 10000B
**.hcf.originatorMacDataService.msduAggregationPolicy.subframeNumThreshold = 2
**.hcf.originatorMacDataService.msduAggregationPolicy.aggregationLengthThreshold = 100
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11n_ampdu: PASS
