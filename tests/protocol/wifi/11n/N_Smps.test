%# expected-result: FAIL
%description:
Observe the specific management action for N_Smps. Match the generic action
wire representation, not a nonexistent specialized C++ chunk. See the Wi-Fi audit
evidence for the missing feature and stimulus limitations.

%file: N_Smps.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11n_smps)
{
    return ProtocolTest("wifi_11n_smps")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isManagementAction(c.event, 7, 1); })
                  .describe("an SM Power Save action frame from sta1").within(2.0));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11n_smps"
include ../../ini/_n.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11n_smps: PASS
