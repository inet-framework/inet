%description:
Observe the production Ieee80211BeaconFrame and assert its HtOperation element is present.
The element is represented inside the management body, not as a standalone chunk.

%file: N_HtOperationIe.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11n_ht_operation_ie)
{
    return ProtocolTest("wifi_11n_ht_operation_ie")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 8")
                  .assertEvent([](const MatchContext& c) {
                      auto body = managementBody<ieee80211::Ieee80211BeaconFrame>(c.event);
                      return body != nullptr && body->getHtOperationPresent();
                  })
                  .describe("a Beacon frame containing HT Operation IE").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11n_ht_operation_ie"
include ../../ini/_n.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11n_ht_operation_ie: PASS
