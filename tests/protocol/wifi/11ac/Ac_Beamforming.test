%# expected-result: FAIL
%description:
Observe an NDP Announcement control frame (subtype 5, INET type 0x15).
This is a necessary sounding-frame probe, not proof of beamforming gain or feedback.

%file: Ac_Beamforming.cc

#include "ProtocolTest.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11ac_beamforming)
{
    return ProtocolTest("wifi_11ac_beamforming")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 21")
                  .describe("a VHT NDP Announcement action frame from sta1").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11ac_beamforming"
include ../../ini/_ac.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11ac_beamforming: PASS
