%# expected-result: FAIL
%description:
Expected failure by explicit maintainer decision: defer this nontrivial repair to future work.
Repair requires coordinated per-TID agreement, request/response, serializer, and acknowledgement bookkeeping.
Evidence and deferred-repair decision: doc/project/evidence/model/wifi/results.md#deferred-repair-expectations.
This declaration records unresolved work, not supported behavior.

Send two classified flows (TIDs 0 and 5), then observe a Multi-TID Block Ack.
Frame declarations exist, but the variant is unfinished and rejected by production handlers.

%file: Ac_MultiTidBa.cc

#include "ProtocolTest.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"

namespace inet {
namespace protocoltest {

using namespace inet::ieee80211;

Define_ProtocolTest(wifi_11ac_multi_tid_ba)
{
    return ProtocolTest("wifi_11ac_multi_tid_ba")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("Ieee80211DataHeader.tid == 0")
                  .describe("BE flow reaches the MAC with TID 0").within(2.5))
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("Ieee80211DataHeader.tid == 5")
                  .describe("VI flow reaches the MAC with TID 5").within(0.5))
        .once(on("sta1.wlan[0].mac").signal("packetReceivedFromLower")
                  .filterEvent([](const MatchContext& c) {
                      if (!c.event.packet) return false;
                      auto ba = c.event.packet->peekAtFront<Ieee80211MultiTidBlockAck>(b(-1), Chunk::PF_ALLOW_NULLPTR);
                      return ba != nullptr;
                  })
                  .describe("a Multi-TID BlockAck received at sta1").within(1.0));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11ac_multi_tid_ba"
*.sta1.numApps = 2
*.sta1.wlan[*].classifier.udpPortUpMap = "5000 BE 5001 VI"
*.sta1.app[1].typename = "UdpBasicApp"
*.sta1.app[1].destAddresses = "sta2"
*.sta1.app[1].destPort = 5001
*.sta1.app[1].messageLength = 1000B
*.sta1.app[1].startTime = 1s
*.sta1.app[1].sendInterval = 2ms
*.sta2.numApps = 2
*.sta2.app[1].typename = "UdpSink"
*.sta2.app[1].localPort = 5001
*.sta*.wlan[*].mac.hcf.isBlockAckSupported = true
*.ap.wlan[*].mac.hcf.isBlockAckSupported = true
*.sta*.wlan[*].mac.hcf.originatorAckPolicy.blockAckReqThreshold = 5
*.sta1.app[0].sendInterval = 2ms
include ../../ini/_ac.ini
**.wlan[*].radio.receiver.energyDetection = -105dBm
**.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 10000B
**.hcf.originatorMacDataService.msduAggregationPolicy.subframeNumThreshold = 100
**.hcf.originatorMacDataService.msduAggregationPolicy.aggregationLengthThreshold = 10000
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11ac_multi_tid_ba: PASS
