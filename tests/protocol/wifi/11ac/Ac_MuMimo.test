%# expected-result: FAIL
%description:
Expected failure by explicit maintainer decision: defer this nontrivial repair to future work.
Repair requires MU user/group allocation, scheduling, and receiver observations; the current explicit testability assertion must also be replaced.
Evidence and deferred-repair decision: doc/project/evidence/model/wifi/results.md#deferred-repair-expectations.
This declaration records unresolved work, not supported behavior.

Testability gap: The VHT PHY header exposes no group ID or multi-user allocation; MU-MIMO transmission cannot be observed.
This explicit failure is not a measurement of protocol behavior.

%file: Ac_MuMimo.cc

#include "ProtocolTest.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11ac_mu_mimo)
{
    return ProtocolTest("wifi_11ac_mu_mimo")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 40")
                  .assertEvent([](const MatchContext&) -> bool {
                      throw cRuntimeError("TESTABILITY GAP: The VHT PHY header exposes no group ID or multi-user allocation; MU-MIMO transmission cannot be observed");
                  })
                  .describe("an AP MU-MIMO downlink frame").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11ac_mu_mimo"
include ../../ini/_ac.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11ac_mu_mimo: PASS
