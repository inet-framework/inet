%# expected-result: FAIL
%description:
Observe the specific management action for Ac_OpModeNotification. Match the generic action
wire representation, not a nonexistent specialized C++ chunk. See the Wi-Fi audit
evidence for the missing feature and stimulus limitations.

%file: Ac_OpModeNotification.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11ac_opmode_notification)
{
    return ProtocolTest("wifi_11ac_opmode_notification")
        .once(on("sta1.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isManagementAction(c.event, 21, 2); })
                  .describe("a VHT Operating Mode Notification action frame").within(2.0));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11ac_opmode_notification"
include ../../ini/_ac.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11ac_opmode_notification: PASS
