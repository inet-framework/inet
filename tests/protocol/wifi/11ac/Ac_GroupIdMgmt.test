%# expected-result: FAIL
%description:
Observe the specific management action for Ac_GroupIdMgmt. Match the generic action
wire representation, not a nonexistent specialized C++ chunk. See the Wi-Fi audit
evidence for the missing feature and stimulus limitations.

%file: Ac_GroupIdMgmt.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11ac_group_id_mgmt)
{
    return ProtocolTest("wifi_11ac_group_id_mgmt")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isManagementAction(c.event, 21, 1); })
                  .describe("a VHT Group ID Management action frame from AP").within(2.0));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11ac_group_id_mgmt"
include ../../ini/_ac.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11ac_group_id_mgmt: PASS
