%# expected-result: FAIL
%description:
Observe a Beacon containing VHT Operation (element ID 192) in its management body.
This checks element presence, not VHT Capabilities or the completeness of VHT negotiation.

%file: Ac_VhtIe.cc

#include "WifiTestSupport.h"

namespace inet {
namespace protocoltest {

Define_ProtocolTest(wifi_11ac_vht_ie)
{
    return ProtocolTest("wifi_11ac_vht_ie")
        .once(on("ap.wlan[0].mac").signal("packetSentToLower")
                  .filterPacket("ieee80211mac.type == 8")
                  .filterEvent([](const MatchContext& c) { return hasManagementElement(c.event, 192); })
                  .describe("a Beacon frame containing VHT Operation IE").within(2.5));
}

} // namespace protocoltest
} // namespace inet

%inifile: test.ini

[General]
*.tester.testName = "wifi_11ac_vht_ie"
include ../../ini/_ac.ini
include ../../ini/_base.ini

%contains: stdout
PROTOCOLTEST wifi_11ac_vht_ie: PASS
