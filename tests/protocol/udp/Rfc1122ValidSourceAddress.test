%description:

RFC 1122 — the source address of a datagram a host sends is one of the addresses of that
host.

Checks RFC1122-UADDR-2 (must) from doc/project/evidence/standard/rfc1122/catalog.md. The
English procedure is in
doc/project/evidence/protocol/udp/checks/delivery.md#valid-source-address; the program steps
below map onto its expected observations. Mapping of the mockup with two links at the
sender: host A = hostA, host B = hostB, host D = hostD.

Host A has two interfaces with a different address on each. No program names a source
address, so the host chooses one itself, and the rule says the choice must fall on one of
its own two. The check reads the address on the wire and compares it with both.

Expected result: PASS.

%includes:
#include "ProtocolTest.h"
#include "UdpMutations.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc1122_valid_source_address")
        // Expected observation 1: on link 1, the source address of the datagram is one of the
        // two addresses of host A (RFC1122-UADDR-2).
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5000")
                  .match([](const MatchContext& c) {
                      return isOwnIpv4Address(c.event.node, ipv4Address(c.event.packet, "ipv4.srcAddress"));
                  })
                  .describe("host A's datagram, whose source address is one of host A's own")
                  .within(0.5))
        // Expected observation 2: host B's UDP hands the 100 octets upward, so the datagram was
        // a normal one and not a discarded one.
        .once(on("hostB.udp").signal("packetSentToUpper")
                  .match([](const MatchContext& c) { return c.event.packet->getByteLength() == 100; })
                  .describe("the 100 octets handed up from host B's UDP toward the program")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc1122_valid_source_address compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The mockup with two links at the sender: hostD -- hostA -- hostB.
network Rfc1122TwoLinkNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        hostD: StandardHost { @display("p=200,100"); }
        hostA: StandardHost { @display("p=400,100"); }
        hostB: StandardHost { @display("p=600,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> hostB.ethg++; // link 1 (hostA.eth[0])
        hostD.ethg++ <--> Eth100M <--> hostA.ethg++; // link 3 (hostA.eth[1]), the second address
}

%inifile: omnetpp.ini

[General]
network = Rfc1122TwoLinkNet
sim-time-limit = 1s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
**.ipv4.arp.typename = "GlobalArp"

# Host A: 100 octets to port 5000 of host B. No program names a source address.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 0.1s
*.hostA.app[0].sendInterval = 1s

# Host B: one receiving program, on port 5000.
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST rfc1122_valid_source_address: PASS
