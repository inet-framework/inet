%description:

RFC 1122 — a program names the IP source address of a datagram it sends, and the datagram
carries it.

Checks RFC1122-UMH-2 (must) from doc/project/evidence/standard/rfc1122/catalog.md. The
English procedure is in
doc/project/evidence/protocol/udp/checks/app-interface.md#source-address-from-the-program;
the program steps below map onto its expected observations. Mapping of the mockup with two
links at the sender: host A = hostA, host B = hostB, host D = hostD.

Host A has two interfaces. The sending program names the address of the interface on
link 3, which is not the path to host B, and the datagram still leaves on link 1. The
program names the address that the host would not choose by itself, so that the check can
tell obedience from chance. The scenario fixes the four addresses, so that the program can
name one of them and the check can compare against it.

Both addresses belong to host A, so the datagram also obeys RFC1122-UADDR-2; the two checks
do not conflict.

Expected result: PASS.

%includes:
#include "ProtocolTest.h"
#include "UdpMutations.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc1122_application_source_address")
        // Expected observation 1: on link 1 the datagram carries the source address the program
        // named, which is the address of host A's second interface (RFC1122-UMH-2).
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("udp.destPort == 5000")
                  .match([](const MatchContext& c) { return ipv4Address(c.event.packet, "ipv4.srcAddress") == "10.0.3.1"; })
                  .describe("host A's datagram, whose source is the address of its second interface")
                  .within(0.5))
        // Expected observation 2: host B's UDP hands the 100 octets upward.
        .once(on("hostB.udp").signal("packetSentToUpper")
                  .match([](const MatchContext& c) { return c.event.packet->getByteLength() == 100; })
                  .describe("the 100 octets handed up from host B's UDP toward the program")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc1122_application_source_address compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The mockup with two links at the sender: hostD -- hostA -- hostB.
network Rfc1122SourceChoiceNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        hostD: StandardHost { @display("p=200,100"); }
        hostA: StandardHost { @display("p=400,100"); }
        hostB: StandardHost { @display("p=600,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> hostB.ethg++; // link 1 (hostA.eth[0])
        hostD.ethg++ <--> Eth100M <--> hostA.ethg++; // link 3 (hostA.eth[1]), the named address
}

%inifile: omnetpp.ini

[General]
network = Rfc1122SourceChoiceNet
sim-time-limit = 1s
seed-set = 0

# Static ARP keeps the wire free of ARP request/reply noise.
**.ipv4.arp.typename = "GlobalArp"

# Fixed addresses, so that the program can name the one on link 3.
*.configurator.config = xml("<config><interface hosts='hostA' towards='hostB' address='10.0.1.1' netmask='255.255.255.0'/><interface hosts='hostB' address='10.0.1.2' netmask='255.255.255.0'/><interface hosts='hostA' towards='hostD' address='10.0.3.1' netmask='255.255.255.0'/><interface hosts='hostD' address='10.0.3.2' netmask='255.255.255.0'/></config>")

# Host A: 100 octets to port 5000, sent from the address of the interface on link 3.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].localAddress = "10.0.3.1"
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 0.1s
*.hostA.app[0].sendInterval = 1s

# Host B: one receiving program, on port 5000.
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST rfc1122_application_source_address: PASS
