%description:

Querier election.

Checks RFC9776-RQRY-5 to RQRY-7, TIMER-10 and RFC2236-ROUTER-11 to ROUTER-13 from
doc/project/evidence/standard/rfc9776/catalog.md and
doc/project/evidence/standard/rfc2236/catalog.md. The English procedure is in
doc/project/evidence/protocol/igmp/checks/router-queries.md#querier-election;
the program steps below map onto its expected observations. The first guard records the last
General Query of R1 before it leaves L1, the second is observation 2; step 1 is observation 1,
and step 2 observation 3.

A node joins or leaves L1 through its link: the ScenarioManager enables or disables the channel
between the node and the switch (the rules of checks.md).

%includes:
#include "ProtocolTest.h"
#include "IgmpChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv4Address G("225.0.1.1"), H("225.0.1.2"), K("225.0.1.3");
static const Ipv4Address S1("10.0.2.10"), S2("10.0.2.11");
static const Ipv4Address R_L1("10.0.1.1"), A_L1("10.0.1.10"), B_L1("10.0.1.11"), C_L1("10.0.1.12");
static const Ipv4Address ALL_SYSTEMS("224.0.0.1"), ALL_ROUTERS("224.0.0.2"), V3_ROUTERS("224.0.0.22");

static std::string num(double v) { std::ostringstream s; s << v; return s.str(); }
static std::set<Ipv4Address> sset(std::initializer_list<Ipv4Address> l) { return std::set<Ipv4Address>(l); }

// A State-Change Report: a Version 3 Report with a Filter-Mode-Change or Source-List-Change record for the group.
static bool isStateChange(const Packet *p, const Ipv4Address& g)
{
    return hasRecordOf(p, g, CHANGE_TO_INCLUDE_MODE) || hasRecordOf(p, g, CHANGE_TO_EXCLUDE_MODE) || hasRecordOf(p, g, ALLOW_NEW_SOURCES) || hasRecordOf(p, g, BLOCK_OLD_SOURCE);
}
// A Current-State Report for the group.
static bool isCurrentState(const Packet *p, const Ipv4Address& g) { return hasRecordOf(p, g, MODE_IS_INCLUDE) || hasRecordOf(p, g, MODE_IS_EXCLUDE); }
// A Query for the group: Group-Specific with no sources, Group-and-Source-Specific with sources.
static bool isGroupQuery(const Packet *p, const Ipv4Address& g) { return isQuery(p) && queryGroup(p) == g && querySources(p) == 0; }
static bool isSourceQuery(const Packet *p, const Ipv4Address& g) { return isQuery(p) && queryGroup(p) == g && querySources(p) > 0; }
static std::set<Ipv4Address> querySourceSet(const Packet *p)
{
    std::set<Ipv4Address> out;
    if (auto q = v3QueryOf(p))
        for (auto& a : q->getSourceList())
            out.insert(a);
    return out;
}
static bool isFwd(const Packet *p, const Ipv4Address& s) { return isDatagram(p, s, G); }
static simtime_t lastR1, heardAt;

Define_ProtocolTestProgram()
{
    lastR1 = -1;
    heardAt = -1;
    return ProtocolTest("rfc9776_querier_election")
        // Records the last General Query of R1 before it leaves L1.
        .meanwhile(never(on("r1.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; if (isGeneralQuery(p) && c.event.time < 100) lastR1 = c.event.time; return false; })
                  .describe("(a recorder of the General Queries of R1)")
                  .within(350.0)))
        // Expected observation 2: from 1 ms after the first Query of R1 until 255 s after the last Query of R1, R2 sends none.
        .meanwhile(never(on("r2.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isGeneralQuery(p) && heardAt >= 0 && c.event.time > heardAt + 0.001 && c.event.time < lastR1 + 255 - 0.1; })
                  .describe("a General Query of R2 while R1 is the querier (RFC9776-RQRY-5, RQRY-6, RFC2236-ROUTER-11, ROUTER-13)")
                  .within(350.0)))
        // Expected observation 1: the General Query of R1 at the start, which R2 hears.
        .once(on("r1.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isGeneralQuery(p); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; heardAt = c.event.time; return true; })
                  .describe("the first General Query of R1")
                  .within(1.0))
        // Expected observation 3: a General Query of R2, 255 s after the last Query of R1.
        .once(on("r2.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isGeneralQuery(p) && c.event.time > 100; })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; simtime_t d = c.event.time - lastR1; return require(d >= 255 - 0.1 && d <= 255 + 0.1, "R2 became the querier " + d.str() + " s after the last Query of R1, not 255 s (RFC9776-RQRY-7, TIMER-10, RFC2236-ROUTER-12)"); })
                  .describe("after 100 s, a General Query of R2")
                  .within(300.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc9776_querier_election compiled\n";

%file: test.ned

import inet.common.scenario.ScenarioManager;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;

// the two routers: R1, R2 and host A on L1 (through the switch sw1).
network IgmpTwoRouters
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='r1' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='r2' names='eth0' address='10.0.1.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        r1: Router { @display("p=150,100"); }
        sw1: EthernetSwitch { @display("p=350,100"); }
        r2: Router { @display("p=550,100"); }
        hostA: StandardHost { @display("p=350,250"); }
        scenarioManager: ScenarioManager {
            script = xml("<scenario><at t='100'><set-channel-param src-module='r1' src-gate='ethg[0]' par='disabled' value='true'/></at></scenario>");
            @display("p=50,150");
        }
    connections:
        r1.ethg++ <--> Eth100M <--> sw1.ethg++;
        r2.ethg++ <--> Eth100M <--> sw1.ethg++;
        hostA.ethg++ <--> Eth100M <--> sw1.ethg++;
}

%inifile: omnetpp.ini

[General]
network = IgmpTwoRouters
sim-time-limit = 352s
seed-set = 0
**.ipv4.igmp.typename = "Igmpv3"
**.igmp.checksumMode = "computed"
*.router.multicastForwarding = true
*.r1.multicastForwarding = true
*.r2.multicastForwarding = true

%contains: stdout
PROTOCOLTEST rfc9776_querier_election: PASS
