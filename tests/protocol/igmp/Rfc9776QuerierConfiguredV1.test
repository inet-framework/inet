%description:

Querier configured in IGMPv1 mode.

Checks RFC9776-COMPR-2, COMPR-3 and COMPH-18 from
doc/project/evidence/standard/rfc9776/catalog.md. The English procedure is in
doc/project/evidence/protocol/igmp/checks/compatibility.md#querier-configured-in-igmpv1-mode;
the program steps below map onto its expected observations. Step 1 is observation 1; the two
guards are observations 2 and 4; step 2 is observation 3.

The test sets the Unsolicited Report Interval of the model to 1 second, the default of RFC 9776
section 8.11; Rfc9776JoinRepeated.test checks the default itself.

%includes:
#include "ProtocolTest.h"
#include "IgmpChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const Ipv4Address G("225.0.1.1"), H("225.0.1.2"), K("225.0.1.3");
static const Ipv4Address S1("10.0.2.10"), S2("10.0.2.11");
static const Ipv4Address R_L1("10.0.1.1"), A_L1("10.0.1.10"), B_L1("10.0.1.11"), C_L1("10.0.1.12");
static const Ipv4Address ALL_SYSTEMS("224.0.0.1"), ALL_ROUTERS("224.0.0.2"), V3_ROUTERS("224.0.0.22");

static std::string num(double v) { std::ostringstream s; s << v; return s.str(); }
static std::set<Ipv4Address> sset(std::initializer_list<Ipv4Address> l) { return std::set<Ipv4Address>(l); }

// A State-Change Report: a Version 3 Report with a Filter-Mode-Change or Source-List-Change record for the group.
static bool isStateChange(const Packet *p, const Ipv4Address& g)
{
    return hasRecordOf(p, g, CHANGE_TO_INCLUDE_MODE) || hasRecordOf(p, g, CHANGE_TO_EXCLUDE_MODE) || hasRecordOf(p, g, ALLOW_NEW_SOURCES) || hasRecordOf(p, g, BLOCK_OLD_SOURCE);
}
// A Current-State Report for the group.
static bool isCurrentState(const Packet *p, const Ipv4Address& g) { return hasRecordOf(p, g, MODE_IS_INCLUDE) || hasRecordOf(p, g, MODE_IS_EXCLUDE); }
// A Query for the group: Group-Specific with no sources, Group-and-Source-Specific with sources.
static bool isGroupQuery(const Packet *p, const Ipv4Address& g) { return isQuery(p) && queryGroup(p) == g && querySources(p) == 0; }
static bool isSourceQuery(const Packet *p, const Ipv4Address& g) { return isQuery(p) && queryGroup(p) == g && querySources(p) > 0; }
static std::set<Ipv4Address> querySourceSet(const Packet *p)
{
    std::set<Ipv4Address> out;
    if (auto q = v3QueryOf(p))
        for (auto& a : q->getSourceList())
            out.insert(a);
    return out;
}
static bool isFwd(const Packet *p, const Ipv4Address& s) { return isDatagram(p, s, G); }
static simtime_t tq;

// An IGMPv1 Query: 8 octets and a Max Resp Code of 0 (RFC 9776 section 7.1).
static bool isV1Query(const Packet *p) { return isQuery(p) && igmpLength(p) == 8 && maxRespCode(p) <= 0; }
static bool isV1Report(const Packet *p) { return dynamicPtrCast<const Igmpv1Report>(igmpOf(p)) != nullptr; }

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc9776_querier_configured_v1")
        // Expected observation 2: every General Query of R is an IGMPv1 Query.
        .meanwhile(never(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isGeneralQuery(p) && !isV1Query(p); })
                  .describe("a General Query of R that is not 8 octets long with a Max Resp Code of 0 (RFC9776-COMPR-2, COMPR-3)")
                  .within(40.0)))
        // Expected observation 4: no IGMPv2 or IGMPv3 message of A.
        .meanwhile(never(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isV2Report(p) || isV2Leave(p) || isV3Report(p); })
                  .describe("an IGMPv2 or IGMPv3 message of A (RFC9776-COMPH-18)")
                  .within(40.0)))
        // Expected observation 1: within 1 s of the start, a General Query of R.
        .once(on("router.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return isGeneralQuery(p); })
                  .describe("a General Query of R")
                  .within(1.0))
        // Expected observation 3: within 10 ms of the join, an IGMPv1 Report for G to G.
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return c.event.time >= 10 && isV1Report(p); })
                  .assertEvent([](const MatchContext& c) { const Packet *p = c.event.packet; (void)p; return require(c.event.time - 10 <= 0.01 && igmpType(p) == IGMPV1_MEMBERSHIP_REPORT && igmpLength(p) == 8 && dynamicPtrCast<const Igmpv1Report>(igmpOf(p))->getGroupAddress() == G && destOf(p) == G, "A sent an IGMPv1 Report of " + num(igmpLength(p)) + " octets to " + destOf(p).str() + " at " + c.event.time.str() + " s (RFC9776-COMPH-18)"); })
                  .describe("after 10 s, an IGMPv1 Report of A")
                  .within(11.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc9776_querier_configured_v1 compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;

// The requests of a host, as its sockets would make them (tests/protocol/igmp/IgmpChecks.h).
simple IgmpRequests
{
    parameters:
        @class(::inet::protocoltest::IgmpRequests);
        string node;
        string interfaceName = default("eth0");
        string script;
}

// The multicast routing of R: one route from L2 to L1 with L1 as a leaf (IgmpChecks.h).
simple MulticastLeafRoute
{
    parameters:
        @class(::inet::protocoltest::MulticastLeafRoute);
        string node;
        string origin;
        string netmask;
        string group;
        string inInterface;
        string outInterface;
}

// the link with a source: R, A and B on L1 (router.eth0 through sw1); R, S1 and S2 on L2 (router.eth1 through sw2).
network IgmpSource
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            config = xml("<config>" +
                         "<interface hosts='router' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='router' names='eth1' address='10.0.2.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='eth0' address='10.0.1.11' netmask='255.255.255.0'/>" +
                         "<interface hosts='S1' names='eth0' address='10.0.2.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='S2' names='eth0' address='10.0.2.11' netmask='255.255.255.0'/>" +
                         "</config>");
            @display("p=50,50");
        }
        router: Router { @display("p=350,200"); }
        sw1: EthernetSwitch { @display("p=350,330"); }
        hostA: StandardHost { @display("p=250,450"); }
        hostB: StandardHost { @display("p=450,450"); }
        sw2: EthernetSwitch { @display("p=350,80"); }
        S1: StandardHost { @display("p=250,20"); }
        S2: StandardHost { @display("p=450,20"); }
        requestsA: IgmpRequests {
            node = "hostA";
            script = "10 a 225.0.1.1 EXCLUDE";
            @display("p=50,500");
        }
        routeR: MulticastLeafRoute {
            node = "router";
            origin = "10.0.2.0";
            netmask = "255.255.255.0";
            group = "0.0.0.0";
            inInterface = "eth1";
            outInterface = "eth0";
            @display("p=50,250");
        }
    connections:
        router.ethg++ <--> Eth100M <--> sw1.ethg++;
        router.ethg++ <--> Eth100M <--> sw2.ethg++;
        hostA.ethg++ <--> Eth100M <--> sw1.ethg++;
        hostB.ethg++ <--> Eth100M <--> sw1.ethg++;
        S1.ethg++ <--> Eth100M <--> sw2.ethg++;
        S2.ethg++ <--> Eth100M <--> sw2.ethg++;
}

%inifile: omnetpp.ini

[General]
network = IgmpSource
sim-time-limit = 42s
seed-set = 0
**.igmp.unsolicitedReportInterval = 1s
*.router.ipv4.igmp.routerVersion = 1

**.ipv4.igmp.typename = "Igmpv3"
**.igmp.checksumMode = "computed"
*.router.multicastForwarding = true
*.r1.multicastForwarding = true
*.r2.multicastForwarding = true
*.S1.numApps = 1
*.S1.app[0].typename = "UdpBasicApp"
*.S1.app[0].destAddresses = "225.0.1.1"
*.S1.app[0].destPort = 5000
*.S1.app[0].messageLength = 100B
*.S1.app[0].sendInterval = 0.5s
*.S1.app[0].startTime = 0.5s
*.S1.app[0].timeToLive = 16
*.S1.app[0].multicastInterface = "eth0"

%contains: stdout
PROTOCOLTEST rfc9776_querier_configured_v1: PASS
