%description:

A twenty-kilobyte certificate queues more than ten records with one millisecond
protection service each. A partial ACK arrives while original records are still
queued. Those reservations must count against the newly available burst budget.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static unsigned handoffsBeforeAck = 0;
static unsigned handoffsAfterAck = 0;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_queued_flight_budget")
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { if (findChunk<inet::dtls::DtlsCiphertextHeader>(c.event.packet) && findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet)) ++handoffsBeforeAck; return false; }).within(1)))
    .once(on("host2.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { return acknowledgement(c) && findChunk<inet::dtls::DtlsCiphertextHeader>(c.event.packet); }).assertEvent([](const MatchContext&) { return handoffsBeforeAck > 0 && handoffsBeforeAck < 9; }).within(1))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket(packetAck).within(0.016).drop())
    .never(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet) && ++handoffsAfterAck > 10; }).within(0.015))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver&) { require(handoffsAfterAck == 10, "the observed post-ACK interval consumes exactly its ten-record budget"); }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(3))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 1, "ACK with queued reservations permits at most ten further handoffs and eventual progress"); }));
}
%activity:
EV << "rfc9147_queued_flight_budget compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 5s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[0].dtls.profile = "certificate"
*.host2.app[0].dtls.certificateBytes = 20000B
*.host2.app[0].dtls.protectOutDelay = 0.001s
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_queued_flight_budget: PASS
