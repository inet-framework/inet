%description:
Closing an active server request reports one negative authentication result and cancels its deadline.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return establish("pha_close")
    .meanwhile(tap("tap").from("host1").filterPacket([](const Packet *p) { return packetHandshake(p, 11) || packetHandshake(p, 15) || packetHandshake(p, 20); }).drop())
    .act(action().after(0.1).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.requestAuthentication(); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 11); }).within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .unordered({on("host2.app[0].driver").signal("authenticationResult").filterValue(0).within(1), on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::CLOSED).within(1)})
    .act(action().after(2.2).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.authenticationResults == std::vector<bool>{false} && app.closedCount == 1 && app.errorCount == 0, "close cancels authentication recovery and reports exactly once"); }));
}
%activity:
EV << "PHA check compiled\n";
%inifile: omnetpp.ini
[General]
*.host2.app[*].dtls.handshakeTimeout = 2s
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.profile = "certificate"
*.host*.app[*].dtls.postHandshakeAuthEnabled = true
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s

%contains: stdout
PROTOCOLTEST pha_close: PASS
