%description:
A working routed path shrinks below the base without ICMP. Failed confirmation
falls back to base, failed base suspends sending, and a restored path releases
held data exactly once while reverse traffic remains usable.
%includes:
#include "DtlsHeartbeatTestUtils.h"
#include "inet/networklayer/common/NetworkInterface.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return ProtocolTest("legacy_pmtu_blackhole_recovery")
    .meanwhile(tap("tap").from("router").filterPacket("icmpv4.type == 3 && icmpv4.code == 4").drop())
    .once(on("host1.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(1154).within(2))
    .act(action().run<NetworkInterface>("router.eth[2]", [](NetworkInterface& nic) { nic.setMtu(508); }))
    .once(on("host1.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(466).within(10))
    .once(on("host1.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(0).within(9))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.maximumDatagramSize() == 0 && app.errorCount == 0 && app.establishedCount == 1, "base failure suspends this established sender");
        app.sendMarker(230, 100);
    }))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(231, 100); }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers.empty(), "suspended sender holds its queued datagram"); }))
    .act(action().run<NetworkInterface>("router.eth[2]", [](NetworkInterface& nic) { nic.setMtu(1228); }))
    .unordered({on("host2.app[0].driver").signal("packetSentToUpper").within(4), on("host1.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(1154).within(4)})
    .act(action().after(0.2).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>{230} && app.errorCount == 0, "confirmed recovery releases one original datagram"); }));
}
%activity:
EV << "blackhole recovery compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.dtls.DtlsPathMtuNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 32s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.router.eth[2].mac.mtu = 1228B
*.router.eth[0].mac.mtu = 1228B
*.router.eth[1].mac.mtu = 1228B
*.configurator.addStaticRoutes = false
*.configurator.config = xml("<config><interface hosts='host1' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/><interface hosts='router' names='eth0' address='10.0.1.2' netmask='255.255.255.0'/><interface hosts='host1' names='eth1' address='10.0.2.1' netmask='255.255.255.0'/><interface hosts='router' names='eth1' address='10.0.2.2' netmask='255.255.255.0'/><interface hosts='router' names='eth2' address='10.0.3.1' netmask='255.255.255.0'/><interface hosts='host2' names='eth0' address='10.0.3.2' netmask='255.255.255.0'/><route hosts='host1' destination='10.0.3.2' netmask='255.255.255.255' gateway='10.0.1.2' interface='eth0'/><route hosts='host2' destination='*' netmask='0.0.0.0' gateway='10.0.3.1' interface='eth0'/></config>")
*.host*.app[*].dtls.pathMtuConfirmationInterval = 2s
*.host*.app[*].dtls.pathMtuRaiseInterval = 20s
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.pathMtuDiscoveryEnabled = true
*.host*.app[*].dtls.pathMtuProbeTimeout = 1s
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST legacy_pmtu_blackhole_recovery: PASS
