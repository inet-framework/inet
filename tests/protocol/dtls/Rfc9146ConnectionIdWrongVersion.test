%description:
Actual legacy CID records exercise silent admission and preserve later valid data.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static std::vector<uint8_t> modernCid;
return ProtocolTest("cid_wrong_version12")
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) {
        if (auto h=findChunk<inet::tls::TlsServerHello>(c.event.packet); h && h->getCipherSuite()==0x1301) for (size_t pos=0;pos<h->getExtensionsArraySize();) { unsigned type=(h->getExtensions(pos)<<8)|h->getExtensions(pos+1); unsigned size=(h->getExtensions(pos+2)<<8)|h->getExtensions(pos+3); if (type==54) { modernCid.clear(); for (size_t i=1;i<size;++i) modernCid.push_back(h->getExtensions(pos+4+i)); } pos+=4+size; } return false;
    }).within(4)))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket(packetApplication).nth(1).mutate([](Packet *p) { require(modernCid.size()==8,"capture actual modern owner CID"); require(mutateHeader<inet::dtls::Dtls12CidHeader>(p,[](auto& h) { for (size_t i=0;i<8;++i) h.setConnectionId(i,modernCid[i]); }),"replace only actual legacy CID"); }))
    .unordered({on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(2),on("host1.app[1].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(2)})
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(174); }))
    .once(on("host2.app[0].dtls").signal("recordDropped").filterValue(6).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(175); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host1.app[1].driver", [](DtlsTestDriver& app) { app.sendMarker(176); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount==2 && app.errorCount==0 && app.receivedMarkers==std::vector<int>({175,176}) && app.receivedHandles[0]!=app.receivedHandles[1],"wrong-version CID neither delivers nor damages either owner"); }));
}
%activity:
EV << "version-separated CID compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host1.numApps = 2
*.host2.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
ned-package-exclusions = inet.protocoltest.dtls.work
*.host1.app[1].localPort = 4436
*.host1.app[0].dtls.versions = "1.2"
*.host1.app[1].dtls.versions = "1.3"
*.host2.app[*].dtls.versions = "1.3 1.2"
*.host*.app[*].dtls.profile = "psk"
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host*.app[*].dtls.connectionIdEnabled = true
%contains: stdout
PROTOCOLTEST cid_wrong_version12: PASS
