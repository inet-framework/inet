%description:

The production client opens an association and hands a typed DTLS 1.3 offer to UDP.
This foundation check verifies offer fields and one sampled handshake processing delay;
it makes no claim that a peer completes the handshake.

%includes:
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_client_hello")
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 1); })
        .assertEvent([](const MatchContext& c) {
            auto record = findChunk<inet::dtls::DtlsPlaintextHeader>(c.event.packet);
            auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet);
            auto body = findChunk<inet::dtls::DtlsClientHello>(c.event.packet);
            if (!record || !h || !body || record->getEpoch() != 0 || body->getLegacyVersion() != 0xfefd || body->getLegacyCookieArraySize() != 0)
                return false;
            if (h->getFragmentOffset() != 0 || h->getFragmentLength() != h->getMessageLength() || h->getMessageLength() != B(body->getChunkLength()).get())
                return false;
            if (body->getCipherSuitesArraySize() != 1 || body->getCipherSuites(0) != 0x1301)
                return false;
            std::vector<int> types;
            for (size_t i = 0; i + 4 <= body->getExtensionsArraySize();) {
                types.push_back((body->getExtensions(i) << 8) | body->getExtensions(i + 1));
                i += 4 + ((body->getExtensions(i + 2) << 8) | body->getExtensions(i + 3));
            }
            return c.event.time == SimTime(0.207) && std::find(types.begin(), types.end(), 43) != types.end()
                && std::find(types.begin(), types.end(), 51) != types.end() && types.back() == 41;
        }).within(1))
    .once(on("host1.udp").signal("packetSentToLower").filterPacket("udp.srcPort == 4434 && udp.destPort == 4433").within(0.01))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 0, "initial offer alone cannot establish"); }));
}
%activity:
EV << "rfc9147_client_hello compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[0].dtls.handshakeOutDelay = 7ms
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_client_hello: PASS
