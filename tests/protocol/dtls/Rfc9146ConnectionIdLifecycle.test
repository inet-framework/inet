%description:
Shutdown and crash cancel retained 1.2 flights; restarted handles survive retention expiry.
%includes:
#include "DtlsHeartbeatTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static std::set<std::vector<uint8_t>> ids;
return ProtocolTest("cid_lifecycle12")
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { if (auto h=findChunk<inet::tls::TlsServerHello>(c.event.packet)) { for (size_t pos=0;pos<h->getExtensionsArraySize();) { unsigned type=(h->getExtensions(pos)<<8)|h->getExtensions(pos+1); unsigned size=(h->getExtensions(pos+2)<<8)|h->getExtensions(pos+3); if (type==54) { std::vector<uint8_t> cid; for (size_t i=1;i<size;++i) cid.push_back(h->getExtensions(pos+4+i)); ids.insert(cid); } pos+=4+size; } } return false; }).within(8)))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::CLOSED).within(1))
    .act(action().after(1.2).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount==1 && app.closedCount==1 && app.errorCount==0, "shutdown closes retained association once"); app.listenPeer(); }))
    .act(action().after(0.05).run<DtlsTestDriver>("host1.app[1].driver", [](DtlsTestDriver& app) { app.openPeer("host2"); }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::CLOSED).within(2))
    .act(action().after(1.2).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount==2 && app.closedCount==2 && app.errorCount==1 && app.lastError=="node crashed", "crash reports and clears second retained association once"); app.listenPeer(); }))
    .act(action().after(0.05).run<DtlsTestDriver>("host1.app[2].driver", [](DtlsTestDriver& app) { app.openPeer("host2"); }))
    .once(on("host1.app[2].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1))
    .act(action().after(241).run<DtlsTestDriver>("host1.app[2].driver", [](DtlsTestDriver& app) { app.sendMarker(141); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(ids.size()==3 && app.establishedCount==3 && app.closedCount==2 && app.errorCount==1 && app.receivedMarkers==std::vector<int>{141}, "old deadlines and expired final retention do not affect restarted data service"); }));
}
%activity:
EV << "lifecycle discovery compiled\n";
%file: PathMtuRestartNetwork.ned
import inet.protocoltest.TapPairNetwork;
import inet.common.scenario.ScenarioManager;
network PathMtuRestartNetwork extends TapPairNetwork
{
    submodules:
        scenarioManager: ScenarioManager;
}
%file: scenario.xml
<scenario>
    <at t="1s"><shutdown module="host2"/></at>
    <at t="2s"><startup module="host2"/></at>
    <at t="4s"><crash module="host2"/></at>
    <at t="5s"><startup module="host2"/></at>
</scenario>
%inifile: omnetpp.ini
[General]
network = PathMtuRestartNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 250s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.scenarioManager.script = xmldoc("scenario.xml")
*.host1.numApps = 3
*.host2.numApps = 1
*.host2.hasStatus = true
*.host1.app[1].active = false
*.host1.app[2].active = false
*.host1.app[1].localPort = 4436
*.host1.app[2].localPort = 4438
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.profile = "psk"
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST cid_lifecycle12: PASS
