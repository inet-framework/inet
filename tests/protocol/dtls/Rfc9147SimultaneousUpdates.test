%description:

DTLS production-path variant SimultaneousUpdates: explicit concurrent-update requirement.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static uint16_t clientSequence, serverSequence;
static bool clientAcked = false, serverAcked = false;

Define_ProtocolTestProgram()
{
return establish("rfc9147_simultaneous_updates")
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.update(true); })
        .run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.update(true); }))
    .unordered({
        on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::tls::TlsKeyUpdate>(c.event.packet); return handshake(c, 24) && h && h->getRequestUpdate() == 1; }).assertEvent([](const MatchContext& c) { clientSequence = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet)->getMessageSequence(); return true; }).within(1),
        on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::tls::TlsKeyUpdate>(c.event.packet); return handshake(c, 24) && h && h->getRequestUpdate() == 1; }).assertEvent([](const MatchContext& c) { serverSequence = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet)->getMessageSequence(); return true; }).within(1)
    })
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { if (packetAckForEpoch(c.event.packet, 3)) clientAcked = true; return packetAckForEpoch(c.event.packet, 3); }).within(2)))
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { if (packetAckForEpoch(c.event.packet, 3)) serverAcked = true; return packetAckForEpoch(c.event.packet, 3); }).within(2)))
    .meanwhile(never(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet); return !clientAcked && h && h->getMessageType() == 24 && h->getMessageSequence() != clientSequence; }).within(2)))
    .meanwhile(never(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet); return !serverAcked && h && h->getMessageType() == 24 && h->getMessageSequence() != serverSequence; }).within(2)))
    .unordered({
        on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::tls::TlsKeyUpdate>(c.event.packet); return handshake(c, 24) && h && h->getRequestUpdate() == 0; }).within(2),
        on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::tls::TlsKeyUpdate>(c.event.packet); return handshake(c, 24) && h && h->getRequestUpdate() == 0; }).within(2)
    })
    .act(action().after(0.02).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(81); })
        .run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(82); }))
    .unordered({
        on("host1.app[0].driver").signal("packetSentToUpper").within(1),
        on("host2.app[0].driver").signal("packetSentToUpper").within(1)
    })
    .meanwhile(never(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 24); }).within(1.2)))
    .never(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 24); }).within(1.2))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>{82} && app.updateResults == std::vector<bool>{true}, "simultaneous client request is admitted and preserves reverse delivery"); })
        .run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>{81} && app.updateResults == std::vector<bool>{true}, "simultaneous server request is admitted and terminates without echo loop"); }));
}
%activity:
EV << "rfc9147_simultaneous_updates compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
ned-package-exclusions = inet.protocoltest.dtls.work

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_simultaneous_updates: PASS
