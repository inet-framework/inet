%description:

Duplicate a real ClientHello into two fragments after its server candidate exists.
Plaintext ACKs and the server flight must share a single record-number allocator.

%includes:
#include <set>
#include "DtlsFragmentTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static unsigned copies = 0;
static std::set<uint64_t> serverNumbers;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_half_open_fragment_numbers")
    .intercept(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { return packetHandshake(p, 1); }).nth(1).duplicate(0.01, 2))
    .intercept(tap("tap").from("host1").copiesOnly().filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { return packetHandshake(p, 1); }).mutate([](Packet *p) { ++copies; sliceClientHello(p, copies == 2, copies); }))
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) {
        auto r = findChunk<inet::dtls::DtlsPlaintextHeader>(c.event.packet);
        if (r) require(serverNumbers.insert(r->getSequenceNumber()).second, "server handshake and partial ACK record numbers are distinct");
        return false;
    }).within(2)))
    .once(on("host2.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet); return h && h->getMessageType() == 1 && h->getFragmentOffset() == 0 && h->getFragmentLength() < h->getMessageLength(); }).within(1))
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return acknowledgement(c) && findChunk<inet::dtls::DtlsPlaintextHeader>(c.event.packet); }).within(0.1))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(2))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(copies == 2 && serverNumbers.size() >= 2 && app.establishedCount == 1, "duplicate fragments retain the existing candidate and complete once"); }));
}
%activity:
EV << "rfc9147_half_open_fragment_numbers compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 5s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[0].dtls.cookieRequired = false
*.host2.app[0].dtls.protectOutDelay = 0.05s
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_half_open_fragment_numbers: PASS
