%description:
A validated routed interface move resets both confirmed budgets to base while
preserving the handle. Oversized queued output is rejected on the new path,
which discovers its lower bottleneck independently.
%includes:
#include "DtlsHeartbeatTestUtils.h"
#include "inet/networklayer/common/NetworkInterface.h"
#include "inet/networklayer/ipv4/IIpv4RoutingTable.h"
#include "inet/networklayer/ipv4/Ipv4Route.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static uint64_t handle = 0;
return ProtocolTest("pmtu_migration")
    .once(on("host1.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(1170).within(4))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { handle = app.lastHandle(); app.requestCids(2); }))
    .once(on("host1.app[0].dtls").signal("connectionIdsReceived").filterValue(2).within(1))
    .act(action().run<NetworkInterface>("router.eth[2]", [](NetworkInterface& nic) { nic.setMtu(620); }).run<NetworkInterface>("router.eth[1]", [](NetworkInterface& nic) { nic.setMtu(620); }).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        auto node = getContainingNode(&app);
        auto table = L3AddressResolver().getIpv4RoutingTableOf(node);
        auto interface = L3AddressResolver().interfaceTableOf(node)->findInterfaceByName("eth1");
        for (int i = 0; i < table->getNumRoutes(); ++i)
            if (table->getRoute(i)->getDestination() == Ipv4Address("10.0.3.2")) { table->getRoute(i)->setInterface(interface); table->getRoute(i)->setGateway(Ipv4Address("10.0.2.2")); }
        app.migrateAddress(L3AddressResolver().resolve("host1%eth1")); app.sendMarker(180, 800); app.sendMarker(181, 400);
    }))
    .unordered({on("host1.app[0].driver").signal("pathChanged").within(2), on("host2.app[0].driver").signal("pathChanged").within(2), on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::SEND_ERROR).within(2), on("host2.app[0].driver").signal("packetSentToUpper").within(2), on("host1.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(562).within(2), on("host2.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(562).within(2)})
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.lastHandle() == handle && app.establishedCount == 1 && app.errorCount == 0 && app.sendErrorCount == 1 && app.migrationResults == std::vector<bool>{true}, "validated move preserves the handle and explicitly rejects the queued oversized datagram");
        require(std::count(app.maximumDatagramSizes.begin(), app.maximumDatagramSizes.end(), 482) >= 2 && app.maximumDatagramSize() == 562, "new path resets to base before confirming a lower ceiling");
    }))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>{181} && app.maximumDatagramSize() == 562, "only fitting data delivers on the new routed path"); app.sendMarker(182, 550); }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").within(1));
}
%activity:
EV << "migration discovery compiled\n";
%inifile: omnetpp.ini
[General]
*.host1.app[*].dtls.protectOutDelay = 100ms
*.router.ipv4.icmp.quoteLength = 64B
network = inet.protocoltest.dtls.DtlsPathMtuNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 14s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.router.eth[2].mac.mtu = 1228B
*.router.eth[0].mac.mtu = 1228B
*.router.eth[1].mac.mtu = 1228B
*.configurator.addStaticRoutes = false
*.configurator.config = xml("<config><interface hosts='host1' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/><interface hosts='router' names='eth0' address='10.0.1.2' netmask='255.255.255.0'/><interface hosts='host1' names='eth1' address='10.0.2.1' netmask='255.255.255.0'/><interface hosts='router' names='eth1' address='10.0.2.2' netmask='255.255.255.0'/><interface hosts='router' names='eth2' address='10.0.3.1' netmask='255.255.255.0'/><interface hosts='host2' names='eth0' address='10.0.3.2' netmask='255.255.255.0'/><route hosts='host1' destination='10.0.3.2' netmask='255.255.255.255' gateway='10.0.1.2' interface='eth0'/><route hosts='host2' destination='*' netmask='0.0.0.0' gateway='10.0.3.1' interface='eth0'/></config>")
*.host*.app[*].dtls.migrationEnabled = true
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.pathMtuDiscoveryEnabled = true
*.host*.app[*].dtls.pathMtuProbeTimeout = 1s
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST pmtu_migration: PASS
