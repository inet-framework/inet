%description:
A delayed response below the current replay high-water mark cannot confirm a path.
%includes:
#include "DtlsHeartbeatTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static bool active = false;
static int probes = 0;
return establish12("rfc9146_migration_fresh_response")
    .meanwhile(tap("tap").from("host1").filterPacket([](const Packet *p) { return active && packetHeartbeat(p, 2); }).nth(1).delay(0.1))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *) { return active; }).mutate([](Packet *p) { mutateHeader<UdpHeader>(p, [](auto& h) { h.setSrcPort(5534); }); }))
    .meanwhile(tap("tap").from("host2").filterPacket("udp.destPort == 5534").mutate([](Packet *p) { if (packetHeartbeat(p, 1)) ++probes; mutateHeader<UdpHeader>(p, [](auto& h) { h.setDestPort(4434); }); }))
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { active = true; app.sendMarker(1); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return heartbeat(c, 2); }).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(3); }))
    .never(on("host2.app[0].driver").signal("pathChanged").within(0.3))
    .once(on("host2.app[0].driver").signal("pathChanged").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(probes == 2 && app.receivedMarkers == std::vector<int>({1,3}) && app.confirmedPaths.size() == 1 && app.confirmedPaths[0].peerPort == 5534 && app.errorCount == 0, "response older than accepted candidate data cannot confirm; a fresh retry response can"); }));
}
%activity:
EV << "migration freshness compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 8s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.migrationEnabled = true
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9146_migration_fresh_response: PASS
