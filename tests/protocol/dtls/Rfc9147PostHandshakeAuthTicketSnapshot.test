%description:
PHA does not upgrade a ticket issued before authentication; resumption restores the original snapshot, then permits a fresh request.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return establish("pha_ticketsnapshot")
    .act(action().after(0.2).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(!app.peerAuthentication().certificateAuthenticated, "ticket issued while the client is anonymous"); app.requestAuthentication(); }))
    .once(on("host2.app[0].driver").signal("authenticationResult").filterValue(1).within(2))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::CLOSED).within(1))
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.resumePeer(); }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(2))
    .act(action().after(0.1).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        auto peer = app.peerAuthentication();
        require(app.isResumed() && peer.resumed && !peer.certificateAuthenticated && peer.identity.empty() && app.authenticationResults == std::vector<bool>{true}, "pre-PHA ticket retains its issuance-time anonymous snapshot without a fresh result");
        app.requestAuthentication();
    }))
    .once(on("host2.app[0].driver").signal("authenticationResult").filterValue(1).within(2))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.peerAuthentication().certificateAuthenticated && app.authenticationResults == std::vector<bool>({true,true}), "resumed association can freshly authenticate the client"); app.sendMarker(75); }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.peerAuthentication().certificateAuthenticated && app.peerAuthentication().resumed && app.authenticationResults.empty(), "client restores its server certificate snapshot without claiming server acceptance of PHA"); }));
}
%activity:
EV << "PHA check compiled\n";
%inifile: omnetpp.ini
[General]
*.host*.app[*].dtls.resumptionEnabled = true
*.host*.app[*].dtls.cipherSuites = "TLS_AES_256_GCM_SHA384"
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.profile = "certificate"
*.host*.app[*].dtls.postHandshakeAuthEnabled = true
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s

%contains: stdout
PROTOCOLTEST pha_ticketsnapshot: PASS
