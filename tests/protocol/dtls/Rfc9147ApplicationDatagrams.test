%description:

DTLS 1.3 production-path check: Rfc9147ApplicationDatagrams. See the owning reviewer document in this suite
and plan/done/dtls.md for requirements, setup, expected result and limitations.
The test uses the real UDP-backed Dtls engine, seed 0 and explicit packet faults.

%includes:
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;

Define_ProtocolTestProgram()
{
return establish("rfc9147_application_datagrams")
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(1); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord).within(1))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { return packetApplication(p); }).nth(1).drop())
    .act(action().after(0.02).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(2); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.receivedMarkers == std::vector<int>{2}, "lost application datagram is not delivered");
        app.sendMarker(3);
    }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").within(1))
    .never(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord).within(1.2))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.receivedMarkers == std::vector<int>{3}, "reverse application datagram is preserved");
        app.sendMarker(7, 0);
        app.sendMarker(9, 1179);
        app.sendMarker(10, 1, 999999);
    }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord).assertEvent([](const MatchContext& c) { return c.event.packet->getByteLength() == 22; }).within(0.1))
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.sendErrorCount == 2, "oversized and unknown-handle sends are rejected locally");
    }).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.receivedMarkers == std::vector<int>({2, -1}), "an empty application datagram remains one empty delivery");
    }))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendBits(1); }))
    .meanwhile(never(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord).within(0.01)))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::SEND_ERROR).within(0.1))
    .act(action().after(0.02).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.sendErrorCount == 3 && app.errorCount == 0, "one-bit application data is consumed and rejected locally without invalidating the association"); app.sendMarker(11, 1); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(0.1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>({2, -1, 11}), "valid data still delivers after an unaligned send is rejected"); }));
}

%activity:
EV << "rfc9147_application_datagrams compiled\n";

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_application_datagrams: PASS
