%description:

DTLS production-path variant KeyUpdateImpossibleLength: explicit post-handshake malformed-input/closure requirement.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;

Define_ProtocolTestProgram()
{
return establish("rfc9147_key_update_impossible_length")
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.update(); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 24); }).within(1))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { return packetHandshake(p, 24); }).mutate([](Packet *p) { replaceProtectedFragment(p, 2, 0, {0}); }))
    .never(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent(acknowledgement).within(1.2))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers.empty(), "invalid declared update length never becomes data"); }));
}
%activity:
EV << "rfc9147_key_update_impossible_length compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
ned-package-exclusions = inet.protocoltest.dtls.work

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_key_update_impossible_length: PASS
