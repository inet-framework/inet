%description:
Periodic confirmation preserves a hint-limited budget during idle time. The
separate raise timer later rediscovers a restored larger routed path.
%includes:
#include "DtlsHeartbeatTestUtils.h"
#include "inet/networklayer/common/NetworkInterface.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static int confirmations = 0;
return ProtocolTest("pmtu_raise")
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { if (heartbeat(c, 1) && c.event.packet->getByteLength() == 800) ++confirmations; return false; }).within(7)))
    .once(on("host1.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(770).within(2))
    .act(action().run<NetworkInterface>("router.eth[2]", [](NetworkInterface& nic) { nic.setMtu(1228); }))
    .never(on("host1.app[0].driver").signal("maximumDatagramSizeChanged").within(2.5))
    .once(on("host1.app[0].driver").signal("maximumDatagramSizeChanged").filterValue(1170).within(1.5))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(confirmations >= 3 && app.errorCount == 0, "idle confirmation keeps its budget until raise probes positively confirm a larger path"); app.sendMarker(190, 1100); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1));
}
%activity:
EV << "raise discovery compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.dtls.DtlsPathMtuNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 14s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.router.eth[2].mac.mtu = 828B
*.router.eth[0].mac.mtu = 1228B
*.router.eth[1].mac.mtu = 1228B
*.configurator.addStaticRoutes = false
*.configurator.config = xml("<config><interface hosts='host1' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/><interface hosts='router' names='eth0' address='10.0.1.2' netmask='255.255.255.0'/><interface hosts='host1' names='eth1' address='10.0.2.1' netmask='255.255.255.0'/><interface hosts='router' names='eth1' address='10.0.2.2' netmask='255.255.255.0'/><interface hosts='router' names='eth2' address='10.0.3.1' netmask='255.255.255.0'/><interface hosts='host2' names='eth0' address='10.0.3.2' netmask='255.255.255.0'/><route hosts='host1' destination='10.0.3.2' netmask='255.255.255.255' gateway='10.0.1.2' interface='eth0'/><route hosts='host2' destination='*' netmask='0.0.0.0' gateway='10.0.3.1' interface='eth0'/></config>")
*.host*.app[*].dtls.pathMtuConfirmationInterval = 1s
*.host*.app[*].dtls.pathMtuRaiseInterval = 3s
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.pathMtuDiscoveryEnabled = true
*.host*.app[*].dtls.pathMtuProbeTimeout = 1s
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.router.ipv4.icmp.quoteLength = 64B
%contains: stdout
PROTOCOLTEST pmtu_raise: PASS
