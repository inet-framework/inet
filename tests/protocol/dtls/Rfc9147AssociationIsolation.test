%description:

DTLS 1.3 production-path check: Rfc9147AssociationIsolation. See the owning reviewer document in this suite
and plan/done/dtls.md for requirements, setup, expected result and limitations.
The test uses the real UDP-backed Dtls engine, seed 0 and explicit packet faults.

%includes:
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;

Define_ProtocolTestProgram()
{
return establish("rfc9147_association_isolation")
    .act(action().after(0.1).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.handles.size() == 2, "one server accepts both source ports");
        require(app.handles[0] != app.handles[1], "accepted associations have distinct local handles");
        require(app.establishedCount == 2, "both independent server associations establish");
    }).run<DtlsTestDriver>("host1.app[1].driver", [](DtlsTestDriver& app) {
        require(app.establishedCount == 1, "second client establishes independently");
    }));
}

%activity:
EV << "rfc9147_association_isolation compiled\n";

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host1.numApps = 2
*.host2.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[1].localPort = 4436

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_association_isolation: PASS
