%description:

DTLS production-path variant InvalidRecordTimer: see the owning reviewer document.
UDP-backed production engine; seed 0; explicit stimulus and assertions.

%includes:
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;

Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_invalid_record_timer")
    .intercept(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").drop())
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 1); }).within(1))
    .act(action().after(0.5).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.sendRaw(rawPlaintext(22, 0, 20), "host1", 4434); }))
    .once(on("host1.app[0].dtls").signal("recordDropped").assertValue(1L).within(0.01))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(0.48).within(0.51))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ERROR).within(2))
    .never(on("host1.app[0].dtls").signal("handshakeRetransmission").within(2));
}

%activity:
EV << "rfc9147_invalid_record_timer compiled\n";

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[0].dtls.handshakeTimeout = 2s

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_invalid_record_timer: PASS
