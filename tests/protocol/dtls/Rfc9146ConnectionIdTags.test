%description:
Selected legacy CID wire/admission boundary through real UDP endpoints.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return establish12("cid_tags12")
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { if (applicationRecord(c)) require(c.event.packet->getRegionTag<CreationTimeTag>(B(30),B(2))->getCreationTime()==SimTime(123),"CID header and nonce shift the actual outgoing payload region"); return false; }).within(4)))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendTaggedMarker(172); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").assertEvent([](const MatchContext& c) { return c.event.packet->getRegionTag<CreationTimeTag>(B(1),B(2))->getCreationTime()==SimTime(123); }).within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.sendTaggedMarker(173); }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").assertEvent([](const MatchContext& c) { return c.event.packet->getRegionTag<CreationTimeTag>(B(1),B(2))->getCreationTime()==SimTime(123); }).within(1));
}
%activity:
EV << "legacy CID boundary compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 6s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.profile = "psk"
*.host*.app[*].dtls.handshakeOutDelay = 10ms
*.host*.app[*].dtls.handshakeInDelay = 10ms
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host2.app[*].dtls.clientAuthentication = false
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host*.app[*].dtls.connectionIdEnabled = true
%contains: stdout
PROTOCOLTEST cid_tags12: PASS
