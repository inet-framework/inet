%description:

A represented epoch-two fatal alert reaches an opening client before ServerHello
has supplied the corresponding protection state. It must be discarded as unknown
epoch, preserving the attempt so the subsequent normal handshake can complete.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_protected_alert_before_hello")
    .intercept(tap("tap").from("host2").filterPacket("udp.srcPort == 14433").filterPacket([](const Packet *p) { return findChunk<inet::dtls::DtlsAlert>(p) != nullptr; }).mutate([](Packet *p) { require(mutateHeader<UdpHeader>(p, [](auto& h) { h.setSrcPort(4433); }), "early alert uses opening client's peer tuple"); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 1); }).within(1))
    .act(action().after(0.01).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.sendRaw(rawProtectedFatalAlert(40), "host1", 4434); }))
    .once(on("host1.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { return protectedRecord(c, 2) && findChunk<inet::dtls::DtlsAlert>(c.event.packet) != nullptr; }).within(0.1))
    .once(on("host1.app[0].dtls").signal("recordDropped").assertValue(2).within(0.1))
    .act(action().after(0.01).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.errorCount == 0 && app.establishedCount == 0, "unavailable epoch cannot process fatal alert or change opening state"); }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(4))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 1 && app.errorCount == 0, "normal handshake survives unknown protection input"); }));
}
%activity:
EV << "rfc9147_protected_alert_before_hello compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
ned-package-exclusions = inet.protocoltest.dtls.work
*.host2.app[0].dtls.handshakeOutDelay = 0.5s
%contains: stdout
PROTOCOLTEST rfc9147_protected_alert_before_hello: PASS
