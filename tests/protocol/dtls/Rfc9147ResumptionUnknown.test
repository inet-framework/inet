%description:
Ticket fallback through the production engine: unknown server ticket falls back to certificates. See resumption.md.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return establish("rfc9147_resumption_unknown")
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .act(action().after(2.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.resumePeer(); }))
    .meanwhile(tap("tap").from("host1").filterPacket([](const Packet *p) { return findChunk<inet::dtls::DtlsClientHello>(p) != nullptr; }).mutate([](Packet *p) {
        editClientHello(p, [](auto& hello) {
            for (size_t i = 0; i + 4 <= hello.getExtensionsArraySize();) {
                unsigned type = (hello.getExtensions(i) << 8) | hello.getExtensions(i + 1);
                unsigned size = (hello.getExtensions(i + 2) << 8) | hello.getExtensions(i + 3);
                if (type == 41) {
                    require(size >= 20, "ticket offer has a sixteen-byte identity");
                    hello.setExtensions(i + 8, hello.getExtensions(i + 8) ^ 0x80);
                }
                i += 4 + size;
            }
        });
    }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(3))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.establishedCount == 2 && !app.isResumed(), "unknown server ticket falls back to certificates");
        app.sendMarker(43);
    }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.establishedCount == 2 && !app.isResumed() && app.receivedMarkers == std::vector<int>{43}, "full handshake fallback delivers application data");
    }));
}
%activity:
EV << "fallback compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 12s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[*].dtls.profile = "certificate"
*.host*.app[*].dtls.resumptionEnabled = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s

%contains: stdout
PROTOCOLTEST rfc9147_resumption_unknown: PASS
