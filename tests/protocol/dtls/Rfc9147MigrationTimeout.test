%description:
Candidate validation timeout preserves a usable confirmed path and handle.
%includes:
#include "DtlsHeartbeatTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static bool active = false;
static int probes = 0, suppressedResponses = 0;
return establish("rfc9147_migration_timeout")
    .meanwhile(tap("tap").from("host1").filterPacket([](const Packet *p) { if (active && packetHeartbeat(p, 2)) { ++suppressedResponses; return true; } return false; }).drop())
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *) { return active; }).mutate([](Packet *p) { mutateHeader<UdpHeader>(p, [](auto& h) { h.setSrcPort(5534); }); }))
    .meanwhile(tap("tap").from("host2").filterPacket("udp.destPort == 5534").mutate([](Packet *p) { if (packetHeartbeat(p, 1)) ++probes; mutateHeader<UdpHeader>(p, [](auto& h) { h.setDestPort(4434); }); }))
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { active = true; app.sendMarker(1); }))
    .once(on("host2.app[0].dtls").signal("probeResult").filterValue(inet::dtls::IDtls::PROBE_TIMED_OUT).within(1.2))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.confirmedPaths.empty() && app.errorCount == 0 && probes == 1 && suppressedResponses == 1, "failed candidate leaves the confirmed endpoint unchanged"); active = false; app.sendMarker(5); }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 1 && app.receivedMarkers == std::vector<int>{5}, "old inbound mapping remains usable"); app.sendMarker(6); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>({1,6}) && app.confirmedPaths.empty() && probes == 1 && app.errorCount == 0, "old path exchanges data in both directions after candidate expiry"); }));
}
%activity:
EV << "migration timeout compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 8s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.migrationEnabled = true
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host2.app[*].dtls.probeTimeout = 1s
%contains: stdout
PROTOCOLTEST rfc9147_migration_timeout: PASS
