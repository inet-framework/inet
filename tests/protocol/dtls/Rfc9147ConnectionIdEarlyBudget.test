%description:
CID negotiation grows an active early record's header budget. The operation
finishes its sampled 10 ms service and is skipped once before handoff, while
handshake admission and later ordinary delivery succeed. See connection-ids.md.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static simtime_t earlyStarted;
Define_ProtocolTestProgram()
{
return establish("rfc9147_connection_id_early_budget")
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .act(action().after(2.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.resumeEarly(); }))
    .once(on("host1.app[0].dtls").signal("processingDelay").filterValue(0.01).assertEvent([](const MatchContext& c) { earlyStarted = c.event.time; return true; }).within(1))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::SEND_ERROR).assertEvent([](const MatchContext& c) { return c.event.time == earlyStarted + SimTime(0.01); }).within(1))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(2))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.isResumed() && app.earlyResults == std::vector<bool>{true} && app.sendErrorCount == 1 && app.lastError == "DTLS early header budget changed before output handoff", "CID negotiation changes an active early record header before handoff");
        app.sendMarker(47);
    }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().after(0.1).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.earlyMarkers.empty() && app.receivedMarkers == std::vector<int>{47}, "no buffering or automatic ordinary retry of unavailable early data");
    }));
}
%activity:
EV << "early boundary compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[*].dtls.resumptionEnabled = true
*.host1.app[*].dtls.earlyDataEnabled = true
*.host*.app[*].dtls.earlyDataBytes = 64B
*.host2.app[*].dtls.cookieRequired = false
*.host2.app[*].dtls.earlyDataEnabled = true
*.host*.app[*].dtls.connectionIdEnabled = true
*.host1.app[*].dtls.protectOutDelay = simTime() > 2.4s ? 0.01s : 0s
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_connection_id_early_budget: PASS
