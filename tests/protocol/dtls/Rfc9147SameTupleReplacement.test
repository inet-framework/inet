%description:

DTLS production-path variant SameTupleReplacement: explicit association-isolation requirement.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static uint64_t original = 0;
Define_ProtocolTestProgram()
{
return establish("rfc9147_same_tuple_replacement")
    .act(action().after(0.1).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.establishedCount == 2, "two peers are established before replacement");
        for (const auto& endpoint : app.acceptedEndpoints) if (endpoint.peerPort == 4434) original = endpoint.id;
        require(original != 0, "replacement targets the first client's handle");
    })
        .run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.reopenPeer(); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 1) && findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet)->getMessageSequence() == 1; }).within(2))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(p); return h && h->getMessageType() == 1 && h->getMessageSequence() == 1; }).nth(1).mutate([](Packet *p) {
        editClientHello(p, [](auto& h) { h.setRandom(0, h.getRandom(0) ^ 1); });
    }))
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto a = findChunk<inet::dtls::DtlsAlert>(c.event.packet); return a && a->getDescription() == 47; }).within(1))
    .act(action().after(0.01).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 2 && app.closedCount == 0, "rejected retry preserves established same-quartet state"); })
        .run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.reopenPeer(); }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(2))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.establishedCount == 3, "validated replacement establishes exactly once");
        require(std::find(app.closedHandles.begin(), app.closedHandles.end(), original) != app.closedHandles.end(), "successful replacement releases and reports old local handle");
    }).run<DtlsTestDriver>("host1.app[1].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 1 && app.errorCount == 0 && app.closedCount == 0, "replacement leaves unrelated peer intact"); }));
}
%activity:
EV << "rfc9147_same_tuple_replacement compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host1.numApps = 2
*.host2.numApps = 1
*.host1.app[1].localPort = 4436
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
ned-package-exclusions = inet.protocoltest.dtls.work

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_same_tuple_replacement: PASS
