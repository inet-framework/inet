%description:
Production DTLS 1.2 boundary check with real UDP records, seed 0 and explicit faults.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static std::set<uint64_t> finalRecords;
return ProtocolTest("final_retention12")
    .meanwhile(tap("tap").from("host2").filterPacket([](const Packet *p) { return simTime()<SimTime(121) && packetHandshake(p,20); }).drop())
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { if (handshake(c,20)) finalRecords.insert(findChunk<inet::dtls::DtlsPlaintextHeader>(c.event.packet)->getSequenceNumber()); return false; }).within(200)))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(3))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(190))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedAt>SimTime(120) && app.establishedAt<SimTime(240) && finalRecords.size()>=2 && app.errorCount==0, "genuine late peer retransmission recovers retained response after sender deadline"); app.sendMarker(131); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount==1 && app.errorCount==0 && app.receivedMarkers==std::vector<int>{131}, "retained response does not repeat establishment"); }));
}
%activity:
EV << "final retention compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 200s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.profile = "psk"
*.host*.app[*].dtls.handshakeOutDelay = 10ms
*.host*.app[*].dtls.handshakeInDelay = 10ms
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host2.app[*].dtls.clientAuthentication = false
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host1.app[*].dtls.handshakeTimeout = 300s
*.host2.app[*].dtls.handshakeTimeout = 120s
%contains: stdout
PROTOCOLTEST final_retention12: PASS
