%description:

DTLS production-path variant Ipv6: see the owning reviewer document.
UDP-backed production engine; seed 0; explicit stimulus and assertions.

%includes:
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_ipv6")
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 1); }).within(6))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(3))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 1, "IPv6 client establishes after address configuration"); app.sendMarker(61); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord).within(1))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>{61}, "IPv6 preserves the protected datagram contract"); }));
}
%activity:
EV << "rfc9147_ipv6 compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 15s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.typename = "StandardHost6"
*.configurator.typename = "Ipv6FlatNetworkConfigurator"
*.host1.app[*].driver.startTime = 5s
*.host2.app[*].driver.startTime = 4.9s
%contains: stdout
PROTOCOLTEST rfc9147_ipv6: PASS
