%description:

DTLS production-path variant UnsentAck: explicit recovery/ACK-accounting requirement.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_unsent_ack")
    .intercept(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket(packetAck).nth(1).mutate([](Packet *p) {
        mutateNestedHeader<inet::dtls::DtlsAck>(p, [](auto& ack) { for (size_t i = 0; i < ack.getSequenceNumbersArraySize(); i++) ack.setSequenceNumbers(i, 65535); });
    }))
    .intercept(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { return packetHandshake(p, 20); }).nth(1).drop())
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 11); }).within(1))
    .once(on("host2.app[0].dtls").signal("packetReceivedFromLower").filterEvent(acknowledgement).within(1))
    .once(on("host2.app[0].dtls").signal("handshakeRetransmission").within(2))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(3));
}
%activity:
EV << "rfc9147_unsent_ack compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
ned-package-exclusions = inet.protocoltest.dtls.work
*.host*.app[0].dtls.profile = "certificate"
*.host2.app[0].dtls.certificateBytes = 20000B
%contains: stdout
PROTOCOLTEST rfc9147_unsent_ack: PASS
