%description:
Reuse the same issued ticket across completed reconnects. Only the first early
attempt may deliver; ordinary resumption remains available after consumption.
See early-data.md for the noncryptographic admission boundary.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static std::vector<uint8_t> firstTicket;
return ProtocolTest("rfc9147_early_data_replay")
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 4); })
        .assertEvent([](const MatchContext& c) {
            auto ticket = findChunk<inet::tls::TlsNewSessionTicket>(c.event.packet);
            for (size_t i = 0; i < ticket->getTicketArraySize(); ++i) firstTicket.push_back(ticket->getTicket(i));
            return firstTicket.size() == 16;
        }).within(1))
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .act(action().after(2.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.resumeEarly(); }))
    .meanwhile(tap("tap").from("host1").filterPacket([](const Packet *p) { return findChunk<inet::dtls::DtlsClientHello>(p) != nullptr; }).mutate([](Packet *p) {
        editClientHello(p, [](auto& hello) {
            for (size_t i = 0; i + 4 <= hello.getExtensionsArraySize();) {
                unsigned type = (hello.getExtensions(i) << 8) | hello.getExtensions(i + 1);
                unsigned size = (hello.getExtensions(i + 2) << 8) | hello.getExtensions(i + 3);
                if (type == 41) {
                    require(size >= 20, "ticket identity is framed");
                    for (size_t j = 0; j < firstTicket.size(); ++j) hello.setExtensions(i + 8 + j, firstTicket[j]);
                }
                i += 4 + size;
            }
        });
    }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1))
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.earlyResults == std::vector<bool>{true}, "first live attempt consumes early admission"); app.closePeer();
    }))
    .act(action().after(2.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.resumeEarly(48); }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.isResumed() && app.earlyResults == std::vector<bool>({true, false}), "consumed ticket resumes but cannot admit a replacement early attempt"); app.sendMarker(49);
    }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().after(0.05).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.earlyMarkers == std::vector<int>{46} && app.receivedMarkers == std::vector<int>{49}, "close did not restore early eligibility or retry rejected data");
    }));
}
%activity:
EV << "early replay compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[*].dtls.resumptionEnabled = true
*.host*.app[*].dtls.earlyDataEnabled = true
*.host*.app[*].dtls.earlyDataBytes = 64B
*.host2.app[*].dtls.cookieRequired = false
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_early_data_replay: PASS
