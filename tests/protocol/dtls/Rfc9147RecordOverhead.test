%description:

DTLS 1.3 production-path check: Rfc9147RecordOverhead. See the owning reviewer document in this suite
and plan/done/dtls.md for requirements, setup, expected result and limitations.
The test uses the real UDP-backed Dtls engine, seed 0 and explicit packet faults.

%includes:
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;

Define_ProtocolTestProgram()
{
static simtime_t first, burstAt;
return establish("rfc9147_record_overhead")
    .act(action().after(0.05).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        burstAt = simTime();
        app.sendMarker(1, 32); app.sendMarker(2, 32); app.sendMarker(3, 32);
    }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord)
        .assertEvent([](const MatchContext& c) { first = c.event.time; return first == burstAt + SimTime(0.002) && c.event.packet->getByteLength() == 54; }).within(1))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord)
        .assertEvent([](const MatchContext& c) { return c.event.time == first + SimTime(0.002) && c.event.packet->getByteLength() == 54; }).within(1))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord)
        .assertEvent([](const MatchContext& c) { return c.event.time == first + SimTime(0.004); }).within(1))
    .act(action().after(0.05).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.receivedMarkers == std::vector<int>({1, 2, 3}), "directional processing preserves admitted data");
    }));
}

%activity:
EV << "rfc9147_record_overhead compiled\n";

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[0].dtls.protectOutDelay = 2ms
*.host*.app[0].dtls.protectInDelay = 3ms
*.host*.app[0].dtls.handshakeOutDelay = 3ms
*.host*.app[0].dtls.handshakeInDelay = 4ms

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_record_overhead: PASS
