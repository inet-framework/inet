%description:
A malformed retained protected handshake produces a selected-format encrypted fatal alert.
This tests structural model dispatch and makes no cryptographic forgery claim.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static bool hit=false;
return establish12("cid_fatal12")
    .meanwhile(tap("tap").from("host1").filterPacket(packetApplication).nth(1).mutate([](Packet *p) {
        auto hs=makeShared<inet::dtls::DtlsHandshakeHeader>(); hs->setMessageType(20); hs->setMessageSequence(200); hs->setMessageLength(0); hs->setFragmentLength(0); hs->markImmutable();
        auto type=makeShared<inet::dtls::DtlsInnerContentType>(); type->setContentType(22); type->markImmutable();
        auto inner=makeShared<SequenceChunk>(); inner->insertAtBack(hs); inner->insertAtBack(type); inner->markImmutable();
        mutateNestedHeader<EncryptedChunk>(p,[inner](auto& h) { h.setChunk(inner); h.setLength(inner->getChunkLength()); });
        require(mutateHeader<inet::dtls::Dtls12CidHeader>(p,[](auto& h) { h.setLength(h.getLength()-20); }),"record length");
        require(mutateHeader<UdpHeader>(p,[](auto& h) { h.setTotalLengthField(h.getTotalLengthField()-B(20)); }),"UDP length");
        require(mutateHeader<Ipv4Header>(p,[](auto& h) { h.setTotalLengthField(h.getTotalLengthField()-B(20)); }),"IP length"); resizeTapEnvelope(p,-20); hit=true;
    }))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(177); }))
    .unordered({on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ERROR).within(1),on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto a=findChunk<inet::dtls::DtlsAlert>(c.event.packet); auto h=findChunk<inet::dtls::Dtls12CidHeader>(c.event.packet); return a && a->getLevel()==2 && a->getDescription()==50 && h && h->getEpoch()==1 && c.event.packet->getByteLength()==48; }).within(1)})
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ERROR).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(hit && app.errorCount==1 && app.maximumDatagramSize()==0,"encrypted legacy fatal reaches and ends the peer once"); }));
}
%activity:
EV << "legacy CID fatal compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 6s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.profile = "psk"
*.host*.app[*].dtls.handshakeOutDelay = 10ms
*.host*.app[*].dtls.handshakeInDelay = 10ms
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host2.app[*].dtls.clientAuthentication = false
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host*.app[*].dtls.connectionIdEnabled = true
%contains: stdout
PROTOCOLTEST cid_fatal12: PASS
