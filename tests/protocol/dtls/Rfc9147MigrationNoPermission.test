%description:
Missing permission to probe the changed peer rejects migration without replay poisoning.
%includes:
#include "DtlsHeartbeatTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static bool active = false;
static uint16_t rejectedNumber = 0;
return establish("rfc9147_migration_no_permission")
    .act(action().after(0.1).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.provideCids(1, false); }))
    .once(on("host1.app[0].dtls").signal("connectionIdsReceived").filterValue(1).within(1))
    .meanwhile(tap("tap").from("host1").filterPacket([](const Packet *p) { return packetApplication(p) && findChunk<BytesChunk>(p)->getByte(0) == 2; }).mutate([](Packet *p) { mutateHeader<inet::dtls::DtlsCiphertextHeader>(p, [](auto& h) { h.setSequenceNumber(rejectedNumber); }); }))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *) { return active; }).mutate([](Packet *p) {
        rejectedNumber = findChunk<inet::dtls::DtlsCiphertextHeader>(p)->getSequenceNumber();
        mutateHeader<UdpHeader>(p, [](auto& h) { h.setSrcPort(5534); });
    }))
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { active = true; app.rebindPort(4438); app.sendMarker(1); }))
    .once(on("host2.app[0].dtls").signal("recordDropped").filterValue(5).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.migrationResults == std::vector<bool>{false}, "local socket movement refuses missing permission despite an available spare"); active = false; app.sendMarker(2); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>{2} && app.confirmedPaths.empty() && app.errorCount == 0, "rejected path neither delivers nor poisons its reused record number"); }));
}
%activity:
EV << "migration permission compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 8s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.migrationEnabled = true
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host1.app[*].dtls.heartbeatAcceptRequests = false
%contains: stdout
PROTOCOLTEST rfc9147_migration_no_permission: PASS
