%description:
Production DTLS 1.2 boundary check with real UDP records, seed 0 and explicit faults.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return ProtocolTest("api_bounds12")
    .unordered({on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(3),on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(3)})
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.update(); app.requestCids(1); app.provideCids(1,true); app.activateCid(); app.requestAuthentication(); app.sendEarlyMarker(1); }))
    .act(action().after(0.05).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.updateResults==std::vector<bool>{false} && app.cidResults==std::vector<bool>({false,false,false}) && app.authenticationAdmissions==std::vector<bool>{false} && app.sendErrorCount==1 && app.errorCount==0, "1.3-only operations refuse without harming legacy association"); app.sendMarker(132); app.sendMarker(133);
    }))
    .act(action().after(0.1).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers==std::vector<int>({132,133}), "records below bound deliver"); }))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(134); }))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ERROR).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.maximumDatagramSize()==0 && app.errorCount==1 && app.sendErrorCount==2, "configured record bound ends handle without KeyUpdate"); }));
}
%activity:
EV << "api bounds compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 6s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.profile = "psk"
*.host*.app[*].dtls.handshakeOutDelay = 10ms
*.host*.app[*].dtls.handshakeInDelay = 10ms
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host2.app[*].dtls.clientAuthentication = false
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host1.app[*].dtls.rekeyAfterRecords = 3
%contains: stdout
PROTOCOLTEST api_bounds12: PASS
