%description:
An early operation admitted behind the client's queued Finished must be skipped
at handoff with one send error; ordinary data is unaffected. See early-data.md.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return establish("rfc9147_early_data_queued_boundary")
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .act(action().after(2.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.resumeEarly(); }))
    .once(on("host1.app[0].driver").signal("earlyDataStatus").filterValue(1).within(1))
    .act(action().after(0.01).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendEarlyMarker(48); }))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::SEND_ERROR).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.isResumed() && app.earlyResults == std::vector<bool>{true} && app.sendErrorCount == 1 && app.lastError == "DTLS early sending ended before output handoff", "Finished handoff closes early sending and skips later queued work once");
        app.sendMarker(47);
    }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.earlyMarkers == std::vector<int>{46} && app.receivedMarkers == std::vector<int>{47}, "queued early payload is neither delivered nor retried");
    }));
}
%activity:
EV << "early queued boundary compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[*].dtls.resumptionEnabled = true
*.host*.app[*].dtls.earlyDataEnabled = true
*.host*.app[*].dtls.earlyDataBytes = 64B
*.host2.app[*].dtls.cookieRequired = false
*.host1.app[*].dtls.protectOutDelay = simTime() > 2.409s && simTime() < 2.6s ? 0.1s : 0s
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_early_data_queued_boundary: PASS
