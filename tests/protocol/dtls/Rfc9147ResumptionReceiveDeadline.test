%description:
Ticket fallback through the production engine: ticket processing past its receive deadline cannot cache it. See resumption.md.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return establish("rfc9147_resumption_receive_deadline")
    .once(on("host1.app[0].dtls").signal("processingDelay").filterValue(1).within(0.1))
    .act(action().after(1.2).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .act(action().after(2.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.resumePeer(); }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(3))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.establishedCount == 2 && !app.isResumed(), "ticket processing past its receive deadline cannot cache it");
        app.sendMarker(43);
    }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.establishedCount == 2 && !app.isResumed() && app.receivedMarkers == std::vector<int>{43}, "full handshake fallback delivers application data");
    }));
}
%activity:
EV << "fallback compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 12s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[*].dtls.profile = "certificate"
*.host*.app[*].dtls.resumptionEnabled = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s

*.host1.app[*].dtls.handshakeTimeout = 0.5s
*.host1.app[*].dtls.handshakeInDelay = simTime() > 0.21s && simTime() < 0.3s ? 1s : 0s
%contains: stdout
PROTOCOLTEST rfc9147_resumption_receive_deadline: PASS
