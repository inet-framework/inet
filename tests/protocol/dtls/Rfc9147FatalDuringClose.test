%description:

A fatal alert arrives while local close_notify protection is active. Cleanup
reports one error and one close completion, cancels the old output operation and
does not later repeat either callback at the close deadline.

%includes:
#include <cmath>
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return establish("rfc9147_fatal_during_close")
    .act(action().after(0.05).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .meanwhile(never(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto a = findChunk<inet::dtls::DtlsAlert>(c.event.packet); return a && a->getDescription() == 0; }).within(0.7)))
    .once(on("host1.app[0].dtls").signal("processingDelay").filterEvent([](const MatchContext& c) { return std::abs(c.event.value - 0.1) < 1e-9; }).within(0.01))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(40, 2); }))
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord).within(0.01))
    .meanwhile(tap("tap").from("host2").filterPacket("udp.srcPort == 4433").filterPacket(packetApplication).nth(1).mutate([](Packet *p) { mutateNestedHeader<BytesChunk>(p, [](auto& b) { b.setBytes({1, 40}); }); mutateNestedHeader<inet::dtls::DtlsInnerContentType>(p, [](auto& t) { t.setContentType(21); }); }))
    .once(on("host1.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { auto t = findChunk<inet::dtls::DtlsInnerContentType>(c.event.packet); auto b = findChunk<BytesChunk>(c.event.packet); return t && t->getContentType() == 21 && b && b->getBytes() == std::vector<uint8_t>({1, 40}); }).within(0.01))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ERROR).within(0.01))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::CLOSED).within(0.001))
    .act(action().after(0.6).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.errorCount == 1 && app.closedCount == 1 && app.receivedMarkers.empty(), "fatal input completes the pending close once and cancels its later deadline and alert handoff"); }));
}
%activity:
EV << "rfc9147_fatal_during_close compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 4s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[0].dtls.protectOutDelay = simTime() < 0.25s ? 0s : 0.1s
*.host1.app[0].dtls.closeTimeout = 0.5s
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_fatal_during_close: PASS
