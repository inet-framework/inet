%description:
A fresh protected record carrying a renegotiation request receives no_renegotiation.
The retained encrypted packet is a model object, not cryptographic attack evidence.
%includes:
#include "DtlsTestUtils.h"
#include "inet/transportlayer/dtls/Dtls12HelloVerifyRequest_m.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static bool hit=false;
static Ptr<const Chunk> hello;
return ProtocolTest("renegotiation12")
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) {
        if (handshake(c,1) && !hello) { Packet copy(*c.event.packet); copy.popAtFront<inet::dtls::DtlsPlaintextHeader>(B(13)); hello=copy.peekData(); }
        return false;
    }).within(2)))
    .meanwhile(tap("tap").from("host1").copiesOnly().filterPacket([](const Packet *p) { return packetHandshake(p,20); }).nth(1).mutate([](Packet *p) {
        require(hello!=nullptr,"a real generated ClientHello is available");
        int delta=hello->getChunkLength().get<B>()-24;
        mutateNestedHeader<EncryptedChunk>(p,[](auto& h) { h.setChunk(constPtrCast<Chunk>(hello)); h.setLength(hello->getChunkLength()); });
        require(mutateHeader<inet::dtls::DtlsPlaintextHeader>(p,[delta](auto& h) { h.setSequenceNumber(1); h.setLength(h.getLength()+delta); }),"fresh full record number and length");
        mutateNestedHeader<inet::dtls::Dtls12ExplicitNonce>(p,[](auto& h) { h.setValue((uint64_t(1)<<48)|1); });
        require(mutateHeader<UdpHeader>(p,[delta](auto& h) { h.setTotalLengthField(h.getTotalLengthField()+B(delta)); }),"UDP length matches");
        require(mutateHeader<Ipv4Header>(p,[delta](auto& h) { h.setTotalLengthField(h.getTotalLengthField()+B(delta)); }),"IP length matches");
        resizeTapEnvelope(p,delta); hit=true;
    }))
    .meanwhile(tap("tap").from("host1").filterPacket([](const Packet *p) { return packetHandshake(p,20); }).nth(1).duplicate(0.5,1))
    .unordered({on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1),on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1)})
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto a=findChunk<inet::dtls::DtlsAlert>(c.event.packet); auto h=findChunk<inet::dtls::DtlsPlaintextHeader>(c.event.packet); return a && a->getLevel()==1 && a->getDescription()==100 && h && h->getEpoch()==1; }).within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(hit && app.establishedCount==1 && app.errorCount==0, "unsupported renegotiation warns without ending the handle"); app.sendMarker(142); }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers==std::vector<int>{142} && app.errorCount==0, "warning leaves ordinary delivery usable"); }));
}
%activity:
EV << "renegotiation compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 6s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.profile = "psk"
*.host*.app[*].dtls.handshakeOutDelay = 10ms
*.host*.app[*].dtls.handshakeInDelay = 10ms
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host2.app[*].dtls.clientAuthentication = false
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST renegotiation12: PASS
