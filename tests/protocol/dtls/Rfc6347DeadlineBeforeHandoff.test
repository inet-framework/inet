%description:

DTLS production-path variant DeadlineBeforeHandoff: explicit timing/reconstruction requirement.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return ProtocolTest("legacy12_deadline_before_handoff")
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ERROR).notBefore(0.69).within(0.71))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.handles.size() == 1 && app.errorCount == 1 && app.establishedCount == 0, "real open attempt expires while its first output remains queued"); }))
    .meanwhile(never(on("host1.app[0].dtls").signal("handshakeRetransmission").within(1.5)))
    .never(on("host1.app[0].dtls").signal("packetSentToLower").within(1.5));
}
%activity:
EV << "legacy12_deadline_before_handoff compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.profile = "psk"
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
ned-package-exclusions = inet.protocoltest.dtls.work
*.host1.app[0].dtls.handshakeOutDelay = 1.2s
*.host1.app[0].dtls.handshakeTimeout = 0.5s
%contains: stdout
PROTOCOLTEST legacy12_deadline_before_handoff: PASS
