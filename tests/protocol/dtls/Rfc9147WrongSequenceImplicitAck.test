%description:

A ServerHello fragment whose message sequence is outside the expected flight
must not implicitly acknowledge the client's preceding ClientHello flight.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static uint64_t originalRecord;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_wrong_sequence_implicit_ack")
    .intercept(tap("tap").from("host2").filterPacket("udp.srcPort == 4433").filterPacket([](const Packet *p) { return packetHandshake(p, 2); }).nth(1).mutate([](Packet *p) { mutateHeader<inet::dtls::DtlsHandshakeHeader>(p, [](auto& h) { h.setMessageSequence(20); h.setMessageLength(h.getMessageLength() + 1); }); }))
    .intercept(tap("tap").from("host2").filterPacket("udp.srcPort == 4433").drop())
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 1); }).assertEvent([](const MatchContext& c) { originalRecord = findChunk<inet::dtls::DtlsPlaintextHeader>(c.event.packet)->getSequenceNumber(); return true; }).within(1))
    .once(on("host1.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet); return h && h->getMessageType() == 2 && h->getMessageSequence() == 20 && h->getFragmentLength() < h->getMessageLength(); }).within(0.1))
    .unordered({
        on("host1.app[0].dtls").signal("handshakeRetransmission").within(1.1),
        on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 1); }).assertEvent([](const MatchContext& c) { auto r = findChunk<inet::dtls::DtlsPlaintextHeader>(c.event.packet); return r->getSequenceNumber() != originalRecord; }).within(1.1)
    })
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 0 && app.errorCount == 0, "wrong-sequence fragment cannot stop the preceding flight's recovery"); }));
}
%activity:
EV << "rfc9147_wrong_sequence_implicit_ack compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 3s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[0].dtls.cookieRequired = false
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_wrong_sequence_implicit_ack: PASS
