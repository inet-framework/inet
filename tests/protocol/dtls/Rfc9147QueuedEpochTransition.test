%description:

A valid KeyUpdate is queued before a represented new-epoch record arrives. Epoch
selection must be reevaluated in input-service order, so that record becomes
eligible after the preceding update rather than being discarded at arrival.

%includes:
#include <cmath>
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static std::vector<simtime_t> inputCosts;
static simtime_t updateArrival;
static uint16_t updateNumber;
static bool updateAcked = false;
Define_ProtocolTestProgram()
{
return establish("rfc9147_queued_epoch_transition")
    .act(action().after(0.2).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.establishedCount == 1, "initial handshake input service has settled"); }))
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("processingDelay").filterEvent([](const MatchContext& c) { if (std::abs(c.event.value - 0.02) < 1e-9) inputCosts.push_back(c.event.time); return false; }).within(1)))
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { auto a = findChunk<inet::dtls::DtlsAck>(c.event.packet); if (a) for (size_t i = 0; i < a->getEpochsArraySize(); ++i) if (a->getEpochs(i) == 3 && a->getSequenceNumbers(i) == updateNumber) updateAcked = true; return false; }).within(1)))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(9); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord).within(0.1))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket(packetApplication).nth(1).duplicate(0.005))
    .meanwhile(tap("tap").from("host1").copiesOnly().filterPacket("udp.srcPort == 4434").filterPacket(packetApplication).mutate([](Packet *p) {
        mutateHeader<inet::dtls::DtlsCiphertextHeader>(p, [](auto& h) { h.setEpochBits(0); h.setSequenceNumber(5); });
        mutateNestedHeader<BytesChunk>(p, [](auto& b) { b.setBytes(std::vector<uint8_t>(b.getBytes().size(), 10)); });
    }))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.update(false); }))
    .once(on("host2.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { return handshake(c, 24); }).assertEvent([](const MatchContext& c) { updateArrival = c.event.time; updateNumber = findChunk<inet::dtls::DtlsCiphertextHeader>(c.event.packet)->getSequenceNumber(); return true; }).within(0.1))
    .once(on("host2.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { auto r = findChunk<inet::dtls::DtlsCiphertextHeader>(c.event.packet); return r && r->getEpochBits() == 0 && r->getSequenceNumber() == 5; }).assertEvent([](const MatchContext& c) { return inputCosts.size() == 1 && c.event.time > updateArrival && c.event.time < inputCosts.front() + SimTime(0.02); }).within(0.01))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").filterEvent([](const MatchContext& c) { return c.event.packet->peekDataAsBytes()->getByte(0) == 10; }).within(0.1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver&) { require(inputCosts.size() == 3 && inputCosts.back() >= updateArrival + SimTime(0.02) && updateAcked, "the queued update is processed before new-epoch deprotection is charged"); })
        .run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(11); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").filterEvent([](const MatchContext& c) { return c.event.packet->peekDataAsBytes()->getByte(0) == 11; }).within(0.1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(inputCosts.size() == 4 && app.receivedMarkers == std::vector<int>({9, 10, 11}) && app.errorCount == 0, "queued represented new-epoch content and subsequent genuine sender data each deliver once"); }));
}
%activity:
EV << "rfc9147_queued_epoch_transition compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 5s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host2.app[0].dtls.protectInDelay = 0.02s
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_queued_epoch_transition: PASS
