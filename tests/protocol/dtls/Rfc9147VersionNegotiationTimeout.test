%description:
Production timeout preserves the configured version offer.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static int hellos=0;
return ProtocolTest("version_timeout")
    .meanwhile(tap("tap").from("host2").drop())
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { if (auto h=findChunk<inet::dtls::DtlsClientHello>(c.event.packet)) { ++hellos; require(hasHelloExtension(*h,43), "every retry preserves supported_versions"); } require(!findChunk<inet::dtls::DtlsCiphertextHeader>(c.event.packet), "no selected protected version on timeout"); return false; }).within(3)))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ERROR).within(3))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(hellos>=2 && app.establishedCount==0 && app.errorCount==1 && app.lastError.find("timeout")!=std::string::npos, "timeout ends the attempt without fallback"); }));
}
%activity:
EV << "version timeout compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 6s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.3 1.2"
*.host*.app[*].dtls.profile = "psk"
*.host*.app[*].dtls.handshakeOutDelay = 10ms
*.host*.app[*].dtls.handshakeInDelay = 10ms
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host2.app[*].dtls.clientAuthentication = false
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host1.app[*].dtls.handshakeTimeout = 1.5s
%contains: stdout
PROTOCOLTEST version_timeout: PASS
