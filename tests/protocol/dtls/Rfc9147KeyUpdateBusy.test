%description:

DTLS production-path variant KeyUpdateBusy: see the owning reviewer document.
UDP-backed production engine; seed 0; explicit stimulus and assertions.

%includes:
#include <cmath>
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static simtime_t originalHandoff, nextDeadline;
static bool dropAcks = true;
Define_ProtocolTestProgram()
{
return establish("rfc9147_key_update_busy")
    .act(action().after(0.05).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.update(); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 24); }).assertEvent([](const MatchContext& c) { originalHandoff = c.event.time; return true; }).within(1))
    .meanwhile(tap("tap").from("host2").filterPacket("udp.srcPort == 4433").filterPacket([](const Packet *p) { return dropAcks && packetAckForEpoch(p, 3); }).drop())
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").assertEvent([](const MatchContext& c) { nextDeadline = c.event.time + std::min(SimTime(60), 2 * (c.event.time - originalHandoff)); return true; }).within(2))
    .act(action().after(0.001).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.update(); }))
    .act(action().after(0.0001).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.updateResults == std::vector<bool>({true, false}) && app.errorCount == 0, "busy update is synchronously rejected without terminal error"); }))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").assertEvent([](const MatchContext& c) { return std::abs((c.event.time - nextDeadline).dbl()) < 0.00001; }).within(3))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver&) { dropAcks = false; }))
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent(acknowledgement).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(28); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.receivedMarkers == std::vector<int>{28}, "busy request leaves original recovery and subsequent application progress intact"); }));
}
%activity:
EV << "rfc9147_key_update_busy compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_key_update_busy: PASS
