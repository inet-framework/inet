%description:
Lost response ACKs retain the first response while a second distinct context succeeds; duplicates do not repeat logical verification.
%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static int logical = 0, certificates = 0;
static bool dropAcks = true;
return establish("pha_ackloss")
    .meanwhile(tap("tap").from("host2").filterPacket([](const Packet *p) { return dropAcks && packetAckForEpoch(p, 3); }).drop())
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("processingDelay").filterEvent([](const MatchContext& c) { if (std::abs(c.event.value - 0.03) < 1e-9) ++logical; return false; }).within(8)))
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { if (handshake(c, 11)) ++certificates; return false; }).within(8)))
    .act(action().after(0.1).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.requestAuthentication(); }))
    .once(on("host2.app[0].driver").signal("authenticationResult").filterValue(1).within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { app.requestAuthentication(); }))
    .once(on("host2.app[0].driver").signal("authenticationResult").filterValue(1).within(1))
    .act(action().after(1.3).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.authenticationResults == std::vector<bool>({true,true}) && app.authenticationAdmissions == std::vector<bool>({true,true}) && logical == 6 && certificates >= 4, "two independent response owners recover without duplicate logical verification");
        dropAcks = false;
        app.sendMarker(74);
    }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().after(3.2).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(app.errorCount == 0 && app.authenticationResults.empty() && app.receivedMarkers == std::vector<int>{74}, "late ACK cleanup preserves the client association"); }));
}
%activity:
EV << "PHA check compiled\n";
%inifile: omnetpp.ini
[General]
*.host2.app[*].dtls.handshakeInDelay = 30ms
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.profile = "certificate"
*.host*.app[*].dtls.postHandshakeAuthEnabled = true
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s

%contains: stdout
PROTOCOLTEST pha_ackloss: PASS
