%description:
Close cancels an outstanding probe; reconnect uses a fresh token and new recovery state.
%includes:
#include "DtlsHeartbeatTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static std::set<std::vector<uint8_t>> tokens;
static int results = 0;
return establish("rfc9147_heartbeat_lifecycle")
    .meanwhile(tap("tap").from("host2").filterPacket([](const Packet *p) { return packetHeartbeat(p, 2); }).nth(1).drop())
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) {
        if (heartbeat(c, 1)) { auto h = findChunk<inet::dtls::DtlsHeartbeat>(c.event.packet); std::vector<uint8_t> payload; for (size_t i = 0; i < h->getPayloadArraySize(); ++i) payload.push_back(h->getPayload(i)); tokens.insert(payload); }
        return false;
    }).within(6)))
    .meanwhile(anyNumberOfTimes(on("host1.app[0].dtls").signal("probeResult").filterEvent([](const MatchContext&) { ++results; return false; }).within(6)))
    .act(action().after(0.1).run<ProbeDtls>("host1.app[0].dtls", [](ProbeDtls& dtls) { dtls.probePeer(); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return heartbeat(c, 1); }).within(0.1))
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return heartbeat(c, 2); }).within(0.1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::CLOSED).within(3))
    .act(action().after(1.2).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { require(results == 0, "closed probe emits no late timeout"); app.reopenPeer(); }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1))
    .act(action().after(0.1).run<ProbeDtls>("host1.app[0].dtls", [](ProbeDtls& dtls) { dtls.probePeer(); }))
    .once(on("host1.app[0].dtls").signal("probeResult").filterValue(inet::dtls::IDtls::PROBE_SUCCEEDED).within(0.1))
    .act(action().run<ProbeDtls>("host1.app[0].dtls", [](ProbeDtls& dtls) { require(dtls.probeAdmissions == std::vector<bool>({true,true}) && results == 1 && tokens.size() == 2, "reconnect has a fresh token and one successful completion"); }));
}
%activity:
EV << "heartbeat lifecycle compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 8s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsHeartbeatTestApp"
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host2.app[*].dtls.udpPayloadLimit = 512B
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host1.app[*].dtls.probeTimeout = 1s
%contains: stdout
PROTOCOLTEST rfc9147_heartbeat_lifecycle: PASS
