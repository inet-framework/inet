%description:
Heartbeat is negotiated with SHA-384 certificate-origin ticket resumption,
early data and CID. A correlated probe succeeds after the resumed handshake.
%includes:
#include "DtlsHeartbeatTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return establish("rfc9147_heartbeat_resumption")
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.closePeer(); }))
    .act(action().after(2.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.resumeEarly(); app.sendEarlyMarker(48, 33); }))
    .meanwhile(tap("tap").from("host1").filterPacket(packetApplication).nth(1).duplicate(0.0001, 2))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord)
        .assertEvent([](const MatchContext& c) { return protectedRecord(c, 1); }).within(1))
    .once(on("host2.app[0].driver").signal("earlyDataReceived").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.earlyMarkers == std::vector<int>{46} && app.receivedMarkers.empty() && app.establishedCount == 1, "marked early delivery precedes the second handshake's completion");
    }))
    .once(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.isResumed() && app.earlyResults == std::vector<bool>{true} && app.sendErrorCount == 1, "resumption, early admission and local byte-limit refusal have separate outcomes");
        app.sendMarker(47);
    }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().after(0.05).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.earlyMarkers == std::vector<int>{46} && app.receivedMarkers == std::vector<int>{47}, "ordinary delivery never retries the early datagram");
    }))
    .act(action().run<ProbeDtls>("host1.app[0].dtls", [](ProbeDtls& dtls) { dtls.probePeer(); }))
    .once(on("host1.app[0].dtls").signal("probeResult").filterValue(inet::dtls::IDtls::PROBE_SUCCEEDED).within(0.1))
    .act(action().run<ProbeDtls>("host1.app[0].dtls", [](ProbeDtls& dtls) { require(dtls.probeAdmissions == std::vector<bool>{true}, "heartbeat is renegotiated on the resumed early-data association"); }));
}
%activity:
EV << "early data compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsHeartbeatTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host*.app[*].dtls.resumptionEnabled = true
*.host*.app[*].dtls.earlyDataEnabled = true
*.host*.app[*].dtls.earlyDataBytes = 64B
*.host2.app[*].dtls.cookieRequired = false
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.cipherSuites = "TLS_AES_256_GCM_SHA384"
*.host*.app[*].dtls.profile = "certificate"
*.host*.app[*].dtls.certificateBytes = 32B
%contains: stdout
PROTOCOLTEST rfc9147_heartbeat_resumption: PASS
