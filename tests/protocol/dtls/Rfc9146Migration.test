%description:
Bidirectional UDP port translation models NAT rebinding. CID retains the handle,
ordinary output uses the old mapping until a fresh heartbeat validates the new one.
%includes:
#include "DtlsHeartbeatTestUtils.h"
#include "inet/transportlayer/common/L4PortTag_m.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
static int translatedOut = 0, translatedIn = 0, probes = 0;
static std::vector<int> outputPorts;
static uint64_t handle;
static bool active = false;
return establish12("legacy_migration")
    .meanwhile(tap("tap").from("host2").filterPacket("udp.destPort == 4434").filterPacket([](const Packet *p) {
        if (active && packetApplication(p)) outputPorts.push_back(4434);
        return active;
    }).drop())
    .meanwhile(tap("tap").from("host2").filterPacket("udp.destPort == 5534").filterPacket([](const Packet *) { return active; }).mutate([](Packet *p) {
        if (packetApplication(p)) outputPorts.push_back(5534);
        if (packetHeartbeat(p, 1)) ++probes;
        mutateHeader<UdpHeader>(p, [](auto& h) { h.setDestPort(4434); }); ++translatedIn;
    }))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *) { return active; }).mutate([](Packet *p) { mutateHeader<UdpHeader>(p, [](auto& h) { h.setSrcPort(5534); }); ++translatedOut; }))
    .act(action().after(0.1).run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { active = true; handle = app.lastHandle(); app.sendMarker(1); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(app.confirmedPaths.empty(), "candidate data does not immediately move output"); app.sendMarker(99); }))
    .once(on("host2.app[0].driver").signal("pathChanged").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.establishedCount == 1 && app.confirmedPaths.size() == 1 && app.confirmedPaths[0].peerPort == 5534 && app.errorCount == 0, "validated mapping changes endpoints without a new handshake");
        app.sendMarker(2);
    }))
    .once(on("host1.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) {
        require(app.lastHandle() == handle && app.establishedCount == 1 && app.receivedMarkers == std::vector<int>{2} && app.errorCount == 0, "actual UDP delivery succeeds through the new mapping with a stable handle");
        require(outputPorts == std::vector<int>({4434,5534}) && probes == 1 && translatedOut >= 2 && translatedIn >= 2, "old ordinary output is suppressed by NAT, while validation and confirmed output use both translation directions");
    }));
}
%activity:
EV << "migration compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 8s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host*.app[*].dtls.versions = "1.2"
*.host*.app[*].dtls.connectionIdEnabled = true
*.host*.app[*].dtls.heartbeatEnabled = true
*.host*.app[*].dtls.migrationEnabled = true
*.host*.app[*].dtls.protectOutDelay = 5ms
*.host*.app[*].dtls.protectInDelay = 3ms
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST legacy_migration: PASS
