%description:

DTLS 1.3 production-path check: Rfc9147KeyUpdate. See the owning reviewer document in this suite
and plan/done/dtls.md for requirements, setup, expected result and limitations.
The test uses the real UDP-backed Dtls engine, seed 0 and explicit packet faults.

%includes:
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;

Define_ProtocolTestProgram()
{
static uint16_t original;
return establish("rfc9147_key_update")
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.update(); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 24); })
        .assertEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsCiphertextHeader>(c.event.packet); original = h->getSequenceNumber(); return h->getEpochBits() == 3; }).within(1))
    .meanwhile(tap("tap").from("host2").filterPacket("udp.srcPort == 4433").filterPacket([](const Packet *p) { return packetAckForEpoch(p, 3); }).nth(1).drop().describe("lose KeyUpdate ACK"))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(4); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 24); })
        .assertEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsCiphertextHeader>(c.event.packet); return h->getEpochBits() == 3 && h->getSequenceNumber() != original; }).within(3))
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent(acknowledgement).within(1))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord)
        .assertEvent([](const MatchContext& c) { return protectedRecord(c, 0); }).within(1))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.receivedMarkers == std::vector<int>{4}, "queued application send resumes once in new epoch after update ACK");
    }));
}

%activity:
EV << "rfc9147_key_update compiled\n";

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_key_update: PASS
