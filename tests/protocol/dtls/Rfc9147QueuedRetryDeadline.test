%description:

Fragment only the real initial ClientHello at the tap. A long link round trip and
0.8s input cost place the complete retry ClientHello before the original2s deadline
but its processing completion after it. Expiry must cancel the queued retry.

%includes:
#include "DtlsFragmentTestUtils.h"
#include <cmath>
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
static simtime_t firstArrival, retryIssue, retryArrival;
static bool retryQueued = false;
static bool retryServiceStarted = false;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_queued_retry_deadline")
    .meanwhile(anyNumberOfTimes(on("host2.app[0].dtls").signal("processingDelay").filterEvent([](const MatchContext& c) {
        if (std::abs(c.event.value - 0.8) < 1e-9) { EV << "observed queued-retry input service at " << c.event.time << "\n"; if (retryQueued && c.event.time >= retryArrival && c.event.time < firstArrival + SimTime(2) && c.event.time + SimTime(0.8) > firstArrival + SimTime(2)) retryServiceStarted = true; }
        return false;
    }).within(5)))
    .intercept(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { return packetHandshake(p, 1); }).nth(1).mutate([](Packet *p) { packClientHello(p); }))
    .intercept(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(p); return h && h->getMessageType() == 1 && h->getMessageSequence() == 0; }).drop())
    .intercept(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { return retryQueued && packetHandshake(p, 1); }).drop())
    .meanwhile(never(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ACCEPTED).within(5)))
    .meanwhile(never(on("host2.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ESTABLISHED).within(5)))
    .meanwhile(never(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet); return h && h->getMessageType() == 2 && h->getMessageSequence() != 0; }).within(5)))
    .once(on("host2.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet); return h && h->getMessageType() == 1 && h->getMessageSequence() == 0; }).assertEvent([](const MatchContext& c) { firstArrival = c.event.time; return true; }).within(1))
    .once(on("host2.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 2); }).assertEvent([](const MatchContext& c) { retryIssue = c.event.time; return retryIssue >= firstArrival + SimTime(0.799); }).within(1))
    .once(on("host2.app[0].dtls").signal("packetReceivedFromLower").filterEvent([](const MatchContext& c) { auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet); return h && h->getMessageType() == 1 && h->getMessageSequence() == 1; }).assertEvent([](const MatchContext& c) {
        auto h = findChunk<inet::dtls::DtlsHandshakeHeader>(c.event.packet);
        retryArrival = c.event.time; retryQueued = true;
        return h->getFragmentOffset() == 0 && h->getFragmentLength() == h->getMessageLength() && retryArrival < firstArrival + SimTime(2) && retryArrival + SimTime(0.8) > firstArrival + SimTime(2);
    }).within(1))
    .act(action().after(2.2).run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) { require(retryServiceStarted, "complete retry positively starts its configured input service before cancellation"); require(simTime() > retryIssue + SimTime(2) && app.acceptedEndpoints.empty() && app.establishedCount == 0, "queued complete retry cannot outlive the original attempt deadline or restart it at cookie issue"); }));
}
%activity:
EV << "rfc9147_queued_retry_deadline compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 6s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 200ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[0].dtls.handshakeTimeout = 10s
*.host2.app[0].dtls.handshakeInDelay = 0.8s
*.host2.app[0].dtls.handshakeTimeout = 2s
*.host2.app[0].dtls.udpPayloadLimit = 64B
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_queued_retry_deadline: PASS
