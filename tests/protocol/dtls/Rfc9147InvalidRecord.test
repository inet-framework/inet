%description:

DTLS 1.3 production-path check: Rfc9147InvalidRecord. See the owning reviewer document in this suite
and plan/pending/dtls.md for requirements, setup, expected result and limitations.
The test uses the real UDP-backed Dtls engine, seed 0 and explicit packet faults.

%includes:
#include "DtlsTestUtils.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;

Define_ProtocolTestProgram()
{
return establish("rfc9147_invalid_record")
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(1); }))
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent(applicationRecord).within(1))
    .meanwhile(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").filterPacket([](const Packet *p) { return packetApplication(p); }).nth(1).mutate([](Packet *packet) {
        require(mutateHeader<inet::dtls::DtlsCiphertextHeader>(packet, [](inet::dtls::DtlsCiphertextHeader& h) { h.setEpochBits(1); }), "fault targets an actual protected record");
    }))
    .once(on("host2.app[0].dtls").signal("recordDropped").within(1))
    .act(action().run<DtlsTestDriver>("host1.app[0].driver", [](DtlsTestDriver& app) { app.sendMarker(2); }))
    .once(on("host2.app[0].driver").signal("packetSentToUpper").within(1))
    .act(action().run<DtlsTestDriver>("host2.app[0].driver", [](DtlsTestDriver& app) {
        require(app.receivedMarkers == std::vector<int>{2}, "unknown epoch is discarded and valid following record is delivered");
        require(app.errorCount == 0, "invalid record does not destroy the established association");
    }));
}

%activity:
EV << "rfc9147_invalid_record compiled\n";

%inifile: omnetpp.ini

[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
ned-package-exclusions = inet.protocoltest.dtls.work
sim-time-limit = 10s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true

*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
%contains: stdout
PROTOCOLTEST rfc9147_invalid_record: PASS
