%description:

DTLS production-path variant HandshakeBackoff: explicit recovery/ACK-accounting requirement.

%includes:
#include "DtlsTestUtils.h"
%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::protocoltest::dtls;
Define_ProtocolTestProgram()
{
return ProtocolTest("rfc9147_handshake_backoff")
    .intercept(tap("tap").from("host1").filterPacket("udp.srcPort == 4434").drop())
    .once(on("host1.app[0].dtls").signal("packetSentToLower").filterEvent([](const MatchContext& c) { return handshake(c, 1); }).within(1))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(0.99).within(1.01))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(1.99).within(2.01))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(3.99).within(4.01))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(7.99).within(8.01))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(15.99).within(16.01))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(31.99).within(32.01))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(59.99).within(60.01))
    .once(on("host1.app[0].dtls").signal("handshakeRetransmission").notBefore(59.99).within(60.01))
    .once(on("host1.app[0].driver").signal("controlStateChanged").filterValue(DtlsTestDriver::ERROR).within(7.1))
    .never(on("host1.app[0].dtls").signal("handshakeRetransmission").within(61));
}
%activity:
EV << "rfc9147_handshake_backoff compiled\n";
%inifile: omnetpp.ini
[General]
network = inet.protocoltest.TapPairNetwork
ned-path = .;../..;../../../lib;../../../../../src
sim-time-limit = 500s
seed-set = 0
**.checksumMode = "declared"
**.fcsMode = "declared"
**.ipv4.arp.typename = "GlobalArp"
*.linkDelay = 1ms
*.host*.numApps = 1
*.host*.app[*].typename = "inet.protocoltest.dtls.DtlsTestApp"
*.host1.app[*].server = false
*.host2.app[*].server = true
*.host1.app[*].driver.startTime = 0.2s
*.host2.app[*].driver.startTime = 0.1s
ned-package-exclusions = inet.protocoltest.dtls.work
*.host1.app[0].dtls.handshakeTimeout = 190s
%contains: stdout
PROTOCOLTEST rfc9147_handshake_backoff: PASS
