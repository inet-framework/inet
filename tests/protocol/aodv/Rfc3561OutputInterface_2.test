%description:
RFC 3561 sections 6.3 and 6.11: OutputInterface_2 through UDP/IP and real data hooks.
See discovery-ownership.md for the scenario, parent assertion and coverage limits.

%file: Peer.cc
#include "../../AodvDiscoveryPeer.h"

%file: test.ned
import inet.applications.contract.IApp;
import inet.node.inet.AdhocHost;
import inet.node.aodv.AodvRouter;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.physicallayer.wireless.common.medium.UnitDiskRadioMedium;
simple AodvDiscoveryPeer like IApp
{
    parameters:
        string scenario = default("OutputConstraints");
        @class(::AodvDiscoveryPeer);
        double startTime @unit(s) = default(1.2s);
        int incompatibleIndex = default(-1);
    gates:
        input socketIn;
        output socketOut;
}
simple AodvDataSource like IApp
{
    parameters:
        @class(::AodvDataSource);
        string destinations = default("10.0.0.99 10.0.0.98");
        double emitTime @unit(s) = default(0.16s);
        int incompatibleIndex = default(-1);
        bool constrainNextHop = default(false);
        string nextHop = default("");
    gates:
        input socketIn;
        output socketOut;
}
network AodvTest
{
    submodules:
        configurator: Ipv4NetworkConfigurator;
        radioMedium: UnitDiskRadioMedium;
        dut: AodvRouter;
        peer: AdhocHost;
        wrongPeer: AdhocHost;
}

%inifile: omnetpp.ini
[General]
network = AodvTest
ned-path = .;../../../../../src;../../../lib
sim-time-limit = 2.2s
seed-set = 0
cmdenv-express-mode = true
**.vector-recording = false
*.configurator.addStaticRoutes = false
*.configurator.addDefaultRoutes = false
*.configurator.addSubnetRoutes = false
*.configurator.config = xml("<config><interface hosts='dut' names='wlan0' address='10.0.0.1' netmask='255.255.255.0'/><interface hosts='dut' names='wlan1' address='10.1.0.1' netmask='255.255.255.0'/><interface hosts='wrongPeer' names='wlan0' address='10.0.0.99' netmask='255.255.255.0'/><interface hosts='wrongPeer' names='wlan1' address='10.0.0.3' netmask='255.255.255.0'/><interface hosts='peer' address='10.0.0.2' netmask='255.255.255.0'/></config>")
*.dut.aodv.jitter = 0s
*.dut.aodv.periodicJitter = 0s
*.dut.aodv.useHelloMessages = false
*.peer.app[0].scenario = "OutputConstraints"
*.dut.aodv.rreqRatelimit = 1
*.peer.app[0].incompatibleIndex = 2
*.dut.app[0].incompatibleIndex = 2
*.dut.app[0].constrainNextHop = false
*.dut.app[0].destinations = "10.0.0.99 10.0.0.99 10.0.0.99"
*.dut.numWlanInterfaces = 2
*.wrongPeer.numWlanInterfaces = 2
*.wrongPeer.numApps = 1
*.wrongPeer.app[0].typename = "UdpSink"
*.wrongPeer.app[0].localPort = 12345
*.wrongPeer.forwarding = false
*.radioMedium.sameTransmissionStartTimeCheck = "ignore"

*.dut.numApps = 1
*.peer.forwarding = false
*.dut.app[0].typename = "AodvDataSource"
*.peer.numApps = 2
*.peer.app[1].typename = "UdpSink"
*.peer.app[1].localPort = 12345
*.peer.app[0].typename = "AodvDiscoveryPeer"
**.arp.typename = "GlobalArp"
**.wlan[*].typename = "AckingWirelessInterface"
**.wlan[*].radio.typename = "GenericUnitDiskRadio"
**.wlan[*].bitrate = 1Mbps
**.wlan[*].radio.transmitter.analogModel.communicationRange = 100m
**.wlan[*].radio.transmitter.headerLength = 4b
**.wlan[*].mac.headerLength = 20B
**.mobility.typename = "StationaryMobility"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initialX = 10m
**.mobility.initialY = 10m
**.mobility.initialZ = 0m

%contains: stdout
AODV OutputConstraints: PASS


