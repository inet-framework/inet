%description:
RFC 3561 sections 6.11/6.12: error state, notifications and actual precursor delivery.

%file: Peer.cc
#include "../../AodvInterfacesPeer.h"

%file: test.ned
import inet.applications.contract.IApp;
import inet.node.inet.AdhocHost;
import inet.node.aodv.AodvRouter;
import inet.routing.aodv.Aodv;
import inet.networklayer.ipv4.Ipv4;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.physicallayer.wireless.common.medium.UnitDiskRadioMedium;
simple AodvDataSource like IApp
{
    parameters:
        string destinations = default("10.0.0.99");
        double emitTime @unit(s) = default(0.16s);
        int localPort = default(12345);
        string nextHop = default("10.0.0.1");
        string outputInterface = default("wlan1");
        @class(::AodvDataSource);
    gates:
        input socketIn;
        output socketOut;
}
simple AodvInterfacesPeer like IApp
{
    parameters:
        string scenario = default("Control");
        double startTime @unit(s) = default(0.01s);
        @class(::AodvInterfacesPeer);
    gates:
        input socketIn;
        output socketOut;
}
simple AodvInterfaceIpv4 extends Ipv4
{
    parameters:
        @class(::AodvInterfaceIpv4);
}
simple AodvInterfaceIngress
{
    parameters:
        @class(::AodvInterfaceIngress);
    gates:
        input in;
        output out;
}
module InterfaceRouter extends AdhocHost
{
    submodules:
        aodv: Aodv;
        ingressFilter: AodvInterfaceIngress;
    connections:
        aodv.socketOut --> at.in++;
        aodv.socketIn <-- ingressFilter.out;
        ingressFilter.in <-- at.out++;
}
network AodvTest
{
    submodules:
        configurator: Ipv4NetworkConfigurator;
        radioMedium: UnitDiskRadioMedium;
        radioMedium1: UnitDiskRadioMedium;
        radioMedium2: UnitDiskRadioMedium;
        dut: InterfaceRouter;
        peer: AdhocHost;
}

%inifile: omnetpp.ini
[General]
network = AodvTest
ned-path = .;../../../../../src;../../../lib
sim-time-limit = 1.5s
seed-set = 0
cmdenv-express-mode = true
**.vector-recording = false
*.configurator.addStaticRoutes = false
*.peer.forwarding = false
*.configurator.addDefaultRoutes = false
*.configurator.addSubnetRoutes = false
*.configurator.config = xml("<config><interface hosts='dut' names='wlan0' address='10.0.0.1' netmask='255.255.255.0'/><interface hosts='dut' names='wlan1' address='10.1.0.1' netmask='255.255.255.0'/><interface hosts='dut' names='wlan2' address='10.2.0.1' netmask='255.255.255.0'/><interface hosts='peer' names='wlan0' address='10.0.0.2' netmask='255.255.255.0'/><interface hosts='peer' names='wlan1' address='10.1.0.2' netmask='255.255.255.0'/><interface hosts='peer' names='wlan2' address='10.2.0.2' netmask='255.255.255.0'/><interface hosts='peer' names='wlan3' address='10.0.0.3' netmask='255.255.255.0'/></config>")
*.dut.aodv.jitter = 0s
*.dut.aodv.periodicJitter = 0s
*.dut.aodv.useHelloMessages = false
*.peer.numApps = 1
*.peer.numWlanInterfaces = 4
*.dut.numWlanInterfaces = 3
*.dut.aodv.interfaces = "wlan1 wlan0"
*.dut.aodv.rreqRatelimit = 1
*.dut.aodv.rerrRatelimit = 1
*.dut.aodv.netDiameter = 1
*.dut.aodv.ttlStart = 1
*.dut.aodv.ttlThreshold = 1
*.dut.aodv.rreqRetries = 0
*.dut.aodv.nodeTraversalTime = 0.01s
*.dut.aodv.activeRouteTimeout = 0.5s
*.dut.aodv.helloInterval = 0.1s
*.dut.aodv.deletePeriod = 2s
*.dut.aodv.blacklistTimeout = 1s
*.dut.aodv.nextHopWait = 0.05s
*.dut.ipv4.ip.typename = "AodvInterfaceIpv4"
*.peer.app[0].scenario = "SelfSecondaryPrimaryIngress"
*.dut.numApps = 0
*.radioMedium.sameTransmissionStartTimeCheck = "ignore"
*.peer.app[0].typename = "AodvInterfacesPeer"
*.dut.wlan[1].radio.radioMediumModule = "radioMedium1"
*.peer.wlan[1].radio.radioMediumModule = "radioMedium1"
*.dut.wlan[2].radio.radioMediumModule = "radioMedium2"
*.peer.wlan[2].radio.radioMediumModule = "radioMedium2"
**.arp.typename = "GlobalArp"
**.wlan[*].typename = "AckingWirelessInterface"
**.wlan[*].radio.typename = "GenericUnitDiskRadio"
**.wlan[*].bitrate = 1Mbps
**.wlan[*].radio.transmitter.analogModel.communicationRange = 100m
**.wlan[*].radio.transmitter.headerLength = 4b
**.wlan[*].mac.headerLength = 20B
**.mobility.typename = "StationaryMobility"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initialX = 10m
**.mobility.initialY = 10m
**.mobility.initialZ = 0m

%contains: stdout
AODV InterfacesSelfSecondaryPrimaryIngress: PASS
