%description:
Infrastructure gateway ExternalIpv6Expiry: native AODV authority through UDP/IP, Ethernet members and real address resolution.
See infrastructure-gateway.md for the exact assertion and coverage limits.

%file: Peer.cc
#include "../../AodvSubnetAuthorityPeer.h"

%file: test.ned
import inet.applications.contract.IApp;
import inet.node.inet.AdhocHost;
import inet.node.inet.StandardHost;
import inet.node.inet.Router;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ethernet.Eth100M;
import inet.routing.aodv.Aodv;
import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.physicallayer.wireless.common.medium.UnitDiskRadioMedium;

simple AuthorityAodv extends Aodv
{
    parameters:
        @lifecycleSupport;
}
module AuthorityRouter extends AdhocHost
{
    submodules:
        aodv: AuthorityAodv;
    connections:
        aodv.socketOut --> at.in++;
        aodv.socketIn <-- at.out++;
}
simple AodvSubnetAuthorityPeer like IApp
{
    parameters:
        string scenario;
        bool ipv6 = default(false);
        bool election = default(false);
        bool external = default(false);
        @class(::AodvSubnetAuthorityPeer);
    gates:
        input socketIn;
        output socketOut;
}
network AuthorityNetwork
{
    submodules:
        configurator: Ipv6NetworkConfigurator;
        radioMedium: UnitDiskRadioMedium;
        dut: AuthorityRouter;
        dut2: AuthorityRouter;
        peer: AdhocHost;
        member: StandardHost;
        member2: StandardHost;
        lan: EthernetSwitch;
        gateway: Router;
        externalLan: EthernetSwitch;
    connections:
        dut.ethg++ <--> Eth100M <--> lan.ethg++;
        dut2.ethg++ <--> Eth100M <--> lan.ethg++;
        gateway.ethg++ <--> Eth100M <--> lan.ethg++;
        gateway.ethg++ <--> Eth100M <--> externalLan.ethg++;
        member.ethg++ <--> Eth100M <--> externalLan.ethg++;
        member2.ethg++ <--> Eth100M <--> externalLan.ethg++;
}

%inifile: omnetpp.ini
[General]
network = AuthorityNetwork
ned-path = .;../../../../../src;../../../lib
sim-time-limit = 1.4s
seed-set = 0
cmdenv-express-mode = false
**.cmdenv-log-level = debug
**.vector-recording = false
**.ipv6.neighbourDiscovery.routerBootupTime = 0s
**.ipv6.neighbourDiscovery.hostBootupTime = 0s
**.ipv6.neighbourDiscovery.dupAddrDetectTransmits = 0
*.configurator.addStaticRoutes = false
*.configurator.addDefaultRoutes = false
*.configurator.addDirectRoutes = false
*.configurator.config = xml("<config><interface hosts='dut' names='wlan0' address='2001:db8:1::1' prefix='2001:db8:1::/64' dupAddrDetectTransmits='0'/><interface hosts='dut2' names='wlan0' address='2001:db8:1::4' prefix='2001:db8:1::/64' dupAddrDetectTransmits='0'/><interface hosts='peer' names='wlan0' address='2001:db8:1::2' prefix='2001:db8:1::/64' dupAddrDetectTransmits='0'/><interface hosts='dut' names='eth0' address='2001:db8:8::1' prefix='2001:db8:8::/64' dupAddrDetectTransmits='0'/><interface hosts='dut2' names='eth0' address='2001:db8:8::2' prefix='2001:db8:8::/64' dupAddrDetectTransmits='0'/><interface hosts='member' names='eth0' address='2001:db8:9::99' prefix='2001:db8:9::/64' dupAddrDetectTransmits='0'/><interface hosts='member2' names='eth0' address='2001:db8:9::100' prefix='2001:db8:9::/64' dupAddrDetectTransmits='0'/><interface hosts='gateway' names='eth0' address='2001:db8:8::fe' prefix='2001:db8:8::/64' dupAddrDetectTransmits='0'/><interface hosts='gateway' names='eth1' address='2001:db8:9::1' prefix='2001:db8:9::/64' dupAddrDetectTransmits='0'/></config>")
*.dut*.numEthInterfaces = 1
*.dut*.numApps = 0
*.dut*.forwarding = true
*.dut*.aodv.jitter = 0s
*.dut*.aodv.periodicJitter = 0s
*.dut*.aodv.useHelloMessages = false
*.dut*.aodv.subnetExtensionType = 253
*.dut*.aodv.subnetAnnouncementInterval = 0.05s
*.dut*.aodv.subnetAnnouncementDelay = 0.01s
*.dut*.aodv.netDiameter = 10
*.dut*.aodv.ttlStart = 1
*.dut*.aodv.ttlThreshold = 2
*.dut*.aodv.rreqRetries = 0
*.dut*.aodv.nodeTraversalTime = 0.01s
*.dut*.aodv.activeRouteTimeout = 0.2s
*.dut*.aodv.deletePeriod = 0.4s
*.dut.aodv.externalSubnets = xml("<subnets><subnet prefix='2001:db8:9::/64' interface='eth0'/></subnets>")
*.dut2.aodv.externalSubnets = xml("<subnets></subnets>")
*.peer.numApps = 1
*.peer.app[0].typename = "AodvSubnetAuthorityPeer"
*.peer.app[0].scenario = "ExternalIpv6Expiry"
*.peer.app[0].ipv6 = true
*.peer.app[0].election = false
*.peer.app[0].external = true
*.member*.numApps = 1
*.member*.app[0].typename = "UdpSink"
