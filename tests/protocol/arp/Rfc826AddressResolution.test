%description:

RFC 826 -- a host that has no hardware address for a neighbour broadcasts a request.

Checks RFC826-REQ-1 (must), RFC826-REQ-4, RFC826-REQ-6 and RFC1122-AUSE-1 (must) from
doc/project/evidence/standard/rfc826/catalog.md and
doc/project/evidence/standard/rfc1122/catalog.md. It also covers RFC826-FMT-3, RFC826-FMT-5
and RFC826-TABLE-2. The English procedure is in
doc/project/evidence/protocol/arp/checks/resolution.md#address-resolution; the program steps
below map onto its expected observations. Mapping of the pair mockup: host A = hostA,
host B = hostB.

Expected observations 1, 2 and 3 describe one packet -- the request at host A's interface --
so they are one program step with the assertions of all three: the frame's type field is
that of ARP and not of IPv4, the opcode is that of a request, the sender fields hold the addresses of host A, the
target protocol address holds the address of host B, and the frame goes to the hardware
broadcast address. The remaining two steps are observations 4 and 5.

The addresses come from the hosts themselves and not from this file, so the check does not
depend on the numbering that the configurator chose.

The frame fields are read through the chunk class name, EthernetMacHeader, and not through
the protocol name. A protocol name resolves to the last chunk of that protocol in the
packet, which for an Ethernet frame is the frame check sequence.

%includes:
#include "ProtocolTest.h"
#include "ArpMutations.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc826_address_resolution")
        // Expected observations 1, 2 and 3: the request that host A puts on the link, with
        // its field values and its broadcast frame (RFC826-REQ-1, REQ-4, REQ-6, FMT-3,
        // FMT-5, TABLE-2, RFC1122-AUSE-1).
        .once(on("hostA.eth[0].mac").signal("packetSentToLower")
                  .packet("arp.opcode == 1 && EthernetMacHeader.typeOrLength == 2054")
                  .match([](const MatchContext& c) {
                      auto packet = c.event.packet;
                      return macAddressField(packet, "arp.srcMacAddress") == interfaceMacAddress("hostA.eth[0]").str()
                             && ipv4AddressField(packet, "arp.srcIpAddress") == interfaceIpv4Address("hostA.eth[0]").str()
                             && ipv4AddressField(packet, "arp.destIpAddress") == interfaceIpv4Address("hostB.eth[0]").str()
                             && macAddressField(packet, "EthernetMacHeader.dest") == MacAddress::BROADCAST_ADDRESS.str();
                  })
                  .describe("an ARP request from host A for the address of host B, broadcast, with host A in the sender fields")
                  .within(0.5))
        // Expected observation 4: the request reaches host B.
        .once(on("hostB.eth[0].mac").signal("packetReceivedFromLower")
                  .packet("arp.opcode == 1")
                  .describe("the request at host B's interface")
                  .within(0.1))
        // Expected observation 5: host B answers, and the datagram of host A then arrives.
        .once(on("hostB.eth[0].mac").signal("packetSentToLower")
                  .packet("arp.opcode == 2")
                  .describe("host B's reply")
                  .within(0.1))
        .once(on("hostB.udp").signal("packetReceivedFromLower")
                  .packet("udp.destPort == 5000")
                  .describe("the datagram of host A at host B's UDP")
                  .within(0.5));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc826_address_resolution compiled\n";

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

// The pair mockup: two hosts on one Ethernet link.
network ArpPairNet
{
    submodules:
        configurator: Ipv4NetworkConfigurator { @display("p=100,50"); }
        hostA: StandardHost { @display("p=300,100"); }
        hostB: StandardHost { @display("p=500,100"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> hostB.ethg++; // link 1
}

%inifile: omnetpp.ini

[General]
network = ArpPairNet
sim-time-limit = 1s
seed-set = 0

# The address resolution of the hosts is the subject of this suite, so nothing replaces it.

# One datagram of 100 octets from host A to port 5000 of host B.
*.hostA.numApps = 1
*.hostA.app[0].typename = "UdpBasicApp"
*.hostA.app[0].destAddresses = "hostB"
*.hostA.app[0].destPort = 5000
*.hostA.app[0].localPort = 4000
*.hostA.app[0].messageLength = 100B
*.hostA.app[0].startTime = 0.1s
*.hostA.app[0].sendInterval = 1s
*.hostB.numApps = 1
*.hostB.app[0].typename = "UdpSink"
*.hostB.app[0].localPort = 5000

%contains: stdout
PROTOCOLTEST rfc826_address_resolution: PASS
