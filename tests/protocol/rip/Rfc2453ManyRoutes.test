%description:

RFC 2453 -- a router with more routes than one message holds splits its update into several
messages of at most 25 entries and loses no route.

Checks RFC2453-GEN-3, MSG-7 (description) and TABLE-2 (must) from
doc/project/evidence/standard/rfc2453/catalog.md. The English procedure is in
doc/project/evidence/protocol/rip/checks/response-contents.md#more-than-25-routes-rip-version-2;
the program steps below map onto its expected observations. Mapping of the pair: every node
keeps its name (host A = hostA, R1 = R1, ...); netA on R1.eth0, L1 on R1.eth1 and R2.eth0, netB
on R2.eth1. "On L1, from R1" is the named interface of the router, R1.eth[1].mac, as it sends a
frame to the lower layer.

The static routes of R1 come from manual routes of the network configurator, through host A.

Observation 3, at least two messages, is asserted on the message that completes the update;
with 1 to 25 entries in each, 34 or more entries need two.

%includes:
#include "ProtocolTest.h"
#include "RipChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static const char *ROUTES[30] = {
    "10.100.1.0", "10.100.2.0", "10.100.3.0", "10.100.4.0", "10.100.5.0", "10.100.6.0",
    "10.100.7.0", "10.100.8.0", "10.100.9.0", "10.100.10.0", "10.100.11.0", "10.100.12.0",
    "10.100.13.0", "10.100.14.0", "10.100.15.0", "10.100.16.0", "10.100.17.0", "10.100.18.0",
    "10.100.19.0", "10.100.20.0", "10.100.21.0", "10.100.22.0", "10.100.23.0", "10.100.24.0",
    "10.100.25.0", "10.100.26.0", "10.100.27.0", "10.100.28.0", "10.100.29.0", "10.100.30.0"
};

static simtime_t roundAt;
static int messages;
static std::set<std::pair<std::string, int>> seen;

static int entryCount(const Packet *p) { return (int)ripOf(p)->getEntryArraySize(); }

static bool entriesWithinLimit(const Packet *p)
{
    int count = entryCount(p);
    return require(count >= 1 && count <= 25, "a message holds " + std::to_string(count) + " entries, outside 1 to 25");
}

static void collect(const Packet *p)
{
    auto rip = ripOf(p);
    messages++;
    for (size_t i = 0; i < rip->getEntryArraySize(); i++)
        seen.insert({rip->getEntry(i).address.str(), rip->getEntry(i).prefixLength});
}

static bool has(const char *address, int prefixLength) { return seen.count({L3Address(address).str(), prefixLength}) > 0; }

static bool allRoutesSeen()
{
    if (!has("10.0.1.0", 24))
        return false;
    for (auto r : ROUTES)
        if (!has(r, 24))
            return false;
    return true;
}

Define_ProtocolTestProgram()
{
    messages = 0;
    seen.clear();
    return ProtocolTest("rfc2453_many_routes")
        // Expected observation 1: after 60 s, on L1, from R1, a message to the multicast group;
        // the periodic update starts. Its entries count toward observation 2 and the union.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return c.event.time >= 60 && isUpdate(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return entriesWithinLimit(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { roundAt = c.event.time; collect(c.event.packet); return true; })
                  .describe("after 60 s, the first message of a periodic update of R1 on L1")
                  .within(100.0))
        // Expected observation 2: every message of the update, within 1 s, holds 1 to 25 entries.
        .meanwhile(never(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) {
                      if (!isUpdate(c.event.packet) || c.event.time > roundAt + 1)
                          return false;
                      int count = entryCount(c.event.packet);
                      return count < 1 || count > 25;
                  })
                  .describe("a message of the update with an entry count outside 1 to 25")
                  .within(1.0)))
        // Expected observations 3 to 5: within 1 s, the messages of the update together hold netA and
        // every static route, in at least two messages, and both routes of 10.200.0.0.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) {
                      if (!isUpdate(c.event.packet) || c.event.time > roundAt + 1)
                          return false;
                      collect(c.event.packet);
                      return allRoutesSeen();
                  })
                  .assertEvent([](const MatchContext&) {
                      return require(messages >= 2, "the update was " + std::to_string(messages) + " message, not at least two");
                  })
                  .assertEvent([](const MatchContext&) {
                      return require(has("10.200.0.0", 16) && has("10.200.0.0", 24), "the update does not hold both 10.200.0.0 with mask 255.255.0.0 and with mask 255.255.255.0");
                  })
                  .describe("the message that completes the update: netA and every static route held")
                  .within(1.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2453_many_routes compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.node.rip.RipRouter;

// host A --netA-- R1 --L1-- R2 --netB-- host B.
network RipPair
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='eth1' address='10.0.12.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='eth0' address='10.0.12.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='eth1' address='10.0.2.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='eth0' address='10.0.2.10' netmask='255.255.255.0'/>" +
                         "<route hosts='hostA' destination='*' netmask='0.0.0.0' gateway='10.0.1.1' interface='eth0'/>" +
                         "<route hosts='hostB' destination='*' netmask='0.0.0.0' gateway='10.0.2.1' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.1.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.2.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.3.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.4.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.5.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.6.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.7.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.8.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.9.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.10.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.11.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.12.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.13.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.14.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.15.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.16.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.17.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.18.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.19.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.20.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.21.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.22.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.23.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.24.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.25.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.26.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.27.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.28.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.29.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.100.30.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.200.0.0' netmask='255.255.0.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "<route hosts='R1' destination='10.200.0.0' netmask='255.255.255.0' gateway='10.0.1.10' interface='eth0'/>" +
                         "</config>");
            @display("p=100,50");
        }
        hostA: StandardHost { @display("p=100,200"); }
        R1: RipRouter { @display("p=300,200"); }
        R2: RipRouter { @display("p=500,200"); }
        hostB: StandardHost { @display("p=700,200"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> R1.ethg++;
        R1.ethg++ <--> Eth100M <--> R2.ethg++;
        R2.ethg++ <--> Eth100M <--> hostB.ethg++;
}

%inifile: omnetpp.ini

[General]
network = RipPair
sim-time-limit = 110s
seed-set = 0

%contains: stdout
PROTOCOLTEST rfc2453_many_routes: PASS
