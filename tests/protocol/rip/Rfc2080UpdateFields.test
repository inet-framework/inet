%description:

RFC 2080 -- the header and the entries of a periodic update: command 2, zero octets, a valid
metric, the prefix length, no link-local prefix, version 1.

Checks RFC2080-MSG-8, GEN-3, MET-3, MET-4, MSG-10 (description) and GEN-5 (must not) from
doc/project/evidence/standard/rfc2080/catalog.md. The English procedure is in
doc/project/evidence/protocol/rip/checks/update-message.md#update-message-fields-ripng;
the program steps below map onto its expected observations. Mapping of the pair on IPv6: every
node keeps its name (host A = hostA, R1 = R1, ...); netA on R1.eth0, L1 on R1.eth1 and R2.eth0,
netB on R2.eth1. "On L1, from R1" is the named interface of the router, R1.eth[1].mac, as it
sends a frame to the lower layer.

Defect: the model sends RIPng messages with version 2. RipPacket declares "short version
@bit(8) = 2" (src/inet/routing/rip/RipPacket.msg:60) and Rip.cc sets the version nowhere, so
the default of RIP version 2 also goes out in RIPng mode. RFC 2080 section 2.5.2: "Set the
version number to the current version of RIPng. The version described in this document is
version 1." Observations 1 to 5 hold; observation 6 fails. This test FAILS, and the failure is
deliberately NOT declared expected: a field that is set to a wrong value is a defect, not a
missing feature. See results.md.

%includes:
#include "ProtocolTest.h"
#include "RipChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

// netA, the marker of R1: a periodic update of R1 holds its entry.
static bool isPeriodicUpdateOfR1(const Packet *p) { return isPeriodicUpdate(p, "2001:db8:1::", 64); }

static bool headerIsResponseWithZeroOctets(const Packet *p)
{
    auto rip = ripOf(p);
    return require(rip->getCommand() == RIP_RESPONSE && rip->getUnused1() == 0,
                   "the header has command " + std::to_string(rip->getCommand()) + " and " + std::to_string(rip->getUnused1())
                   + " in the must-be-zero octets, not command 2 and 0");
}

static bool everyRouteEntryHasValidMetric(const Packet *p)
{
    auto rip = ripOf(p);
    for (size_t i = 0; i < rip->getEntryArraySize(); i++) {
        const RipEntry& e = rip->getEntry(i);
        if (e.metric != 0xFF)
            require(e.metric >= 1 && e.metric <= RIP_INFINITY, "a route entry has a metric outside 1 to 16: " + entriesOf(rip));
    }
    return true;
}

static bool netAHasMetric1AndPrefixLength64(const Packet *p)
{
    auto rip = ripOf(p);
    const RipEntry *e = findEntry(rip, L3Address("2001:db8:1::"), 64);
    return require(e != nullptr && e->metric == 1, "no entry 2001:db8:1::/64 with metric 1: " + entriesOf(rip));
}

static bool noLinkLocalPrefix(const Packet *p)
{
    auto rip = ripOf(p);
    for (size_t i = 0; i < rip->getEntryArraySize(); i++) {
        const RipEntry& e = rip->getEntry(i);
        if (e.metric != 0xFF)
            require(!e.address.toIpv6().isLinkLocal(), "an entry holds a link-local prefix: " + entriesOf(rip));
    }
    return true;
}

static bool headerIsVersion1(const Packet *p)
{
    auto rip = ripOf(p);
    return require(rip->getVersion() == 1, "the header has version " + std::to_string(rip->getVersion()) + ", not 1");
}

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc2080_update_fields")
        // Expected observations 1 to 6: the next periodic update of R1 on L1 after 60 s, and its
        // header, its entries, the entry of netA, the absence of link-local prefixes, and last
        // the version, so that a wrong version cannot keep the others from a verdict.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isPeriodicUpdateOfR1(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return headerIsResponseWithZeroOctets(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return everyRouteEntryHasValidMetric(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return netAHasMetric1AndPrefixLength64(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return noLinkLocalPrefix(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return headerIsVersion1(c.event.packet); })
                  .describe("a periodic update of R1 on L1: command 2 and zero octets; metric 1 to 16 in every route entry; netA with metric 1 and prefix length 64; no link-local prefix; version 1")
                  .notBefore(60.0)
                  .within(100.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2080_update_fields compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.node.rip.RipRouter;

// host A --netA-- R1 --L1-- R2 --netB-- host B (IPv6).
network RipngPair
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // on-link routes only: every route to a remote prefix comes from RIPng
            addRemoteRoutes = false;
            addDefaultRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='2001:db8:1::10'/>" +
                         "<interface hosts='R1' names='eth0' address='2001:db8:1::1'/>" +
                         "<interface hosts='R1' names='eth1' address='2001:db8:12::1'/>" +
                         "<interface hosts='R2' names='eth0' address='2001:db8:12::2'/>" +
                         "<interface hosts='R2' names='eth1' address='2001:db8:2::1'/>" +
                         "<interface hosts='hostB' names='eth0' address='2001:db8:2::10'/>" +
                         "<route hosts='hostA' destination='::/0' gateway='2001:db8:1::1' interface='eth0'/>" +
                         "<route hosts='hostB' destination='::/0' gateway='2001:db8:2::1' interface='eth0'/>" +
                         "</config>");
            @display("p=100,50");
        }
        hostA: StandardHost { hasIpv4 = false; hasIpv6 = true; @display("p=100,200"); }
        R1: RipRouter { hasIpv4 = false; hasIpv6 = true; @display("p=300,200"); }
        R2: RipRouter { hasIpv4 = false; hasIpv6 = true; @display("p=500,200"); }
        hostB: StandardHost { hasIpv4 = false; hasIpv6 = true; @display("p=700,200"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> R1.ethg++;
        R1.ethg++ <--> Eth100M <--> R2.ethg++;
        R2.ethg++ <--> Eth100M <--> hostB.ethg++;
}

%inifile: omnetpp.ini

[General]
network = RipngPair
sim-time-limit = 105s
seed-set = 0

**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.rip.mode = "RIPng"
**.rip.routingTableModule = "^.ipv6.routingTable"

%contains: stdout
PROTOCOLTEST rfc2080_update_fields: PASS
