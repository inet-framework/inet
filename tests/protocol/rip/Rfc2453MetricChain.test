%description:

RFC 2453 -- each router of a chain advertises a remote network one higher than the router
before it, and the routes carry traffic end to end.

Checks RFC2453-MET-5, RESP-6 and TABLE-3 (description), and covers RFC2453-NH-1 from
doc/project/evidence/standard/rfc2453/catalog.md. The English procedure is in
doc/project/evidence/protocol/rip/checks/route-learning.md#metric-through-a-chain-rip-version-2;
the program steps below map onto its expected observations. Mapping of the chain: every node
keeps its name (host A = hostA, R1 = R1, ...); netA on R1.eth0, L1 on R1.eth1 and R2.eth0, L2
on R2.eth1 and R3.eth0, netC on R3.eth1. "On L1, from R1" is the named interface of the router,
R1.eth[1].mac, as it sends a frame to the lower layer.

%includes:
#include "ProtocolTest.h"
#include "RipChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static bool holdsNetA(const Packet *p, int metric) { return isUpdateWith(p, "10.0.1.0", 24, metric); }

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc2453_metric_chain")
        // Expected observation 1: on L1, from R1, an update that holds netA with metric 1.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return holdsNetA(c.event.packet, 1); })
                  .describe("an update of R1 on L1 that holds netA with metric 1")
                  .within(60.0))
        // Expected observation 2: on L2, from R2, an update that holds netA with metric 2.
        .once(on("R2.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return holdsNetA(c.event.packet, 2); })
                  .describe("an update of R2 on L2 that holds netA with metric 2")
                  .within(60.0))
        // Expected observation 3: on netC, from R3, an update that holds netA with metric 3.
        .once(on("R3.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return holdsNetA(c.event.packet, 3); })
                  .describe("an update of R3 on netC that holds netA with metric 3")
                  .within(60.0))
        // Expected observation 4: the echo reply of host C reaches host A.
        .once(on("hostA.eth[0].mac").signal("packetReceivedFromLower")
                  .filterPacket("icmpv4.type == 0")
                  .describe("the echo reply of host C at host A")
                  .within(200.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2453_metric_chain compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.node.rip.RipRouter;

// host A --netA-- R1 --L1-- R2 --L2-- R3 --netC-- host C.
network RipChain
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='eth1' address='10.0.12.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='eth0' address='10.0.12.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='eth1' address='10.0.23.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R3' names='eth0' address='10.0.23.3' netmask='255.255.255.0'/>" +
                         "<interface hosts='R3' names='eth1' address='10.0.3.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostC' names='eth0' address='10.0.3.10' netmask='255.255.255.0'/>" +
                         "<route hosts='hostA' destination='*' netmask='0.0.0.0' gateway='10.0.1.1' interface='eth0'/>" +
                         "<route hosts='hostC' destination='*' netmask='0.0.0.0' gateway='10.0.3.1' interface='eth0'/>" +
                         "</config>");
            @display("p=100,50");
        }
        hostA: StandardHost { @display("p=100,200"); }
        R1: RipRouter { @display("p=250,200"); }
        R2: RipRouter { @display("p=400,200"); }
        R3: RipRouter { @display("p=550,200"); }
        hostC: StandardHost { @display("p=700,200"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> R1.ethg++;
        R1.ethg++ <--> Eth100M <--> R2.ethg++;
        R2.ethg++ <--> Eth100M <--> R3.ethg++;
        R3.ethg++ <--> Eth100M <--> hostC.ethg++;
}

%inifile: omnetpp.ini

[General]
network = RipChain
sim-time-limit = 250s
seed-set = 0

*.hostA.numApps = 1
*.hostA.app[0].typename = "PingApp"
*.hostA.app[0].destAddr = "10.0.3.10"
*.hostA.app[0].startTime = 90s
*.hostA.app[0].count = 1

%contains: stdout
PROTOCOLTEST rfc2453_metric_chain: PASS
