%description:

RFC 2080 -- the periodic updates of a router come 15 to 45 seconds apart, and each holds the
network the router is attached to.

Checks RFC2080-TIMER-1, OUT-2 (description) and TIMER-2 (must, "required") from
doc/project/evidence/standard/rfc2080/catalog.md. The English procedure is in
doc/project/evidence/protocol/rip/checks/periodic-update.md#periodic-update-interval-ripng;
the program steps below map onto its expected observations. Mapping of the pair on IPv6: every
node keeps its name (host A = hostA, R1 = R1, ...); netA on R1.eth0, L1 on R1.eth1 and R2.eth0,
netB on R2.eth1. "On L1, from R1" is the named interface of the router, R1.eth[1].mac, as it
sends a frame to the lower layer.

%includes:
#include "ProtocolTest.h"
#include "RipChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

// netA, the marker of R1: a periodic update of R1 holds its entry.
static bool isPeriodicUpdateOfR1(const Packet *p) { return isPeriodicUpdate(p, "2001:db8:1::", 64); }

// The instant of the last periodic update seen. Each step that checks an interval advances it,
// so the next step compares against the update just before it.
static simtime_t lastAt;

static bool recordFirst(const MatchContext& c) { lastAt = c.event.time; return true; }

static bool intervalWithinBounds(const MatchContext& c)
{
    simtime_t interval = c.event.time - lastAt;
    lastAt = c.event.time;
    return require(interval >= 15 && interval <= 45,
                   "the periodic update came " + interval.str() + " s after the one before it, outside 15 to 45 s");
}

Define_ProtocolTestProgram()
{
    lastAt = -1;
    return ProtocolTest("rfc2080_periodic_update")
        // Expected observation 4, over the whole window: every periodic update holds netA with
        // metric 1.
        .meanwhile(never(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) {
                      return isPeriodicUpdateOfR1(c.event.packet) && metricOf(c.event.packet, "2001:db8:1::", 64) != 1;
                  })
                  .describe("a periodic update of R1 on L1 that holds netA with a metric other than 1")
                  .within(280.0)))
        // Expected observation 1: a first periodic update after 40 s; record its instant.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isPeriodicUpdateOfR1(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return recordFirst(c); })
                  .describe("a first periodic update of R1 on L1")
                  .notBefore(40.0)
                  .within(86.0))
        // Expected observation 2: the next periodic update comes 15 to 45 s after the one before it.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isPeriodicUpdateOfR1(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return intervalWithinBounds(c); })
                  .describe("the next periodic update of R1 on L1, 15 to 45 s after the one before it")
                  .within(46.0))
        // Expected observation 3: the periodic update after that comes 15 to 45 s after the one before it.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isPeriodicUpdateOfR1(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return intervalWithinBounds(c); })
                  .describe("the next periodic update of R1 on L1, 15 to 45 s after the one before it")
                  .within(46.0))
        // Expected observation 3: the periodic update after that comes 15 to 45 s after the one before it.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isPeriodicUpdateOfR1(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return intervalWithinBounds(c); })
                  .describe("the next periodic update of R1 on L1, 15 to 45 s after the one before it")
                  .within(46.0))
        // Expected observation 3: the periodic update after that comes 15 to 45 s after the one before it.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isPeriodicUpdateOfR1(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return intervalWithinBounds(c); })
                  .describe("the next periodic update of R1 on L1, 15 to 45 s after the one before it")
                  .within(46.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2080_periodic_update compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.node.rip.RipRouter;

// host A --netA-- R1 --L1-- R2 --netB-- host B (IPv6).
network RipngPair
{
    submodules:
        configurator: Ipv6NetworkConfigurator {
            // on-link routes only: every route to a remote prefix comes from RIPng
            addRemoteRoutes = false;
            addDefaultRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='2001:db8:1::10'/>" +
                         "<interface hosts='R1' names='eth0' address='2001:db8:1::1'/>" +
                         "<interface hosts='R1' names='eth1' address='2001:db8:12::1'/>" +
                         "<interface hosts='R2' names='eth0' address='2001:db8:12::2'/>" +
                         "<interface hosts='R2' names='eth1' address='2001:db8:2::1'/>" +
                         "<interface hosts='hostB' names='eth0' address='2001:db8:2::10'/>" +
                         "<route hosts='hostA' destination='::/0' gateway='2001:db8:1::1' interface='eth0'/>" +
                         "<route hosts='hostB' destination='::/0' gateway='2001:db8:2::1' interface='eth0'/>" +
                         "</config>");
            @display("p=100,50");
        }
        hostA: StandardHost { hasIpv4 = false; hasIpv6 = true; @display("p=100,200"); }
        R1: RipRouter { hasIpv4 = false; hasIpv6 = true; @display("p=300,200"); }
        R2: RipRouter { hasIpv4 = false; hasIpv6 = true; @display("p=500,200"); }
        hostB: StandardHost { hasIpv4 = false; hasIpv6 = true; @display("p=700,200"); }
    connections:
        hostA.ethg++ <--> Eth100M <--> R1.ethg++;
        R1.ethg++ <--> Eth100M <--> R2.ethg++;
        R2.ethg++ <--> Eth100M <--> hostB.ethg++;
}

%inifile: omnetpp.ini

[General]
network = RipngPair
sim-time-limit = 285s
seed-set = 0

**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.rip.mode = "RIPng"
**.rip.routingTableModule = "^.ipv6.routingTable"

%contains: stdout
PROTOCOLTEST rfc2080_periodic_update: PASS
