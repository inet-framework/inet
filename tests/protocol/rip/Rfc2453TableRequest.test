%description:

RFC 2453 -- a router that restarts asks for the table on every network, and the neighbor
answers it directly, after split horizon.

Checks RFC2453-REQ-1, REQ-4, REQ-8, OUT-1, MSG-4 (description), REQ-6 (must) and GEN-1 (should)
from
doc/project/evidence/standard/rfc2453/catalog.md. The English procedure is in
doc/project/evidence/protocol/rip/checks/table-request.md#table-request-of-a-restarted-router-rip-version-2;
the program steps below map onto its expected observations. Mapping of the pair: every node
keeps its name (host A = hostA, R1 = R1, ...); netA on R1.eth0, L1 on R1.eth1 and R2.eth0, netB
on R2.eth1. "On L1, from R1" is the named interface of the router, R1.eth[1].mac, as it sends a
frame to the lower layer.

R2 fails at 100 s by a crash of the node and starts again at 110 s by a startup of the node,
both from the scenario manager. RIP starts a random time after the node, so the request can
come up to 30 s after 110 s.

%includes:
#include "ProtocolTest.h"
#include "RipChecks.h"

%global:

using namespace inet;
using namespace inet::protocoltest;

static bool portsAre(const Packet *p, int port)
{
    auto udp = udpOf(p);
    return require(udp != nullptr && udp->getSrcPort() == port && udp->getDestPort() == port,
                   udp == nullptr ? std::string("no UDP header")
                                  : "UDP ports are " + std::to_string(udp->getSrcPort()) + " -> " + std::to_string(udp->getDestPort())
                                    + ", not " + std::to_string(port) + " -> " + std::to_string(port));
}

static bool destinationIs(const Packet *p, const char *address)
{
    L3Address dest = destinationAddressOf(p);
    return require(dest == L3Address(address), "IP destination is " + dest.str() + ", not " + address);
}

static bool versionIs(const Packet *p, int version)
{
    auto rip = ripOf(p);
    return require(rip->getVersion() == version, "the header has version " + std::to_string(rip->getVersion()) + ", not " + std::to_string(version));
}

// RFC 2453 section 3.9.1: one entry, address family 0, metric 16; and version 2.
static bool isWholeTableRequest(const Packet *p)
{
    auto rip = ripOf(p);
    bool ok = rip->getVersion() == 2 && rip->getEntryArraySize() == 1
              && rip->getEntry(0).addressFamilyId == RIP_AF_NONE && rip->getEntry(0).metric == RIP_INFINITY;
    return require(ok, "the request is not version 2 with one entry of address family 0 and metric 16: version "
                       + std::to_string(rip->getVersion()) + ", " + entriesOf(rip));
}

// The source address of the request of observation 2; the answer goes back to it.
static L3Address requester;

static bool recordRequester(const Packet *p) { requester = sourceAddressOf(p); return true; }

static bool netBAbsentOrInfinite(const Packet *p)
{
    int metric = metricOf(p, "10.0.2.0", 24);
    return require(metric == -1 || metric == 16, "the answer holds netB with metric " + std::to_string(metric));
}

static bool netAHasMetric1(const Packet *p)
{
    return require(metricOf(p, "10.0.1.0", 24) == 1, "the answer does not hold netA with metric 1: " + entriesOf(ripOf(p)));
}

Define_ProtocolTestProgram()
{
    return ProtocolTest("rfc2453_table_request")
        // Expected observation 1: before 100 s, on L1, from R2, an update that holds netB with
        // metric 1 -- R1 learns netB from R2 over L1.
        .once(on("R2.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return c.event.time < 100 && isUpdateWith(c.event.packet, "10.0.2.0", 24, 1); })
                  .describe("before 100 s, an update of R2 on L1 that holds netB with metric 1")
                  .within(100.0))
        // Expected observation 2: after 110 s, on L1, from R2, a whole-table request from port
        // 520 to port 520 and to 224.0.0.9; record its source address.
        .once(on("R2.eth[0].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return c.event.time >= 110 && isRequest(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return isWholeTableRequest(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return portsAre(c.event.packet, RIP_PORT); })
                  .assertEvent([](const MatchContext& c) { return destinationIs(c.event.packet, "224.0.0.9"); })
                  .assertEvent([](const MatchContext& c) { return recordRequester(c.event.packet); })
                  .describe("after the restart, a whole-table request of R2 on L1, from port 520 to port 520 and 224.0.0.9")
                  .within(150.0))
        // Expected observation 3: within 1 s, on netB, from R2, a request of the same form.
        .once(on("R2.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isRequest(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return isWholeTableRequest(c.event.packet); })
                  .describe("a whole-table request of R2 on netB")
                  .within(1.0))
        // Expected observations 4 to 6: within 5 s, on L1, from R1, the answer, to the
        // address of the requester and to port 520; its version,
        // netA with metric 1, and netB not at all or with metric 16.
        .once(on("R1.eth[1].mac").signal("packetSentToLower")
                  .filterEvent([](const MatchContext& c) { return isResponse(c.event.packet) && destinationAddressOf(c.event.packet) == requester; })
                  .assertEvent([](const MatchContext& c) {
                      auto udp = udpOf(c.event.packet);
                      return require(udp->getDestPort() == RIP_PORT, "the answer goes to UDP port " + std::to_string(udp->getDestPort()) + ", not 520");
                  })
                  .assertEvent([](const MatchContext& c) { return versionIs(c.event.packet, 2); })
                  .assertEvent([](const MatchContext& c) { return netAHasMetric1(c.event.packet); })
                  .assertEvent([](const MatchContext& c) { return netBAbsentOrInfinite(c.event.packet); })
                  .describe("the answer of R1 on L1 to the requester and its port")
                  .within(5.0));
}

%activity:
// present only so opp_test compiles the %global above; this module is not in the network.
EV << "rfc2453_table_request compiled\n";

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.common.scenario.ScenarioManager;
import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
import inet.node.rip.RipRouter;

// host A --netA-- R1 --L1-- R2 --netB-- host B.
network RipPair
{
    submodules:
        configurator: Ipv4NetworkConfigurator {
            addStaticRoutes = false;
            config = xml("<config>" +
                         "<interface hosts='hostA' names='eth0' address='10.0.1.10' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='eth0' address='10.0.1.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R1' names='eth1' address='10.0.12.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='eth0' address='10.0.12.2' netmask='255.255.255.0'/>" +
                         "<interface hosts='R2' names='eth1' address='10.0.2.1' netmask='255.255.255.0'/>" +
                         "<interface hosts='hostB' names='eth0' address='10.0.2.10' netmask='255.255.255.0'/>" +
                         "<route hosts='hostA' destination='*' netmask='0.0.0.0' gateway='10.0.1.1' interface='eth0'/>" +
                         "<route hosts='hostB' destination='*' netmask='0.0.0.0' gateway='10.0.2.1' interface='eth0'/>" +
                         "</config>");
            @display("p=100,50");
        }
        hostA: StandardHost { @display("p=100,200"); }
        R1: RipRouter { @display("p=300,200"); }
        R2: RipRouter { @display("p=500,200"); }
        hostB: StandardHost { @display("p=700,200"); }
        scenarioManager: ScenarioManager {
            script = xml("<scenario><at t='100'><crash module='R2'/></at><at t='110'><startup module='R2'/></at></scenario>");
            @display("p=100,120");
        }
    connections:
        hostA.ethg++ <--> Eth100M <--> R1.ethg++;
        R1.ethg++ <--> Eth100M <--> R2.ethg++;
        R2.ethg++ <--> Eth100M <--> hostB.ethg++;
}

%inifile: omnetpp.ini

[General]
network = RipPair
sim-time-limit = 250s
seed-set = 0
**.hasStatus = true

%contains: stdout
PROTOCOLTEST rfc2453_table_request: PASS
