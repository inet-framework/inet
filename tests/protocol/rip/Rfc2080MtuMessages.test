                         "<route hosts='R1' destination='2001:db8:100:33::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:34::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:35::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:36::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:37::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:38::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:39::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:3a::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:3b::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:3c::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:3d::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:3e::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:3f::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:40::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:41::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:42::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
