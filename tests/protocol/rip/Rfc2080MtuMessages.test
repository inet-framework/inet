                         "<route hosts='R1' destination='2001:db8:100:6::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:7::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:8::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:9::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:a::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:b::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:c::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
