                         "<route hosts='R1' destination='2001:db8:100:2b::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:2c::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:2d::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:2e::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:2f::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:30::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:31::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
