                         "<route hosts='R1' destination='2001:db8:100:11::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
                         "<route hosts='R1' destination='2001:db8:100:12::/64' gateway='2001:db8:1::10' interface='eth0'/>" +
