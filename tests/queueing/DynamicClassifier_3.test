%description:

This test checks that a dynamic classifier (DynamicClassifier) refuses the
reverseOrder parameter. The classifier creates its output gates in the order
in which the classes appear, so a reverse order of the gates has no meaning.

%file: test.ned

import inet.queueing.classifier.DynamicClassifier;
import inet.queueing.common.PacketDelayer;
import inet.queueing.common.PacketMultiplexer;
import inet.queueing.queue.PacketQueue;
import inet.queueing.server.PacketServer;
import inet.queueing.sink.PassivePacketSink;
import inet.queueing.source.ActivePacketSource;
import inet.test.queueingtest.lib.QueryProbe;

network TestDynamicClassifier
{
    submodules:
        producer: ActivePacketSource {
            @display("p=100,100");
        }
        queue: PacketQueue {
            @display("p=200,100");
        }
        server: PacketServer {
            @display("p=300,100");
        }
        probe: QueryProbe {
            @display("p=400,100");
        }
        classifier: DynamicClassifier {
            @display("p=500,100");
        }
        branch[0]: PacketDelayer {
            @display("p=600,100,column,100");
        }
        multiplexer: PacketMultiplexer {
            @display("p=700,100");
        }
        consumer: PassivePacketSink {
            @display("p=800,100");
        }
    connections allowunconnected:
        producer.out --> queue.in;
        queue.out --> server.in;
        server.out --> probe.in;
        probe.out --> classifier.in;
        multiplexer.out --> consumer.in;
}

%file: Test.cc
#include <cstring>
#include "inet/queueing/function/PacketClassifierFunction.h"
#include "inet/common/packet/Packet.h"

using namespace inet;

// the class of producer-N is N modulo 2
static int testClassify(Packet *packet)
{
    return atoi(strrchr(packet->getName(), '-') + 1) % 2;
}

Register_Packet_Classifier_Function(TestClassifier, testClassify);

%inifile: omnetpp.ini

[General]
network = TestDynamicClassifier
sim-time-limit = 3s
cmdenv-event-banners = false
cmdenv-log-prefix = "At %ts %N: "
*.producer.packetLength = 1B
*.producer.productionInterval = 1s
*.server.processingTime = 0s
*.classifier.classifierClass = "TestClassifier"
*.classifier.submoduleName = "branch"
*.classifier.moduleType = "inet.queueing.common.PacketDelayer"
*.branch[*].delay = 0.5s
*.probe.numRepeats = 0
*.classifier.reverseOrder = true

%# remove formatting
%subst: /\x1B\[[0-9;]*m//

%subst: /\nRunning simulation\.\.\.\n//
%# remove method call lines added in OMNeT++ 6.4
%subst: /^At \S+ \S+: Method call [^\n]*\n//m

%exitcode: 1

%contains: stderr
The reverseOrder parameter is not supported
