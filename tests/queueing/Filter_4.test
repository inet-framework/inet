%description:

This test is Filter_2 with a query probe (QueryProbe) between the filter and
the sink. The probe asks the filter three more times for each query, and it
checks that each pulled packet is the offered packet. In pull mode the filter
drops a packet that does not match when the packet becomes available: when the
source offers it, and after each pull. A query drops nothing, so the sink gets
the same packets at the same times as without the probe.

%file: test.ned

import inet.queueing.sink.ActivePacketSink;
import inet.queueing.filter.PacketFilter;
import inet.queueing.source.PassivePacketSource;
import inet.test.queueingtest.lib.QueryProbe;

network TestFilter
{
    submodules:
        provider: PassivePacketSource {
            @display("p=100,100");
        }
        filter: PacketFilter {
            @display("p=200,100");
        }
        probe: QueryProbe {
            @display("p=250,100");
        }
        collector: ActivePacketSink {
            @display("p=300,100");
        }
    connections allowunconnected:
        provider.out --> filter.in;
        filter.out --> probe.in;
        probe.out --> collector.in;
}

%file: Test.cc
#include "inet/queueing/function/PacketFilterFunction.h"
#include "inet/common/packet/Packet.h"

using namespace inet; 

static bool testFilter(const Packet *packet)
{
    return packet->getId() % 2 == 0;
}

Register_Packet_Filter_Function(TestFilter, testFilter);

%inifile: omnetpp.ini

[General]
network = TestFilter
sim-time-limit = 10s
cmdenv-event-banners = false
cmdenv-log-prefix = "At %ts %N: "
*.provider.packetLength = 1B
*.collector.collectionInterval = 1s
*.filter.filterClass = "TestFilter"

%# remove formatting
%subst: /\x1B\[[0-9;]*m//

%subst: /\nRunning simulation\.\.\.\n//
%# remove method call lines added in OMNeT++ 6.4
%subst: /^At \S+ \S+: Method call [^\n]*\n//m

%contains-regex: stdout
^At 0s collector: Collecting packet, [^\n]*provider-0 \(

%contains-regex: stdout
^At 0s filter: Filtering out packet, [^\n]*provider-1 \(

%contains-regex: stdout
^At 1s collector: Collecting packet, [^\n]*provider-2 \(

%contains-regex: stdout
^At 1s filter: Filtering out packet, [^\n]*provider-3 \(

