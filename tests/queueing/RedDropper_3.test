%description:

This test is RedDropper_2 with a query probe (QueryProbe) that asks the dropper
three times before each push if it can take the packet. A query must not change
the average queue length and must not draw a random number, so the dropper drops
the same packets as in RedDropper_2.

%file: test.ned

import inet.queueing.filter.RedDropper;
import inet.queueing.queue.PacketQueue;
import inet.queueing.sink.ActivePacketSink;
import inet.queueing.source.ActivePacketSource;
import inet.test.queueingtest.lib.QueryProbe;

network TestRedDropper
{
    submodules:
        producer: ActivePacketSource {
            @display("p=100,100");
        }
        probe: QueryProbe {
            @display("p=200,100");
        }
        dropper: RedDropper {
            @display("p=300,100");
        }
        queue: PacketQueue {
            @display("p=400,100");
        }
        collector: ActivePacketSink {
            @display("p=500,100");
        }
    connections:
        producer.out --> probe.in;
        probe.out --> dropper.in;
        dropper.out --> queue.in;
        queue.out --> collector.in;
}

%inifile: omnetpp.ini

[General]
network = TestRedDropper
sim-time-limit = 30s
cmdenv-event-banners = false
cmdenv-log-prefix = "At %ts %N: "
*.producer.packetLength = 1B
*.producer.productionInterval = 0.5s
*.dropper.minth = 1
*.dropper.maxth = 5
*.dropper.maxp = 0.5
*.dropper.wq = 0.5
*.collector.collectionInterval = 1s
*.probe.numRepeats = 3

%# remove formatting
%subst: /\x1B\[[0-9;]*m//

%subst: /\nRunning simulation\.\.\.\n//
%# remove method call lines added in OMNeT++ 6.4
%subst: /^At \S+ \S+: Method call [^\n]*\n//m

%contains-regex: stdout
