%description:

In this test, an active packet sink (ActivePacketSink) pulls packets from a
passive packet source through a statistical rate limiter
(StatisticalRateLimiter). The source tags each packet with a data rate of
100 bps, and the limit is 50 bps, so the limiter drops about half of the
packets at random. In pull mode the limiter drops a packet when the source
offers it. The query probe between the limiter and the sink asks no query
(numRepeats = 0).

%file: test.ned

import inet.queueing.filter.StatisticalRateLimiter;
import inet.queueing.sink.ActivePacketSink;
import inet.test.queueingtest.lib.QueryProbe;

network TestStatisticalRateLimiter
{
    submodules:
        provider: TaggingSource {
            @display("p=100,100");
        }
        limiter: StatisticalRateLimiter {
            @display("p=200,100");
        }
        probe: QueryProbe {
            @display("p=300,100");
        }
        collector: ActivePacketSink {
            @display("p=400,100");
        }
    connections:
        provider.out --> limiter.in;
        limiter.out --> probe.in;
        probe.out --> collector.in;
}

%file: TaggingSource.ned

import inet.queueing.source.PassivePacketSource;

simple TaggingSource extends PassivePacketSource
{
    parameters:
        double taggedDatarate @unit(bps);
        @class(TaggingSource);
}

%file: TaggingSource.cc
#include "inet/queueing/common/RateTag_m.h"
#include "inet/queueing/source/PassivePacketSource.h"

using namespace inet;
namespace StatisticalRateLimiter_1 {

// a passive packet source that tags each packet with a data rate
class TaggingSource : public queueing::PassivePacketSource
{
  protected:
    virtual Packet *createPacket() override
    {
        auto packet = PassivePacketSource::createPacket();
        packet->addTag<RateTag>()->setDatarate(bps(par("taggedDatarate").doubleValue()));
        return packet;
    }
};

Define_Module(TaggingSource);

} // namespace StatisticalRateLimiter_1

%inifile: omnetpp.ini

[General]
network = TestStatisticalRateLimiter
sim-time-limit = 20s
cmdenv-event-banners = false
cmdenv-log-prefix = "At %ts %N: "
*.provider.packetLength = 1B
*.provider.taggedDatarate = 100bps
*.limiter.maxDatarate = 50bps
*.collector.collectionInterval = 1s
*.probe.numRepeats = 0

%# remove formatting
%subst: /\x1B\[[0-9;]*m//

%subst: /\nRunning simulation\.\.\.\n//
%# remove method call lines added in OMNeT++ 6.4
%subst: /^At \S+ \S+: Method call [^\n]*\n//m

%contains-regex: stdout
^At 0s collector: Collecting packet, [^\n]*provider-0 \(

