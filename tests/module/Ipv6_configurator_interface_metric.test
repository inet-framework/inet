%description:
Ipv6NetworkConfigurator applies the metric attribute of an <interface> element to
the on-link (direct) route it adds through that interface, as Ipv4NetworkConfigurator
does through the interface metric of the connected route. The three on-link routes
come from three places in addStaticRoutes(): the direct route of a single-interface
host (h1), a route to a link the router shares with a configured host (r eth1), and
the route to a link with no other configured member (r eth2). Interfaces without the
attribute keep the routing table's default static route metric of 10.

%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

simple RouteMetricProbe
{
    parameters:
        @class(::inet::RouteMetricProbe);
        string hosts;
}

network Ipv6InterfaceMetricNetwork
{
    types:
        channel ethline extends DatarateChannel {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        configurator: Ipv6NetworkConfigurator;
        probe: RouteMetricProbe;
        h1: StandardHost6;
        h2: StandardHost6;
        h3: StandardHost6;
        r: Router6;
    connections:
        h1.ethg++ <--> ethline <--> r.ethg++;
        h2.ethg++ <--> ethline <--> r.ethg++;
        h3.ethg++ <--> ethline <--> r.ethg++;
}

%file: RouteMetricProbe.cc
#include "inet/common/INETDefs.h"
#include "inet/networklayer/common/L3AddressResolver.h"
#include "inet/networklayer/ipv6/Ipv6RoutingTable.h"

namespace inet {

class RouteMetricProbe : public cSimpleModule
{
  protected:
    void initialize() override { scheduleAt(0.1, new cMessage("print")); }
    void handleMessage(cMessage *msg) override
    {
        delete msg;
        cStringTokenizer tokenizer(par("hosts"));
        while (tokenizer.hasMoreTokens()) {
            const char *name = tokenizer.nextToken();
            auto host = getParentModule()->getSubmodule(name);
            auto routingTable = L3AddressResolver().getIpv6RoutingTableOf(host);
            for (int i = 0; i < routingTable->getNumRoutes(); i++) {
                auto route = routingTable->getRoute(i);
                if (route->getSourceType() == IRoute::MANUAL && route->getNextHop().isUnspecified())
                    std::cout << "ROUTE " << name << " " << route->getDestPrefix() << "/" << route->getPrefixLength()
                              << " dev " << route->getInterface()->getInterfaceName()
                              << " metric " << route->getMetric() << std::endl;
            }
        }
    }
};

Define_Module(RouteMetricProbe);

} // namespace inet

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Ipv6InterfaceMetricNetwork
ned-path = .;../../../../src
sim-time-limit = 0.2s
cmdenv-express-mode = false

**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.probe.hosts = "h1 h2 r"
**.configurator.config = xml("<config> \
    <interface hosts='h1' names='eth0' metric='5' prefix='2001:db8:1::/64'/> \
    <interface hosts='r' names='eth1' metric='7' prefix='2001:db8:2::/64'/> \
    <interface hosts='r' names='eth2' metric='9' prefix='2001:db8:3::/64'/> \
    <interface hosts='h2 r' prefix='2001:db8:x::/64'/> \
  </config>")

%#--------------------------------------------------------------------------------------------------------------
%# single-interface host: the direct route carries the metric of its interface
%contains: stdout
ROUTE h1 2001:db8:1::/64 dev eth0 metric 5
%#--------------------------------------------------------------------------------------------------------------
%# no metric attribute: the routing table's default static route metric
%contains: stdout
ROUTE h2 2001:db8:2::/64 dev eth0 metric 10
%#--------------------------------------------------------------------------------------------------------------
%# router, link shared with an attribute-less interface (r eth0 to h1)
%contains: stdout
ROUTE r 2001:db8:1::/64 dev eth0 metric 10
%#--------------------------------------------------------------------------------------------------------------
%# router, link shared with a configured host
%contains: stdout
ROUTE r 2001:db8:2::/64 dev eth1 metric 7
%#--------------------------------------------------------------------------------------------------------------
%# router, link with no other configured member
%contains: stdout
ROUTE r 2001:db8:3::/64 dev eth2 metric 9
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object:
%#--------------------------------------------------------------------------------------------------------------
