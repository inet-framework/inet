%description:
Tests a pure ACK that a peer sends from beyond a shrunk window
(windowShrinkAllowed). The server has a receive buffer of 8000 bytes, so its
first offer is 4000 bytes, and its application does not read. The client sends
4000 bytes at once (increasedIWEnabled). The offer falls with each segment:
2502, 1505, then 0 at 3001, so the server refuses the segment 3001:4001. The
server then sends 500 bytes, and the client ACK (A007) carries the sequence
number 4001: beyond the window in force (3001), but within the highest edge
offered (4001). The tester copies A007 after 50 ms. The copy acknowledges
nothing new, so only the sequence test decides: the server accepts it, as
Linux tcp_sequence(), and does not answer it with an ACK.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 4000"
*.srv_app.sendScript="1.1 500"
*.*_tcp.mss = 1000
*.*_tcp.delayedAcksEnabled = false
*.cli_tcp.increasedIWEnabled = true
*.srv_tcp.receiveBufferSize = 8000B
*.srv_tcp.windowShrinkAllowed = true
*.srv_app.autoRead=false
*.srv_app.readScript="3 20000"
*.tcptester.script="a7 copy 0,0.05"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.001 A004] A.1000 > B.2000: A 1001:2001(1000) ack 501 win 16384 
[1.001 A005] A.1000 > B.2000: A 2001:3001(1000) ack 501 win 16384 
[1.001 A006] A.1000 > B.2000: A 3001:4001(1000) ack 501 win 16384 
[1.003 B002] A.1000 < B.2000: A ack 1001 win 2502 
[1.003 B003] A.1000 < B.2000: A ack 2001 win 1505 
[1.003 B004] A.1000 < B.2000: A ack 3001 win 0 
[1.003 B005] A.1000 < B.2000: A ack 3001 win 0 
[1.101 B006] A.1000 < B.2000: A 501:1001(500) ack 3001 win 0 
[1.103 A007] A.1000 > B.2000: A ack 1001 win 16384 # removing original
[1.103 A007] A.1000 > B.2000: A ack 1001 win 16384 # introducing copy
[1.153 A007] A.1000 > B.2000: A ack 1001 win 16384 # introducing copy
[2.005 A008] A.1000 > B.2000: A 3001:4001(1000) ack 1001 win 16384 
[2.007 B007] A.1000 < B.2000: A ack 3001 win 0 
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
Not Acceptable segment. seqNo=4001
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
