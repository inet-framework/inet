%description:
Tests the send path after a retransmission timeout with SACK, when the
receiver holds all data above the next segment to send. The tester deletes
the first two of four segments, and the receiver SACKs the other two. The
timeout at t=4 retransmits 1:501. Its ACK at t=4.003 acknowledges 501 and
SACKs 1001:2001. The sender sends 501:1001. Then it moves snd_nxt over the
SACKed data to the end of the send queue, and no data is left to send.
Before the repair, the sender made a segment of zero bytes there, and the
simulation stopped with "Returning an empty chunk is not allowed". Now the
sender sends nothing more, and the next write goes out at t=6.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="a3 delete; a4 delete"

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 2000;6 500"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.increasedIWEnabled = true



%# after the timeout, the sender sends the one segment that is not SACKed...
%contains: stdout
[4.005 A008] A.1000 > B.2000: A 501:1001(500) ack 501 win 5000

%contains: stdout
[4.007 B005] A.1000 < B.2000: A ack 2001 win 5000

%# ...and the connection continues with the next write
%contains: stdout
[6.001 A009] A.1000 > B.2000: A 2001:2501(500) ack 501 win 5000

%contains: stdout
[6.003 B006] A.1000 < B.2000: A ack 2501 win 5000

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
