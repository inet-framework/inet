%description:
Tests that the mobility messages Mobile IPv6 sends with a pinned output interface
are addressed to the link-layer address of their next hop, not to the broadcast
address FF-FF-FF-FF-FF-FF.

Mipv6 pins the output interface of the Binding Update, the Care-of Test Init and
the Binding Acknowledgement. A pinned interface makes the Ipv6 module skip
next-hop determination, so Mipv6 states the next hop itself: the next hop of the
longest matching route through the pinned interface.

RFC 4861 Section 5.2: Once the IP address of the next-hop node is known, the
sender examines the Neighbor Cache for link-layer information about that
neighbor.

The mobile node moves from its home link to the foreign link and back, so it
sends a home registration, return routability and a Binding Update to the
correspondent node from the foreign link, and the de-registrations from the home
link. On the foreign link the next hop of every message to a global address is
the access router; a broadcast frame would be relayed back into the cell by the
access point.

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
record-vector-results = false
# log the frames as they are queued for transmission, with their link-layer addresses
**.MN[0].wlan[0].mac.dcf.channelAccess.pendingQueue.cmdenv-log-level = trace
**.Home_Agent.eth[*].queue.dataQueue.cmdenv-log-level = trace
**.CN[0].eth[0].queue.dataQueue.cmdenv-log-level = trace
**.mipv6.cmdenv-log-level = trace
**.cmdenv-log-level = off
cmdenv-event-banners = false
ned-path = .;../../../../src;../../lib
network = inet.test.moduletest.lib.Mipv6Network
sim-time-limit = 60s
cmdenv-express-mode = false
cmdenv-log-prefix = "%C: "
num-rngs = 3
seed-set = 1
**.mobility.rng-0 = 2

*.total_mn = 1
*.total_cn = 1

# realistic Router Advertisement intervals; movement is detected from a Router
# Solicitation sent on each L2 (re)association (default detectL2Movement)
**.neighbourDiscovery.minIntervalBetweenRAs = 3s
**.neighbourDiscovery.maxIntervalBetweenRAs = 7s

*.radioMedium.mediumLimitCache.maxTransmissionPower = 2.0mW
*.radioMedium.mediumLimitCache.minReceptionPower = -82dBm
*.radioMedium.mediumLimitCache.minInterferencePower = -82dBm

**.wlan*.mgmt.numAuthSteps = 4
**.AP*.wlan*.mgmt.beaconInterval = 0.1s
**.AP_Home.wlan*.mgmt.ssid = "HOME"
**.AP_Home.wlan*.address = "10:AA:00:00:00:01"
**.AP_Home.eth[0].address = "10:AE:00:00:00:02"
**.AP_Home.eth[0].duplexMode = true
**.AP_1.wlan*.mgmt.ssid = "AP1"
**.AP_1.wlan*.address = "10:AA:00:00:A1:01"
**.AP_1.eth[0].address = "10:AE:00:00:A1:02"
**.AP_1.eth[0].duplexMode = true

# the MN dwells at home, dashes to the foreign network, dwells there, then returns
# home and stays, so it also sends the de-registrations from the home link
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxZ = 0m
**.MN[0].mobility.typename = "TurtleMobility"
**.MN[0].mobility.turtleScript = xml("<movement><set x='249' y='175'/><wait t='12'/><moveto x='566' y='175' t='3'/><wait t='20'/><moveto x='249' y='175' t='3'/><wait t='22'/></movement>")
**.MN*.mobility.updateInterval = 0.1s

# the correspondent node pings the MN's home address throughout
**.MN*.numApps = 0
**.CN*.numApps = 1
**.CN[0].app[0].typename = "PingApp"
**.CN[0].app[0].destAddr = "aaaa:0:66:0:8aa:ff:fe00:8"
**.CN[0].app[0].packetSize = 56B
**.CN[0].app[0].sendInterval = 0.5s
**.CN[0].app[0].startTime = 1s
**.CN[0].app[0].hopLimit = 32
**.CN[0].app[0].printPing = true

**.forwarding = false
**.eth[*].queue.typename = "EthernetQosQueue"
**.eth[*].queue.dataQueue.typename = "DropTailQueue"
**.eth[*].queue.dataQueue.packetCapacity = 10
**.eth*.duplexMode = true
**.analogModel.ignorePartialInterference = true
**.AP_Home.wlan*.radio.channelNumber = 1
**.AP_1.wlan*.radio.channelNumber = 2
**.MN*.wlan*.radio.channelNumber = 0
**.wlan*.agent.activeScan = true
**.wlan*.agent.defaultSsid = ""
**.wlan*.agent.channelsToScan = "1 2"
**.wlan*.agent.probeDelay = 0.1s
**.wlan*.agent.minChannelTime = 0.15s
**.wlan*.agent.maxChannelTime = 0.3s
**.wlan*.agent.authenticationTimeout = 5s
**.wlan*.agent.associationTimeout = 5s
**.wlan*.bitrate = 2Mbps
**.wlan*.mac.dcf.channelAccess.cwMin = 7
**.radio.transmitter.power = 2.0mW
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMaxX = 850m
**.constraintAreaMaxY = 850m

%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%# the scenario covers registration, route optimization and de-registration
%contains: stdout
Mipv6Network.MN[0].ipv6.mipv6: Message recognised as CARE-OF TEST (CoT)
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Mipv6Network.CN[0].ipv6.mipv6: Deregistered binding
%#--------------------------------------------------------------------------------------------------------------
%# the mobile node sends its Binding Update to the access router on the foreign link
%contains-regex: stdout
pendingQueue: Pushing packet, packet = \(Packet\)Binding Update [^\n]*receiverAddress = 10-AA-00-00-A1-01[^\n]*address3 = 0A-AA-00-00-00-04
%#--------------------------------------------------------------------------------------------------------------
%# no mobility message to a global address goes out as a link-layer broadcast (the mobile
%# node also sends a Care-of Test Init to the home agent's link-local address from the
%# foreign link, which has no neighbour to address)
%not-contains-regex: stdout
Pushing packet, packet = \(Packet\)(Binding Update|Binding Acknowledgement|CoTI|HoTI|CoT|HoT) [^\n]*(address3|dest) = FF-FF-FF-FF-FF-FF[^\n]*destinationAddress = (?!fe80:)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
