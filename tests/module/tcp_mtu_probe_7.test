%description:
Tests that pathMtu bounds the path MTU search (mtuProbing = 2). The
scenario is that of tcp_mtu_probe_6 with a route MTU of 900 at the client: the
search runs from 552 to 1500, but its midpoints stay at or below 900, so the
probes of the MTUs 726, 813 and 856 raise the MSS to 816, toward the MSS of
the route MTU (860).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 40000"
*.*_tcp.mss = 1460
*.*_tcp.delayedAcksEnabled = false
*.cli_tcp.mtuProbing = 2
*.cli_tcp.baseMss = 512
*.cli_tcp.pathMtu = 900

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
RFC 4821: the MTU probe of 726 is acknowledged, snd_mss is 686, the search runs from 726 to 1500
%contains: stdout
RFC 4821: the MTU probe of 856 is acknowledged, snd_mss is 816, the search runs from 856 to 1500
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
