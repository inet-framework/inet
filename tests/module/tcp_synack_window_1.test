%description:
Tests that the window field of a SYN-ACK is at most 65535 (RFC 7323 section
2.2: the window of a SYN or SYN-ACK is never scaled). Both ends have window
scaling and an advertised window of 131072. The tester drops the first SYN-ACK.
After the SYN of the client turned window scaling on, the server offers
65535 in each SYN-ACK; its first ACK after the handshake offers the scaled
131072 (32768 << 2).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="4.0 1000"
*.*_tcp.windowScalingSupport = true
*.*_tcp.advertisedWindow = 131072
*.tcptester.script="b1 delete"  # the first SYN-ACK

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.003 B001] A.1000 < B.2000: A S 500:500(0) ack 1 win 65535   Option(s): MaxSegSize NOP WinScale# deleting
[3.001 A002] A.1000 > B.2000: S 0:0(0) win 65535   Option(s): MaxSegSize NOP WinScale
[3.003 B002] A.1000 < B.2000: A S 500:500(0) ack 1 win 65535   Option(s): MaxSegSize NOP WinScale
[3.003 B003] A.1000 < B.2000: A S 500:500(0) ack 1 win 65535   Option(s): MaxSegSize NOP WinScale
%contains: postrun-command(1).out
[4.203 B004] A.1000 < B.2000: A ack 1001 win 32768
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
