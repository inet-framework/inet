%description:
Rx rejects an unsuccessful PHY header or incomplete content before the standalone FCS check.
The rejection applies when the PHY clears the aggregation flag after header failure.
Seven PHY flag combinations use one-byte bodies with a clear Packet bit-error flag.
Each rejection emits one drop with unchanged copied PHY tags and one corruption notification.
A valid standalone CTS reaches the production FCS check, with and without a nonaggregate PHY indication.
This fixture tests the Rx entry point. The PHY reception fixture tests the real radio path.

%file: AmpduRxBoundary.cc
#include "inet/common/Simsignals.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Rx.h"
#include "inet/linklayer/ieee80211/mac/contract/IContention.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/SignalTag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

class RxBoundaryContention : public IContention
{
  public:
    int corruptions = 0;
    void startContention(int, simtime_t, simtime_t, simtime_t, ICallback *) override { ASSERT(false); }
    bool isContentionInProgress() override { return false; }
    void mediumStateChanged(bool) override {}
    void corruptedFrameReceived() override { corruptions++; }
};

class AmpduRxBoundary : public Rx, public cListener
{
    RxBoundaryContention contention;
    mutable int fcsCalls = 0;
    int drops = 0;
    bool expectedHeader = false;
    bool expectedComplete = false;
    bool expectedAggregation = false;
    Ptr<Ieee80211AmpduInd> retained;

  protected:
    int numInitStages() const override { return 1; }
    void initialize(int stage) override {
        Rx::initialize(stage);
        address = MacAddress("02:00:00:00:00:01");
        registerContention(&contention);
        subscribe(packetDroppedSignal, this);
        scheduleAt(SIMTIME_ZERO, new cMessage("exercise"));
    }
    bool isFcsOk(Packet *packet) const override {
        fcsCalls++;
        return Rx::isFcsOk(packet);
    }
    void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *details) override {
        ASSERT(signal == packetDroppedSignal);
        auto packet = check_and_cast<Packet *>(object);
        ASSERT(check_and_cast<PacketDropDetails *>(details)->getReason() == INCORRECTLY_RECEIVED);
        ASSERT(packet->getDataLength() == B(1) && !packet->hasBitError());
        ASSERT(fcsCalls == 0);
        auto indication = packet->getTag<Ieee80211AmpduInd>();
        ASSERT(indication->getHeaderSuccessful() == expectedHeader);
        ASSERT(indication->getContentComplete() == expectedComplete);
        ASSERT(indication->getAggregation() == expectedAggregation);
        ASSERT(indication->getRangesArraySize() == 1);
        const auto& range = indication->getRanges(0);
        ASSERT(range.kind == 1 && range.offset == B(0) && range.length == B(1));
        ASSERT(range.valid && !range.successful);
        ASSERT(packet->getTag<SignalPowerInd>()->getPower() == W(0.001));
        ASSERT(packet->getTag<SnirInd>()->getMinimumSnir() == 42);
        auto time = packet->getTag<SignalTimeInd>();
        ASSERT(time->getStartTime() == SIMTIME_ZERO && time->getEndTime() == SimTime(1, SIMTIME_US));
        ASSERT(time->getTransmissionId() == 73);
        retained = makeShared<Ieee80211AmpduInd>(*indication);
        drops++;
    }
    void handleMessage(cMessage *message) override {
        delete message;
        for (int flags = 0; flags < 8; flags++) {
            expectedHeader = flags & 1;
            expectedComplete = flags & 2;
            expectedAggregation = flags & 4;
            if (expectedHeader && expectedComplete && !expectedAggregation)
                continue;
            auto source = new Packet("short-phy-result", makeShared<ByteCountChunk>(B(1)));
            auto indication = source->addTag<Ieee80211AmpduInd>();
            indication->setHeaderSuccessful(expectedHeader);
            indication->setContentComplete(expectedComplete);
            indication->setAggregation(expectedAggregation);
            indication->setRangesArraySize(1);
            Ieee80211AmpduRange range;
            range.kind = 1;
            range.offset = B(0);
            range.length = B(1);
            range.valid = true;
            range.successful = false;
            indication->setRanges(0, range);
            source->addTag<SignalPowerInd>()->setPower(W(0.001));
            source->addTag<SnirInd>()->setMinimumSnir(42);
            auto time = source->addTag<SignalTimeInd>();
            time->setStartTime(SIMTIME_ZERO);
            time->setEndTime(SimTime(1, SIMTIME_US));
            time->setTransmissionId(73);
            auto input = source->dup();
            delete source;
            int previousDrops = drops;
            int previousCorruptions = contention.corruptions;
            ASSERT(!lowerFrameReceived(input));
            ASSERT(drops == previousDrops + 1 && contention.corruptions == previousCorruptions + 1);
            ASSERT(fcsCalls == 0);
            ASSERT(retained && retained->getRanges(0).length == B(1));
            ASSERT(retained->getHeaderSuccessful() == expectedHeader);
        }
        for (bool tagged : {false, true}) {
            auto frame = new Packet("valid-standalone");
            auto header = makeShared<Ieee80211CtsFrame>();
            header->setReceiverAddress(address);
            frame->insertAtBack(header);
            auto trailer = makeShared<Ieee80211MacTrailer>();
            trailer->setFcsMode(FCS_DECLARED_CORRECT);
            frame->insertAtBack(trailer);
            if (tagged) {
                auto indication = frame->addTag<Ieee80211AmpduInd>();
                indication->setHeaderSuccessful(true);
                indication->setContentComplete(true);
                indication->setAggregation(false);
            }
            int previousFcsCalls = fcsCalls;
            ASSERT(lowerFrameReceived(frame));
            ASSERT(fcsCalls == previousFcsCalls + 1);
            ASSERT(drops == 7 && contention.corruptions == 7);
            delete frame;
        }
        EV << "Rx PHY boundary checks passed: seven rejections and two standalone acceptances\n";
    }
};
Define_Module(AmpduRxBoundary);

%file: test.ned
simple AmpduRxBoundary
{
    parameters:
        @class(::AmpduRxBoundary);
}
network Test
{
    submodules:
        rx: AmpduRxBoundary;
}

%inifile: omnetpp.ini
[General]
network = Test
ned-path = .;../../../../src
sim-time-limit = 1ms
seed-set = 0
cmdenv-express-mode = false
**.scalar-recording = false
**.vector-recording = false

%contains: stdout
Rx PHY boundary checks passed: seven rejections and two standalone acceptances
