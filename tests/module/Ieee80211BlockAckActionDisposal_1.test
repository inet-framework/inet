%description:
Check owned Block Ack Actions through actual pending-queue overflow. Request disposal before transmission cancels initial setup without teardown. Successful response disposal preserves its recipient agreement. Originator DELBA disposal drops its deferred batch and leaves recovery required.

Later DATA starts another recovery DELBA. Recipient DELBA disposal preserves the opposite role. Later VO queue eviction must release deferred BE DATA without another BE arrival. An isolated cleanup case supplies another peer's retry through the production recovery API. Reset must clear a retry from an actual failed RTS before the protected Action transmits.

The fixture supplies agreement records and does not transmit frames through a peer radio.

%extraargs: -r 0..6,8,10

%file: ActionDisposal.cc
#include <iostream>
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/queueing/queue/PacketQueue.h"

namespace inet::ieee80211 {
class DisposalQueue : public queueing::PacketQueue {
  public:
    void setCapacity(int capacity) { packetCapacity = capacity; }
};
Define_Module(DisposalQueue);
class DisposalOriginator : public OriginatorBlockAckAgreementHandler {
  public:
    void accept(MacAddress peer, Tid tid = 5) {
        auto agreement = new OriginatorBlockAckAgreement(peer, tid, SequenceNumberCyclic(100), 64, false, false);
        agreement->setIsAddbaRequestSent(true);
        agreement->setIsAddbaResponseReceived(true);
        agreement->setBlockAckTimeoutValue(SIMTIME_ZERO);
        agreement->calculateExpirationTime();
        blockAckAgreements[{peer, tid}] = agreement;
    }
    void prepare(const Ptr<const Ieee80211AddbaRequest>& request) { createAgreement(request); }
};
class DisposalRecipient : public RecipientBlockAckAgreementHandler {
  public:
    void accept(MacAddress peer) {
        auto agreement = new RecipientBlockAckAgreement(peer, 5, SequenceNumberCyclic(100), 64, SIMTIME_ZERO);
        agreement->addbaResposneSent();
        agreement->calculateExpirationTime();
        blockAckAgreements[{peer, 5}] = agreement;
    }
};
class ActionDisposalHcf : public Hcf {
  public:
    const MacAddress peer = MacAddress("02:00:00:00:00:02");
    int queueDrops = 0;
    int requestDrops = 0;
    int responseDrops = 0;
    int delbaDrops = 0;
    int delbaSubmissions = 0;
    int attempts = 0;
    int beAdmissions = 0;
    int beAttempts = 0;
    int requestAttempts = 0;
    simtime_t firstBeAttempt = SIMTIME_MAX;
    simtime_t beDeadline = SIMTIME_MAX;
    Ptr<const Ieee80211AddbaRequest> rtsChargedHeader;
    int selectedScenario = -1;
    void run(int scenario) {
        Enter_Method("run");
        selectedScenario = scenario;
        delete originatorBlockAckAgreementHandler;
        delete recipientBlockAckAgreementHandler;
        auto originator = new DisposalOriginator();
        auto recipient = new DisposalRecipient();
        originatorBlockAckAgreementHandler = originator;
        recipientBlockAckAgreementHandler = recipient;
        auto queue = check_and_cast<DisposalQueue *>(edca->getEdcaf(AC_VO)->getPendingQueue());
        if (scenario == 9 || scenario == 10) {
            queue->setCapacity(100);
            queuePendingBeRequest();
            return;
        }
        if (scenario == 8) {
            queue->setCapacity(100);
            originator->accept(peer, 0);
            beginTeardown(peer, 0, true, 37);
            queueData("deferred-be-after-delba", 0);
            ASSERT(!check_and_cast<IContention *>(edca->getEdcaf(AC_BE)->getSubmodule("contention"))->isContentionInProgress());
            scheduleAfter(SimTime(10, SIMTIME_MS), new cMessage("verifyBeResume"));
            return;
        }
        if (scenario == 6) {
            queue->setCapacity(1);
            queueVoice("voice-blocker", B(1000));
            return;
        }
        if (scenario == 7) {
            queue->setCapacity(100);
            auto edcaf = edca->getEdcaf(AC_VO);
            auto recovery = edcaf->getMgmtAndNonQoSRecoveryProcedure();
            auto other = makeShared<Ieee80211MgmtHeader>();
            other->setReceiverAddress(MacAddress("02:00:00:00:00:03"));
            other->setSequenceNumber(SequenceNumberCyclic(0));
            auto otherPacket = new Packet("other-peer-retry", other);
            recovery->dataOrMgmtFrameTransmissionFailed(otherPacket, other, edcaf->getStationRetryCounters());
            ASSERT(recovery->getRetryCount(otherPacket, other) == 1);
            queuePendingBeRequest();
            auto selected = edcaf->getInProgressFrames()->getFrameToTransmit();
            ASSERT(dynamicPtrCast<const Ieee80211AddbaRequest>(selected->peekAtFront<Ieee80211MacHeader>()) != nullptr);
            ASSERT(edcaf->getInProgressFrames()->getLength() == 1);
            auto request = edcaf->getInProgressFrames()->getFrames(0)->peekAtFront<Ieee80211AddbaRequest>();
            ASSERT(request->getSequenceNumber() == other->getSequenceNumber());
            ASSERT(request->getFragmentNumber() == other->getFragmentNumber());
            ASSERT(attempts == 0);
            throw cRuntimeError("Association reset requires the next commit");
            ASSERT(recovery->getRetryCount(otherPacket, other) == 1);
            ASSERT(ownedActions.empty());
            delete otherPacket;
            std::cout << "Block Ack Action disposal assertions passed.\n";
            endSimulation();
        }
        queue->setCapacity(scenario == 4 ? 1 : scenario == 5 ? 100 : 0);
        handlingAgreementAction = true;
        if (scenario == 0 || scenario == 4) {
            auto request = makeShared<Ieee80211AddbaRequest>();
            request->setTransmitterAddress(mac->getAddress());
            request->setReceiverAddress(peer);
            request->setTid(5);
            request->setDialogToken(37);
            request->setBufferSize(64);
            request->setBlockAckPolicy(true);
            request->setStartingSequenceNumber(SequenceNumberCyclic(100));
            originator->prepare(request);
            queueData("deferred");
            processMgmtFrame(new Packet("request", request), request);
            if (scenario == 4) {
                ASSERT(queue->getNumPackets() == 1);
                auto filler = makeShared<Ieee80211MgmtHeader>();
                filler->setReceiverAddress(peer);
                filler->setType(ST_PROBEREQUEST);
                processUpperFrame(new Packet("filler", filler), filler);
            }
            ASSERT(requestDrops == 1);
            ASSERT(originator->getAgreement(peer, 5) == nullptr);
            ASSERT(originator->getProcedures().count({peer, 5}) == 0);
            ASSERT(delbaSubmissions == 0);
            ASSERT(edca->getLifetimeHandler()->getNumFrames() == 1);
        }
        else if (scenario == 1) {
            originator->accept(peer);
            auto request = makeShared<Ieee80211AddbaRequest>();
            request->setTransmitterAddress(peer);
            request->setReceiverAddress(mac->getAddress());
            request->setTid(5);
            request->setDialogToken(37);
            request->setSequenceNumber(SequenceNumberCyclic(10));
            request->setBufferSize(64);
            request->setBlockAckPolicy(true);
            request->setStartingSequenceNumber(SequenceNumberCyclic(100));
            auto packet = new Packet("incoming-request", request);
            packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
            packet->addTag<physicallayer::Ieee80211ModeInd>()->setMode(modeSet->getMode(bps(6000000)));
            processLowerFrame(packet, request);
            ASSERT(responseDrops == 1);
            ASSERT(recipient->getAgreement(5, peer) != nullptr);
            ASSERT(originator->getAgreement(peer, 5) != nullptr);
        }
        else {
            originator->accept(peer);
            recipient->accept(peer);
            if (scenario == 2 || scenario == 5) {
                queueData("batch-first");
                queueData("batch-second");
                ASSERT(edca->getLifetimeHandler()->getNumFrames() == 2);
                beginTeardown(peer, 5, true, 37);
                if (scenario == 5) {
                    handlingAgreementAction = false;
                    updateContention();
                    scheduleAfter(SimTime(2, SIMTIME_MS), new cMessage("delbaFailure"));
                    return;
                }
                ASSERT(originator->getAgreement(peer, 5) == nullptr);
                ASSERT(recipient->getAgreement(5, peer) != nullptr);
                ASSERT(originator->getProcedures().at({peer, 5}).state == IOriginatorBlockAckAgreementHandler::ProcedureState::RECOVERY_NEEDED);
                ASSERT(!hasQueuedData(peer, 5));
                ASSERT(edca->getLifetimeHandler()->getNumFrames() == 0);
                ASSERT(delbaDrops == 1);
                ASSERT(delbaSubmissions == 1);
                queue->setCapacity(100);
                queueData("later");
                ASSERT(delbaSubmissions == 2);
                ASSERT(originator->getProcedures().at({peer, 5}).state == IOriginatorBlockAckAgreementHandler::ProcedureState::TEARDOWN_PENDING);
                ASSERT(hasQueuedData(peer, 5));
                ASSERT(edca->getLifetimeHandler()->getNumFrames() == 1);
            }
            else {
                beginTeardown(peer, 5, false, 37);
                ASSERT(recipient->getAgreement(5, peer) == nullptr);
                ASSERT(originator->getAgreement(peer, 5) != nullptr);
                ASSERT(!recipient->isTeardownPending(peer, 5));
                ASSERT(delbaDrops == 1);
            }
        }
        ASSERT(attempts == 0);
        ASSERT(queueDrops == 1);
        if (scenario != 2)
            ASSERT(ownedActions.empty());
        handlingAgreementAction = false;
        std::cout << "Block Ack Action disposal assertions passed.\n";
        endSimulation();
    }
  protected:
    void handleMessage(cMessage *message) override {
        if (message->isName("verifyRtsTerminal")) {
            delete message;
            ASSERT(rtsChargedHeader != nullptr);
            ASSERT(attempts == 1);
            ASSERT(requestAttempts == 0);
            ASSERT(queueDrops == 0);
            ASSERT(edca->getEdcaf(AC_VO)->getMgmtAndNonQoSRecoveryProcedure()->getShortRetryCount(nullptr, rtsChargedHeader) == 0);
            ASSERT(ownedActions.empty());
            ASSERT(originatorBlockAckAgreementHandler->getAgreement(peer, 0) == nullptr);
            ASSERT(originatorBlockAckAgreementHandler->getProcedures().count({peer, 0}) == 0);
            std::cout << "Block Ack Action disposal assertions passed.\n";
            endSimulation();
        }
        if (message->isName("resetAfterRtsFailure")) {
            delete message;
            auto recovery = edca->getEdcaf(AC_VO)->getMgmtAndNonQoSRecoveryProcedure();
            ASSERT(rtsChargedHeader != nullptr);
            ASSERT(recovery->getShortRetryCount(nullptr, rtsChargedHeader) == 1);
            ASSERT(requestAttempts == 0);
            throw cRuntimeError("Association reset requires the next commit");
            ASSERT(recovery->getShortRetryCount(nullptr, rtsChargedHeader) == 0);
            ASSERT(ownedActions.empty());
            std::cout << "Block Ack Action disposal assertions passed.\n";
            endSimulation();
        }
        if (message->isName("delbaAck")) {
            delete message;
            auto header = makeShared<Ieee80211AckFrame>();
            header->setReceiverAddress(mac->getAddress());
            auto packet = new Packet("delba-ack", header);
            packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
            packet->addTag<physicallayer::Ieee80211ModeInd>()->setMode(modeSet->getMode(bps(6000000)));
            processLowerFrame(packet, header);
            ASSERT(originatorBlockAckAgreementHandler->getProcedures().count({peer, 0}) == 0);
            return;
        }
        if (message->isName("queueDeferredBe")) {
            delete message;
            ASSERT(tx->hasTransmission());
            auto contention = check_and_cast<IContention *>(edca->getEdcaf(AC_BE)->getSubmodule("contention"));
            ASSERT(!contention->isContentionInProgress());
            queuePendingBeRequest();
            ASSERT(!contention->isContentionInProgress());
            ASSERT(edca->getEdcaf(AC_VO)->getPendingQueue()->getNumPackets() == 1);
            ASSERT(requestAttempts == 0);
            scheduleAfter(SimTime(100, SIMTIME_US), new cMessage("evictPendingRequest"));
            return;
        }
        if (message->isName("evictPendingRequest")) {
            delete message;
            auto contention = check_and_cast<IContention *>(edca->getEdcaf(AC_BE)->getSubmodule("contention"));
            ASSERT(!contention->isContentionInProgress());
            ASSERT(tx->hasTransmission());
            queueVoice("voice-evictor", B(10));
            ASSERT(requestDrops == 1);
            ASSERT(requestAttempts == 0);
            ASSERT(originatorBlockAckAgreementHandler->getAgreement(peer, 0) == nullptr);
            ASSERT(originatorBlockAckAgreementHandler->getProcedures().count({peer, 0}) == 0);
            ASSERT(hasQueuedData(peer, 0));
            scheduleAfter(SimTime(10, SIMTIME_MS), new cMessage("verifyBeResume"));
            return;
        }
        if (message->isName("verifyBeResume")) {
            delete message;
            ASSERT(beAdmissions == 1);
            ASSERT(beAttempts >= 1);
            ASSERT(firstBeAttempt < beDeadline);
            ASSERT(simTime() < beDeadline);
            ASSERT(requestAttempts == 0);
            std::cout << "Block Ack Action disposal assertions passed.\n";
            endSimulation();
        }
        if (!message->isName("delbaFailure")) {
            Hcf::handleMessage(message);
            return;
        }
        delete message;
        ASSERT(attempts == 1);
        ASSERT(queueDrops == 0);
        ASSERT(delbaSubmissions == 1);
        ASSERT(originatorBlockAckAgreementHandler->getAgreement(peer, 5) == nullptr);
        ASSERT(recipientBlockAckAgreementHandler->getAgreement(5, peer) != nullptr);
        ASSERT(originatorBlockAckAgreementHandler->getProcedures().at({peer, 5}).state == IOriginatorBlockAckAgreementHandler::ProcedureState::RECOVERY_NEEDED);
        ASSERT(edca->getLifetimeHandler()->getNumFrames() == 0);
        ASSERT(!hasQueuedData(peer, 5));
        ASSERT(ownedActions.empty());
        handlingAgreementAction = true;
        queueData("later-after-retry-limit");
        ASSERT(delbaSubmissions == 2);
        ASSERT(originatorBlockAckAgreementHandler->getProcedures().at({peer, 5}).state == IOriginatorBlockAckAgreementHandler::ProcedureState::TEARDOWN_PENDING);
        ASSERT(edca->getLifetimeHandler()->getNumFrames() == 1);
        handlingAgreementAction = false;
        std::cout << "Block Ack Action disposal assertions passed.\n";
        endSimulation();
    }
    void queueVoice(const char *name, B payload) {
        auto header = makeShared<Ieee80211MgmtHeader>();
        header->setType(ST_PROBEREQUEST);
        header->setReceiverAddress(MacAddress("02:00:00:00:00:03"));
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<ByteCountChunk>(payload));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
    }
    void queuePendingBeRequest() {
        auto request = makeShared<Ieee80211AddbaRequest>();
        request->setTransmitterAddress(mac->getAddress());
        request->setReceiverAddress(peer);
        request->setTid(0);
        request->setDialogToken(37);
        request->setBlockAckPolicy(true);
        request->setBufferSize(64);
        request->setStartingSequenceNumber(SequenceNumberCyclic(0));
        check_and_cast<DisposalOriginator *>(originatorBlockAckAgreementHandler)->prepare(request);
        queueData("deferred-be", 0);
        processMgmtFrame(new Packet("pending-be-request", request), request);
    }
    void queueData(const char *name, Tid tid = 5) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setTransmitterAddress(mac->getAddress());
        header->setReceiverAddress(peer);
        header->setAddress3(peer);
        header->setTid(tid);
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(10)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
        if (tid == 0) {
            beAdmissions++;
            beDeadline = edca->getLifetimeHandler()->getDeadline(packet);
        }
    }
    void receiveSignal(cComponent *source, simsignal_t signal, cObject *object, cObject *details) override {
        if (signal == packetDroppedSignal && dynamic_cast<DisposalQueue *>(source) != nullptr) {
            queueDrops++;
            auto packet = check_and_cast<Packet *>(object);
            auto header = packet->peekAtFront<Ieee80211MacHeader>();
            requestDrops += dynamicPtrCast<const Ieee80211AddbaRequest>(header) != nullptr;
            responseDrops += dynamicPtrCast<const Ieee80211AddbaResponse>(header) != nullptr;
            delbaDrops += dynamicPtrCast<const Ieee80211Delba>(header) != nullptr;
        }
        Hcf::receiveSignal(source, signal, object, details);
    }
    void processMgmtFrame(Packet *packet, const Ptr<const Ieee80211MgmtHeader>& header) override {
        if (dynamicPtrCast<const Ieee80211Delba>(header))
            delbaSubmissions++;
        Hcf::processMgmtFrame(packet, header);
    }
    bool transmitFrame(Packet *packet, simtime_t ifs) override {
        attempts++;
        auto header = packet->peekAtFront<Ieee80211MacHeader>();
        auto data = dynamicPtrCast<const Ieee80211DataHeader>(header);
        bool accepted = Hcf::transmitFrame(packet, ifs);
        if (accepted && packet->isName("voice-blocker"))
            scheduleAfter(SimTime(1, SIMTIME_NS), new cMessage("queueDeferredBe"));
        if (accepted && data && data->getTid() == 0) {
            beAttempts++;
            firstBeAttempt = std::min(firstBeAttempt, simTime());
        }
        if (accepted && dynamicPtrCast<const Ieee80211AddbaRequest>(header))
            requestAttempts++;
        return accepted;
    }
    void transmissionComplete(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override {
        Enter_Method("transmissionComplete");
        bool delba = dynamicPtrCast<const Ieee80211Delba>(header) != nullptr;
        Hcf::transmissionComplete(packet, header);
        if (delba && beAdmissions == 1)
            scheduleAfter(SimTime(60, SIMTIME_US), new cMessage("delbaAck"));
    }
    void originatorProcessRtsProtectionFailed(Packet *packet) override {
        Enter_Method("originatorProcessRtsProtectionFailed");
        auto request = dynamicPtrCast<const Ieee80211AddbaRequest>(packet->peekAtFront<Ieee80211MacHeader>());
        Hcf::originatorProcessRtsProtectionFailed(packet);
        if (request && selectedScenario == 10) {
            rtsChargedHeader = request;
            scheduleAfter(SimTime(1, SIMTIME_NS), new cMessage("verifyRtsTerminal"));
            return;
        }
        if (request && !rtsChargedHeader) {
            ASSERT(requestAttempts == 0);
            ASSERT(ownedActions.count(packet->getId()) == 1);
            ASSERT(!ownedActions.at(packet->getId()).attempted);
            ASSERT(edca->getEdcaf(AC_VO)->getMgmtAndNonQoSRecoveryProcedure()->getShortRetryCount(packet, request) == 1);
            rtsChargedHeader = request;
            scheduleAfter(SimTime(1, SIMTIME_NS), new cMessage("resetAfterRtsFailure"));
        }
    }
    void transmitControlResponseFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>&,
            Packet *, const Ptr<const Ieee80211MacHeader>&) override { delete packet; }
    void sendUp(const std::vector<Packet *>& packets) override {
        for (auto packet : packets) {
            take(packet);
            delete packet;
        }
    }
};
Define_Module(ActionDisposalHcf);
class ActionDisposalTest : public cSimpleModule {
  protected:
    void initialize() override { scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("test")); }
    void handleMessage(cMessage *message) override {
        delete message;
        check_and_cast<ActionDisposalHcf *>(getModuleByPath("^.host.wlan[0].mac.hcf"))->run(par("scenario"));
    }
};
Define_Module(ActionDisposalTest);
}

%file: test.ned
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.linklayer.ieee80211.mac.queue.PendingQueue;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
module ActionDisposalHcf extends Hcf { parameters: @class(::inet::ieee80211::ActionDisposalHcf); }
simple DisposalQueue extends PendingQueue { parameters: @class(::inet::ieee80211::DisposalQueue); }
simple ActionDisposalTest { parameters: int scenario; @class(::inet::ieee80211::ActionDisposalTest); }
network ActionDisposalNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        host: WirelessHost;
        test: ActionDisposalTest;
}

%inifile: omnetpp.ini
[General]
network = ActionDisposalNetwork
ned-path = .;../../../../src
sim-time-limit = 20ms
seed-set = 0
*.test.scenario = ${scenario=0..10}
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "ActionDisposalHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = true
**.wlan[*].mac.hcf.blockAckVariant = "basic"
**.wlan[*].mac.hcf.originatorAckPolicy.ackTimeout = 1ms
**.mgmtAndNonQoSRecoveryProcedure.shortRetryLimit = ${scenario} == 9 ? 3 : 1
**.mgmtAndNonQoSRecoveryProcedure.longRetryLimit = 1
**.wlan[*].mac.hcf.rtsPolicy.rtsThreshold = (${scenario} == 9 || ${scenario} == 10) ? 0B : 2346B
**.wlan[*].mac.hcf.rtsPolicy.ctsTimeout = 1ms
**.wlan[*].mac.hcf.edca.edcaf[*].pendingQueue.typename = "DisposalQueue"
**.wlan[*].mac.hcf.edca.edcaf[*].pendingQueue.dropperClass = "inet::queueing::PacketAtCollectionBeginDropper"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initialX = 0m
**.mobility.initialY = 0m

%contains: stdout
Block Ack Action disposal assertions passed.
