%description:
Check Compressed interframe behavior through physical reception and HCF ACK completion.
The fixture supplies an accepted recipient agreement with four positions. It does not test negotiation.
A raw radio driver transmits HT DATA and receives real HCF responses.
The driver supplies no interframe relation flag to HCF or the data service.
Check SIFS, the exact tolerance boundary, a missing prior receipt, wrap, and unrelated traffic.
Check RIFS with an external HT waveform that omits the six-microsecond signal extension.
The external transmitter changes physical and analog duration together. It retains the actual HT mode and PHY length.
Check a default-extension RIFS control and a gap outside the RIFS tolerance.
Repeat each case with zero and five-microsecond propagation time.
After cache expiry, require the saved physical snapshot to retain the exact interval for a later transmission.

%extraargs: -r 0..27

%file: Interframe.cc
#include <iostream>
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/recipient/RecipientQosMacDataService.h"
#include "inet/mobility/contract/IMobility.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadioMedium.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ITransmitterAnalogModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/SignalTag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Radio.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211PhyHeader_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmitter.h"

namespace inet::ieee80211 {
using namespace physicallayer;

class InterframeTransmitter : public Ieee80211Transmitter {
  public:
    const ITransmission *createTransmission(const IRadio *radio, const Packet *packet, simtime_t start) const override {
        if (!packet->isName("first-no-extension"))
            return Ieee80211Transmitter::createTransmission(radio, packet, start);
        auto selected = computeTransmissionMode(packet);
        auto phy = Ieee80211Radio::peekIeee80211PhyHeaderAtFront(packet);
        ASSERT(selected->getHtMcsIndex() == 0);
        ASSERT(selected->getSignalExtensionTime() == SimTime(6, SIMTIME_US));
        auto duration = selected->getDuration(B(phy->getLengthField())) - SimTime(6, SIMTIME_US);
        auto preamble = selected->getPreambleMode()->getDuration();
        auto header = selected->getHeaderMode()->getDuration();
        auto data = duration - preamble - header;
        auto mobility = radio->getAntenna()->getMobility();
        auto position = mobility->getCurrentPosition();
        auto orientation = mobility->getCurrentAngularPosition();
        auto analog = getAnalogModel()->createAnalogModel(preamble, header, data, centerFrequency,
                selected->getDataMode()->getBandwidth(), computeTransmissionPower(packet));
        return new Ieee80211Transmission(radio, packet, start, start + duration, preamble, header, data,
                position, position, orientation, orientation, nullptr, nullptr, nullptr, nullptr,
                analog, selected, computeTransmissionChannel(packet));
    }
};
Define_Module(InterframeTransmitter);

class InterframeReordering : public BlockAckReordering {
  public:
    ReceiveBuffer *find(MacAddress peer) const {
        auto it = receiveBuffers.find({5, peer});
        return it == receiveBuffers.end() ? nullptr : it->second;
    }
};
class InterframeRecipient : public RecipientQosMacDataService {
  protected:
    void initialize() override {
        RecipientQosMacDataService::initialize();
        delete blockAckReordering;
        blockAckReordering = new InterframeReordering();
    }
  public:
    ReceiveBuffer *buffer(MacAddress peer) const {
        return static_cast<InterframeReordering *>(blockAckReordering)->find(peer);
    }
};
Define_Module(InterframeRecipient);

class InterframeJammer : public cSimpleModule {
  public:
    void start() {
        Enter_Method("start");
        scheduleAfter(SimTime(1, SIMTIME_PS), new cMessage("busy"));
    }
  protected:
    void handleMessage(cMessage *message) override {
        delete message;
        auto radio = check_and_cast<Ieee80211Radio *>(getParentModule()->getSubmodule("radio"));
        radio->setRadioMode(IRadio::RADIO_MODE_TRANSMITTER);
        auto header = makeShared<Ieee80211DataHeader>();
        header->setReceiverAddress(MacAddress("02:00:00:00:00:09"));
        header->setTransmitterAddress(MacAddress("02:00:00:00:00:08"));
        header->setDurationField(SIMTIME_ZERO);
        auto packet = new Packet("busy-only", header);
        auto fcs = makeShared<Ieee80211MacTrailer>();
        fcs->setFcsMode(FCS_DECLARED_CORRECT);
        packet->insertAtBack(fcs);
        auto catalog = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
        const IIeee80211Mode *mode = nullptr;
        for (int i = 0; i < catalog->getNumModes(); i++) {
            auto candidate = catalog->getMode(i);
            if (candidate->getHtMcsIndex() == 8 && !candidate->isHtShortGuardInterval() &&
                    candidate->getDataMode()->getBandwidth() == MHz(20))
                mode = candidate;
        }
        ASSERT(mode && mode->getDataMode()->getNumberOfSpatialStreams() == 2);
        packet->addTag<Ieee80211ModeReq>()->setMode(mode);
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
        send(packet, "out");
    }
};
Define_Module(InterframeJammer);

class InterframeAgreements : public RecipientBlockAckAgreementHandler {
  public:
    RecipientBlockAckAgreement *accept(MacAddress peer, int start) {
        auto agreement = new RecipientBlockAckAgreement(peer, 5, SequenceNumberCyclic(start), 4, SIMTIME_ZERO);
        agreement->setVariant(BlockAckVariant::COMPRESSED);
        agreement->addbaResposneSent();
        blockAckAgreements[{peer, 5}] = agreement;
        return agreement;
    }
};
class InterframeHcf : public Hcf {
  public:
    const MacAddress peer = MacAddress("02:00:00:00:00:02");
    InterframeRecipient *recipient = nullptr;
    InterframeAgreements *agreements = nullptr;
    RecipientBlockAckAgreement *accepted = nullptr;
    std::vector<int> delivered;
    int ackCompletions = 0;
    int ctsCompletions = 0;
    int baCompletions = 0;
    int physicalStarts = 0;
    int busyStates = 0;
    MacAddress address() const { return mac->getAddress(); }
    void prepare(int start) {
        Enter_Method("prepare");
        delete recipientBlockAckAgreementHandler;
        agreements = new InterframeAgreements();
        recipientBlockAckAgreementHandler = agreements;
        accepted = agreements->accept(peer, start);
        recipient = check_and_cast<InterframeRecipient *>(getSimulation()->getSystemModule()->getSubmodule("recipientProbe"));
        recipientDataService = recipient;
    }
    void retireAndAcceptAgain(int start) {
        Enter_Method("retireAndAcceptAgain");
        retireAgreement(peer, 5, false, true);
        accepted = agreements->accept(peer, start);
        // Supply prior receipt state independently of the previous agreement's physical ACK context.
        auto seed = makeShared<Ieee80211DataHeader>();
        seed->setSequenceNumber(SequenceNumberCyclic(start));
        accepted->recordReceived(seed);
        accepted->getBlockAckRecord()->compressedFrameReceived(seed);
    }
    void check(int start, int scenario, bool report = true) {
        Enter_Method("check");
        int first = (start + (scenario == 2 || scenario == 12 ? 1 : 0)) % 4096;
        int last = (start + 4) % 4096;
        int recordStart = (start + 1) % 4096;
        bool related = scenario == 0 || scenario == 3 || scenario == 4 || scenario == 6 || scenario == 7;
        auto record = accepted->getBlockAckRecord();
        ASSERT(record->getWindowStart() == SequenceNumberCyclic(recordStart));
        unsigned bitmap = 0;
        for (int i = 0; i < 64; i++)
            if (record->getCompressedAckState(SequenceNumberCyclic((recordStart + i) % 4096)))
                bitmap |= 1u << i;
        ASSERT(bitmap == (scenario == 2 || scenario == 12 ? 9u : 8u));
        auto buffer = recipient->buffer(peer);
        ASSERT(buffer);
        int expectedB = related ? (last + 1) % 4096 : scenario == 2 || scenario == 12 ? (start + 2) % 4096 : recordStart;
        ASSERT(buffer->getNextExpectedSequenceNumber() == SequenceNumberCyclic(expectedB));
        ASSERT(buffer->getLength() == (related ? 0 : 1));
        std::vector<int> expected = related ? std::vector<int>{first, last} : std::vector<int>{first};
        ASSERT(delivered == expected);
        ASSERT(ackCompletions == (scenario >= 7 && scenario <= 9 ? 1 : 2));
        ASSERT(ctsCompletions == (scenario == 5 ? 1 : 0));
        ASSERT(baCompletions == (scenario == 12 ? 1 : 0));
        if (scenario == 13 && report) {
            ASSERT(physicalStarts == 2);
            ASSERT(busyStates > 0);
        }
        if (report)
            std::cout << "Interframe scenario=" << scenario << " R=" << recordStart << " bitmap=" << bitmap
                      << " B=" << expectedB << " ACK=" << ackCompletions << " CTS=" << ctsCompletions << "\n";
    }
    void checkNoPending() {
        Enter_Method("checkNoPending");
        auto watch = dynamic_cast<cWatchBase *>(findObject("numPendingInterframeReceptions", false));
        ASSERT(watch && watch->str() == "0");
    }
  protected:
    void sendUp(const std::vector<Packet *>& frames) override {
        for (auto frame : frames) {
            delivered.push_back(frame->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().get());
            take(frame);
            delete frame;
        }
    }
    void transmissionComplete(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override {
        if (header->getType() == ST_ACK)
            ackCompletions++;
        if (header->getType() == ST_CTS)
            ctsCompletions++;
        if (header->getType() == ST_BLOCKACK)
            baCompletions++;
        Hcf::transmissionComplete(packet, header);
        if (header->getType() == ST_ACK && ackCompletions == 1 && par("busyProbe").boolValue())
            check_and_cast<InterframeJammer *>(getSimulation()->getSystemModule()->getModuleByPath("jammerNode.jammer"))->start();
    }
    void receiveSignal(cComponent *source, simsignal_t signal, cObject *object, cObject *details) override {
        if (source == getParentModule()->getParentModule()->getSubmodule("radio") && signal == receptionStartedSignal)
            physicalStarts++;
        Hcf::receiveSignal(source, signal, object, details);
    }
    void receiveSignal(cComponent *source, simsignal_t signal, intval_t value, cObject *details) override {
        if (source == getParentModule()->getParentModule()->getSubmodule("radio") &&
                signal == IRadio::receptionStateChangedSignal && value == IRadio::RECEPTION_STATE_BUSY)
            busyStates++;
        Hcf::receiveSignal(source, signal, value, details);
    }
};
Define_Module(InterframeHcf);

class InterframeDriver : public cSimpleModule, public cListener {
  protected:
    InterframeHcf *receiver = nullptr;
    Ieee80211Radio *radio = nullptr;
    const IRadioMedium *medium = nullptr;
    const IIeee80211Mode *ht = nullptr;
    const Ieee80211ModeSet *catalog = nullptr;
    int scenario = -1;
    int start = 100;
    int receivedAcks = 0;
    bool finalSent = false;
    TransmissionTimingSnapshot saved;
    simtime_t initialAckArrival = -1;
    bool snapshotVerified = false;
    bool completed = false;
    int malformedIndex = 0;

    void initialize() override {
        scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("start"));
    }
    void finish() override { ASSERT(completed); }
    void scheduleFinal(simtime_t gap) {
        scheduleAfter(gap, new cMessage("final"));
    }
    void sendFrame(const Ptr<Ieee80211MacHeader>& header, const char *name, bool payload = false) {
        header->setDurationField(SIMTIME_ZERO);
        auto packet = new Packet(name, header);
        if (payload)
            packet->insertAtBack(makeShared<ByteCountChunk>(B(10)));
        auto fcs = makeShared<Ieee80211MacTrailer>();
        fcs->setFcsMode(FCS_DECLARED_CORRECT);
        packet->insertAtBack(fcs);
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
        packet->addTag<Ieee80211ModeReq>()->setMode(header->getType() == ST_RTS ? catalog->getMode(bps(6000000)) : ht);
        send(packet, "out");
    }
    void data(int sequence, const char *name, bool addressed = true, AckPolicy policy = NORMAL_ACK) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setReceiverAddress(addressed ? receiver->address() : MacAddress("02:00:00:00:00:09"));
        header->setTransmitterAddress(receiver->peer);
        header->setAddress3(receiver->peer);
        header->setTid(5);
        header->setSequenceNumber(SequenceNumberCyclic(sequence));
        header->setAckPolicy(policy);
        sendFrame(header, name, true);
    }
    void sendMalformed() {
        Ptr<Ieee80211BlockAckReq> bar;
        int kind = malformedIndex % 3;
        if (kind == 2)
            bar = makeShared<Ieee80211MultiTidBlockAckReq>();
        else {
            auto compressed = makeShared<Ieee80211CompressedBlockAckReq>();
            compressed->setStartingSequenceNumber(SequenceNumberCyclic((start + 2) % 4096));
            compressed->setTidInfo(5);
            compressed->setFragmentNumber(kind == 0 ? 1 : 0);
            bar = compressed;
        }
        bar->setTransmitterAddress(receiver->peer);
        bar->setReceiverAddress(receiver->address());
        sendFrame(bar, "malformed-bar", kind == 1);
    }
    void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *) override {
        Enter_Method_Silent();
        auto transmission = check_and_cast<const Ieee80211Transmission *>(object);
        auto name = std::string(transmission->getPacket()->getName());
        if (signal == transmissionStartedSignal && name == "snapshot-probe") {
            ASSERT(saved.transmissionId >= 0);
            ASSERT(medium->getTransmission(saved.transmissionId) == nullptr);
            ASSERT(medium->getTransmissionTimingSnapshot(saved.transmissionId).transmissionId == -1);
            auto gap = medium->computePrecedingSignalGap(transmission->getId(), saved);
            ASSERT(gap.has_value());
            ASSERT(*gap == transmission->getStartTime() - saved.arrivalEndTimes.at(radio->getId()));
            snapshotVerified = true;
        }
        if (signal == transmissionEndedSignal && name == "unrelated")
            scheduleFinal(catalog->getSifsTime() + (scenario == 11 ? SimTime::fromRaw(catalog->getSlotTime().raw() / 10 + 1) : SIMTIME_ZERO));
        if (signal == transmissionEndedSignal && (name == "first-no-extension" || name == "first-rifs-default")) {
            auto extension = transmission->getSignalExtensionDuration();
            ASSERT(extension.has_value());
            ASSERT(*extension == (scenario == 8 ? SimTime(6, SIMTIME_US) : SIMTIME_ZERO));
            scheduleFinal(SimTime(2, SIMTIME_US) + (scenario == 9 ? SimTime(200001, SIMTIME_PS) : SIMTIME_ZERO));
        }
        if (signal == transmissionEndedSignal && name == "snapshot-probe")
            scheduleAfter(SimTime(20, SIMTIME_US), new cMessage("finish"));
        if (signal == transmissionEndedSignal && name == "malformed-bar") {
            auto propagation = getSimulation()->getSystemModule()->getSubmodule("radioMedium")->getSubmodule("propagation");
            scheduleAfter(SimTime(propagation->par("propagationTime").doubleValue()) + SimTime(1, SIMTIME_PS),
                    new cMessage("malformed-check"));
        }
    }
    void handleMessage(cMessage *message) override {
        if (!message->isSelfMessage()) {
            auto packet = check_and_cast<Packet *>(message);
            ASSERT(!packet->hasBitError());
            if (packet->isName("busy-only")) {
                delete packet;
                return;
            }
            auto header = packet->peekAtFront<Ieee80211MacHeader>();
            if (header->getType() == ST_BLOCKACK) {
                ASSERT(scenario == 12 && receivedAcks == 0);
                scheduleAfter(catalog->getSifsTime(), new cMessage("first"));
            }
            else if (header->getType() == ST_CTS) {
                ASSERT(scenario == 5 && receivedAcks == 1);
                scheduleFinal(catalog->getSifsTime());
            }
            else {
                ASSERT(header->getType() == ST_ACK);
                receivedAcks++;
                if (receivedAcks == 1 && (scenario < 7 || scenario >= 10)) {
                    auto timing = packet->getTag<SignalTimeInd>();
                    saved = medium->getTransmissionTimingSnapshot(timing->getTransmissionId());
                    initialAckArrival = timing->getEndTime();
                    ASSERT(initialAckArrival == simTime());
                    if (scenario == 10)
                        receiver->retireAndAcceptAgain(start);
                    if (scenario == 4 || scenario == 11)
                        scheduleAfter(catalog->getSifsTime(), new cMessage("unrelated"));
                    else if (scenario == 5)
                        scheduleAfter(catalog->getSifsTime(), new cMessage("rts"));
                    else {
                        auto offset = scenario == 1 ? SimTime::fromRaw(catalog->getSlotTime().raw() / 10 + 1) :
                                scenario == 6 ? SimTime::fromRaw(catalog->getSlotTime().raw() / 10) : SIMTIME_ZERO;
                        scheduleFinal(catalog->getSifsTime() + offset);
                    }
                }
                else {
                    ASSERT(finalSent);
                    if (saved.transmissionId < 0)
                        saved = medium->getTransmissionTimingSnapshot(packet->getTag<SignalTimeInd>()->getTransmissionId());
                    scheduleAfter(SimTime(2, SIMTIME_MS), new cMessage("snapshot"));
                }
            }
            delete packet;
            return;
        }
        std::string name = message->getName();
        delete message;
        if (name == "start") {
            receiver = check_and_cast<InterframeHcf *>(getSimulation()->getSystemModule()->getModuleByPath("receiver.wlan[0].mac.hcf"));
            radio = check_and_cast<Ieee80211Radio *>(getParentModule()->getSubmodule("radio"));
            medium = radio->getMedium();
            ASSERT(medium->getTransmission(0) == nullptr);
            ASSERT(medium->getTransmissionTimingSnapshot(0).transmissionId == -1);
            ASSERT(!medium->computePrecedingSignalGap(0, TransmissionTimingSnapshot()).has_value());
            radio->setRadioMode(IRadio::RADIO_MODE_TRANSCEIVER);
            radio->subscribe(transmissionStartedSignal, this);
            radio->subscribe(transmissionEndedSignal, this);
            scenario = par("scenario");
            start = scenario == 3 ? 4094 : 100;
            catalog = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
            for (int i = 0; i < catalog->getNumModes(); i++) {
                auto candidate = catalog->getMode(i);
                if (candidate->getHtMcsIndex() == 0 && !candidate->isHtShortGuardInterval() &&
                        candidate->getDataMode()->getBandwidth() == MHz(20))
                    ht = candidate;
            }
            ASSERT(ht);
            receiver->prepare(start);
            bool rifs = scenario >= 7 && scenario <= 9;
            if (scenario == 12) {
                auto bar = makeShared<Ieee80211CompressedBlockAckReq>();
                bar->setTransmitterAddress(receiver->peer);
                bar->setReceiverAddress(receiver->address());
                bar->setTidInfo(5);
                bar->setStartingSequenceNumber(SequenceNumberCyclic(101));
                sendFrame(bar, "initial-bar");
            }
            else
                data((start + (scenario == 2 ? 1 : 0)) % 4096,
                        rifs ? scenario == 8 ? "first-rifs-default" : "first-no-extension" : "first",
                        true, rifs ? BLOCK_ACK : NORMAL_ACK);
        }
        else if (name == "first")
            data(101, "first");
        else if (name == "final") {
            finalSent = true;
            data((start + 4) % 4096, "final");
        }
        else if (name == "unrelated")
            data(200, "unrelated", false);
        else if (name == "rts") {
            auto header = makeShared<Ieee80211RtsFrame>();
            header->setTransmitterAddress(receiver->peer);
            header->setReceiverAddress(receiver->address());
            sendFrame(header, "rts");
        }
        else if (name == "snapshot") {
            receiver->check(start, scenario);
            data(300, "snapshot-probe", false);
        }
        else if (name == "finish") {
            ASSERT(snapshotVerified);
            ASSERT(receivedAcks == (scenario >= 7 && scenario <= 9 ? 1 : 2));
            sendMalformed();
        }
        else if (name == "malformed-check") {
            receiver->checkNoPending();
            receiver->check(start, scenario, false);
            malformedIndex++;
            if (malformedIndex < 6) {
                sendMalformed();
                return;
            }
            std::cout << "Compressed Block Ack interframe assertions passed.\n";
            completed = true;
            endSimulation();
        }
    }
};
Define_Module(InterframeDriver);
}

%file: test.ned
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.linklayer.ieee80211.mac.recipient.RecipientQosMacDataService;
import inet.mobility.static.StationaryMobility;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadio;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211Transmitter;
module InterframeTransmitter extends Ieee80211Transmitter { parameters: @class(::inet::ieee80211::InterframeTransmitter); }
module InterframeRecipient extends RecipientQosMacDataService { parameters: @class(::inet::ieee80211::InterframeRecipient); }
module InterframeHcf extends Hcf { parameters: bool busyProbe; @class(::inet::ieee80211::InterframeHcf); }
simple InterframeJammer {
    parameters: @class(::inet::ieee80211::InterframeJammer);
    gates: output out;
}
simple InterframeDriver {
    parameters: int scenario; @class(::inet::ieee80211::InterframeDriver);
    gates: input in; output out;
}
module DriverNode {
    parameters: @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: Ieee80211ScalarRadio;
        driver: InterframeDriver;
    connections allowunconnected:
        driver.out --> radio.upperLayerIn;
        radio.upperLayerOut --> driver.in;
}
module JammerNode {
    parameters: @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: Ieee80211ScalarRadio;
        jammer: InterframeJammer;
    connections allowunconnected:
        jammer.out --> radio.upperLayerIn;
}
network InterframeNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        receiver: WirelessHost;
        driverNode: DriverNode;
        jammerNode: JammerNode;
        recipientProbe: InterframeRecipient;
}

%inifile: omnetpp.ini
[General]
network = InterframeNetwork
ned-path = .;../../../../src
sim-time-limit = 10ms
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.driverNode.driver.scenario = ${scenario=0..13}
*.radioMedium.propagation.typename = "ConstantTimePropagation"
*.radioMedium.propagation.propagationTime = (${scenario} == 13 ? 100us : 0s) + ${propagation=0s,5us}
*.radioMedium.mediumLimitCache.maxTransmissionDuration = 1ms
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "n(mixed-2.4Ghz)"
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "InterframeHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = true
**.wlan[*].mac.hcf.blockAckVariant = "compressed"
*.receiver.wlan[0].mac.hcf.busyProbe = ${scenario} == 13
*.receiver.wlan[0].radio.bandwidth = 20MHz
*.receiver.wlan[0].radio.antenna.numAntennas = 1
*.receiver.wlan[0].radio.receiver.sensitivity = -70dBm
*.receiver.wlan[0].radio.receiver.energyDetection = -90dBm
*.jammerNode.radio.opMode = "n(mixed-2.4Ghz)"
*.jammerNode.radio.bandwidth = 20MHz
*.jammerNode.radio.transmitter.bitrate = 6.5Mbps
*.jammerNode.radio.transmitter.power = -40dBm
*.jammerNode.radio.antenna.numAntennas = 2
*.jammerNode.radio.antenna.mobilityModule = "^.^.mobility"
*.driverNode.radio.opMode = "n(mixed-2.4Ghz)"
*.driverNode.radio.bandwidth = 20MHz
*.driverNode.radio.transmitter.typename = "InterframeTransmitter"
*.driverNode.radio.transmitter.bitrate = 6.5Mbps
*.driverNode.radio.antenna.mobilityModule = "^.^.mobility"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 10m
**.mobility.constraintAreaMaxY = 10m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m
*.receiver.mobility.initialX = 0m
*.driverNode.mobility.initialX = 1m
*.jammerNode.mobility.initialX = 1m

%contains: stdout
Compressed Block Ack interframe assertions passed.
