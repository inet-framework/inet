%description:
Tests Nagle with MSG_EOR. While 100 bytes are not acknowledged, the client writes
300 bytes with MSG_EOR, which Nagle holds, and then 300 bytes more. The first
record goes at once, because it cannot become larger (Linux applies Nagle only to
the last skb). Nagle holds the second record until the ACK.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 100; 1.1 300 eor; 1.1 300"
*.*_tcp.mss = 1000

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:101(100) ack 501 win 16384 
[1.101 A004] A.1000 > B.2000: A 101:401(300) ack 501 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 401 win 16384 
[1.205 A005] A.1000 > B.2000: A 401:701(300) ack 501 win 16384 
[1.407 B003] A.1000 < B.2000: A ack 701 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
MSG_EOR: record boundary at sequence number 401
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
