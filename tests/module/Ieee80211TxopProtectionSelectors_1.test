%description:
Verify the default protection selector and retention of the active protection class until TXOP end.

%includes:
#include "inet/linklayer/ieee80211/mac/originator/TxopProcedure.h"
using namespace inet;
using namespace inet::ieee80211;

%file: TestNetwork.ned
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
network TestNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        host: WirelessHost;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
ned-path = .;../../../../src;../../lib
seed-set = 0
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].mac.qosStation = true
**.mobility.initFromDisplayString = false
**.mobility.initialX = 0m
**.mobility.initialY = 0m

%activity:
auto txop = check_and_cast<TxopProcedure *>(getModuleByPath("^.host.wlan[0].mac.hcf.edca.edcaf[2].txopProcedure"));
ASSERT(!strcmp(txop->par("protectionMechanism"), "single"));
txop->startTxop(AC_VI);
ASSERT(txop->getProtectionMechanism() == TxopProcedure::SINGLE_PROTECTION);
wait(omnetpp::SimTime(100, omnetpp::SIMTIME_US));
ASSERT(txop->getProtectionMechanism() == TxopProcedure::SINGLE_PROTECTION);
txop->endTxop();
ASSERT(txop->getReservationEnd() == 0);
EV << "Default protection selector and active protection retention passed.\n";

%contains: stdout
Default protection selector and active protection retention passed.
