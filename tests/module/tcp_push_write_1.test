%description:
Tests pushSegmentsOnWriteBoundary, the PSH of Linux at the end of a write
(tcp_mark_push()). The client writes 300 bytes, and 1500 bytes at t=1.1. The
segment that ends each write has PSH; the full-sized segment in the middle of
the second write has none.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 300; 1.1 1500"
*.*_tcp.mss = 1000
*.cli_tcp.pushSegmentsOnWriteBoundary = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A P 1:301(300) ack 501 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 301 win 16384 
[1.205 A004] A.1000 > B.2000: A 301:1301(1000) ack 501 win 16384 
[1.407 B003] A.1000 < B.2000: A ack 1301 win 16384 
[1.409 A005] A.1000 > B.2000: A P 1301:1801(500) ack 501 win 16384 
[1.611 B004] A.1000 < B.2000: A ack 1801 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
