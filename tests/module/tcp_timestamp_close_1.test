%description:
Tests the TS option in the closing states (RFC 7323 section 3.2: "the TSopt
MUST be sent in every non-<RST> segment for the duration of the connection").
The client closes at t=2 s and the server at t=3 s. The FIN of the client, the
FIN of the server in LAST_ACK and the ACK of the client in TIME_WAIT carry the
option, and each side echoes the TSval of the other. Master sent each FIN and
each segment in CLOSING, LAST_ACK and TIME_WAIT without options.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 100"
*.cli_app.tClose=2s
*.srv_app.tClose=3s
*.*_tcp.timestampSupport = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:101(100) ack 501 win 16384   Option(s): NOP NOP TS(1000,2)
[1.203 B002] A.1000 < B.2000: A ack 101 win 16384   Option(s): NOP NOP TS(1202,1000)
cli_tcp: ESTABLISHED --> FIN_WAIT_1  (on CLOSE)
[2.001 A004] A.1000 > B.2000: A F ack 501 win 16384   Option(s): NOP NOP TS(2000,1202)
srv_tcp: ESTABLISHED --> CLOSE_WAIT  (on RCV_FIN)
[2.003 B003] A.1000 < B.2000: A ack 102 win 16384   Option(s): NOP NOP TS(2002,2000)
cli_tcp: FIN_WAIT_1 --> FIN_WAIT_2  (on RCV_ACK)
srv_tcp: CLOSE_WAIT --> LAST_ACK  (on CLOSE)
[3.001 B004] A.1000 < B.2000: A F ack 102 win 16384   Option(s): NOP NOP TS(3000,2000)
cli_tcp: FIN_WAIT_2 --> TIME_WAIT  (on RCV_FIN)
[3.003 A005] A.1000 > B.2000: A ack 502 win 16384   Option(s): NOP NOP TS(3002,3000)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
