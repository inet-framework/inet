%description:
Next-hop forwarding has no native IP error protocol. Its public queued-failure operation consumes a real LOCALOUT queued datagram silently and removes its reinjection obligation.

%file: Peer.cc
#include "../../../protocol/ipv4/QueuedDatagramFailurePeer.h"

%file: test.ned
import inet.applications.contract.IApp;
import inet.node.ethernet.Eth100M;
import inet.node.inet.StandardHost;
simple QueuedDatagramFailurePeer like IApp
{
    parameters:
        string scenario = default("NextHop");
        bool usingIpv6 = default(false);
        @class(::QueuedDatagramFailurePeer);
    gates:
        input socketIn;
        output socketOut;
}
network QueuedFailureNetwork
{
    submodules:
        hostA: StandardHost;
        hostB: StandardHost;
    connections:
        hostA.ethg++ <--> Eth100M <--> hostB.ethg++;
}

%inifile: omnetpp.ini
[General]
network = QueuedFailureNetwork
ned-path = .;../../../../src;../../../protocol/lib
sim-time-limit = 1s
seed-set = 0
cmdenv-express-mode = true
**.vector-recording = false
*.host*.hasIpv4 = false
*.host*.hasIpv6 = false
*.host*.hasGn = true
*.host*.hasUdp = false
*.host*.hasTcp = false
*.host*.generic.typename = "NextHopNetworkLayer"
*.host*.generic.interfaceTableModule = "^.interfaceTable"
*.hostA.numApps = 1
*.hostA.app[0].typename = "QueuedDatagramFailurePeer"
*.hostB.numApps = 0

%contains: stdout
QUEUED DATAGRAM FAILURE NextHop: PASS
