%description:
Tests the range check of the TcpCubic parameters: hystartDetect = 4 stops the
simulation with an error when the algorithm of the connection starts.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 20000"
*.cli_tcp.tcpAlgorithmClass = "TcpCubic"
*.cli_tcp.conn-*.algorithm.hystartDetect = 4

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%exitcode: 1
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "<!>" test.* > test_err.out || true
%contains: test_err.out
hystartDetect must be 0 to 3, but it is 4
%#--------------------------------------------------------------------------------------------------------------
