%description:
A mobile node moves to a foreign network while the correspondent node pings its home
address. The home agent starts tunneling the pings as soon as it accepts the Binding
Update, and the first tunneled ping makes the mobile node start return routability. Its
Home Test Init is sourced from the home address, so it is held until the Binding
Acknowledgement creates the reverse tunnel.

The home agent sends the acknowledgement of a first registration 1 s after it accepts the
Binding Update (its stand-in for Duplicate Address Detection), and it starts tunneling at
acceptance. The link between Home_Agent and R_2 delays frames that carry a Binding
Acknowledgement by another 0.4 s, so the acknowledgement arrives more than INITIAL_BINDACK_TIMEOUT (1 s)
after the Home Test Init was held: the Home Test Init is held at t = 34.004 s, its
retransmission timer fires at 35.004 s, and the acknowledgement arrives at 35.231 s.

RFC 6275 Section 11.8 retransmits a Home Test Init only if no response arrives within the
retransmission interval. A held Home Test Init has not been sent, so the test requires that
the retransmission timer does not send a second one: the correspondent node receives one
Home Test Init and one Binding Update, not two of each.

%#--------------------------------------------------------------------------------------------------------------
%file: BindingAcknowledgementDelayChannel.cc
#include "inet/common/INETDefs.h"

namespace inet {

class BindingAcknowledgementDelayChannel : public cDatarateChannel
{
  public:
    explicit BindingAcknowledgementDelayChannel(const char *name = nullptr) : cDatarateChannel(name) {}

    virtual Result processMessage(cMessage *msg, const SendOptions& options, simtime_t t) override
    {
        Result result = cDatarateChannel::processMessage(msg, options, t);
        if (strstr(msg->getName(), "Binding Acknowledgement") != nullptr)
            result.delay += par("extraDelay").doubleValue();
        return result;
    }
};

Define_Channel(BindingAcknowledgementDelayChannel);

} // namespace inet

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.Router6;
import inet.node.wireless.AccessPoint;
import inet.node.mipv6.CorrespondentNode6;
import inet.node.mipv6.HomeAgent6;
import inet.node.mipv6.WirelessHost6;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
import inet.test.moduletest.lib.ethernetline;

channel BindingAcknowledgementDelayChannel extends ned.DatarateChannel
{
    @class(::inet::BindingAcknowledgementDelayChannel);
    double extraDelay @unit(s) = default(0s);
    delay = 0.1us;
    datarate = 100Mbps;
}

network Mipv6DelayedAckNetwork
{
    parameters:
        **.mgmt.numChannels = 5;
    submodules:
        configurator: Ipv6FlatNetworkConfigurator;
        radioMedium: Ieee80211ScalarRadioMedium;
        Home_Agent: HomeAgent6;
        R_1: Router6;
        R_2: Router6;
        MN: WirelessHost6;
        CN: CorrespondentNode6;
        AP_Home: AccessPoint {
            @display("p=249,172");
        }
        AP_1: AccessPoint {
            @display("p=566,172");
        }
        switch: EthernetSwitch;
    connections allowunconnected:
        R_1.ethg++ <--> ethernetline <--> R_2.ethg++;
        Home_Agent.ethg++ <--> BindingAcknowledgementDelayChannel { extraDelay = 0.4s; } <--> R_2.ethg++;
        CN.ethg++ <--> ethernetline <--> switch.ethg++;
        switch.ethg++ <--> ethernetline <--> R_2.ethg++;
        AP_Home.ethg++ <--> ethernetline <--> Home_Agent.ethg++;
        AP_1.ethg++ <--> ethernetline <--> R_1.ethg++;
}

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
record-vector-results = false
**.mipv6.cmdenv-log-level = trace
**.cmdenv-log-level = off
cmdenv-event-banners = false
ned-path = .;../../../../src;../../lib
network = Mipv6DelayedAckNetwork
sim-time-limit = 60s
cmdenv-express-mode = false
cmdenv-log-prefix = "%C: "
num-rngs = 3
seed-set = 1
**.mobility.rng-0 = 2

**.neighbourDiscovery.minIntervalBetweenRAs = 0.03s
**.neighbourDiscovery.maxIntervalBetweenRAs = 0.07s
**.neighbourDiscovery.detectL2Movement = false

*.radioMedium.mediumLimitCache.maxTransmissionPower = 2.0mW
*.radioMedium.mediumLimitCache.minReceptionPower = -82dBm
*.radioMedium.mediumLimitCache.minInterferencePower = -82dBm

**.wlan*.mgmt.numAuthSteps = 4
**.AP*.wlan*.mgmt.beaconInterval = 0.1s
**.AP_Home.wlan*.mgmt.ssid = "HOME"
**.AP_Home.wlan*.address = "10:AA:00:00:00:01"
**.AP_Home.eth[0].address = "10:AE:00:00:00:02"
**.AP_1.wlan*.mgmt.ssid = "AP1"
**.AP_1.wlan*.address = "10:AA:00:00:A1:01"
**.AP_1.eth[0].address = "10:AE:00:00:A1:02"

**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxZ = 0m
**.MN.mobility.typename = "RectangleMobility"
**.MN.mobility.constraintAreaMinX = 180m
**.MN.mobility.constraintAreaMinY = 170m
**.MN.mobility.constraintAreaMaxX = 630m
**.MN.mobility.constraintAreaMaxY = 180m
**.MN.mobility.startPos = 0
**.MN.mobility.speed = 10mps
**.MN.mobility.updateInterval = 0.1s

**.MN.numApps = 0
**.CN.numApps = 1
**.CN.app[0].typename = "PingApp"
**.CN.app[0].destAddr = "aaaa:0:66:0:8aa:ff:fe00:8"
**.CN.app[0].packetSize = 56B
**.CN.app[0].sendInterval = 0.2s
**.CN.app[0].startTime = 1s
**.CN.app[0].hopLimit = 32

**.forwarding = false
**.eth*.duplexMode = true
**.analogModel.ignorePartialInterference = true
**.AP_Home.wlan*.radio.channelNumber = 1
**.AP_1.wlan*.radio.channelNumber = 2
**.MN.wlan*.radio.channelNumber = 0
**.wlan*.agent.activeScan = true
**.wlan*.agent.defaultSsid = ""
**.wlan*.agent.channelsToScan = "1 2"
**.wlan*.agent.probeDelay = 0.1s
**.wlan*.agent.minChannelTime = 0.15s
**.wlan*.agent.maxChannelTime = 0.3s
**.wlan*.agent.authenticationTimeout = 5s
**.wlan*.agent.associationTimeout = 5s
**.wlan*.bitrate = 2Mbps
**.wlan*.mac.dcf.channelAccess.cwMin = 7
**.radio.transmitter.power = 2.0mW
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMaxX = 850m
**.constraintAreaMaxY = 850m

%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep -c "CN.ipv6.mipv6: Message recognised as HOME TEST INIT" test.out > hoti_count.out || true
%postrun-command: grep -c "CN.ipv6.mipv6: Message recognised as BINDING UPDATE" test.out > bu_count.out || true
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%#--------------------------------------------------------------------------------------------------------------
%# the retransmission timer of the Home Test Init fired while the Home Test Init was held...
%contains: stdout
is still held until the reverse tunnel exists; not retransmitting it
%#--------------------------------------------------------------------------------------------------------------
%# ...and the held Home Test Init was sent when the reverse tunnel came up
%contains: stdout
is up; sending the held datagram HoTI
%#--------------------------------------------------------------------------------------------------------------
%# one Home Test Init and one Binding Update reach the correspondent node
%contains-regex: hoti_count.out
^1$
%#--------------------------------------------------------------------------------------------------------------
%contains-regex: bu_count.out
^1$
%#--------------------------------------------------------------------------------------------------------------
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
