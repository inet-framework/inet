%description:
Reject invalid VRA configuration: ticksPerSecond = 99.

%file: TestNetwork.ned
import inet.protocolelement.redundancy.VectorStreamMerger;
network TestNetwork {
    submodules:
        merger: VectorStreamMerger;
    connections allowunconnected:
}

%file: Fixture.cc
// Empty compilation unit for this NED-only initialization test.

%inifile: omnetpp.ini
[General]
ned-path = .;../../../../src
network = TestNetwork
sim-time-limit = 1ms
*.merger.mapping = {a: "out"}
*.merger.ticksPerSecond = 99

%exitcode: 1
%postrun-command: cat test.out test.err > diagnostics.out
%contains: diagnostics.out
ticksPerSecond must be 100..4294967295
