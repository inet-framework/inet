%description:
Tests that a new TCP_NOTSENT_LOWAT wakes a writer that waits for the old
mark (Linux calls sk_write_space() in the setsockopt). The scenario is that of
tcp_notsent_lowat_2: the mark is 2000 bytes, and the write of 6000 bytes at
t=1 leaves more unsent bytes. At t=1.002 the client raises the mark to 6000,
and TCP_I_SEND_MSG comes at once, before the first ACK.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 6000"
*.*_tcp.mss = 1000
*.*_tcp.delayedAcksEnabled = false
*.cli_app.notsentLowat = 2000
*.cli_app.notsentLowatScript="1.002 6000"
*.cli_app.logIndications = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
cli_app: TCP_I_SEND_MSG
[1.003 B002] A.1000 < B.2000: A ack 1001 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
