%description:
Exercise the actual association's protected/plaintext record allocation and
sending-epoch boundaries without generating astronomical numbers of packets.

%file: SenderStateFixture.cc
#include <iostream>
#include <limits>
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/transportlayer/dtls/Dtls.h"
#include "inet/transportlayer/dtls/DtlsPlaintextHeader_m.h"

namespace DtlsSenderState_1 {

using namespace inet;
using namespace inet::dtls;

class ProbeAssociation : public DtlsAssociation
{
  public:
    explicit ProbeAssociation(Dtls& engine) : DtlsAssociation(engine, 64) {}
    void seed(AssociationId handle, IDtls::ICallback *owner, bool atCap) {
        id = handle;
        callback = owner;
        state = HandshakeState::ESTABLISHED;
        sendEpoch = atCap ? MAX_SEND_EPOCH : 3;
        nextApplicationRecord = atCap ? MAX_PROTECTED_RECORDS : 0;
        handshakeDeadline = std::make_unique<cMessage>("probeDeadline");
    }
    void check() {
        uint64_t number = 0;
        nextEpoch0Record = MAX_PLAINTEXT_RECORDS - 1;
        ASSERT(allocatePlaintextRecord(number) && number == MAX_PLAINTEXT_RECORDS - 1);
        ASSERT(!allocatePlaintextRecord(number));
        nextApplicationRecord = MAX_PROTECTED_RECORDS - 1;
        ASSERT(allocateApplicationRecord(number) && number == MAX_PROTECTED_RECORDS - 1);
        ASSERT(!allocateApplicationRecord(number));
        nextApplicationRecord = std::numeric_limits<uint64_t>::max();
        ASSERT(!allocateApplicationRecord(number));
        sendEpoch = MAX_SEND_EPOCH - 1;
        ASSERT(advanceSendEpoch() && sendEpoch == MAX_SEND_EPOCH && nextApplicationRecord == 0);
        ASSERT(!advanceSendEpoch() && sendEpoch == MAX_SEND_EPOCH);
        ASSERT(MAX_REKEY_AFTER_RECORDS == (uint64_t(1) << 23));
        state = HandshakeState::ESTABLISHED;
        receiveEpoch = 3;
        receiveEpoch3 = std::make_unique<DtlsRecordState>(64);
        nextPeerMessage = 42;
        auto checkFragment = [this](uint32_t total, uint32_t offset, const std::vector<uint8_t>& bytes) {
            Packet packet("modeled KeyUpdate", makeShared<BytesChunk>(bytes));
            auto header = makeShared<DtlsHandshakeHeader>();
            header->setMessageType(24);
            header->setMessageSequence(42);
            header->setMessageLength(total);
            header->setFragmentOffset(offset);
            header->setFragmentLength(bytes.size());
            packet.insertAtFront(header);
            receiveKeyUpdate(3, 0, &packet);
        };
        checkFragment(1, 0, {});
        checkFragment(2, 0, {0});
        checkFragment(1, 1, {0});
        ASSERT(receiveEpoch == 3 && nextPeerMessage == 42 && !receiveEpoch3->hasRecords());
        ASSERT(getReassemblyEntryCount() == 0 && getReassemblyBytes() == 0 && pendingAcks.empty());
    }
};

class TestDtls : public Dtls
{
  public:
    AssociationId installProbe(IDtls::ICallback *callback, bool atCap) {
        Enter_Method("installProbe");
        auto handle = nextAssociationId++;
        ProbeAssociation probe(*this);
        probe.seed(handle, callback, atCap);
        associations.emplace(handle, std::make_unique<DtlsAssociation>(std::move(probe)));
        return handle;
    }
    bool fillOutput() {
        Enter_Method("fillOutput");
        return outputProcessing->enqueue(0, 19, 100, [] {});
    }
};
Define_Module(TestDtls);

class TrackedPacket : public Packet
{
    bool& destroyed;
  public:
    explicit TrackedPacket(bool& destroyed) : Packet("tracked application", makeShared<BytesChunk>(std::vector<uint8_t>{1})), destroyed(destroyed) {}
    ~TrackedPacket() override { destroyed = true; }
};

class SenderStateFixture : public cSimpleModule, public IDtls::ICallback
{
    bool destroyed = false;
    int sendErrors = 0;
    int errors = 0;
  public:
    SenderStateFixture() : cSimpleModule(65536) {}
    void accepted(IDtls::AssociationId, const L3Address&, int, const L3Address&, int) override { throw cRuntimeError("unexpected accept"); }
    void established(IDtls::AssociationId) override { throw cRuntimeError("unexpected establishment"); }
    void dataArrived(IDtls::AssociationId, Packet *packet) override { delete packet; throw cRuntimeError("unexpected data"); }
    void earlyDataArrived(IDtls::AssociationId, Packet *packet) override { delete packet; throw cRuntimeError("unexpected early data"); }
    void earlyDataStatus(IDtls::AssociationId, bool) override { throw cRuntimeError("unexpected early status"); }
    void pathChanged(IDtls::AssociationId, const DtlsPath&) override { throw cRuntimeError("unexpected path change"); }
    void authenticationResult(IDtls::AssociationId, bool, const char *) override { throw cRuntimeError("unexpected authentication result"); }
    void maximumDatagramSizeChanged(IDtls::AssociationId, size_t) override { throw cRuntimeError("unexpected size change"); }
    void sendError(IDtls::AssociationId, long, const char *) override { ASSERT(destroyed); ++sendErrors; }
    void error(IDtls::AssociationId, const char *) override { ++errors; }
    void closed(IDtls::AssociationId) override { throw cRuntimeError("unexpected close"); }
  protected:
    void activity() override {
        wait(0.1);
        auto engine = check_and_cast<TestDtls *>(getModuleByPath("^.host.app[0].dtls"));
        ProbeAssociation association(*engine);
        association.check();
        auto handle = engine->installProbe(this, true);
        engine->send(handle, new TrackedPacket(destroyed), this);
        ASSERT(destroyed && sendErrors == 1 && errors == 1);
        auto busyHandle = engine->installProbe(this, false);
        ASSERT(engine->requestKeyUpdate(busyHandle, false));
        ASSERT(!engine->requestKeyUpdate(busyHandle, false));
        ASSERT(errors == 1 && sendErrors == 1);
        ASSERT(engine->fillOutput());
        auto overflowHandle = engine->installProbe(this, false);
        ASSERT(engine->requestKeyUpdate(overflowHandle, false));
        ASSERT(errors == 2 && sendErrors == 1);
        std::cout << "DTLS sender state PASS" << std::endl;
    }
};
Define_Module(SenderStateFixture);
}

%file: TestNetwork.ned
import inet.node.inet.StandardHost;
import inet.transportlayer.dtls.Dtls;

simple TestDtls extends Dtls
{
    @class(::DtlsSenderState_1::TestDtls);
}
simple SenderStateFixture
{
    @class(::DtlsSenderState_1::SenderStateFixture);
}
network TestNetwork
{
    submodules:
        host: StandardHost;
        fixture: SenderStateFixture;
    connections allowunconnected:
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
ned-path = .;../../../../src
sim-time-limit = 1s
*.host.numApps = 1
*.host.app[0].typename = "DtlsApp"
*.host.app[0].server = true
*.host.app[0].dtls.typename = "TestDtls"
*.host.app[0].dtls.localPort = 4433
*.host.app[0].dtls.rekeyAfterRecords = 8388608
*.host.app[0].dtls.maxProcessingBytes = 32B
*.host.app[0].dtls.handshakeOutDelay = 1s

%contains: stdout
DTLS sender state PASS
