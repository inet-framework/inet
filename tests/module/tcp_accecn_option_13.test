%description:
Tests the counts of a duplicate segment with accEcnOptionPolicy="linux". Linux
tests the acceptability against the left edge of the window that it advertised
last (tcp_sequence()), so a duplicate that ends at RCV.NXT passes, and its
payload counts. The tester removes the ACK B002 and marks the retransmission
A004 ECT(0), so B003 reports EE0B=2001, as Linux does.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000"
*.*_tcp.tcpEcnMode = "accecn"
*.*_tcp.accEcnOptionPolicy = "linux"
*.*_tcp.sackSupport = true
*.tcptester.script="b2 delete; a4 ect0"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.203 B002] A.1000 < B.2000: A E N ack 1001 win 16384   Option(s): NOP AccECN1(e1b=1,ceb=0,e0b=1001)# deleting
[4.001 A004] A.1000 > B.2000: A E N 1:1001(1000) ack 501 win 16384 ECT(0)   Option(s): NOP AccECN1(e1b=1,ceb=0,e0b=1)# marking ECT(0)
[4.003 B003] A.1000 < B.2000: A E N ack 1001 win 16384   Option(s): NOP NOP SACK[1,1001) NOP AccECN1(e1b=1,ceb=0,e0b=2001)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
