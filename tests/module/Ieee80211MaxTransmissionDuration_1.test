%description:

Tests that an IEEE 802.11 host using Ieee80211ScalarRadioMedium with the default
mediumLimitCache.maxTransmissionDuration can transmit a full-size 1500-byte IP
packet (1472 B ICMP echo payload) at DSSS 1 Mbit/s (~12.48 ms on the air) and
complete the ping exchange without hitting "Maximum transmission duration is exceeded".

%file: test.ned
// Author: Miguel González-López

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

network Test
{
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        configurator: Ipv4NetworkConfigurator;
        host1: AdhocHost;
        host2: AdhocHost;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 1s
ned-path = .;../../../../src

**.arp.typename = "GlobalArp"

**.host*.mobility.typename = "StationaryMobility"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
**.host1.mobility.initialX = 200m
**.host2.mobility.initialX = 300m

**.wlan[*].opMode = "g(mixed)"
**.wlan[*].bitrate = 1Mbps
**.fragmentationThreshold = 2346B

*.host1.numApps = 1
*.host1.app[0].typename = "PingApp"
*.host1.app[0].destAddr = "host2"
*.host1.app[0].packetSize = 1472B
*.host1.app[0].count = 1
*.host1.app[0].startTime = 0.1s
*.host1.app[0].printPing = true

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
sent: 1   received: 1   loss rate (%): 0
%#--------------------------------------------------------------------------------------------------------------
%contains: results/General-#0.sca
scalar Test.radioMedium "transmission count" 4
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
