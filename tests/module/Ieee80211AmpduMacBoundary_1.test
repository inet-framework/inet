%description:
The production radio sends aggregate containers to the production MAC and Rx.
Rx rejects successful, partially failed, and entirely failed aggregates before standalone FCS or header checks.
The drop signal retains the PHY range outcomes and the clear container bit-error flag.
A standalone CTS still sets NAV through the normal acceptance path.
Scalar and dimensional radios cover whole-signal and separate-part reception with DCF and HCF.
Malformed delimiters before typed MPDUs permit bounded recovery without a radio exception.
Typed and byte representations preserve the same recovered ranges.

%extraargs: -r 0..15

%file: AmpduMacBoundary.cc
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/Simsignals.h"
#include "inet/common/checksum/Checksum.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/Rx.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/errormodel/Ieee80211NistErrorModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ISnir.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IReception.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ITransmission.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

class BoundaryErrorModel : public Ieee80211NistErrorModel
{
  public:
    double computePacketErrorRate(const ISnir *, IRadioSignal::SignalPart) const override { return 0; }
    double computeAmpduRangeSuccessRate(const ISnir *snir, const IIeee80211Mode *, B length) const override {
        auto packet = snir->getReception()->getTransmission()->getPacket();
        bool failed = packet->isName("failed") || (packet->isName("partial") && length == B(101));
        return length != B(4) && failed ? 0 : 1;
    }
};
Define_Module(BoundaryErrorModel);

class BoundaryDriver : public cSimpleModule, public cListener
{
    int sent = 0;
    int dropped = 0;
    int navSet = 0;
  protected:
    void initialize() override {
        auto rx = getModuleByPath("^.receiver.wlan[0].mac.rx");
        rx->subscribe(packetDroppedSignal, this);
        rx->subscribe(Rx::navChangedSignal, this);
        scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("send"));
    }
    void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *) override {
        ASSERT(signal == packetDroppedSignal);
        auto packet = check_and_cast<Packet *>(object);
        ASSERT(dropped < 4);
        ASSERT(packet->isName(dropped == 0 ? "good" : dropped == 1 ? "partial" : dropped == 2 ? "failed" : "malformed"));
        ASSERT(!packet->hasBitError());
        auto indication = packet->getTag<Ieee80211AmpduInd>();
        ASSERT(indication->getAggregation() && indication->getHeaderSuccessful() && indication->getContentComplete());
        if (dropped == 3) {
            ASSERT(indication->getRangesArraySize() == 30);
            ASSERT(!indication->getRanges(0).valid && indication->getRanges(0).offset == B(0));
            int members = 0;
            for (size_t i = 0; i < indication->getRangesArraySize(); i++) {
                const auto& range = indication->getRanges(i);
                ASSERT(range.offset + range.length <= packet->getDataLength());
                ASSERT(range.successful);
                if (range.kind == 1) {
                    ASSERT(range.valid);
                    ASSERT(range.offset == (members == 0 ? B(108) : B(216)));
                    ASSERT(range.length == (members == 0 ? B(101) : B(102)));
                    members++;
                }
            }
            ASSERT(members == 2);
            dropped++;
            return;
        }
        ASSERT(indication->getRangesArraySize() == 6);
        int failed = 0;
        for (size_t i = 0; i < indication->getRangesArraySize(); i++) {
            auto& range = indication->getRanges(i);
            ASSERT(range.valid);
            failed += !range.successful;
        }
        ASSERT(failed == (dropped == 0 ? 0 : dropped == 1 ? 1 : 3));
        dropped++;
    }
    void receiveSignal(cComponent *, simsignal_t signal, const SimTime& value, cObject *) override {
        ASSERT(signal == Rx::navChangedSignal);
        if (value > SIMTIME_ZERO) {
            ASSERT(sent == 5 && dropped == 4);
            ASSERT(value == SimTime(50, SIMTIME_US));
            navSet++;
        }
    }
    void handleMessage(cMessage *message) override {
        delete message;
        auto packet = new Packet(sent == 0 ? "good" : sent == 1 ? "partial" : sent == 2 ? "failed" : sent == 3 ? "malformed" : "ordinary");
        if (sent < 4) {
            for (int length : {100, 101, 102}) {
                auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
                delimiter->setLength(sent == 3 && length == 100 ? 2000 : length);
                packet->insertAtBack(delimiter);
                auto member = makeShared<Ieee80211DataHeader>();
                member->setSequenceNumber(SequenceNumberCyclic(0));
                packet->insertAtBack(member);
                packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(length - member->getChunkLength().get<B>(), 0)));
                if (length != 102 && length % 4)
                    packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(4 - length % 4, 0)));
            }
        }
        else {
            auto header = makeShared<Ieee80211CtsFrame>();
            header->setReceiverAddress(MacAddress("02:00:00:00:00:99"));
            header->setDurationField(SimTime(50, SIMTIME_US));
            packet->insertAtBack(header);
            auto bytes = packet->peekAllAsBytes()->getBytes();
            auto trailer = makeShared<Ieee80211MacTrailer>();
            trailer->setFcsMode(FCS_COMPUTED);
            trailer->setFcs(ethernetFcs(bytes.data(), bytes.size()));
            packet->insertAtBack(trailer);
        }
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
        auto modes = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
        const IIeee80211Mode *selected = nullptr;
        for (int i = 0; i < modes->getNumModes(); i++) {
            auto mode = modes->getMode(i);
            if (mode->getHtMcsIndex() == 0 && mode->getDataMode()->getBandwidth() == MHz(20) && !mode->isHtShortGuardInterval())
                selected = mode;
        }
        ASSERT(selected);
        packet->addTag<Ieee80211ModeReq>()->setMode(selected);
        sent++;
        send(packet, "out");
        if (sent < 5)
            scheduleAt(simTime() + SimTime(1, SIMTIME_MS), new cMessage("send"));
    }
    using cListener::finish;
    void finish() override {
        ASSERT(sent == 5 && dropped == 4 && navSet == 1);
        EV << "MAC aggregate boundary checks passed\n";
    }
};
Define_Module(BoundaryDriver);

%file: test.ned
import inet.mobility.static.StationaryMobility;
import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211Radio;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211RadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.errormodel.Ieee80211NistErrorModel;

module BoundaryErrorModel extends Ieee80211NistErrorModel
{
    parameters:
        @class(::BoundaryErrorModel);
}
simple BoundaryDriver
{
    parameters:
        @class(::BoundaryDriver);
    gates:
        output out;
}
module BoundarySender
{
    parameters:
        @networkNode;
    gates:
        input in;
        input radioIn @directIn;
    submodules:
        mobility: StationaryMobility;
        radio: Ieee80211Radio;
    connections allowunconnected:
        in --> radio.upperLayerIn;
        radioIn --> radio.radioIn;
}
network Test
{
    submodules:
        radioMedium: Ieee80211RadioMedium;
        driver: BoundaryDriver;
        sender: BoundarySender;
        receiver: AdhocHost;
    connections:
        driver.out --> sender.in;
}

%inifile: omnetpp.ini
[General]
network = Test
ned-path = .;../../../../src
sim-time-limit = 7ms
seed-set = 0
cmdenv-express-mode = false
**.vector-recording = false
*.receiver.numWlanInterfaces = 1
*.receiver.wlan[0].opMode = "n(mixed-2.4Ghz)"
*.receiver.wlan[0].mac.qosStation = ${qos=false,true}
*.receiver.wlan[0].radio.receiver.errorModel.typename = "BoundaryErrorModel"
*.receiver.wlan[0].radio.separateReceptionParts = ${parts=false,true}
*.sender.radio.separateReceptionParts = ${parts}
*.sender.radio.opMode = "n(mixed-2.4Ghz)"
*.sender.radio.initialRadioMode = "transmitter"
*.sender.radio.antenna.mobilityModule = "^.^.mobility"
*.sender.radio.sendRawBytes = ${raw=false,true}
*.radioMedium.signalAnalogRepresentation = ${analog="scalar","dimensional"}
**.radio.signalAnalogRepresentation = ${analog}
**.radio.receiver.bandwidth = 20MHz
*.radioMedium.backgroundNoise.power = -110dBm
**.mobility.initFromDisplayString = false
**.mobility.initialX = 10m
**.mobility.initialY = 10m
**.mobility.initialZ = 0m
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m

%contains: stdout
MAC aggregate boundary checks passed

%contains: stdout
Run statistics: total 16, successful 16
