%description:
Tests pushSegmentsOnWriteBoundary in a long write. The client writes 1000 bytes
and 12000 bytes, with RFC 3390 initial window and a peer window of 8000 bytes.
PSH is on the segments that end a write (1001, 13001), on the last segment of
each GSO burst of new data (3001, 6001, 9001; Linux tcp_transmit_skb()), and on
the mark of forced_push() at 7001 (Linux tcp_sendmsg(): the write fills more than
max_window/2 after the last mark).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000; 1.0 12000"
*.*_tcp.mss = 1000
*.cli_tcp.increasedIWEnabled = true
*.srv_tcp.advertisedWindow = 8000
*.cli_tcp.pushSegmentsOnWriteBoundary = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A P 1:1001(1000) ack 501 win 16384 
[1.001 A004] A.1000 > B.2000: A 1001:2001(1000) ack 501 win 16384 
[1.001 A005] A.1000 > B.2000: A P 2001:3001(1000) ack 501 win 16384 
[1.001 A006] A.1000 > B.2000: A 3001:4001(1000) ack 501 win 16384 
[1.003 B002] A.1000 < B.2000: A ack 2001 win 8000 
[1.003 B003] A.1000 < B.2000: A ack 4001 win 8000 
[1.005 A007] A.1000 > B.2000: A 4001:5001(1000) ack 501 win 16384 
[1.005 A008] A.1000 > B.2000: A P 5001:6001(1000) ack 501 win 16384 
[1.005 A009] A.1000 > B.2000: A P 6001:7001(1000) ack 501 win 16384 
[1.005 A010] A.1000 > B.2000: A 7001:8001(1000) ack 501 win 16384 
[1.005 A011] A.1000 > B.2000: A P 8001:9001(1000) ack 501 win 16384 
[1.005 A012] A.1000 > B.2000: A 9001:10001(1000) ack 501 win 16384 
[1.007 B004] A.1000 < B.2000: A ack 6001 win 8000 
[1.007 B005] A.1000 < B.2000: A ack 8001 win 8000 
[1.007 B006] A.1000 < B.2000: A ack 10001 win 8000 
[1.009 A013] A.1000 > B.2000: A 10001:11001(1000) ack 501 win 16384 
[1.009 A014] A.1000 > B.2000: A 11001:12001(1000) ack 501 win 16384 
[1.009 A015] A.1000 > B.2000: A P 12001:13001(1000) ack 501 win 16384 
[1.011 B007] A.1000 < B.2000: A ack 12001 win 8000 
[1.211 B008] A.1000 < B.2000: A ack 13001 win 8000 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
forced_push: PSH at sequence number 7001
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
