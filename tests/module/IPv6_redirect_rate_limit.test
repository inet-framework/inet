%description:
Tests that a router limits the rate of the ICMPv6 Redirects it sends
(RFC 4861 Section 8.2: "A router MUST limit the rate at which Redirect
messages are sent"), with the token bucket of RFC 4443 Section 2.4 (f).

Topology: hostA, r1 and r2 on one switch; hostB behind r2. hostA's route to
hostB goes via r1, and r1's route goes via the link-local address of r2, back
out the interface the echo requests arrived on, so every echo request makes
r1 send a Redirect. hostA discards each one, because its route names r1 by
its global address, not by the link-local source of the Redirect, and keeps
sending through r1.

hostA sends 40 echo requests, one per 50 ms, from t=2s to t=3.95s. With a
burst of 5 and a rate of 2 per second, the bucket allows 5 + 2 * 1.95 = 8.9
Redirects over that time, so r1 sends 8 in all. The postrun command counts
every Redirect r1 sends.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned
import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.ethernet.EthernetSwitch;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;

network RedirectRateLimit
{
    submodules:
        configurator: Ipv6NetworkConfigurator;
        hostA: StandardHost;
        sw: EthernetSwitch;
        r1: Router;
        r2: Router;
        hostB: StandardHost;
    connections:
        hostA.ethg++ <--> Eth100M <--> sw.ethg++;
        r1.ethg++ <--> Eth100M <--> sw.ethg++;
        r2.ethg++ <--> Eth100M <--> sw.ethg++;
        r2.ethg++ <--> Eth100M <--> hostB.ethg++;
}
%#--------------------------------------------------------------------------------------------------------------
%file: redirect.xml
<config>
  <interface hosts="hostA" names="eth0" address="2001:db8:2::10"/>
  <interface hosts="r1"    names="eth0" address="2001:db8:2::2"/>
  <interface hosts="r2"    names="eth0" address="2001:db8:2::3"/>
  <interface hosts="r2"    names="eth1" address="2001:db8:4::1"/>
  <interface hosts="hostB" names="eth0" address="2001:db8:4::2"/>

  <route hosts="hostA" destination="2001:db8:4::" prefixLength="64" gateway="2001:db8:2::2" interface="eth0"/>
  <route hosts="r1"    destination="2001:db8:4::" prefixLength="64" gateway="fe80::8aa:ff:fe00:6" interface="eth0"/>
  <route hosts="hostB" destination="2001:db8:2::" prefixLength="64" gateway="2001:db8:4::1" interface="eth0"/>
</config>
%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = ../../../../src;.
network = RedirectRateLimit
sim-time-limit = 4.1s
cmdenv-express-mode = false
cmdenv-log-prefix = "%C: "

**.hasIpv4 = false
**.hasIpv6 = true
**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.ipv6.neighbourDiscovery.dupAddrDetectTransmits = 0
*.configurator.addStaticRoutes = true
*.configurator.addRemoteRoutes = false
*.configurator.addDefaultRoutes = false
*.configurator.config = xmldoc("redirect.xml")
*.r1.ipv6.routingTable.routes = xml("<routingTable><local node='r1'><interface name='eth0' AdvSendAdvertisements='off'/></local></routingTable>")
*.r2.ipv6.routingTable.routes = xml("<routingTable><local node='r2'><interface name='eth0' AdvSendAdvertisements='off'/><interface name='eth1' AdvSendAdvertisements='off'/></local></routingTable>")

*.hostA.numApps = 1
*.hostA.app[0].typename = "PingApp"
*.hostA.app[0].destAddr = "2001:db8:4::2"
*.hostA.app[0].startTime = 2s
*.hostA.app[0].stopTime = 3.99s
*.hostA.app[0].sendInterval = 50ms
*.r1.ipv6.neighbourDiscovery.redirectRate = 2Hz
*.r1.ipv6.neighbourDiscovery.redirectBurst = 5
%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep -c "RedirectRateLimit.r1.ipv6.neighbourDiscovery: Sending ICMPv6 Redirect" test.out > test_redirects.out || true
%contains-regex: test_redirects.out
^8$
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
RedirectRateLimit.r1.ipv6.neighbourDiscovery: Not sending ICMPv6 Redirect to 2001:db8:2::10 for 2001:db8:4::2: rate limit reached
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
