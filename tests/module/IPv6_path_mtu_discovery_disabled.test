%description:
Tests that Path MTU Discovery can be turned off with the `pathMtuDiscovery`
parameter of the ~Ipv6 module.

Same scenario as IPv6_path_mtu_discovery, but with Path MTU Discovery disabled
on the client. The client then never learns the 1400-byte path MTU, keeps
sending 1448-byte datagrams that r2 cannot forward, and nothing arrives at the
server.

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = ../../../../examples;../../../../src
network = inet.examples.ipv6.nclients.NClientsEth
sim-time-limit = 15s
cmdenv-express-mode = false
cmdenv-log-prefix = "%C: "

# number of client computers
*.n = 1

*.r2.eth[1].*.mtu = 1400B

# turn off Path MTU Discovery
**.ipv6.ipv6.pathMtuDiscovery = false

**.cli[*].numApps = 1
**.cli[*].app[0].typename = "UdpBasicApp"
**.cli[*].app[0].destAddresses = "srv"
**.cli[*].app[0].destPort = 1000
**.cli[*].app[0].messageLength = 1400B

**.cli[*].app[0].startTime = 10s
**.cli[*].app[0].stopTime = 14s
**.cli[*].app[0].sendInterval = 1s

**.srv.numApps = 1
**.srv.app[0].typename = "UdpSink"
**.srv.app[0].localPort = 1000

# Ethernet NIC configuration
**.eth[*].queue.typename = "EthernetQosQueue"
**.eth[*].queue.dataQueue.typename = "DropTailQueue" # in routers
**.eth[*].queue.dataQueue.packetCapacity = 10  # in routers

%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%# the router still reports the problem
%contains: stdout
NClientsEth.r2.ipv6.icmpv6: sending ICMP error: (inet::Packet)Packet Too Big
%#--------------------------------------------------------------------------------------------------------------
%# but the client neither caches nor uses a path MTU
%not-contains: stdout
Path MTU for
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
Using cached path MTU
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
Received packet: (inet::Packet)UdpBasicAppData-
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
