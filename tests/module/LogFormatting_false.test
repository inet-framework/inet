%description:

With inet-log-formatting = false, the log contains no ANSI escape sequences:
the field name of an EV_FIELD, bold with inet-log-formatting = true, is
plain.

%inifile: omnetpp.ini

[General]
record-vector-results = false
record-scalar-results = false
ned-path = .;../../../../src;../../lib
network = inet.test.moduletest.lib.ClientServer
sim-time-limit = 1s
cmdenv-express-mode = false
cmdenv-event-banners = false
inet-log-formatting = false

%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Registering network interface, interface = (inet::NetworkInterface)lo[0] lo0
%not-contains-regex: stdout
\x1B\[
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
