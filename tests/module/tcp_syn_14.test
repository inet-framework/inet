%description:
Test connection setup with timestamps: a SYN-ACK that answers the first copy
of a retransmitted SYN is valid. The tester deletes B's SYN-ACK and A's
retransmitted SYN at t=4, so B retransmits its SYN-ACK, and the tester sets
its TSecr to the TSval of A's first SYN (1000). The TSecr check of A uses the
time of the first SYN as its lower bound (Linux tp->retrans_stamp), so A
accepts the SYN-ACK. With the time of the last SYN, A would send an RST.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.tOpen=1s
*.cli_app.sendScript="6 100"
*.*_tcp.timestampSupport = true
*.tcptester.script="b1 delete; a2 delete; b2 tsecr 1000"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "^\[testing\]\|PAWSACTIVEREJECTED" test.out > test_1.out || true
%contains: test_1.out
[testing]: [4.003 B002] A.1000 < B.2000: A S 250500:250500(0) ack 250001 win 16384   Option(s): MaxSegSize NOP NOP TS(4002,1000)# changing TSecr
[testing]: cli_tcp: SYN_SENT --> ESTABLISHED  (on RCV_SYN_ACK)
%not-contains: test_1.out
PAWSACTIVEREJECTED

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
