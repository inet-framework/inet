%description:
Check that an active scan's queued retune waits for the Probe Response ACK.
At seed 0, the first channel's dwell expires during the AP's Probe Response.
The station must ACK on channel 0 and then resume the scan on channel 1.

%file: ScanRetuneProbe.cc
#include <cstring>
#include <iostream>

#include "inet/common/InitStages.h"
#include "inet/common/Simsignals.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IReception.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211ControlInfo_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmitter.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

namespace Ieee80211ScanRetune_1 {

class ScanRetuneMac : public Ieee80211Mac
{
  private:
    simtime_t channelOneRequestedAt = -1;

  protected:
    void handleUpperCommand(cMessage *message) override
    {
        auto command = dynamic_cast<const Ieee80211ConfigureRadioCommand *>(message->getControlInfo());
        if (command && command->getChannelNumber() == 1 && channelOneRequestedAt < SIMTIME_ZERO)
            channelOneRequestedAt = simTime();
        Ieee80211Mac::handleUpperCommand(message);
    }

  public:
    simtime_t getChannelOneRequestedAt() const { return channelOneRequestedAt; }
};

Define_Module(ScanRetuneMac);

class ScanRetuneProbe : public cSimpleModule, public cListener
{
  private:
    opp_component_ptr<cModule> stationRadio;
    opp_component_ptr<cModule> accessPointRadio;
    ScanRetuneMac *stationMac = nullptr;
    cMessage *timer = nullptr;
    bool receivedAck = false;
    simtime_t probeResponseStart = -1;
    simtime_t probeResponseEnd = -1;
    int ackChannel = -1;
    int channelAtAckCompletion = -1;

    int getStationChannel() const
    {
        auto radio = check_and_cast<IRadio *>(stationRadio.get());
        auto transmitter = check_and_cast<const Ieee80211Transmitter *>(radio->getTransmitter());
        return transmitter->getChannel()->getChannelNumber();
    }

  protected:
    int numInitStages() const override { return NUM_INIT_STAGES; }

    void initialize(int stage) override
    {
        if (stage == INITSTAGE_LAST) {
            stationRadio = getModuleByPath("^.station.wlan[0].radio");
            accessPointRadio = getModuleByPath("^.ap.wlan[0].radio");
            stationMac = check_and_cast<ScanRetuneMac *>(getModuleByPath("^.station.wlan[0].mac"));
            stationRadio->subscribe(receptionStartedSignal, this);
            stationRadio->subscribe(transmissionStartedSignal, this);
            stationRadio->subscribe(transmissionEndedSignal, this);
            accessPointRadio->subscribe(packetSentToUpperSignal, this);
            timer = new cMessage("check ACK and scan channel");
            scheduleAt(SimTime(1450, SIMTIME_US), timer);
        }
    }

    void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *) override
    {
        if (signal == packetSentToUpperSignal) {
            auto packet = check_and_cast<const Packet *>(object);
            if (std::strcmp(packet->getName(), "WlanAck") == 0 && !packet->hasBitError())
                receivedAck = true;
        }
        else if (signal == receptionStartedSignal) {
            auto reception = check_and_cast<const IReception *>(object);
            auto transmission = check_and_cast<const Ieee80211Transmission *>(reception->getTransmission());
            if (std::strcmp(transmission->getPacket()->getName(), "ProbeResp") == 0 &&
                transmission->getChannel()->getChannelNumber() == 0) {
                probeResponseStart = reception->getStartTime();
                probeResponseEnd = reception->getEndTime();
            }
        }
        else {
            auto transmission = check_and_cast<const Ieee80211Transmission *>(object);
            if (std::strcmp(transmission->getPacket()->getName(), "WlanAck") == 0) {
                if (signal == transmissionStartedSignal)
                    ackChannel = transmission->getChannel()->getChannelNumber();
                else
                    channelAtAckCompletion = getStationChannel();
            }
        }
    }

    void handleMessage(cMessage *message) override
    {
        auto requestTime = stationMac->getChannelOneRequestedAt();
        if (requestTime <= probeResponseStart || requestTime >= probeResponseEnd)
            throw cRuntimeError("Expected the channel-1 request at the MAC during the channel-0 Probe Response");
        if (ackChannel != 0 || !receivedAck)
            throw cRuntimeError("Expected an ACK on channel 0 received by the AP, observed channel %d", ackChannel);
        if (channelAtAckCompletion != 0)
            throw cRuntimeError("Station left channel 0 before finishing the ACK");
        if (getStationChannel() != 1)
            throw cRuntimeError("Station did not retune to channel 1 after the ACK");
        std::cout << "Station finished its channel-0 ACK before retuning and the AP received it: PASS\n";
        endSimulation();
    }

    using cListener::finish;

  public:
    ~ScanRetuneProbe() override
    {
        if (stationRadio) {
            stationRadio->unsubscribe(receptionStartedSignal, this);
            stationRadio->unsubscribe(transmissionStartedSignal, this);
            stationRadio->unsubscribe(transmissionEndedSignal, this);
        }
        if (accessPointRadio)
            accessPointRadio->unsubscribe(packetSentToUpperSignal, this);
        cancelAndDelete(timer);
    }
};

Define_Module(ScanRetuneProbe);

} // namespace Ieee80211ScanRetune_1

%file: test.ned
import inet.linklayer.ieee80211.mac.Ieee80211Mac;
import inet.node.inet.WirelessHost;
import inet.node.wireless.AccessPoint;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

simple ScanRetuneProbe
{
    parameters:
        @class(::Ieee80211ScanRetune_1::ScanRetuneProbe);
}

module ScanRetuneMac extends Ieee80211Mac
{
    parameters:
        @class(::Ieee80211ScanRetune_1::ScanRetuneMac);
}

network ScanRetuneNetwork
{
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        station: WirelessHost;
        ap: AccessPoint;
        probe: ScanRetuneProbe;
}

%inifile: omnetpp.ini
[General]
network = ScanRetuneNetwork
ned-path = .;../../../../src
sim-time-limit = 2ms
seed-set = 0
record-scalar-results = false
record-vector-results = false
*.radioMedium.analogModel.ignorePartialInterference = true
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 6Mbps
**.wlan[*].mac.qosStation = false
**.wlan[*].radio.typename = "Ieee80211ScalarRadio"
**.wlan[*].radio.bandName = "5 GHz (mapped 20 MHz)"
**.wlan[*].radio.channelNumber = 0
**.mobility.initFromDisplayString = false
*.ap.mobility.initialX = 1m
**.mobility.initialX = 0m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m
*.station.wlan[0].mgmt.typename = "Ieee80211MgmtSta"
*.station.wlan[0].mac.typename = "ScanRetuneMac"
*.station.wlan[0].agent.typename = "Ieee80211AgentSta"
*.station.wlan[0].agent.activeScan = true
*.station.wlan[0].agent.channelsToScan = "0 1"
*.station.wlan[0].agent.startingTime = 1ms
*.station.wlan[0].agent.probeDelay = 200us
*.station.wlan[0].agent.minChannelTime = 120us
*.station.wlan[0].agent.maxChannelTime = 135us
*.station.wlan[0].agent.defaultSsid = "ReviewAP"
*.ap.wlan[0].mgmt.ssid = "ReviewAP"
*.ap.wlan[0].mgmt.beaconInterval = 60s

%contains: stdout
Station finished its channel-0 ACK before retuning and the AP received it: PASS
%not-contains: stdout
undisposed object:
