%description:
Tests that a tunnel exit point survives a netfilter PREROUTING hook that drops
the decapsulated datagram.

Topology: A --- B --- H. Host A tunnels its UDP traffic for H to router B. A
hook on B drops every UDP datagram at PREROUTING, so B drops each inner
datagram after decapsulating it. Ipv6::datagramPreRoutingHook() deletes a
dropped datagram itself, so the tunnel exit point must not delete it again.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import inet.test.moduletest.lib.InnerDatagramDropper;
import ned.DatarateChannel;

module DroppingRouter6 extends Router6
{
    submodules:
        dropper: InnerDatagramDropper {
            networkProtocolModule = "^.ipv6.ipv6";
        }
}

network Ipv6TunnelExitDropTestNetwork
{
    types:
        channel ethline extends DatarateChannel {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        configurator: Ipv6NetworkConfigurator;
        A: StandardHost6;
        B: DroppingRouter6;
        H: StandardHost6;
    connections:
        A.ethg++ <--> ethline <--> B.ethg++;
        B.ethg++ <--> ethline <--> H.ethg++;
}

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Ipv6TunnelExitDropTestNetwork
ned-path = .;../../../../src;../../lib
sim-time-limit = 5s
cmdenv-express-mode = false
cmdenv-log-prefix = "%C: "

**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.configurator.config = xml("<config> \
    <interface among='A B' prefix='2001:db8:1::/64'/> \
    <interface among='B H' prefix='2001:db8:2::/64'/> \
    <route hosts='A' destination='2001:db8:2:0:8aa:ff:fe00:4' prefixLength='128' interface='tun0'/> \
  </config>")

**.A.numTunInterfaces = 1
**.A.tun[0].typename = "Ipv6TunnelInterface"
**.A.tun[0].source = "2001:db8:1:0:8aa:ff:fe00:1"
**.A.tun[0].destination = "2001:db8:1:0:8aa:ff:fe00:2"

**.A.numApps = 1
**.A.app[0].typename = "UdpBasicApp"
**.A.app[0].destAddresses = "2001:db8:2:0:8aa:ff:fe00:4"
**.A.app[0].destPort = 5000
**.A.app[0].messageLength = 100B
**.A.app[0].sendInterval = 0.5s
**.A.app[0].startTime = 3s
**.A.app[0].stopTime = 3.9s

**.H.numApps = 1
**.H.app[0].typename = "UdpSink"
**.H.app[0].localPort = 5000

%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Ipv6TunnelExitDropTestNetwork.B.dropper: Dropping UdpBasicAppData-1
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Ipv6TunnelExitDropTestNetwork.H.app[0]: received 0 packets
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
