%description:
Tests MSG_MORE (the tag TcpSendMoreReq). The client writes 300 bytes with
MSG_MORE at t=1, which TCP holds, and 300 bytes without it at t=1.1, which sends
both writes in one segment with PSH.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 300 more; 1.1 300"
*.*_tcp.mss = 1000

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.101 A003] A.1000 > B.2000: A P 1:601(600) ack 501 win 16384 
[1.303 B002] A.1000 < B.2000: A ack 601 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Holding the partial segment (TCP_CORK or MSG_MORE)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
