%description:
Tests RFC 9293 MUST-37: "As long as the receiving TCP peer continues to send
acknowledgments in response to the probe segments, the sending TCP peer MUST
allow the connection to stay open". The server reads nothing for 1500 s, so
its window stays zero, and it answers each probe. The client sends the same
probe octet each 60 s (maxPersistTimeout) at the end, and the connection stays
open; a probe that the retransmission timer repeats would abort it after 12
retransmissions.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 1500s
*.cli_app.sendScript="1.0 5000"
*.*_tcp.mss = 1000
*.srv_tcp.advertisedWindow = 2000
*.srv_app.autoRead=false

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1384.409 A032] A.1000 > B.2000: A 2001:2002(1) ack 501 win 16384 
[1384.411 B031] A.1000 < B.2000: A ack 2001 win 0 
[1444.409 A033] A.1000 > B.2000: A 2001:2002(1) ack 501 win 16384 
[1444.411 B032] A.1000 < B.2000: A ack 2001 win 0 
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
Retransmission count exceeds
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
aborting connection
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
