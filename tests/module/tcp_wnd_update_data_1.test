%description:
Tests the window update from a data segment of the peer (RFC 9293 section
3.10.7.4). The server offers 2000 bytes and reads nothing, so its window is
zero after two segments. It reads at t=1.5 s, which sends no window update, and
sends 100 bytes at t=1.6 s: that data segment carries the open window, and the
client sends its last 1000 bytes at once. Master took the window only from a
segment without data, so the client waited for its zero-window probe.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 3000"
*.*_tcp.mss = 1000
*.srv_tcp.advertisedWindow = 2000
*.srv_app.autoRead=false
*.srv_app.readScript="1.5 2000"
*.srv_app.tSend = 1.6s
*.srv_app.sendBytes = 100B

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 1001 win 1000 
[1.205 A004] A.1000 > B.2000: A 1001:2001(1000) ack 501 win 16384 
[1.407 B003] A.1000 < B.2000: A ack 2001 win 0 
[1.601 B004] A.1000 < B.2000: A 501:601(100) ack 2001 win 2000 
[1.603 A005] A.1000 > B.2000: A 2001:3001(1000) ack 501 win 16384 
[1.803 A006] A.1000 > B.2000: A ack 601 win 16384 
[1.805 B005] A.1000 < B.2000: A ack 3001 win 1000 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
