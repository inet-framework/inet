%description:
Tests the RST of a DCTCP connection: RFC 8257 section 3.6 asks for ECT on it.
The server closes the connection (abortOnDataAfterClose=true), and data that
arrives after that makes it reset the connection; the RST is ECT(0).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000; 3.0 1000"
*.*_tcp.tcpEcnMode = "rfc3168"
*.*_tcp.tcpAlgorithmClass = "DcTcp"
*.srv_tcp.abortOnDataAfterClose = true
*.srv_app.tClose=2s

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[3.001 A005] A.1000 > B.2000: A 1001:2001(1000) ack 502 win 16384 ECT(0) 
srv_tcp: FIN_WAIT_2 --> CLOSED  (on ABORT)
[3.003 B004] A.1000 < B.2000: R win 0 ECT(0) 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
