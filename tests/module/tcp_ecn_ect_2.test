%description:
Tests that the control segments of an ECN connection are Not-ECT: the SYN-ACK
(RFC 3168 section 6.1.1: "A host MUST NOT set ECT on SYN or SYN-ACK packets")
and the FIN without data (a segment without data, RFC 3168 section 6.1.4).
Before, both were ECT. The data segment is ECT(0).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000"
*.cli_app.tClose=2s
*.*_tcp.ecnWillingness = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.003 B001] A.1000 < B.2000: A S E 500:500(0) ack 1 win 16384   Option(s): MaxSegSize
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 ECT(0) 
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[2.001 A004] A.1000 > B.2000: A F ack 501 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
