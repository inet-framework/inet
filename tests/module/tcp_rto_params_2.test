%description:
Tests minRexmitTimeout. The client measures an RTT of 2 ms (the server sends
its ACKs at once), so the RTO is the lower limit, 0.5 s (1 s by default). The
tester removes the second data segment, and its retransmission comes after
0.5 s.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 500; 2.0 500"
*.cli_tcp.minRexmitTimeout = 0.5s
*.srv_tcp.delayedAcksEnabled = false # an RTT of 2 ms, so that the minimum applies
*.tcptester.script="a4 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:501(500) ack 501 win 16384 
[1.003 B002] A.1000 < B.2000: A ack 501 win 16384 
[2.001 A004] A.1000 > B.2000: A 501:1001(500) ack 501 win 16384 # deleting
[2.501 A005] A.1000 > B.2000: A 501:1001(500) ack 501 win 16384 
[2.503 B003] A.1000 < B.2000: A ack 1001 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
