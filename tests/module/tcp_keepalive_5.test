%description:
Tests that an answered keepalive probe does not count toward
keepAliveProbeCount, also when keepAliveInterval is longer than the idle time
(Linux tcp_ack() clears the probe count). The client has keepalive with an
idle time of 10 s, an interval of 20 s and a probe count of 2. The server
answers each probe, so each probe after an idle time is the first, and the
connection stays open until the close at t=70.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 80s
*.cli_app.tClose=70s
*.cli_tcp.keepAliveEnabled = true
*.cli_tcp.keepAliveIdleTime = 10s
*.cli_tcp.keepAliveInterval = 20s
*.cli_tcp.keepAliveProbeCount = 2

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[10.005 A003] A.1000 > B.2000: A ack 501 win 16384 
[10.007 B002] A.1000 < B.2000: A ack 1 win 16384 
[30.005 A004] A.1000 > B.2000: A ack 501 win 16384 
[30.007 B003] A.1000 < B.2000: A ack 1 win 16384 
[50.005 A005] A.1000 > B.2000: A ack 501 win 16384 
[50.007 B004] A.1000 < B.2000: A ack 1 win 16384 
cli_tcp: ESTABLISHED --> FIN_WAIT_1  (on CLOSE)
[70.001 A006] A.1000 > B.2000: A F ack 501 win 16384 
srv_tcp: ESTABLISHED --> CLOSE_WAIT  (on RCV_FIN)
[70.003 B005] A.1000 < B.2000: A ack 2 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
aborting connection
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
