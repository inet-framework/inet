%description:
Tests TCP_NOTSENT_LOWAT from the module parameter notsentLowat (2000 bytes). The
client application queues 6000 bytes, so the unsent bytes exceed the mark, and
TCP sends TCP_I_SEND_MSG when the sending brings them to the mark: after A006,
2000 bytes are unsent.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 6000"
*.*_tcp.mss = 1000
*.*_tcp.delayedAcksEnabled = false
*.cli_tcp.notsentLowat = 2000B
*.cli_app.logIndications = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.003 B002] A.1000 < B.2000: A ack 1001 win 16384 
[1.005 A004] A.1000 > B.2000: A 1001:2001(1000) ack 501 win 16384 
[1.005 A005] A.1000 > B.2000: A 2001:3001(1000) ack 501 win 16384 
[1.007 B003] A.1000 < B.2000: A ack 2001 win 16384 
[1.007 B004] A.1000 < B.2000: A ack 3001 win 16384 
cli_app: TCP_I_SEND_MSG
[1.009 A006] A.1000 > B.2000: A 3001:4001(1000) ack 501 win 16384 
[1.009 A007] A.1000 > B.2000: A 4001:5001(1000) ack 501 win 16384 
[1.009 A008] A.1000 > B.2000: A 5001:6001(1000) ack 501 win 16384 
[1.011 B005] A.1000 < B.2000: A ack 4001 win 16384 
[1.011 B006] A.1000 < B.2000: A ack 5001 win 16384 
[1.011 B007] A.1000 < B.2000: A ack 6001 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
