%description:
Tests that TcpVegas changes cwnd by at most one segment for each RTT in
congestion avoidance (alpha and beta, as Linux tcp_vegas_cong_avoid()). The
client sends 1 MB over a bottleneck with a queue of 10 packets. Vegas decides
once per RTT; the script counts the cwnd steps between two decisions of
congestion avoidance, and the largest count is 1.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "
**.client.tcp.**.cmdenv-log-level=DETAIL
**.cmdenv-log-level=OFF

*.testing=true

network = inet.test.moduletest.lib.ClientServer
total-stack = 7MiB

*.server*.tcpType = "Tcp"
*.client*.tcpType = "Tcp"
**.tcp.tcpAlgorithmClass = "TcpVegas"

## tcp apps
**.client.numApps = 1
**.client.app[0].typename = "TcpSessionApp"
**.client.app[0].active = true
**.client.app[0].localPort = -1
**.client.app[0].connectAddress = "server"
**.client.app[0].connectPort = 1000
**.client.app[0].tOpen = 0.2s
**.client.app[0].tSend = 0.4s
**.client.app[0].sendBytes = 1000000B
**.client.app[0].sendScript = ""
**.client.app[0].tClose = 25s

**.server.numApps = 1
**.server.app[0].typename="TcpSinkApp"
**.server.app[0].localPort = 1000

# NIC configuration
**.ppp[*].queue.typename = "DropTailQueue"
**.ppp[*].queue.packetCapacity = 10

*.configurator.config=xml("<config><interface hosts='*' address='192.168.1.x' netmask='255.255.255.0'/></config>")

%#--------------------------------------------------------------------------------------------------------------
%file: steps.pl
# the cwnd steps between two decisions of congestion avoidance
my ($inCa, $steps, $max, $rtts) = (0, 0, 0, 0);
open FILE, '<test.out';
while (my $line = <FILE>) {
    if ($line =~ /Vegas: (Slow Start|Congestion avoidance)/) {
        $max = $steps if $inCa && $steps > $max;
        $inCa = $1 eq 'Congestion avoidance';
        $rtts++ if $inCa;
        $steps = 0;
    }
    elsif ($inCa && $line =~ /Vegas: (incr|decr) cwnd linearly/) {
        $steps++;
    }
}
print "congestion avoidance RTTs: $rtts\n";
print "largest number of cwnd steps in one RTT of congestion avoidance: $max\n";
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: perl ./steps.pl
%#--------------------------------------------------------------------------------------------------------------
%contains-regex: postrun-command(1).out
congestion avoidance RTTs: [1-9][0-9]+
%contains: postrun-command(1).out
largest number of cwnd steps in one RTT of congestion avoidance: 1
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
