%description:

DimensionalMediumAnalogModel with attenuateWithCenterFrequency = false, no
obstacle loss, and trace logging: the attenuation sampled across the band is
printed in the log, without the obstacle loss the medium does not have. One
ping request and its reply are received.

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.common.medium.DimensionalRadioMedium;

network Test
{
    submodules:
        radioMedium: DimensionalRadioMedium;
        configurator: Ipv4NetworkConfigurator;
        host1: WirelessHost;
        host2: WirelessHost;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 1s
ned-path = .;../../../../src
cmdenv-express-mode = false
cmdenv-event-banners = false
**.arp.typename = "GlobalArp"

**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
*.host1.mobility.initialX = 400m
*.host2.mobility.initialX = 500m

*.radioMedium.backgroundNoise.powerSpectralDensity = -113dBmWpMHz
*.radioMedium.analogModel.attenuateWithCenterFrequency = false
*.host*.wlan[*].typename = "AckingWirelessInterface"
*.host*.wlan[*].bitrate = 2Mbps
*.host*.wlan[*].mac.headerLength = 10B
*.host*.wlan[*].radio.typename = "ApskDimensionalRadio"
*.host*.wlan[*].radio.centerFrequency = 2.4GHz
*.host*.wlan[*].radio.bandwidth = 2MHz
*.host*.wlan[*].radio.transmitter.power = 100mW
*.host*.wlan[*].radio.transmitter.preambleDuration = 0s
*.host*.wlan[*].radio.transmitter.headerLength = 96b
*.host*.wlan[*].radio.receiver.energyDetection = -95dBm
*.host*.wlan[*].radio.receiver.sensitivity = -95dBm
*.host*.wlan[*].radio.receiver.snirThreshold = 4dB

*.host1.numApps = 1
*.host1.app[0].typename = "PingApp"
*.host1.app[0].destAddr = "host2"
*.host1.app[0].count = 1
*.host1.app[0].sendInterval = 1s
*.host1.app[0].startTime = 0.5s
*.host1.app[0].printPing = true

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains-regex: stdout
sent: 1\s+received: 1\s+loss rate \(%\): 0
%contains: test.out
(FrequencyDependentAttenuation
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
