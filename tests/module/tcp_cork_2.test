%description:
Tests the cork timer (Linux ICSK_TIME_PROBE0). The client corks, writes 500
bytes at t=1, and 100 bytes at t=2 and t=3, and never uncorks. With nothing in
flight, the cork timer sends the held data one RTO after the first hold (t=4,
the initial RTO is 3 s), with PSH (Linux tcp_write_wakeup()). The later writes
do not restart the timer, as Linux tcp_check_probe_timer().

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.corkScript="0.5 1"
*.cli_app.sendScript="1.0 500; 2.0 100; 3.0 100"
*.*_tcp.mss = 1000

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[4.001 A003] A.1000 > B.2000: A P 1:701(700) ack 501 win 16384 
[4.203 B002] A.1000 < B.2000: A ack 701 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
CORK timer expired
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
