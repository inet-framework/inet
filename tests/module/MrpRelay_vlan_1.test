%description:

Tests that MrpRelay forwards VLAN-tagged frames in a switch that has an
802.1Q layer: the frames leave the switch tagged with their VLAN ID, PCP and
DEI, and destinations are looked up in the VLAN of the frame (independent VLAN
learning). The network and the traffic are described in
lib/relay-vlan.ini; two host pairs tag their frames with VLANs 42 and 81, and
a third pair with the same MAC addresses sends untagged frames.

MrpRelay is the relay of a switch with hasMrp. MRP is disabled, so the ring
ports, the two extra ports looped to each other, do not forward.

Every pair must receive its data. The expected frame counts at the hosts are
those of the same network with a BridgingLayer relay in the switch. The tag
inserter of the switch must set the VLAN IDs of both VLANs, and the PCP and
DEI that a1 sent.

%file: test.ned

import inet.node.ethernet.Eth100M;
import inet.test.moduletest.lib.RelayVlanTestNetwork;

network MrpRelayVlanTestNetwork extends RelayVlanTestNetwork
{
    connections:
        switch.ethg[6] <--> Eth100M <--> switch.ethg[7];
}

%inifile: omnetpp.ini

[General]
ned-path = .;../../../../src;../../lib
network = MrpRelayVlanTestNetwork
*.switch.hasMrp = true
*.switch.llc.typename = "Ieee8022Llc"
*.switch.numEthInterfaces = 8
*.switch.mrp.ringPort1 = 6
*.switch.mrp.ringPort2 = 7
*.switch.mrp.uuid0 = 1
*.switch.mrp.uuid1 = 1
include ../../lib/relay-vlan.ini

%subst: /\x1B\[[0-9;]*m//

%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.a1.eth[0].macLayer.fcsChecker incomingPackets:count 28
%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.a2.eth[0].macLayer.fcsChecker incomingPackets:count 51
%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.a2.app[0] packetReceived:sum(packetBytes) 65536
%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.b1.eth[0].macLayer.fcsChecker incomingPackets:count 28
%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.b2.eth[0].macLayer.fcsChecker incomingPackets:count 51
%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.b2.app[0] packetReceived:sum(packetBytes) 65536
%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.c1.eth[0].macLayer.fcsChecker incomingPackets:count 28
%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.c2.eth[0].macLayer.fcsChecker incomingPackets:count 51
%contains: results/General-#0.sca
scalar MrpRelayVlanTestNetwork.c2.app[0] packetReceived:sum(packetBytes) 65536
%contains: stdout
Setting VID, vid = 42.
%contains: stdout
Setting VID, vid = 81.
%contains: stdout
Setting PCP, pcp = 5.
%contains: stdout
Setting dropEligible, dei = 1.
