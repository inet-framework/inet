%description:
Tests a window probe of an ECN connection: RFC 3168 section 6.1.6, "the TCP
data sender MUST NOT set either an ECT codepoint or the CWR bit on window
probe packets." The tester marks the first data segment CE, and the ACK with
ECE closes the window. The sender reduces cwnd, but its next segment is the
window probe at t=2 s, without ECT and without CWR. Before, the probe carried
both.

%inifile: omnetpp.ini
[General]
record-vector-results = false
sim-time-limit = 8s
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 2000"
*.srv_app.autoRead=false
*.srv_app.readScript="30 4000"
*.tcptester.script="a3 ce"
*.*_tcp.mss = 1000
*.*_tcp.delayedAcksEnabled = false
*.srv_tcp.advertisedWindow = 1000
*.*_tcp.ecnWillingness = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.003 B002] A.1000 < B.2000: A E ack 1001 win 0 
[2.005 A004] A.1000 > B.2000: A 1001:1002(1) ack 501 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
