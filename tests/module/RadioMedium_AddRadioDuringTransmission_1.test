%description:

A radio that is added to the radio medium while a transmission is on the air
must see that transmission as interference, the same as a radio that was
already there when the transmission started. The medium computes the
arrival at the new radio, and must also enter it into the radio's reception
intervals, which the default communication cache searches for interference.

Host1 pings host2 once at 0.5s with a long packet. At 0.502s, while the ping
request is on the air, the probe creates a listener (a radio and a mobility)
at runtime, the same way the ScenarioManager create-module command does.
Then, for the listener and for host2's radio, it counts the transmissions
whose arrival at the radio overlaps the next 100us, and the transmissions
that the communication cache returns as interfering over the same interval.
Both radios must have one of each.

%file: test.cc

#include "inet/physicallayer/wireless/common/contract/packetlevel/IArrival.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ICommunicationCache.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadio.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadioMedium.h"

using namespace inet;
using namespace inet::physicallayer;

namespace RadioMedium_AddRadioDuringTransmission_1 {

class Probe : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(0.502, new cMessage("create")); }

    virtual void handleMessage(cMessage *msg) override
    {
        cModule *network = getParentModule();
        cModule *listener = cModuleType::get("Listener")->create("listener", network);
        listener->finalizeParameters();
        listener->buildInside();
        listener->callInitialize();
        auto medium = check_and_cast<IRadioMedium *>(getModuleByPath("^.radioMedium"));
        auto communicationCache = const_cast<ICommunicationCache *>(medium->getCommunicationCache());
        simtime_t startTime = simTime();
        simtime_t endTime = startTime + SimTime(100, SIMTIME_US);
        for (const char *path : {"^.listener.radio", "^.host2.wlan[0].radio"}) {
            auto radio = check_and_cast<IRadio *>(getModuleByPath(path));
            int arrivingCount = 0;
            communicationCache->mapTransmissions([&] (const ITransmission *transmission) {
                auto arrival = communicationCache->getCachedArrival(radio, transmission);
                if (arrival != nullptr && !(arrival->getEndTime() < startTime || endTime < arrival->getStartTime()))
                    arrivingCount++;
            });
            auto interferingTransmissions = communicationCache->computeInterferingTransmissions(radio, startTime, endTime);
            std::cout << "probe: " << path << ": " << arrivingCount << " arriving, " << interferingTransmissions->size() << " interfering" << std::endl;
            delete interferingTransmissions;
        }
        delete msg;
    }
};

Define_Module(Probe);

} // namespace RadioMedium_AddRadioDuringTransmission_1

%file: test.ned

import inet.mobility.static.StationaryMobility;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.apsk.packetlevel.ApskScalarRadio;
import inet.physicallayer.wireless.common.medium.ScalarRadioMedium;

simple Probe
{
    @class(Probe);
}

module Listener
{
    submodules:
        mobility: StationaryMobility;
        radio: ApskScalarRadio;
    connections allowunconnected:
}

network Test
{
    submodules:
        radioMedium: ScalarRadioMedium;
        configurator: Ipv4NetworkConfigurator;
        host1: WirelessHost;
        host2: WirelessHost;
        probe: Probe;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 1s
ned-path = .;../../../../src
**.arp.typename = "GlobalArp"

**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
*.host1.mobility.initialX = 400m
*.host2.mobility.initialX = 450m
*.listener.mobility.initialX = 425m

*.radioMedium.backgroundNoise.power = -110dBm

**.radio.centerFrequency = 2.4GHz
**.radio.bandwidth = 2MHz
**.radio.transmitter.power = 100mW
**.radio.transmitter.preambleDuration = 0s
**.radio.transmitter.headerLength = 96b
**.radio.receiver.energyDetection = -90dBm
**.radio.receiver.sensitivity = -85dBm
**.radio.receiver.snirThreshold = 4dB
*.listener.radio.antenna.mobilityModule = "^.^.mobility"
*.listener.radio.transmitter.bitrate = 2Mbps
*.listener.radio.receiver.bitrate = 2Mbps

*.host*.wlan[*].typename = "AckingWirelessInterface"
*.host*.wlan[*].bitrate = 2Mbps
*.host*.wlan[*].mac.headerLength = 10B
*.host*.wlan[*].radio.typename = "ApskScalarRadio"

*.host1.numApps = 1
*.host1.app[0].typename = "PingApp"
*.host1.app[0].destAddr = "host2"
*.host1.app[0].count = 1
*.host1.app[0].packetSize = 1000B
*.host1.app[0].startTime = 0.5s

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
probe: ^.listener.radio: 1 arriving, 1 interfering
%contains: stdout
probe: ^.host2.wlan[0].radio: 1 arriving, 1 interfering
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
