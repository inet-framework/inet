%description:
Tests that LinuxTcp turns HyStart on in the algorithm of its connections.
TcpCubic has slowStartExit = "none", and LinuxTcp sets the default of its
connections to "hystart" with a pattern assignment. The client has Tcp and the
server LinuxTcp, both with TcpCubic, and nothing else sets the parameter.
The connections stay open, so the scalar file records the parameters of
both algorithms at the end of the run.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.script=""

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 30000"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.srv_tcp.typename = "LinuxTcp"
*.cli_tcp.tcpAlgorithmClass = "TcpCubic"

%#--------------------------------------------------------------------------------------------------------------
%# Tcp keeps the default of TcpCubic
%contains: results/General-#0.sca
par TcpTestNet1.cli_tcp.conn-0.algorithm slowStartExit "\"none\""
%# the pattern of LinuxTcp sets it in the connection that the listener forks
%contains: results/General-#0.sca
par TcpTestNet1.srv_tcp.conn-3.algorithm slowStartExit "\"hystart\""
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
