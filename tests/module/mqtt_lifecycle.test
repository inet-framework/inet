%description:
Repeated application-only stop/start and crash/start cross pending keepalive and
connection deadlines. Completion without stale self-messages and undisposed
objects checks timer cancellation and destruction in the real applications.

%file: test.ned
import inet.tests.mqtt.MqttTestNetwork;
import inet.common.scenario.ScenarioManager;
network MqttLifecycleModuleNetwork extends MqttTestNetwork {
    submodules:
        scenarioManager: ScenarioManager;
}

%file: scenario.xml
<scenario>
  <at t="1"><shutdown module="publisher.app[0]"/></at>
  <at t="2"><startup module="publisher.app[0]"/></at>
  <at t="3"><crash module="publisher.app[0]"/></at>
  <at t="4"><startup module="publisher.app[0]"/></at>
  <at t="5"><shutdown module="broker.app[0]"/></at>
  <at t="6"><startup module="broker.app[0]"/></at>
</scenario>

%inifile: omnetpp.ini
[General]
network = MqttLifecycleModuleNetwork
ned-path = .;../../../../src;../../../networks
seed-set = 0
sim-time-limit = 8s
*.scenarioManager.script = xmldoc("scenario.xml")
*.broker.numApps = 1
*.broker.app[0].typename = "MqttBroker"
*.publisher.numApps = 1
*.publisher.app[0].typename = "MqttClient"
*.publisher.app[0].clientIdentifier = "publisher"
*.publisher.app[0].connectAddress = "broker"
*.publisher.app[0].startTime = 0.1s
*.publisher.app[0].cleanSession = false
*.publisher.app[0].keepAlive = 2s

%contains: stdout
Simulation time limit reached

%postrun-command: rg 'undisposed object:' test.out > undisposed.out || true
%not-contains: undisposed.out
undisposed object:
