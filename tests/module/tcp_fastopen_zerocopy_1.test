%description:
Tests MSG_ZEROCOPY with the data of a Fast Open SYN. The client writes 200 bytes
with zero copy, which go on its SYN (without a cookie, as the server accepts),
and the SYN-ACK acknowledges them. The application gets the completion when the
SYN goes out. Master completed zero-copy writes only in sendSegment(), which
never sends this data, so the completion never came.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 10s
*.cli_app.fastOpen=true
*.cli_app.tSend=0s
*.cli_app.sendBytes=200B
*.cli_app.zerocopy = true
*.cli_app.logIndications = true
*.cli_tcp.fastopenClientEnabled = true
*.cli_tcp.fastopenClientNoCookieRequired = true
*.srv_tcp.fastopenAcceptWithoutCookie = true
*.srv_tcp.fastopenServerEnabled = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.001 A001] A.1000 > B.2000: S 0:200(200) win 16384   Option(s): MaxSegSize
srv_tcp: LISTEN --> SYN_RCVD  (on RCV_SYN)
[0.003 B001] A.1000 < B.2000: A S 500:500(0) ack 201 win 16384   Option(s): MaxSegSize
cli_tcp: SYN_SENT --> ESTABLISHED  (on RCV_SYN_ACK)
cli_app: TCP_I_ESTABLISHED
[0.005 A002] A.1000 > B.2000: A ack 501 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Notifying app: ZEROCOPY_COMPLETION id=0
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
