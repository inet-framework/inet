%description:
HCF replaces a retained mode tag when rate control changes the rate after an ACK timeout.
The prepared response mode, Duration/ID, and airtime agree with the actual radio transmissions.
Both 6-to-24 Mbps and 24-to-6 Mbps retries use the production rate-selection and transmission paths.

%file: RetryMode.cc
#include "TxopTestSupport.h"
#include "inet/common/Simsignals.h"
#include "inet/linklayer/ieee80211/mac/contract/IRateControl.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"

namespace inet {
namespace ieee80211 {

using namespace physicallayer;

// This controlled rate change follows real failure feedback from HCF.
class RetryModeRateControl : public cSimpleModule, public IRateControl
{
  public:
    int failures = 0;
    int successes = 0;

    virtual const IIeee80211Mode *getRate(const MacAddress& receiverAddress) override
    {
        Enter_Method("getRate");
        return Ieee80211ModeSet::getModeSet("a")->getMode(bps(par(failures ? "retryBitrate" : "initialBitrate").doubleValue()));
    }

    virtual void frameTransmitted(Packet *frame, int retryCount, bool isSuccessful, bool isGivenUp) override
    {
        Enter_Method("frameTransmitted");
        ASSERT(!isGivenUp);
        if (isSuccessful)
            successes++;
        else
            failures++;
    }

    virtual void frameReceived(Packet *frame) override {}
};
Define_Module(RetryModeRateControl);

class RetryModeHcf : public ExchangeHcf
{
  public:
    bool suppressedAck = false;
    std::vector<PreparedReceive> responses;
    std::vector<simtime_t> planDurations;

    void injectOne()
    {
        Enter_Method("injectOne");
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setTid(5);
        header->setReceiverAddress(MacAddress("02:00:00:00:00:02"));
        header->setTransmitterAddress(MacAddress("02:00:00:00:00:01"));
        header->setAddress3(MacAddress("02:00:00:00:00:01"));
        auto packet = new Packet("retry-mode-data", header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(200)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
    }

  protected:
    virtual void transmitFrame(Packet *packet, simtime_t ifs, const PreparedTransmit *prepared) override
    {
        ASSERT(prepared && prepared->length == B(230));
        auto header = packet->peekAtFront<Ieee80211DataHeader>();
        if (header->getRetry()) {
            ASSERT(events.size() == 1);
            // Planning must change only its duplicate before HCF commits the selected mode.
            ASSERT(packet->getTag<Ieee80211ModeReq>()->getMode() == events[0].mode);
            ASSERT(prepared->mode != events[0].mode);
        }
        auto plan = frameSequenceHandler->getContext()->getActivePlan();
        auto steps = plan->flatten();
        ASSERT(steps.size() == 2);
        auto response = check_and_cast<IReceiveStep *>(steps[1])->getPreparedReceive();
        ASSERT(response && response->request == packet);
        responses.push_back(*response);
        // Do not retain a borrowed packet pointer after the exchange.
        responses.back().request = nullptr;
        planDurations.push_back(plan->duration);
        Hcf::transmitFrame(packet, ifs, prepared);
    }

    virtual void transmitControlResponseFrame(Packet *response, const Ptr<const Ieee80211MacHeader>& responseHeader,
            Packet *received, const Ptr<const Ieee80211MacHeader>& receivedHeader) override
    {
        ASSERT(responseHeader->getType() == ST_ACK);
        if (!suppressedAck) {
            suppressedAck = true;
            take(response);
            delete response;
            return;
        }
        Hcf::transmitControlResponseFrame(response, responseHeader, received, receivedHeader);
    }

    virtual void recipientProcessTransmittedControlResponseFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override
    {
        responseCount++;
        Hcf::recipientProcessTransmittedControlResponseFrame(packet, header);
    }
};
Define_Module(RetryModeHcf);

struct RadioAttempt
{
    const IIeee80211Mode *mode;
    simtime_t start;
    simtime_t end;
};

class RetryModeTest : public cSimpleModule, public cListener
{
  protected:
    cModule *senderRadio = nullptr;
    cModule *receiverRadio = nullptr;
    std::vector<RadioAttempt> dataTransmissions;
    std::vector<RadioAttempt> ackTransmissions;

    virtual void receiveSignal(cComponent *source, simsignal_t signalID, cObject *object, cObject *details) override
    {
        Enter_Method("receiveSignal");
        ASSERT(signalID == transmissionStartedSignal);
        auto transmission = check_and_cast<const Ieee80211Transmission *>(object);
        auto& records = source == senderRadio ? dataTransmissions : ackTransmissions;
        records.push_back({transmission->getMode(), transmission->getStartTime(), transmission->getEndTime()});
    }

    virtual void activity() override
    {
        wait(SimTime(1, SIMTIME_MS));
        auto sender = check_and_cast<RetryModeHcf *>(getModuleByPath("^.sender.wlan[0].mac.hcf"));
        auto receiver = check_and_cast<RetryModeHcf *>(getModuleByPath("^.receiver.wlan[0].mac.hcf"));
        auto control = check_and_cast<RetryModeRateControl *>(sender->getSubmodule("rateControl"));
        senderRadio = getModuleByPath("^.sender.wlan[0].radio");
        receiverRadio = getModuleByPath("^.receiver.wlan[0].radio");
        senderRadio->subscribe(transmissionStartedSignal, this);
        receiverRadio->subscribe(transmissionStartedSignal, this);
        sender->injectOne();
        wait(SimTime(4, SIMTIME_MS));
        senderRadio->unsubscribe(transmissionStartedSignal, this);
        receiverRadio->unsubscribe(transmissionStartedSignal, this);

        ASSERT(receiver->suppressedAck && receiver->responseCount == 1);
        ASSERT(control->failures == 1 && control->successes == 1);
        ASSERT(sender->failures == 1 && sender->acknowledgments == 1 && sender->grants == 2);
        ASSERT(sender->events.size() == 2 && sender->responses.size() == 2);
        ASSERT(dataTransmissions.size() == 2 && ackTransmissions.size() == 1);
        ASSERT(!sender->events[0].retry && sender->events[1].retry);
        ASSERT(sender->events[0].sequence == sender->events[1].sequence);
        ASSERT(sender->events[0].fragment == sender->events[1].fragment);

        auto modes = Ieee80211ModeSet::getModeSet("a");
        auto initialMode = modes->getMode(bps(control->par("initialBitrate").doubleValue()));
        auto retryMode = modes->getMode(bps(control->par("retryBitrate").doubleValue()));
        simtime_t sifs = modes->getSifsTime();
        for (int i = 0; i < 2; i++) {
            auto expectedMode = i ? retryMode : initialMode;
            const auto& event = sender->events[i];
            const auto& response = sender->responses[i];
            const auto& actual = dataTransmissions[i];
            // Both selected modes are mandatory OFDM modes; no ACK rate override is configured.
            simtime_t dataAirtime = expectedMode->getDuration(B(230));
            simtime_t ackAirtime = expectedMode->getDuration(B(14));
            ASSERT(event.mode == expectedMode && actual.mode == expectedMode);
            ASSERT(response.mode == expectedMode && response.length == B(14));
            ASSERT(response.airtime == ackAirtime && response.ifs == sifs);
            ASSERT(event.airtime == dataAirtime && actual.end - actual.start == dataAirtime);
            ASSERT(event.start == actual.start);
            ASSERT(event.duration == sifs + ackAirtime);
            ASSERT(sender->planDurations[i] == dataAirtime + sifs + ackAirtime);
        }
        const auto& retry = dataTransmissions[1];
        const auto& ack = ackTransmissions[0];
        ASSERT(ack.mode == sender->responses[1].mode);
        ASSERT(ack.end - ack.start == sender->responses[1].airtime);
        ASSERT(ack.start == retry.end + sifs);
        ASSERT(ack.end - retry.start == sender->planDurations[1]);
        ASSERT(sender->burstDurations.size() == 2);
        ASSERT(sender->burstDurations[1] == sender->planDurations[1]);
        ASSERT(ack.end - retry.start <= SimTime(500, SIMTIME_US));
        std::cout << "Retry mode, predicted ACK, radio airtime, and TXOP duration verified.\n";
    }

  public:
    RetryModeTest() : cSimpleModule(65536) {}
};
Define_Module(RetryModeTest);

} // namespace ieee80211
} // namespace inet

%file: test.ned
import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mac.contract.IRateControl;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

simple RetryModeRateControl extends SimpleModule like IRateControl
{
    parameters:
        double initialBitrate @unit(bps);
        double retryBitrate @unit(bps);
        @class(::inet::ieee80211::RetryModeRateControl);
}
module RetryModeHcf extends Hcf
{
    parameters:
        @class(::inet::ieee80211::RetryModeHcf);
}
simple RetryModeTest extends SimpleModule
{
    parameters:
        @class(::inet::ieee80211::RetryModeTest);
}
network RetryModeNetwork
{
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        sender: WirelessHost;
        receiver: WirelessHost;
        test: RetryModeTest;
}

%inifile: omnetpp.ini
[General]
network = RetryModeNetwork
ned-path = .;../../../../src;../../lib
sim-time-limit = 6ms
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.radioMedium.propagation.typename = "ConstantTimePropagation"
*.radioMedium.propagation.propagationTime = 0s
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 24Mbps
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "RetryModeHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = false
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.originatorMacDataService.mpduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.rateSelection.dataFrameBitrate = -1bps
**.wlan[*].mac.hcf.rateSelection.responseAckFrameBitrate = -1bps
*.sender.wlan[0].mac.hcf.rateControl.typename = "RetryModeRateControl"
*.sender.wlan[0].mac.hcf.rateControl.initialBitrate = ${initial=6,24}Mbps
*.sender.wlan[0].mac.hcf.rateControl.retryBitrate = ${initial} == 6 ? 24Mbps : 6Mbps
**.wlan[*].mac.hcf.rtsPolicy.rtsThreshold = 4096B
**.wlan[*].mac.hcf.edca.edcaf[2].txopProcedure.txopLimit = 500us
*.sender.wlan[0].address = "02:00:00:00:00:01"
*.receiver.wlan[0].address = "02:00:00:00:00:02"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.sender.mobility.initialX = 0m
*.sender.mobility.initialY = 0m
*.receiver.mobility.initialX = 1m
*.receiver.mobility.initialY = 0m
**.wlan[*].radio.transmitter.power = 100mW
**.wlan[*].radio.receiver.sensitivity = -85dBm
**.wlan[*].radio.receiver.snirThreshold = 4dB

%contains: stdout
Retry mode, predicted ACK, radio airtime, and TXOP duration verified.
