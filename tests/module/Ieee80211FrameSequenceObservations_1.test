%description:
Check start and finish order through the production frame sequence handler.
Check empty first preparation and synchronous accepted DATA/ACK completion.
Require ordered callbacks and valid history in both result filters.

%file: Observations.cc
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceHandler.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceContext.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
namespace inet::ieee80211 {
class ObservationFrames : public InProgressFrames {
  public:
    void clearDroppedFrames() override {}
};
class ObservationValue : public cNumericResultFilter {
  public:
    int calls = 0;
    double value = -1;
    bool process(simtime_t&, double& value, cObject *) override { calls++; this->value = value; return false; }
};
class ObservationSequence : public IFrameSequence {
  public:
    int kind;
    int index = 0;
    ObservationSequence(int kind) : kind(kind) {}
    void startSequence(FrameSequenceContext *, int) override {}
    IFrameSequenceStep *prepareStep(FrameSequenceContext *) override {
        if (kind == 0 || index == 2)
            return nullptr;
        if (index == 1)
            return new ReceiveStep(SimTime(100, SIMTIME_US));
        auto header = makeShared<Ieee80211DataHeader>();
        return new TransmitStep(new Packet("DATA", header), SIMTIME_ZERO, true);
    }
    bool completeStep(FrameSequenceContext *) override { index++; return true; }
    std::string getHistory() const override { return "observation fixture"; }
};
class ObservationTest : public cSimpleModule, public IFrameSequenceHandler::ICallback {
  public:
    FrameSequenceHandler handler;
    int kind = 0;
    int starts = 0;
    int finishes = 0;
    int submissions = 0;
    int timers = 0;
    FrameSequenceDurationFilter durationFilter;
    FrameSequenceNumPacketsFilter countFilter;
    ObservationValue *durationValue = new ObservationValue();
    ObservationValue *countValue = new ObservationValue();
    void frameSequenceStarted() override {
        ASSERT(handler.isSequenceRunning());
        ASSERT(handler.getContext() != nullptr);
        ASSERT(handler.getContext()->getNumSteps() == 0);
        ASSERT(starts == finishes);
        starts++;
    }
    void transmitFrame(Packet *, simtime_t) override {
        ASSERT(starts == finishes + 1);
        submissions++;
        ASSERT(kind == 1 && submissions == 1);
        handler.transmissionComplete();
    }
    void frameSequenceFinished() override {
        ASSERT(starts == finishes + 1);
        auto context = handler.getContext();
        ASSERT(context != nullptr && handler.isSequenceRunning());
        ASSERT(context->getDuration() == SIMTIME_ZERO);
        ASSERT(context->getNumSteps() == (kind == 1 ? 2 : 0));
        if (kind == 1) {
            ASSERT(dynamic_cast<ReceiveStep *>(context->getLastStep()) != nullptr);
            ASSERT(context->getLastStep()->getCompletion() == IFrameSequenceStep::Completion::ACCEPTED);
        }
        else
            ASSERT(context->getLastStep() == nullptr);
        durationFilter.receiveSignal(nullptr, simTime(), const_cast<FrameSequenceContext *>(context), nullptr);
        countFilter.receiveSignal(nullptr, simTime(), const_cast<FrameSequenceContext *>(context), nullptr);
        ASSERT(durationValue->value == 0);
        ASSERT(countValue->value == (kind == 1 ? 2 : 0));
        finishes++;
    }
    void originatorProcessRtsProtectionFailed(Packet *) override { ASSERT(false); }
    void originatorProcessFailedFrame(Packet *) override { ASSERT(false); }
    void originatorProcessTransmittedFrame(Packet *) override {
        ASSERT(kind == 1);
        ASSERT(handler.getContext()->getLastStep()->getCompletion() == IFrameSequenceStep::Completion::ACCEPTED);
    }
    void originatorProcessReceivedFrame(Packet *, Packet *) override { ASSERT(kind == 1); }
    void scheduleStartRxTimer(simtime_t) override {
        ASSERT(kind == 1);
        timers++;
        handler.processResponse(new Packet("ACK", makeShared<Ieee80211AckFrame>()));
    }
  protected:
    void initialize() override {
        durationFilter.addDelegate(durationValue);
        countFilter.addDelegate(countValue);
        for (kind = 0; kind < 2; kind++) {
            ObservationFrames frames;
            submissions = timers = 0;
            auto context = new FrameSequenceContext(MacAddress::UNSPECIFIED_ADDRESS, nullptr, &frames, nullptr, nullptr, nullptr, nullptr);
            handler.startFrameSequence(new ObservationSequence(kind), context, this);
            ASSERT(submissions == kind && timers == kind);
            ASSERT(!handler.isSequenceRunning());
            ASSERT(handler.getContext() == nullptr);
        }
        ASSERT(starts == 2 && finishes == 2);
        ASSERT(durationValue->calls == 2 && countValue->calls == 2);
        std::cout << "Frame sequence observation assertions passed.\n";
    }
};
Define_Module(ObservationTest);
}
%file: test.ned
simple ObservationTest {
    parameters:
        @class(::inet::ieee80211::ObservationTest);
}
network ObservationNetwork {
    submodules:
        test: ObservationTest;
}
%inifile: omnetpp.ini
[General]
network = ObservationNetwork
ned-path = .;../../../../src;../../lib
seed-set = 0
%contains: stdout
Frame sequence observation assertions passed.
