%description:
Reject a discovery ceiling above the configured UDP limit.
%file: TestNetwork.ned
import inet.node.inet.StandardHost;
network TestNetwork
{
    submodules:
        host: StandardHost;
    connections allowunconnected:
}
%inifile: omnetpp.ini
[General]
network = TestNetwork
ned-path = .;../../../../src
simtime-resolution = ps
*.host.numApps = 1
*.host.app[0].typename = "DtlsApp"
*.host.app[0].server = true
*.host.app[0].dtls.localPort = 4433
*.host.app[0].dtls.pathMtuDiscoveryEnabled = true
*.host.app[0].dtls.pathMtuProbeCeiling = 1201B
%exitcode: 1
%postrun-command: grep '<!>' test.out test.err > configuration-error.out || true
%contains: configuration-error.out
Invalid DTLS path MTU base, ceiling or timer profile
