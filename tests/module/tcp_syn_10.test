%description:
Test connection setup: simultaneous active open by A and B, with SACK.
  A,B: INIT --> SYN_SENT --> SYN_RCVD --> ESTABLISHED
Each side reads the options of the crossing SYN, so both SYN-ACKs carry the
MSS and SACK-permitted options, and SACK is on. Each SYN-ACK repeats the SYN
that the other side already has, so each side reports that one sequence
number by a D-SACK (RFC 2883), with an immediate ACK, as Linux
tcp_data_queue() does.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

#cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

####cmdenv-log-format=""
cmdenv-log-prefix="[%c]: "
#*.tcptester.cmdenv-ev-output=true
#**.cmdenv-ev-output=false

*.cli_app.active=true
*.srv_app.active=true

*.cli_app.tOpen=0s
*.srv_app.tOpen=0s

*.cli_app.tSend=1s
*.cli_app.sendBytes=100B
*.srv_app.tSend=1s
*.srv_app.sendBytes=100B

*.*_tcp.sackSupport = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "^\[testing\]" test.out > test_1.out || true
%contains: test_1.out
[testing]: cli_tcp: INIT --> SYN_SENT  (on OPEN_ACTIVE)
[testing]: srv_tcp: INIT --> SYN_SENT  (on OPEN_ACTIVE)
[testing]: [0.001 A001] A.1000 > B.2000: S 0:0(0) win 16384   Option(s): MaxSegSize NOP NOP SackPermitted
[testing]: [0.001 B001] A.1000 < B.2000: S 0:0(0) win 16384   Option(s): MaxSegSize NOP NOP SackPermitted
[testing]: srv_tcp: SYN_SENT --> SYN_RCVD  (on RCV_SYN)
[testing]: cli_tcp: SYN_SENT --> SYN_RCVD  (on RCV_SYN)
[testing]: [0.003 B002] A.1000 < B.2000: A S 0:0(0) ack 1 win 16384   Option(s): MaxSegSize NOP NOP SackPermitted
[testing]: [0.003 A002] A.1000 > B.2000: A S 0:0(0) ack 1 win 16384   Option(s): MaxSegSize NOP NOP SackPermitted
[testing]: cli_tcp: SYN_RCVD --> ESTABLISHED  (on RCV_ACK)
[testing]: srv_tcp: SYN_RCVD --> ESTABLISHED  (on RCV_ACK)
[testing]: [0.005 A003] A.1000 > B.2000: A ack 1 win 16384   Option(s): NOP NOP SACK[0,1)
[testing]: [0.005 B003] A.1000 < B.2000: A ack 1 win 16384   Option(s): NOP NOP SACK[0,1)
[testing]: [1.001 A004] A.1000 > B.2000: A 1:101(100) ack 1 win 16384
[testing]: [1.001 B004] A.1000 < B.2000: A 1:101(100) ack 1 win 16384
[testing]: [1.203 B005] A.1000 < B.2000: A ack 101 win 16384
[testing]: [1.203 A005] A.1000 > B.2000: A ack 101 win 16384
[testing]: [1.204] tcpdump finished, A:5 B:5 segments
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
