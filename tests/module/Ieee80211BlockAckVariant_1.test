%description:
Check profile validation through production HCF initialization.
Accept the default, explicit Basic, and explicit Compressed profiles.
Reject unknown values with support enabled or disabled.
Reject delayed policy for Compressed before any ADDBA transmission.

%testprog: python3 check-profile.py

%file: profile.ini
[General]
network = inet.showcases.wireless.blockack.BlockAckShowcase
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.isBlockAckSupported = true

%file: check-profile.py
from pathlib import Path
import subprocess

root = Path.cwd().parents[3]
cases = [
    (None, True, (), None),
    ("basic", True, (), None),
    ("invalid", True, (), 'Unknown blockAckVariant "invalid": expected "basic" or "compressed"'),
    ("invalid", False, (), 'Unknown blockAckVariant "invalid": expected "basic" or "compressed"'),
    ("compressed", True, (), None),
    ("compressed", False, (), None),
]
for policies in [("originator",), ("recipient",), ("originator", "recipient")]:
    cases.append(("compressed", True, policies,
                  "Compressed Block Ack does not support delayedAckPolicySupported"))
    cases.append(("basic", True, policies, None))
for variant, supported, policies, diagnostic in cases:
    command = [str(root / "bin/inet"), "--debug", "-u", "Cmdenv", "-f", str(Path.cwd() / "profile.ini"), "-c", "General", "-r", "0",
               "--sim-time-limit=0s", "--record-vector-results=false", "--record-scalar-results=false",
               f"--result-dir={Path.cwd() / 'results'}",
               f"--**.wlan[*].mac.hcf.isBlockAckSupported={'true' if supported else 'false'}"]
    if variant is not None:
        command.append(f'--**.wlan[*].mac.hcf.blockAckVariant="{variant}"')
    for policy in policies:
        command.append(f'--**.wlan[*].mac.hcf.{policy}BlockAckAgreementPolicy.delayedAckPolicySupported=true')
    result = subprocess.run(command, cwd=root / "showcases/wireless/blockack", text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    print(result.stdout)
    if diagnostic is None:
        assert result.returncode == 0, (variant, supported, result.stdout)
    else:
        assert result.returncode != 0 and diagnostic in result.stdout, (variant, supported, result.stdout)
print("Block Ack profile initialization checks passed.")

%contains: stdout
Block Ack profile initialization checks passed.
