%description:
Verify lifetime expiry through production EDCA arbitration.
Scenario 0 expires voice DATA before a simultaneous video grant.
Scenario 1 omits the voice request.
Both cases must transmit video DATA without an internal collision.
Scenario 2 retains valid voice DATA and must preserve the genuine collision.
All runs use seed 0, zero contention windows, and native AIFS values.

%extraargs: -r 0..2

%file: LifetimeArbitration.cc
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/Rx.h"

using namespace inet;
using namespace inet::ieee80211;

class LifetimeArbitrationHcf : public Hcf {
  protected:
    bool transmitFrame(Packet *packet, simtime_t ifs) override {
        bool accepted = Hcf::transmitFrame(packet, ifs);
        if (accepted && packet->peekAtFront<Ieee80211MacHeader>()->getType() == ST_DATA_WITH_QOS) {
            auto tid = packet->peekAtFront<Ieee80211DataHeader>()->getTid();
            if (tid == 6)
                acceptedVoice++;
            else if (tid == 5)
                acceptedVideo++;
        }
        return accepted;
    }
  public:
    int acceptedVoice = 0;
    int acceptedVideo = 0;
};
Define_Module(LifetimeArbitrationHcf);

class LifetimeArbitrationTest : public cSimpleModule, public cListener {
    int lifetimeDrops = 0;
    int lowerRetryDrops = 0;
    int collisions = 0;
    int lowerTid = 5;
  protected:
    void receiveSignal(cComponent *, simsignal_t, cObject *object, cObject *details) override {
        auto reason = check_and_cast<PacketDropDetails *>(details)->getReason();
        if (reason == LIFETIME_EXPIRED)
            lifetimeDrops++;
        if (reason == RETRY_LIMIT_REACHED && check_and_cast<Packet *>(object)->peekAtFront<Ieee80211DataHeader>()->getTid() == lowerTid)
            lowerRetryDrops++;
    }
    void receiveSignal(cComponent *, simsignal_t, unsigned long count, cObject *) override {
        collisions += count;
    }
    void accept(LifetimeArbitrationHcf *hcf, int tid) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setTid(tid);
        header->setSequenceNumber(SequenceNumberCyclic(0));
        header->setReceiverAddress(MacAddress("02:00:00:00:00:02"));
        header->setTransmitterAddress(MacAddress("02:00:00:00:00:01"));
        header->setAddress3(header->getReceiverAddress());
        auto packet = new Packet(tid == 6 ? "expired-voice" : "valid-video", header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        hcf->processUpperFrame(packet, header);
    }
    void activity() override {
        auto mac = getParentModule()->getSubmodule("sender")->getSubmodule("wlan", 0)->getSubmodule("mac");
        auto hcf = check_and_cast<LifetimeArbitrationHcf *>(mac->getSubmodule("hcf"));
        auto edca = check_and_cast<Edca *>(hcf->getSubmodule("edca"));
        auto rx = check_and_cast<Rx *>(mac->getSubmodule("rx"));
        hcf->subscribe(packetDroppedSignal, this);
        hcf->subscribe(Hcf::edcaCollisionDetectedSignal, this);
        int scenario = par("scenario");
        bool includeHigh = scenario != 1;
        bool expiredHigh = scenario == 0;
        rx->setContentionBlocked(true);
        if (includeHigh)
            accept(hcf, 6);
        wait(SimTime(400, SIMTIME_MS));
        accept(hcf, lowerTid);
        wait(SimTime(300, SIMTIME_MS));
        ASSERT(edca->getEdcaf(AC_VO)->getPendingQueue()->getNumPackets() == (scenario == 2 ? 1 : 0));
        ASSERT(edca->getEdcaf(AC_VI)->getPendingQueue()->getNumPackets() == 1);
        ASSERT(lifetimeDrops == (expiredHigh ? 1 : 0));
        rx->setContentionBlocked(false);
        wait(SimTime(50, SIMTIME_US));
        bool genuineCollision = scenario == 2;
        ASSERT(hcf->acceptedVoice == (genuineCollision ? 1 : 0));
        ASSERT(hcf->acceptedVideo == (genuineCollision ? 0 : 1));
        ASSERT(lowerRetryDrops == (genuineCollision ? 1 : 0));
        ASSERT(collisions == (genuineCollision ? 1 : 0));
        ASSERT(!edca->getEdcaf(AC_VO)->isOwning() || genuineCollision);
        std::cout << "Lifetime arbitration verified for scenario " << scenario << ".\n";
        hcf->unsubscribe(packetDroppedSignal, this);
        hcf->unsubscribe(Hcf::edcaCollisionDetectedSignal, this);
        endSimulation();
    }
  public:
    LifetimeArbitrationTest() : cSimpleModule(65536) {}
};
Define_Module(LifetimeArbitrationTest);

%file: test.ned
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;

module LifetimeArbitrationHcf extends Hcf {
    parameters:
        @class(::LifetimeArbitrationHcf);
}
simple LifetimeArbitrationTest {
    parameters:
        int scenario;
        @class(::LifetimeArbitrationTest);
}
network LifetimeArbitrationNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        sender: WirelessHost;
        receiver: WirelessHost;
        test: LifetimeArbitrationTest;
}

%inifile: omnetpp.ini
[General]
network = LifetimeArbitrationNetwork
sim-time-limit = 1s
seed-set = 0
cmdenv-express-mode = true
ned-path = .;../../../../src;../../lib
record-scalar-results = true
record-vector-results = false
*.test.scenario = ${scenario=0,1,2}
*.sender.wlan[0].mac.hcf.edca.edcaf[3].msduLifetime = ${scenario} == 2 ? 1s : 0.512s
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 6Mbps
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "LifetimeArbitrationHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = false
**.wlan[*].mac.hcf.rateSelection.dataFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.edca.edcaf[*].cwMin = 0
**.wlan[*].mac.hcf.edca.edcaf[*].cwMax = 0
**.wlan[*].mac.hcf.edca.edcaf[*].recoveryProcedure.shortRetryLimit = 1
*.sender.wlan[0].address = "02:00:00:00:00:01"
*.receiver.wlan[0].address = "02:00:00:00:00:02"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.sender.mobility.initialX = 0m
*.sender.mobility.initialY = 0m
*.receiver.mobility.initialX = 1m
*.receiver.mobility.initialY = 0m


%contains: stdout
Lifetime arbitration verified for scenario 2.
