%description:
Tests the out-of-band byte of Linux (urgentOutOfBand, which LinuxTcp sets). The
scenario is that of tcp_urgent_1, between two LinuxTcp hosts: 1000 bytes, 3000
bytes of urgent data, and 1000 bytes. The urgent pointer is 4001, so the last
urgent byte, sequence number 4000, leaves the stream, as Linux without
SO_OOBINLINE: the notice counts the 2999 bytes before it, the segment that holds
it gives it to the application alone (TCP_I_URGENT_DATA of one byte with
TcpOutOfBandInd), the data before it comes as ordinary data (1000, 1448, 1448
and 103 bytes), and the 1000 bytes after it follow. The stream has 4999 bytes.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=true

*.tcptester.script=""

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1.0 1000; 1.1 3000 urgent; 1.5 1000"
*.*_tcp.typename = "LinuxTcp"
*.srv_app.logIndications = true
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

sim-time-limit = 3s

%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
[testing]: srv_app: TCP_I_URGENT, 2999 urgent bytes to read
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
[testing]: srv_app: TCP_I_URGENT_DATA, 1 bytes, out-of-band
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
[testing]: srv_app: TCP_I_DATA, 103 bytes
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Urgent data: the out-of-band byte at 4000 leaves the stream
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
TCP_I_DATA, 1 bytes
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
