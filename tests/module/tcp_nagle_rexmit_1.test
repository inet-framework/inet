%description:
Tests that Nagle does not hold a retransmission. The client sends 2500 bytes
at t=1 with TCP_NODELAY and an initial window of three segments, and turns
Nagle on again at t=1.5. The tester removes the second segment and the
partial segment at the end (A004, A005). After the retransmission timeout,
the go-back sends 1025:2049 again, and at its ACK the partial segment
2049:2501 at once (A007): it is a retransmission, below snd_max, and Nagle
holds only new data (RFC 9293 section 3.7.4 tests SND.NXT > SND.UNA; Linux
never sends a retransmission through Nagle). Before, Nagle held it until the
next timeout.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib
sim-time-limit = 20s

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 2500"
*.cli_app.noDelayScript="0 1; 1.5 0"
*.cli_tcp.initialWindow = "rfc3390"
*.tcptester.script="a4 delete; a5 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1025(1024) ack 501 win 16384 
[1.001 A004] A.1000 > B.2000: A 1025:2049(1024) ack 501 win 16384 # deleting
[1.001 A005] A.1000 > B.2000: A 2049:2501(452) ack 501 win 16384 # deleting
[1.203 B002] A.1000 < B.2000: A ack 1025 win 16384 
[2.205 A006] A.1000 > B.2000: A 1025:2049(1024) ack 501 win 16384 
[2.407 B003] A.1000 < B.2000: A ack 2049 win 16384 
[2.409 A007] A.1000 > B.2000: A 2049:2501(452) ack 501 win 16384 
[2.611 B004] A.1000 < B.2000: A ack 2501 win 16384 
[20.000] tcpdump finished, A:7 B:4 segments
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
