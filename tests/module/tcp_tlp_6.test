%description:
Tests that the congestion response of a tail loss probe (RFC 8985 section
7.4.2, tlpEnabled=true) is that of a fast recovery of the flavour, here
CUBIC. The tester deletes the last of four segments, and the probe at
t=1.212 repairs it. At t=1.5 the sender sends six new segments with cwnd
4000. The first ACK above the probe comes at t=1.504, and CUBIC sets
ssthresh to 0.7 of eight segments, five segments.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="a6 delete"

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 2000;1.5 3000"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpCubic"
*.*_tcp.tlpEnabled = true
*.*_tcp.increasedIWEnabled = true



%contains: stdout
Loss at cwnd=8 segments, in flight=8 segments

%contains: stdout
TLP: the probe repaired a lost tail, cwnd reduced to ssthresh=2500
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
