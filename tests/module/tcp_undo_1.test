%description:
Tests the undo of a needless reduction (RFC 2883 D-SACK, Linux
tcp_undo_cwnd_reduction(), lossUndoEnabled=true). The tester delays the
first segment of a burst of four by 0.3 ms, so three SACKs arrive first and
the sender retransmits it in a fast recovery, with cwnd 2000. The original
then arrives, and the retransmission comes as a duplicate: the receiver
reports it by a D-SACK on a duplicate ACK at t=2.007. The sender counts that
D-SACK, all retransmissions of the episode are now proven needless, and at
the next ACK of new data it restores cwnd 2000 and ssthresh.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="A4 delay 0.0003"  # the first segment of the burst arrives 0.3 ms late

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 500;2 2500;3 500"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.lossUndoEnabled = true
*.*_tcp.increasedIWEnabled = true



%# the D-SACK of the needless retransmission arrives on a duplicate ACK...
%contains: stdout
[2.007 B007] A.1000 < B.2000: A ack 2501 win 5000   Option(s): NOP NOP SACK[501,1001)

%# ...and the next ACK of new data undoes the reduction
%contains: stdout
Undoing spurious cwnd reduction (D-SACK): cwnd=2000, ssthresh=4294967295

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
