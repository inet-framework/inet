%description:
Tests the truesize of a large segment from the tun device of packetdrill, as
Linux (tun_alloc_skb(), alloc_skb_with_frags()). A 20000-byte segment, 20040
bytes with its headers, costs a linear part of one page (4096 bytes), one page
of order 2 for the rest (16384 bytes) and struct sk_buff (232 bytes): 20712
bytes, so the payload ratio is 247/256. The server locks a buffer of 100000
bytes and does not read. A locked buffer offers its free space at that ratio:
after three segments, (100000 - 3 * 20712) * 247/256 = 36532 bytes, and the
server takes 96549 bytes before it offers a zero window. Before the repair,
the segment cost one page of order 3 (33000 bytes), and the server took
60585 bytes.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 200000"
*.srv_app.autoRead=false
*.srv_app.rcvBufScript="0.5 100000"  # SO_RCVBUF: lock the buffer
sim-time-limit = 3s
*.*_tcp.mss = 20000
*.*_tcp.delayedAcksEnabled = false
*.srv_tcp.advertisedWindow = 20000
*.srv_tcp.receiveBufferSize = 100000B
*.srv_tcp.windowAutoTuning = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%# the offer after three segments...
%contains: postrun-command(1).out
[1.007 B004] A.1000 < B.2000: A ack 60001 win 36532 
%# ...and the zero window after 96549 bytes
%contains: postrun-command(1).out
[2.015 B006] A.1000 < B.2000: A ack 96550 win 0 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------

