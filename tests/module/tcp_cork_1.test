%description:
Tests TcpSocket::setCork(), the socket option TCP_CORK of Linux. The client
corks at t=0.5 and writes 1500 and 300 bytes. The full-sized segment goes; the
rest (800 bytes) waits, also after the ACK of t=1.203 leaves nothing in flight.
The uncork at t=1.5 sends it, with PSH, because the writes came without MSG_MORE
(Linux tcp_mark_push()).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.corkScript="0.5 1; 1.5 0"
*.cli_app.sendScript="1.0 1500; 1.1 300"
*.*_tcp.mss = 1000

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 1001 win 16384 
[1.501 A004] A.1000 > B.2000: A P 1001:1801(800) ack 501 win 16384 
[1.703 B003] A.1000 < B.2000: A ack 1801 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Holding the partial segment (TCP_CORK or MSG_MORE)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
