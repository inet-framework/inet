%description:
Classic RFC 3168 ECN with a delayed ACK: the tester CE-marks the first data
segment of the client, and the server delays its ACK. The second segment,
without CE, makes the server send the ACK of both. The CE mark started the
echo state when it arrived (RFC 3168 section 6.1.3), so this ACK has ECE,
and the client halves cwnd.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false
*.tcptester.script="a3 ce"

*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.active=true
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.tClose=-1s
*.cli_app.sendScript="0.5 5000"

*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.active=false
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.tClose=-1s
*.srv_app.sendScript=""

*.*_tcp.sackSupport = false
*.*_tcp.windowScalingSupport = false
*.*_tcp.timestampSupport = false
*.*_tcp.mss = 1000
*.*_tcp.delayedAcksEnabled = true
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.ecnWillingness = true
*.*_tcp.advertisedWindow = 20000

%#--------------------------------------------------------------------------------------------------------------
%# The sender reacted to the ECN-Echo: cwnd halved and ssthresh pulled down with it.
%# the delayed ACK of the CE segment and the next one has ECE...
%contains: stdout
[0.503 B002] A.1000 < B.2000: A E ack 2001 win 20000
%# ...and the client reacts
%contains: stdout
cwnd = cwnd / 2: received ECN-Echo ACK... new cwnd = 2000
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
