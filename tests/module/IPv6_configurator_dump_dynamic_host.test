%description:
Tests that the address dump of Ipv6NetworkConfigurator shows a host interface
that assignAddressesToHosts = false leaves to dynamic configuration as
"addr=dynamic", and does not print the address that the configurator computed
for it but does not assign.

One host and one router share one Ethernet link:

    h1 -- r1

h1 is given the explicit address 2001:db8:1:1::99, which the configurator does
not assign in this mode; h1 autoconfigures its EUI-64 address instead. r1 keeps
its static address.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

network ConfiguratorDumpDynamicHostTest
{
    types:
        channel ethernetline extends DatarateChannel
        {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        h1: StandardHost6;
        r1: Router6;
        configurator: Ipv6NetworkConfigurator;
    connections:
        h1.ethg++ <--> ethernetline <--> r1.ethg++;
}

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini

[General]
record-vector-results = false
network = ConfiguratorDumpDynamicHostTest
sim-time-limit = 1s
cmdenv-express-mode = false
cmdenv-log-prefix = "%C: "
ned-path = .;../../../../src

**.ipv6.configurator.networkConfiguratorModule = "configurator"
*.configurator.assignAddressesToHosts = false
*.configurator.dumpAddresses = true
*.configurator.config = xml("<config>\
    <interface hosts='h1' address='2001:db8:1:1::99'/>\
    <interface hosts='r1' address='2001:db8:1:1::1'/>\
    </config>")

**.eth[*].queue.typename = "EthernetQosQueue"
**.eth[*].queue.dataQueue.typename = "DropTailQueue"
**.eth[*].queue.dataQueue.packetCapacity = 100

%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%# the host interface is shown as left to dynamic configuration
%contains: stdout
ConfiguratorDumpDynamicHostTest.h1:
(Ipv6NetworkConfigurator)ConfiguratorDumpDynamicHostTest.configurator:   eth0 addr=dynamic prefix=2001:db8:1:1::/64
%#--------------------------------------------------------------------------------------------------------------
%# the address the configurator does not assign is not printed
%not-contains: stdout
addr=2001:db8:1:1::99/64
%#--------------------------------------------------------------------------------------------------------------
%# the router keeps its static address
%contains: stdout
addr=2001:db8:1:1::1/64
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
