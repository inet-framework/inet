%description:
Tests alignOptions=false: the options go out without NOP alignment. Both sides
support window scaling, SACK and timestamps. The SYN and the SYN-ACK carry MSS,
window scale, SACK-Permitted and the timestamp with no NOP between them (19
bytes, and one End of Option List byte pads the area), and the ACKs carry the
timestamp alone. With alignOptions=true (the default), NOPs align the window
scale option and the timestamp option.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

*.cli_app.sendScript="1.0 100"
*.*_tcp.sackSupport = true
*.*_tcp.windowScalingSupport = true
*.*_tcp.alignOptions = false
*.*_tcp.timestampSupport = true

include ../../lib/defaults.ini

%contains: stdout
[0.001 A001] A.1000 > B.2000: S 0:0(0) win 16384   Option(s): MaxSegSize WinScale SackPermitted TS(0,0)
[0.003 B001] A.1000 < B.2000: A S 500:500(0) ack 1 win 16384   Option(s): MaxSegSize WinScale SackPermitted TS(2,0)
[0.005 A002] A.1000 > B.2000: A ack 501 win 16384   Option(s): TS(4,0)

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
