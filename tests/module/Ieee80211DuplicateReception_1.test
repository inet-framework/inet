%description:
Three real radio-only non-HT duplicate ACK receptions: quiet, secondary20 noise,
and primary20 noise. An 80MHz transmission uses the legacy20MHz per-copy mode.
The production receiver decodes primary20 at one quarter of full received power,
without renormalization. Secondary noise preserves decoded power/SNIR/PER/outcome;
primary noise destroys reception. An ordinary secondary20 observer sees energy
but cannot decode the primary copy. Cached results and decisions retain the
original reception after scoped primary-copy computation. This proves response
PHY behavior, not MAC channel access, retries, or mesh negotiation.

%file: test.cc
#include <array>
#include <cmath>
#include <iostream>
#include <memory>

#include "inet/common/InitStages.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/Simsignals.h"
#include "inet/common/checksum/Checksum.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/physicallayer/wireless/common/analogmodel/dimensional/DimensionalReceptionAnalogModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadioMedium.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/SignalTag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Radio.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/noise/NoiseSource.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

namespace Ieee80211DuplicateReception_1 {

class PulsedNoise : public NoiseSource
{
  public:
    void pulse()
    {
        Enter_Method_Silent();
        ASSERT(!transmissionTimer->isScheduled());
        cancelEvent(sleepTimer);
        startTransmission();
    }
};
Define_Module(PulsedNoise);

class Probe : public cSimpleModule, public cListener
{
    struct Sample {
        double power = 0;
        double snir = 0;
        double per = 0;
        bool success = false;
        double originalSnir = 0;
        double originalNoise = 0;
    };
    std::array<Sample, 3> samples;
    IRadioMedium *medium = nullptr;
    Ieee80211Radio *sender = nullptr;
    Ieee80211Radio *receiver = nullptr;
    Ieee80211Radio *observer = nullptr;
    opp_component_ptr<cModule> mediumModule;
    opp_component_ptr<cModule> observerModule;
    const ITransmission *active = nullptr;
    cMessage *begin = nullptr;
    cMessage *transmit = nullptr;
    cMessage *inspect = nullptr;
    cMessage *check = nullptr;
    int round = 0;
    int delivered = 0;
    int corrupted = 0;
    int secondaryDelivered = 0;
    int secondaryAttempts = 0;
    int secondaryArrivals = 0;
    bool sampled = false;

    static bool equal(double a, double b) { return std::abs(a - b) <= 1e-10 * std::max(std::abs(a), std::abs(b)); }

    void checkTags(const Packet *packet) const
    {
        const auto& vector = packet->getTag<Ieee80211ModeInd>()->getTxVector();
        ASSERT(vector.format == Ieee80211TxVector::Format::NON_HT_DUPLICATE);
        ASSERT(vector.bandwidth == MHz(80));
        ASSERT(vector.mode->getDataMode()->getBandwidth() == MHz(20));
        const auto *channel = packet->getTag<Ieee80211ChannelInd>()->getChannel();
        ASSERT(channel->getChannelNumber() == 0 && channel->getPrimaryChannel() == 36);
        ASSERT(channel->getAllocationWidth() == MHz(80) && channel->getCenterChannel(MHz(80)) == 42);
    }

  protected:
    int numInitStages() const override { return NUM_INIT_STAGES; }

    void initialize(int stage) override
    {
        if (stage != INITSTAGE_LAST)
            return;
        mediumModule = getModuleByPath("^.radioMedium");
        medium = check_and_cast<IRadioMedium *>(mediumModule.get());
        sender = check_and_cast<Ieee80211Radio *>(getModuleByPath("^.a.radio"));
        receiver = check_and_cast<Ieee80211Radio *>(getModuleByPath("^.b.radio"));
        observerModule = getModuleByPath("^.c.radio");
        observer = check_and_cast<Ieee80211Radio *>(observerModule.get());
        ASSERT(medium->supportsInterferenceObservation());
        ASSERT(sender->hasContiguousAllocation() && receiver->hasContiguousAllocation());
        ASSERT(!observer->hasContiguousAllocation());
        mediumModule->subscribe(IRadioMedium::signalDepartureStartedSignal, this);
        mediumModule->subscribe(IRadioMedium::signalArrivalStartedSignal, this);
        observerModule->subscribe(receptionStartedSignal, this);
        begin = new cMessage("begin round");
        transmit = new cMessage("send duplicate ACK");
        inspect = new cMessage("inspect cached result before receivePacket");
        check = new cMessage("check completed round");
        scheduleAt(SimTime(1, SIMTIME_MS), begin);
    }

    void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *) override
    {
        Enter_Method_Silent();
        if (signal == IRadioMedium::signalDepartureStartedSignal) {
            auto transmission = check_and_cast<const ITransmission *>(object);
            if (transmission->getTransmitterRadioId() != sender->getId())
                return;
            active = transmission;
            auto duplicate = check_and_cast<const Ieee80211Transmission *>(active);
            ASSERT(duplicate->getTxVector().format == Ieee80211TxVector::Format::NON_HT_DUPLICATE);
            auto arrival = medium->getArrival(receiver, active);
            scheduleAt(arrival->getStartTime() + (arrival->getEndTime() - arrival->getStartTime()) / 2, inspect);
        }
        else {
            auto reception = check_and_cast<const IReception *>(object);
            if (reception->getReceiverRadio() == observer && active && reception->getTransmission() == active) {
                if (signal == IRadioMedium::signalArrivalStartedSignal)
                    secondaryArrivals++;
                else if (signal == receptionStartedSignal)
                    secondaryAttempts++;
            }
        }
    }

    void handleMessage(cMessage *message) override
    {
        if (message == begin) {
            ASSERT(round < 3);
            sampled = false;
            if (round != 0)
                check_and_cast<PulsedNoise *>(getModuleByPath(round == 1 ? "^.secondary" : "^.primary"))->pulse();
            scheduleAfter(SimTime(100, SIMTIME_US), transmit);
        }
        else if (message == transmit) {
            auto packet = new Packet("raw duplicate ACK");
            auto ack = makeShared<Ieee80211AckFrame>();
            ack->setReceiverAddress(MacAddress("02:00:00:00:00:02"));
            packet->insertAtBack(ack);
            auto bytes = packet->peekAllAsBytes()->getBytes();
            auto trailer = makeShared<Ieee80211MacTrailer>();
            trailer->setFcsMode(FCS_COMPUTED);
            trailer->setFcs(ethernetFcs(bytes.data(), bytes.size()));
            packet->insertAtBack(trailer);
            packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
            auto base = Ieee80211ModeSet::getModeSet("a")->getMode(Mbps(6), MHz(20), 1);
            Ieee80211TxVector vector(base);
            vector.format = Ieee80211TxVector::Format::NON_HT_DUPLICATE;
            vector.bandwidth = MHz(80);
            packet->addTag<Ieee80211ModeReq>()->setTxVector(vector);
            send(packet, "out");
            scheduleAfter(SimTime(2, SIMTIME_MS), check);
        }
        else if (message == inspect) {
            // getReceptionResult returns only after the scoped decoded reception
            // has gone away. Never retain/dereference this result after the
            // real radio's receivePacket consumes and deletes its cached packet.
            auto listening = medium->getListening(receiver, active);
            auto original = medium->getReception(receiver, active);
            auto analog = check_and_cast<const DimensionalReceptionAnalogModel *>(original->getAnalogModel());
            auto fullPower = analog->computeMinPower(original->getStartTime(), original->getEndTime()).get();
            auto powerFunction = analog->getPower();
            ASSERT(analog->getBandwidth() == MHz(80));
            auto noise = medium->getNoise(receiver, active);
            auto snir = medium->getSNIR(receiver, active);
            ASSERT(snir->getReception() == original && snir->getNoise() == noise);
            std::array<double, 3> fullSnir = { snir->getMin(), snir->getMax(), snir->getMean() };
            auto fullNoise = noise->computeMaxPower(original->getStartTime(), original->getEndTime());
            const IReceptionResult *result;
            {
                // This query creates the cached Packet without Enter_Method.
                // Match receivePacket's medium context, which later deletes it.
                cContextSwitcher context(mediumModule.get());
                result = medium->getReceptionResult(receiver, listening, active);
            }
            ASSERT(result->getReception() == original);
            bool success = true;
            for (auto decision : *result->getDecisions()) {
                ASSERT(decision->getReception() == original);
                success &= decision->isReceptionSuccessful();
            }
            ASSERT(result == medium->getReceptionResult(receiver, listening, active));
            ASSERT(medium->getReception(receiver, active) == original);
            ASSERT(medium->getNoise(receiver, active) == noise && medium->getSNIR(receiver, active) == snir);
            ASSERT(analog->getBandwidth() == MHz(80) && analog->getPower() == powerFunction);
            ASSERT(analog->computeMinPower(original->getStartTime(), original->getEndTime()).get() == fullPower);
            ASSERT(noise->computeMaxPower(original->getStartTime(), original->getEndTime()) == fullNoise);
            ASSERT((fullSnir == std::array<double, 3>{ snir->getMin(), snir->getMax(), snir->getMean() }));
            auto packet = result->getPacket();
            checkTags(packet);
            samples[round] = { packet->getTag<SignalPowerInd>()->getPower().get(),
                packet->getTag<SnirInd>()->getMinimumSnir(), packet->getTag<ErrorRateInd>()->getPacketErrorRate(), success,
                fullSnir[0], fullNoise.get() };
            std::cout << "duplicate sample " << round << " fullPower=" << fullPower << " primaryPower=" << samples[round].power
                << " snir=" << samples[round].snir << " per=" << samples[round].per << " success=" << samples[round].success
                << " originalSnir=" << samples[round].originalSnir << " originalNoise=" << samples[round].originalNoise << std::endl;
            ASSERT(equal(samples[round].power, fullPower / 4));
            // This ordinary20MHz receiver is centered on secondary channel40.
            // Its actual full80MHz arrival supplies energy, but no decodable copy.
            auto secondaryReception = medium->getReception(observer, active);
            auto secondaryAnalog = check_and_cast<const DimensionalReceptionAnalogModel *>(secondaryReception->getAnalogModel());
            ASSERT(secondaryAnalog->getBandwidth() == MHz(80));
            auto position = observer->getAntenna()->getMobility()->getCurrentPosition();
            std::unique_ptr<const IListening> secondaryListening(observer->getReceiver()->createListening(
                observer, simTime(), simTime() + SimTime::fromRaw(1), position, position));
            ASSERT(!observer->getReceiver()->computeIsReceptionPossible(secondaryListening.get(), active));
            std::unique_ptr<const IListeningDecision> energy(medium->listenOnMedium(observer, secondaryListening.get()));
            ASSERT(energy->isListeningPossible());
            sampled = true;
        }
        else if (message == check) {
            ASSERT(sampled && secondaryArrivals == round + 1 && secondaryAttempts == 0 && secondaryDelivered == 0);
            const auto& sample = samples[round];
            if (round < 2) {
                ASSERT(sample.success && sample.per == 0 && delivered == round + 1);
                if (round == 1) {
                    ASSERT(sample.power == samples[0].power);
                    ASSERT(sample.snir == samples[0].snir && sample.per == samples[0].per);
                    ASSERT(sample.originalSnir < samples[0].originalSnir && sample.originalNoise > samples[0].originalNoise);
                }
            }
            else {
                ASSERT(!sample.success && sample.snir < samples[0].snir && sample.per == 1 && delivered == 2 && corrupted == 1);
                ASSERT(sample.power == samples[0].power);
                ASSERT(sample.originalNoise > samples[0].originalNoise);
            }
            std::cout << "duplicate round " << round << ": PASS power=" << sample.power
                << " snir=" << sample.snir << " per=" << sample.per << " success=" << sample.success << std::endl;
            active = nullptr;
            round++;
            if (round < 3)
                scheduleAfter(SimTime(1, SIMTIME_MS), begin);
        }
        else {
            auto packet = check_and_cast<Packet *>(message);
            if (packet->getArrivalGate() == gate("in")) {
                checkTags(packet);
                // Radios pass unsuccessful receptions upward with a bit-error
                // indication; a MAC would discard them. No MAC runs here.
                ASSERT(packet->hasBitError() == (round == 2));
                if (packet->hasBitError())
                    corrupted++;
                else {
                    ASSERT(packet->peekAtFront<Ieee80211AckFrame>()->getType() == ST_ACK);
                    auto trailer = packet->peekAtBack<Ieee80211MacTrailer>(B(4));
                    auto bytes = packet->peekAt<BytesChunk>(packet->getFrontOffset(), packet->getDataLength() - B(4))->getBytes();
                    ASSERT(trailer->getFcsMode() == FCS_COMPUTED && trailer->getFcs() == ethernetFcs(bytes.data(), bytes.size()));
                    delivered++;
                }
            }
            else
                secondaryDelivered++;
            delete packet;
        }
    }

    void finish() override
    {
        ASSERT(round == 3 && delivered == 2 && corrupted == 1 && secondaryArrivals == 3 && secondaryAttempts == 0 && secondaryDelivered == 0);
        std::cout << "duplicate reception: PASS" << std::endl;
    }

  public:
    using cListener::finish;
    ~Probe() override
    {
        if (mediumModule) {
            mediumModule->unsubscribe(IRadioMedium::signalDepartureStartedSignal, this);
            mediumModule->unsubscribe(IRadioMedium::signalArrivalStartedSignal, this);
        }
        if (observerModule)
            observerModule->unsubscribe(receptionStartedSignal, this);
        cancelAndDelete(begin);
        cancelAndDelete(transmit);
        cancelAndDelete(inspect);
        cancelAndDelete(check);
    }
};
Define_Module(Probe);
}

%file: test.ned
import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadio;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;
import inet.physicallayer.wireless.noise.NoiseSource;

module RadioNode
{
    gates:
        input down;
        output up;
    submodules:
        mobility: StationaryMobility;
        radio: Ieee80211DimensionalRadio {
            parameters:
                antenna.mobilityModule = absPath("^.mobility");
        }
    connections allowunconnected:
        down --> radio.upperLayerIn;
        radio.upperLayerOut --> up;
}

module PulsedNoise extends NoiseSource
{
    parameters:
        @class(PulsedNoise);
}

simple Probe
{
    parameters:
        @class(Probe);
    gates:
        output out;
        input in;
        input secondaryIn;
}

network Test
{
    submodules:
        radioMedium: Ieee80211DimensionalRadioMedium;
        a: RadioNode;
        b: RadioNode;
        c: RadioNode;
        secondary: PulsedNoise;
        primary: PulsedNoise;
        probe: Probe;
    connections allowunconnected:
        probe.out --> a.down;
        b.up --> probe.in;
        c.up --> probe.secondaryIn;
}

%inifile: omnetpp.ini
[General]
network = Test
ned-path = .;../../../../src
sim-time-limit = 12ms
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
**.scalar-recording = false
**.vector-recording = false
*.radioMedium.listeningFilter = false
*.radioMedium.macAddressFilter = false
*.radioMedium.radioModeFilter = false
*.radioMedium.rangeFilter = ""
*.radioMedium.backgroundNoise.power = nan W
*.radioMedium.backgroundNoise.powerSpectralDensity = -130dBmWpMHz
# Flat received PSD isolates the no-renormalization invariant from frequency-
# dependent path-loss variation across the occupied80MHz allocation.
*.radioMedium.analogModel.attenuateWithCenterFrequency = true
*.a.radio.initialRadioMode = "transmitter"
*.b.radio.initialRadioMode = "receiver"
*.c.radio.initialRadioMode = "receiver"
*.a.radio.contiguousChannelAllocation = true
*.b.radio.contiguousChannelAllocation = true
*.c.radio.contiguousChannelAllocation = false
*.a.radio.bandwidth = 80MHz
*.b.radio.bandwidth = 80MHz
*.c.radio.bandwidth = 20MHz
*.c.radio.channelNumber = 1
**.radio.channelNumber = 0
**.radio.opMode = "ac-complete"
**.radio.bandName = "5 GHz (mapped 20 MHz)"
**.radio.fcsMode = "computed"
**.radio.sendRawBytes = true
**.radio.transmitter.power = 20mW
**.radio.transmitter.bitrate = 6Mbps
**.radio.transmitter.bandwidth = 20MHz
**.radio.receiver.bandwidth = 20MHz
**.radio.receiver.sensitivity = -100dBm
**.radio.receiver.energyDetection = -100dBm
**.radio.receiver.snirThreshold = 4dB
*.secondary.transmitter.centerFrequency = 5200MHz
*.primary.transmitter.centerFrequency = 5180MHz
*.secondary.sleepInterval = 1s
*.primary.sleepInterval = 1s
*.secondary.transmitter.duration = 1ms
*.primary.transmitter.duration = 1ms
*.secondary.transmitter.bandwidth = 20MHz
*.primary.transmitter.bandwidth = 20MHz
*.secondary.transmitter.power = 20W
*.primary.transmitter.power = 20W
*.secondary.transmitter.signalAnalogRepresentation = "dimensional"
*.primary.transmitter.signalAnalogRepresentation = "dimensional"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.a.mobility.initialX = 0m
*.b.mobility.initialX = 10m
*.c.mobility.initialX = 10m
*.secondary.mobility.initialX = 0m
*.primary.mobility.initialX = 0m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m

%contains: stdout
duplicate round 0: PASS
%contains: stdout
duplicate round 1: PASS
%contains: stdout
duplicate round 2: PASS
%contains: stdout
duplicate reception: PASS

%not-contains: stdout
undisposed object:

%not-contains: stdout
it doesn't own
