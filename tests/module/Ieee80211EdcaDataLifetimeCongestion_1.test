%description:
Measure MAC delay and lifetime disposal under identical controlled congestion.
Hold twenty DATA frames for 0.7 seconds before channel access.
Compare the default with a one-second lifetime through production MAC exchanges.

%extraargs: -r 0..1

%file: LifetimeCongestion.cc
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/Rx.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"

namespace inet::ieee80211 {
class CongestionHcf : public Hcf {
  public:
    int delivered = 0;
    int completed = 0;
    simtime_t delaySum = 0;
    simtime_t completionSum = 0;
  protected:
    void sendUp(const std::vector<Packet *>& frames) override {
        for (auto packet : frames) {
            delivered++;
            delaySum += simTime();
            delete packet;
        }
    }
    void originatorProcessReceivedControlFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header,
            Packet *last, const Ptr<const Ieee80211MacHeader>& lastHeader, AccessCategory ac) override {
        if (header->getType() == ST_ACK && lastHeader->getType() == ST_DATA_WITH_QOS) {
            completed++;
            completionSum += simTime();
        }
        Hcf::originatorProcessReceivedControlFrame(packet, header, last, lastHeader, ac);
    }
};
Define_Module(CongestionHcf);

class LifetimeCongestionTest : public cSimpleModule, public cListener {
    int lifetimeDrops = 0;
    int otherDrops = 0;
    simtime_t queueDelaySum = 0;
  protected:
    void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *details) override {
        if (signal == packetDroppedSignal) {
            auto drop = check_and_cast<PacketDropDetails *>(details);
            if (drop->getReason() == LIFETIME_EXPIRED) {
                lifetimeDrops++;
                queueDelaySum += simTime();
                std::cout << "DISPOSAL " << object->getName() << " acceptance=0 disposal=" << simTime()
                    << " age=" << simTime() << " cause=LIFETIME_EXPIRED\n";
            }
            else
                otherDrops++;
        }
        else {
            auto packet = check_and_cast<Packet *>(object);
            queueDelaySum += simTime();
            std::cout << "QUEUE_EXIT " << packet->getName() << " acceptance=0 time=" << simTime() << "\n";
        }
    }
    void activity() override {
        auto senderMac = getParentModule()->getSubmodule("host")->getSubmodule("wlan", 0)->getSubmodule("mac");
        auto sender = check_and_cast<CongestionHcf *>(senderMac->getSubmodule("hcf"));
        auto receiverMac = getParentModule()->getSubmodule("receiver")->getSubmodule("wlan", 0)->getSubmodule("mac");
        auto receiver = check_and_cast<CongestionHcf *>(receiverMac->getSubmodule("hcf"));
        auto rx = check_and_cast<Rx *>(senderMac->getSubmodule("rx"));
        auto edca = check_and_cast<Edca *>(sender->getSubmodule("edca"));
        auto pending = edca->getEdcaf(AC_BE)->getPendingQueue();
        sender->subscribe(packetDroppedSignal, this);
        auto pendingModule = check_and_cast<cModule *>(pending);
        pendingModule->subscribe(cComponent::registerSignal("packetPulled"), this);
        rx->setContentionBlocked(true);
        for (int i = 0; i < 20; i++) {
            auto header = makeShared<Ieee80211DataHeader>();
            header->setType(ST_DATA_WITH_QOS);
            header->addChunkLength(QOSCONTROL_PART_LENGTH);
            header->setTid(0);
            header->setReceiverAddress(MacAddress("02:00:00:00:00:02"));
            header->setTransmitterAddress(MacAddress("02:00:00:00:00:01"));
            header->setAddress3(header->getReceiverAddress());
            std::string name = "congestion-data-" + std::to_string(i);
            auto packet = new Packet(name.c_str(), header);
            packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
            packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
            sender->processUpperFrame(packet, header);
        }
        wait(SimTime(700, SIMTIME_MS));
        bool expires = par("expectedExpiration").boolValue() && !par("longLifetime").boolValue();
        ASSERT(pending->getNumPackets() == (expires ? 0 : 20));
        ASSERT(lifetimeDrops == (expires ? 20 : 0));
        ASSERT(otherDrops == 0);
        rx->setContentionBlocked(false);
        wait(SimTime(50, SIMTIME_MS));
        ASSERT(receiver->delivered == (expires ? 0 : 20));
        ASSERT(sender->completed == (expires ? 0 : 20));
        ASSERT(otherDrops == 0);
        std::cout << "CONGESTION lifetime=" << (par("longLifetime").boolValue() ? "1" : "0.512")
            << " blockAck=false delivered=" << receiver->delivered << " lifetimeDisposal=" << lifetimeDrops
            << " otherDisposal=" << otherDrops << " meanQueueDelay="
            << queueDelaySum.dbl() / 20;
        if (expires)
            std::cout << " meanDeliveryDelay=unavailable meanCompletionDelay=unavailable\n";
        else
            std::cout << " meanDeliveryDelay=" << receiver->delaySum.dbl() / 20
                << " meanCompletionDelay=" << sender->completionSum.dbl() / 20 << "\n";
        sender->unsubscribe(packetDroppedSignal, this);
        pendingModule->unsubscribe(cComponent::registerSignal("packetPulled"), this);
        std::cout << "Controlled congestion checks passed.\n";
    }
  public:
    LifetimeCongestionTest() : cSimpleModule(65536) {}
};
Define_Module(LifetimeCongestionTest);
}

%file: LifetimeCongestionNetwork.ned
import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
module CongestionHcf extends Hcf {
    parameters:
        @class(::inet::ieee80211::CongestionHcf);
}
simple LifetimeCongestionTest extends SimpleModule {
    parameters:
        bool expectedExpiration = default(true);
        bool longLifetime;
        @class(::inet::ieee80211::LifetimeCongestionTest);
}
network LifetimeCongestionNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        host: WirelessHost;
        receiver: WirelessHost;
        test: LifetimeCongestionTest;
}

%inifile: omnetpp.ini
[General]
network = LifetimeCongestionNetwork
ned-path = .;../../../../src;../../lib
sim-time-limit = 0.8s
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.test.longLifetime = ${longLifetime=false,true}
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 6Mbps
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "CongestionHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = false
**.wlan[*].mac.hcf.edca.edcaf[*].msduLifetime = ${longLifetime} ? 1s : 0.512s
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.originatorMacDataService.mpduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.rateSelection.dataFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.edca.edcaf[*].cwMin = 0
**.wlan[*].mac.hcf.edca.edcaf[*].cwMax = 0
*.host.wlan[0].address = "02:00:00:00:00:01"
*.receiver.wlan[0].address = "02:00:00:00:00:02"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.host.mobility.initialX = 0m
*.host.mobility.initialY = 0m
*.receiver.mobility.initialX = 1m
*.receiver.mobility.initialY = 0m

%contains: stdout
Controlled congestion checks passed.
