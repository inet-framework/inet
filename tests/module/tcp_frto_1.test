%description:
Tests that F-RTO (RFC 5682, SACK-enhanced, frtoEnabled=true) finds a
spurious timeout after a delay of the ACKs. The tester delays the four
ACKs of the first flight by 3.5 s, so the timeout at t=4 retransmits
1:501. The receiver holds all data, so its ACK at t=4.003 acknowledges
2001 and reports the retransmission by a D-SACK. The ACK covers data
that the sender sent only once, so the original flight arrived (Linux
FLAG_ORIG_SACK_ACKED), and the sender restores cwnd 2000 and ssthresh.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="b2 delay 3.5; b3 delay 3.5; b4 delay 3.5; b5 delay 3.5"

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 2000;6 500"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.frtoEnabled = true
*.*_tcp.increasedIWEnabled = true



%# the first ACK after the timeout covers data that was sent once...
%contains: stdout
[4.003 B006] A.1000 < B.2000: A ack 2001 win 5000   Option(s): NOP NOP SACK[1,501)

%# ...so F-RTO undoes the reduction of the timeout
%contains: stdout
F-RTO: spurious retransmission timeout detected, undoing the RTO response

%contains: stdout
Undoing spurious cwnd reduction (D-SACK): cwnd=2000, ssthresh=4294967295

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
