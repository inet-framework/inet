%description:
Tests the wait of the path MTU search (mtuProbing = 2) for room for a probe. The
scenario is that of tcp_mtu_probe_1, but the client offers a window of 8000
bytes. A probe needs room in the window for itself and reordering + 1 = 4
segments after it (RFC 4821 section 7.4). When only the window edge has no
room, the server sends nothing and waits, as Linux tcp_mtu_probe() returns 0:
after the ACK of the first probe (A022), the ACKs up to A028 give no segment.
A029 makes room, and the server sends the probe of 1223 bytes (B033) and the
segments after it.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.srv_app.sendScript="1.0 40000"
*.srv_tcp.mss = 600
*.cli_tcp.mss = 1460
*.cli_tcp.advertisedWindow = 8000
*.*_tcp.delayedAcksEnabled = false
*.srv_tcp.mtuProbing = 2
*.srv_tcp.baseMss = 512
*.srv_tcp.pathMtu = 1500

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.019 A022] A.1000 > B.2000: A ack 12887 win 8000 
[1.019 A023] A.1000 > B.2000: A ack 13487 win 8000 
[1.019 A024] A.1000 > B.2000: A ack 14087 win 8000 
[1.019 A025] A.1000 > B.2000: A ack 14687 win 8000 
[1.019 A026] A.1000 > B.2000: A ack 15287 win 8000 
[1.019 A027] A.1000 > B.2000: A ack 15887 win 8000 
[1.019 A028] A.1000 > B.2000: A ack 16487 win 8000 
[1.019 A029] A.1000 > B.2000: A ack 17087 win 8000 
[1.021 B029] A.1000 < B.2000: A 17087:17687(600) ack 1 win 16384 
[1.021 B030] A.1000 < B.2000: A 17687:18287(600) ack 1 win 16384 
[1.021 B031] A.1000 < B.2000: A 18287:18887(600) ack 1 win 16384 
[1.021 B032] A.1000 < B.2000: A 18887:19487(600) ack 1 win 16384 
[1.021 B033] A.1000 < B.2000: A 19487:20710(1223) ack 1 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
RFC 4821: waiting for room for an MTU probe
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
RFC 4821: sent an MTU probe of 1223 bytes (MTU 1263)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
