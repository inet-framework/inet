%description:
Tests the retransmission of a SYN-ACK that gives a TCP Fast Open cookie. The
tester deletes the SYN-ACK of connection 1, which gives the cookie. The
retransmitted SYN-ACK carries no Fast Open option (RFC 7413 section 4.2.2: "the
server SHOULD retransmit a SYN-ACK segment with neither data nor Fast Open
options"), so the client caches no cookie, and the SYN of connection 2 requests
a cookie again, without data.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.fastOpen=true
*.cli_app.tOpen2=0.5s
*.cli_app.active2=true
*.cli_app.localPort2=1001
*.cli_app.tSend2=0.5s
*.cli_app.sendBytes2=200B
*.cli_app.fastOpen2=true
*.srv_app.tOpen2=0.5s
*.srv_app.localPort2=2000

*.tcptester.script="b1 delete"
*.cli_tcp.fastopenClientEnabled = true
*.srv_tcp.fastopenServerEnabled = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.501 A002] A.1001 > B.2000: S 125000:125000(0) win 16384   Option(s): MaxSegSize NOP NOP FastOpen(cookieLen=0)
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.505 A003] A.1001 > B.2000: A 125001:125201(200) ack 125501 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[3.003 B004] A.1000 < B.2000: A S 500:500(0) ack 1 win 16384   Option(s): MaxSegSize
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
