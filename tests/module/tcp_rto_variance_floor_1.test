%description:
Tests rtoVarianceFloor=true, the RTO of Linux (tcp_set_rto()). The tester
delays the ACK of the first data segment, so the client measures an RTT of
52 ms. With a minimum of 200 ms, the RTO is SRTT + max(4*RTTVAR, minimum) =
52 + 200 = 252 ms. The tester removes the second data segment, and its
retransmission comes after 252 ms. RFC 6298 (rtoVarianceFloor=false) gives
max(52 + 104, 200) = 200 ms.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 500; 2.0 500"
*.cli_tcp.rtoVarianceFloor = true
*.cli_tcp.minRexmitTimeout = 0.2s
*.srv_tcp.delayedAcksEnabled = false
*.tcptester.script="b2 delay 0.048; a4 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:501(500) ack 501 win 16384 
[1.003 B002] A.1000 < B.2000: A ack 501 win 16384 # removing original
[1.051 B002] A.1000 < B.2000: A ack 501 win 16384 # introducing copy
[2.001 A004] A.1000 > B.2000: A 501:1001(500) ack 501 win 16384 # deleting
[2.253 A005] A.1000 > B.2000: A 501:1001(500) ack 501 win 16384 
[2.255 B003] A.1000 < B.2000: A ack 1001 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
new RTO=252ms
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
