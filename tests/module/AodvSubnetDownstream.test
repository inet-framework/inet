%description:
RFC 3561 sections 5.2, 6 and 7: received subnet routes and independent prefix state.

%file: Peer.cc
#include "../../../protocol/aodv/AodvSubnetDownstreamPeer.h"

%file: test.ned
import inet.applications.contract.IApp;
import inet.node.inet.AdhocHost;
import inet.node.aodv.AodvRouter;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.physicallayer.wireless.common.medium.UnitDiskRadioMedium;
simple AodvSubnetDownstreamPeer like IApp
{
    parameters:
        string scenario = default("Control");
        @class(::AodvSubnetDownstreamPeer);
    gates:
        input socketIn;
        output socketOut;
}
simple AodvDataSource like IApp
{
    parameters:
        string destinations;
        double emitTime @unit(s);
        int localPort = default(12345);
        @class(::AodvDataSource);
    gates:
        input socketIn;
        output socketOut;
}
simple AodvSubnetSource like IApp
{
    parameters:
        double emitTime @unit(s) = default(10s);
        @class(::AodvSubnetSource);
    gates:
        input socketIn;
        output socketOut;
}
network AodvTest
{
    submodules:
        configurator: Ipv4NetworkConfigurator;
        radioMedium: UnitDiskRadioMedium;
        radioMedium1: UnitDiskRadioMedium;
        requester: AodvRouter;
        dut: AodvRouter;
        peer: AdhocHost;
}

%inifile: omnetpp.ini
[General]
network = AodvTest
ned-path = .;../../../../src;../../lib
sim-time-limit = 1s
seed-set = 0
cmdenv-express-mode = true
**.vector-recording = false
*.configurator.addStaticRoutes = false
*.configurator.addDefaultRoutes = false
*.configurator.addSubnetRoutes = false
*.configurator.config = xml("<config><interface hosts='dut' names='wlan0' address='10.0.0.1' netmask='255.255.255.0'/><interface hosts='peer' names='wlan0' address='10.0.0.2' netmask='255.255.255.0'/><interface hosts='dut' names='wlan1' address='10.1.0.1' netmask='255.255.255.0'/><interface hosts='requester' address='10.1.0.2' netmask='255.255.255.0'/></config>")
*.dut.aodv.jitter = 0s
*.dut.aodv.periodicJitter = 0s
*.dut.aodv.useHelloMessages = false
*.peer.app[0].scenario = "Downstream"
*.dut.numApps = 0
*.peer.forwarding = false
*.peer.numWlanInterfaces = 1
*.dut.numWlanInterfaces = 2
*.dut.aodv.interfaces = "wlan0 wlan1"
*.dut.wlan[1].radio.radioMediumModule = "radioMedium1"
*.requester.wlan[0].radio.radioMediumModule = "radioMedium1"
*.requester.numApps = 2
*.requester.app[*].typename = "AodvDataSource"
*.requester.app[0].destinations = "10.8.0.99"
*.requester.app[0].emitTime = 0.16s
*.requester.app[1].destinations = "10.8.0.100"
*.requester.app[1].emitTime = 0.24s
*.requester.app[1].localPort = 12346
*.requester.aodv.jitter = 0s
*.requester.aodv.periodicJitter = 0s
*.requester.aodv.useHelloMessages = false
*.peer.numApps = 1
*.peer.app[0].typename = "AodvSubnetDownstreamPeer"
**.arp.typename = "GlobalArp"
**.wlan[*].typename = "AckingWirelessInterface"
**.wlan[*].radio.typename = "GenericUnitDiskRadio"
**.wlan[*].bitrate = 1Mbps
**.wlan[*].radio.transmitter.analogModel.communicationRange = 100m
**.wlan[*].radio.transmitter.headerLength = 4b
**.wlan[*].mac.headerLength = 20B
**.mobility.typename = "StationaryMobility"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initialX = 10m
**.mobility.initialY = 10m
**.mobility.initialZ = 0m

%contains: stdout
AODV Subnet Downstream: PASS
