%description:
Tests the sequence number of the RST of an abort during a retransmission. The
tester deletes the ACKs of the server for the three segments 1:3001, so the
client sends the first again after the RTO (snd_nxt 1001, snd_max 3001), and
aborts then. Its RST carries seq 3001, the SND.NXT of RFC 9293, which lies at
RCV.NXT of the server, and the server closes at once. Master put snd_nxt (1001)
on the RST: the server dropped it as outside its window and closed only on the
RST that answered its next ACK.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 3000"
*.*_tcp.mss = 1000
*.cli_tcp.increasedIWEnabled = true
*.cli_app.tAbort=4.0015s
*.tcptester.script="B2 delete; B3 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.001 A004] A.1000 > B.2000: A 1001:2001(1000) ack 501 win 16384 
[1.001 A005] A.1000 > B.2000: A 2001:3001(1000) ack 501 win 16384 
[1.003 B002] A.1000 < B.2000: A ack 2001 win 16384 # deleting
[1.203 B003] A.1000 < B.2000: A ack 3001 win 16384 # deleting
[4.001 A006] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
cli_tcp: ESTABLISHED --> CLOSED  (on ABORT)
[4.002 A007] A.1000 > B.2000: R win 0 
[4.003 B004] A.1000 < B.2000: A ack 3001 win 16384 
srv_tcp: ESTABLISHED --> CLOSED  (on RCV_RST)
[4.005 A008] A.1000 > B.2000: R win 0 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
