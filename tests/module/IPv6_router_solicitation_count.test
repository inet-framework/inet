%description:
Tests the maxRtrSolicitations Router Discovery knob of Ipv6NeighbourDiscovery
and its per-interface counterpart in Ipv6NetworkConfigurator.

Three hosts share one Ethernet link (via a switch) with no router on it, so
no Router Solicitation is ever answered and every host sends its full count:
  - hostA: maxRtrSolicitations = 0 as a NED parameter -> sends none;
  - hostB: NED default (3), overridden to 1 by the configurator's
    maxRtrSolicitations interface attribute -> sends exactly one;
  - hostC: NED default -> sends MAX_RTR_SOLICITATIONS = 3, as before the knob.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned
import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ethernet.EthernetSwitch;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

network RsCountTestNetwork
{
    types:
        channel ethline extends DatarateChannel
        {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        configurator: Ipv6NetworkConfigurator;
        switch: EthernetSwitch;
        hostA: StandardHost6;
        hostB: StandardHost6;
        hostC: StandardHost6;
    connections:
        hostA.ethg++ <--> ethline <--> switch.ethg++;
        hostB.ethg++ <--> ethline <--> switch.ethg++;
        hostC.ethg++ <--> ethline <--> switch.ethg++;
}
%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = ../../../../src
network = RsCountTestNetwork
sim-time-limit = 20s
cmdenv-express-mode = false
cmdenv-event-banners = false
cmdenv-log-prefix = "%C: "
**.neighbourDiscovery.cmdenv-log-level = info
**.cmdenv-log-level = off

*.configurator.config = xml("<config> \
    <interface hosts='hostB' prefix='2001:db8:1:1::/64' maxRtrSolicitations='1'/> \
    <interface hosts='**' prefix='2001:db8:1:1::/64'/> \
</config>")

*.hostA.ipv6.neighbourDiscovery.maxRtrSolicitations = 0

%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: awk '/\.hostA\.ipv6\.neighbourDiscovery: Sending Router Solicitation/ {a++} /\.hostB\.ipv6\.neighbourDiscovery: Sending Router Solicitation/ {b++} /\.hostC\.ipv6\.neighbourDiscovery: Sending Router Solicitation/ {c++} END {printf "hostA sent %d RS\nhostB sent %d RS\nhostC sent %d RS\n", a, b, c}' test.out > rs_count.out
%contains: rs_count.out
hostA sent 0 RS
hostB sent 1 RS
hostC sent 3 RS
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
RsCountTestNetwork.hostA.ipv6.neighbourDiscovery: Router Discovery is disabled on eth0 (maxRtrSolicitations = 0)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
