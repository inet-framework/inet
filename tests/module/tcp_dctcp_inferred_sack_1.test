%description:
DcTcp without SACK ends the inferred SACKs at an ACK of new data outside
a fast recovery, as the other classic flavours do (Linux
tcp_reset_reno_sack()). The tester delays segment a14 and drops a15, so
the duplicate ACKs B013 and B014 mark two segments as SACKed, and B015
acknowledges a14 at t=1.016 s. With the marks gone, cwnd 13312 allows two
segments after B015, and at the fast retransmit three new segments go
out in recovery, as the inflated window of RFC 5681 allows. Old marks
lower the count of the bytes in flight by two segments: the sender sends
four segments after B015, two beyond cwnd, and six in recovery. The trace
is the same as with TcpReno.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

*.cli_app.tSend=1s
*.cli_app.sendBytes=65536B # 64 1024-byte segments

*.tcptester.script="a14 delay 0.0005; a15 delete"  # two duplicate ACKs, then an ACK of new data

*.*_tcp.tcpAlgorithmClass = "DcTcp"
*.*_tcp.delayedAcksEnabled = false
*.*_tcp.advertisedWindow = 65535

include ../../lib/defaults.ini

%contains: stdout
[1.015 B014] A.1000 < B.2000: A ack 11265 win 65535
[1.016 B015] A.1000 < B.2000: A ack 12289 win 64511

%contains: stdout
[1.018 A026] A.1000 > B.2000: A 23553:24577(1024) ack 501 win 65535
[1.018 A027] A.1000 > B.2000: A 24577:25601(1024) ack 501 win 65535
[1.019 B016] A.1000 < B.2000: A ack 12289 win 64511

%contains: stdout
[1.020 B025] A.1000 < B.2000: A ack 12289 win 64511
[1.021 A028] A.1000 > B.2000: A 12289:13313(1024) ack 501 win 65535
[1.021 A029] A.1000 > B.2000: A 25601:26625(1024) ack 501 win 65535
[1.022 A030] A.1000 > B.2000: A 26625:27649(1024) ack 501 win 65535
[1.022 A031] A.1000 > B.2000: A 27649:28673(1024) ack 501 win 65535
[1.023 B026] A.1000 < B.2000: A ack 25601 win 65535

%contains: stdout
[1.044] tcpdump finished, A:67 B:65 segments

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
