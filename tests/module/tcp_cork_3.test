%description:
Tests TCP_NODELAY on a corked connection. The client corks and writes 500 bytes.
TCP_NODELAY at t=1.5 sends the held partial once, as Linux TCP_NAGLE_PUSH, but
the cork stays: the write of t=2 waits until the cork timer sends it one RTO
later.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.corkScript="0.5 1"
*.cli_app.noDelayScript="1.5 1"
*.cli_app.sendScript="1.0 500; 2.0 200"
*.*_tcp.mss = 1000

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.501 A003] A.1000 > B.2000: A P 1:501(500) ack 501 win 16384 
[1.703 B002] A.1000 < B.2000: A ack 501 win 16384 
[3.001 A004] A.1000 > B.2000: A P 501:701(200) ack 501 win 16384 
[3.203 B003] A.1000 < B.2000: A ack 701 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Holding the partial segment (TCP_CORK or MSG_MORE)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
