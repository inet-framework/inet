%description:
Reject invalid VRA configuration: individualRecovery = true.

%file: TestNetwork.ned
import inet.protocolelement.redundancy.VectorStreamMerger;
network TestNetwork {
    submodules:
        merger: VectorStreamMerger;
    connections allowunconnected:
}

%file: Fixture.cc
// Empty compilation unit for this NED-only initialization test.

%inifile: omnetpp.ini
[General]
ned-path = .;../../../../src
network = TestNetwork
sim-time-limit = 1ms
*.merger.individualRecovery = true
*.merger.mapping = {a: "same", b: "same"}

%exitcode: 1
%postrun-command: cat test.out test.err > diagnostics.out
%contains: diagnostics.out
Individual recovery requires a distinct recovery instance
