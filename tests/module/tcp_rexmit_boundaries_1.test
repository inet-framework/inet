%description:
A retransmission keeps the original segments, as Linux does: it takes only
whole segments that fit into one SMSS together (tcp_retrans_try_collapse()),
and it never splits a segment to fill up the SMSS. The client sends two
segments of 300 bytes and one of 1024 bytes, and the tester drops all three.
At the timeout, the first retransmission carries the two small segments, 600
bytes; the segment of 1024 bytes follows whole. Before, the first
retransmission took 1024 bytes and split the third segment.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

# script format: "time numbytes; time numbytes; ..."
*.cli_app.sendScript="1.0 300; 1.0 300; 1.0 1024"
*.tcptester.script="a3 delete; a4 delete; a5 delete"

*.*_tcp.nagleEnabled = false
*.*_tcp.delayedAcksEnabled = false
*.*_tcp.increasedIWEnabled = true

include ../../lib/defaults.ini

%contains: stdout
[1.001 A003] A.1000 > B.2000: A 1:301(300) ack 501 win 16384 # deleting
[1.001 A004] A.1000 > B.2000: A 301:601(300) ack 501 win 16384 # deleting
[1.001 A005] A.1000 > B.2000: A 601:1625(1024) ack 501 win 16384 # deleting
[4.001 A006] A.1000 > B.2000: A 1:601(600) ack 501 win 16384
[4.003 B002] A.1000 < B.2000: A ack 601 win 16384
[4.005 A007] A.1000 > B.2000: A 601:1625(1024) ack 501 win 16384
[4.007 B003] A.1000 < B.2000: A ack 1625 win 16384

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
