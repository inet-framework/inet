%description:
Verify Block Ack inactivity through real ADDBA exchanges and HCF restart.
Cover both agreement owners, overdue deadlines, node stop/crash, zero timeout,
and simultaneous originator and recipient agreements with different deadlines.
Cover ADDBA response retries and queued responses after agreement expiry.
IEEE Std 802.11-2024, 11.5.4 requires timeout DELBA for inactive agreements.

%extraargs: -r 0..16

%file: TestIeee80211BlockAckInactivity.cc

#include "inet/common/lifecycle/LifecycleController.h"
#include "inet/common/lifecycle/ModuleOperations.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadio.h"

namespace inet {
namespace ieee80211 {

class TestBlockAckMac : public Ieee80211Mac
{
  public:
    virtual void sendUpFrame(Packet *packet) override
    {
        Enter_Method("sendUpFrame");
        take(packet);
        delete packet;
    }
};

Define_Module(TestBlockAckMac);

class TestBlockAckHcf : public Hcf
{
  public:
    int timeoutDelbas = 0;
    int transmittedDelbas = 0;
    bool stopOnTimeoutDelba = false;
    bool dropAddbaAck = false;
    bool stopOnAddbaResponse = false;
    bool repeatStopOnAddbaResponse = false;
    int droppedAddbaAcks = 0;
    int expiredAddbaRequests = 0;
    int transmittedAddbaResponses = 0;
    int expiredAddbaResponses = 0;

    bool hasInactivityTimer() const { return inactivityTimer->isScheduled(); }
    simtime_t getInactivityTime() const { return inactivityTimer->getArrivalTime(); }
    bool isIdle() const { return !frameSequenceHandler->isSequenceRunning(); }
    simtime_t getAgreementDeadline(const MacAddress& peer, bool originator, Tid tid = 0) const
    {
        if (originator) {
            auto agreement = originatorBlockAckAgreementHandler->getAgreement(peer, tid);
            return agreement != nullptr && agreement->getIsAddbaResponseReceived() ? agreement->getExpirationTime() : -1;
        }
        auto agreement = recipientBlockAckAgreementHandler->getAgreement(tid, peer);
        return agreement != nullptr ? agreement->getExpirationTime() : -1;
    }

    void queueFrame(const MacAddress& receiver, Tid tid = 0)
    {
        Enter_Method("queueFrame");
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setTid(tid);
        header->setSequenceNumber(SequenceNumberCyclic(1));
        header->setAckPolicy(NORMAL_ACK);
        header->setReceiverAddress(receiver);
        header->setTransmitterAddress(mac->getAddress());
        auto packet = new Packet("agreementTrigger", header);
        packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(800, 0)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
    }

    virtual void processMgmtFrame(Packet *packet, const Ptr<const Ieee80211MgmtHeader>& header) override
    {
        if (stopOnAddbaResponse && dynamicPtrCast<const Ieee80211AddbaResponse>(header)) {
            if (!repeatStopOnAddbaResponse)
                stopOnAddbaResponse = false;
            stop();
        }
        auto delba = dynamicPtrCast<const Ieee80211Delba>(header);
        if (delba != nullptr && delba->getReasonCode() == 39) {
            ++timeoutDelbas;
            if (stopOnTimeoutDelba && timeoutDelbas == 1)
                stop();
        }
        Hcf::processMgmtFrame(packet, header);
    }

  protected:
    virtual void transmitControlResponseFrame(Packet *responsePacket, const Ptr<const Ieee80211MacHeader>& responseHeader,
            Packet *receivedPacket, const Ptr<const Ieee80211MacHeader>& receivedHeader) override
    {
        if (dropAddbaAck && dynamicPtrCast<const Ieee80211AddbaResponse>(receivedHeader)) {
            ++droppedAddbaAcks;
            delete responsePacket;
            return;
        }
        Hcf::transmitControlResponseFrame(responsePacket, responseHeader, receivedPacket, receivedHeader);
    }

    virtual void originatorProcessTransmittedManagementFrame(const Ptr<const Ieee80211MgmtHeader>& header, AccessCategory ac) override
    {
        if (dynamicPtrCast<const Ieee80211Delba>(header) != nullptr)
            ++transmittedDelbas;
        if (auto request = dynamicPtrCast<const Ieee80211AddbaRequest>(header)) {
            if (originatorBlockAckAgreementHandler->getAgreement(request->getReceiverAddress(), request->getTid()) == nullptr)
                ++expiredAddbaRequests;
        }
        if (auto response = dynamicPtrCast<const Ieee80211AddbaResponse>(header)) {
            ++transmittedAddbaResponses;
            if (recipientBlockAckAgreementHandler->getAgreement(response->getTid(), response->getReceiverAddress()) == nullptr)
                ++expiredAddbaResponses;
        }
        Hcf::originatorProcessTransmittedManagementFrame(header, ac);
    }
};

Define_Module(TestBlockAckHcf);

class Ieee80211BlockAckInactivityTest : public cSimpleModule, public LifecycleController
{
  protected:
    class Completion : public IDoneCallback
    {
      public:
        bool done = false;
        virtual void invoke() override { done = true; }
    };

  public:
    Ieee80211BlockAckInactivityTest() : cSimpleModule(65536) {}

  protected:
    void operate(cModule *node, LifecycleOperation *operation)
    {
        LifecycleOperation::StringMap parameters;
        operation->initialize(node, parameters);
        Completion completion;
        if (!initiateOperation(operation, &completion)) {
            for (int i = 0; i < 100 && !completion.done; ++i)
                wait(SimTime(100, SIMTIME_US));
            ASSERT(completion.done);
        }
    }

    virtual void activity() override
    {
        auto sender = check_and_cast<TestBlockAckHcf *>(getModuleByPath("^.node[0].wlan[0].mac.hcf"));
        auto recipient = check_and_cast<TestBlockAckHcf *>(getModuleByPath("^.node[1].wlan[0].mac.hcf"));
        const MacAddress senderAddress("02:00:00:00:00:01");
        const MacAddress recipientAddress("02:00:00:00:00:02");
        int scenario = par("scenario");
        if (scenario == 16) {
            sender->queueFrame(recipientAddress);
            wait(SimTime(5, SIMTIME_MS));
            ASSERT(sender->getAgreementDeadline(recipientAddress, true) > simTime());
            auto radio = check_and_cast<physicallayer::IRadio *>(getModuleByPath("^.node[0].wlan[0].radio"));
            sender->stop();
            radio->setRadioMode(physicallayer::IRadio::RADIO_MODE_OFF);
            sender->queueFrame(recipientAddress);
            wait(SimTime(45, SIMTIME_MS));
            radio->setRadioMode(physicallayer::IRadio::RADIO_MODE_RECEIVER);
            sender->start();
            wait(SimTime(5, SIMTIME_MS));
            ASSERT(sender->expiredAddbaRequests == 0);
            ASSERT(sender->getAgreementDeadline(recipientAddress, true) > simTime());
            ASSERT(recipient->getAgreementDeadline(senderAddress, false) > simTime());
            ASSERT(sender->isIdle() && recipient->isIdle());
            std::cout << "Block Ack inactivity scenario " << scenario << " passed.\n";
            endSimulation();
        }
        sender->dropAddbaAck = scenario == 13;
        recipient->stopOnAddbaResponse = scenario >= 14;
        recipient->repeatStopOnAddbaResponse = scenario == 15;
        sender->queueFrame(recipientAddress);
        if (scenario >= 12) {
            if (scenario >= 14) {
                for (int i = 0; i < 100 && !recipient->isStopped(); ++i)
                    wait(SimTime(100, SIMTIME_US));
                ASSERT(recipient->isStopped());
                ASSERT(recipient->transmittedAddbaResponses == 0);
                auto deadline = recipient->getAgreementDeadline(senderAddress, false);
                ASSERT(deadline >= simTime());
                wait(deadline - simTime() + SimTime(1, SIMTIME_US));
                recipient->start();
            }
            wait(SimTime(20, SIMTIME_MS));
            ASSERT(recipient->timeoutDelbas == 1);
            ASSERT(recipient->transmittedDelbas >= 1);
            ASSERT(!recipient->hasInactivityTimer());
            if (scenario == 15) {
                ASSERT(sender->expiredAddbaRequests >= 1);
                ASSERT(sender->isIdle());
                ASSERT(recipient->isStopped());
                auto retainedDeadline = recipient->getAgreementDeadline(senderAddress, false);
                ASSERT(retainedDeadline >= 0 && retainedDeadline <= simTime());
            }
            else {
                ASSERT(recipient->getAgreementDeadline(senderAddress, false) < 0);
                ASSERT(sender->isIdle() && recipient->isIdle());
            }
            if (scenario == 12) {
                ASSERT(sender->droppedAddbaAcks == 0);
                ASSERT(recipient->transmittedAddbaResponses == 1);
                ASSERT(recipient->expiredAddbaResponses == 0);
            }
            else {
                ASSERT(recipient->expiredAddbaResponses >= 1);
                if (scenario == 13) {
                    ASSERT(sender->droppedAddbaAcks > 1);
                    ASSERT(recipient->transmittedAddbaResponses > 1);
                }
            }
            std::cout << "Block Ack inactivity scenario " << scenario << " passed.\n";
            endSimulation();
        }
        for (int i = 0; i < 100 && sender->getAgreementDeadline(recipientAddress, true) < 0; ++i)
            wait(SimTime(100, SIMTIME_US));
        ASSERT(sender->getAgreementDeadline(recipientAddress, true) >= 0);
        ASSERT(recipient->getAgreementDeadline(senderAddress, false) >= 0);
        wait(SimTime(1, SIMTIME_MS));
        ASSERT(sender->isIdle() && recipient->isIdle());

        if (scenario >= 10) {
            sender->queueFrame(recipientAddress, 3);
            for (int i = 0; i < 100 && sender->getAgreementDeadline(recipientAddress, true, 3) < 0; ++i)
                wait(SimTime(100, SIMTIME_US));
            ASSERT(sender->getAgreementDeadline(recipientAddress, true, 3) >= 0);
            ASSERT(recipient->getAgreementDeadline(senderAddress, false, 3) >= 0);
            wait(SimTime(1, SIMTIME_MS));
            ASSERT(sender->isIdle() && recipient->isIdle());
        }

        if (scenario == 9) {
            // The later recipient deadline must not replace the originator deadline.
            recipient->queueFrame(senderAddress);
            for (int i = 0; i < 100 && recipient->getAgreementDeadline(senderAddress, true) < 0; ++i)
                wait(SimTime(100, SIMTIME_US));
            ASSERT(recipient->getAgreementDeadline(senderAddress, true) >= 0);
            wait(SimTime(1, SIMTIME_MS));
            recipient->stop();
            check_and_cast<physicallayer::IRadio *>(getModuleByPath("^.node[1].wlan[0].radio"))->setRadioMode(physicallayer::IRadio::RADIO_MODE_OFF);
            sender->stop();
            auto firstDeadline = sender->getAgreementDeadline(recipientAddress, true);
            auto secondDeadline = sender->getAgreementDeadline(recipientAddress, false);
            ASSERT(firstDeadline < secondDeadline);
            sender->start();
            ASSERT(sender->hasInactivityTimer());
            ASSERT(sender->getInactivityTime() == firstDeadline);
            wait(firstDeadline - simTime() + SimTime(1, SIMTIME_NS));
            ASSERT(sender->getAgreementDeadline(recipientAddress, true) < 0);
            ASSERT(sender->getAgreementDeadline(recipientAddress, false) == secondDeadline);
            ASSERT(sender->timeoutDelbas == 1);
            ASSERT(sender->getInactivityTime() == secondDeadline);
            wait(secondDeadline - simTime() + SimTime(1, SIMTIME_NS));
            ASSERT(sender->getAgreementDeadline(recipientAddress, false) < 0);
            ASSERT(sender->timeoutDelbas == 2);
            wait(SimTime(3, SIMTIME_MS));
            ASSERT(sender->timeoutDelbas == 2);
            ASSERT(sender->transmittedDelbas >= 2);
        }
        else {
            bool originator = scenario % 2 == 0;
            bool overdue = scenario == 2 || scenario == 3 || scenario == 6 || scenario == 7 || scenario >= 10;
            bool nodeOperation = scenario >= 4 && scenario <= 7;
            auto target = originator ? sender : recipient;
            auto remote = originator ? recipient : sender;
            auto peer = originator ? recipientAddress : senderAddress;
            auto node = getModuleByPath(originator ? "^.node[0]" : "^.node[1]");
            auto deadline = target->getAgreementDeadline(peer, originator);
            target->stopOnTimeoutDelba = scenario >= 10;
            ASSERT(scenario == 8 ? deadline == SIMTIME_MAX : target->hasInactivityTimer());
            remote->stop();
            auto remoteRadio = getModuleByPath(originator ? "^.node[1].wlan[0].radio" : "^.node[0].wlan[0].radio");
            check_and_cast<physicallayer::IRadio *>(remoteRadio)->setRadioMode(physicallayer::IRadio::RADIO_MODE_OFF);
            if (nodeOperation)
                operate(node, scenario >= 6 ? static_cast<LifecycleOperation *>(new ModuleCrashOperation()) : new ModuleStopOperation());
            else
                target->stop();
            target->stop();
            ASSERT(target->isStopped());
            ASSERT(!target->hasInactivityTimer());
            wait(SimTime(overdue ? 35 : 1, SIMTIME_MS));
            ASSERT(target->timeoutDelbas == 0);
            ASSERT(target->getAgreementDeadline(peer, originator) == deadline);
            if (nodeOperation)
                operate(node, new ModuleStartOperation());
            else
                target->start();
            target->start();
            ASSERT(!target->isStopped());
            if (scenario == 8) {
                ASSERT(!target->hasInactivityTimer());
                wait(SimTime(40, SIMTIME_MS));
                ASSERT(target->getAgreementDeadline(peer, originator) == SIMTIME_MAX);
                ASSERT(target->timeoutDelbas == 0);
            }
            else {
                ASSERT(target->hasInactivityTimer());
                ASSERT(target->getInactivityTime() == std::max(deadline, simTime()));
                wait(std::max(deadline - simTime(), SIMTIME_ZERO) + SimTime(1, SIMTIME_NS));
                ASSERT(target->getAgreementDeadline(peer, originator) < 0);
                int expectedDelbas = scenario >= 10 ? 2 : 1;
                ASSERT(target->timeoutDelbas == expectedDelbas);
                ASSERT(!target->hasInactivityTimer());
                if (scenario >= 10) {
                    ASSERT(target->getAgreementDeadline(peer, originator, 3) < 0);
                    ASSERT(target->isStopped());
                    ASSERT(target->transmittedDelbas == 0);
                    wait(SimTime(1, SIMTIME_MS));
                    ASSERT(target->transmittedDelbas == 0);
                    target->start();
                }
                wait(SimTime(3, SIMTIME_MS));
                ASSERT(target->timeoutDelbas == expectedDelbas);
                // The stopped peer need not acknowledge DELBA retries.
                ASSERT(target->transmittedDelbas >= expectedDelbas);
            }
        }
        std::cout << "Block Ack inactivity scenario " << scenario << " passed.\n";
        endSimulation();
    }
};

Define_Module(Ieee80211BlockAckInactivityTest);

} // namespace ieee80211
} // namespace inet

%file: test.ned

import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mac.Ieee80211Mac;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

module TestBlockAckMac extends Ieee80211Mac
{
    parameters:
        @class(::inet::ieee80211::TestBlockAckMac);
}

module TestBlockAckHcf extends Hcf
{
    parameters:
        @class(::inet::ieee80211::TestBlockAckHcf);
}

simple Ieee80211BlockAckInactivityTest extends SimpleModule
{
    parameters:
        int scenario;
        @class(::inet::ieee80211::Ieee80211BlockAckInactivityTest);
}

network Ieee80211BlockAckInactivityTestNetwork
{
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        node[2]: AdhocHost;
        test: Ieee80211BlockAckInactivityTest;
}

%inifile: omnetpp.ini

[General]
network = Ieee80211BlockAckInactivityTestNetwork
ned-path = .;../../../../src;../../lib
sim-time-limit = 100ms
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
seed-set = 0
*.test.scenario = ${scenario=0..16}
*.node[*].hasStatus = true
*.node[*].wlan[0].mac.typename = "TestBlockAckMac"
*.node[*].wlan[0].mac.qosStation = true
*.node[*].wlan[0].mac.hcf.typename = "TestBlockAckHcf"
**.hcf.isBlockAckSupported = true
*.node[0].wlan[0].mac.hcf.originatorBlockAckAgreementPolicy.blockAckTimeoutValue = ${scenario} == 8 ? 0s : (${scenario} >= 12 && ${scenario} <= 15 ? 1.024ms : 20ms)
*.node[1].wlan[0].mac.hcf.originatorBlockAckAgreementPolicy.blockAckTimeoutValue = 30ms
**.recipientBlockAckAgreementPolicy.blockAckTimeoutValue = 1s
*.node[0].wlan[0].address = "02:00:00:00:00:01"
*.node[1].wlan[0].address = "02:00:00:00:00:02"
**.wlan[*].opMode = "g(mixed)"
**.wlan[*].bitrate = 24Mbps
**.hcf.edca.edcaf[*].txopProcedure.txopLimit = 2ms
**.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
**.hcf.originatorMacDataService.mpduAggregationPolicy.typename = ""
**.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 4096B
**.radio.bandName = "2.4 GHz"
**.radio.centerFrequency = 2.4GHz
**.radio.transmitter.power = 100mW
**.radio.receiver.sensitivity = -85dBm
**.radio.receiver.snirThreshold = 4dB
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.node[0].mobility.initialX = 0m
*.node[1].mobility.initialX = 1m
**.mobility.initialY = 0m

%contains: stdout
Block Ack inactivity scenario
