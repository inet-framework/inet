%description:
Tests the receiver SWS avoidance with a receive buffer smaller than one MSS
(RFC 9293 section 3.8.6.2.2: the threshold is a fraction of RCV.BUFF). The
server has a receive buffer of 500 bytes and an MSS of 1000, and its
application reads at once. The empty buffer offers its 500 bytes, so the
client sends its 2000 bytes in segments of 500 bytes.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 10s
*.cli_app.sendScript="1.0 2000"
*.*_tcp.mss = 1000
*.srv_tcp.receiveBufferSize = 500B

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:501(500) ack 501 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 501 win 500 
[1.205 A004] A.1000 > B.2000: A 501:1001(500) ack 501 win 16384 
[1.407 B003] A.1000 < B.2000: A ack 1001 win 500 
[1.409 A005] A.1000 > B.2000: A 1001:1501(500) ack 501 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
