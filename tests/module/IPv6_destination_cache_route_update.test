%description:
Changing or deleting an IPv6 route takes effect on the next packet: the
destination cache must not keep forwarding to the next hop that the route
supplied before.

Topology: h1 -- r1 -- r2 -- h2

h1 pings h2 every 100 ms from 5 s. At 6.05 s the test module changes the
next hop of r1's route to h2 in place, to an address on the r1-r2 link that no
node holds, so no echo request reaches h2. At 7.05 s it removes every route r1
has towards h2 with removeRoute(), so r1 must answer later echo requests with
ICMPv6 Destination Unreachable. h1 must receive no echo reply after 6.05 s.
(deleteRoute() is covered by the examples/bgpv4/BgpWithdrawal6 fingerprints.)

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

simple RouteUpdater
{
    parameters:
        string routingTableModule;
        string destAddress;
        string pingAppModule;
        string newNextHop;
        double changeTime @unit(s);
        double deleteTime @unit(s);
}

network RouteUpdateTest
{
    types:
        channel ethline extends DatarateChannel {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        configurator: Ipv6NetworkConfigurator;
        routeUpdater: RouteUpdater;
        h1: StandardHost6;
        r1: Router6;
        r2: Router6;
        h2: StandardHost6;
    connections:
        h1.ethg++ <--> ethline <--> r1.ethg++;
        r1.ethg++ <--> ethline <--> r2.ethg++;
        r2.ethg++ <--> ethline <--> h2.ethg++;
}

%#--------------------------------------------------------------------------------------------------------------
%file: RouteUpdater.cc

#include "inet/networklayer/common/L3AddressResolver.h"
#include "inet/networklayer/ipv6/Ipv6RoutingTable.h"

namespace IPv6_destination_cache_route_update {

using namespace inet;

class RouteUpdater : public cSimpleModule, public cListener
{
  protected:
    simtime_t changeTime;
    simtime_t deleteTime;
    cMessage *changeTimer = nullptr;
    int repliesBeforeChange = 0;
    int repliesAfterChange = 0;
    int repliesAfterDeletion = 0;

  protected:
    virtual void initialize() override
    {
        changeTime = par("changeTime");
        deleteTime = par("deleteTime");
        getModuleByPath(par("pingAppModule"))->subscribe("pingRxSeq", this);
        changeTimer = new cMessage("changeRoute");
        scheduleAt(changeTime, changeTimer);
        scheduleAt(deleteTime, new cMessage("removeRoutes"));
    }

    virtual void handleMessage(cMessage *msg) override
    {
        auto rt = check_and_cast<Ipv6RoutingTable *>(getModuleByPath(par("routingTableModule")));
        Ipv6Address dest = L3AddressResolver().resolve(par("destAddress")).toIpv6();
        if (msg == changeTimer) {
            auto route = const_cast<Ipv6Route *>(rt->doLongestPrefixMatch(dest));
            route->setNextHop(Ipv6Address(par("newNextHop").stringValue()));
            EV_INFO << "changed route to " << route->str() << endl;
        }
        else {
            while (const Ipv6Route *route = rt->doLongestPrefixMatch(dest)) {
                EV_INFO << "removing route " << route->str() << endl;
                delete rt->removeRoute(const_cast<Ipv6Route *>(route));
            }
        }
        delete msg;
    }

    virtual void receiveSignal(cComponent *source, simsignal_t signalID, intval_t value, cObject *details) override
    {
        if (simTime() < changeTime)
            repliesBeforeChange++;
        else if (simTime() < deleteTime)
            repliesAfterChange++;
        else
            repliesAfterDeletion++;
    }

    virtual void finish() override
    {
        EV_INFO << "echo replies before route change: " << repliesBeforeChange << endl;
        EV_INFO << "echo replies after route change: " << repliesAfterChange << endl;
        EV_INFO << "echo replies after route deletion: " << repliesAfterDeletion << endl;
    }
};

Define_Module(RouteUpdater);

} // namespace IPv6_destination_cache_route_update

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini

[General]
network = RouteUpdateTest
ned-path = .;../../../../src
sim-time-limit = 8s
record-vector-results = false
cmdenv-express-mode = false

**.ipv6.configurator.networkConfiguratorModule = "configurator"

*.h1.numApps = 1
*.h1.app[0].typename = "PingApp"
*.h1.app[0].destAddr = "h2(ipv6)"
*.h1.app[0].startTime = 5s
*.h1.app[0].sendInterval = 0.1s

*.routeUpdater.routingTableModule = "^.r1.ipv6.routingTable"
*.routeUpdater.destAddress = "h2(ipv6)"
*.routeUpdater.pingAppModule = "^.h1.app[0]"
*.routeUpdater.newNextHop = "fe80::99"
*.routeUpdater.changeTime = 6.05s
*.routeUpdater.deleteTime = 7.05s

*.routeUpdater.cmdenv-log-level = info
*.r1.ipv6.ipv6.cmdenv-log-level = info
**.cmdenv-log-level = off

%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
echo replies before route change: 11
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
echo replies after route change: 0
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
echo replies after route deletion: 0
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
unroutable, sending ICMPv6_DESTINATION_UNREACHABLE
%#--------------------------------------------------------------------------------------------------------------
