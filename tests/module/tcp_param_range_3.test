%description:
Tests the range check of the Tcp parameters: dupthresh = 0 stops the
simulation with an error at the open, because 0 and negative values give
contradictory loss detection.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 20000"
*.cli_tcp.dupthresh = 0

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%exitcode: 1
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "<!>" test.* > test_err.out || true
%contains: test_err.out
dupthresh must be 1 or more, but it is 0
%#--------------------------------------------------------------------------------------------------------------
