%description:
Tests syncookiesAlways, which models Linux tcp_syncookies=2: the SYN cookie
of the server quantizes the MSS of the client down to the IPv4 msstab
{536, 1300, 1440, 1460}. Both sides announce MSS 1024, so the server sends
with MSS 536: its 1000 bytes go out as 536 and 464 bytes. Without the
parameter, they go out in one segment.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

*.srv_tcp.syncookiesAlways = true
*.srv_app.sendScript="1.0 1000"

include ../../lib/defaults.ini

%contains: stdout
[1.001 B002] A.1000 < B.2000: A 501:1037(536) ack 1 win 16384

%contains: stdout
[1.205 B003] A.1000 < B.2000: A 1037:1501(464) ack 1 win 16384

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
