%description:
Tests the ECT of the RST of an abort with abortRstWithAck on a DCTCP
connection: the RST carries the ACK bit, and it is ECT(0), as the RST without
the ACK bit (RFC 8257 section 3.6, as Linux for DCTCP).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 100"
*.cli_app.tAbort=2s
*.cli_tcp.abortRstWithAck = true
*.*_tcp.tcpAlgorithmClass = "DcTcp"
*.*_tcp.tcpEcnMode = "rfc3168"
*.*_tcp.timestampSupport = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[2.001 A004] A.1000 > B.2000: A R ack 501 win 0 ECT(0)   Option(s): NOP NOP TS(2000,1202)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
