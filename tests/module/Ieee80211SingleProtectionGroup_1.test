%description:
Check final group management and non-QoS DATA through production HCF.
Require zero Duration/ID and no current-frame ACK-mode query.
Run each frame type with Block Ack support enabled and disabled.
Check the legacy arithmetic with a successor separately from production group transmission.

%extraargs: -r 0..3
%file: Group.cc
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/rateselection/QosRateSelection.h"
#include "inet/linklayer/ieee80211/mac/protectionmechanism/SingleProtectionMechanism.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
namespace inet::ieee80211 {
class GroupRateSelection : public IQosRateSelection {
  public:
    IQosRateSelection *delegate = nullptr;
    int ackQueries = 0;
    int currentAckQueries = 0;
    int successorAckQueries = 0;
    const physicallayer::IIeee80211Mode *computeResponseAckFrameMode(Packet *packet, const Ptr<const Ieee80211DataOrMgmtHeader>& header) override {
        ackQueries++;
        if (header->getReceiverAddress().isMulticast()) currentAckQueries++;
        else successorAckQueries++;
        return delegate->computeResponseAckFrameMode(packet, header);
    }
    const physicallayer::IIeee80211Mode *computeMode(Packet *packet, const Ptr<const Ieee80211MacHeader>& header, TxopProcedure *txop) override { return delegate->computeMode(packet, header, txop); }
    const physicallayer::IIeee80211Mode *computeResponseCtsFrameMode(Packet *packet, const Ptr<const Ieee80211RtsFrame>& header) override { return delegate->computeResponseCtsFrameMode(packet, header); }
    const physicallayer::IIeee80211Mode *computeResponseBlockAckFrameMode(Packet *packet, const Ptr<const Ieee80211BlockAckReq>& header) override { return delegate->computeResponseBlockAckFrameMode(packet, header); }
};
class GroupMechanism : public SingleProtectionMechanism {
  public:
    void configure(physicallayer::Ieee80211ModeSet *modes, IQosRateSelection *selection) { modeSet = modes; rateSelection = selection; }
};
class GroupMac : public Ieee80211Mac {
  public:
    int rts = 0;
    int data = 0;
    int responses = 0;
    void sendDownFrame(Packet *packet) override {
        auto header = packet->peekAtFront<Ieee80211MacHeader>();
        data++;
        ASSERT(header->getReceiverAddress().isMulticast());
        ASSERT(header->getDurationField() == SIMTIME_ZERO);
        Ieee80211Mac::sendDownFrame(packet);
    }
};
Define_Module(GroupMac);
class GroupHcf : public Hcf {
  public:
    int timeouts = 0;
    int finishes = 0;
    GroupRateSelection tracedSelection;
    GroupMechanism tracedMechanism;
    void scheduleStartRxTimer(simtime_t timeout) override { timeouts++; Hcf::scheduleStartRxTimer(timeout); }
    void frameSequenceFinished() override { ASSERT(tracedSelection.ackQueries == 0); finishes++; Hcf::frameSequenceFinished(); }
    void inject() {
        Enter_Method("inject");
        tracedSelection.delegate = rateSelection;
        rateSelection = &tracedSelection;
        tracedMechanism.configure(modeSet, &tracedSelection);
        singleProtectionMechanism = &tracedMechanism;
        Ptr<Ieee80211DataOrMgmtHeader> header;
        if (par("management").boolValue()) {
            auto management = makeShared<Ieee80211MgmtHeader>();
            management->setType(ST_AUTHENTICATION);
            header = management;
        }
        else
            header = makeShared<Ieee80211DataHeader>();
        header->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
        header->setTransmitterAddress(mac->getAddress());
        header->setAddress3(mac->getAddress());
        Packet current("group-arithmetic", header);
        current.insertAtBack(makeShared<ByteCountChunk>(B(26)));
        current.insertAtBack(makeShared<Ieee80211MacTrailer>());
        auto successorHeader = makeShared<Ieee80211DataHeader>();
        successorHeader->setType(ST_DATA_WITH_QOS);
        successorHeader->addChunkLength(QOSCONTROL_PART_LENGTH);
        successorHeader->setTid(5);
        successorHeader->setAckPolicy(NORMAL_ACK);
        successorHeader->setReceiverAddress(MacAddress("02:00:00:00:00:02"));
        successorHeader->setTransmitterAddress(mac->getAddress());
        successorHeader->setAddress3(mac->getAddress());
        Packet successor("successor-arithmetic", successorHeader);
        successor.insertAtBack(makeShared<ByteCountChunk>(B(26)));
        successor.insertAtBack(makeShared<Ieee80211MacTrailer>());
        auto txop = edca->getEdcaf(AC_BE)->getTxopProcedure();
        auto duration = singleProtectionMechanism->computeDurationField(&current, header, &successor, successorHeader, txop, recipientAckPolicy);
        // Only the successor contributes DATA (100 us), ACK (44 us), and two SIFS intervals (32 us).
        ASSERT(duration == SimTime(176, SIMTIME_US));
        auto selection = &tracedSelection;
        ASSERT(selection->currentAckQueries == 0 && selection->successorAckQueries == 1);
        ASSERT(selection->ackQueries == 1);
        selection->ackQueries = 0;
        auto packet = new Packet("policy-selection", header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(26)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
    }
};
Define_Module(GroupHcf);
class GroupTest : public cSimpleModule {
  public:
    GroupTest() : cSimpleModule(65536) {}
  protected:
    void activity() override {
        wait(SimTime(1, SIMTIME_MS));
        auto sender = check_and_cast<GroupMac *>(getModuleByPath("^.sender.wlan[0].mac"));
        check_and_cast<GroupHcf *>(sender->getSubmodule("hcf"))->inject();
        wait(SimTime(500, SIMTIME_US));
        ASSERT(sender->data == 1);
        auto hcf = check_and_cast<GroupHcf *>(sender->getSubmodule("hcf"));
        ASSERT(hcf->finishes == 1);
        ASSERT(hcf->timeouts == 0);
        std::cout << "Single protection group assertions passed.\n";
        endSimulation();
    }
};
Define_Module(GroupTest);
}
%file: test.ned
import inet.linklayer.ieee80211.mac.Ieee80211Mac;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
module GroupMac extends Ieee80211Mac { parameters: @class(::inet::ieee80211::GroupMac); }
module GroupHcf extends Hcf { parameters: bool management; @class(::inet::ieee80211::GroupHcf); }
simple GroupTest { parameters: @class(::inet::ieee80211::GroupTest); }
network GroupNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        sender: WirelessHost;
        test: GroupTest;
}
%inifile: omnetpp.ini
[General]
network = GroupNetwork
ned-path = .;../../../../src;../../lib
sim-time-limit = 2ms
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
**.wlan[*].mac.hcf.management = ${management=false,true}
*.radioMedium.propagation.typename = "ConstantTimePropagation"
*.radioMedium.propagation.propagationTime = 0s
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 6Mbps
**.wlan[*].mac.typename = "GroupMac"
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "GroupHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = ${blockAck=false,true}
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.originatorMacDataService.mpduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.rtsPolicy.rtsThreshold = 4096B
**.wlan[*].mac.hcf.rateSelection.dataFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rateSelection.controlFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rateSelection.responseAckFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rateSelection.responseCtsFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.edca.edcaf[*].cwMin = 0
**.wlan[*].mac.hcf.edca.edcaf[*].cwMax = 0
**.wlan[*].mac.hcf.edca.edcaf[*].txopProcedure.protectionMechanism = "single"
*.sender.wlan[0].address = "02:00:00:00:00:01"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.sender.mobility.initialX = 0m
*.sender.mobility.initialY = 0m
%contains: stdout
Single protection group assertions passed.
