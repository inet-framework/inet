%description:
Tests the range check of the Tcp parameters: baseMss = 0 with mtuProbing = 2
stops the simulation with an error at the open, because a smaller base MSS
leaves no room for the options.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 20000"
*.cli_tcp.mtuProbing = 2
*.cli_tcp.baseMss = 0

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%exitcode: 1
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "<!>" test.* > test_err.out || true
%contains: test_err.out
baseMss must be at least 88, but it is 0
%#--------------------------------------------------------------------------------------------------------------
