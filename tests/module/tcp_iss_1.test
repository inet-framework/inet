%description:
Tests initialSendSequenceNumber, a fixed initial send sequence number. The
client starts at 1000000 and the server at 4294967000, close to the end of the
32-bit sequence space. The SYN and the SYN-ACK carry these numbers, and the
first data segment of the server (B004, 4294967001:729) crosses the wrap of the
sequence space; the client acknowledges it with 729.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 2000"
*.srv_app.sendScript="2.0 2000"
*.cli_tcp.initialSendSequenceNumber = 1000000
*.srv_tcp.initialSendSequenceNumber = 4294967000

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.001 A001] A.1000 > B.2000: S 1000000:1000000(0) win 16384   Option(s): MaxSegSize
srv_tcp: LISTEN --> SYN_RCVD  (on RCV_SYN)
[0.003 B001] A.1000 < B.2000: A S 4294967000:4294967000(0) ack 1000001 win 16384   Option(s): MaxSegSize
cli_tcp: SYN_SENT --> ESTABLISHED  (on RCV_SYN_ACK)
[0.005 A002] A.1000 > B.2000: A ack 4294967001 win 16384 
srv_tcp: SYN_RCVD --> ESTABLISHED  (on RCV_ACK)
[1.001 A003] A.1000 > B.2000: A 1000001:1001025(1024) ack 4294967001 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 1001025 win 16384 
[1.205 A004] A.1000 > B.2000: A 1001025:1002001(976) ack 4294967001 win 16384 
[1.407 B003] A.1000 < B.2000: A ack 1002001 win 16384 
[2.001 B004] A.1000 < B.2000: A 4294967001:729(1024) ack 1002001 win 16384 
[2.203 A005] A.1000 > B.2000: A ack 729 win 16384 
[2.205 B005] A.1000 < B.2000: A 729:1705(976) ack 1002001 win 16384 
[2.407 A006] A.1000 > B.2000: A ack 1705 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
