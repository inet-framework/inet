%description:
Tests the start MSS of an active opener with the path MTU search (mtuProbing =
2). Both ends have an MSS of 1460, and the client has a base MSS of 512. As
Linux tcp_connect_init(), which arms the search before tcp_sync_mss(), the
client starts at the base MSS, so its segments carry 512 bytes. Its route MTU
is the MTU of the negotiated MSS (1500), so the search runs from 552 to 1500:
the probe of 986 bytes (A022, MTU 1026) raises the MSS to 986, and the next
probe raises it to 1223. A passive connection keeps its MSS (tcp_mtu_probe_1).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 40000"
*.*_tcp.mss = 1460
*.*_tcp.delayedAcksEnabled = false
*.cli_tcp.mtuProbing = 2
*.cli_tcp.baseMss = 512

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.017 A021] A.1000 > B.2000: A 9217:9729(512) ack 501 win 16384 
[1.017 A022] A.1000 > B.2000: A 9729:10715(986) ack 501 win 16384 
[1.017 A023] A.1000 > B.2000: A 10715:11227(512) ack 501 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
RFC 4821: an active opener starts at the base MSS, SMSS is 512
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
RFC 4821: the MTU probe of 1026 is acknowledged, snd_mss is 986
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
RFC 4821: the MTU probe of 1263 is acknowledged, snd_mss is 1223
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
