%description:

Radio with allowConcurrentReceptions on a dimensional medium, receiving
concurrent signals on disjoint bands: the case of a base station receiving
several users on different parts of its band. Three senders start one signal
each in the same event, all at the same distance from the receiver: senderA1
and senderA2 on band A, senderB on band B, both bands inside the receiver's
listening band. The receiver's receiver takes any signal within its listening
band and attempts every one, so all three receptions are attempted at once and
sent up. Interference stays within its band: the two band-A signals collide
and both have bit errors, while the band-B signal, overlapping them in time,
is decoded.

%file: test.cc

#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/physicallayer/wireless/apsk/packetlevel/ApskReceiver.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/INarrowbandSignalAnalogModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadio.h"
#include "inet/physicallayer/wireless/common/radio/packetlevel/BandListening.h"

using namespace inet;
using namespace inet::physicallayer;

namespace ConcurrentRadio_4 {

// Takes any signal whose band lies within its listening band, not only one
// centered on it, and attempts every such reception, whatever else is in
// progress: the policy of a receiver that decodes concurrent signals on
// disjoint parts of its band.
class BandReceiver : public ApskReceiver
{
  protected:
    static bool isWithinBand(Hz centerFrequency, Hz bandwidth, const INarrowbandSignalAnalogModel *signal)
    {
        return centerFrequency - bandwidth / 2 <= signal->getCenterFrequency() - signal->getBandwidth() / 2 &&
               signal->getCenterFrequency() + signal->getBandwidth() / 2 <= centerFrequency + bandwidth / 2;
    }

  public:
    virtual bool computeIsReceptionPossible(const IListening *listening, const ITransmission *transmission) const override
    {
        return isWithinBand(getCenterFrequency(), getBandwidth(), check_and_cast<const INarrowbandSignalAnalogModel *>(transmission->getAnalogModel()));
    }
    virtual bool computeIsReceptionPossible(const IListening *listening, const IReception *reception, IRadioSignal::SignalPart part) const override
    {
        auto bandListening = check_and_cast<const BandListening *>(listening);
        auto signal = check_and_cast<const INarrowbandSignalAnalogModel *>(reception->getAnalogModel());
        if (!isWithinBand(bandListening->getCenterFrequency(), bandListening->getBandwidth(), signal))
            return false;
        // the sensitivity check of the analog model, over the signal's own band
        BandListening signalListening(listening->getReceiverRadio(), listening->getStartTime(), listening->getEndTime(), listening->getStartPosition(), listening->getEndPosition(), signal->getCenterFrequency(), signal->getBandwidth());
        return getAnalogModel()->computeIsReceptionPossible(&signalListening, reception, sensitivity);
    }
    virtual bool computeIsReceptionAttempted(const IListening *listening, const IReception *reception, IRadioSignal::SignalPart part, const IInterference *interference) const override
    {
        return computeIsReceptionPossible(listening, reception, part);
    }
};

Define_Module(BandReceiver);

// Hands one packet, named after its node, to the radio at the start.
class TestSource : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(0, new cMessage("start")); }
    virtual void handleMessage(cMessage *msg) override
    {
        auto packet = new Packet(getParentModule()->getName(), makeShared<ByteCountChunk>(B(100)));
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::apskPhy);
        send(packet, "out");
        delete msg;
    }
};

Define_Module(TestSource);

// Switches its radio to receiver mode at the start, then reports what the
// radio sends up, with or without bit errors. (A radio configured to start in
// receiver mode listens on the medium before it has registered with it.)
class TestSink : public cSimpleModule
{
  protected:
    int received = 0;
    virtual void initialize() override { scheduleAt(0, new cMessage("switchToReceiver")); }
    virtual void handleMessage(cMessage *msg) override
    {
        if (msg->isSelfMessage()) {
            delete msg;
            check_and_cast<IRadio *>(getParentModule()->getSubmodule("radio"))->setRadioMode(IRadio::RADIO_MODE_RECEIVER);
            return;
        }
        auto packet = check_and_cast<Packet *>(msg);
        received++;
        std::cout << "sink: received " << packet->getName() << (packet->hasBitError() ? " with" : " without") << " bit errors at " << simTime() << std::endl;
        delete packet;
    }
    virtual void finish() override { std::cout << "sink: received " << received << " packets" << std::endl; }
};

Define_Module(TestSink);

} // namespace ConcurrentRadio_4

%file: test.ned

import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.apsk.packetlevel.ApskDimensionalRadio;
import inet.physicallayer.wireless.apsk.packetlevel.ApskReceiver;
import inet.physicallayer.wireless.common.medium.DimensionalRadioMedium;

module BandReceiver extends ApskReceiver
{
    @class(BandReceiver);
}

simple TestSource
{
    @class(TestSource);
    gates:
        output out;
}

simple TestSink
{
    @class(TestSink);
    gates:
        input in;
}

module SenderNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
        source: TestSource;
    connections allowunconnected:
        source.out --> radio.upperLayerIn;
}

module ReceiverNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
        sink: TestSink;
    connections allowunconnected:
        radio.upperLayerOut --> sink.in;
}

network Test
{
    submodules:
        radioMedium: DimensionalRadioMedium;
        senderA1: SenderNode;
        senderA2: SenderNode;
        senderB: SenderNode;
        receiver: ReceiverNode;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 10ms
ned-path = .;../../../../src
cmdenv-express-mode = false

# every sender 100m from the receiver
*.senderA1.mobility.initialX = 400m
*.senderA2.mobility.initialX = 500m
*.senderA2.mobility.initialY = 400m
*.senderB.mobility.initialX = 600m
*.receiver.mobility.initialX = 500m
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m

*.radioMedium.backgroundNoise.powerSpectralDensity = -120dBmWpMHz
*.radioMedium.sameTransmissionStartTimeCheck = "ignore"

# band A: 2394-2396 MHz, band B: 2404-2406 MHz, the receiver listens on 2390-2410 MHz
*.senderA*.radio.centerFrequency = 2.395GHz
*.senderB.radio.centerFrequency = 2.405GHz
*.sender*.radio.bandwidth = 2MHz
*.receiver.radio.centerFrequency = 2.4GHz
*.receiver.radio.bandwidth = 20MHz

**.radio.antenna.mobilityModule = "^.^.mobility"
**.radio.transmitter.bitrate = 2Mbps
**.radio.transmitter.preambleDuration = 0s
**.radio.transmitter.headerLength = 96b
**.radio.transmitter.power = 100mW
**.radio.receiver.energyDetection = -90dBm
**.radio.receiver.sensitivity = -80dBm
**.radio.receiver.snirThreshold = 10dB
*.sender*.radio.initialRadioMode = "transmitter"
*.receiver.radio.receiver.typename = "BandReceiver"
*.receiver.radio.allowConcurrentReceptions = true

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
sink: received senderA1 with bit errors at 0.000448
%contains: stdout
sink: received senderA2 with bit errors at 0.000448
%contains: stdout
sink: received senderB without bit errors at 0.000448
%contains: stdout
sink: received 3 packets
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
