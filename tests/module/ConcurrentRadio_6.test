%description:

Radio with allowConcurrentReceptions and separateReceptionParts: the received
signal part is the part of the only attempted reception in progress. The far
sender's signal A starts first; the near sender's signal B, about 30 dB
stronger on the same band, starts while A is in its data part. At 120 us both
are attempted, so there is no single received part and its getter throws an
error. A ends at about 139 us, during B's header (about 110 to 158 us): at
148 us B is the reception in progress and the part is its header, not the
data part of the reception that has ended.

%file: test.cc

#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/physicallayer/wireless/apsk/packetlevel/ApskReceiver.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadio.h"

using namespace inet;
using namespace inet::physicallayer;

namespace ConcurrentRadio_6 {

// Attempts every reception it could receive, whatever else is in progress:
// the policy a receiver that decodes concurrent transmissions would have.
class AttemptingReceiver : public ApskReceiver
{
  public:
    virtual bool computeIsReceptionAttempted(const IListening *listening, const IReception *reception, IRadioSignal::SignalPart part, const IInterference *interference) const override
    {
        return computeIsReceptionPossible(listening, reception, part);
    }
};

Define_Module(AttemptingReceiver);

// Hands one packet of the given length to the radio at the given time.
class TestSource : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(par("startTime"), new cMessage("start")); }
    virtual void handleMessage(cMessage *msg) override
    {
        auto packet = new Packet(getParentModule()->getName(), makeShared<ByteCountChunk>(B(par("length").intValue())));
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::apskPhy);
        send(packet, "out");
        delete msg;
    }
};

Define_Module(TestSource);

// Switches its radio to receiver mode at the start, and reports the reception
// state, the received signal part and the reception it belongs to at two
// probe times.
class TestSink : public cSimpleModule
{
  protected:
    virtual void initialize() override
    {
        scheduleAt(0, new cMessage("switchToReceiver"));
        scheduleAt(SimTime(120, SIMTIME_US), new cMessage("probe"));
        scheduleAt(SimTime(148, SIMTIME_US), new cMessage("probe"));
    }
    virtual void handleMessage(cMessage *msg) override
    {
        if (msg->isSelfMessage()) {
            auto radio = check_and_cast<IRadio *>(getParentModule()->getSubmodule("radio"));
            if (!strcmp(msg->getName(), "probe")) {
                std::cout << "sink: at " << simTime().inUnit(SIMTIME_US) << "us reception state " << IRadio::getRadioReceptionStateName(radio->getReceptionState());
                try {
                    auto part = radio->getReceivedSignalPart();
                    std::cout << ", received part " << IRadioSignal::getSignalPartName(part) << " of " << radio->getReceptionInProgress()->getPacket()->getName() << std::endl;
                }
                catch (cRuntimeError& e) {
                    std::cout << ", error: " << e.what() << std::endl;
                }
            }
            else
                radio->setRadioMode(IRadio::RADIO_MODE_RECEIVER);
        }
        delete msg;
    }
};

Define_Module(TestSink);

} // namespace ConcurrentRadio_6

%file: test.ned

import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.apsk.packetlevel.ApskDimensionalRadio;
import inet.physicallayer.wireless.apsk.packetlevel.ApskReceiver;
import inet.physicallayer.wireless.common.medium.DimensionalRadioMedium;

module AttemptingReceiver extends ApskReceiver
{
    @class(AttemptingReceiver);
}

simple TestSource
{
    @class(TestSource);
    double startTime @unit(s);
    int length @unit(B);
    gates:
        output out;
}

simple TestSink
{
    @class(TestSink);
    gates:
        input in;
}

module SenderNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
        source: TestSource;
    connections allowunconnected:
        source.out --> radio.upperLayerIn;
}

module ReceiverNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
        sink: TestSink;
    connections allowunconnected:
        radio.upperLayerOut --> sink.in;
}

network Test
{
    submodules:
        radioMedium: DimensionalRadioMedium;
        far: SenderNode;
        near: SenderNode;
        receiver: ReceiverNode;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 10ms
ned-path = .;../../../../src
cmdenv-express-mode = false

**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
*.far.mobility.initialX = 200m
*.near.mobility.initialX = 490m
*.receiver.mobility.initialX = 500m

*.radioMedium.backgroundNoise.power = -110dBm

**.radio.antenna.mobilityModule = "^.^.mobility"
**.radio.centerFrequency = 2.4GHz
**.radio.bandwidth = 2MHz
**.radio.transmitter.bitrate = 2Mbps
**.radio.transmitter.preambleDuration = 10us
**.radio.transmitter.headerLength = 96b
**.radio.transmitter.power = 100mW
**.radio.receiver.energyDetection = -90dBm
**.radio.receiver.sensitivity = -80dBm
**.radio.receiver.snirThreshold = 10dB
*.far.radio.initialRadioMode = "transmitter"
*.near.radio.initialRadioMode = "transmitter"
*.far.source.startTime = 0s
*.far.source.length = 20B
*.near.source.startTime = 100us
*.near.source.length = 100B
*.receiver.radio.receiver.typename = "AttemptingReceiver"
*.receiver.radio.allowConcurrentReceptions = true
*.receiver.radio.separateReceptionParts = true

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
sink: at 120us reception state RECEIVING, error: getReceivedSignalPart(): 2 receptions are in progress, each in its own signal part
%contains: stdout
sink: at 148us reception state RECEIVING, received part HEADER of near
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
