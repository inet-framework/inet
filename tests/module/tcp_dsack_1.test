%description:
The receiver reports every duplicate segment by a D-SACK block (RFC 2883),
also one that ends exactly at rcv_nxt, and a duplicate FIN (its sequence
number counts in the segment length). The tester drops the ACK of the only
data segment, so the timeout at t=4 retransmits data that the receiver
already has; the ACK reports it as SACK[1,1001). Then it drops the ACK of the
FIN, and the retransmitted FIN gets SACK[1001,1002). Before, a duplicate had
to end below rcv_nxt, so neither ACK carried a D-SACK.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

*.cli_app.sendScript="1.0 1000"
*.cli_app.tClose=5s
*.tcptester.script="b2 delete; b4 delete"  # the ACK of the data, the ACK of the FIN

*.*_tcp.sackSupport = true
*.*_tcp.delayedAcksEnabled = false

include ../../lib/defaults.ini

%contains: stdout
[4.001 A004] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384
[4.003 B003] A.1000 < B.2000: A ack 1001 win 16384   Option(s): NOP NOP SACK[1,1001)

%contains: stdout
[11.001 A006] A.1000 > B.2000: A F ack 501 win 16384
[11.003 B005] A.1000 < B.2000: A ack 1002 win 16384   Option(s): NOP NOP SACK[1001,1002)

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
