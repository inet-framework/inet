%description:
Tests MSG_EOR (the tag TcpSendEorReq) with TCP_CORK. The client corks and writes
300 bytes with MSG_EOR, which the cork holds. The second write of 300 bytes at
t=1.1 sends the first record at once, because a record cannot become larger (as
Linux tcp_write_xmit(), which corks only the last skb). The cork holds the second
record until the uncork at t=1.5. No segment spans the record boundary at 301.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.corkScript="0.5 1; 1.5 0"
*.cli_app.sendScript="1.0 300 eor; 1.1 300"
*.*_tcp.mss = 1000

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.101 A003] A.1000 > B.2000: A 1:301(300) ack 501 win 16384 
[1.303 B002] A.1000 < B.2000: A ack 301 win 16384 
[1.501 A004] A.1000 > B.2000: A P 301:601(300) ack 501 win 16384 
[1.703 B003] A.1000 < B.2000: A ack 601 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
MSG_EOR: record boundary at sequence number 301
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
