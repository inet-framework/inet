%description:
Tests that adaptiveDelayedAcks=true sends no ACK at once for a segment beyond
the offered window, as Linux (rcv_neg_window). As in tcp_rcvbuf_accept_1, the
server accepts the whole segment beyond its window
(acceptBeyondBufferAtEmptyQueue), but its ACK waits for the ATO (40 ms), not
for the quickack mode of the first data.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 1.044s # stop before the ACKs of the bytes that the tester added
*.cli_app.sendScript="1.0 1000"
*.*_tcp.mss = 1000
*.srv_tcp.adaptiveDelayedAcks = true
*.srv_tcp.advertisedWindow = 2000
*.srv_tcp.acceptBeyondBufferAtEmptyQueue = true
*.srv_app.autoRead=false
*.srv_app.readScript="3 10000"
*.tcptester.script="a3 data 3000"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:4001(4000) ack 501 win 16384 # adding data
[1.043 B002] A.1000 < B.2000: A ack 4001 win 0 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
