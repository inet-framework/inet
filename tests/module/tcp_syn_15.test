%description:
Test connection setup: simultaneous active open by A and B, and a copy of A's
SYN reaches B in SYN_RCVD. B answers it with a plain ACK, as Linux does for
a socket in SYN_RECV after a simultaneous open. Only a passive open re-sends
its SYN-ACK for a repeated SYN (Linux tcp_check_req()).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

#cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

####cmdenv-log-format=""
cmdenv-log-prefix="[%c]: "
#*.tcptester.cmdenv-ev-output=true
#**.cmdenv-ev-output=false

*.cli_app.active=true
*.srv_app.active=true

*.cli_app.tOpen=0s
*.srv_app.tOpen=0s

*.cli_app.tSend=1s
*.cli_app.sendBytes=100B
*.srv_app.tSend=1s
*.srv_app.sendBytes=100B

*.tcptester.script="a1 copy 0,0.001"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "^\[testing\]" test.out > test_1.out || true
%contains: test_1.out
[testing]: [0.002 A001] A.1000 > B.2000: S 0:0(0) win 16384   Option(s): MaxSegSize# introducing copy
[testing]: cli_tcp: SYN_SENT --> SYN_RCVD  (on RCV_SYN)
[testing]: [0.003 B002] A.1000 < B.2000: A S 0:0(0) ack 1 win 16384   Option(s): MaxSegSize
[testing]: [0.003 A002] A.1000 > B.2000: A S 0:0(0) ack 1 win 16384   Option(s): MaxSegSize
[testing]: cli_tcp: SYN_RCVD --> ESTABLISHED  (on RCV_ACK)
[testing]: [0.004 B003] A.1000 < B.2000: A ack 1 win 16384
[testing]: srv_tcp: SYN_RCVD --> ESTABLISHED  (on RCV_ACK)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
