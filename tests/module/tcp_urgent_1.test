%description:
Tests the urgent send (RFC 9293 section 3.8.5). The client (Tcp) sends 1000
bytes at t=1, 3000 bytes of urgent data at t=1.1 (TcpSocket::sendUrgent(), the
flag "urgent" of the send script), and 1000 bytes at t=1.5. The urgent data
needs three segments (MUST-31), and each carries URG and the urgent pointer,
the offset of the octet after the urgent data, sequence number 4001, from its
own sequence number (MUST-62): 3000, 1552 and 104. The last urgent segment is
smaller than the MSS and goes while data is in flight, because Nagle holds no
urgent data (Linux tcp_nagle_test()). After the ACK of the urgent data, the
next segment carries no URG.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=true

*.tcptester.script=""

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1.0 1000; 1.1 3000 urgent; 1.5 1000"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

sim-time-limit = 3s

%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.101 A004] A.1000 > B.2000: U A 1001:2449(1448) ack 501 win 65535 urg 3000   Option(s): NOP NOP TS(1100,2)
[1.101 A005] A.1000 > B.2000: U A 2449:3897(1448) ack 501 win 65535 urg 1552   Option(s): NOP NOP TS(1100,2)
[1.101 A006] A.1000 > B.2000: U A P 3897:4001(104) ack 501 win 65535 urg 104   Option(s): NOP NOP TS(1100,2)
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.501 A007] A.1000 > B.2000: A P 4001:5001(1000) ack 501 win 65535   Option(s): NOP NOP TS(1500,1302)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
