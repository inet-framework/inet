%description:

A reconfiguration of the receiving radio during an attempted reception
abandons it, and says so: halfway through the only signal, the receiver's
radio is given its bandwidth again (any reconfiguration invalidates the
attempt), which logs "Reception abandoned"; the signal keeps arriving, is
ignored when it ends, and nothing is sent up.

%file: test.cc

#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/physicallayer/wireless/common/base/packetlevel/NarrowbandRadioBase.h"

using namespace inet;
using namespace inet::physicallayer;

namespace Radio_AbandonedReception {

// Hands one packet to the radio at the start.
class TestSource : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(0, new cMessage("start")); }
    virtual void handleMessage(cMessage *msg) override
    {
        delete msg;
        auto packet = new Packet("data", makeShared<ByteCountChunk>(B(100)));
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::apskPhy);
        send(packet, "out");
    }
};

Define_Module(TestSource);

// Switches its radio to receiver mode at the start, reconfigures it halfway
// through the signal, and counts what the radio sends up. (A radio
// configured to start in receiver mode listens on the medium before it has
// registered with it.)
class TestSink : public cSimpleModule
{
  protected:
    int received = 0;
    virtual void initialize() override
    {
        scheduleAt(0, new cMessage("switchToReceiver"));
        scheduleAt(SimTime(200, SIMTIME_US), new cMessage("reconfigure"));
    }
    virtual void handleMessage(cMessage *msg) override
    {
        if (msg->isSelfMessage()) {
            auto radio = check_and_cast<NarrowbandRadioBase *>(getParentModule()->getSubmodule("radio"));
            if (!strcmp(msg->getName(), "reconfigure"))
                radio->setBandwidth(MHz(2));
            else
                radio->setRadioMode(IRadio::RADIO_MODE_RECEIVER);
            delete msg;
            return;
        }
        received++;
        delete msg;
    }
    virtual void finish() override { std::cout << "sink: received " << received << " packets" << std::endl; }
};

Define_Module(TestSink);

} // namespace Radio_AbandonedReception

%file: test.ned

import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.apsk.packetlevel.ApskDimensionalRadio;
import inet.physicallayer.wireless.common.medium.DimensionalRadioMedium;

simple TestSource
{
    @class(TestSource);
    gates:
        output out;
}

simple TestSink
{
    @class(TestSink);
    gates:
        input in;
}

module SenderNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
        source: TestSource;
    connections allowunconnected:
        source.out --> radio.upperLayerIn;
}

module ReceiverNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
        sink: TestSink;
    connections allowunconnected:
        radio.upperLayerOut --> sink.in;
}

network Test
{
    submodules:
        radioMedium: DimensionalRadioMedium;
        sender: SenderNode;
        receiver: ReceiverNode;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 10ms
ned-path = .;../../../../src
cmdenv-express-mode = false

**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
*.sender.mobility.initialX = 400m
*.receiver.mobility.initialX = 500m

*.radioMedium.backgroundNoise.power = -110dBm

**.radio.antenna.mobilityModule = "^.^.mobility"
**.radio.centerFrequency = 2.4GHz
**.radio.bandwidth = 2MHz
**.radio.transmitter.bitrate = 2Mbps
**.radio.transmitter.preambleDuration = 0s
**.radio.transmitter.headerLength = 96b
**.radio.transmitter.power = 100mW
**.radio.receiver.energyDetection = -90dBm
**.radio.receiver.sensitivity = -80dBm
**.radio.receiver.snirThreshold = 10dB
*.sender.radio.initialRadioMode = "transmitter"

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Reception started: attempting
%contains: stdout
Reception abandoned: for
%contains: stdout
Reception ended: ignoring
%contains: stdout
sink: received 0 packets
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
