%description:
Tests the learning of the reordering degree (Linux tcp_check_sack_reordering(),
RFC 8985 step 3) with RACK. The tester delays the first segment of two bursts
by 0.3 ms. In the burst at t=2, two later segments are SACKed before it
arrives: RACK waits the reordering window, the delayed segment is
acknowledged, and the sender learns that the path reorders. In the burst at
t=3, four later segments are SACKed first. Because reordering was seen, RACK
keeps its reordering window of 0.5 ms, and no retransmission goes out; the
SACK of the fourth segment raises the reordering degree to 5. Without the
learning (adaptiveReorderingEnabled = false), RACK sets the window to 0 once
DupThresh segments are SACKed, and it retransmits the delayed segment
spuriously at t=3.004.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="A4 delay 0.0003; A7 delay 0.0003"  # the first segment of each burst arrives 0.3 ms late

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 500;2 1500;3 2500"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.lossDetectionMode = "rack"
*.*_tcp.adaptiveReorderingEnabled = true
*.*_tcp.increasedIWEnabled = true



%# four later segments are SACKed, then the delayed one arrives...
%contains: stdout
[3.003 B009] A.1000 < B.2000: A ack 2001 win 5000   Option(s): NOP NOP SACK[2501,4501)
%contains: stdout
[3.003 B010] A.1000 < B.2000: A ack 4501 win 5000
%contains: stdout
reordering degree updated to 5

%# ...and nothing is retransmitted
%not-contains: stdout
RACK: marked
%contains: stdout
[3.005] tcpdump finished, A:11 B:10 segments
