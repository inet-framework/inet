%description:
Tests delayedAckFrameCount and delayedAckTimeout. The server sends a delayed
ACK at once when three full-sized segments wait for it (two by default), and
else after 100 ms (200 ms by default). The client sends three full-sized
segments at once, which the server acknowledges at once, and then 100 bytes,
which the server acknowledges after 100 ms.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 3072; 2.0 100"
*.cli_tcp.increasedIWEnabled = true # three full-sized segments at once
*.srv_tcp.delayedAckTimeout = 100ms
*.srv_tcp.delayedAckFrameCount = 3

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1025(1024) ack 501 win 16384 
[1.001 A004] A.1000 > B.2000: A 1025:2049(1024) ack 501 win 16384 
[1.001 A005] A.1000 > B.2000: A 2049:3073(1024) ack 501 win 16384 
[1.003 B002] A.1000 < B.2000: A ack 3073 win 16384 
[2.001 A006] A.1000 > B.2000: A 3073:3173(100) ack 501 win 16384 
[2.103 B003] A.1000 < B.2000: A ack 3173 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
