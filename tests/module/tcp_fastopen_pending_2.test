%description:
Tests that the limit of pending TCP Fast Open connections counts the
connections of a listener (Linux fastopenq.qlen), not those of a local
address. The scenario is that of tcp_fastopen_pending_1, and connection 3
goes to a second address of the server (10.0.0.3); the server listens on each
address, and both sides use Fast Open without a cookie. Connections 2 and 3
send their SYNs with data at the same time, and the limit of the listener
admits one of them: the other SYN-ACK acknowledges only the SYN.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.fastOpen=true
*.cli_app.tOpen2=0.5s
*.cli_app.active2=true
*.cli_app.localPort2=1001
*.cli_app.tSend2=0.5s
*.cli_app.sendBytes2=200B
*.cli_app.fastOpen2=true
*.cli_app.tOpen3=0.5s
*.cli_app.active3=true
*.cli_app.localPort3=1002
*.cli_app.tSend3=0.5s
*.cli_app.sendBytes3=200B
*.cli_app.fastOpen3=true
*.cli_app.connectAddress3="10.0.0.3"
*.srv_app.localAddress="" # the listener takes each address
*.cli_tcp.fastopenClientNoCookieRequired = true # data on the SYN also to 10.0.0.3, which gave no cookie
*.srv_tcp.fastopenAcceptWithoutCookie = true
*.srv_app.fork=true

*.cli_tcp.fastopenClientEnabled = true
*.srv_tcp.fastopenServerEnabled = true
*.srv_tcp.fastopenMaxPendingRequests = 1

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.503 B001] A.1001 < B.2000: A S 125500:125500(0) ack 125201 win 16184   Option(s): MaxSegSize
[0.503 B002] A.1002 < B.2000: A S 125500:125500(0) ack 125001 win 16384   Option(s): MaxSegSize
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Fast Open: the limit of pending Fast Open connections is reached, no Fast Open for this SYN
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
