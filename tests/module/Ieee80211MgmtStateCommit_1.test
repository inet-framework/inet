%description:
Check complete HT and rate state inside association and Beacon callbacks.
Drive a real HT association, final AP response ACKs, and accepted Beacons.
Check pending AP cleanup, the STA Beacon timer, changed HT state, HT removal,
and duplicate publication. The fixture does not write MIB records.
Run 0 checks both endpoints. Run 1 checks AP callbacks independently.

%extraargs: -r 0..1

%file: StateCommit.cc
#include <iostream>
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee80211/mgmt/Ieee80211HtMgmtElements.h"
#include "inet/linklayer/ieee80211/mgmt/Ieee80211MgmtAp.h"
#include "inet/linklayer/ieee80211/mgmt/Ieee80211MgmtSta.h"
#include "inet/linklayer/ieee80211/mgmt/Ieee80211MgmtStaSimplified.h"
#include "inet/linklayer/ieee80211/mgmt/Ieee80211MgmtTransactionTag_m.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/SignalTag_m.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211Channel.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

namespace inet::ieee80211 {

class StateCommitAp : public Ieee80211MgmtAp
{
  public:
    Ptr<const Ieee80211BeaconFrame> beacon;
    Ptr<const Ieee80211AssociationResponseFrame> response;
    bool captureOnly = false;
    uint64_t transaction(const MacAddress& peer) const { return staList.at(peer).pendingAssociationTransactionId; }

    void completeRequest(const MacAddress& peer, const Ptr<Ieee80211AssociationRequestFrame>& body)
    {
        Enter_Method("completeRequest");
        captureOnly = true;
        auto request = new Packet("Request");
        request->insertAtBack(body);
        auto header = makeShared<Ieee80211MgmtHeader>();
        header->setTransmitterAddress(peer);
        bool reassociation = dynamicPtrCast<Ieee80211ReassociationRequestFrame>(body) != nullptr;
        header->setType(reassociation ? ST_REASSOCIATIONREQUEST : ST_ASSOCIATIONREQUEST);
        if (reassociation)
            handleReassociationRequestFrame(request, header);
        else
            handleAssociationRequestFrame(request, header);
        ASSERT(transaction(peer) != 0);
        Packet response("Response");
        auto responseHeader = makeShared<Ieee80211MgmtHeader>();
        responseHeader->setType(reassociation ? ST_REASSOCIATIONRESPONSE : ST_ASSOCIATIONRESPONSE);
        responseHeader->setReceiverAddress(peer);
        response.insertAtBack(responseHeader);
        response.addTag<Ieee80211MgmtTransactionTag>()->setTransactionId(transaction(peer));
        frameTransmissionFinished(&response, FRAME_TRANSMISSION_STATUS_ACKNOWLEDGED);
    }

  protected:
    void sendManagementFrame(const char *name, const Ptr<Ieee80211MgmtFrame>& body, int subtype,
            const MacAddress& address, uint64_t transactionId = 0) override
    {
        if (subtype == ST_BEACON)
            beacon = dynamicPtrCast<const Ieee80211BeaconFrame>(body);
        if (subtype == ST_ASSOCIATIONRESPONSE || subtype == ST_REASSOCIATIONRESPONSE)
            response = dynamicPtrCast<const Ieee80211AssociationResponseFrame>(body);
        if (!captureOnly)
            Ieee80211MgmtAp::sendManagementFrame(name, body, subtype, address, transactionId);
    }
};
Define_Module(StateCommitAp);

class StateCommitSta : public Ieee80211MgmtSta
{
  public:
    Ptr<const Ieee80211AssociationRequestFrame> request;
    bool hasBeaconTimer() const {
        return assocAP.beaconTimeoutMsg != nullptr && assocAP.beaconTimeoutMsg->isScheduled() &&
                assocAP.beaconTimeoutMsg->getArrivalTime() > simTime();
    }
    void refresh(const MacAddress& peer, const Ptr<Ieee80211BeaconFrame>& body)
    {
        Enter_Method("refresh");
        auto packet = new Packet("Beacon");
        packet->insertAtBack(body);
        packet->addTag<SignalPowerInd>()->setPower(mW(1));
        physicallayer::Ieee80211Channel channel(&physicallayer::Ieee80211CompliantBands::band2_4GHz, 0);
        packet->addTag<physicallayer::Ieee80211ChannelInd>()->setChannel(&channel);
        auto header = makeShared<Ieee80211MgmtHeader>();
        header->setType(ST_BEACON);
        header->setTransmitterAddress(peer);
        handleBeaconFrame(packet, header);
    }

  protected:
    void sendManagementFrame(const char *name, const Ptr<Ieee80211MgmtFrame>& body, int subtype,
            const MacAddress& address) override
    {
        if (subtype == ST_ASSOCIATIONREQUEST)
            request = dynamicPtrCast<const Ieee80211AssociationRequestFrame>(body);
        Ieee80211MgmtSta::sendManagementFrame(name, body, subtype, address);
    }
};
Define_Module(StateCommitSta);

class StateCommitSimpleSta : public Ieee80211MgmtStaSimplified
{
  public:
    void renew() {
        Enter_Method("renew");
        stop();
        configureAssociation();
    }
};
Define_Module(StateCommitSimpleSta);

class StateCommitTest : public cSimpleModule, public cListener
{
    Ieee80211Mib *apMib = nullptr;
    Ieee80211Mib *staMib = nullptr;
    StateCommitAp *ap = nullptr;
    StateCommitSta *sta = nullptr;
    Ieee80211Mib *simpleApMib = nullptr;
    Ieee80211Mib *simpleStaMib = nullptr;
    int simpleApNotifications = 0;
    int simpleStaNotifications = 0;
    int apNotifications = 0;
    int staNotifications = 0;
    bool controlled = false;
    bool checkRefusal = false;
    int refusalNotifications = 0;
    bool expectHt = true;
    bool expectedShortGi = false;

  protected:
    int numInitStages() const override { return NUM_INIT_STAGES; }
    void initialize(int stage) override
    {
        if (stage == INITSTAGE_LAST) {
            apMib = check_and_cast<Ieee80211Mib *>(getModuleByPath("^.ap.wlan[0].mib"));
            staMib = check_and_cast<Ieee80211Mib *>(getModuleByPath("^.sta.wlan[0].mib"));
            ap = check_and_cast<StateCommitAp *>(getModuleByPath("^.ap.wlan[0].mgmt"));
            sta = check_and_cast<StateCommitSta *>(getModuleByPath("^.sta.wlan[0].mgmt"));
            apMib->subscribe(Ieee80211Mib::rateStateChangedSignal, this);
            staMib->subscribe(Ieee80211Mib::rateStateChangedSignal, this);
            simpleApMib = check_and_cast<Ieee80211Mib *>(getModuleByPath("^.simpleAp.wlan[0].mib"));
            simpleStaMib = check_and_cast<Ieee80211Mib *>(getModuleByPath("^.simpleSta.wlan[0].mib"));
            simpleApMib->subscribe(Ieee80211Mib::rateStateChangedSignal, this);
            simpleStaMib->subscribe(Ieee80211Mib::rateStateChangedSignal, this);
            scheduleAt(SimTime(500, SIMTIME_MS), new cMessage("check"));
        }
    }

    void receiveSignal(cComponent *source, simsignal_t, bool, cObject *) override
    {
        Enter_Method("rateStateChanged");
        if (source == simpleApMib || source == simpleStaMib) {
            bool isSimpleAp = source == simpleApMib;
            if (!simpleStaMib->bssStationData.isAssociated)
                return;
            auto mib = isSimpleAp ? simpleApMib : simpleStaMib;
            auto peer = isSimpleAp ? simpleStaMib->address : simpleApMib->address;
            ASSERT(mib->findPeerHtState(peer) != nullptr);
            ASSERT(mib->findPeerRateSet(peer) != nullptr && mib->findPeerRateSet(peer)->operational.known);
            if (isSimpleAp) {
                ASSERT(!mib->findPeerRateSet(peer)->basic.known);
                simpleApNotifications++;
            }
            else {
                ASSERT(mib->getBssRateSet() == simpleApMib->getBssRateSet());
                simpleStaNotifications++;
            }
            return;
        }
        bool isAp = source == apMib;
        if (isAp && checkRefusal) {
            ASSERT(apMib->bssAccessPointData.stations.at(staMib->address) == Ieee80211Mib::AUTHENTICATED);
            ASSERT(apMib->findPeerRateSet(staMib->address) == nullptr);
            ASSERT(apMib->findPeerHtState(staMib->address) == nullptr);
            ASSERT(ap->transaction(staMib->address) == 0);
            ASSERT(apMib->getBssRateSet().operational.known);
            refusalNotifications++;
            return;
        }
        if (isAp && apMib->bssAccessPointData.stations[staMib->address] != Ieee80211Mib::ASSOCIATED)
            return;
        if (!isAp && !staMib->bssStationData.isAssociated)
            return;
        if (!isAp && !par("checkSta").boolValue()) {
            staNotifications++;
            return;
        }
        auto mib = isAp ? apMib : staMib;
        auto peer = isAp ? staMib->address : apMib->address;
        const auto *rates = mib->findPeerRateSet(peer);
        ASSERT(rates != nullptr && rates->supported.known && rates->operational.known);
        const auto *ht = mib->findPeerHtState(peer);
        ASSERT((ht != nullptr) == expectHt);
        if (isAp) {
            ASSERT(ap->transaction(peer) == 0);
            apNotifications++;
        }
        else {
            ASSERT(sta->hasBeaconTimer());
            ASSERT(mib->getBssRateSet() == *rates);
            staNotifications++;
        }
        if (controlled) {
            ASSERT(rates->operational.legacyRates == std::set<bps>({Mbps(6)}));
            if (ht != nullptr)
                ASSERT(ht->advertisedCapabilities.shortGi20 == expectedShortGi);
        }
    }

    void handleMessage(cMessage *message) override
    {
        ASSERT(apNotifications > 0 && staNotifications > 0);
        ASSERT(sta->request != nullptr && ap->beacon != nullptr);
        controlled = true;
        Ieee80211SupportedRatesElement rates;
        rates.numRates = 1;
        rates.rate[0] = 6;
        rates.basicRate[0] = true;
        auto request = makeShared<Ieee80211AssociationRequestFrame>(*sta->request);
        request->setSupportedRates(rates);
        request->setExtendedSupportedRatesPresent(false);
        auto capabilities = staMib->localHtCapabilities;
        capabilities.shortGi20 = !capabilities.shortGi20;
        expectedShortGi = capabilities.shortGi20;
        setHtCapabilities(request, capabilities);
        int before = apNotifications;
        ap->completeRequest(staMib->address, request);
        ASSERT(apNotifications == before + 1);
        ap->completeRequest(staMib->address, request);
        ASSERT(apNotifications == before + 1);
        expectHt = false;
        request = makeShared<Ieee80211AssociationRequestFrame>(*request);
        request->setHtCapabilitiesPresent(false);
        ap->completeRequest(staMib->address, request);
        ASSERT(apNotifications == before + 2);

        expectHt = true;
        auto beacon = makeShared<Ieee80211BeaconFrame>(*ap->beacon);
        beacon->setSupportedRates(rates);
        beacon->setExtendedSupportedRatesPresent(false);
        capabilities = apMib->localHtCapabilities;
        capabilities.shortGi20 = !capabilities.shortGi20;
        expectedShortGi = capabilities.shortGi20;
        setHtCapabilities(beacon, capabilities);
        before = staNotifications;
        sta->refresh(apMib->address, beacon);
        ASSERT(staNotifications == before + 1);
        sta->refresh(apMib->address, beacon);
        ASSERT(staNotifications == before + 1);
        for (bool extended : {false, true}) {
            for (int selector = 122; selector <= 127; selector++) {
                auto selectorBeacon = makeShared<Ieee80211BeaconFrame>(*beacon);
                auto selectorRates = rates;
                Ieee80211ExtendedSupportedRatesElement extra;
                if (extended) {
                    extra.numRates = 1;
                    extra.rate[0] = selector * 0.5;
                    extra.basicRate[0] = true;
                }
                else {
                    selectorRates.numRates = 2;
                    selectorRates.rate[1] = selector * 0.5;
                    selectorRates.basicRate[1] = true;
                }
                selectorBeacon->setSupportedRates(selectorRates);
                selectorBeacon->setExtendedSupportedRatesPresent(extended);
                selectorBeacon->setExtendedSupportedRates(extra);
                int fixedLength = 8 + 2 + 2 + 2 + std::string(selectorBeacon->getSSID()).size() +
                        (selectorBeacon->getChannelNumber() != -1 ? 3 : 0);
                selectorBeacon->setChunkLength(B(fixedLength + 2 + selectorRates.numRates + (extended ? 3 : 0)) +
                        getHtMgmtElementsLength(selectorBeacon));
                Packet wire("SelectorBeacon", selectorBeacon);
                Packet decoded("DecodedBeacon", wire.peekAllAsBytes());
                auto decodedBody = decoded.popAtFront<Ieee80211BeaconFrame>(wire.getTotalLength());
                sta->refresh(apMib->address, makeShared<Ieee80211BeaconFrame>(*decodedBody));
                ASSERT(staMib->getBssRateSet().supported.legacyRates == std::set<bps>({Mbps(6)}));
                ASSERT(staMib->getBssRateSet().basic.legacyRates == std::set<bps>({Mbps(6)}));
                ASSERT(staMib->getBssRateSet().operational.legacyRates == std::set<bps>({Mbps(6)}));
                ASSERT(staNotifications == before + 1);
            }
        }
        expectHt = false;
        beacon = makeShared<Ieee80211BeaconFrame>(*beacon);
        beacon->setHtCapabilitiesPresent(false);
        beacon->setHtOperationPresent(false);
        sta->refresh(apMib->address, beacon);
        ASSERT(staNotifications == before + 2);
        auto simpleSta = check_and_cast<StateCommitSimpleSta *>(getModuleByPath("^.simpleSta.wlan[0].mgmt"));
        simpleSta->renew();
        ASSERT(simpleStaNotifications == 1 && simpleApNotifications == 1);
        auto refused = makeShared<Ieee80211ReassociationRequestFrame>();
        refused->setCurrentAP(apMib->address);
        refused->setSupportedRates(rates);
        auto malformed = makeHtCapabilitiesElement(staMib->localHtCapabilities);
        malformed.maxAmpduLengthExponent = 4;
        refused->setHtCapabilitiesPresent(true);
        refused->setHtCapabilities(malformed);
        refused->setChunkLength(B(10) + getHtMgmtElementsLength(refused));
        checkRefusal = true;
        ap->completeRequest(staMib->address, refused);
        ASSERT(ap->response->getStatusCode() == SC_UNSUP_CAP);
        ASSERT(refusalNotifications == 1);
        checkRefusal = false;
        std::cout << "HT and rate publication completes before association and Beacon callbacks.\n";
        delete message;
    }
};
Define_Module(StateCommitTest);
} // namespace inet::ieee80211

%file: test.ned
import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mgmt.Ieee80211MgmtAp;
import inet.linklayer.ieee80211.mgmt.Ieee80211MgmtSta;
import inet.linklayer.ieee80211.mgmt.Ieee80211MgmtStaSimplified;
import inet.node.inet.WirelessHost;
import inet.node.wireless.AccessPoint;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
simple StateCommitAp extends Ieee80211MgmtAp { parameters: @class(::inet::ieee80211::StateCommitAp); }
simple StateCommitSta extends Ieee80211MgmtSta { parameters: @class(::inet::ieee80211::StateCommitSta); }
simple StateCommitSimpleSta extends Ieee80211MgmtStaSimplified { parameters: @class(::inet::ieee80211::StateCommitSimpleSta); }
simple StateCommitTest extends SimpleModule {
    parameters:
        bool checkSta = default(true);
        @class(::inet::ieee80211::StateCommitTest);
}
network StateCommitNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        ap: AccessPoint;
        sta: WirelessHost;
        simpleAp: AccessPoint;
        simpleSta: WirelessHost;
        test: StateCommitTest;
}

%inifile: omnetpp.ini
[General]
network = StateCommitNetwork
ned-path = .;../../../../src;../../lib
sim-time-limit = 501ms
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.test.checkSta = ${true,false}
*.ap.wlan[0].mgmt.typename = "StateCommitAp"
*.sta.wlan[0].mgmt.typename = "StateCommitSta"
*.simpleAp.wlan[0].mgmt.typename = "Ieee80211MgmtApSimplified"
*.simpleSta.wlan[0].mgmt.typename = "StateCommitSimpleSta"
*.simpleSta.wlan[0].agent.typename = ""
*.simpleSta.wlan[0].mgmt.accessPointAddress = "02:00:00:00:00:03"
*.simpleAp.wlan[0].address = "02:00:00:00:00:03"
*.simpleSta.wlan[0].address = "02:00:00:00:00:04"
*.sta.wlan[0].agent.startingTime = 0s
*.sta.wlan[0].agent.channelsToScan = "0"
*.sta.wlan[0].agent.probeDelay = 1ms
*.sta.wlan[0].agent.minChannelTime = 10ms
*.sta.wlan[0].agent.maxChannelTime = 20ms
*.ap.wlan[0].address = "02:00:00:00:00:01"
*.sta.wlan[0].address = "02:00:00:00:00:02"
**.wlan[0].opMode = "n(mixed-2.4Ghz)"
**.wlan[0].bitrate = 65Mbps
**.wlan[0].radio.bandName = "2.4 GHz"
**.wlan[0].radio.channelNumber = 0
**.wlan[0].radio.transmitter.power = 100mW
**.wlan[0].radio.receiver.sensitivity = -85dBm
**.wlan[0].radio.receiver.snirThreshold = 4dB
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 10m
**.mobility.constraintAreaMaxY = 10m
**.mobility.constraintAreaMaxZ = 0m

%contains: stdout
HT and rate publication completes before association and Beacon callbacks.
