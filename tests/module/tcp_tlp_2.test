%description:
Tests that a tail loss probe (RFC 8985 section 7, tlpEnabled=true) that was
not necessary causes no congestion response. The tester delays the last
of four segments by 211.5 ms, so the probe at t=1.212 retransmits it, and
then the original arrives first. The ACK of 2001 covers the probe without
a D-SACK, so the sender waits (section 7.4.2). Then the probe arrives,
and the receiver reports it by a D-SACK that ends at the end of the probe:
both the original and the probe arrived, and the episode ends with no
response.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="a6 delay 0.2115"

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 2000;6 500"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.tlpEnabled = true
*.*_tcp.increasedIWEnabled = true



%# the ACK of the original comes first, without a D-SACK...
%contains: stdout
[1.214 B005] A.1000 < B.2000: A ack 2001 win 5000

%# ...then the D-SACK of the probe
%contains: stdout
[1.215 B006] A.1000 < B.2000: A ack 2001 win 5000   Option(s): NOP NOP SACK[1501,2001)

%not-contains: stdout
TLP: the probe repaired
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
