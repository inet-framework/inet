%description:
A real HCF waits for an ACK after ordinary QoS DATA transmission.
A second radio starts an HT aggregate before the response timer expires.
The aggregate HEADER ends before expiry. Its DATA remains active at expiry.
The timer consumes its event while the production ReceiveStep remains active.
Overheard aggregate reception must end that wait with one originator failure.
Addressed aggregate reception must end that wait before one real Block Ack transmission.
The fixture supplies recipient agreement and peer HT state. It does not test ADDBA negotiation.
Both cases use long and short GI, separate reception parts, deterministic reception, and seed zero.
The addressed cases complete one non-HT Compressed Block Ack at 6 Mbps after SIFS.

%extraargs: -r 0..3

%file: AmpduResponseWindow.cc
#include <iostream>
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmitter.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/errormodel/Ieee80211NistErrorModel.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

class ResponseWindowHcf;

class ResponseWindowDriver : public cSimpleModule, public cListener
{
    ResponseWindowHcf *hcf = nullptr;
    const IIeee80211Mode *mode = nullptr;
    simtime_t responseDeadline;
    bool armed = false;
    bool transmitted = false;
  public:
    void arm(simtime_t deadline);
  protected:
    void initialize() override;
    void handleMessage(cMessage *message) override;
    void receiveSignal(cComponent *, simsignal_t, cObject *object, cObject *) override;
    Packet *createAggregate();
};
Define_Module(ResponseWindowDriver);

class ResponseWindowErrorModel : public Ieee80211NistErrorModel
{
  public:
    double computePacketErrorRate(const ISnir *, IRadioSignal::SignalPart) const override { return 0; }
    double computeAmpduRangeSuccessRate(const ISnir *, const IIeee80211Mode *, B) const override { return 1; }
};
Define_Module(ResponseWindowErrorModel);

class ResponseWindowAgreements : public RecipientBlockAckAgreementHandler
{
  public:
    void accept(MacAddress peer) {
        auto agreement = new RecipientBlockAckAgreement(peer, 5, SequenceNumberCyclic(100), 64, SIMTIME_ZERO);
        agreement->setVariant(BlockAckVariant::COMPRESSED);
        agreement->addbaResposneSent();
        agreement->calculateExpirationTime();
        blockAckAgreements[{peer, 5}] = agreement;
    }
};

class ResponseWindowHcf : public Hcf
{
    IRadio *physicalRadio = nullptr;
    simtime_t aggregateEnd;
  public:
    int waitTimers = 0;
    int consumedTimers = 0;
    int failedFrames = 0;
    int finishedSequences = 0;
    int receivedAggregates = 0;
    int transmittedBlockAcks = 0;
    int delivered = 0;
    bool observedDataAtExpiry = false;
    MacAddress address() const { return mac->getAddress(); }
    void begin() {
        Enter_Method("begin");
        physicalRadio = check_and_cast<IRadio *>(mac->gate("lowerLayerOut")->getNextGate()->getOwnerModule());
        auto transmitter = check_and_cast<const Ieee80211Transmitter *>(physicalRadio->getTransmitter());
        auto channel = transmitter->getChannel();
        mib->setPrimaryChannel(channel->getChannelNumber(), channel->getBand());
        auto incomingPeer = MacAddress("02:00:00:00:00:02");
        mib->setPeerHtCapabilities(incomingPeer, mib->localHtCapabilities, mib->getHtOperation());
        delete recipientBlockAckAgreementHandler;
        auto accepted = new ResponseWindowAgreements();
        accepted->accept(incomingPeer);
        recipientBlockAckAgreementHandler = accepted;

        // The absent outgoing peer supplies no ACK. Its absent HT state retains Normal Ack DATA.
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setReceiverAddress(MacAddress("02:00:00:00:00:09"));
        header->setTransmitterAddress(address());
        header->setAddress3(header->getReceiverAddress());
        header->setTid(0);
        auto packet = new Packet("outgoing-normal-data", header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
    }
    void verify(bool addressed) {
        Enter_Method("verify");
        ASSERT(waitTimers == 1 && consumedTimers == 1 && observedDataAtExpiry);
        ASSERT(receivedAggregates == 1);
        ASSERT(failedFrames == 1 && finishedSequences == 1);
        ASSERT(!frameSequenceHandler->isSequenceRunning());
        ASSERT(edca->getChannelOwner() == nullptr);
        ASSERT(!startRxTimer->isScheduled());
        ASSERT(transmittedBlockAcks == (addressed ? 1 : 0));
        ASSERT(delivered == (addressed ? 2 : 0));
        ASSERT(!tx->hasTransmission());
        std::cout << "Aggregate response-window assertions passed: addressed=" << addressed << "\n";
    }
    void processLowerAggregate(Packet *packet, AmpduReception reception) override {
        auto mode = packet->getTag<Ieee80211ModeInd>()->getMode();
        ASSERT(mode->getHtMcsIndex() == 0 && mode->getDataMode()->getBandwidth() == MHz(20));
        ASSERT(mode->isHtShortGuardInterval() == par("shortGi").boolValue());
        ASSERT(!mode->isHtShortGuardInterval() || mib->localHtCapabilities.shortGi20);
        ASSERT(!mib->getBssRateSet().basic.known);
        aggregateEnd = simTime();
        ASSERT(consumedTimers == 1);
        ASSERT(frameSequenceHandler->isSequenceRunning());
        ASSERT(frameSequenceHandler->getContext()->getLastStep()->getType() == IFrameSequenceStep::Type::RECEIVE);
        ASSERT(!startRxTimer->isScheduled());
        receivedAggregates++;
        Hcf::processLowerAggregate(packet, std::move(reception));
        ASSERT(!frameSequenceHandler->isSequenceRunning());
        ASSERT(edca->getChannelOwner() == nullptr);
    }
  protected:
    void scheduleStartRxTimer(simtime_t timeout) override {
        Hcf::scheduleStartRxTimer(timeout);
        waitTimers++;
        ASSERT(waitTimers == 1);
        check_and_cast<ResponseWindowDriver *>(getSimulation()->getSystemModule()->getSubmodule("driver"))->arm(startRxTimer->getArrivalTime());
    }
    void handleMessage(cMessage *message) override {
        if (message == startRxTimer) {
            ASSERT(physicalRadio->getReceivedSignalPart() == IRadioSignal::SIGNAL_PART_DATA);
            ASSERT(isReceptionInProgress());
            ASSERT(frameSequenceHandler->isSequenceRunning());
            ASSERT(frameSequenceHandler->getContext()->getLastStep()->getType() == IFrameSequenceStep::Type::RECEIVE);
            observedDataAtExpiry = true;
            Hcf::handleMessage(message);
            consumedTimers++;
            ASSERT(!startRxTimer->isScheduled());
            ASSERT(frameSequenceHandler->isSequenceRunning());
        }
        else
            Hcf::handleMessage(message);
    }
    void originatorProcessFailedFrame(Packet *packet) override {
        ASSERT(packet->peekAtFront<Ieee80211DataHeader>()->getReceiverAddress() == MacAddress("02:00:00:00:00:09"));
        failedFrames++;
        Hcf::originatorProcessFailedFrame(packet);
    }
    void frameSequenceFinished() override {
        finishedSequences++;
        Hcf::frameSequenceFinished();
    }
    void transmissionComplete(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override {
        if (dynamicPtrCast<const Ieee80211CompressedBlockAck>(header)) {
            auto mode = packet->getTag<Ieee80211ModeReq>()->getMode();
            ASSERT(mode->getHtMcsIndex() < 0 && mode->getDataMode()->getNetBitrate() == bps(6000000));
            ASSERT(simTime() - mode->getDuration(packet->getDataLength()) == aggregateEnd + modeSet->getSifsTime());
            ASSERT(!frameSequenceHandler->isSequenceRunning());
            ASSERT(edca->getChannelOwner() == nullptr);
            transmittedBlockAcks++;
        }
        Hcf::transmissionComplete(packet, header);
    }
    void sendUp(const std::vector<Packet *>& frames) override {
        for (auto frame : frames) {
            delivered++;
            take(frame);
            delete frame;
        }
    }
};
Define_Module(ResponseWindowHcf);

void ResponseWindowDriver::initialize()
{
    hcf = check_and_cast<ResponseWindowHcf *>(getModuleByPath("^.host.wlan[0].mac.hcf"));
    getModuleByPath("^.sender.radio")->subscribe(transmissionStartedSignal, this);
    auto modes = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
    for (int i = 0; i < modes->getNumModes(); i++) {
        auto candidate = modes->getMode(i);
        if (candidate->getHtMcsIndex() == 0 && candidate->getDataMode()->getBandwidth() == MHz(20) &&
            candidate->isHtShortGuardInterval() == par("shortGi").boolValue())
            mode = candidate;
    }
    ASSERT(mode);
    scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("begin"));
}

void ResponseWindowDriver::arm(simtime_t deadline)
{
    Enter_Method("arm");
    ASSERT(!armed);
    armed = true;
    responseDeadline = deadline;
    ASSERT(simTime() + SimTime(20, SIMTIME_US) < deadline);
    scheduleAfter(SimTime(20, SIMTIME_US), new cMessage("aggregate"));
}

Packet *ResponseWindowDriver::createAggregate()
{
    auto packet = new Packet("incoming-aggregate");
    for (int sequence : {100, 101}) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setReceiverAddress(par("addressed").boolValue() ? hcf->address() : MacAddress("02:00:00:00:00:08"));
        header->setTransmitterAddress(MacAddress("02:00:00:00:00:02"));
        header->setAddress3(header->getTransmitterAddress());
        header->setTid(5);
        header->setAckPolicy(NORMAL_ACK);
        header->setSequenceNumber(SequenceNumberCyclic(sequence));
        header->setDurationField(SIMTIME_ZERO);
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(1000);
        packet->insertAtBack(delimiter);
        packet->insertAtBack(header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(1000) - header->getChunkLength() - B(4)));
        auto trailer = makeShared<Ieee80211MacTrailer>();
        trailer->setFcsMode(FCS_DECLARED_CORRECT);
        packet->insertAtBack(trailer);
    }
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    return packet;
}

void ResponseWindowDriver::receiveSignal(cComponent *, simsignal_t, cObject *object, cObject *)
{
    Enter_Method_Silent();
    auto transmission = check_and_cast<const Ieee80211Transmission *>(object);
    ASSERT(armed && !transmitted);
    transmitted = true;
    // The real radio must reach DATA before expiry and remain there until after expiry.
    ASSERT(transmission->getStartTime(IRadioSignal::SIGNAL_PART_DATA) < responseDeadline);
    ASSERT(responseDeadline < transmission->getEndTime(IRadioSignal::SIGNAL_PART_DATA));
    scheduleAt(transmission->getEndTime() + SimTime(1, SIMTIME_MS), new cMessage("verify"));
}

void ResponseWindowDriver::handleMessage(cMessage *message)
{
    if (message->isName("begin")) {
        delete message;
        hcf->begin();
    }
    else if (message->isName("aggregate")) {
        delete message;
        send(createAggregate(), "out");
    }
    else {
        delete message;
        ASSERT(transmitted);
        hcf->verify(par("addressed").boolValue());
        endSimulation();
    }
}

%file: test.ned
import inet.mobility.static.StationaryMobility;
import inet.node.inet.AdhocHost;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211Radio;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211RadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.errormodel.Ieee80211NistErrorModel;
module ResponseWindowHcf extends Hcf { parameters: bool shortGi; @class(::ResponseWindowHcf); }
module ResponseWindowErrorModel extends Ieee80211NistErrorModel { parameters: @class(::ResponseWindowErrorModel); }
simple ResponseWindowDriver { parameters: bool addressed; bool shortGi; @class(::ResponseWindowDriver); gates: output out; }
module ResponseWindowSender {
    parameters: @networkNode;
    gates: input in; input radioIn @directIn;
    submodules:
        mobility: StationaryMobility;
        radio: Ieee80211Radio;
    connections allowunconnected:
        in --> radio.upperLayerIn;
        radioIn --> radio.radioIn;
}
network Test {
    submodules:
        radioMedium: Ieee80211RadioMedium;
        driver: ResponseWindowDriver;
        sender: ResponseWindowSender;
        host: AdhocHost;
    connections:
        driver.out --> sender.in;
}

%inifile: omnetpp.ini
[General]
network = Test
ned-path = .;../../../../src
sim-time-limit = 10ms
seed-set = 0
cmdenv-express-mode = false
record-vector-results = false
record-scalar-results = false
*.driver.addressed = ${addressed=false,true}
*.driver.shortGi = ${shortGi=false,true}
*.host.wlan[0].mac.hcf.shortGi = ${shortGi}
*.host.wlan[0].opMode = "n(mixed-2.4Ghz)"
*.host.wlan[0].mac.qosStation = true
*.host.wlan[0].mac.hcf.typename = "ResponseWindowHcf"
*.host.wlan[0].mac.hcf.isBlockAckSupported = true
*.host.wlan[0].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
*.host.wlan[0].mac.hcf.originatorAckPolicy.ackTimeout = 200us
*.host.wlan[0].radio.receiver.errorModel.typename = "ResponseWindowErrorModel"
*.host.wlan[0].radio.separateReceptionParts = true
*.sender.radio.separateReceptionParts = true
*.sender.radio.opMode = "n(mixed-2.4Ghz)"
*.sender.radio.initialRadioMode = "transmitter"
*.sender.radio.antenna.mobilityModule = "^.^.mobility"
**.recoveryProcedure.shortRetryLimit = 1
**.recoveryProcedure.longRetryLimit = 1
**.radio.receiver.bandwidth = 20MHz
*.radioMedium.backgroundNoise.power = -110dBm
*.radioMedium.propagation.typename = "ConstantTimePropagation"
*.radioMedium.propagation.propagationTime = 0s
**.mobility.initFromDisplayString = false
**.mobility.initialX = 10m
**.mobility.initialY = 10m
**.mobility.initialZ = 0m
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m

