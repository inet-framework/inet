%description:
Ipv6NetworkConfigurator rejects a manual <route> that names a gateway but no
interface when the gateway is not an address on any link the node is attached
to: without an interface the route cannot be installed.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

network Ipv6RouteGatewayNotOnLinkNetwork
{
    types:
        channel ethline extends DatarateChannel {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        configurator: Ipv6NetworkConfigurator;
        h1: StandardHost6;
        r: Router6;
    connections:
        h1.ethg++ <--> ethline <--> r.ethg++;
}

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Ipv6RouteGatewayNotOnLinkNetwork
ned-path = .;../../../../src
sim-time-limit = 1s
cmdenv-express-mode = false

**.ipv6.configurator.networkConfiguratorModule = "configurator"
**.configurator.config = xml("<config> \
    <interface among='h1 r' prefix='2001:db8:1::/64'/> \
    <route hosts='h1' destination='2001:db8:99::/64' gateway='2001:db8:77::1'/> \
  </config>")

%#--------------------------------------------------------------------------------------------------------------
%exitcode: 1
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "<!>" test.* > test_err.out || true
%#--------------------------------------------------------------------------------------------------------------
%contains: test_err.out
has no interface towards "2001:db8:77::1"
%#--------------------------------------------------------------------------------------------------------------
