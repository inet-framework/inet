%description:
Tests the close of an AccECN connection. The FINs and the ACK in TIME_WAIT
carry the ACE field, because RFC 9768 section 3.2.2.2 asks for the ACE field
on each segment with SYN=0 (accEcnBareTimeWaitAck=false).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000"
*.*_tcp.accEcnOptionEnabled = false # the ACE field alone (tcp_accecn_option_* test the option)
*.*_tcp.tcpEcnMode = "accecn"
*.cli_app.tClose=2s
*.srv_app.tClose=3s

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[2.001 A004] A.1000 > B.2000: A F E N ack 501 win 16384 
srv_tcp: ESTABLISHED --> CLOSE_WAIT  (on RCV_FIN)
[2.003 B003] A.1000 < B.2000: A E N ack 1002 win 16384 
cli_tcp: FIN_WAIT_1 --> FIN_WAIT_2  (on RCV_ACK)
srv_tcp: CLOSE_WAIT --> LAST_ACK  (on CLOSE)
[3.001 B004] A.1000 < B.2000: A F E N ack 1002 win 16384 
cli_tcp: FIN_WAIT_2 --> TIME_WAIT  (on RCV_FIN)
[3.003 A005] A.1000 > B.2000: A E N ack 502 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
