%description:
Tests the ECN codepoint of the data of a classic ECN connection (RFC 3168):
ECT(0). RFC 8311 section 3 gives ECT(1) to experiments: "A network node MUST
NOT originate traffic marked with ECT(1) unless the network node is
participating in a Congestion Marking Differences experiment that uses
ECT(1)". Before, INET marked ECT(1). The pure ACK stays Not-ECT.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000"
*.*_tcp.ecnWillingness = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 ECT(0) 
[1.203 B002] A.1000 < B.2000: A ack 1001 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
