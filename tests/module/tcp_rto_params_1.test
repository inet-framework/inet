%description:
Tests initialRto, maxRexmitTimeout and maxRexmitCount. The client has an
initial RTO of 1 s (3 s by default), an upper limit of 1.5 s and two
retransmissions. The tester removes the data segment and its
retransmissions: the first retransmission comes after 1 s, the second after
1.5 s (not 2 s), and at the third timeout the connection aborts.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 500"
*.cli_tcp.initialRto = 1s
*.cli_tcp.maxRexmitTimeout = 1.5s
*.cli_tcp.maxRexmitCount = 2
*.tcptester.script="a3 delete; a4 delete; a5 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:501(500) ack 501 win 16384 # deleting
[2.001 A004] A.1000 > B.2000: A 1:501(500) ack 501 win 16384 # deleting
[3.501 A005] A.1000 > B.2000: A 1:501(500) ack 501 win 16384 # deleting
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Retransmission count exceeds 2, aborting connection
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
