%description:
Tests the limit of pending TCP Fast Open connections (RFC 7413 section 4.2:
PendingFastOpenRequests), here 1 (fastopenMaxPendingRequests). Connection 1
caches the cookie. Connections 2 and 3 send their Fast Open SYNs with 200
bytes at the same time to the forked server. The server accepts the data of
connection 2, which stays in SYN_RCVD until the ACK of its SYN-ACK. For
connection 3, the limit is reached: its SYN-ACK acknowledges only the SYN
and gives no cookie, and the first ACK of the client carries the data.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.fastOpen=true
*.cli_app.tOpen2=0.5s
*.cli_app.active2=true
*.cli_app.localPort2=1001
*.cli_app.tSend2=0.5s
*.cli_app.sendBytes2=200B
*.cli_app.fastOpen2=true
*.cli_app.tOpen3=0.5s
*.cli_app.active3=true
*.cli_app.localPort3=1002
*.cli_app.tSend3=0.5s
*.cli_app.sendBytes3=200B
*.cli_app.fastOpen3=true
*.srv_app.fork=true

*.cli_tcp.fastopenClientEnabled = true
*.srv_tcp.fastopenServerEnabled = true
*.srv_tcp.fastopenMaxPendingRequests = 1

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.503 B002] A.1001 < B.2000: A S 125500:125500(0) ack 125201 win 16184   Option(s): MaxSegSize
[0.503 B003] A.1002 < B.2000: A S 125500:125500(0) ack 125001 win 16384   Option(s): MaxSegSize
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.505 A006] A.1002 > B.2000: A 125001:125201(200) ack 125501 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
TcpTestNet1.srv_app: received 400 bytes in 2 packets
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
