%description:
Tests CUBIC after HyStart++ (RFC 9438 section 4.10). The scenario is that of
tcp_hystartpp_1, with TcpCubic. HyStart++ leaves the first slow start without a
loss, so W_max is undefined; CUBIC then sets W_max to cwnd (90 segments) and K
to 0, and grows from there by the cubic curve. Because W_max is known, the
clamp of Linux for an unknown W_max (cntClamp, 20) does not act: at the start
of congestion avoidance, the curve is flat, and one segment of cwnd needs 9000
acknowledged segments (100 times cwnd).

%file: test.ned
import ned.DatarateChannel;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;

network HystartppNet
{
    types:
        channel C extends DatarateChannel
        {
            datarate = 10Mbps;
            delay = 10ms;
        }
    submodules:
        client: StandardHost;
        server: StandardHost;
        configurator: Ipv4NetworkConfigurator;
    connections:
        client.pppg++ <--> C <--> server.pppg++;
}

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = HystartppNet
total-stack = 7MiB

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.server*.tcpType = "Tcp"
*.client*.tcpType = "Tcp"
**.tcp.tcpAlgorithmClass = "TcpCubic"
**.tcp.sackSupport = true
**.client.tcp.conn-*.algorithm.slowStartExit = "hystartpp"

**.client.numApps = 1
**.client.app[0].typename = "TcpSessionApp"
**.client.app[0].active = true
**.client.app[0].localPort = -1
**.client.app[0].connectAddress = "server"
**.client.app[0].connectPort = 1000
**.client.app[0].tOpen = 0.2s
**.client.app[0].tSend = 0.4s
**.client.app[0].sendBytes = 1000000B
**.client.app[0].sendScript = ""
**.client.app[0].tClose = 25s

**.server.numApps = 1
**.server.app[0].typename = "TcpSinkApp"
**.server.app[0].localPort = 1000

**.ppp[*].queue.typename = "DropTailQueue"
**.ppp[*].queue.packetCapacity = 100

*.configurator.config = xml("<config><interface hosts='*' address='192.168.1.x' netmask='255.255.255.0'/></config>")


%contains: stdout
HyStart++: 5 rounds of CSS, congestion avoidance, ssthresh=130356
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
CUBIC: W_max=90 segments after HyStart++, K=0
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Congestion avoidance: 2 of 9000 segments acked towards the next increment
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
