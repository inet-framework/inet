%description:

With inet-log-formatting = true, the log contains ANSI escape sequences even
when the standard output is not a terminal (the test runner captures it into
a file): the field name of an EV_FIELD is bold.

%inifile: omnetpp.ini

[General]
record-vector-results = false
record-scalar-results = false
ned-path = .;../../../../src;../../lib
network = inet.test.moduletest.lib.ClientServer
sim-time-limit = 1s
cmdenv-express-mode = false
cmdenv-event-banners = false
inet-log-formatting = true

%#--------------------------------------------------------------------------------------------------------------
%contains-regex: stdout
Registering network interface, \x1B\[1minterface\x1B\[0m = \(inet::NetworkInterface\)lo\[0\] lo0
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
