%description:
Tests that a router interface configured by Ipv6NetworkConfigurator holds its global
address once.

    h1 -- r1 -- h2

The configurator assigns the router's global addresses at initialization, derived from the
link prefix and the interface identifier. When the link-local address of an interface
passes Duplicate Address Detection (DAD), Ipv6NeighbourDiscovery forms a global address
from every prefix the interface advertises, which is the same address again. The
interface must not hold two entries for it.

At t = 4 s, well after DAD has finished, a checker module counts the entries of each of
r1's interfaces and how many of them are distinct.

%#--------------------------------------------------------------------------------------------------------------
%file: AddressListChecker.cc

#include <algorithm>
#include <string>
#include <vector>

#include "inet/networklayer/contract/IInterfaceTable.h"
#include "inet/networklayer/ipv6/Ipv6InterfaceData.h"

namespace inet {

class AddressListChecker : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(par("checkTime"), new cMessage("check")); }

    virtual void handleMessage(cMessage *msg) override
    {
        delete msg;
        auto ift = check_and_cast<IInterfaceTable *>(getModuleByPath(par("interfaceTableModule")));
        for (int i = 0; i < ift->getNumInterfaces(); i++) {
            auto ie = ift->getInterface(i);
            auto ipv6Data = ie->findProtocolData<Ipv6InterfaceData>();
            if (ipv6Data == nullptr || ie->isLoopback())
                continue;
            std::vector<Ipv6Address> distinct;
            std::string global;
            for (int j = 0; j < ipv6Data->getNumAddresses(); j++) {
                const Ipv6Address& address = ipv6Data->getAddress(j);
                if (std::find(distinct.begin(), distinct.end(), address) == distinct.end())
                    distinct.push_back(address);
                if (address.getScope() == Ipv6Address::GLOBAL)
                    global += " " + address.str();
            }
            EV_INFO << ie->getInterfaceName() << ": " << ipv6Data->getNumAddresses() << " addresses, "
                    << distinct.size() << " distinct, global" << global << endl;
        }
    }
};

Define_Module(AddressListChecker);

} // namespace inet

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

simple AddressListChecker
{
    parameters:
        @class(::inet::AddressListChecker);
        string interfaceTableModule;
        double checkTime @unit(s);
}

network RouterGlobalAddressOnceTest6
{
    types:
        channel ethernetline extends DatarateChannel
        {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        h1: StandardHost6;
        r1: Router6;
        h2: StandardHost6;
        configurator: Ipv6NetworkConfigurator;
        checker: AddressListChecker {
            interfaceTableModule = "^.r1.interfaceTable";
            checkTime = 4s;
        }
    connections:
        h1.ethg++ <--> ethernetline <--> r1.ethg++;
        r1.ethg++ <--> ethernetline <--> h2.ethg++;
}

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini

[General]
record-vector-results = false
network = RouterGlobalAddressOnceTest6
sim-time-limit = 5s
cmdenv-express-mode = false
cmdenv-log-prefix = "%C: "
ned-path = .;../../../../src
*.checker.cmdenv-log-level = info
**.cmdenv-log-level = off

**.ipv6.configurator.networkConfiguratorModule = "configurator"

%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%# each router interface holds its global address and its link-local address, once each
%contains: stdout
RouterGlobalAddressOnceTest6.checker: eth0: 2 addresses, 2 distinct, global 2001:db8:0:1:8aa:ff:fe00:2
%contains: stdout
RouterGlobalAddressOnceTest6.checker: eth1: 2 addresses, 2 distinct, global 2001:db8:0:2:8aa:ff:fe00:3
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
