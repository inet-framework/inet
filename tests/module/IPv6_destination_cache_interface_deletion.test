%description:
Deleting an interface removes the destination cache entries that name it, so
the next packet to a destination last reached over that interface takes a
remaining route instead of aborting in the interface table lookup.

Topology: h1 -- r1 -- r2 -- h2

h1 pings h2 every 100 ms from 5 s. At 5.55 s the test module creates an
IPv6-in-IPv6 tunnel interface from r1 to r2 on r1 and adds a /128 route to h2
over it, so r1's destination cache sends h2's traffic into the tunnel. At
6.55 s it deletes the tunnel interface with deleteTunnelNetworkInterface(). The
echo requests sent after that must reach h2 over r1's original route.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned

import inet.networklayer.configurator.ipv6.Ipv6NetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

simple TunnelUpdater
{
    parameters:
        string routingTableModule;
        string destAddress;
        string tunnelSource;
        string tunnelDestination;
        string pingAppModule;
        double createTime @unit(s);
        double deleteTime @unit(s);
}

network InterfaceDeletionTest
{
    types:
        channel ethline extends DatarateChannel {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        configurator: Ipv6NetworkConfigurator;
        tunnelUpdater: TunnelUpdater;
        h1: StandardHost6;
        r1: Router6;
        r2: Router6;
        h2: StandardHost6;
    connections:
        h1.ethg++ <--> ethline <--> r1.ethg++;
        r1.ethg++ <--> ethline <--> r2.ethg++;
        r2.ethg++ <--> ethline <--> h2.ethg++;
}

%#--------------------------------------------------------------------------------------------------------------
%file: TunnelUpdater.cc

#include "inet/networklayer/common/L3AddressResolver.h"
#include "inet/networklayer/ipv6/Ipv6RoutingTable.h"

namespace IPv6_destination_cache_interface_deletion {

using namespace inet;

class TunnelUpdater : public cSimpleModule, public cListener
{
  protected:
    simtime_t createTime;
    simtime_t deleteTime;
    cMessage *createTimer = nullptr;
    NetworkInterface *tunnel = nullptr;
    int repliesBeforeCreation = 0;
    int repliesOverTunnel = 0;
    int repliesAfterDeletion = 0;

  protected:
    virtual void initialize() override
    {
        createTime = par("createTime");
        deleteTime = par("deleteTime");
        getModuleByPath(par("pingAppModule"))->subscribe("pingRxSeq", this);
        createTimer = new cMessage("createTunnel");
        scheduleAt(createTime, createTimer);
        scheduleAt(deleteTime, new cMessage("deleteTunnel"));
    }

    virtual void handleMessage(cMessage *msg) override
    {
        auto rt = check_and_cast<Ipv6RoutingTable *>(getModuleByPath(par("routingTableModule")));
        Ipv6Address dest = L3AddressResolver().resolve(par("destAddress")).toIpv6();
        if (msg == createTimer) {
            Ipv6Address source = L3AddressResolver().resolve(par("tunnelSource")).toIpv6();
            Ipv6Address destination = L3AddressResolver().resolve(par("tunnelDestination")).toIpv6();
            tunnel = rt->createTunnelNetworkInterface(source, destination);
            rt->addStaticRoute(dest, 128, tunnel->getInterfaceId(), Ipv6Address::UNSPECIFIED_ADDRESS);
            EV_INFO << "created tunnel interface " << tunnel->getInterfaceName() << endl;
        }
        else {
            int interfaceId = -1;
            rt->lookupDestCache(dest, interfaceId);
            EV_INFO << "destination cache interface before deletion: " << (interfaceId == tunnel->getInterfaceId() ? "tunnel" : "other") << endl;
            rt->deleteTunnelNetworkInterface(tunnel);
            tunnel = nullptr;
        }
        delete msg;
    }

    virtual void receiveSignal(cComponent *source, simsignal_t signalID, intval_t value, cObject *details) override
    {
        if (simTime() < createTime)
            repliesBeforeCreation++;
        else if (simTime() < deleteTime)
            repliesOverTunnel++;
        else
            repliesAfterDeletion++;
    }

    virtual void finish() override
    {
        EV_INFO << "echo replies before tunnel creation: " << repliesBeforeCreation << endl;
        EV_INFO << "echo replies over the tunnel: " << repliesOverTunnel << endl;
        EV_INFO << "echo replies after tunnel deletion: " << repliesAfterDeletion << endl;
    }
};

Define_Module(TunnelUpdater);

} // namespace IPv6_destination_cache_interface_deletion

%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini

[General]
network = InterfaceDeletionTest
ned-path = .;../../../../src
sim-time-limit = 7.5s
record-vector-results = false
cmdenv-express-mode = false

**.ipv6.configurator.networkConfiguratorModule = "configurator"

*.h1.numApps = 1
*.h1.app[0].typename = "PingApp"
*.h1.app[0].destAddr = "h2(ipv6)"
*.h1.app[0].startTime = 5s
*.h1.app[0].sendInterval = 0.1s

*.tunnelUpdater.routingTableModule = "^.r1.ipv6.routingTable"
*.tunnelUpdater.destAddress = "h2(ipv6)"
*.tunnelUpdater.tunnelSource = "r1%eth1(ipv6)"
*.tunnelUpdater.tunnelDestination = "r2%eth0(ipv6)"
*.tunnelUpdater.pingAppModule = "^.h1.app[0]"
*.tunnelUpdater.createTime = 5.55s
*.tunnelUpdater.deleteTime = 6.55s

*.tunnelUpdater.cmdenv-log-level = info
**.cmdenv-log-level = off

%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
destination cache interface before deletion: tunnel
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
echo replies over the tunnel: 10
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
echo replies after tunnel deletion: 9
%#--------------------------------------------------------------------------------------------------------------
