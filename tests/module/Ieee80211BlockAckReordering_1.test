%description:
Check S1 recipient delivery through RecipientQosMacDataService.
Supply accepted Basic agreements with known buffer sizes.
Check fragment capacity, complete gap release, cyclic delivery, and BAR before DATA.
Check window movement, incomplete-unit disposal, peer/TID isolation, and A-MSDU order.
The fixture supplies agreements; it does not test ADDBA negotiation.
Compressed cases check gap release, cyclic delivery, peer/TID isolation, and receipt retention through the production recipient service.
Basic bitmap cases check that BAR and DATA window advances retire receipt history even when no complete MSDU is delivered.
The sequence reuse case checks that a retired fragment receipt cannot set a bit in the next sequence cycle.
Group QoS data uses a separate sequence space and must leave individual Basic and Compressed agreements untouched.
An equal group sequence must not suppress the first received unicast retry, with or without an agreement.
Check duplicate reporting for a received Normal Ack fragment and a late retry first seen after a Compressed reorder gap.

%extraargs: -r 0..19

%file: RecipientReordering.cc
// Author: Miguel González-López
#include "inet/common/Simsignals.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/aggregation/MsduAggregation.h"
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckProcedure.h"
#include "inet/linklayer/ieee80211/mac/recipient/RecipientQosMacDataService.h"

namespace inet::ieee80211 {

class ReorderingProbe : public BlockAckReordering {
  public:
    ReceiveBuffer *findBuffer(Tid tid, MacAddress peer) const {
        auto it = receiveBuffers.find({tid, peer});
        return it == receiveBuffers.end() ? nullptr : it->second;
    }
    size_t getBufferCount() const { return receiveBuffers.size(); }
};

class ReorderingRecipient : public RecipientQosMacDataService {
  protected:
    void initialize() override {
        RecipientQosMacDataService::initialize();
        delete blockAckReordering;
        blockAckReordering = new ReorderingProbe();
    }
  public:
    const ReorderingProbe *getReordering() const {
        return static_cast<const ReorderingProbe *>(blockAckReordering);
    }
};
Define_Module(ReorderingRecipient);

class ReorderingAgreements : public RecipientBlockAckAgreementHandler {
  public:
    void accept(MacAddress peer, Tid tid, int start, int size, BlockAckVariant variant = BlockAckVariant::BASIC) {
        auto agreement = new RecipientBlockAckAgreement(peer, tid, SequenceNumberCyclic(start), size, SIMTIME_ZERO);
        agreement->setVariant(variant);
        agreement->addbaResposneSent();
        blockAckAgreements[{peer, tid}] = agreement;
    }
};

class BasicBitmapBuilder : public RecipientBlockAckProcedure {
  public:
    using RecipientBlockAckProcedure::buildBlockAck;
};

class DuplicateDropProbe : public cListener {
  public:
    std::vector<std::string> packets;
    void receiveSignal(cComponent *, simsignal_t, cObject *object, cObject *details) override {
        auto drop = check_and_cast<PacketDropDetails *>(details);
        ASSERT(drop->getReason() == DUPLICATE_DETECTED);
        packets.push_back(check_and_cast<Packet *>(object)->getName());
    }
};

class RecipientReorderingTest : public cSimpleModule {
  protected:
    ReorderingRecipient *recipient = nullptr;
    ReorderingAgreements agreements;
    const MacAddress peer = MacAddress("02:00:00:00:00:02");
    const MacAddress otherPeer = MacAddress("02:00:00:00:00:03");
    const MacAddress receiver = MacAddress("02:00:00:00:00:01");

    Packet *makeData(int sequence, const char *name, int fragment = 0, bool more = false,
            MacAddress transmitter = MacAddress("02:00:00:00:00:02"), Tid tid = 5,
            bool group = false, bool retry = false, AckPolicy ackPolicy = BLOCK_ACK) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setTransmitterAddress(transmitter);
        header->setReceiverAddress(group ? MacAddress::BROADCAST_ADDRESS : receiver);
        header->setAddress3(transmitter);
        header->setTid(tid);
        header->setAckPolicy(group ? NO_ACK : ackPolicy);
        header->setSequenceNumber(SequenceNumberCyclic(sequence));
        header->setFragmentNumber(fragment);
        header->setMoreFragments(more);
        header->setRetry(retry);
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(10)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        return packet;
    }

    using cSimpleModule::receive;
    std::vector<Packet *> receive(Packet *packet, bool interframe = false) {
        auto header = packet->peekAtFront<Ieee80211DataHeader>();
        return recipient->dataFrameReceived(packet, header, &agreements, interframe);
    }

    std::vector<Packet *> receiveBar(int start, MacAddress transmitter, Tid tid = 5, int fragment = 0) {
        auto header = makeShared<Ieee80211BasicBlockAckReq>();
        header->setTransmitterAddress(transmitter);
        header->setReceiverAddress(receiver);
        header->setTidInfo(tid);
        header->setFragmentNumber(fragment);
        header->setStartingSequenceNumber(SequenceNumberCyclic(start));
        auto packet = new Packet("bar", header);
        auto result = recipient->controlFrameReceived(packet, header, &agreements);
        delete packet;
        return result;
    }

    void checkDelivery(std::vector<Packet *> frames, std::initializer_list<const char *> names) {
        std::vector<std::string> actualNames;
        for (auto frame : frames) {
            actualNames.push_back(frame->getName());
            take(frame);
            delete frame;
        }
        std::vector<std::string> expectedNames(names.begin(), names.end());
        std::cout << "Delivered:";
        for (const auto& name : actualNames)
            std::cout << " " << name;
        std::cout << "\n";
        ASSERT(actualNames == expectedNames);
    }

    void checkWindow(int start, int length, MacAddress transmitter, Tid tid = 5) {
        auto buffer = recipient->getReordering()->findBuffer(tid, transmitter);
        ASSERT(buffer != nullptr);
        std::cout << "Window start=" << buffer->getNextExpectedSequenceNumber()
                  << " positions=" << buffer->getLength() << "\n";
        ASSERT(buffer->getNextExpectedSequenceNumber() == SequenceNumberCyclic(start));
        ASSERT(buffer->getLength() == length);
    }

    void checkBasicReceipt(int start, int offset, bool firstFragmentReceived) {
        auto bar = makeShared<Ieee80211BasicBlockAckReq>();
        bar->setTransmitterAddress(peer);
        bar->setReceiverAddress(receiver);
        bar->setTidInfo(5);
        bar->setStartingSequenceNumber(SequenceNumberCyclic(start));
        BasicBitmapBuilder builder;
        auto reply = dynamicPtrCast<const Ieee80211BasicBlockAck>(builder.buildBlockAck(bar, agreements.getAgreement(5, peer)));
        ASSERT(reply->getStartingSequenceNumber() == SequenceNumberCyclic(start));
        ASSERT(reply->getBlockAckBitmap(offset).getBit(0) == firstFragmentReceived);
        ASSERT(!reply->getBlockAckBitmap(offset).getBit(1));
    }

    Packet *makeAggregate(int sequence, const char *first, const char *second) {
        std::vector<Packet *> frames = {makeData(sequence, first), makeData(sequence, second)};
        MsduAggregation aggregation;
        auto packet = aggregation.aggregateFrames(&frames);
        auto header = packet->removeAtFront<Ieee80211DataHeader>();
        header->setSequenceNumber(SequenceNumberCyclic(sequence));
        header->setAckPolicy(BLOCK_ACK);
        packet->insertAtFront(header);
        return packet;
    }

    void handleMessage(cMessage *message) override {
        delete message;
        recipient = check_and_cast<ReorderingRecipient *>(getModuleByPath("^.recipient"));
        int scenario = par("scenario");
        std::cout << "Recipient scenario " << scenario << "\n";
        switch (scenario) {
            case 0: // Two Basic fragments occupy one sequence position.
                agreements.accept(peer, 5, 100, 1);
                checkDelivery(receive(makeData(100, "fragmented-frag0", 0, true)), {});
                checkWindow(100, 1, peer);
                checkDelivery(receive(makeData(100, "duplicate-frag0", 0, true)), {});
                checkWindow(100, 1, peer);
                checkDelivery(receive(makeData(100, "fragmented-frag1", 1)), {"fragmented"});
                checkWindow(101, 0, peer);
                break;
            case 1: // DATA fills a gap without a later DATA or BAR.
            case 2: { // The same operation crosses 4095 -> 0.
                int start = scenario == 1 ? 100 : 4094;
                agreements.accept(peer, 5, start, 8);
                checkDelivery(receive(makeData((start + 1) % 4096, "second")), {});
                checkDelivery(receive(makeData((start + 2) % 4096, "third")), {});
                checkDelivery(receive(makeData(start, "first")), {"first", "second", "third"});
                checkWindow((start + 3) % 4096, 0, peer);
                checkDelivery(receive(makeData(start, "old")), {});
                break;
            }
            case 3: // BAR establishes state before the first DATA.
                agreements.accept(peer, 5, 100, 8);
                ASSERT(recipient->getReordering()->getBufferCount() == 0);
                {
                    auto unsupported = makeShared<Ieee80211MultiTidBlockAckReq>();
                    unsupported->setTransmitterAddress(peer);
                    unsupported->setReceiverAddress(receiver);
                    auto packet = new Packet("unsupported-bar", unsupported);
                    checkDelivery(recipient->controlFrameReceived(packet, unsupported, &agreements), {});
                    delete packet;
                }
                checkDelivery(receiveBar(104, otherPeer), {});
                checkDelivery(receiveBar(104, peer, 6), {});
                checkDelivery(receiveBar(104, peer, 5, 1), {});
                ASSERT(recipient->getReordering()->getBufferCount() == 0);
                checkDelivery(receiveBar(104, peer), {});
                checkWindow(104, 0, peer);
                checkDelivery(receive(makeData(104, "first")), {"first"});
                checkWindow(105, 0, peer);
                break;
            case 4: // BAR releases preceding and consecutive units in cyclic order.
                agreements.accept(peer, 5, 4093, 8);
                checkDelivery(receive(makeData(4094, "incomplete-frag0", 0, true)), {});
                checkDelivery(receive(makeAggregate(4095, "before-a", "before-b")), {});
                checkDelivery(receive(makeAggregate(0, "after-a", "after-b")), {});
                checkDelivery(receive(makeData(1, "last")), {});
                checkDelivery(receiveBar(0, peer), {"before-a", "before-b", "after-a", "after-b", "last"});
                checkWindow(2, 0, peer);
                checkDelivery(receiveBar(4095, peer), {});
                checkDelivery(receiveBar(2, peer), {});
                checkDelivery(receiveBar(2050, peer), {});
                checkWindow(2, 0, peer);
                checkDelivery(receive(makeData(4094, "old-frag1", 1)), {});
                break;
            case 5: // DATA beyond the window releases complete older units.
                agreements.accept(peer, 5, 100, 4);
                checkDelivery(receive(makeData(100, "incomplete-frag0", 0, true)), {});
                checkDelivery(receive(makeData(101, "preceding")), {});
                checkDelivery(receive(makeData(103, "following")), {});
                checkDelivery(receive(makeData(106, "new")), {"preceding", "following"});
                checkWindow(104, 1, peer);
                checkDelivery(receive(makeData(100, "old-frag1", 1)), {});
                checkDelivery(receive(makeData(104, "gap-one")), {"gap-one"});
                checkDelivery(receive(makeData(105, "gap-two")), {"gap-two", "new"});
                checkWindow(107, 0, peer);
                break;
            case 6: // Peer and TID state remain independent.
                agreements.accept(peer, 5, 100, 8);
                agreements.accept(otherPeer, 5, 100, 8);
                agreements.accept(peer, 6, 100, 8);
                checkDelivery(receive(makeData(101, "peer-one")), {});
                checkDelivery(receive(makeData(101, "peer-two", 0, false, otherPeer)), {});
                checkDelivery(receive(makeData(101, "tid-six", 0, false, peer, 6)), {});
                checkDelivery(receiveBar(101, peer), {"peer-one"});
                checkWindow(102, 0, peer);
                checkWindow(100, 1, otherPeer);
                checkWindow(100, 1, peer, 6);
                checkDelivery(receive(makeData(100, "peer-two-first", 0, false, otherPeer)),
                        {"peer-two-first", "peer-two"});
                checkDelivery(receive(makeData(100, "tid-six-first", 0, false, peer, 6)),
                        {"tid-six-first", "tid-six"});
                break;
            case 7: // An incomplete unit stops consecutive release.
                agreements.accept(peer, 5, 100, 4);
                checkDelivery(receive(makeData(101, "fragmented-frag0", 0, true)), {});
                checkDelivery(receive(makeData(102, "third")), {});
                checkDelivery(receive(makeData(100, "first")), {"first"});
                checkWindow(101, 2, peer);
                checkDelivery(receive(makeData(101, "fragmented-frag1", 1)), {"fragmented", "third"});
                checkWindow(103, 0, peer);
                break;
            case 8:
            case 9: {
                int start = scenario == 8 ? 100 : 4095;
                agreements.accept(peer, 5, start, 4, BlockAckVariant::COMPRESSED);
                checkDelivery(receive(makeData(start, "first")), {"first"});
                checkDelivery(receive(makeData((start + 2) % 4096, "third")), {});
                checkDelivery(receive(makeData((start + 1) % 4096, "second")), {"second", "third"});
                checkWindow((start + 3) % 4096, 0, peer);
                auto record = agreements.getAgreement(5, peer)->getBlockAckRecord();
                for (int offset = 0; offset < 4; offset++)
                    ASSERT(record->getCompressedAckState(SequenceNumberCyclic(start) + offset) == (offset < 3));
                break;
            }
            case 10:
                agreements.accept(peer, 5, 100, 4, BlockAckVariant::COMPRESSED);
                agreements.accept(otherPeer, 5, 100, 4, BlockAckVariant::COMPRESSED);
                agreements.accept(peer, 6, 100, 4, BlockAckVariant::COMPRESSED);
                checkDelivery(receive(makeData(101, "peer-one")), {});
                checkDelivery(receive(makeData(101, "peer-two", 0, false, otherPeer)), {});
                checkDelivery(receive(makeData(101, "tid-six", 0, false, peer, 6)), {});
                checkDelivery(receive(makeData(100, "first")), {"first", "peer-one"});
                checkWindow(102, 0, peer);
                checkWindow(100, 1, otherPeer);
                checkWindow(100, 1, peer, 6);
                ASSERT(!agreements.getAgreement(5, otherPeer)->getBlockAckRecord()->getCompressedAckState(SequenceNumberCyclic(100)));
                ASSERT(!agreements.getAgreement(6, peer)->getBlockAckRecord()->getCompressedAckState(SequenceNumberCyclic(100)));
                break;
            case 11: // Successive BARs move the window past half the sequence space without delivery.
                agreements.accept(peer, 5, 0, 64);
                checkDelivery(receiveBar(2000, peer), {});
                checkDelivery(receiveBar(2050, peer), {});
                checkDelivery(receive(makeData(2050, "fragmented-frag0", 0, true)), {});
                checkDelivery(receiveBar(2000, peer), {}); // A stale BAR cannot undo the advance.
                checkWindow(2050, 1, peer);
                checkBasicReceipt(2050, 0, true);
                checkDelivery(receive(makeData(2050, "fragmented-frag1", 1)), {"fragmented"});
                break;
            case 12: // An accepted advance can be exactly half a cycle from the last delivered receipt.
                agreements.accept(peer, 5, 0, 64);
                checkDelivery(receive(makeData(0, "first")), {"first"});
                checkDelivery(receiveBar(2048, peer), {});
                checkDelivery(receive(makeData(2049, "fragmented-frag0", 0, true)), {});
                checkWindow(2048, 1, peer);
                checkBasicReceipt(2048, 1, true);
                break;
            case 13: // DATA can also advance the receive window without delivery.
                agreements.accept(peer, 5, 0, 64);
                checkDelivery(receive(makeData(2047, "preceding-frag0", 0, true)), {});
                checkDelivery(receive(makeData(2050, "fragmented-frag0", 0, true)), {});
                checkWindow(1987, 2, peer);
                checkBasicReceipt(1987, 63, true);
                break;
            case 14: { // A retired receipt must not survive reuse of its sequence number.
                SequenceNumberCyclic start(4095);
                agreements.accept(peer, 5, start.get(), 64);
                checkDelivery(receive(makeData(start.get(), "old-frag0", 0, true)), {});
                checkBasicReceipt(start.get(), 0, true);
                checkDelivery(receiveBar((start + 2000).get(), peer), {});
                checkDelivery(receiveBar((start + 4000).get(), peer), {});
                checkDelivery(receiveBar(start.get(), peer), {});
                checkWindow(start.get(), 0, peer);
                checkBasicReceipt(start.get(), 0, false);
                break;
            }
            case 15:
            case 16: {
                DuplicateDropProbe drops;
                recipient->subscribe(packetDroppedSignal, &drops);
                const bool basic = scenario == 15;
                agreements.accept(peer, 5, 0, 64, basic ? BlockAckVariant::BASIC : BlockAckVariant::COMPRESSED);
                auto agreement = agreements.getAgreement(5, peer);
                auto record = agreement->getBlockAckRecord();
                checkDelivery(receive(makeData(0, "unicast-0")), {"unicast-0"});
                checkWindow(1, 0, peer);
                checkDelivery(receive(makeData(66, "broadcast-66", 0, false, peer, 5, true)), {"broadcast-66"});
                checkWindow(1, 0, peer);
                ASSERT(agreement->getHighestReceivedSequence() == SequenceNumberCyclic(0));
                if (basic)
                    checkBasicReceipt(1, 0, false);
                else {
                    ASSERT(record->getWindowStart() == SequenceNumberCyclic(0));
                    ASSERT(!record->hasCompleteReceipt(SequenceNumberCyclic(66)));
                    ASSERT(!record->getCompressedAckState(SequenceNumberCyclic(1)));
                }
                checkDelivery(receive(makeData(1, "broadcast-1", 0, false, peer, 5, true)), {"broadcast-1"});
                checkWindow(1, 0, peer);
                checkDelivery(receive(makeData(1, "unicast-retry-1", 0, false, peer, 5, false, true)), {"unicast-retry-1"});
                checkWindow(2, 0, peer);
                ASSERT(drops.packets.empty());
                checkDelivery(receive(makeData(1, "duplicate-1", 0, false, peer, 5, false, true)), {});
                ASSERT(drops.packets == std::vector<std::string>{"duplicate-1"});
                checkWindow(2, 0, peer);
                if (basic)
                    checkBasicReceipt(1, 0, true);
                else
                    ASSERT(record->getCompressedAckState(SequenceNumberCyclic(1)));
                checkDelivery(receive(makeData(3, "buffered-3")), {});
                checkDelivery(receive(makeData(3, "duplicate-buffered-3", 0, false, peer, 5, false, true)), {});
                ASSERT((drops.packets == std::vector<std::string>{"duplicate-1", "duplicate-buffered-3"}));
                checkDelivery(receive(makeData(2, "unicast-2")), {"unicast-2", "buffered-3"});
                recipient->unsubscribe(packetDroppedSignal, &drops);
                break;
            }
            case 17: {
                DuplicateDropProbe drops;
                recipient->subscribe(packetDroppedSignal, &drops);
                checkDelivery(receive(makeData(1, "broadcast-1", 0, false, peer, 5, true)), {"broadcast-1"});
                checkDelivery(receive(makeData(1, "unicast-retry-1", 0, false, peer, 5, false, true, NORMAL_ACK)), {"unicast-retry-1"});
                checkDelivery(receive(makeData(1, "duplicate-1", 0, false, peer, 5, false, true, NORMAL_ACK)), {});
                ASSERT(drops.packets == std::vector<std::string>{"duplicate-1"});
                ASSERT(recipient->getReordering()->getBufferCount() == 0);
                drops.packets.clear();
                // Reuse the cached sequence as the start of a fresh agreement.
                agreements.accept(peer, 5, 1, 64);
                checkDelivery(receive(makeData(1, "agreement-retry-1", 0, false, peer, 5, false, true)), {"agreement-retry-1"});
                checkWindow(2, 0, peer);
                checkBasicReceipt(1, 0, true);
                ASSERT(drops.packets.empty());
                recipient->unsubscribe(packetDroppedSignal, &drops);
                break;
            }
            case 18: { // A lost Normal Ack leaves a duplicate of the delivered fragment.
                DuplicateDropProbe drops;
                recipient->subscribe(packetDroppedSignal, &drops);
                agreements.accept(peer, 5, 100, 4);
                checkDelivery(receive(makeData(100, "normal-original", 0, false, peer, 5, false, false, NORMAL_ACK)), {"normal-original"});
                checkWindow(101, 0, peer);
                checkBasicReceipt(100, 0, false);
                checkDelivery(receive(makeData(100, "unseen-fragment", 1, false, peer, 5, false, true, NORMAL_ACK)), {});
                ASSERT(drops.packets.empty());
                checkDelivery(receive(makeData(100, "normal-retry", 0, false, peer, 5, false, true, NORMAL_ACK)), {});
                ASSERT(drops.packets == std::vector<std::string>{"normal-retry"});
                checkBasicReceipt(100, 0, false);
                recipient->unsubscribe(packetDroppedSignal, &drops);
                break;
            }
            case 19: { // The receipt window still covers a sequence that reordering skipped.
                DuplicateDropProbe drops;
                recipient->subscribe(packetDroppedSignal, &drops);
                agreements.accept(peer, 5, 100, 4, BlockAckVariant::COMPRESSED);
                checkDelivery(receive(makeData(100, "first")), {"first"});
                auto bar = makeShared<Ieee80211CompressedBlockAckReq>();
                bar->setTransmitterAddress(peer);
                bar->setReceiverAddress(receiver);
                bar->setTidInfo(5);
                bar->setChunkLength(LENGTH_BLOCKACKREQ - B(4));
                bar->setStartingSequenceNumber(SequenceNumberCyclic(101));
                auto request = new Packet("compressed-bar", bar);
                checkDelivery(recipient->controlFrameReceived(request, bar, &agreements), {});
                delete request;
                auto record = agreements.getAgreement(5, peer)->getBlockAckRecord();
                ASSERT(record->getWindowStart() == SequenceNumberCyclic(101));
                checkDelivery(receive(makeData(102, "after-gap"), true), {"after-gap"});
                checkWindow(103, 0, peer);
                ASSERT(!record->getCompressedAckState(SequenceNumberCyclic(101)));
                checkDelivery(receive(makeData(101, "first-seen-retry", 0, false, peer, 5, false, true)), {});
                ASSERT(drops.packets.empty());
                ASSERT(record->getCompressedAckState(SequenceNumberCyclic(101)));
                checkDelivery(receive(makeData(101, "repeat-late-retry", 0, false, peer, 5, false, true)), {});
                ASSERT(drops.packets == std::vector<std::string>{"repeat-late-retry"});
                recipient->unsubscribe(packetDroppedSignal, &drops);
                break;
            }
            default:
                throw cRuntimeError("Unknown recipient scenario");
        }
        std::cout << "Recipient reordering checks passed.\n";
    }

    void initialize() override { scheduleAt(SIMTIME_ZERO, new cMessage("checkRecipient")); }
};
Define_Module(RecipientReorderingTest);
}

%file: RecipientReorderingNetwork.ned
import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mac.recipient.RecipientQosMacDataService;

module ReorderingRecipient extends RecipientQosMacDataService
{
    parameters:
        @class(::inet::ieee80211::ReorderingRecipient);
}

simple RecipientReorderingTest extends SimpleModule
{
    parameters:
        int scenario;
        @class(::inet::ieee80211::RecipientReorderingTest);
}

network RecipientReorderingNetwork
{
    submodules:
        recipient: ReorderingRecipient;
        test: RecipientReorderingTest;
}

%inifile: omnetpp.ini
[General]
network = RecipientReorderingNetwork
sim-time-limit = 1ms
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.test.scenario = ${scenario=0..19}

%contains: stdout
Recipient reordering checks passed.
