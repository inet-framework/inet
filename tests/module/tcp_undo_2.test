%description:
Tests that the undo of a reduction needs a D-SACK for every retransmission of
the episode (Linux undo_retrans). The tester delays one segment of a burst
by 0.3 ms and drops another. The fast recovery retransmits both: the delayed
one needlessly, the dropped one by step (C) of RFC 6675. The receiver reports
only the first by a D-SACK, so the reduction stays: the retransmission by
step (C) counts too, and a loss was real.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="A7 delay 0.0003; A9 delete"  # one segment late, one lost

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 2000;2 3000;3 500"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.lossUndoEnabled = true
*.*_tcp.increasedIWEnabled = true



%# the needless retransmission is reported by a D-SACK...
%contains: stdout
[2.007 B011] A.1000 < B.2000: A ack 3001 win 4000   Option(s): NOP NOP SACK[2001,2501)[3501,5001)

%# ...but the other retransmission repaired a real loss, so nothing is undone
%not-contains: stdout
Undoing spurious cwnd reduction

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
