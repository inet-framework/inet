%description:
Check Basic setup deferral through wireless DATA, ADDBA, ACK, and DELBA exchanges.
The receiver holds its actual response queue until 150 ms after request ACK.
The 100 ms default must expire; a 250 ms timeout must accept the delayed response.
Other runs check first-DATA numbering, deferred voice versus eligible video, and genuine collision.
Request delays of 100 ms and 450 ms reverse the response deadline and DATA lifetime order.
Newer DATA must preserve the response deadline after the original DATA expires.
RTS failure and lifetime expiry must retire an agreement before its first DATA transmission.
Spaced DATA must start setup before later extraction after an earlier eligible DATA completes.
The same rule applies when greedy A-MSDU aggregation empties the earlier queue.
All runs use seed 0 and zero contention windows.

%extraargs: -r 0..11

%file: Deferral.cc
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/Rx.h"
#include "inet/linklayer/ieee80211/mac/contract/IContention.h"

using namespace inet;
using namespace inet::ieee80211;

class DeferralHcf : public Hcf {
  public:
    int requests = 0;
    int delbas = 0;
    int dataVoice = 0;
    int dataVideo = 0;
    int dataAfterRequest = 0;
    int dataWithAgreement = 0;
    int dataAfterDelba = 0;
    int aggregatesAccepted = 0;
    int requestStart = -1;
    int firstData = -1;
    simtime_t requestAccepted = SIMTIME_MAX;
    simtime_t requestAck = SIMTIME_MAX;
    simtime_t observedDeadline = SIMTIME_MAX;
    simtime_t responseQueued = SIMTIME_MAX;
    simtime_t responseAccepted = SIMTIME_MAX;
    simtime_t responseReceived = SIMTIME_MAX;
    bool holdResponse = false;
    bool holdRequest = false;
    bool dropProtectedCts = false;
    int droppedCts = 0;
    int firstRtsSequence = -1;
    int rtsFailures = 0;
    bool dataEligible(Packet *frame) const { return isFrameEligible(frame, false); }
    bool hasAgreement(Tid tid) const {
        auto agreement = originatorBlockAckAgreementHandler->getAgreement(MacAddress("02:00:00:00:00:02"), tid);
        return agreement && agreement->getIsAddbaResponseReceived();
    }
    bool deferred(Tid tid) const {
        const auto& procedures = originatorBlockAckAgreementHandler->getProcedures();
        return procedures.count({MacAddress("02:00:00:00:00:02"), tid}) != 0;
    }
    bool contending(AccessCategory ac) const {
        return check_and_cast<IContention *>(edca->getEdcaf(ac)->getSubmodule("contention"))->isContentionInProgress();
    }
    void processMgmtFrame(Packet *frame, const Ptr<const Ieee80211MgmtHeader>& header) override {
        if (dynamicPtrCast<const Ieee80211AddbaResponse>(header) && responseQueued == SIMTIME_MAX) {
            responseQueued = simTime();
            if (holdResponse)
                rx->setContentionBlocked(true);
        }
        Hcf::processMgmtFrame(frame, header);
    }
  protected:
    void transmitControlResponseFrame(Packet *response, const Ptr<const Ieee80211MacHeader>& responseHeader,
            Packet *received, const Ptr<const Ieee80211MacHeader>& receivedHeader) override {
        if (dropProtectedCts && droppedCts == 0 && responseAccepted != SIMTIME_MAX && dynamicPtrCast<const Ieee80211RtsFrame>(receivedHeader)) {
            droppedCts++;
            delete response;
            return;
        }
        Hcf::transmitControlResponseFrame(response, responseHeader, received, receivedHeader);
    }
    void originatorProcessRtsProtectionFailed(Packet *frame) override {
        if (requestStart >= 0) {
            auto data = dynamicPtrCast<const Ieee80211DataHeader>(frame->peekAtFront<Ieee80211MacHeader>());
            if (data && data->getTid() == 6) {
                rtsFailures++;
                if (firstRtsSequence < 0)
                    firstRtsSequence = data->getSequenceNumber().get();
            }
        }
        Hcf::originatorProcessRtsProtectionFailed(frame);
    }
    void frameSequenceFinished() override {
        Hcf::frameSequenceFinished();
        if (holdRequest && requestAccepted == SIMTIME_MAX && deferred(6))
            rx->setContentionBlocked(true);
    }
    void sendUp(const std::vector<Packet *>& frames) override {
        for (auto frame : frames) {
            take(frame);
            delete frame;
        }
    }
    bool transmitFrame(Packet *frame, simtime_t ifs) override {
        auto header = frame->peekAtFront<Ieee80211MacHeader>();
        bool accepted = Hcf::transmitFrame(frame, ifs);
        if (!accepted)
            return false;
        if (auto request = dynamicPtrCast<const Ieee80211AddbaRequest>(header)) {
            requests++;
            if (requestStart < 0) {
                requestStart = request->getStartingSequenceNumber().get();
                requestAccepted = simTime();
                ASSERT(observedDeadline == SIMTIME_MAX);
            }
        }
        if (dynamicPtrCast<const Ieee80211Delba>(header))
            delbas++;
        if (dynamicPtrCast<const Ieee80211AddbaResponse>(header) && responseAccepted == SIMTIME_MAX)
            responseAccepted = simTime();
        if (auto data = dynamicPtrCast<const Ieee80211DataHeader>(header)) {
            if (data->getAMsduPresent()) aggregatesAccepted++;
            if (data->getTid() == 6) dataVoice++;
            if (data->getTid() == 5) dataVideo++;
            if (requestStart >= 0 && data->getTid() == 6) {
                if (hasAgreement(6))
                    dataWithAgreement++;
                if (delbas > 0 && !hasAgreement(6)) {
                    ASSERT(data->getAckPolicy() == NORMAL_ACK);
                    dataAfterDelba++;
                }
                if (firstData < 0) firstData = data->getSequenceNumber().get();
                dataAfterRequest++;
            }
        }
        return true;
    }
    void originatorProcessReceivedControlFrame(Packet *frame, const Ptr<const Ieee80211MacHeader>& header,
            Packet *last, const Ptr<const Ieee80211MacHeader>& lastHeader, AccessCategory ac) override {
        bool request = dynamicPtrCast<const Ieee80211AddbaRequest>(lastHeader) != nullptr;
        Hcf::originatorProcessReceivedControlFrame(frame, header, last, lastHeader, ac);
        if (request && requestAck == SIMTIME_MAX) {
            requestAck = simTime();
            auto it = originatorBlockAckAgreementHandler->getProcedures().find({MacAddress("02:00:00:00:00:02"), 6});
            if (it != originatorBlockAckAgreementHandler->getProcedures().end())
                observedDeadline = it->second.responseDeadline;
        }
    }
    void recipientProcessReceivedManagementFrame(const Ptr<const Ieee80211MgmtHeader>& header) override {
        if (dynamicPtrCast<const Ieee80211AddbaResponse>(header) && responseReceived == SIMTIME_MAX)
            responseReceived = simTime();
        Hcf::recipientProcessReceivedManagementFrame(header);
    }
};
Define_Module(DeferralHcf);

class DeferralTest : public cSimpleModule, public cListener {
    int collisions = 0;
    int videoRetryDrops = 0;
    int lifetimeDrops = 0;
  protected:
    void receiveSignal(cComponent *, simsignal_t, unsigned long value, cObject *) override { collisions += value; }
    void receiveSignal(cComponent *, simsignal_t, cObject *object, cObject *details) override {
        auto drop = check_and_cast<PacketDropDetails *>(details);
        auto header = dynamicPtrCast<const Ieee80211DataHeader>(check_and_cast<Packet *>(object)->peekAtFront<Ieee80211MacHeader>());
        if (drop->getReason() == RETRY_LIMIT_REACHED && header && header->getTid() == 5)
            videoRetryDrops++;
        if (drop->getReason() == LIFETIME_EXPIRED)
            lifetimeDrops++;
    }
    Packet *accept(DeferralHcf *hcf, Tid tid) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setTid(tid);
        header->setSequenceNumber(SequenceNumberCyclic(77));
        header->setReceiverAddress(MacAddress("02:00:00:00:00:02"));
        header->setTransmitterAddress(MacAddress("02:00:00:00:00:01"));
        header->setAddress3(header->getReceiverAddress());
        auto frame = new Packet(tid == 6 ? "voice-data" : "video-data", header);
        frame->insertAtBack(makeShared<ByteCountChunk>(B(100)));
        frame->insertAtBack(makeShared<Ieee80211MacTrailer>());
        hcf->processUpperFrame(frame, header);
        return frame;
    }
    void activity() override {
        auto sender = check_and_cast<DeferralHcf *>(getModuleByPath("^.sender.wlan[0].mac.hcf"));
        auto receiver = check_and_cast<DeferralHcf *>(getModuleByPath("^.receiver.wlan[0].mac.hcf"));
        auto senderRx = check_and_cast<Rx *>(getModuleByPath("^.sender.wlan[0].mac.rx"));
        auto receiverRx = check_and_cast<Rx *>(getModuleByPath("^.receiver.wlan[0].mac.rx"));
        int scenario = par("scenario");
        sender->subscribe(Hcf::edcaCollisionDetectedSignal, this);
        sender->subscribe(packetDroppedSignal, this);
        senderRx->setContentionBlocked(true);
        if (scenario >= 10) {
            auto edca = check_and_cast<Edca *>(sender->getSubmodule("edca"));
            accept(sender, 6);
            if (scenario == 11)
                accept(sender, 6);
            senderRx->setContentionBlocked(false);
            wait(SimTime(5, SIMTIME_MS));
            ASSERT(sender->dataVoice == 1);
            ASSERT(sender->aggregatesAccepted == (scenario == 11 ? 1 : 0));
            ASSERT(sender->requests == 0);
            ASSERT(edca->getEdcaf(AC_VO)->getPendingQueue()->isEmpty());
            ASSERT(edca->getEdcaf(AC_VO)->getInProgressFrames()->getLength() == 0);
            auto later = accept(sender, 6);
            bool deferredBeforeExtraction = !sender->dataEligible(later);
            if (scenario == 11)
                accept(sender, 6);
            std::cout << "Later DATA admission at " << simTime() << ": deferred=" << deferredBeforeExtraction << ".\n";
            wait(SimTime(5, SIMTIME_MS));
            std::cout << "Spaced DATA: requests=" << sender->requests << ", DATA accepted=" << sender->dataVoice
                << ", aggregates=" << sender->aggregatesAccepted << ", request start=" << sender->requestStart
                << ", first DATA=" << sender->firstData << ".\n";
            ASSERT(deferredBeforeExtraction);
            ASSERT(sender->requests == 1 && !sender->hasAgreement(6) && sender->delbas == 1);
            ASSERT(sender->requestStart == 1 && sender->firstData == sender->requestStart);
            ASSERT(sender->dataAfterRequest == 1);
            ASSERT(sender->aggregatesAccepted == (scenario == 11 ? 2 : 0));
        }
        else if (scenario == 4) {
            accept(sender, 6);
            accept(sender, 5);
            ASSERT(sender->contending(AC_VO) && sender->contending(AC_VI));
            senderRx->setContentionBlocked(false);
            wait(SimTime(50, SIMTIME_US));
            ASSERT(sender->dataVoice == 1 && sender->dataVideo == 0);
            ASSERT(collisions == 1 && videoRetryDrops == 1);
        }
        else {
            receiver->holdResponse = scenario != 2 && scenario < 8;
            receiver->dropProtectedCts = scenario >= 8;
            sender->holdRequest = scenario >= 5 && scenario != 8;
            accept(sender, 6);
            accept(sender, 6);
            auto deferredFrame = accept(sender, 6);
            auto deferredId = deferredFrame->getId();
            ASSERT(sender->contending(AC_VO));
            senderRx->setContentionBlocked(false);
            wait(SimTime(5, SIMTIME_MS));
            if (scenario >= 5 && scenario != 8) {
                ASSERT(sender->requests == 0 && sender->requestAck == SIMTIME_MAX);
                ASSERT(sender->deferred(6));
                auto release = SimTime(scenario == 9 ? 500 : scenario == 5 ? 100 : 450, SIMTIME_MS);
                wait(release - simTime());
                sender->holdRequest = false;
                senderRx->setContentionBlocked(false);
                wait(SimTime(5, SIMTIME_MS));
            }
            std::cout << "Requests=" << sender->requests << ", start=" << sender->requestStart << ", voice DATA=" << sender->dataVoice << ".\n";
            ASSERT(sender->requests == 1);
            ASSERT(sender->requestStart == sender->dataVoice - sender->dataAfterRequest);
            ASSERT(sender->requestAck != SIMTIME_MAX);
            ASSERT(sender->requestAck > sender->requestAccepted);
            auto timeout = SimTime(scenario == 1 ? 250 : 100, SIMTIME_MS);
            ASSERT(sender->observedDeadline == sender->requestAck + timeout);
            if (scenario >= 8) {
                if (scenario == 9)
                    wait(SimTime(560, SIMTIME_MS) - simTime());
                ASSERT(sender->rtsFailures >= 1);
                ASSERT(sender->firstRtsSequence == sender->requestStart);
                ASSERT(sender->dataWithAgreement == 0);
                if (scenario == 8) {
                    ASSERT(sender->dataAfterRequest == 1 && sender->dataAfterDelba == 1);
                    ASSERT(sender->firstData == (sender->requestStart + 1) % 4096);
                }
                else
                    ASSERT(sender->dataAfterRequest == 0 && sender->firstData == -1);
                ASSERT(!sender->hasAgreement(6));
                ASSERT(sender->delbas == 1);
                ASSERT(lifetimeDrops == (scenario == 9 ? 2 : 0));
            }
            else if (scenario >= 5) {
                auto edca = check_and_cast<Edca *>(sender->getSubmodule("edca"));
                auto lifetime = edca->getLifetimeHandler();
                ASSERT(lifetime->getDeadline(deferredFrame) == SimTime(512, SIMTIME_MS));
                if (scenario == 5) {
                    ASSERT(sender->observedDeadline < SimTime(512, SIMTIME_MS));
                    wait(sender->observedDeadline + SimTime(5, SIMTIME_MS) - simTime());
                    ASSERT(sender->delbas == 1 && sender->dataAfterRequest == 1);
                    ASSERT(lifetimeDrops == 0);
                }
                else {
                    ASSERT(sender->observedDeadline > SimTime(512, SIMTIME_MS));
                    if (scenario == 7) {
                        wait(SimTime(480, SIMTIME_MS) - simTime());
                        accept(sender, 6);
                    }
                    wait(SimTime(513, SIMTIME_MS) - simTime());
                    // Preview leaves both unsent frames under their original lifetime deadlines.
                    ASSERT(lifetimeDrops == 2 && lifetime->findFrame(deferredId) == nullptr);
                    if (scenario == 6)
                        ASSERT(sender->delbas == 1 && sender->dataAfterRequest == 0);
                    else {
                        ASSERT(sender->delbas == 0 && sender->deferred(6));
                        wait(sender->observedDeadline + SimTime(5, SIMTIME_MS) - simTime());
                        ASSERT(sender->delbas == 1 && sender->dataAfterRequest == 1);
                    }
                }
                std::cout << "Request release=" << SimTime(scenario == 5 ? 100 : 450, SIMTIME_MS) << ", request ACK=" << sender->requestAck
                    << ", response deadline=" << sender->observedDeadline << ", original DATA deadline=0.512.\n";
            }
            else if (scenario == 2) {
                ASSERT(sender->dataAfterRequest == 2);
                ASSERT(sender->firstData == sender->requestStart);
            }
            else {
                ASSERT(sender->deferred(6));
                ASSERT(sender->dataAfterRequest == 0);
                ASSERT(deferredFrame->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber() == SequenceNumberCyclic(77));
                ASSERT(!sender->contending(AC_VO));
                std::cout << "The pre-setup VO request resolved. Deferred VO has no contention request at " << simTime() << ".\n";
                if (scenario == 3) {
                    accept(sender, 5);
                    wait(SimTime(5, SIMTIME_MS));
                    ASSERT(sender->dataVideo == 1);
                    ASSERT(sender->dataAfterRequest == 0);
                    ASSERT(collisions == 0 && videoRetryDrops == 0);
                }
                else {
                    wait(sender->requestAck + SimTime(150, SIMTIME_MS) - simTime());
                    receiverRx->setContentionBlocked(false);
                    wait(SimTime(10, SIMTIME_MS));
                    if (scenario == 1) {
                        ASSERT(receiver->responseAccepted != SIMTIME_MAX);
                        ASSERT(receiver->responseAccepted >= sender->requestAck + SimTime(150, SIMTIME_MS));
                    }
                    std::cout << "Request ACK=" << sender->requestAck << ", response deadline=" << sender->observedDeadline
                        << ", response queued=" << receiver->responseQueued << ", response Tx accepted=" << receiver->responseAccepted << ".\n";
                    if (scenario == 0) {
                        ASSERT(sender->delbas >= 1);
                        ASSERT(!sender->hasAgreement(6));
                    }
                    else {
                        // The accepted response releases the final DATA before completion causes DELBA.
                        ASSERT(simTime() < sender->observedDeadline);
                        ASSERT(sender->delbas == 1);
                        ASSERT(!sender->hasAgreement(6));
                        std::cout << "Completed deferred DATA: " << sender->dataAfterRequest << ".\n";
                        ASSERT(sender->dataAfterRequest == 2);
                        ASSERT(sender->firstData == sender->requestStart);
                    }
                }
            }
        }
        sender->unsubscribe(Hcf::edcaCollisionDetectedSignal, this);
        sender->unsubscribe(packetDroppedSignal, this);
        std::cout << "Block Ack deferral scenario " << scenario << " passed.\n";
        endSimulation();
    }
  public:
    DeferralTest() : cSimpleModule(65536) {}
};
Define_Module(DeferralTest);

%file: test.ned
import inet.node.inet.WirelessHost;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.linklayer.ieee80211.mac.blockack.OriginatorBlockAckAgreementPolicy;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
module DeferralHcf extends Hcf { parameters: @class(::DeferralHcf); }
simple LongTimeoutPolicy extends OriginatorBlockAckAgreementPolicy { parameters: addbaFailureTimeout = 250ms; }
simple DeferralTest { parameters: int scenario; @class(::DeferralTest); }
network DeferralNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        sender: WirelessHost;
        receiver: WirelessHost;
        test: DeferralTest;
}

%inifile: omnetpp.ini
[General]
network = DeferralNetwork
sim-time-limit = 1s
seed-set = 0
ned-path = .;../../../../src;../../lib
cmdenv-express-mode = true
record-scalar-results = false
record-vector-results = false
*.test.scenario = ${scenario=0..11}
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 6Mbps
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "DeferralHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = ${scenario} != 4
**.wlan[*].mac.hcf.originatorBlockAckAgreementPolicy.typename = ${policy="OriginatorBlockAckAgreementPolicy","LongTimeoutPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy","OriginatorBlockAckAgreementPolicy" ! scenario}
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ${aggregation="","","","","","","","","","","","BasicMsduAggregationPolicy" ! scenario}
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.subframeNumThreshold = 2
**.wlan[*].mac.hcf.rateSelection.dataFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rtsPolicy.rtsThreshold = ${scenario} >= 8 && ${scenario} <= 9 ? 1B : 2346B
**.wlan[*].mac.hcf.rtsPolicy.ctsTimeout = ${scenario} == 9 ? 50ms : -1s
**.wlan[*].mac.hcf.edca.edcaf[*].cwMin = 0
**.wlan[*].mac.hcf.edca.edcaf[*].cwMax = 0
**.wlan[*].mac.hcf.edca.edcaf[*].recoveryProcedure.shortRetryLimit = ${scenario} == 9 ? 10 : 1
*.sender.wlan[0].address = "02:00:00:00:00:01"
*.receiver.wlan[0].address = "02:00:00:00:00:02"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.sender.mobility.initialX = 0m
*.sender.mobility.initialY = 0m
*.receiver.mobility.initialX = 1m
*.receiver.mobility.initialY = 0m

%contains: stdout
Block Ack deferral scenario 11 passed.
