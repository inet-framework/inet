%description:
Tests the default CLOSE of RFC 9293 (abortOnDataAfterClose=false): the
server application closes at t=1, and the data that the client sends at
t=1.5 still reaches the server. After a CLOSE the application may still
receive, so the server acknowledges the data and does not reset.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.srv_app.tClose=1s
*.cli_app.sendScript="1.5 500"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "^\[testing\]\|finishing with\|received .* bytes\|Notifying app: CLOSED" test.out > test_1.out || true
%contains: test_1.out
[testing]: [1.501 A004] A.1000 > B.2000: A 1:501(500) ack 502 win 16384
[testing]: [1.703 B003] A.1000 < B.2000: A ack 501 win 16384

%contains: test_1.out
[]: TcpTestNet1.srv_app: received 500 bytes in 1 packets

%not-contains: test_1.out
Notifying app: CLOSED
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
