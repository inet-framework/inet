%description:
Tests the sequence number of a pure ACK during a retransmission. The tester
deletes the three segments of the client (1:3001), and the client sends the
first again after the RTO, so snd_nxt is 1001 and snd_max 3001. The server's
data arrives then, and the client's ACK for it carries seq 3001, the SND.NXT of
RFC 9293, which a retransmission does not move back (as BSD and Linux); master
put snd_nxt (1001) on it.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 3000"
*.*_tcp.mss = 1000
*.cli_tcp.increasedIWEnabled = true
*.cli_tcp.delayedAcksEnabled = false
*.srv_app.tSend = 4s
*.srv_app.sendBytes = 100B
*.tcptester.script="A3 delete; A4 delete; A5 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 # deleting
[1.001 A004] A.1000 > B.2000: A 1001:2001(1000) ack 501 win 16384 # deleting
[1.001 A005] A.1000 > B.2000: A 2001:3001(1000) ack 501 win 16384 # deleting
[4.001 A006] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[4.001 B002] A.1000 < B.2000: A 501:601(100) ack 1 win 16384 
[4.003 A007] A.1000 > B.2000: A ack 601 win 16384 
[4.203 B003] A.1000 < B.2000: A ack 1001 win 16384 
[4.205 A008] A.1000 > B.2000: A 1001:2001(1000) ack 601 win 16384 
[4.205 A009] A.1000 > B.2000: A 2001:3001(1000) ack 601 win 16384 
[4.207 B004] A.1000 < B.2000: A ack 3001 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Sending: .1000 > .2000: seq 3001 ack 601
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
