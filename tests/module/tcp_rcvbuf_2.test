%description:
Tests receiveBufferSize smaller than the advertised window. The server offers
4000 bytes but has a receive buffer of 2000 bytes, and its application reads
late. The SYN-ACK offers only the buffer (2000), and the unread data then
closes the window (1000, then 0).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 4000"
*.*_tcp.mss = 1000
*.*_tcp.delayedAcksEnabled = false
*.srv_tcp.advertisedWindow = 4000
*.srv_tcp.receiveBufferSize = 2000B
*.srv_app.autoRead=false
*.srv_app.readScript="3 2000; 4 2000"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.001 A001] A.1000 > B.2000: S 0:0(0) win 16384   Option(s): MaxSegSize
srv_tcp: LISTEN --> SYN_RCVD  (on RCV_SYN)
[0.003 B001] A.1000 < B.2000: A S 500:500(0) ack 1 win 2000   Option(s): MaxSegSize
cli_tcp: SYN_SENT --> ESTABLISHED  (on RCV_SYN_ACK)
[0.005 A002] A.1000 > B.2000: A ack 501 win 16384 
srv_tcp: SYN_RCVD --> ESTABLISHED  (on RCV_ACK)
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.003 B002] A.1000 < B.2000: A ack 1001 win 1000 
[1.005 A004] A.1000 > B.2000: A 1001:2001(1000) ack 501 win 16384 
[1.007 B003] A.1000 < B.2000: A ack 2001 win 0 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
