%description:

The getters of every transmission and reception in progress on a radio with
the defaults, which transmits one signal and attempts one reception at a
time: halfway through the only signal, getTransmissionsInProgress() at the
sender and getReceptionsInProgress() at the receiver hold exactly the
transmission that getTransmissionInProgress() and getReceptionInProgress()
answer; after it, both are empty.

%file: test.cc

#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadio.h"

using namespace inet;
using namespace inet::physicallayer;

namespace Radio_InProgressGetters {

// Hands one packet to the radio, then reports what its radio has in progress
// halfway through the signal and after it.
class TestSource : public cSimpleModule
{
  protected:
    virtual void initialize() override
    {
        scheduleAt(0, new cMessage("start"));
        scheduleAt(SimTime(200, SIMTIME_US), new cMessage("probe"));
        scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("probe"));
    }
    virtual void handleMessage(cMessage *msg) override
    {
        if (!strcmp(msg->getName(), "probe")) {
            auto radio = check_and_cast<IRadio *>(getParentModule()->getSubmodule("radio"));
            auto transmissions = radio->getTransmissionsInProgress();
            std::cout << "source: " << transmissions.size() << " transmissions in progress at " << simTime() << std::endl;
            if (transmissions.size() == 1 && transmissions[0] == radio->getTransmissionInProgress())
                std::cout << "source: it is the transmission in progress" << std::endl;
        }
        else {
            auto packet = new Packet("data", makeShared<ByteCountChunk>(B(100)));
            packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::apskPhy);
            send(packet, "out");
        }
        delete msg;
    }
};

Define_Module(TestSource);

// Switches its radio to receiver mode at the start, reports what its radio
// attempts halfway through the signal and after it, and counts what the radio
// sends up.
class TestSink : public cSimpleModule
{
  protected:
    int received = 0;
    virtual void initialize() override
    {
        scheduleAt(0, new cMessage("switchToReceiver"));
        scheduleAt(SimTime(200, SIMTIME_US), new cMessage("probe"));
        scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("probe"));
    }
    virtual void handleMessage(cMessage *msg) override
    {
        if (msg->isSelfMessage()) {
            auto radio = check_and_cast<IRadio *>(getParentModule()->getSubmodule("radio"));
            if (!strcmp(msg->getName(), "probe")) {
                auto receptions = radio->getReceptionsInProgress();
                std::cout << "sink: " << receptions.size() << " receptions in progress at " << simTime() << std::endl;
                if (receptions.size() == 1 && receptions[0] == radio->getReceptionInProgress())
                    std::cout << "sink: it is the reception in progress" << std::endl;
            }
            else
                radio->setRadioMode(IRadio::RADIO_MODE_RECEIVER);
            delete msg;
            return;
        }
        received++;
        delete msg;
    }
    virtual void finish() override { std::cout << "sink: received " << received << " packets" << std::endl; }
};

Define_Module(TestSink);

} // namespace Radio_InProgressGetters

%file: test.ned

import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.apsk.packetlevel.ApskDimensionalRadio;
import inet.physicallayer.wireless.common.medium.DimensionalRadioMedium;

simple TestSource
{
    @class(TestSource);
    gates:
        output out;
}

simple TestSink
{
    @class(TestSink);
    gates:
        input in;
}

module SenderNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
        source: TestSource;
    connections allowunconnected:
        source.out --> radio.upperLayerIn;
}

module ReceiverNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
        sink: TestSink;
    connections allowunconnected:
        radio.upperLayerOut --> sink.in;
}

network Test
{
    submodules:
        radioMedium: DimensionalRadioMedium;
        sender: SenderNode;
        receiver: ReceiverNode;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 10ms
ned-path = .;../../../../src
cmdenv-express-mode = false

**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
*.sender.mobility.initialX = 400m
*.receiver.mobility.initialX = 500m

*.radioMedium.backgroundNoise.power = -110dBm

**.radio.antenna.mobilityModule = "^.^.mobility"
**.radio.centerFrequency = 2.4GHz
**.radio.bandwidth = 2MHz
**.radio.transmitter.bitrate = 2Mbps
**.radio.transmitter.preambleDuration = 0s
**.radio.transmitter.headerLength = 96b
**.radio.transmitter.power = 100mW
**.radio.receiver.energyDetection = -90dBm
**.radio.receiver.sensitivity = -80dBm
**.radio.receiver.snirThreshold = 10dB
*.sender.radio.initialRadioMode = "transmitter"

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
source: 1 transmissions in progress at 0.0002
%contains: stdout
source: it is the transmission in progress
%contains: stdout
sink: 1 receptions in progress at 0.0002
%contains: stdout
sink: it is the reception in progress
%contains: stdout
source: 0 transmissions in progress at 0.001
%contains: stdout
sink: 0 receptions in progress at 0.001
%contains: stdout
sink: received 1 packets
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
