%description:
Tests the default send MSS of RFC 9293 MUST-15 on the passive side: the
client sends no MSS option in its SYN (sendMssOption=false), so the server
sends with the IPv4 default of 536 bytes: its 1000 bytes go out as 536 and
464 bytes.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

*.cli_tcp.sendMssOption = false
*.srv_app.sendScript="1.0 1000"

include ../../lib/defaults.ini

%contains: stdout
[1.001 B002] A.1000 < B.2000: A 501:1037(536) ack 1 win 16384

%contains: stdout
[1.205 B003] A.1000 < B.2000: A 1037:1501(464) ack 1 win 16384

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
