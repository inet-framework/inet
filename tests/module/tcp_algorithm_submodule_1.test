%description:
Tests that the algorithm of a connection is its submodule `algorithm`, of
the NED type that tcpAlgorithmClass names. The client has Tcp, with its
default TcpNewReno. The server has LinuxTcp, with TcpCubic, and the
connection that its listener forks has the type of the listener's
algorithm. The log prefix shows the path and the NED type of the module
that writes each line.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="{%d|%y} "

*.testing=true

*.tcptester.script=""

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 30000"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.srv_tcp.typename = "LinuxTcp"

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
my %seen;
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^(\{[^|}]*\.algorithm\|[^}]*\})/ && !$seen{$1}++)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
{TcpTestNet1.cli_tcp.conn-0.algorithm|inet.transportlayer.tcp.flavours.TcpNewReno}
%contains: postrun-command(1).out
{TcpTestNet1.srv_tcp.conn-3.algorithm|inet.transportlayer.tcp.flavours.TcpCubic}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
