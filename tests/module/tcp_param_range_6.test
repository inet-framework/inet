%description:
Tests the range check of the Tcp parameters: maxPersistTimeout = 0s stops the
simulation with an error at the open, because 0 sends the zero-window probes
without a pause.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 20000"
*.cli_tcp.maxPersistTimeout = 0s

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%exitcode: 1
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "<!>" test.* > test_err.out || true
%contains: test_err.out
maxPersistTimeout must be more than 0, but it is 0
%#--------------------------------------------------------------------------------------------------------------
