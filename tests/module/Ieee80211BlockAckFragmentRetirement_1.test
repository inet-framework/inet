%description:
Check the sequence boundary after ordinary originator teardown of fragmented DATA.
IEEE Std 802.11-2024, 11.5.3.4 requires the next MPDU to use a later sequence
when the originator discards the last transmitted MPDU.
The fixture supplies accepted Basic agreements and injects immediate ACKs and Basic Block Ack responses.
Production fragmentation, inactivity expiry, retirement, and transmission remain active.
Runs cover sequence 0 and wraparound at 4095, with expiry during transmission
or after the first fragment receives its Normal Ack.
Later intact DATA and an unrelated peer must retain their transmissions.
Additional runs transmit an earlier DATA unit before a gap in sequence allocation.
The fixture extracts and disposes of the skipped DATA through the production allocator.
Distances 2047, 2048, 2049, and 4096 cover the half-range boundary and a full wrap.
A deferred successor keeps the transfer open while the fixture advances the allocator.

%extraargs: -r 0..19

%file: FragmentRetirement.cc
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/originator/OriginatorQosMacDataService.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

namespace inet::ieee80211 {
class FragmentRetirementOriginator : public OriginatorBlockAckAgreementHandler {
  public:
    void accept(MacAddress peer, int start, simtime_t timeout) {
        auto agreement = new OriginatorBlockAckAgreement(peer, 5, SequenceNumberCyclic(start), 64, false, false);
        agreement->setIsAddbaRequestSent(true);
        agreement->setIsAddbaResponseReceived(true);
        agreement->setBlockAckTimeoutValue(timeout);
        agreement->calculateExpirationTime();
        blockAckAgreements[{peer, 5}] = agreement;
    }
};

class FragmentRetirementHcf : public Hcf {
    const MacAddress peer = MacAddress("02:00:00:00:00:02");
    const MacAddress other = MacAddress("02:00:00:00:00:03");
    int start = 0;
    int distance = 0;
    bool acknowledgedFirst = false;
    bool firstCompleted = false;
    bool firstAcknowledged = false;
    bool retired = false;
    bool successorSent = false;
    bool otherSent = false;
    bool otherRetired = false;
    Ptr<const Ieee80211BasicBlockAckReq> pendingBar;
    Packet *deferredSuccessor = nullptr;
    int delbas = 0;

    void skipData(int count) {
        auto queue = edca->getEdcaf(AC_VI)->getPendingQueue();
        for (int i = 0; i < count; i++) {
            auto header = makeShared<Ieee80211DataHeader>();
            header->setType(ST_DATA_WITH_QOS);
            header->setReceiverAddress(peer);
            header->setTid(5);
            auto packet = new Packet("sequence-setup", header);
            packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
            queue->enqueuePacket(packet);
            auto frames = originatorDataService->extractFramesToTransmit(queue);
            for (auto frame : *frames) {
                take(frame);
                delete frame;
            }
            delete frames;
        }
    }

    void startRetirement() {
        auto agreement = originatorBlockAckAgreementHandler->getAgreement(peer, 5);
        agreement->setStartingSequenceNumber(SequenceNumberCyclic(start));
        agreement->setBlockAckTimeoutValue(SimTime(1024, SIMTIME_US));
        agreement->calculateExpirationTime();
        scheduleInactivityTimer();
        scheduleAfter(SimTime(acknowledgedFirst ? 650 : 974, SIMTIME_US), new cMessage("queue-data"));
    }

    Packet *queueData(const char *name, MacAddress address, int length) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setTid(5);
        header->setReceiverAddress(address);
        header->setTransmitterAddress(mac->getAddress());
        header->setAddress3(address);
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(length)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
        return packet;
    }

  public:
    void begin() {
        Enter_Method("begin");
        start = par("startSequence");
        distance = par("sequenceDistance");
        acknowledgedFirst = par("acknowledgedFirst");
        delete originatorBlockAckAgreementHandler;
        auto handler = new FragmentRetirementOriginator();
        originatorBlockAckAgreementHandler = handler;
        handler->accept(peer, start, SIMTIME_ZERO);
        handler->accept(other, 0, SIMTIME_ZERO);
        // Advance the production allocator without a radio exchange for each earlier sequence.
        skipData(start);
        subscribe(blockAckAgreementDeletedSignal, this);
        if (distance == 0)
            startRetirement();
        else {
            check_and_cast<OriginatorQosMacDataService *>(originatorDataService)->setEligibility(
                [this](Packet *packet) { return !packet->isName("deferred-successor") && isFrameEligible(packet, false); },
                [this](Packet *packet) { return isAMsduPermitted(packet); });
            // Force Normal Ack for the earlier DATA, independent of the fragment ACK policy.
            handler->getAgreement(peer, 5)->setStartingSequenceNumber(SequenceNumberCyclic(start) + 1);
            queueData("earlier-data", peer, 20);
            deferredSuccessor = queueData("deferred-successor", peer, 20);
        }
        scheduleAfter(SimTime(10, SIMTIME_MS), new cMessage("verify"));
    }

  protected:
    void receiveSignal(cComponent *source, simsignal_t signal, cObject *object, cObject *details) override {
        if (signal != blockAckAgreementDeletedSignal) {
            Hcf::receiveSignal(source, signal, object, details);
            return;
        }
        auto agreement = check_and_cast<OriginatorBlockAckAgreement *>(object);
        if (agreement->getReceiverAddr() == other) {
            ASSERT(otherSent);
            ASSERT(!hasQueuedData(other, 5) && !hasNumberedData(other, 5));
            otherRetired = true;
            return;
        }
        ASSERT(!retired);
        retired = true;
        ASSERT(firstCompleted == acknowledgedFirst);
        ASSERT(firstAcknowledged == acknowledgedFirst);
        ASSERT(originatorBlockAckAgreementHandler->getAgreement(peer, 5) == nullptr);
        ASSERT(originatorBlockAckAgreementHandler->getAgreement(other, 5) != nullptr);
        auto frames = edca->getEdcaf(AC_VI)->getInProgressFrames();
        for (int i = 0; i < frames->getLength(); i++) {
            auto data = dynamicPtrCast<const Ieee80211DataHeader>(frames->getFrames(i)->peekAtFront<Ieee80211MacHeader>());
            ASSERT(!data || data->getReceiverAddress() != peer || data->getSequenceNumber() != SequenceNumberCyclic(start));
        }
    }

    bool transmitFrame(Packet *packet, simtime_t ifs) override {
        auto data = dynamicPtrCast<const Ieee80211DataHeader>(packet->peekAtFront<Ieee80211MacHeader>());
        bool accepted = Hcf::transmitFrame(packet, ifs);
        if (accepted && data) {
            if (packet->isName("earlier-data")) {
                ASSERT(data->getSequenceNumber() == SequenceNumberCyclic(start));
                ASSERT(data->getAckPolicy() == NORMAL_ACK);
                return accepted;
            }
            if (data->getReceiverAddress() == peer) {
                if (!retired) {
                    ASSERT(data->getSequenceNumber() == SequenceNumberCyclic(start));
                    ASSERT(data->getFragmentNumber() == 0);
                }
                else {
                    ASSERT(data->getSequenceNumber() == SequenceNumberCyclic(start) + 1);
                    ASSERT(data->getFragmentNumber() == 0 && !data->getMoreFragments());
                    successorSent = true;
                }
            }
            else {
                ASSERT(data->getReceiverAddress() == other);
                ASSERT(data->getSequenceNumber() == SequenceNumberCyclic(0));
                otherSent = true;
            }
        }
        return accepted;
    }

    void transmissionComplete(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override {
        Enter_Method("transmissionComplete");
        auto data = dynamicPtrCast<const Ieee80211DataHeader>(header);
        auto bar = dynamicPtrCast<const Ieee80211BasicBlockAckReq>(header);
        if (bar) {
            ASSERT(bar->getReceiverAddress() == other);
            pendingBar = bar;
        }
        bool earlier = packet->isName("earlier-data");
        bool first = !earlier && data && data->getReceiverAddress() == peer && data->getSequenceNumber() == SequenceNumberCyclic(start);
        bool ack = dynamicPtrCast<const Ieee80211Delba>(header) || (data && data->getAckPolicy() == NORMAL_ACK);
        if (first)
            firstCompleted = true;
        if (dynamicPtrCast<const Ieee80211Delba>(header))
            delbas++;
        Hcf::transmissionComplete(packet, header);
        if (ack)
            scheduleAfter(SimTime(20, SIMTIME_US), new cMessage(earlier ? "ack-earlier" : first ? "ack-first" : "ack"));
        if (bar)
            scheduleAfter(SimTime(20, SIMTIME_US), new cMessage("block-ack"));
    }

    void handleMessage(cMessage *message) override {
        if (message->isName("queue-data")) {
            delete message;
            queueData("fragmented-data", peer, 400);
            queueData("intact-successor", peer, 20);
            queueData("other-peer", other, 20);
        }
        else if (message->isName("block-ack")) {
            delete message;
            auto header = makeShared<Ieee80211BasicBlockAck>();
            header->setReceiverAddress(mac->getAddress());
            header->setTransmitterAddress(other);
            header->setTidInfo(5);
            header->setStartingSequenceNumber(pendingBar->getStartingSequenceNumber());
            BitVector bits;
            bits.appendBit(true);
            for (int i = 1; i < 16; i++)
                bits.appendBit(false);
            header->setBlockAckBitmap(0, bits);
            auto packet = new Packet("block-ack", header);
            packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
            packet->addTag<physicallayer::Ieee80211ModeInd>()->setMode(modeSet->getMode(bps(24000000)));
            pendingBar = nullptr;
            processLowerFrame(packet, header);
        }
        else if (message->isName("ack") || message->isName("ack-first") || message->isName("ack-earlier")) {
            bool first = message->isName("ack-first");
            bool earlier = message->isName("ack-earlier");
            delete message;
            auto header = makeShared<Ieee80211AckFrame>();
            header->setReceiverAddress(mac->getAddress());
            auto packet = new Packet("ack", header);
            packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
            packet->addTag<physicallayer::Ieee80211ModeInd>()->setMode(modeSet->getMode(bps(6000000)));
            processLowerFrame(packet, header);
            if (first)
                firstAcknowledged = true;
            if (earlier) {
                auto queue = edca->getEdcaf(AC_VI)->getPendingQueue();
                queue->removePacket(deferredSuccessor);
                take(deferredSuccessor);
                edca->getLifetimeHandler()->forgetFrame(deferredSuccessor->getId());
                delete deferredSuccessor;
                deferredSuccessor = nullptr;
                skipData(distance - 1);
                start = (start + distance) % 4096;
                startRetirement();
            }
        }
        else if (message->isName("verify")) {
            delete message;
            std::cout << "Fragment retirement state: retired=" << retired << " firstCompleted=" << firstCompleted
                << " successorSent=" << successorSent << " otherSent=" << otherSent << " delbas=" << delbas << "\n";
            ASSERT(retired && firstCompleted && successorSent && otherSent);
            ASSERT(delbas == 2 && otherRetired);
            ASSERT(originatorBlockAckAgreementHandler->getAgreement(other, 5) == nullptr);
            unsubscribe(blockAckAgreementDeletedSignal, this);
            std::cout << "Fragment retirement passed: start=" << start << ", acknowledgedFirst=" << acknowledgedFirst
                      << ", distance=" << distance << std::endl;
            endSimulation();
        }
        else
            Hcf::handleMessage(message);
    }
};
Define_Module(FragmentRetirementHcf);

class FragmentRetirementDriver : public cSimpleModule {
  protected:
    void initialize() override { scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("begin")); }
    void handleMessage(cMessage *message) override {
        delete message;
        check_and_cast<FragmentRetirementHcf *>(getModuleByPath("^.host.wlan[0].mac.hcf"))->begin();
    }
};
Define_Module(FragmentRetirementDriver);
}

%file: test.ned
import inet.node.inet.WirelessHost;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
module FragmentRetirementHcf extends Hcf {
    parameters:
        int startSequence;
        int sequenceDistance;
        bool acknowledgedFirst;
        @class(::inet::ieee80211::FragmentRetirementHcf);
}
simple FragmentRetirementDriver { parameters: @class(::inet::ieee80211::FragmentRetirementDriver); }
network FragmentRetirementNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        host: WirelessHost;
        driver: FragmentRetirementDriver;
}

%inifile: omnetpp.ini
[General]
network = FragmentRetirementNetwork
ned-path = .;../../../../src
sim-time-limit = 20ms
seed-set = 0
cmdenv-express-mode = true
record-scalar-results = false
record-vector-results = false
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 6Mbps
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "FragmentRetirementHcf"
**.wlan[*].mac.hcf.startSequence = ${start=0,4095}
**.wlan[*].mac.hcf.sequenceDistance = ${distance=0,2047,2048,2049,4096}
**.wlan[*].mac.hcf.acknowledgedFirst = ${acked=false,true}
**.wlan[*].mac.hcf.isBlockAckSupported = true
**.wlan[*].mac.hcf.blockAckVariant = "basic"
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 200B
**.wlan[*].mac.hcf.originatorAckPolicy.maxBlockAckPolicyFrameLength = ${acked} ? 0B : 1000B
**.wlan[*].mac.hcf.originatorAckPolicy.ackTimeout = 1ms
**.wlan[*].mac.hcf.edca.edcaf[*].cwMin = 0
**.wlan[*].mac.hcf.edca.edcaf[*].cwMax = 0
**.wlan[*].mac.hcf.edca.edcaf[*].aifsn = 20
**.wlan[*].mac.hcf.edca.edcaf[2].txopProcedure.txopLimit = 0s
*.host.wlan[0].address = "02:00:00:00:00:01"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initialX = 0m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m

%contains: stdout
Fragment retirement passed: start=0, acknowledgedFirst=0
%contains: stdout
Fragment retirement passed: start=0, acknowledgedFirst=1
%contains: stdout
Fragment retirement passed: start=4095, acknowledgedFirst=0
%contains: stdout
Fragment retirement passed: start=4095, acknowledgedFirst=1
