%description:
Each side announces its own receive limit in the MSS option (RFC 9293
section 3.7.1). Host A (client) has an MSS of 536, host B (server) one of
1460. The SYN-ACK of host B announces 1460, not the 536 of host A. Both
sides then send segments of at most 536 bytes: the minimum of the two
values.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
*.srv_tcp.**.cmdenv-log-level=INFO
**.cmdenv-log-level=OFF

*.cli_app.tSend=1s
*.cli_app.sendBytes=2048B

*.cli_tcp.mss = 536
*.srv_tcp.mss = 1460

include ../../lib/defaults.ini

%contains: stdout
Tcp Header Option MSS(=1460) sent

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
