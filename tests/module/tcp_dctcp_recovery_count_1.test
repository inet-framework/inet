%description:
Tests the count of DCTCP in a fast recovery, with AccECN and SACK. RFC 8257
section 3.3 counts the acknowledged and the marked bytes at each ACK, and Linux
updates alpha at each ACK (dctcp_update_alpha()); only the cut of cwnd waits
until no recovery runs. The tester removes A028, which starts a fast recovery,
and marks A030 CE. The ACK of the retransmission A042 acknowledges 14336 bytes
in the recovery, and DCTCP counts them and the 1024 marked bytes in this
window of data.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 40000"
*.*_tcp.tcpEcnMode = "accecn"
*.*_tcp.tcpAlgorithmClass = "DcTcp"
*.*_tcp.sackSupport = true
*.tcptester.script="a28 delete; a30 ce"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.429 A028] A.1000 > B.2000: A E N 25589:26613(1024) ack 501 win 16384 ECT(0) # deleting
[1.429 A029] A.1000 > B.2000: A E N 26613:27637(1024) ack 501 win 16384 ECT(0) 
