%description:

Tests that a frame on a port that has no entry in Ieee8021adPolicy stops the
simulation, also when the entry is removed during the run. The network and the
traffic are those of lib/ieee8021ad-access-trunk.ini (see Ieee8021adPolicy_1).
At 0.5 s, a test module removes the port eth2 of bridge1, the port of b1, with
removePort(); the configuration has no '*' entry. The ARP retry of b1 at 1 s
arrives on eth2, and the simulation stops with an error that names the
interface.

%file: test.cc

#include "inet/linklayer/vlan/Ieee8021adPolicy.h"
#include "inet/networklayer/common/NetworkInterface.h"

using namespace inet;

namespace Ieee8021adPolicy_runtime_2 {

// Removes the port of bridge1's eth2 at 0.5 s.
class TestController : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(0.5, new cMessage("remove")); }

    virtual void handleMessage(cMessage *msg) override
    {
        auto bridge = getModuleByPath(par("bridgeModule"));
        auto interfaceTable = check_and_cast<IInterfaceTable *>(bridge->getSubmodule("interfaceTable"));
        auto policy = check_and_cast<Ieee8021adPolicy *>(bridge->getModuleByPath(".bridging.vlanPolicy"));
        policy->removePort(interfaceTable->findInterfaceByName("eth2"));
        delete msg;
    }
};

Define_Module(TestController);

} // namespace Ieee8021adPolicy_runtime_2

%file: test.ned

import inet.test.moduletest.lib.VlanAccessTrunkTestNetwork;

simple TestController
{
    parameters:
        string bridgeModule;
}

network TestNetwork extends VlanAccessTrunkTestNetwork
{
    submodules:
        controller: TestController {
            bridgeModule = "^.bridge1";
        }
}

%inifile: omnetpp.ini

[General]
ned-path = .;../../../../src;../../lib
network = TestNetwork
sim-time-limit = 3s
include ../../lib/ieee8021ad-access-trunk.ini

%exitcode: 1
%postrun-command: grep '<!>' test.out test.err > vlan-port-error.out || true
%contains: vlan-port-error.out
Interface 'eth2' has no entry in the ports parameter, and there is no '*' entry
