%description:
Tests that TcpWestwood takes its first slow-start threshold from
initialSsthresh, as the other algorithms with slow start do. The client has initialSsthresh =
3000, and its state shows ssthresh=3000 from the start.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
*.cli_tcp.**.cmdenv-log-level=DETAIL
**.cmdenv-log-level=OFF

*.*_tcp.tcpAlgorithmClass = "TcpWestwood"
*.cli_tcp.initialSsthresh = 3000

*.cli_app.tSend=1s
*.cli_app.sendBytes=32768B # 32 1024-byte segments

*.tcptester.script=""

include ../../lib/defaults.ini

%contains-regex: stdout
TCB: .* ssthresh=3000

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
