%description:
Tests that the probe timeout of a tail loss probe (RFC 8985 section 7,
tlpEnabled=true) stops when the ACK covers all data. The client sends two
segments and its FIN, and the ACK of the FIN arrives at t=1.004. The probe
timeout that the ACK of 1001 armed must not send the FIN again.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script=""

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 1000"
*.cli_app.tClose=1.0001s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=3s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.tlpEnabled = true
*.*_tcp.increasedIWEnabled = true



%contains: stdout
[1.003 B004] A.1000 < B.2000: A ack 1002 win 5000

%# the close completes with no probe between
%contains: stdout
[3.003 A006] A.1000 > B.2000: A ack 502 win 5000

%not-contains: stdout
TLP: probing
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
