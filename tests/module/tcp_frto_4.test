%description:
Tests that F-RTO (RFC 5682, frtoEnabled=true) does not start at a timeout
during a fast recovery (RFC 5682 step 1). The tester deletes the first
segment and its fast retransmission, and it delays the new segment
2001:2501 of the fast recovery by 2.995 s. The timeout at t=4 comes
during the fast recovery. The receiver then SACKs the delayed segment,
which the sender sent once, but F-RTO is not active, and the sender keeps
the reduction. (After the timeout, the duplicate ACK of t=4.002 starts a
new fast recovery at once. RFC 6675 section 5.1 forbids this, see
decision D-34 of the staged landing.)
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="a3 delete; a7 delete; a8 delay 2.995"

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 2500"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.frtoEnabled = true
*.*_tcp.increasedIWEnabled = true



%contains: stdout
F-RTO: no detection, the timeout comes during a loss recovery

%# the SACK of the segment that was sent once does not undo the reduction
%contains: stdout
[4.002 B005] A.1000 < B.2000: A ack 1 win 5000   Option(s): NOP NOP SACK[501,2501)

%not-contains: stdout
F-RTO: spurious

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
