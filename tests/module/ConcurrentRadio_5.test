%description:

The singular getters getTransmissionInProgress() and getReceptionInProgress()
only answer for a radio that transmits and attempts one at a time: on a radio
with allowConcurrentTransmissions and allowConcurrentReceptions set, both
throw an error that points to the plural getter; on a radio with the
defaults, both answer (nullptr, as nothing is in progress).

%file: test.cc

#include <functional>

#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadio.h"

using namespace inet;
using namespace inet::physicallayer;

namespace ConcurrentRadio_5 {

// Calls both singular getters of both radios and prints what they answer.
class TestProbe : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(0, new cMessage("probe")); }
    virtual void handleMessage(cMessage *msg) override
    {
        delete msg;
        for (const char *node : {"concurrent", "plain"}) {
            auto radio = check_and_cast<IRadio *>(getParentModule()->getSubmodule(node)->getSubmodule("radio"));
            probe(node, "getTransmissionInProgress", [&] () { return radio->getTransmissionInProgress(); });
            probe(node, "getReceptionInProgress", [&] () { return radio->getReceptionInProgress(); });
        }
    }
    void probe(const char *node, const char *getter, std::function<const ITransmission *()> f)
    {
        try {
            auto transmission = f();
            std::cout << node << ": " << getter << ": " << (transmission == nullptr ? "nullptr" : "a transmission") << std::endl;
        }
        catch (cRuntimeError& e) {
            std::cout << node << ": " << getter << ": error: " << e.what() << std::endl;
        }
    }
};

Define_Module(TestProbe);

} // namespace ConcurrentRadio_5

%file: test.ned

import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.apsk.packetlevel.ApskDimensionalRadio;
import inet.physicallayer.wireless.common.medium.DimensionalRadioMedium;

simple TestProbe
{
    @class(TestProbe);
}

module Node
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: ApskDimensionalRadio;
    connections allowunconnected:
}

network Test
{
    submodules:
        radioMedium: DimensionalRadioMedium;
        concurrent: Node;
        plain: Node;
        probe: TestProbe;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 1ms
ned-path = .;../../../../src
cmdenv-express-mode = false

**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
*.concurrent.mobility.initialX = 400m
*.plain.mobility.initialX = 500m

*.radioMedium.backgroundNoise.power = -110dBm

**.radio.antenna.mobilityModule = "^.^.mobility"
**.radio.centerFrequency = 2.4GHz
**.radio.bandwidth = 2MHz
**.radio.transmitter.bitrate = 2Mbps
**.radio.transmitter.preambleDuration = 0s
**.radio.transmitter.headerLength = 96b
**.radio.transmitter.power = 100mW
**.radio.receiver.energyDetection = -90dBm
**.radio.receiver.sensitivity = -80dBm
**.radio.receiver.snirThreshold = 10dB
*.concurrent.radio.allowConcurrentTransmissions = true
*.concurrent.radio.allowConcurrentReceptions = true

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
concurrent: getTransmissionInProgress: error: getTransmissionInProgress() is ambiguous when allowConcurrentTransmissions is set, use getTransmissionsInProgress()
%contains: stdout
concurrent: getReceptionInProgress: error: getReceptionInProgress() is ambiguous when allowConcurrentReceptions is set, use getReceptionsInProgress()
%contains: stdout
plain: getTransmissionInProgress: nullptr
%contains: stdout
plain: getReceptionInProgress: nullptr
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
