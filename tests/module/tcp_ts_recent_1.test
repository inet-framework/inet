%description:
Tests that TS.Recent changes only after the window test (RFC 7323 section 5.3:
R2 before R3). The tester deletes the ACK of the server, so the client sends
its segment again after the RTO, with TSval 4000. The copy lies outside the
window of the server, which answers it with an ACK that echoes TSval 1000 of
the original; master took TSval 4000 of the copy into TS.Recent.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 100"
*.*_tcp.timestampSupport = true
*.tcptester.script="B2 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:101(100) ack 501 win 16384   Option(s): NOP NOP TS(1000,2)
[1.203 B002] A.1000 < B.2000: A ack 101 win 16384   Option(s): NOP NOP TS(1202,1000)# deleting
[4.001 A004] A.1000 > B.2000: A 1:101(100) ack 501 win 16384   Option(s): NOP NOP TS(4000,2)
[4.003 B003] A.1000 < B.2000: A ack 101 win 16384   Option(s): NOP NOP TS(4002,1000)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
