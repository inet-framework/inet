%description:
Tests the range check of the Tcp parameters: maxReordering below dupthresh
stops the simulation with an error at the open, because a smaller value lowers
the loss threshold below DupThresh.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 5s
*.cli_app.sendScript="1.0 20000"
*.cli_tcp.maxReordering = 2

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%exitcode: 1
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "<!>" test.* > test_err.out || true
%contains: test_err.out
maxReordering must be at least dupthresh (3), but it is 2
%#--------------------------------------------------------------------------------------------------------------
