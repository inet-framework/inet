%description:
Tests the advertised window and the receive buffer of one socket (D-4 of the
staged landing: a socket option is not a module parameter). The server
application sets a window of 3000 bytes and a buffer of 6000 bytes on its first
socket (TcpSocket::setAdvertisedWindow(), setReceiveBufferSize()), which the
open command carries. The first connection offers 3000, and STATUS reports the
buffer of 6000 (skRcvbuf); the second connection of the same Tcp module offers
the window of the module parameters (16384).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000"
*.cli_app.tOpen2=2s
*.cli_app.active2=true
*.cli_app.localPort2=1001
*.cli_app.tSend2=3s
*.cli_app.sendBytes2=1000B
*.srv_app.tOpen2=1.5s
*.srv_app.localPort2=2000
*.srv_app.socketAdvertisedWindow = 3000
*.srv_app.socketReceiveBufferSize = 6000
*.srv_app.statusRequestScript="1.2"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.001 A001] A.1000 > B.2000: S 0:0(0) win 16384   Option(s): MaxSegSize
srv_tcp: LISTEN --> SYN_RCVD  (on RCV_SYN)
[0.003 B001] A.1000 < B.2000: A S 500:500(0) ack 1 win 3000   Option(s): MaxSegSize
cli_tcp: SYN_SENT --> ESTABLISHED  (on RCV_SYN_ACK)
[0.005 A002] A.1000 > B.2000: A ack 501 win 16384 
srv_tcp: SYN_RCVD --> ESTABLISHED  (on RCV_ACK)
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 1001 win 3000 
srv_tcp: INIT --> LISTEN  (on OPEN_PASSIVE)
cli_tcp: INIT --> SYN_SENT  (on OPEN_ACTIVE)
[2.001 A004] A.1001 > B.2000: S 500000:500000(0) win 16384   Option(s): MaxSegSize
srv_tcp: LISTEN --> SYN_RCVD  (on RCV_SYN)
[2.003 B003] A.1001 < B.2000: A S 500499:500499(0) ack 500001 win 16384   Option(s): MaxSegSize
cli_tcp: SYN_SENT --> ESTABLISHED  (on RCV_SYN_ACK)
[2.005 A005] A.1001 > B.2000: A ack 500500 win 16384 
srv_tcp: SYN_RCVD --> ESTABLISHED  (on RCV_ACK)
[3.001 A006] A.1001 > B.2000: A 500001:501001(1000) ack 500500 win 16384 
[3.203 B004] A.1001 < B.2000: A ack 501001 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
STATUS: skRcvbuf=6000
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
