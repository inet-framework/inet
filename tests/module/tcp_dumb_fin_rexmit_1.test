%description:
Tests that DumbTcp sends a lost FIN again when no data is left before it. The
client sends 1000 bytes at t=1 and closes at t=1.5, and the tester removes the
FIN. The retransmission timer of DumbTcp expires 2 s later, at t=3.5, and
retransmitData() sends the FIN again. It sent nothing before the repair, because
it counted the FIN as data, and the connection never ended.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib
sim-time-limit = 4s

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_tcp.tcpAlgorithmClass = "DumbTcp"
*.cli_app.sendScript="1.0 1000"
*.cli_app.tClose=1.5s
*.tcptester.script="a4 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.501 A004] A.1000 > B.2000: A F ack 501 win 16384 # deleting
[3.501 A005] A.1000 > B.2000: A F ack 501 win 16384 
srv_tcp: ESTABLISHED --> CLOSE_WAIT  (on RCV_FIN)
[3.503 B003] A.1000 < B.2000: A ack 1002 win 16384 
cli_tcp: FIN_WAIT_1 --> FIN_WAIT_2  (on RCV_ACK)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
