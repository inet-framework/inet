%description:
Exercise production single-protection HCF admission with deterministic DATA/ACK and RTS/CTS exchanges.
Check strict TXNAV boundaries, independent TXOP containment, propagation, mode changes, and finite queue progress.

%extraargs: -r 0..25

%file: SingleProtection.cc
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/Rx.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/contract/IRateControl.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

namespace inet::ieee80211 {
struct SingleTransmission {
    simtime_t start;
    simtime_t airtime;
    simtime_t duration;
    int type;
    bool retry;
    int tid;
    bool aggregated;
    long treeId;
    const physicallayer::IIeee80211Mode *mode;
};
class SingleMac : public Ieee80211Mac {
  public:
    std::vector<SingleTransmission> transmissions;
    void sendDownFrame(Packet *packet) override {
        auto header = packet->peekAtFront<Ieee80211MacHeader>();
        auto data = dynamicPtrCast<const Ieee80211DataHeader>(header);
        auto mode = packet->getTag<physicallayer::Ieee80211ModeReq>()->getMode();
        transmissions.push_back({simTime(), mode->getDuration(packet->getDataLength()),
            header->getDurationField(), header->getType(), header->getRetry(), data ? data->getTid() : -1,
            data && data->getAMsduPresent(), packet->getTreeId(), mode});
        Ieee80211Mac::sendDownFrame(packet);
    }
};
Define_Module(SingleMac);

class SingleRx : public Rx {
  public:
    simtime_t adjustment = 0;
    bool expand = false;
    bool admissionQuery = false;
    mutable int samples = 0;
    simtime_t getTxnavRemaining() const override {
        samples++;
        auto remaining = Rx::getTxnavRemaining();
        if (!admissionQuery) return remaining;
        return expand ? SimTime(10, SIMTIME_MS) : std::max(SIMTIME_ZERO, remaining + adjustment);
    }
};
Define_Module(SingleRx);

class SingleRateSelection : public IQosRateSelection {
  public:
    IQosRateSelection *delegate = nullptr;
    const physicallayer::IIeee80211Mode *dataMode = nullptr;
    int dataQueries = 0;
    std::vector<const physicallayer::IIeee80211Mode *> ackInputs;
    std::vector<long> ackTreeIds;
    std::vector<simtime_t> ackTimes;
    std::vector<simtime_t> ackDurations;
    const physicallayer::IIeee80211Mode *computeMode(Packet *packet,
            const Ptr<const Ieee80211MacHeader>& header, TxopProcedure *txop) override {
        if (dynamicPtrCast<const Ieee80211DataOrMgmtHeader>(header)) {
            dataQueries++;
            return dataMode;
        }
        return delegate->computeMode(packet, header, txop);
    }
    const physicallayer::IIeee80211Mode *computeResponseCtsFrameMode(Packet *packet,
            const Ptr<const Ieee80211RtsFrame>& header) override {
        return delegate->computeResponseCtsFrameMode(packet, header);
    }
    const physicallayer::IIeee80211Mode *computeResponseAckFrameMode(Packet *packet,
            const Ptr<const Ieee80211DataOrMgmtHeader>& header) override {
        auto requestMode = packet->findTag<physicallayer::Ieee80211ModeReq>();
        ackInputs.push_back(requestMode ? requestMode->getMode() :
            packet->getTag<physicallayer::Ieee80211ModeInd>()->getMode());
        ackTreeIds.push_back(packet->getTreeId());
        ackTimes.push_back(simTime());
        auto responseMode = delegate->computeResponseAckFrameMode(packet, header);
        ackDurations.push_back(responseMode->getDuration(LENGTH_ACK));
        return responseMode;
    }
    const physicallayer::IIeee80211Mode *computeResponseBlockAckFrameMode(Packet *packet,
            const Ptr<const Ieee80211BlockAckReq>& header) override {
        return delegate->computeResponseBlockAckFrameMode(packet, header);
    }
};
class SingleRateControl : public IRateControl {
  public:
    int failedFeedback = 0;
    int successfulFeedback = 0;
    const physicallayer::IIeee80211Mode *getRate(const MacAddress&) override {
        return physicallayer::Ieee80211ModeSet::getModeSet("a")->getMode(bps(6e6));
    }
    void frameTransmitted(Packet *, int retryCount, bool successful, bool givenUp) override {
        ASSERT(retryCount == 0 && !givenUp);
        if (successful) successfulFeedback++;
        else failedFeedback++;
    }
    void frameReceived(Packet *) override {}
};
class SingleHcf : public Hcf {
  public:
    SingleRateSelection selection;
    SingleRateControl feedback;
    int failures = 0;
    int acknowledgments = 0;
    int currentData = 0;
    int refusals = 0;
    int grants = 0;
    int timerStarts = 0;
    int forecastChecks = 0;
    std::vector<int> burstData;
    std::vector<int> finishSteps;
    std::vector<int> finishTypes;
    std::vector<simtime_t> decisions;
    std::vector<simtime_t> budgets;
    std::vector<simtime_t> waits;
    std::vector<simtime_t> grantTimes;
    std::vector<simtime_t> acknowledgmentTimes;
    std::vector<int> admissionGrants;
    int scenario() const { return par("scenario"); }
    bool sender() const { return getFullPath().find("sender") != std::string::npos; }
    const physicallayer::IIeee80211Mode *mode(double rate) {
        return physicallayer::Ieee80211ModeSet::getModeSet("a")->getMode(bps(rate));
    }
    void inject(int payload, bool group = false, int tid = 5) {
        Enter_Method("inject");
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setTid(tid);
        header->setReceiverAddress(group ? MacAddress::BROADCAST_ADDRESS : MacAddress("02:00:00:00:00:02"));
        header->setTransmitterAddress(mac->getAddress());
        header->setAddress3(mac->getAddress());
        auto packet = new Packet("single-data", header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(payload)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        processUpperFrame(packet, header);
    }
    bool transmitFrame(Packet *packet, simtime_t ifs) override {
        auto h = packet->peekAtFront<Ieee80211MacHeader>();
        auto context = frameSequenceHandler->getContext();
        Packet *selected = packet;
        if (dynamicPtrCast<const Ieee80211RtsFrame>(h))
            selected = const_cast<Packet *>(check_and_cast<RtsTransmitStep *>(context->getLastStep())->getProtectedFrame());
        auto selectedTag = selected->findTag<physicallayer::Ieee80211ModeReq>();
        auto selectedMode = selectedTag ? selectedTag->getMode() : nullptr;
        auto pending = dynamicPtrCast<const Ieee80211DataOrMgmtHeader>(h) ?
            context->getInProgressFrames()->getPendingFrameFor(packet) : nullptr;
        if (pending && sender() && forecastChecks == 0) {
            if (scenario() != 1)
                pending->addTagIfAbsent<physicallayer::Ieee80211ModeReq>()->setMode(mode(54e6));
            auto retainedHeader = pending->removeAtFront<Ieee80211DataHeader>();
            retainedHeader->setAckPolicy(AckPolicy::BLOCK_ACK);
            pending->insertAtFront(retainedHeader);
        }
        auto pendingTag = pending ? pending->findTag<physicallayer::Ieee80211ModeReq>() : nullptr;
        auto pendingMode = pendingTag ? pendingTag->getMode() : nullptr;
        auto pendingHeader = pending ? pending->peekAtFront<Ieee80211DataHeader>() : nullptr;
        auto pendingPolicy = pendingHeader ? pendingHeader->getAckPolicy() : AckPolicy::NORMAL_ACK;
        auto controlledRx = check_and_cast<SingleRx *>(rx);
        controlledRx->admissionQuery = sender();
        if (sender()) {
            decisions.push_back(simTime());
            budgets.push_back(rx->getTxnavRemaining());
            waits.push_back(ifs);
            admissionGrants.push_back(grants);
        }
        // A refusal must not start a response timer.
        int previousTimers = timerStarts;
        bool accepted = Hcf::transmitFrame(packet, ifs);
        controlledRx->admissionQuery = false;
        if (pending) {
            auto tag = pending->findTag<physicallayer::Ieee80211ModeReq>();
            ASSERT(bool(tag) == bool(pendingTag));
            ASSERT(!tag || tag->getMode() == pendingMode);
            ASSERT(pending->peekAtFront<Ieee80211DataHeader>()->getAckPolicy() == pendingPolicy);
            forecastChecks++;
        }
        if (!accepted) {
            refusals++;
            auto tag = selected->findTag<physicallayer::Ieee80211ModeReq>();
            ASSERT(bool(tag) == bool(selectedTag));
            ASSERT(!tag || tag->getMode() == selectedMode);
            ASSERT(timerStarts == previousTimers);
            ASSERT(!startRxTimer->isScheduled());
            ASSERT(context->getNumSteps() >= 2);
        }
        return accepted;
    }
    void channelGranted(IChannelAccess *access) override {
        grants++;
        grantTimes.push_back(simTime());
        Hcf::channelGranted(access);
    }
    void scheduleStartRxTimer(simtime_t timeout) override {
        timerStarts++;
        Hcf::scheduleStartRxTimer(timeout);
    }
    void originatorProcessTransmittedFrame(Packet *packet) override {
        if (dynamicPtrCast<const Ieee80211DataOrMgmtHeader>(packet->peekAtFront<Ieee80211MacHeader>()))
            currentData++;
        Hcf::originatorProcessTransmittedFrame(packet);
    }
    void originatorProcessReceivedFrame(Packet *packet, Packet *request) override {
        auto type = packet->peekAtFront<Ieee80211MacHeader>()->getType();
        if (type == ST_ACK) {
            acknowledgments++;
            acknowledgmentTimes.push_back(simTime());
            if (sender() && scenario() == 25 && acknowledgments == 2)
                ASSERT(rx->getTxnavRemaining() == 0);
            if (sender() && acknowledgments == 1) {
                if (scenario() == 3 || scenario() == 4)
                    selection.dataMode = mode(scenario() == 3 ? 54e6 : 6e6);
            }
        }
        if (sender() && type == ST_CTS && scenario() == 14)
            selection.dataMode = mode(54e6);
        Hcf::originatorProcessReceivedFrame(packet, request);
    }
    void frameSequenceFinished() override {
        auto context = frameSequenceHandler->getContext();
        burstData.push_back(currentData);
        finishSteps.push_back(context->getNumSteps());
        auto last = context->getLastStep();
        auto receive = dynamic_cast<IReceiveStep *>(last);
        finishTypes.push_back(receive ? receive->getReceivedFrame()->peekAtFront<Ieee80211MacHeader>()->getType() : -1);
        currentData = 0;
        if (sender() && scenario() == 4 && refusals)
            selection.dataMode = mode(54e6);
        Hcf::frameSequenceFinished();
    }
    void originatorProcessFailedFrame(Packet *packet) override {
        failures++;
        Hcf::originatorProcessFailedFrame(packet);
    }
    void originatorProcessRtsProtectionFailed(Packet *packet) override {
        failures++;
        Hcf::originatorProcessRtsProtectionFailed(packet);
    }
  protected:
    void initialize(int stage) override {
        Hcf::initialize(stage);
        if (stage == INITSTAGE_LOCAL) {
            selection.delegate = rateSelection;
            rateSelection = &selection;
            dataAndMgmtRateControl = &feedback;
            selection.dataMode = mode(scenario() == 4 ? 54e6 : 6e6);
        }
    }
    void sendUp(const std::vector<Packet *>& frames) override {
        for (auto packet : frames) { take(packet); delete packet; }
    }
};
Define_Module(SingleHcf);
class SingleTest : public cSimpleModule {
  public:
    SingleTest() : cSimpleModule(65536) {}
  protected:
    void activity() override {
        wait(SimTime(1, SIMTIME_MS));
        auto sender = check_and_cast<SingleHcf *>(getModuleByPath("^.sender.wlan[0].mac.hcf"));
        auto txrx = check_and_cast<SingleRx *>(getModuleByPath("^.sender.wlan[0].mac.rx"));
        auto mac = check_and_cast<SingleMac *>(getModuleByPath("^.sender.wlan[0].mac"));
        auto peer = check_and_cast<SingleMac *>(getModuleByPath("^.receiver.wlan[0].mac"));
        int s = sender->scenario();
        if (s == 1) txrx->adjustment = SimTime(-16, SIMTIME_US);
        if (s == 2) txrx->adjustment = SimTime(-15.999e-6);
        if (s == 24) txrx->adjustment = SimTime(-16.001e-6);
        if (s == 5 || s == 6 || s == 16 || s == 22) txrx->expand = true;
        if (s == 23) txrx->adjustment = SimTime(0.4e-6);
        if (s >= 11 && s <= 13) {
            for (int i = 0; i < 3; i++) sender->inject(1466, false, 6);
            sender->inject(66, false, 6);
            if (s == 13) sender->inject(66, false, 0);
        }
        else if (s == 7 || s == 20) sender->inject(26);
        else if (s == 15 || s == 18) sender->inject(180);
        else if (s == 17) {
            for (int i = 0; i < 4; i++) sender->inject(26);
        }
        else {
            sender->inject(26, s == 9);
            sender->inject(s == 8 ? 66 : 26);
            if (s == 25) sender->inject(26, false, 0);
        }
        wait(SimTime(10, SIMTIME_MS));
        ASSERT(sender->failures == 0);
        ASSERT(sender->feedback.failedFeedback == 0);
        ASSERT(sender->feedback.successfulFeedback == sender->acknowledgments);
        ASSERT(!mac->transmissions.empty());
        for (auto frame : mac->transmissions) ASSERT(!frame.retry);
        if (s >= 11 && s <= 13) {
            ASSERT(sender->acknowledgments == (s == 13 ? 5 : 4));
            ASSERT(sender->grants >= 3);
            int voice = 0, bestEffort = 0;
            for (auto frame : mac->transmissions) {
                if (frame.type == ST_DATA_WITH_QOS) {
                    if (frame.tid == 6) voice++;
                    if (frame.tid == 0) bestEffort++;
                }
            }
            ASSERT(voice == 4 && bestEffort == (s == 13 ? 1 : 0));
        }
        else if (s == 7 || s == 20) {
            ASSERT(sender->acknowledgments == 1);
            ASSERT(mac->transmissions.size() == (s == 7 ? 2 : 1));
            ASSERT(mac->transmissions[0].type == (s == 7 ? ST_RTS : ST_DATA_WITH_QOS));
            ASSERT(sender->refusals == 0);
        }
        else if (s == 15 || s == 18) {
            ASSERT(sender->acknowledgments >= 2);
            ASSERT(mac->transmissions.size() >= 2);
            if (s == 18) {
                ASSERT(sender->grants == sender->acknowledgments);
                for (auto count : sender->burstData) ASSERT(count == 1);
            }
            else ASSERT(sender->burstData[0] > 1);
        }
        else if (s == 17) {
            ASSERT(sender->acknowledgments == 2);
            ASSERT(mac->transmissions.size() == 2);
            ASSERT(sender->burstData[0] == 2);
            for (auto frame : mac->transmissions) ASSERT(frame.aggregated);
        }
        else if (s == 25) {
            ASSERT(sender->acknowledgments == 3);
            ASSERT(sender->refusals == 0 && sender->grants == 2);
            ASSERT(sender->burstData.size() == 2 && sender->burstData[0] == 2 && sender->burstData[1] == 1);
            ASSERT(sender->budgets[1] == SimTime(175.6e-6));
            ASSERT(mac->transmissions[0].tid == 5 && mac->transmissions[1].tid == 5 && mac->transmissions[2].tid == 0);
            ASSERT(sender->grantTimes[1] > sender->acknowledgmentTimes[1]);
        }
        else {
            ASSERT(sender->acknowledgments == (s == 9 ? 1 : 2));
            if (s == 0 || s == 2 || s == 3 || s == 6 || s == 19 || s == 21 || s == 23)
                ASSERT(sender->burstData[0] == 2);
            if (s == 14)
                ASSERT(sender->burstData.size() == 2 && sender->burstData[0] == 1 && sender->burstData[1] == 1);
            if (s == 1 || s == 4 || s == 5 || s == 8 || s == 9 || s == 10 || s == 16 || s == 22 || s == 24)
                ASSERT(sender->burstData.size() == 2 && sender->burstData[0] == 1 && sender->burstData[1] == 1);
            if (s == 0) {
                ASSERT(mac->transmissions[0].duration == SimTime(236, SIMTIME_US));
                ASSERT(mac->transmissions[1].start - mac->transmissions[0].start == SimTime(176, SIMTIME_US));
                ASSERT(sender->waits[1] == SimTime(16, SIMTIME_US));
                ASSERT(sender->budgets[1] == SimTime(176, SIMTIME_US));
                ASSERT(sender->decisions[1] == mac->transmissions[0].start + SimTime(160, SIMTIME_US));
            }
            if (s == 1 || s == 4 || s == 8 || s == 16 || s == 22 || s == 24) {
                ASSERT(sender->refusals == 1);
                ASSERT(sender->finishTypes[0] == ST_ACK);
                ASSERT(sender->finishSteps[0] == 2);
                ASSERT(sender->grants == 2);
            }
            if (s == 1) ASSERT(sender->budgets[1] == SimTime(160, SIMTIME_US));
            if (s == 2) ASSERT(sender->budgets[1] == SimTime(160.001e-6));
            if (s == 24) ASSERT(sender->budgets[1] == SimTime(159.999e-6));
            if (s == 21) {
                ASSERT(sender->budgets[1] == SimTime(175.6e-6));
                ASSERT(sender->refusals == 0 && sender->grants == 1);
                ASSERT(mac->transmissions[0].duration == SimTime(236, SIMTIME_US));
                ASSERT(mac->transmissions[1].start - mac->transmissions[0].start == SimTime(176.4e-6));
            }
            if (s == 23) {
                ASSERT(sender->budgets[1] == SimTime(176, SIMTIME_US));
                ASSERT(mac->transmissions[1].start - mac->transmissions[0].start == SimTime(176.4e-6));
            }
            if (s == 5 || s == 10)
                ASSERT(mac->transmissions[0].duration == SimTime(60, SIMTIME_US));
            if (s == 9)
                ASSERT(mac->transmissions[0].duration == 0);
            if (s == 8) {
                ASSERT(mac->transmissions.size() == 3);
                ASSERT(mac->transmissions[0].duration == SimTime(188, SIMTIME_US));
                ASSERT(mac->transmissions[1].type == ST_RTS);
                ASSERT(sender->admissionGrants[1] == 1 && sender->admissionGrants[2] == 2);
            }
            if (s == 3 || s == 4)
                ASSERT(mac->transmissions.back().mode == sender->mode(54e6));
            if (s == 14) {
                ASSERT(mac->transmissions.size() == 4);
                ASSERT(mac->transmissions[1].mode == sender->mode(6e6));
                ASSERT(mac->transmissions[3].mode == sender->mode(54e6));
                bool beforeCts = false, afterCts = false;
                for (size_t i = 0; i < sender->selection.ackInputs.size(); i++) {
                    if (sender->selection.ackTreeIds[i] == mac->transmissions[1].treeId) {
                        ASSERT(sender->selection.ackInputs[i] == sender->mode(6e6));
                        ASSERT(sender->selection.ackDurations[i] == SimTime(44, SIMTIME_US));
                        if (sender->selection.ackTimes[i] < peer->transmissions[0].start)
                            beforeCts = true;
                        if (sender->selection.ackTimes[i] > peer->transmissions[0].start)
                            afterCts = true;
                    }
                }
                ASSERT(beforeCts && afterCts);
            }
        }
        ASSERT(sender->forecastChecks > 0 || s == 7 || s == 15 || s == 18 || s == 20);
        std::cout << "Single-protection production admission assertions passed.\n";
    }
};
Define_Module(SingleTest);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mac.Ieee80211Mac;
import inet.linklayer.ieee80211.mac.Rx;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
module SingleMac extends Ieee80211Mac {
    parameters:
        @class(::inet::ieee80211::SingleMac);
}
module SingleHcf extends Hcf {
    parameters:
        int scenario;
        @class(::inet::ieee80211::SingleHcf);
}
simple SingleRx extends Rx {
    parameters:
        @class(::inet::ieee80211::SingleRx);
}
simple SingleTest extends SimpleModule {
    parameters:
        @class(::inet::ieee80211::SingleTest);
}
network SingleNetwork {
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        sender: WirelessHost;
        receiver: WirelessHost;
        test: SingleTest;
}

%inifile: omnetpp.ini
[General]
network = SingleNetwork
ned-path = .;../../../../src;../../lib
sim-time-limit = 12ms
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.radioMedium.propagation.typename = "ConstantTimePropagation"
*.radioMedium.propagation.propagationTime = (${scenario} >= 21 && ${scenario} <= 23) || ${scenario} == 25 ? 0.2us : (${scenario} == 16 ? 0.48us : 0s)
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 6Mbps
**.wlan[*].mac.typename = "SingleMac"
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.rx.typename = "SingleRx"
**.wlan[*].mac.hcf.typename = "SingleHcf"
**.wlan[*].mac.hcf.scenario = ${scenario=0..25}
**.wlan[*].mac.hcf.isBlockAckSupported = false
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ${aggregationType="","","","","","","","","","","","","","","","","","BasicMsduAggregationPolicy","","","","","","","","" ! scenario}
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.maxAMsduSize = 80
**.wlan[*].mac.hcf.originatorMacDataService.mpduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = ${scenario} == 15 || ${scenario} == 18 ? 100B : 1500B
**.wlan[*].mac.hcf.rateSelection.dataFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rateSelection.mgmtFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rateSelection.controlFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rateSelection.responseAckFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rateSelection.responseCtsFrameBitrate = 6Mbps
**.wlan[*].mac.hcf.rtsPolicy.rtsThreshold = ${scenario} == 7 || ${scenario} == 12 || ${scenario} == 14 ? 0B : (${scenario} == 8 ? 75B : 4096B)
**.wlan[*].mac.hcf.edca.edcaf[*].cwMin = 0
**.wlan[*].mac.hcf.edca.edcaf[*].cwMax = 0
**.wlan[*].mac.hcf.edca.edcaf[*].txopProcedure.txopLimit = ${scenario} == 5 ? 335us : (${scenario} == 6 || ${scenario} == 16 || ${scenario} == 22 ? 336us : (${scenario} == 19 ? 337us : (${scenario} == 7 || ${scenario} == 20 ? 100us : (${scenario} == 10 || ${scenario} == 18 ? 0s : (${scenario} >= 11 && ${scenario} <= 13 ? 1504us : 3008us)))))
**.wlan[*].mac.hcf.edca.edcaf[*].txopProcedure.protectionMechanism = "single"
*.sender.wlan[0].address = "02:00:00:00:00:01"
*.receiver.wlan[0].address = "02:00:00:00:00:02"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.sender.mobility.initialX = 0m
*.sender.mobility.initialY = 0m
*.receiver.mobility.initialX = 1m
*.receiver.mobility.initialY = 0m
**.wlan[*].radio.transmitter.power = 100mW
**.wlan[*].radio.receiver.sensitivity = -85dBm
**.wlan[*].radio.receiver.snirThreshold = 4dB
**.wlan[*].radio.receiver.errorModel.typename = ""

%contains: stdout
Single-protection production admission assertions passed.
