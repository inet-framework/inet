%description:
The passive side seeds its RTT estimator from the handshake
(seedRttFromHandshake, Linux tcp_synack_rtt_meas()): from its SYN-ACK to the
ACK that completes the handshake, 4 ms. So srtt is 4 ms, and the RTO is the
minimum of 1 s instead of the initial 3 s. The server's first data segment,
sent at t=1, is lost, and its retransmission leaves at t=2, not at t=4.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

*.srv_app.tSend=1s
*.srv_app.sendBytes=1000B
*.tcptester.script="b2 delete"

*.*_tcp.seedRttFromHandshake = true

include ../../lib/defaults.ini

%contains: stdout
[1.001 B002] A.1000 < B.2000: A 501:1501(1000) ack 1 win 16384 # deleting
[2.001 B003] A.1000 < B.2000: A 501:1501(1000) ack 1 win 16384

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
