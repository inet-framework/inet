%description:
Tests the growth of the receive buffer with windowAutoTuning by out-of-order
data, as Linux (tcp_rcvbuf_grow() at the end of tcp_data_queue_ofo()). The
server has a receive buffer of 8000 bytes and offers 8000 bytes first. The
tester removes A012, so A013 to A019 wait as out-of-order data. Each
out-of-order segment grows the buffer of the connection, which the
application owns, to the window of twice the receive space and the
out-of-order span, at the payload ratio of the segments: a 1000-byte segment
costs 2280 bytes, so the ratio is 112/256. The receive space is the first
offer, 8000 bytes. Before the loss, Dynamic Right-Sizing grows it: in the
first receive RTT that the receiver measured (4 ms), the application read
9000 bytes, more than the space, so the space becomes 9000 and the buffer the
window 2 * 9000 + 2 * 18000 * 1000/8000 = 22500, 51428 bytes (the slow-start
rule of tcp_rcvbuf_grow() above 1 ms). The out-of-order segments then grow the
buffer to the window 18000 + their span: 52571, 54857, 57142 and 59428 bytes
for spans of 5000 to 8000. The clamp of the offer follows the buffer, so the
SACKs offer more. STATUS reports the buffer (skRcvbuf): 8000 before, 59428
after. Before the repair of out-of-order growth, the buffer grew only when its
memory outgrew it (tcp_clamp_window()), to 18240 bytes.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 20000"
*.*_tcp.mss = 1000
*.*_tcp.delayedAcksEnabled = false
*.*_tcp.sackSupport = true
*.srv_tcp.advertisedWindow = 8000
*.srv_tcp.receiveBufferSize = 8000B
*.srv_tcp.windowAutoTuning = true
*.srv_app.statusRequestScript="0.5,3"
*.tcptester.script="a12 delete"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.013 A012] A.1000 > B.2000: A 9001:10001(1000) ack 501 win 16384 # deleting
[1.013 A013] A.1000 > B.2000: A 10001:11001(1000) ack 501 win 16384 
[1.013 A014] A.1000 > B.2000: A 11001:12001(1000) ack 501 win 16384 
[1.013 A015] A.1000 > B.2000: A 12001:13001(1000) ack 501 win 16384 
[1.013 A016] A.1000 > B.2000: A 13001:14001(1000) ack 501 win 16384 
[1.013 A017] A.1000 > B.2000: A 14001:15001(1000) ack 501 win 16384 
[1.015 B009] A.1000 < B.2000: A ack 8001 win 8000 
[1.015 B010] A.1000 < B.2000: A ack 9001 win 8000 
[1.015 B011] A.1000 < B.2000: A ack 9001 win 10000   Option(s): NOP NOP SACK[10001,11001)
[1.015 B012] A.1000 < B.2000: A ack 9001 win 12000   Option(s): NOP NOP SACK[10001,12001)
[1.015 B013] A.1000 < B.2000: A ack 9001 win 14000   Option(s): NOP NOP SACK[10001,13001)
[1.015 B014] A.1000 < B.2000: A ack 9001 win 16000   Option(s): NOP NOP SACK[10001,14001)
[1.015 B015] A.1000 < B.2000: A ack 9001 win 18000   Option(s): NOP NOP SACK[10001,15001)
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
STATUS: skRcvbuf=8000
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
STATUS: skRcvbuf=59428
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
