%description:
Tests a SEND of zero bytes. The client sends an empty packet at t=1 and 100
bytes at t=2. The empty SEND puts nothing on the wire, and the 100 bytes go
out as usual. Before the repair, the empty SEND stopped the simulation with
"Returning an empty chunk is not allowed". The test client sends a packet
without content for a size of 0.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

*.cli_app.sendScript="1.0 0; 2.0 100"

include ../../lib/defaults.ini

%contains: stdout
[0.005 A002] A.1000 > B.2000: A ack 501 win 16384
[2.001 A003] A.1000 > B.2000: A 1:101(100) ack 501 win 16384

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
