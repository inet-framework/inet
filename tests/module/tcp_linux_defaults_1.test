%description:
Tests that LinuxTcp selects the defaults of Linux. The client sends 30000
bytes at t=1. Its SYN carries the options of Linux (MSS, SACK permitted,
timestamps and window scale), and its first flight is the initial window
of Linux (TCP_INIT_CWND), ten segments, where Tcp sends three. With the
receive buffer of Linux (tcp_rmem[1]), the window scale is 10, so the windows
after the handshake are in units of 1024 bytes.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=true

*.tcptester.script=""

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 30000"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.typename = "LinuxTcp"

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%# the SYN carries the options of Linux
%contains: postrun-command(1).out
[0.001 A001] A.1000 > B.2000: S 0:0(0) win 65535   Option(s): MaxSegSize NOP WinScale SackPermitted TS(0,0)
%# the tenth data segment leaves before the first ACK arrives
%contains: postrun-command(1).out
[1.001 A012] A.1000 > B.2000: A 13033:14481(1448) ack 501 win 63   Option(s): NOP NOP TS(1000,2)
[1.003 B002] A.1000 < B.2000: A ack 1449 win 64   Option(s): NOP NOP TS(1002,1000)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
