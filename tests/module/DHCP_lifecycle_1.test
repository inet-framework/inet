%description:

Test for basic DHCP lifecycle handling.

The client probes the granted address for probeWait (1s) before it takes it (RFC 5227), so
the shutdown at 1s stops the first probe. The rebooted client probes again (RFC 2131
section 3.2) and takes the address while the server is down. After the server restarts, the
client takes the address again, and it renews its lease without a probe.

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
ned-path = .;../../../../src;../../lib
cmdenv-express-mode = false
sim-time-limit = 1000s

**.hasStatus = true
**.scenarioManager.script = xmldoc("scenario.xml")

**.numApps = 1

**.client.app[0].typename = "DhcpClient"
**.client.app[0].interface = "eth0"

**.server.app[0].typename = "DhcpServer"
**.server.app[0].subnetMask = "255.255.255.0"
**.server.app[0].numReservedAddresses = 100
**.server.app[0].maxNumClients = 100
**.server.app[0].gateway = "192.168.1.1"
**.server.app[0].dns = ""
**.server.app[0].leaseTime = 100s
**.server.app[0].interface = "eth0"

%file: test.ned

import inet.test.moduletest.lib.*;
import inet.node.ethernet.Eth10M;
import inet.node.inet.StandardHost;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.common.scenario.ScenarioManager;

network Test
{
    submodules:
        scenarioManager: ScenarioManager;
        configurator: Ipv4NetworkConfigurator {
            parameters:
                config = xml("<config><interface hosts='server' address='192.168.1.1' netmask='255.255.255.0'/></config>");
        }
        client: StandardHost;
        server: StandardHost;
    connections:
        client.ethg++ <--> Eth10M <--> server.ethg++;
}

%file: scenario.xml

<scenario>
    <at t="1.0">
        <shutdown module="client"/>
    </at>
    <at t="2.0">
        <startup module="client"/>
    </at>
    <at t="3.0">
        <shutdown module="server"/>
    </at>
    <at t="4.0">
        <startup module="server"/>
    </at> -->
</scenario>

%contains-regex: stdout
.*
Probing the granted address 192\.168\.1\.100 before taking it\.
.*
Test.client shutting down
.*
Test.client shut down
.*
Test.client starting up
.*
Test.client started
.*
Probing the granted address 192\.168\.1\.100 before taking it\.
.*
DHCPACK message arrived in REBOOTING state. Initialization with known IP address was successful.
.*
Test.server shutting down
.*
Test.server shut down
.*
The probe of 192\.168\.1\.100 went unanswered\. The address is free\.
.*
The requested IP 192\.168\.1\.100/255\.255\.255\.0 is available. Assigning it to client.
.*
Test.server starting up
.*
Test.server started
.*
The requested IP 192\.168\.1\.100/255\.255\.255\.0 is available. Assigning it to client.
.*
The requested IP 192\.168\.1\.100/255\.255\.255\.0 is available. Assigning it to client.
DHCPACK message arrived in RENEWING state. The renewing process was successful.
.*
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
