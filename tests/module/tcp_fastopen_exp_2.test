%description:
Tests the choice of the option for a TCP Fast Open cookie request with a
server without Fast Open (Linux tcp_fastopen_cache_set(): "first kind 34,
then kind 254 once, then kind 34"). The request of connection 1 (kind 34) has
no answer, so connection 2 requests with the experimental option (kind 254).
That request has no answer too, so connection 3 requests with kind 34 again.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.fastOpen=true
*.cli_app.tOpen2=0.5s
*.cli_app.active2=true
*.cli_app.localPort2=1001
*.cli_app.fastOpen2=true
*.cli_app.tOpen3=1s
*.cli_app.active3=true
*.cli_app.localPort3=1002
*.cli_app.fastOpen3=true
*.srv_app.tOpen2=0.5s
*.srv_app.localPort2=2000
*.srv_app.tOpen3=1s
*.srv_app.localPort3=2000

*.*_tcp.fastopenExpOptionEnabled = true
*.cli_tcp.fastopenClientEnabled = true

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.001 A001] A.1000 > B.2000: S 0:0(0) win 16384   Option(s): MaxSegSize NOP NOP FastOpen(cookieLen=0)
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.501 A003] A.1001 > B.2000: S 125000:125000(0) win 16384   Option(s): MaxSegSize FastOpenExp(cookieLen=0)
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A005] A.1002 > B.2000: S 250000:250000(0) win 16384   Option(s): MaxSegSize NOP NOP FastOpen(cookieLen=0)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
