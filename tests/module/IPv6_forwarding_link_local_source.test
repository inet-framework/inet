%description:
Tests that a router does not forward a datagram with a link-local source address
onto another link (RFC 4291 Section 2.5.6, RFC 4007 Section 9), and that it
answers with ICMPv6 Destination Unreachable, code 2, "beyond scope of source
address" (RFC 4443 Section 3.1).

hostA pings hostB's global address from its own link-local address. The router
between them must drop the three Echo Requests instead of forwarding them to
hostB's link, and hostA must receive three Destination Unreachable messages with
code 2.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

network LinkLocalSourceNetwork
{
    types:
        channel ethline extends DatarateChannel
        {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        configurator: Ipv6FlatNetworkConfigurator;
        hostA: StandardHost6;
        router: Router6;
        hostB: StandardHost6;
    connections:
        hostA.ethg++ <--> ethline <--> router.ethg++;
        router.ethg++ <--> ethline <--> hostB.ethg++;
}
%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = ../../../../src
network = LinkLocalSourceNetwork
sim-time-limit = 6s
cmdenv-express-mode = false
cmdenv-log-prefix = "%C: "

**.hostA.eth[0].address = "0A:AA:00:00:00:0A"
**.hostA.numApps = 1
**.hostA.app[0].typename = "PingApp"
**.hostA.app[0].srcAddr = "fe80::8aa:ff:fe00:a"
**.hostA.app[0].destAddr = "hostB(ipv6)"
**.hostA.app[0].startTime = 4s
**.hostA.app[0].sendInterval = 0.5s
**.hostA.app[0].count = 3
%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%not-contains-regex: stdout
LinkLocalSourceNetwork\.router\.ipv6\.ipv6: next hop for aaaa[^\n]*, interface eth1
%#--------------------------------------------------------------------------------------------------------------
%contains-regex: stdout
(LinkLocalSourceNetwork\.router\.ipv6\.ipv6: source address is link-local and the datagram would leave its link, dropping[\s\S]*){3}
%#--------------------------------------------------------------------------------------------------------------
%contains-regex: stdout
(LinkLocalSourceNetwork\.hostA\.ipv6\.lp: Dispatching packet[^\n]*Icmpv6DestUnreachableMsg[^\n]*code[^,\n]*= 2[\s\S]*){3}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
