*.a.capture.pcapFile = "results/ampdu-${runnumber}-tx.pcap"
*.b.capture.pcapFile = "results/ampdu-${runnumber}-rx.pcap"
**.scalar-recording = false
**.vector-recording = false
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.a.mobility.initialX = 0m
*.b.mobility.initialX = 10m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m

%file: check-capture.py
import collections
import hashlib
import json
from pathlib import Path
import re
import struct
import sys
import traceback
import zlib

# Independent raw-byte oracle: imports no INET serializer/helper implementation.
# Radiotap field definitions: https://radiotap.org/fields/A-MPDU%20status.html
FIELDS = {0:(8,8),1:(1,1),2:(1,1),3:(2,4),5:(1,1),6:(1,1),10:(1,1),19:(1,3),20:(4,8),21:(2,12)}

def audit_error(kind,value,trace):
    Path('capture-audit-error.txt').write_text(''.join(traceback.format_exception(kind,value,trace)))
    sys.__excepthook__(kind,value,trace)
sys.excepthook = audit_error

def golden(index):
    header = struct.pack('<HH',0x0088,0)
    header += bytes.fromhex('020000000002020000000001020000000003')
    header += struct.pack('<HH',(100+index)<<4,0x65)
    body = header + bytes.fromhex('aaaa0300000088b5') + bytes([0x20 if index else 0x10]) * (12 if index else 9)
    return body + struct.pack('<I',zlib.crc32(body))

def capture(path):
    data = path.read_bytes()
    if not data:
        return [] # PcapWriter creates its global header lazily at first record.
    assert data[:4] == bytes.fromhex('d4c3b2a1'), path
    assert struct.unpack_from('<I',data,20)[0] == 127
    offset = 24
    result = []
    while offset < len(data):
        sec,usec,size,original = struct.unpack_from('<IIII',data,offset)
        offset += 16
        assert size == original and offset+size <= len(data)
        raw = data[offset:offset+size]
        offset += size
        version,pad,length,present = struct.unpack_from('<BBHI',raw)
        assert version == pad == 0 and not present & 0x80000000
        cursor = 8
        fields = {}
        for bit in range(31):
            if present & (1<<bit):
                assert bit in FIELDS, bit
                align,count = FIELDS[bit]
                cursor = (cursor+align-1)//align*align
                fields[bit] = raw[cursor:cursor+count]
                cursor += count
        assert cursor <= length
        result.append((fields,raw[length:]))
    assert offset == len(data)
    return result

def delimiters(raw, vht):
    cursor = 0
    members = []
    while cursor+4 <= len(raw):
        word,crc,signature = struct.unpack_from('<HBB',raw,cursor)
        assert signature == 0x4e and not word & 2
        length = (word>>4) | ((word&12)<<10)
        eof = bool(word&1)
        cursor += 4
        if length:
            assert not eof and cursor+length <= len(raw)
            members.append((raw[cursor:cursor+length],crc))
            cursor += length
            if cursor == len(raw):
                break
            cursor += (-length)%4
        else:
            assert vht or not eof
    return members

def metadata(fields,vht):
    assert fields[1][0] & 0x10
    assert struct.unpack('<HH',fields[3])[0] == 5180
    if vht:
        known,flags,width,users,coding,group,aid = struct.unpack('<HBB4sBBH',fields[21])
        assert known & 0x44 == 0x44 and flags & 4 and width == 4
        assert users == bytes([0x71,0,0,0]) and 19 not in fields
        return {'family':'VHT','width_mhz':80,'short_gi':bool(flags&4),'mcs':users[0]>>4,'nss':users[0]&15,'channel_mhz':5180}
    else:
        known,flags,mcs = fields[19]
        assert known & 7 == 7 and flags & 7 == 5 and mcs == 7 and 21 not in fields
        return {'family':'HT','width_mhz':40,'short_gi':bool(flags&4),'mcs':mcs,'nss':mcs//8+1,'channel_mhz':5180}

settings = {}
run = None
log = Path('test.out').read_text()
for line in log.splitlines():
    match = re.search(r'Preparing for running configuration General, run #(\d+)',line)
    if match: run = int(match[1])
    if line.startswith('Scenario:'):
        values = dict(re.findall(r'\$(\w+)=([^, ]+)',line))
        settings[run] = (values['vht']=='true',int(values['scenario']))
assert len(settings) == 12 and set(settings.values()) == {(v,s) for v in (False,True) for s in range(6)}
assert log.count('Dumping packet') == 40, 'Actual verbose printer path must execute for every record'
audit = []
manifest = []
observations = []
for run,(vht,scenario) in sorted(settings.items()):
    tx = capture(Path(f'results/ampdu-{run}-tx.pcap'))
    rx = capture(Path(f'results/ampdu-{run}-rx.pcap'))
    assert len(tx) == (1 if scenario==4 else 2), (run,'tx',len(tx))
    assert len(rx) == (0 if scenario==3 else 1 if scenario==4 else 2), (run,'rx',len(rx))
    if scenario==3:
        original = Path(f'results/psdu-{run}-tx.bin').read_bytes()
        truncated = Path(f'results/psdu-{run}-rx.bin').read_bytes()
        assert len(truncated)==73 and truncated==original[:73]
        assert truncated[4:51]==golden(0), 'A complete good first member must precede the rejected truncation'
        assert truncated[68:]==golden(1)[:5], 'Only five bytes of the second member remain'
    for side,records in [('tx',tx),('rx',rx)]:
        path = Path(f'results/ampdu-{run}-{side}.pcap')
        manifest.append({'path':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'records':len(records)})
        if scenario!=4:
            body = Path(f'results/psdu-{run}-{side}.bin')
            manifest.append({'path':str(body),'sha256':hashlib.sha256(body.read_bytes()).hexdigest(),'bytes':body.stat().st_size})
        expected = [golden(0)] if scenario==4 else [golden(0),golden(1)]
        if side=='rx' and scenario in (1,2):
            first = bytearray(expected[0])
            if scenario==1: first[-1] ^= 0x80
            else: first[0]=first[1]=first[4]=first[5]=0xff
            expected[0] = bytes(first)
        raw_members = None
        if scenario != 4 and not (side=='rx' and scenario==3):
            raw_members = delimiters(Path(f'results/psdu-{run}-{side}.bin').read_bytes(),vht)
            assert [m for m,crc in raw_members] == expected, (run,side,'actual PSDU members')
        references = []
        for index,(fields,mac) in enumerate(records):
            decoded = metadata(fields,vht)
            assert mac == expected[index], (run,side,index,'member bytes')
            crc_ok = zlib.crc32(mac[:-4]) == int.from_bytes(mac[-4:],'little')
            expected_bad = side=='rx' and (scenario==5 or index==0 and scenario in (1,2))
            assert bool(fields[1][0]&0x40) == expected_bad, (run,side,index,'bad-FCS flag',fields[1][0],expected_bad)
            assert crc_ok == (not (side=='rx' and index==0 and scenario in (1,2))), (run,side,index,'independent MAC CRC')
            observation = {'run':run,'side':side,'member_index':index,'mac_hex':mac.hex(),'mac_length':len(mac),
                'crc32_valid':crc_ok,'bad_fcs':bool(fields[1][0]&0x40),'metadata':decoded,
                'radiotap_fields_hex':{str(k):v.hex() for k,v in fields.items()}}
            if scenario==4:
                assert 20 not in fields
            else:
                reference,flags,crc,reserved = struct.unpack('<IHBB',fields[20])
                references.append(reference)
                assert flags == (0x00a4 | (8 if index==1 else 0))
                assert crc == raw_members[index][1] and reserved==0
                observation['ampdu'] = {'reference':reference,'flags':flags,'delimiter_crc':crc}
            observations.append(observation)
        if references: assert len(set(references)) == 1
    audit.append({'run':run,'vht':vht,'scenario':scenario,'tx_records':len(tx),'rx_records':len(rx),'status':'PASS'})
Path('capture-audit.json').write_text(json.dumps({'status':'PASS','rounds':audit,'capture_manifest':manifest,
    'records':observations,'actual_verbose_printer_calls':log.count('Dumping packet'),
    'radiotap_authority':'https://radiotap.org/fields/A-MPDU%20status.html',
    'delimiter_crc_scope':'Observed value cross-checked against actual PSDU delimiter; no independent delimiter polynomial claim.'},indent=2)+'\n')
print('A-MPDU capture audit PASS:12 real-radio rounds, exact member bytes/FCS/radiotap')

%contains: stdout
actual A-MPDU capture round PASS

%not-contains: stdout
it doesn't own

%not-contains: stdout
undisposed object:
