%description:
Actual dimensional-radio capture through the opt-in IEEE80211 recorder. HT40
and VHT80 each send two distinguishable computed-FCS QoS members. Receiver
decapsulation faults damage only the first FCS, arbitrary first-header bytes,
or truncate the second member; another case marks the whole PPDU erroneous.
The recorder must preserve bad member bytes and still record the good second
member, atomically reject truncated structure, and delegate ordinary frames.
An independent Python PCAP/radiotap/CRC32 oracle checks every captured byte.
This isolates radio observation; it does not prove MAC aggregation/admission.

%extraargs: -r 0..11
%postrun-command: python3 check-capture.py

%file: test.cc
#include <fstream>
#include <iostream>
#include <memory>

#include "inet/common/ProtocolTag_m.h"
#include "inet/common/Simsignals.h"
#include "inet/common/checksum/Checksum.h"
#include "inet/linklayer/ieee80211/mac/aggregation/Ieee80211Ampdu.h"
#include "inet/linklayer/ieee80211/mac/contract/Ieee80211AmpduObservationTag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Radio.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

namespace Ieee80211AmpduCapture_1 {

static void saveBody(const Packet *packet, const char *side)
{
    auto header = Ieee80211Radio::peekIeee80211PhyHeaderAtFront(packet);
    auto available = packet->getDataLength() - header->getChunkLength();
    auto length = std::min(B(available), header->getLengthField());
    auto bytes = packet->peekDataAt<BytesChunk>(header->getChunkLength(), length)->getBytes();
    auto pattern = std::string("results/psdu-${runnumber}-") + side + ".bin";
    auto path = cSimulation::getActiveSimulation()->getEnvir()->getConfig()->substituteVariables(pattern.c_str());
    std::ofstream stream(path, std::ios::binary);
    ASSERT(stream.good());
    stream.write(reinterpret_cast<const char *>(bytes.data()), bytes.size());
}

class FaultRadio : public Ieee80211Radio
{
  protected:
    void decapsulate(Packet *packet) const override
    {
        int scenario = par("scenario");
        const auto& vector = packet->getTag<Ieee80211ModeInd>()->getTxVector();
        ASSERT(!packet->findTag<Ieee80211AmpduObservationTag>());
        if (vector.ampdu) {
            auto header = peekIeee80211PhyHeaderAtFront(packet);
            Ieee80211AmpduLayout layout;
            ASSERT(findAmpdu(packet, header->getChunkLength(), header->getLengthField(),
                vector.format == Ieee80211TxVector::VHT, layout));
            ASSERT(layout.members.size() == 2);
            auto first = header->getChunkLength() + layout.members[0].offset;
            if (scenario == 1 || scenario == 2) {
                auto bytes = packet->peekDataAt<BytesChunk>(first, layout.members[0].length)->getBytes();
                if (scenario == 1)
                    bytes.back() ^= 0x80;
                else {
                    // Delimiters/length stay valid while FC/header are arbitrary.
                    bytes[0] = bytes[1] = 0xff;
                    bytes[4] = bytes[5] = 0xff;
                }
                packet->replaceDataAt(makeShared<BytesChunk>(bytes), first, layout.members[0].length);
            }
            else if (scenario == 3) {
                auto end = header->getChunkLength() + layout.members[1].offset + B(5);
                packet->eraseDataAt(end, packet->getDataLength() - end);
            }
            else if (scenario == 5)
                packet->setBitError(true);
            saveBody(packet, "rx");
        }
        Ieee80211Radio::decapsulate(packet);
    }
};
Define_Module(FaultRadio);

class Probe : public cSimpleModule, public cListener
{
    opp_component_ptr<cModule> medium;
    const IIeee80211Mode *mode = nullptr;
    int scenario = 0;
    bool vht = false;
    int departures = 0;
    int deliveries = 0;

    Packet *member(int index)
    {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setChunkLength(B(26));
        header->setDurationField(SIMTIME_ZERO);
        header->setReceiverAddress(MacAddress("02:00:00:00:00:02"));
        header->setTransmitterAddress(MacAddress("02:00:00:00:00:01"));
        header->setAddress3(MacAddress("02:00:00:00:00:03"));
        header->setSequenceNumber(SequenceNumberCyclic(100 + index));
        header->setTid(5);
        header->setAckPolicy(BLOCK_ACK);
        auto packet = new Packet(index ? "capture-second" : "capture-first", header);
        // Experimental SNAP type keeps this radio-only payload opaque; no
        // truncated synthetic IPv4 packet is presented to the verbose printer.
        std::vector<uint8_t> payload = {0xaa,0xaa,0x03,0,0,0,0x88,0xb5};
        payload.insert(payload.end(), index ? 12 : 9, index ? 0x20 : 0x10);
        packet->insertAtBack(makeShared<BytesChunk>(payload));
        auto bytes = packet->peekDataAsBytes()->getBytes();
        auto fcs = makeShared<Ieee80211MacTrailer>();
        fcs->setFcsMode(FCS_COMPUTED);
        fcs->setFcs(ethernetFcs(bytes.data(), bytes.size()));
        packet->insertAtBack(fcs);
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
        return packet;
    }

  protected:
    void initialize() override
    {
        scenario = par("scenario");
        vht = par("vht");
        auto modes = Ieee80211ModeSet::getModeSet("ac-complete");
        for (int i = 0; i < modes->getNumModes(); i++) {
            auto candidate = modes->getMode(i);
            if ((vht ? candidate->getVhtMcsIndex() : candidate->getHtMcsIndex()) == 7
                    && candidate->getDataMode()->getBandwidth() == MHz(vht ? 80 : 40)
                    && candidate->getDataMode()->getNumberOfSpatialStreams() == 1
                    && (vht ? candidate->isVhtShortGuardInterval() : candidate->isHtShortGuardInterval()))
                mode = candidate;
        }
        ASSERT(mode);
        medium = getParentModule()->getSubmodule("radioMedium");
        medium->subscribe(IRadioMedium::signalDepartureStartedSignal, this);
        scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("send", 0));
        scheduleAt(SimTime(3, SIMTIME_MS), new cMessage("check", 1));
    }

    void receiveSignal(cComponent *, simsignal_t, cObject *object, cObject *) override
    {
        auto transmission = check_and_cast<const Ieee80211Transmission *>(object);
        const auto& vector = transmission->getTxVector();
        ASSERT(vector.mode == mode && vector.bandwidth == MHz(vht ? 80 : 40));
        ASSERT(vector.ampdu == (scenario != 4));
        ASSERT(!transmission->getPacket()->findTag<Ieee80211AmpduObservationTag>());
        if (vector.ampdu)
            saveBody(transmission->getPacket(), "tx");
        departures++;
    }

    void handleMessage(cMessage *message) override
    {
        if (auto packet = dynamic_cast<Packet *>(message)) {
            auto vector = packet->getTag<Ieee80211ModeInd>()->getTxVector();
            ASSERT(vector.mode == mode && vector.bandwidth == MHz(vht ? 80 : 40));
            ASSERT(vector.ampdu == (scenario != 4));
            ASSERT(!packet->findTag<Ieee80211AmpduObservationTag>());
            ASSERT(packet->hasBitError() == (scenario == 3 || scenario == 5));
            deliveries++;
            delete packet;
            return;
        }
        int kind = message->getKind();
        delete message;
        if (kind == 1) {
            ASSERT(departures == 1 && deliveries == 1);
            std::cout << "actual A-MPDU capture round PASS vht=" << vht << " scenario=" << scenario << std::endl;
            endSimulation();
            return;
        }
        std::unique_ptr<Packet> first(member(0));
        std::unique_ptr<Packet> second(member(1));
        Packet *packet = scenario == 4 ? first.release() : buildAmpdu({first.get(), second.get()}, vht, B(64));
        Ieee80211TxVector vector(mode);
        vector.ampdu = scenario != 4;
        vector.singleMpdu = vht && scenario == 4;
        packet->addTagIfAbsent<Ieee80211ModeReq>()->setTxVector(vector);
        send(packet, "out");
    }

  public:
    using cListener::finish;
    ~Probe() override
    {
        if (medium)
            medium->unsubscribe(IRadioMedium::signalDepartureStartedSignal, this);
    }
};
Define_Module(Probe);
}

%file: test.ned
import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.common.contract.packetlevel.IRadio;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadio;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;
import inet.physicallayer.wireless.ieee80211.radiotap.Ieee80211PcapRecorder;

module FaultRadio extends Ieee80211DimensionalRadio
{
    parameters:
        int scenario;
        @class(FaultRadio);
}

module RadioNode
{
    gates:
        input down;
        output up;
    submodules:
        mobility: StationaryMobility;
        radio: <default("Ieee80211DimensionalRadio")> like IRadio {
            parameters:
                antenna.mobilityModule = absPath("^.mobility");
        }
        capture: Ieee80211PcapRecorder;
    connections allowunconnected:
        down --> radio.upperLayerIn;
        radio.upperLayerOut --> up;
}

simple Probe
{
    parameters:
        bool vht;
        int scenario;
        @class(Probe);
    gates:
        output out;
        input in;
}

network Test
{
    submodules:
        radioMedium: Ieee80211DimensionalRadioMedium;
        a: RadioNode;
        b: RadioNode;
        probe: Probe;
    connections allowunconnected:
        probe.out --> a.down;
        b.up --> probe.in;
}

%inifile: omnetpp.ini
[General]
network = Test
ned-path = .;../../../../src
sim-time-limit = 4ms
seed-set = 0
cmdenv-express-mode = false
cmdenv-event-banners = false
*.probe.vht = ${vht=false,true}
*.probe.scenario = ${scenario=0..5}
*.b.radio.typename = "FaultRadio"
*.b.radio.scenario = ${scenario}
*.a.radio.initialRadioMode = "transmitter"
*.b.radio.initialRadioMode = "receiver"
**.radio.opMode = "ac-complete"
**.radio.bandName = "5 GHz (mapped 20 MHz)"
**.radio.channelNumber = 0
**.radio.contiguousChannelAllocation = true
**.radio.bandwidth = ${vht} ? 80MHz : 40MHz
**.radio.transmitter.bandwidth = 20MHz
**.radio.transmitter.bitrate = 6Mbps
**.radio.transmitter.power = 20mW
**.radio.fcsMode = "computed"
**.radio.receiver.sensitivity = -100dBm
**.radio.receiver.energyDetection = -100dBm
**.radio.receiver.snirThreshold = 4dB
*.radioMedium.listeningFilter = false
*.radioMedium.macAddressFilter = false
*.radioMedium.radioModeFilter = false
*.radioMedium.rangeFilter = ""
*.radioMedium.backgroundNoise.power = nan W
*.radioMedium.backgroundNoise.powerSpectralDensity = -130dBmWpMHz
**.capture.moduleNamePatterns = "radio"
*.a.capture.sendingSignalNames = "transmissionEnded"
*.a.capture.receivingSignalNames = ""
*.b.capture.sendingSignalNames = ""
*.b.capture.receivingSignalNames = "receptionEnded"
**.capture.helpers = "inet::physicallayer::Ieee80211RadiotapPcapRecorderHelper"
**.capture.dumpProtocols = "ieee80211mac"
**.capture.fileFormat = "pcap"
**.capture.dumpBadFrames = true
**.capture.verbose = true
**.capture.packetFilter = "capture-*"
**.capture.alwaysFlush = true
**.capture.cmdenv-log-level = debug
