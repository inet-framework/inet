%description:
Tests tcpEcnMode="passive" on the server: the client ("rfc3168") requests
ECN on its SYN (ECE and CWR), the passive server answers with an ECN-setup
SYN-ACK (ECE), and the data of the client is ECT(0).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000"
*.cli_tcp.tcpEcnMode = "rfc3168"
*.srv_tcp.tcpEcnMode = "passive"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[0.001 A001] A.1000 > B.2000: S E W 0:0(0) win 16384   Option(s): MaxSegSize
srv_tcp: LISTEN --> SYN_RCVD  (on RCV_SYN)
[0.003 B001] A.1000 < B.2000: A S E 500:500(0) ack 1 win 16384   Option(s): MaxSegSize
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 ECT(0) 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
