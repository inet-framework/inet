%description:

Tests that Ieee8021adPolicy rejects a port type of the S-tag in a bridge that
uses the C-tag in its ports parameter at initialization, naming the interface.
The network is the one of lib/ieee8021ad-access-trunk.ini, with one malformed
parameter.

%inifile: omnetpp.ini

[General]
ned-path = .;../../../../src;../../lib
*.bridge1.bridging.vlanPolicy.ports = {"eth0" : {"type" : "cnp", "vid" : 10}, "eth1" : {"type" : "access", "vid" : 10}, "eth2" : {"type" : "access", "vid" : 20}, "eth3" : {"type" : "trunk", "vids" : [10, 20]}}
include ../../lib/ieee8021ad-access-trunk.ini

%exitcode: 1
%postrun-command: grep '<!>' test.out test.err > vlan-port-error.out || true
%contains: vlan-port-error.out
Port type 'cnp' of interface 'eth0' requires vlanTagType "s"
