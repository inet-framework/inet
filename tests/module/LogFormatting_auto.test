%description:

With inet-log-formatting = auto, the default, the log contains no ANSI escape
sequences when the standard output is not a terminal (the test runner
captures it into a file): the field name of an EV_FIELD, bold with
inet-log-formatting = true, is plain. The option is left at its default.

%inifile: omnetpp.ini

[General]
record-vector-results = false
record-scalar-results = false
ned-path = .;../../../../src;../../lib
network = inet.test.moduletest.lib.ClientServer
sim-time-limit = 1s
cmdenv-express-mode = false
cmdenv-event-banners = false

%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
Registering network interface, interface = (inet::NetworkInterface)lo[0] lo0
%not-contains-regex: stdout
\x1B\[
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
