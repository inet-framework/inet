%description:
Tests lastDataRecvTime in STATUS, as Linux tcpi_last_data_recv (icsk_ack.lrcvtime):
the arrival of the last in-order data, and before any data the end of the
handshake. The server asks for STATUS at 0.5, 1.5 and 3.5 s: the times are the
end of its handshake (0.006), and the arrivals of the data of t=1 and t=2. The
FIN of t=3 is not data and does not change the time.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 100; 2.0 100"
*.cli_app.tClose=3s
*.srv_app.statusRequestScript="0.5, 1.5, 3.5"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:101(100) ack 501 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 101 win 16384 
[2.001 A004] A.1000 > B.2000: A 101:201(100) ack 501 win 16384 
[2.203 B003] A.1000 < B.2000: A ack 201 win 16384 
cli_tcp: ESTABLISHED --> FIN_WAIT_1  (on CLOSE)
[3.001 A005] A.1000 > B.2000: A F ack 501 win 16384 
srv_tcp: ESTABLISHED --> CLOSE_WAIT  (on RCV_FIN)
[3.003 B004] A.1000 < B.2000: A ack 202 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
STATUS: lastDataRecvTime=0.006
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
STATUS: lastDataRecvTime=1.002
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
STATUS: lastDataRecvTime=2.002
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
