%description:
DCF, legacy HCF, and prepared HCF release frame contexts before frame-store deletion.
End simulation or delete the sender during transmission or response wait.
A model-change listener checks the owner before its destructor, without accessing freed memory.

%file: ExchangeTeardown.cc
#include <functional>
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Dcf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"

namespace inet::ieee80211 {

class TeardownDriver : public cSimpleModule
{
  protected:
    cMessage *teardown = nullptr;
    bool injected = false;
    cModule *sender = nullptr;
    std::function<void()> checkActiveExchange;
    void initialize() override;
    void startExchange();
    void handleMessage(cMessage *message) override
    {
        if (!injected) {
            injected = true;
            startExchange();
            return;
        }
        ASSERT(message == teardown && sender && checkActiveExchange);
        checkActiveExchange();
        checkActiveExchange = {};
        if (getParentModule()->par("deleteNode").boolValue()) {
            sender->deleteModule();
            sender = nullptr;
        }
        endSimulation();
    }

  public:
    ~TeardownDriver() { cancelAndDelete(teardown); }
    void arm(cModule *node, std::function<void()> check)
    {
        Enter_Method("arm");
        ASSERT(sender == nullptr);
        sender = node;
        checkActiveExchange = std::move(check);
        scheduleAfter(SimTime(1, SIMTIME_US), teardown);
    }
};
Define_Module(TeardownDriver);

template<typename Base>
class TeardownCoordination : public Base
{
  protected:
    InProgressFrames *watchedStore = nullptr;

    void sendUp(const std::vector<Packet *>& frames) override
    {
        // This MAC-only fixture has no upper-layer protocol header.
        for (auto frame : frames) {
            this->take(frame);
            delete frame;
        }
    }

    void arm(bool responseWait)
    {
        auto network = this->getSimulation()->getSystemModule();
        if (watchedStore || this->getFullPath().find("sender") == std::string::npos ||
            network->par("responseWait").boolValue() != responseWait)
            return;
        auto context = this->frameSequenceHandler->getContext();
        ASSERT(context && this->frameSequenceHandler->isSequenceRunning());
        watchedStore = context->getInProgressFrames();
        watchedStore->subscribe(PRE_MODEL_CHANGE, this);
        auto driver = check_and_cast<TeardownDriver *>(network->getSubmodule("test"));
        driver->arm(network->getSubmodule("sender"), [this, responseWait] {
            ASSERT(this->frameSequenceHandler->isSequenceRunning());
            auto step = this->frameSequenceHandler->getContext()->getLastStep();
            ASSERT(step->getType() == (responseWait ? IFrameSequenceStep::Type::RECEIVE : IFrameSequenceStep::Type::TRANSMIT));
        });
    }

    void transmissionStarted(TxRequestId id) override
    {
        Base::transmissionStarted(id);
        arm(false);
    }

    void scheduleStartRxTimer(simtime_t timeout) override
    {
        Base::scheduleStartRxTimer(timeout);
        arm(true);
    }

    void receiveSignal(cComponent *source, simsignal_t signal, cObject *object, cObject *details) override
    {
        if (signal == PRE_MODEL_CHANGE) {
            auto deletion = dynamic_cast<cPreModuleDeleteNotification *>(object);
            if (deletion && deletion->module == watchedStore) {
                auto context = this->frameSequenceHandler ? this->frameSequenceHandler->getContext() : nullptr;
                ASSERT2(!context || context->getInProgressFrames() != watchedStore,
                    "Frame store still has a borrowed reference at destruction");
                std::cout << "Frame context released before frame-store destruction.\n";
                watchedStore = nullptr;
            }
        }
        else
            Base::receiveSignal(source, signal, object, details);
    }

  public:
    void inject()
    {
        Enter_Method("inject");
        auto header = makeShared<Ieee80211DataHeader>();
        if (this->getSimulation()->getSystemModule()->par("profile").intValue() != 0) {
            header->setType(ST_DATA_WITH_QOS);
            header->addChunkLength(QOSCONTROL_PART_LENGTH);
            header->setTid(5);
        }
        header->setReceiverAddress(MacAddress("02:00:00:00:00:02"));
        header->setTransmitterAddress(MacAddress("02:00:00:00:00:01"));
        header->setAddress3(MacAddress("02:00:00:00:00:01"));
        auto frame = new Packet("teardown-data", header);
        frame->insertAtBack(makeShared<ByteCountChunk>(B(200)));
        frame->insertAtBack(makeShared<Ieee80211MacTrailer>());
        this->processUpperFrame(frame, header);
    }
};

class TeardownDcf : public TeardownCoordination<Dcf> {};
class TeardownHcf : public TeardownCoordination<Hcf> {};
Define_Module(TeardownDcf);
Define_Module(TeardownHcf);

void TeardownDriver::initialize()
{
    teardown = new cMessage("teardown");
    scheduleAfter(SimTime(1, SIMTIME_MS), teardown);
}

void TeardownDriver::startExchange()
{
    auto mac = getParentModule()->getSubmodule("sender")->getSubmodule("wlan", 0)->getSubmodule("mac");
    if (getParentModule()->par("profile").intValue() == 0)
        check_and_cast<TeardownDcf *>(mac->getSubmodule("dcf"))->inject();
    else
        check_and_cast<TeardownHcf *>(mac->getSubmodule("hcf"))->inject();
}

} // namespace inet::ieee80211

%file: test.ned
import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mac.coordinationfunction.Dcf;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.inet.WirelessHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

module TeardownDcf extends Dcf { parameters: @class(::inet::ieee80211::TeardownDcf); }
module TeardownHcf extends Hcf { parameters: @class(::inet::ieee80211::TeardownHcf); }
simple TeardownDriver extends SimpleModule { parameters: @class(::inet::ieee80211::TeardownDriver); }
network TeardownNetwork
{
    parameters:
        int profile;
        bool responseWait;
        bool deleteNode;
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        sender: WirelessHost;
        receiver: WirelessHost;
        test: TeardownDriver;
}

%inifile: omnetpp.ini
[General]
network = TeardownNetwork
ned-path = .;../../../../src;../../lib
sim-time-limit = 2ms
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.profile = ${profile=0,1}
*.responseWait = ${false,true}
*.deleteNode = ${false,true}
*.radioMedium.propagation.typename = "ConstantTimePropagation"
*.radioMedium.propagation.propagationTime = 0s
**.wlan[*].agent.typename = ""
**.wlan[*].mgmt.typename = "Ieee80211MgmtAdhoc"
**.wlan[*].opMode = "a"
**.wlan[*].bitrate = 24Mbps
**.wlan[*].mac.qosStation = ${profile} != 0
**.wlan[*].mac.dcf.typename = "TeardownDcf"
**.wlan[*].mac.hcf.typename = "TeardownHcf"
**.wlan[*].mac.hcf.isBlockAckSupported = ${profile} == 1
**.wlan[*].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.originatorMacDataService.mpduAggregationPolicy.typename = ""
**.wlan[*].mac.hcf.edca.edcaf[2].txopProcedure.txopLimit = 2ms
**.wlan[*].mac.*.rtsPolicy.rtsThreshold = 4096B
*.sender.wlan[0].address = "02:00:00:00:00:01"
*.receiver.wlan[0].address = "02:00:00:00:00:02"
**.mobility.initFromDisplayString = false
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m
*.sender.mobility.initialX = 0m
*.sender.mobility.initialY = 0m
*.receiver.mobility.initialX = 1m
*.receiver.mobility.initialY = 0m
**.wlan[*].radio.transmitter.power = 100mW
**.wlan[*].radio.receiver.sensitivity = -85dBm
**.wlan[*].radio.receiver.snirThreshold = 4dB

%contains: stdout
Frame context released before frame-store destruction.

%not-contains: stdout
<!> Warning:

%not-contains: stderr
<!> Warning:
