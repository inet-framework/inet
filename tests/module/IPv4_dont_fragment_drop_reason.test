%description:
Tests that IPv4 reports a datagram that is larger than the MTU of the next link
and has the Don't Fragment (DF) flag set with the packet drop reason
PACKET_TOO_BIG, so that the packetDropPacketTooBig statistic of Ipv4 counts it
and packetDropUndefined does not.

hostA sends three UDP datagrams with a 1000-byte payload and DF set to hostB. The router's
link toward hostB has an MTU of 576 bytes, so the router drops all three and
sends ICMP Destination Unreachable (Fragmentation Needed) to hostA.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;
import ned.DatarateChannel;

network DontFragmentNetwork
{
    types:
        channel ethline extends DatarateChannel
        {
            delay = 0.1us;
            datarate = 100Mbps;
        }
    submodules:
        configurator: Ipv4NetworkConfigurator;
        hostA: StandardHost;
        router: Router;
        hostB: StandardHost;
    connections:
        hostA.ethg++ <--> ethline <--> router.ethg++;
        router.ethg++ <--> ethline <--> hostB.ethg++;
}
%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
ned-path = ../../../../src
network = DontFragmentNetwork
sim-time-limit = 5s
record-vector-results = false
cmdenv-express-mode = true

**.router.eth[1].mac.mtu = 576B

**.hostA.numApps = 1
**.hostA.app[0].typename = "UdpBasicApp"
**.hostA.app[0].destAddresses = "hostB"
**.hostA.app[0].destPort = 1000
**.hostA.app[0].messageLength = 1000B
**.hostA.app[0].dontFragment = true
**.hostA.app[0].startTime = 1s
**.hostA.app[0].sendInterval = 1s
**.hostA.app[0].stopTime = 3.5s
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: gawk '$1 == "scalar" && $2 == "DontFragmentNetwork.router.ipv4.ip" && ($3 == "packetDropPacketTooBig:count" || $3 == "packetDropUndefined:count") { print $3, $4 }' results/*.sca > drops.out
%contains: drops.out
packetDropPacketTooBig:count 3
%#--------------------------------------------------------------------------------------------------------------
%contains: drops.out
packetDropUndefined:count 0
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
