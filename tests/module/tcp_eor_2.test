%description:
Tests that no full-sized segment spans a record boundary of MSG_EOR. The client
writes 1500 bytes with MSG_EOR and 1500 bytes without it. After the first ACK,
the segment 1001:1501 ends at the record boundary, and the next full-sized
segment starts there. Nagle holds the last 500 bytes until the next ACK.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1500 eor; 1.0 1500"
*.*_tcp.mss = 1000

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.203 B002] A.1000 < B.2000: A ack 1001 win 16384 
[1.205 A004] A.1000 > B.2000: A 1001:1501(500) ack 501 win 16384 
[1.205 A005] A.1000 > B.2000: A 1501:2501(1000) ack 501 win 16384 
[1.407 B003] A.1000 < B.2000: A ack 2501 win 16384 
[1.409 A006] A.1000 > B.2000: A 2501:3001(500) ack 501 win 16384 
[1.611 B004] A.1000 < B.2000: A ack 3001 win 16384 
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
MSG_EOR: record boundary at sequence number 1501
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
