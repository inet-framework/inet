%description:
Tests that Duplicate Address Detection (DAD) ends without completing for an
address that was removed from the interface while its DAD was still running
(RFC 4862 (IPv6 Stateless Address Autoconfiguration) Section 5.4; Ipv6InterfaceData::permanentlyAssign() asserts that the
interface holds the address).

The router advertises two autonomous prefixes in one Router Advertisement (RA):
aaaa:0:65::/64 from the configurator and aaaa:2::/64 from its routing table
configuration. The RA arrives after the host's link-local DAD has completed.
The first Prefix Information option assigns aaaa:0:65:0:8aa:ff:fe00:2 tentative
and starts its DAD. The second one takes the path written for a Mobile IPv6
handover: it records aaaa:0:65:0:8aa:ff:fe00:2 as the old care-of address and
restarts DAD on the link-local address. At this seed the link-local DAD
completes first, at 4.394825462416 s, and removes aaaa:0:65:0:8aa:ff:fe00:2. The
DAD of the removed address must not complete after that.

%#--------------------------------------------------------------------------------------------------------------
%file: test.ned
import inet.networklayer.configurator.ipv6.Ipv6FlatNetworkConfigurator;
import inet.node.ipv6.Router6;
import inet.node.ipv6.StandardHost6;
import ned.DatarateChannel;

network DadRemovedAddressNetwork
{
    types:
        channel ethline extends DatarateChannel
        {
            delay = 0.1us;
            datarate = 10Mbps;
        }
    submodules:
        configurator: Ipv6FlatNetworkConfigurator;
        router: Router6;
        host: StandardHost6;
    connections:
        host.ethg++ <--> ethline <--> router.ethg++;
}
%#--------------------------------------------------------------------------------------------------------------
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = ../../../../src
network = DadRemovedAddressNetwork
sim-time-limit = 10s
seed-set = 0
cmdenv-express-mode = false
cmdenv-log-prefix = "[%t] %C: "

**.router.routes = xml("<routingTable><local node='router'><interface name='eth0' AdvSendAdvertisements='on'><AdvPrefixList><AdvPrefix AdvValidLifetime='2592000' AdvOnLinkFlag='on' AdvPreferredLifetime='604800' AdvAutonomousFlag='on'>aaaa:2::/64</AdvPrefix></AdvPrefixList></interface></local></routingTable>")

**.eth[*].queue.typename = "EthernetQosQueue"
**.eth[*].queue.dataQueue.typename = "DropTailQueue"
**.eth[*].queue.dataQueue.packetCapacity = 10
%#--------------------------------------------------------------------------------------------------------------
%subst: /omnetpp:://
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
[4.394825462416] (Ipv6NeighbourDiscovery)DadRemovedAddressNetwork.host.ipv6.neighbourDiscovery: DAD completed for address fe80::8aa:ff:fe00:2 on eth0, address is unique
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
DAD completed for address aaaa:0:65:0:8aa:ff:fe00:2 on eth0
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
