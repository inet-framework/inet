%description:
Tests that an interface can be connected to scalar ifIn and ifOut gates of a
module, not only to the elements of ifIn[] and ifOut[] gate vectors.

When an interface is added to its interface table, the table finds the module
whose ifIn and ifOut gates the interface is connected to, and checks that both
gates have the same index. A scalar gate has no index, and two scalar gates
are consistent. The node of this test connects a loopback interface to a
module with scalar ifIn and ifOut gates, and must initialize without an error.

%file: ScalarIfGatesLayer.cc

#include "inet/common/INETDefs.h"

using namespace inet;

namespace InterfaceTable_scalar_ifIn_ifOut {

// Deletes everything it receives
class ScalarIfGatesLayer : public cSimpleModule
{
  protected:
    virtual void handleMessage(cMessage *msg) override { delete msg; }
};

Define_Module(ScalarIfGatesLayer);

} // namespace InterfaceTable_scalar_ifIn_ifOut

%file: test.ned

import inet.linklayer.loopback.LoopbackInterface;
import inet.networklayer.common.InterfaceTable;

simple ScalarIfGatesLayer
{
    parameters:
        @class(ScalarIfGatesLayer);
    gates:
        input ifIn;
        output ifOut;
}

module ScalarIfGatesNode
{
    parameters:
        @networkNode;
    submodules:
        interfaceTable: InterfaceTable;
        layer: ScalarIfGatesLayer;
        lo0: LoopbackInterface {
            interfaceTableModule = "^.interfaceTable";
        }
    connections:
        layer.ifOut --> lo0.upperLayerIn;
        lo0.upperLayerOut --> layer.ifIn;
}

network ScalarIfGatesTestNetwork
{
    submodules:
        node: ScalarIfGatesNode;
}

%inifile: omnetpp.ini
[General]
network = ScalarIfGatesTestNetwork
record-vector-results = false
sim-time-limit = 1s
cmdenv-express-mode = false

%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
Gate is not member of a gate vector
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
