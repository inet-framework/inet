%description:
Tests that an RTO ends the episode of a tail loss probe (RFC 8985 section
7.1, tlpEnabled=true). The tester deletes the last of four segments and
also the probe at t=1.212. The RTO at t=2.212 retransmits 1501:2001, and
the ACK of 2001 covers the probe. The first ACK above the probe comes at
t=6.003. The RTO already reduced cwnd, so the probe gives no second
congestion response.
%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

network = inet.test.moduletest.lib.TcpTestNet1

cmdenv-event-banners=false
cmdenv-express-mode=false
cmdenv-log-prefix="[%c]: "

*.testing=false

*.tcptester.script="a6 delete; a7 delete"

*.cli_app.active=true
*.cli_app.localAddress="10.0.0.1"
*.cli_app.localPort=1000
*.cli_app.connectAddress="10.0.0.2"
*.cli_app.connectPort=2000
*.cli_app.tOpen=0s
*.cli_app.tSend=-1s
*.cli_app.sendBytes=0B
*.cli_app.sendScript="1 2000;6 500"
*.cli_app.tClose=-1s

*.srv_app.active=false
*.srv_app.localAddress="10.0.0.2"
*.srv_app.localPort=2000
*.srv_app.connectAddress="10.0.0.1"
*.srv_app.connectPort=1000
*.srv_app.tOpen=0s
*.srv_app.tSend=-1s
*.srv_app.sendBytes=0B
*.srv_app.sendScript=""
*.srv_app.tClose=-1s

*.*_tcp.advertisedWindow = 5000
*.*_tcp.sackSupport = true
*.*_tcp.mss = 500
*.*_tcp.tcpAlgorithmClass = "TcpReno"
*.*_tcp.tlpEnabled = true
*.*_tcp.increasedIWEnabled = true



%contains: stdout
[1.213 A007] A.1000 > B.2000: A 1501:2001(500) ack 501 win 5000 # deleting

%contains: stdout
[2.213 A008] A.1000 > B.2000: A 1501:2001(500) ack 501 win 5000

%contains: stdout
[6.003 B006] A.1000 < B.2000: A ack 2501 win 5000

%not-contains: stdout
TLP: the probe repaired
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
