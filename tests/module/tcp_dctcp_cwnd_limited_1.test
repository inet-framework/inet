%description:
DcTcp grows cwnd in slow start as the other classic flavours do, by the
shared congestion control. The scenario of tcp_cwnd_limited_1: the
application sends one segment every 0.5 s, and then 20 segments at t=4 s.
Slow start does not grow cwnd while the application does not fill it, so
the 20 segments start with a window of two segments. DCTCP's own copy of
slow start grew cwnd by one segment at each ACK, so the burst started
with seven segments at once.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

# script format: "time numbytes; time numbytes; ..."
*.cli_app.sendScript="1.0 1024; 1.5 1024; 2.0 1024; 2.5 1024; 3.0 1024; 3.5 1024; 4.0 20480;"

*.*_tcp.tcpAlgorithmClass = "DcTcp"

include ../../lib/defaults.ini

%contains: stdout
[3.703 B007] A.1000 < B.2000: A ack 6145 win 16384
[4.001 A009] A.1000 > B.2000: A 6145:7169(1024) ack 501 win 16384
[4.001 A010] A.1000 > B.2000: A 7169:8193(1024) ack 501 win 16384
[4.003 B008] A.1000 < B.2000: A ack 8193 win 16384

%contains: stdout
[4.020] tcpdump finished, A:28 B:17 segments

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
