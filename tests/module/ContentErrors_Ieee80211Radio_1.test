%description:
Content errors of the chunk corruption mode with the IEEE 802.11 radio, without
a MAC. The far sender gives its radio a PSDU of three 500-byte chunks with
different fill bytes. The near sender, close to the receiver, starts to transmit
during the last chunk. The receiver radio receives the PSDU region by region:
the PHY header and the first two chunks stay correct, and the last chunk is
incorrect. The packet has no packet-level bit error. The tail and pad bits of an
OFDM mode are not part of the PSDU and stay as they were sent.

Runs 0 to 2 use the NIST model with ERP-OFDM, HT, and HR/DSSS modes. Runs 3 and
4 use the Yans and the BER table models, and run 5 the dimensional radio. Run 6
is the packet mode, in which the whole packet has a bit error. Runs 7 and 8 are
the byte and bit modes: the last chunk becomes a raw chunk with flipped bytes or
bits, marked incorrect.

%file: test.cc
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/common/packet/chunk/SequenceChunk.h"

namespace ContentErrors_Ieee80211Radio_1 {

using namespace inet;

// Hands one PSDU of chunks with different fill bytes to the radio at the given time.
class TestSource : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(par("startTime"), new cMessage("start")); }
    virtual void handleMessage(cMessage *msg) override
    {
        auto packet = new Packet(getParentModule()->getName());
        for (int i = 0; i < 3; i++)
            packet->insertAtBack(makeShared<ByteCountChunk>(B(par("chunkLength").intValue()), i + 1));
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
        send(packet, "out");
        delete msg;
    }
};

Define_Module(TestSource);

// Prints the packet-level flag and the flag of each chunk of a received packet.
class TestSink : public cSimpleModule
{
  protected:
    virtual void handleMessage(cMessage *msg) override
    {
        auto packet = check_and_cast<Packet *>(msg);
        std::cout << par("label").stdstringValue() << ": received " << packet->getName() << (packet->cPacket::hasBitError() ? " with" : " without") << " a packet-level bit error" << std::endl;
        const auto& content = packet->peekAll(Chunk::PF_ALLOW_INCOMPLETE | Chunk::PF_ALLOW_INCORRECT | Chunk::PF_ALLOW_IMPROPERLY_REPRESENTED);
        std::deque<Ptr<const Chunk>> chunks;
        if (content->getChunkType() == Chunk::CT_SEQUENCE)
            chunks = staticPtrCast<const SequenceChunk>(content)->getChunks();
        else
            chunks.push_back(content);
        for (const auto& chunk : chunks)
            std::cout << par("label").stdstringValue() << ":   " << chunk->getClassName() << " " << chunk->getChunkLength() << (chunk->isCorrect() ? " correct" : " incorrect") << std::endl;
        delete msg;
    }
};

Define_Module(TestSink);

} // namespace ContentErrors_Ieee80211Radio_1

%file: test.ned

import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.common.contract.packetlevel.IRadio;
import inet.physicallayer.wireless.common.contract.packetlevel.IRadioMedium;

simple TestSource
{
    @class(TestSource);
    double startTime @unit(s);
    int chunkLength @unit(B);
    gates:
        output out;
}

simple TestSink
{
    @class(TestSink);
    string label;
    gates:
        input in;
}

module SenderNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: <> like IRadio;
        source: TestSource;
    connections allowunconnected:
        source.out --> radio.upperLayerIn;
}

module ReceiverNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: <> like IRadio;
        sink: TestSink;
    connections allowunconnected:
        radio.upperLayerOut --> sink.in;
}

network Test
{
    submodules:
        radioMedium: <> like IRadioMedium;
        far: SenderNode;
        near: SenderNode;
        receiver: ReceiverNode;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 10ms
ned-path = .;../../../../src
cmdenv-express-mode = false

**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
*.far.mobility.initialX = 480m
*.near.mobility.initialX = 502m
*.receiver.mobility.initialX = 500m

# the variants of the runs
*.radioMedium.typename = ${medium="Ieee80211ScalarRadioMedium", "Ieee80211ScalarRadioMedium", "Ieee80211ScalarRadioMedium", "Ieee80211ScalarRadioMedium", "Ieee80211ScalarRadioMedium", "Ieee80211DimensionalRadioMedium", "Ieee80211ScalarRadioMedium", "Ieee80211ScalarRadioMedium", "Ieee80211ScalarRadioMedium" ! run}
**.radio.typename = ${radio="Ieee80211ScalarRadio", "Ieee80211ScalarRadio", "Ieee80211ScalarRadio", "Ieee80211ScalarRadio", "Ieee80211ScalarRadio", "Ieee80211DimensionalRadio", "Ieee80211ScalarRadio", "Ieee80211ScalarRadio", "Ieee80211ScalarRadio" ! run}
**.radio.opMode = ${opMode="g(mixed)", "n(mixed-2.4Ghz)", "b", "g(mixed)", "g(mixed)", "g(mixed)", "g(mixed)", "g(mixed)", "g(mixed)" ! run}
**.radio.transmitter.bitrate = ${bitrate=54Mbps, 65Mbps, 11Mbps, 54Mbps, 54Mbps, 54Mbps, 54Mbps, 54Mbps, 54Mbps ! run}
**.radio.receiver.errorModel.typename = ${model="Ieee80211NistErrorModel", "Ieee80211NistErrorModel", "Ieee80211NistErrorModel", "Ieee80211YansErrorModel", "Ieee80211BerTableErrorModel", "Ieee80211NistErrorModel", "Ieee80211NistErrorModel", "Ieee80211NistErrorModel", "Ieee80211NistErrorModel" ! run}
**.radio.receiver.errorModel.corruptionMode = ${mode="chunk", "chunk", "chunk", "chunk", "chunk", "chunk", "packet", "byte", "bit" ! run}
*.near.source.startTime = ${interference=185us, 190us, 1000us, 185us, 185us, 185us, 185us, 185us, 185us ! run}
**.radio.receiver.errorModel.berTableFile = "../../../statistical/files/per_table_80211g_Trivellato.dat"
**.radio.receiver.errorModel.opMode = "g(mixed)"
*.receiver.sink.label = "run ${run=0..8}"

*.radioMedium.backgroundNoise.power = -110dBm
**.radio.antenna.mobilityModule = "^.^.mobility"
**.radio.bandName = "2.4 GHz"
**.radio.channelNumber = 0
**.radio.transmitter.power = 100mW
*.far.radio.initialRadioMode = "transmitter"
*.near.radio.initialRadioMode = "transmitter"
*.receiver.radio.initialRadioMode = "receiver"
*.far.source.startTime = 0s
**.source.chunkLength = 500B

%extraargs: -r 0..8

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
