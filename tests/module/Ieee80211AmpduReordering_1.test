%description:
Real radios send HT aggregates through the production MAC, Rx, HCF, and recipient data service.
Twenty-two scenarios check partial reception, all-member failure, absent agreements, duplicates, delimiter gaps, invalid FCS, and overheard DATA.
Physical SIFS intervals exercise aggregate and individual history for release conditions (i) through (v).
Negative history cases use a long interval, a failed delimiter tail, or an absent prior receipt.
The fixture supplies peer HT capabilities and accepted agreements. It does not test ADDBA negotiation.
A response probe suppresses Block Ack transmission in the first seventeen scenarios.
Three additional scenarios use actual Block Ack transmission and physical SIFS intervals to check retained or cleared aggregate history.
Two negative RIFS scenarios send standalone HT DATA with Block Ack policy before an aggregate or another standalone frame.
A 2 us gap after the 6 us signal extension does not meet the production RIFS condition.
HCF adds the preceding signal extension to the measured gap before it compares that sum with the RIFS duration.
Both scenarios keep the frame after the missing sequence number in the recipient buffer.
Scalar and dimensional radios use long and short GI, whole and separate reception parts, and seed zero.

%extraargs: -r 0..175
%postrun-command: python3 check-reordering.py

%file: AmpduReordering.cc
#include <iostream>
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/Simsignals.h"
#include "inet/common/checksum/Checksum.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/Rx.h"
#include "inet/linklayer/ieee80211/mac/Tx.h"
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/contract/IContention.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mib/Ieee80211Mib.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Radio.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmitter.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/errormodel/Ieee80211NistErrorModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ISnir.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IReception.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

class ReorderPhysicalModel : public Ieee80211NistErrorModel
{
    mutable std::map<int, int> delimiterCalls;
  public:
    double computePacketErrorRate(const ISnir *, IRadioSignal::SignalPart) const override { return 0; }
    double computeAmpduRangeSuccessRate(const ISnir *snir, const IIeee80211Mode *, B length) const override {
        auto transmission = snir->getReception()->getTransmission();
        auto packet = transmission->getPacket();
        if (length == B(4)) {
            int index = delimiterCalls[transmission->getId()]++;
            return (packet->isName("delimiter-gap") || packet->isName("delimiter-tail")) && index == 1 ? 0 : 1;
        }
        return packet->isName("all-failed") || (packet->isName("partial") && length == B(101)) ? 0 : 1;
    }
};
Define_Module(ReorderPhysicalModel);

class ReorderAcceptedAgreements : public RecipientBlockAckAgreementHandler
{
  public:
    void accept(MacAddress peer, int start) {
        auto agreement = new RecipientBlockAckAgreement(peer, 5, SequenceNumberCyclic(start), 2, SIMTIME_ZERO);
        agreement->setVariant(BlockAckVariant::COMPRESSED);
        agreement->addbaResposneSent();
        agreement->calculateExpirationTime();
        blockAckAgreements[{peer, 5}] = agreement;
    }
};

class ReorderPhysicalHcf : public Hcf
{
  public:
    std::vector<int> delivered;
    int aggregateCalls = 0;
    int acceptedMembers = 0;
    int normalResponses = 0;
    int blockResponses = 0;
    int corruptions = 0;
    int delbas = 0;
    bool actualResponses = false;
    MacAddress address() const { return mac->getAddress(); }
    RecipientBlockAckAgreement *agreement() { return recipientBlockAckAgreementHandler->getAgreement(5, MacAddress("02:00:00:00:00:02")); }
    void seed(int scenario) {
        Enter_Method("seed");
        actualResponses = scenario >= 17 && scenario < 20;
        auto radio = check_and_cast<IRadio *>(mac->gate("lowerLayerOut")->getNextGate()->getOwnerModule());
        auto transmitter = check_and_cast<const Ieee80211Transmitter *>(radio->getTransmitter());
        auto channel = transmitter->getChannel();
        mib->setPrimaryChannel(channel->getChannelNumber(), channel->getBand());
        mib->setPeerHtCapabilities(MacAddress("02:00:00:00:00:02"), mib->localHtCapabilities, mib->getHtOperation());
        delete recipientBlockAckAgreementHandler;
        auto accepted = new ReorderAcceptedAgreements();
        recipientBlockAckAgreementHandler = accepted;
        if (scenario != 3)
            accepted->accept(MacAddress("02:00:00:00:00:02"), actualResponses ? 0 : (scenario == 14 ? 4095 : (scenario == 16 ? 4094 : 100)));
    }
    void processLowerAggregate(Packet *packet, AmpduReception reception) override {
        aggregateCalls++;
        acceptedMembers += reception.members.size();
        Hcf::processLowerAggregate(packet, std::move(reception));
    }
    void corruptedFrameReceived() override {
        corruptions++;
        Hcf::corruptedFrameReceived();
    }
  protected:
    void sendUp(const std::vector<Packet *>& frames) override {
        for (auto frame : frames) {
            delivered.push_back(frame->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().get());
            take(frame);
            delete frame;
        }
    }
    void transmitControlResponseFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header,
            Packet *, const Ptr<const Ieee80211MacHeader>&) override {
        if (header->getType() == ST_ACK) normalResponses++;
        if (dynamicPtrCast<const Ieee80211BlockAck>(header)) blockResponses++;
        delete packet;
    }
    void processMgmtFrame(Packet *packet, const Ptr<const Ieee80211MgmtHeader>& header) override {
        if (dynamicPtrCast<const Ieee80211Delba>(header)) delbas++;
        Hcf::processMgmtFrame(packet, header);
    }
};
Define_Module(ReorderPhysicalHcf);

class ReorderResponseTx : public Tx
{
  public:
    void transmitFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header,
            simtime_t ifs, bool updateLocalNav, ITx::ICallback *callback) override {
        auto hcf = check_and_cast<ReorderPhysicalHcf *>(getModuleByPath("^.hcf"));
        if (!hcf->actualResponses && dynamicPtrCast<const Ieee80211BlockAck>(header)) {
            hcf->blockResponses++;
            return;
        }
        Tx::transmitFrame(packet, header, ifs, updateLocalNav, callback);
    }
};
Define_Module(ReorderResponseTx);

class ReorderContentionProbe : public IContention
{
  public:
    int corruptions = 0;
    void startContention(int, simtime_t, simtime_t, simtime_t, ICallback *) override { ASSERT(false); }
    bool isContentionInProgress() override { return false; }
    void mediumStateChanged(bool) override {}
    void corruptedFrameReceived() override { corruptions++; }
};

class ReorderPhysicalDriver : public cSimpleModule, public cListener, public ITx::ICallback
{
    ReorderPhysicalHcf *hcf = nullptr;
    ReorderContentionProbe contention;
    int sent = 0;
    int actualBlockAckTransmissions = 0;
    int unrelatedTransmissions = 0;
    int unrelatedCompletions = 0;
    simtime_t expectedSecondStart;
    const IIeee80211Mode *mode = nullptr;
    int scenario() const { return par("scenario"); }
    bool actualResponses() const { return scenario() >= 17 && scenario() < 20; }
    bool rifsScenario() const { return scenario() >= 20; }
    bool twoTransmissions() const { return scenario() == 5 || (scenario() >= 8 && scenario() <= 13) || scenario() >= 17; }
    bool individual(bool second) const {
        return second ? scenario() == 9 || scenario() == 11 || scenario() == 18 || scenario() == 21 :
                scenario() == 10 || scenario() == 11 || rifsScenario();
    }
    Packet *member(int sequence, int length, bool standalone) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->addChunkLength(QOSCONTROL_PART_LENGTH);
        header->setReceiverAddress(scenario() == 7 ? MacAddress("02:00:00:00:00:09") : hcf->address());
        header->setTransmitterAddress(MacAddress("02:00:00:00:00:02"));
        header->setAddress3(MacAddress("02:00:00:00:00:02"));
        header->setTid(5);
        header->setAckPolicy(standalone ? BLOCK_ACK : NORMAL_ACK);
        header->setSequenceNumber(SequenceNumberCyclic(sequence));
        header->setDurationField(SIMTIME_ZERO);
        auto frame = new Packet("member", header);
        frame->insertAtBack(makeShared<ByteCountChunk>(B(length) - header->getChunkLength() - B(4)));
        auto trailer = makeShared<Ieee80211MacTrailer>();
        auto bytes = frame->peekAllAsBytes()->getBytes();
        auto fcs = ethernetFcs(bytes.data(), bytes.size());
        trailer->setFcsMode(FCS_COMPUTED);
        trailer->setFcs(scenario() == 6 && length == 101 ? fcs ^ 1 : fcs);
        frame->insertAtBack(trailer);
        return frame;
    }
    void transmit() {
        bool second = sent != 0;
        std::vector<int> sequences;
        if (actualResponses())
            sequences = {second ? 2 : 0};
        else if ((scenario() >= 8 && scenario() <= 13) || rifsScenario())
            sequences = {second ? 102 : 100};
        else if (scenario() == 14)
            sequences = {4095, 1};
        else if (scenario() == 16)
            sequences = {4094, 0};
        else if (scenario() == 15)
            sequences = {102};
        else
            sequences = {100, 101, 102};
        const char *name = scenario() == 1 ? "partial" : scenario() == 2 ? "all-failed" : scenario() == 4 ? "delimiter-gap" :
                scenario() == 13 && !second ? "delimiter-tail" : "aggregate";
        Packet *packet = nullptr;
        if (individual(second))
            packet = member(sequences.front(), 100, true);
        else {
            packet = new Packet(name);
            for (size_t i = 0; i < sequences.size(); i++) {
                int length = 100 + i;
                auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
                delimiter->setLength(length);
                packet->insertAtBack(delimiter);
                auto frame = member(sequences[i], length, false);
                packet->insertAtBack(frame->peekData());
                delete frame;
                if (i + 1 < sequences.size() && length % 4)
                    packet->insertAtBack(makeShared<ByteCountChunk>(B(4 - length % 4)));
            }
            if (scenario() == 13 && !second) {
                auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
                delimiter->setLength(0);
                packet->insertAtBack(delimiter);
            }
        }
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
        packet->addTag<Ieee80211ModeReq>()->setMode(mode);
        sent++;
        send(packet, "out");
    }
    void transmitUnrelatedControl() {
        auto header = makeShared<Ieee80211CtsFrame>();
        header->setReceiverAddress(MacAddress("02:00:00:00:00:09"));
        header->setDurationField(SIMTIME_ZERO);
        auto packet = new Packet("unrelated-local-control", header);
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        packet->addTag<Ieee80211ModeReq>()->setMode(Ieee80211ModeSet::getModeSet("g(mixed)")->getMode(Mbps(6)));
        auto tx = check_and_cast<Tx *>(getModuleByPath("^.receiver.wlan[0].mac.tx"));
        ASSERT(!tx->hasTransmission());
        tx->transmitFrame(packet, header, false, this);
        delete packet;
    }
  public:
    void frameTransmissionStarted(Packet *) override {}
    void transmissionComplete(Packet *, const Ptr<const Ieee80211MacHeader>& header) override {
        ASSERT(header && header->getType() == ST_CTS);
        unrelatedCompletions++;
    }
  protected:
    void initialize() override {
        hcf = check_and_cast<ReorderPhysicalHcf *>(getModuleByPath("^.receiver.wlan[0].mac.hcf"));
        check_and_cast<Rx *>(getModuleByPath("^.receiver.wlan[0].mac.rx"))->registerContention(&contention);
        getModuleByPath("^.sender.radio")->subscribe(transmissionStartedSignal, this);
        getModuleByPath("^.receiver.wlan[0].radio")->subscribe(transmissionEndedSignal, this);
        auto modes = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
        for (int i = 0; i < modes->getNumModes(); i++) {
            auto candidate = modes->getMode(i);
            if (candidate->getHtMcsIndex() == 0 && candidate->getDataMode()->getBandwidth() == MHz(20) &&
                    candidate->isHtShortGuardInterval() == par("shortGi").boolValue())
                mode = candidate;
        }
        ASSERT(mode);
        scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("first"));
    }
    void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *) override {
        Enter_Method_Silent();
        auto transmission = check_and_cast<const Ieee80211Transmission *>(object);
        if (signal == transmissionEndedSignal) {
            if (!actualResponses()) return;
            auto packet = transmission->getPacket();
            auto phy = Ieee80211Radio::peekIeee80211PhyHeaderAtFront(packet);
            auto header = packet->peekDataAt<Ieee80211MacHeader>(phy->getChunkLength());
            if (dynamicPtrCast<const Ieee80211CompressedBlockAck>(header)) {
                actualBlockAckTransmissions++;
                if (sent == 1) {
                    expectedSecondStart = transmission->getEndTime() + mode->getSifsTime();
                    scheduleAt(expectedSecondStart, new cMessage(scenario() == 19 ? "unrelated" : "second"));
                }
            }
            else if (header->getType() == ST_CTS) {
                ASSERT(scenario() == 19 && sent == 1);
                unrelatedTransmissions++;
                expectedSecondStart = transmission->getEndTime() + mode->getSifsTime();
                scheduleAt(expectedSecondStart, new cMessage("second"));
            }
            return;
        }
        if (actualResponses()) {
            if (sent == 2) ASSERT(transmission->getStartTime() == expectedSecondStart);
            return;
        }
        if (sent == 1 && twoTransmissions()) {
            auto interval = scenario() == 5 || scenario() == 12 ? SimTime(1, SIMTIME_MS) : mode->getSifsTime();
            if (rifsScenario()) {
                ASSERT(mode->getRifsTime() == SimTime(2, SIMTIME_US));
                ASSERT(transmission->getSignalExtensionDuration() == SimTime(6, SIMTIME_US));
                interval = mode->getRifsTime();
            }
            expectedSecondStart = transmission->getEndTime() + interval;
            scheduleAt(expectedSecondStart, new cMessage("second"));
        }
        if (rifsScenario() && sent == 2) ASSERT(transmission->getStartTime() == expectedSecondStart);
    }
    void handleMessage(cMessage *message) override {
        if (message->isName("unrelated")) {
            delete message;
            transmitUnrelatedControl();
            return;
        }
        if (message->isName("first")) hcf->seed(scenario());
        delete message;
        transmit();
    }
    using cListener::finish;
    void finish() override {
        std::vector<int> expected;
        if (scenario() == 0 || scenario() == 5) expected = {100, 101, 102};
        else if (scenario() == 1 || scenario() == 6 || (scenario() >= 8 && scenario() <= 11)) expected = {100, 102};
        else if (scenario() == 4 || scenario() == 12 || scenario() == 13) expected = {100};
        else if (scenario() == 14) expected = {4095, 1};
        else if (scenario() == 16) expected = {4094, 0};
        else if (scenario() == 17 || scenario() == 18) expected = {0, 2};
        else if (scenario() == 19) expected = {0};
        else if (rifsScenario()) expected = {100};
        ASSERT(hcf->delivered == expected);
        ASSERT(sent == (twoTransmissions() ? 2 : 1));
        ASSERT(hcf->normalResponses == 0 && hcf->delbas == 0);
        ASSERT(contention.corruptions == (scenario() == 2 ? 1 : 0));
        ASSERT(hcf->corruptions == (scenario() == 2 ? 1 : 0));
        if (actualResponses()) {
            ASSERT(actualBlockAckTransmissions == (scenario() == 18 ? 1 : 2));
            ASSERT(unrelatedTransmissions == (scenario() == 19 ? 1 : 0));
            ASSERT(unrelatedCompletions == unrelatedTransmissions);
        }
        if (scenario() == 3) {
            ASSERT(!hcf->agreement());
            ASSERT(hcf->blockResponses == 0);
        }
        else {
            auto record = hcf->agreement()->getBlockAckRecord();
            if (rifsScenario()) {
                ASSERT(record->hasCompleteReceipt(SequenceNumberCyclic(100)));
                ASSERT(record->hasCompleteReceipt(SequenceNumberCyclic(102)));
                ASSERT(hcf->aggregateCalls == (individual(true) ? 0 : 1));
            }
            if (scenario() == 2 || scenario() == 7) {
                ASSERT(!record->hasCompleteReceipt(SequenceNumberCyclic(100)));
                ASSERT(!record->hasCompleteReceipt(SequenceNumberCyclic(101)));
                ASSERT(!record->hasCompleteReceipt(SequenceNumberCyclic(102)));
                ASSERT(hcf->blockResponses == 0);
            }
            if (scenario() == 1 || scenario() == 4 || scenario() == 6) {
                ASSERT(record->hasCompleteReceipt(SequenceNumberCyclic(100)));
                ASSERT(!record->hasCompleteReceipt(SequenceNumberCyclic(101)));
                ASSERT(record->hasCompleteReceipt(SequenceNumberCyclic(102)));
            }
        }
        std::cout << "Physical aggregate reordering passed: scenario=" << scenario() << " delivered=";
        for (int sequence : hcf->delivered) std::cout << sequence << ",";
        std::cout << "\n";
    }
};
Define_Module(ReorderPhysicalDriver);

%file: test.ned
import inet.mobility.static.StationaryMobility;
import inet.node.inet.AdhocHost;
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.linklayer.ieee80211.mac.Tx;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211Radio;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211RadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.errormodel.Ieee80211NistErrorModel;
module ReorderPhysicalModel extends Ieee80211NistErrorModel { parameters: @class(::ReorderPhysicalModel); }
module ReorderPhysicalHcf extends Hcf { parameters: @class(::ReorderPhysicalHcf); }
module ReorderResponseTx extends Tx { parameters: @class(::ReorderResponseTx); }
simple ReorderPhysicalDriver { parameters: int scenario; bool shortGi; @class(::ReorderPhysicalDriver); gates: output out; }
module ReorderPhysicalSender {
    parameters: @networkNode;
    gates: input in; input radioIn @directIn;
    submodules:
        mobility: StationaryMobility;
        radio: Ieee80211Radio;
    connections allowunconnected:
        in --> radio.upperLayerIn;
        radioIn --> radio.radioIn;
}
network Test {
    submodules:
        radioMedium: Ieee80211RadioMedium;
        driver: ReorderPhysicalDriver;
        sender: ReorderPhysicalSender;
        receiver: AdhocHost;
    connections:
        driver.out --> sender.in;
}

%inifile: omnetpp.ini
[General]
network = Test
ned-path = .;../../../../src
sim-time-limit = 7ms
seed-set = 0
cmdenv-express-mode = false
record-vector-results = false
record-scalar-results = false
*.driver.scenario = ${scenario=0..21}
*.driver.shortGi = ${shortGi=false,true}
*.receiver.wlan[0].opMode = "n(mixed-2.4Ghz)"
*.receiver.wlan[0].mac.qosStation = true
*.receiver.wlan[0].mac.hcf.typename = "ReorderPhysicalHcf"
*.receiver.wlan[0].mac.hcf.isBlockAckSupported = true
*.receiver.wlan[0].mac.tx.typename = "ReorderResponseTx"
*.receiver.wlan[0].mac.hcf.originatorMacDataService.msduAggregationPolicy.typename = ""
*.receiver.wlan[0].radio.receiver.errorModel.typename = "ReorderPhysicalModel"
*.receiver.wlan[0].radio.separateReceptionParts = ${parts=false,true}
*.sender.radio.separateReceptionParts = ${parts}
*.sender.radio.opMode = "n(mixed-2.4Ghz)"
*.sender.radio.initialRadioMode = "transmitter"
*.sender.radio.antenna.mobilityModule = "^.^.mobility"
*.radioMedium.signalAnalogRepresentation = ${analog="scalar","dimensional"}
**.radio.signalAnalogRepresentation = ${analog}
**.radio.receiver.bandwidth = 20MHz
*.radioMedium.backgroundNoise.power = -110dBm
*.radioMedium.propagation.typename = "ConstantTimePropagation"
*.radioMedium.propagation.propagationTime = 0s
**.mobility.initFromDisplayString = false
**.mobility.initialX = 10m
**.mobility.initialY = 10m
**.mobility.initialZ = 0m
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 0m

%contains: stdout
Physical aggregate reordering passed:

%file: check-reordering.py
from collections import Counter
from pathlib import Path
import re

text = Path("test.out").read_text()
errors = Path("test.err").read_text()
assert "Warning:" not in text + errors
assert "Error:" not in text + errors
assert re.findall(r"Run statistics: total (\d+), successful (\d+)([^\n]*)", text) == [("176", "176", "")]
scenarios = re.findall(r"^Physical aggregate reordering passed: scenario=(\d+) delivered=", text, re.MULTILINE)
assert Counter(map(int, scenarios)) == Counter({scenario: 8 for scenario in range(22)})
print("All 176 physical reordering cases passed without warnings or errors.")

%contains: stdout
Run statistics: total 176, successful 176
