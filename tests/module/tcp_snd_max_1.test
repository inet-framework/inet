%description:
Tests that the sndMax signal follows each change of snd_max. The client sends
1000 bytes at t=1 and closes at t=1.5. Its SYN, its data and its FIN each
advance snd_max by their length, and the SYN-ACK of the server advances the
snd_max of the server. Before the repair, the FIN of a CLOSE and the SYN-ACK
changed snd_max without the signal.

%file: SndMaxProbe.cc
#include "inet/common/INETDefs.h"

namespace inet {

// Prints each value of the sndMax signal of a TCP connection, with the time and
// the TCP module of the connection.
class SndMaxProbe : public cSimpleModule, public cListener
{
  protected:
    virtual void initialize() override
    {
        getSimulation()->getSystemModule()->subscribe("sndMax", this);
    }

    void print(cComponent *source, uint64_t value)
    {
        std::cout << "sndMax " << simTime() << " " << source->getParentModule()->getName() << " " << value << endl;
    }

    virtual void receiveSignal(cComponent *source, simsignal_t signalID, intval_t value, cObject *details) override { print(source, value); }
    virtual void receiveSignal(cComponent *source, simsignal_t signalID, uintval_t value, cObject *details) override { print(source, value); }
};

Define_Module(SndMaxProbe);

} // namespace inet

%file: test.ned
import inet.test.moduletest.lib.TcpTestNet1;

simple SndMaxProbe
{
    @class(::inet::SndMaxProbe);
}

network SndMaxNet extends TcpTestNet1
{
    submodules:
        probe: SndMaxProbe;
}

%inifile: omnetpp.ini
[General]
network = SndMaxNet
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000"
*.cli_app.tClose=1.5s

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "^sndMax" test.out > sndmax.out || true
%contains: sndmax.out
sndMax 0 cli_tcp 1
sndMax 0.002 srv_tcp 501
sndMax 1 cli_tcp 1001
sndMax 1.5 cli_tcp 1002
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
