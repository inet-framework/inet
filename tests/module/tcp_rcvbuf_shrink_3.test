%description:
Tests that a duplicate segment does not take receive buffer space
(windowShrinkAllowed). The scenario is that of tcp_rcvbuf_shrink_1 with an
initial window of four segments. The tester drops the first segment and
delivers the second twice, the second copy 1 ms later. The second copy
arrives out of order and adds no data, so it costs no truesize: its ACK
offers the same window as the ACK before it (5757), and after the
retransmission the windows are those of the run without the copy (4760,
3762).

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 4s
*.cli_app.sendScript="1.0 8000"
*.cli_tcp.initialWindow = "rfc3390" # four segments at once
*.tcptester.script="A3 delete; A4 copy 0,0.001"
*.*_tcp.mss = 1000
*.*_tcp.delayedAcksEnabled = false
*.srv_tcp.receiveBufferSize = 20000B
*.srv_tcp.windowShrinkAllowed = true
*.srv_app.autoRead=false
*.srv_app.readScript="3 20000"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.003 B004] A.1000 < B.2000: A ack 1 win 5757 
[1.004 B005] A.1000 < B.2000: A ack 1 win 5757 
[1.005 A007] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 
[1.005 A008] A.1000 > B.2000: A 4001:5001(1000) ack 501 win 16384 
[1.007 B006] A.1000 < B.2000: A ack 4001 win 4760 
[1.007 B007] A.1000 < B.2000: A ack 5001 win 3762 
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
