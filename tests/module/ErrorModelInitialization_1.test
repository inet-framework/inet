%description:
The stochastic and BER table error models in IEEE 802.11 reception, without a
MAC. The far sender gives its radio a PSDU of three 500-byte chunks. In the
runs with interference, the near sender, close to the receiver, starts to
transmit during the PSDU. The error model must initialize its base, so that its
corruption mode and its SNIR mode are known, and the BER table model must find
the length of the PSDU in the PHY header, because a packet-level IEEE 802.11
transmission has no bit model.

Run 0: StochasticErrorModel with the packet error rate 1: the packet has a
packet-level bit error.
Run 1: Ieee80211BerTableErrorModel without interference: the packet has no
bit error.
Run 2: Ieee80211BerTableErrorModel with interference: the packet has a
packet-level bit error.

%file: test.cc
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"

namespace ErrorModelInitialization_1 {

using namespace inet;

// Hands one PSDU of chunks with different fill bytes to the radio at the given time.
class TestSource : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(par("startTime"), new cMessage("start")); }
    virtual void handleMessage(cMessage *msg) override
    {
        auto packet = new Packet(getParentModule()->getName());
        for (int i = 0; i < 3; i++)
            packet->insertAtBack(makeShared<ByteCountChunk>(B(par("chunkLength").intValue()), i + 1));
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211Mac);
        send(packet, "out");
        delete msg;
    }
};

Define_Module(TestSource);

// Prints the packet-level flag of a received packet.
class TestSink : public cSimpleModule
{
  protected:
    virtual void handleMessage(cMessage *msg) override
    {
        auto packet = check_and_cast<Packet *>(msg);
        std::cout << par("label").stdstringValue() << ": received " << packet->getName() << (packet->cPacket::hasBitError() ? " with" : " without") << " a packet-level bit error" << std::endl;
        delete msg;
    }
};

Define_Module(TestSink);

} // namespace ErrorModelInitialization_1

%file: test.ned

import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.common.contract.packetlevel.IRadio;
import inet.physicallayer.wireless.common.contract.packetlevel.IRadioMedium;

simple TestSource
{
    @class(TestSource);
    double startTime @unit(s);
    int chunkLength @unit(B);
    gates:
        output out;
}

simple TestSink
{
    @class(TestSink);
    string label;
    gates:
        input in;
}

module SenderNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: <> like IRadio;
        source: TestSource;
    connections allowunconnected:
        source.out --> radio.upperLayerIn;
}

module ReceiverNode
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        radio: <> like IRadio;
        sink: TestSink;
    connections allowunconnected:
        radio.upperLayerOut --> sink.in;
}

network Test
{
    submodules:
        radioMedium: <> like IRadioMedium;
        far: SenderNode;
        near: SenderNode;
        receiver: ReceiverNode;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Test
sim-time-limit = 10ms
ned-path = .;../../../../src
cmdenv-express-mode = false

**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 1000m
**.mobility.constraintAreaMaxY = 1000m
**.mobility.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 500m
**.mobility.initialZ = 0m
*.far.mobility.initialX = 480m
*.near.mobility.initialX = 502m
*.receiver.mobility.initialX = 500m

# the variants of the runs
*.radioMedium.typename = "Ieee80211ScalarRadioMedium"
**.radio.typename = "Ieee80211ScalarRadio"
**.radio.opMode = "g(mixed)"
**.radio.transmitter.bitrate = 54Mbps
**.radio.receiver.errorModel.typename = ${model="StochasticErrorModel", "Ieee80211BerTableErrorModel", "Ieee80211BerTableErrorModel" ! run}
*.near.source.startTime = ${interference=185us, 1s, 185us ! run}
**.radio.receiver.errorModel.packetErrorRate = 1
**.radio.receiver.errorModel.bitErrorRate = 1
**.radio.receiver.errorModel.berTableFile = "../../../statistical/files/per_table_80211g_Trivellato.dat"
**.radio.receiver.errorModel.opMode = "g(mixed)"
*.receiver.sink.label = "run ${run=0..2}"

*.radioMedium.backgroundNoise.power = -110dBm
**.radio.antenna.mobilityModule = "^.^.mobility"
**.radio.bandName = "2.4 GHz"
**.radio.channelNumber = 0
**.radio.transmitter.power = 100mW
*.far.radio.initialRadioMode = "transmitter"
*.near.radio.initialRadioMode = "transmitter"
*.receiver.radio.initialRadioMode = "receiver"
*.far.source.startTime = 0s
**.source.chunkLength = 500B

%extraargs: -r 0..2

%#--------------------------------------------------------------------------------------------------------------
%# remove colorizing
%subst: /\x1B\[[0-9;]*m//
%#--------------------------------------------------------------------------------------------------------------
%contains: stdout
run 0: received far with a packet-level bit error
%contains: stdout
run 1: received far without a packet-level bit error
%contains: stdout
run 2: received far with a packet-level bit error
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
