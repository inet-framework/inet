%description:
Tests the zero-window probe of RFC 9293 section 3.8.6.1. The server offers 2000
bytes and reads nothing until t=20, so its window is zero after two segments.
Each probe of the client is the first unacknowledged octet, 2001: new data the
first time, and the same octet again later. The probes start no retransmission
timer, and their ACKs are no duplicate ACKs. The first probe comes one RTO
(1 s) after the window closed, and each probe doubles the interval (RFC 9293
SHLD-29, SHLD-30): 1, 2, 4, 8, 16 s.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

sim-time-limit = 40s
*.cli_app.sendScript="1.0 5000"
*.*_tcp.mss = 1000
*.srv_tcp.advertisedWindow = 2000
*.srv_app.autoRead=false
*.srv_app.readScript="20 10000"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[2.409 A005] A.1000 > B.2000: A 2001:2002(1) ack 501 win 16384 
[2.411 B004] A.1000 < B.2000: A ack 2001 win 0 
[4.409 A006] A.1000 > B.2000: A 2001:2002(1) ack 501 win 16384 
[4.411 B005] A.1000 < B.2000: A ack 2001 win 0 
[8.409 A007] A.1000 > B.2000: A 2001:2002(1) ack 501 win 16384 
[8.411 B006] A.1000 < B.2000: A ack 2001 win 0 
[16.409 A008] A.1000 > B.2000: A 2001:2002(1) ack 501 win 16384 
[16.411 B007] A.1000 < B.2000: A ack 2001 win 0 
[32.409 A009] A.1000 > B.2000: A 2001:2002(1) ack 501 win 16384 
[32.411 B008] A.1000 < B.2000: A ack 2001 win 2000 
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
Performing retransmission
%#--------------------------------------------------------------------------------------------------------------
%not-contains: stdout
Duplicate ACK
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
