%description:

Tests that the protocol modules of a node act only on interfaces of the
node's own interface table, not on those of another interface table nested
inside the node.

At 1 s, ScenarioManager creates two interfaces in a router: router.extra in
the router's own interface table, and router.nested.eth in the interface table
of a submodule. The router has IPv4 with IGMPv2, and IPv6. At 2 s, a checker
prints which protocol data each interface has: router.extra must be
configured for IPv4 (with the all-hosts and all-routers multicast groups),
router.nested.eth must have no IPv4 and no IPv6 data. (IPv6 does not
configure interfaces created during the run, not even router.extra, so the
IPv6 part only checks that nothing is added.)

%file: test.cc

#include "inet/networklayer/contract/IInterfaceTable.h"
#include "inet/networklayer/ipv4/Ipv4InterfaceData.h"
#include "inet/networklayer/ipv6/Ipv6InterfaceData.h"

using namespace inet;

namespace InterfaceTable_nested_table_1 {

class InterfaceChecker : public cSimpleModule
{
  protected:
    virtual void initialize() override { scheduleAt(par("checkTime"), new cMessage("check")); }
    virtual void handleMessage(cMessage *msg) override;
    void check(const char *interfaceTablePath, const char *interfaceName);
};

Define_Module(InterfaceChecker);

void InterfaceChecker::handleMessage(cMessage *msg)
{
    check("router.interfaceTable", "eth0");
    check("router.interfaceTable", "extra");
    check("router.nested.interfaceTable", "eth");
    delete msg;
}

void InterfaceChecker::check(const char *interfaceTablePath, const char *interfaceName)
{
    auto interfaceTable = check_and_cast<IInterfaceTable *>(getModuleByPath(interfaceTablePath));
    auto networkInterface = interfaceTable->findInterfaceByName(interfaceName);
    ASSERT(networkInterface != nullptr);
    auto ipv4Data = networkInterface->findProtocolData<Ipv4InterfaceData>();
    auto ipv6Data = networkInterface->findProtocolData<Ipv6InterfaceData>();
    std::cout << "CHECK " << interfaceTablePath << " " << interfaceName << ": ipv4=" << (ipv4Data ? "yes" : "no");
    if (ipv4Data) {
        std::cout << " groups=";
        for (int i = 0; i < ipv4Data->getNumOfJoinedMulticastGroups(); i++)
            std::cout << (i ? "," : "") << ipv4Data->getJoinedMulticastGroup(i);
    }
    std::cout << " ipv6=" << (ipv6Data ? "yes" : "no") << endl;
}

} // namespace InterfaceTable_nested_table_1

%file: test.ned

import inet.common.scenario.ScenarioManager;
import inet.networklayer.common.InterfaceTable;
import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.ethernet.Eth100M;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;

simple InterfaceChecker
{
    parameters:
        @class(InterfaceChecker);
        double checkTime @unit(s);
}

module NestedInterfaceTable
{
    submodules:
        interfaceTable: InterfaceTable;
}

module RouterWithNestedTable extends Router
{
    submodules:
        nested: NestedInterfaceTable;
}

network Test
{
    submodules:
        scenarioManager: ScenarioManager;
        configurator: Ipv4NetworkConfigurator;
        checker: InterfaceChecker;
        router: RouterWithNestedTable;
        host: StandardHost;
    connections:
        router.ethg++ <--> Eth100M <--> host.ethg++;
}

%inifile: omnetpp.ini

[General]
network = Test
ned-path = .;../../../../src;../../lib
sim-time-limit = 3s
cmdenv-express-mode = true
record-vector-results = false

*.*.eth[*].typename = "LayeredEthernetInterface"
*.*.eth[*].bitrate = 100Mbps
*.*.ethernet.typename = "EthernetLayer"
*.*.llc.typename = ""
*.router.hasIpv6 = true
*.host.hasIpv6 = true
**.igmp.typename = "Igmpv2"

*.router.extra.bitrate = 100Mbps
*.router.nested.eth.bitrate = 100Mbps
*.router.nested.eth.interfaceTableModule = "^.interfaceTable"
*.checker.checkTime = 2s
*.scenarioManager.script = xml("<scenario><at t='1s'>\
    <create-module type='inet.linklayer.ethernet.modular.LayeredEthernetInterface' parent='router' submodule='extra'/>\
    <create-module type='inet.linklayer.ethernet.modular.LayeredEthernetInterface' parent='router.nested' submodule='eth'/>\
  </at></scenario>")

%contains: stdout
CHECK router.interfaceTable eth0: ipv4=yes groups=224.0.0.1,224.0.0.2 ipv6=yes
%contains: stdout
CHECK router.interfaceTable extra: ipv4=yes groups=224.0.0.1,224.0.0.2 ipv6=
%contains: stdout
CHECK router.nested.interfaceTable eth: ipv4=no ipv6=no
