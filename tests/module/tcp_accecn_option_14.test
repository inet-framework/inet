%description:
Tests the counts of a duplicate segment with the default
accEcnOptionPolicy="rfc". RFC 9768 section 4: "only 'Acceptable' packets
contribute to the ECN counters", and a duplicate is not acceptable (RFC 9293
section 3.10.7.4). The tester removes the ACK B002 and marks the
retransmission A004 ECT(0); no count changes, so B003 has no AccECN option.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true
cmdenv-log-prefix="[%c]: "

*.cli_app.sendScript="1.0 1000"
*.*_tcp.tcpEcnMode = "accecn"
*.*_tcp.sackSupport = true
*.tcptester.script="b2 delete; a4 ect0"

include ../../lib/defaults.ini

%#--------------------------------------------------------------------------------------------------------------
%file: postrun.pl
open FILE, '<test.out';
while($sor = <FILE>)
{
    if ($sor =~ /^\[testing\]: (.*)$/)
    {
        print "$1\n";
    }
}
%#--------------------------------------------------------------------------------------------------------------
%postrun-command:  perl ./postrun.pl
%#--------------------------------------------------------------------------------------------------------------
%contains: postrun-command(1).out
[1.203 B002] A.1000 < B.2000: A E N ack 1001 win 16384   Option(s): NOP NOP NOP AccECN0(e0b=1001)# deleting
[4.001 A004] A.1000 > B.2000: A E N 1:1001(1000) ack 501 win 16384 ECT(0) # marking ECT(0)
[4.003 B003] A.1000 < B.2000: A E N ack 1001 win 16384   Option(s): NOP NOP SACK[1,1001)
%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
