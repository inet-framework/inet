%description:
The active side seeds its RTT estimator from the handshake
(seedRttFromHandshake, Linux tcp_ack_update_rtt() on the SYN-ACK). The SYN
and the SYN-ACK take 4 ms, so srtt is 4 ms, and the RTO is the minimum of 1 s
instead of the initial 3 s. The first data segment, sent at t=1, is lost, and
its retransmission leaves at t=2, not at t=4.

%inifile: omnetpp.ini
[General]
record-vector-results = false
ned-path = .;../../../../src;../../lib

cmdenv-event-banners=false
cmdenv-express-mode=false

*.testing=true

*.tcptester.cmdenv-log-level=DEBUG
**.cmdenv-log-level=OFF

*.cli_app.sendScript="1.0 1000"
*.tcptester.script="a3 delete"

*.*_tcp.seedRttFromHandshake = true

include ../../lib/defaults.ini

%contains: stdout
[1.001 A003] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384 # deleting
[2.001 A004] A.1000 > B.2000: A 1:1001(1000) ack 501 win 16384

%#--------------------------------------------------------------------------------------------------------------
%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
%#--------------------------------------------------------------------------------------------------------------
