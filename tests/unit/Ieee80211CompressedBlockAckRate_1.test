%description:
Check Compressed response rates through the production QoS rate selector.
Use independent MIB rate sets for two peers and both response directions.
Retain the Basic response contract and reject an invalid Compressed override.

%includes:
#include "inet/linklayer/ieee80211/mac/rateselection/QosRateSelection.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

namespace Ieee80211CompressedBlockAckRate_1 {
class CompressedRateSelection : public QosRateSelection {
  protected:
    void initialize(int stage) override {
        if (stage == INITSTAGE_LOCAL)
            mib.reference(this, "mibModule", true);
    }
  public:
    void configure(const Ieee80211ModeSet *catalog, const IIeee80211Mode *response) {
        modeSet = catalog;
        responseBlockAckFrameMode = response;
    }
    void controlOverride(const IIeee80211Mode *mode) { controlFrameMode = mode; }
};
Define_Module(CompressedRateSelection);

static Ieee80211RateSetState rates(std::initializer_list<int> basic) {
    Ieee80211RateSetState state;
    state.supported.known = state.operational.known = state.basic.known = true;
    for (int rate : {6, 9, 12, 18, 24, 36, 48, 54})
        state.supported.legacyRates.insert(Mbps(rate));
    state.operational = state.supported;
    for (int rate : basic)
        state.basic.legacyRates.insert(Mbps(rate));
    return state;
}
}

%file: TestNetwork.ned
import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mib.Ieee80211Mib;
simple CompressedRateSelection extends SimpleModule {
    parameters:
        @class(CompressedRateSelection);
        string mibModule;
}
network TestNetwork {
    submodules:
        test: Test;
        mib: Ieee80211Mib;
        selector: CompressedRateSelection { parameters: mibModule = "^.mib"; }
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
ned-path = .;../../../../src;../../lib
seed-set = 0
record-vector-results = false
record-scalar-results = false

%activity:
using namespace Ieee80211CompressedBlockAckRate_1;
auto mib = check_and_cast<Ieee80211Mib *>(getModuleByPath("mib"));
auto selector = check_and_cast<CompressedRateSelection *>(getModuleByPath("selector"));
const MacAddress a("02:00:00:00:00:01"), b("02:00:00:00:00:02");
for (const char *name : {"n(mixed-2.4Ghz)", "ac"}) {
    auto catalog = Ieee80211ModeSet::getModeSet(name);
    auto mode = [&](int rate) { return catalog->getMode(Mbps(rate)); };
    auto inputCatalog = Ieee80211ModeSet::getModeSet(name[0] == 'a' ? "a" : "g(mixed)");
    auto fastInput = inputCatalog->getMode(Mbps(54));
    mib->setLocalRateSet(rates({6, 12, 24}));
    mib->setBssRateSet(rates({6, 12, 24}));
    selector->configure(catalog, nullptr);
    auto bar = makeShared<Ieee80211CompressedBlockAckReq>();
    bar->setReceiverAddress(b);
    bar->setTransmitterAddress(a);
    auto check = [&](const IIeee80211Mode *input, int expected) {
        Packet predict("predict"), respond("respond");
        predict.addTag<Ieee80211ModeReq>()->setMode(input);
        respond.addTag<Ieee80211ModeInd>()->setMode(input);
        auto predicted = selector->computeResponseBlockAckFrameMode(&predict, bar, ResponseQueryRole::PREDICT);
        auto response = selector->computeResponseBlockAckFrameMode(&respond, bar, ResponseQueryRole::RESPOND);
        ASSERT(predicted == mode(expected));
        ASSERT(response == predicted);
        ASSERT(response->getHtMcsIndex() < 0);
        ASSERT(response->getDuration(B(32)) < response->getDuration(LENGTH_BASIC_BLOCKACK));
    };
    check(fastInput, 24);
    check(mode(6), 6);
    mib->setBssRateSet(rates({48}));
    check(mode(24), 24);
    mib->clearBssRateSet();
    check(fastInput, 24);
    mib->setBssRateSet(rates({}));
    check(fastInput, 24);
    mib->setBssRateSet(rates({6, 12, 24}));
    for (int i = 0; i < catalog->getNumModes(); i++) {
        auto ht = catalog->getMode(i);
        auto family = ht->getModulationClass();
        if (family != IIeee80211Mode::ModulationClass::HT && family != IIeee80211Mode::ModulationClass::VHT)
            continue;
        auto reference = ht->getNonHtReferenceRate();
        int expected = reference >= Mbps(24) ? 24 : reference >= Mbps(12) ? 12 : 6;
        check(ht, expected);
    }
    mib->setBssRateSet(rates({48}));
    selector->configure(catalog, mode(6));
    bool refused = false;
    try { check(fastInput, 6); }
    catch (const cRuntimeError&) { refused = true; }
    ASSERT(refused);
    selector->configure(catalog, nullptr);
    auto basic = makeShared<Ieee80211BasicBlockAckReq>();
    Packet packet("basic");
    packet.addTag<Ieee80211ModeInd>()->setMode(mode(24));
    ASSERT(selector->computeResponseBlockAckFrameMode(&packet, basic, ResponseQueryRole::RESPOND) == mode(24));
    auto bss = rates({6, 12, 24});
    auto peer = rates({6});
    peer.operational.legacyRates = {Mbps(6), Mbps(12)};
    mib->installBssAndPeerRateSets(bss, b, peer);
    Packet originated("originated");
    ASSERT(selector->computeCompressedBlockAckReqMode(&originated, bar, true) == mode(24));
    ASSERT(selector->computeCompressedBlockAckReqMode(&originated, bar, false) == mode(12));
    mib->removePeerRateSet(b);
    ASSERT(selector->computeCompressedBlockAckReqMode(&originated, bar, false) == mode(24));
    mib->setBssRateSet(rates({}));
    ASSERT(selector->computeCompressedBlockAckReqMode(&originated, bar, true) == mode(24));
    mib->clearBssRateSet();
    ASSERT(selector->computeCompressedBlockAckReqMode(&originated, bar, true) == mode(24));
    selector->controlOverride(mode(6));
    ASSERT(selector->computeCompressedBlockAckReqMode(&originated, bar, true) == mode(6));
    mib->setBssRateSet(rates({6}));
    selector->controlOverride(mode(24));
    refused = false;
    try { selector->computeCompressedBlockAckReqMode(&originated, bar, true); }
    catch (const cRuntimeError&) { refused = true; }
    ASSERT(refused);
    for (int i = 0; i < catalog->getNumModes(); i++) {
        auto ht = catalog->getMode(i);
        if (ht->getModulationClass() != IIeee80211Mode::ModulationClass::HT)
            continue;
        selector->controlOverride(ht);
        refused = false;
        try { selector->computeCompressedBlockAckReqMode(&originated, bar, true); }
        catch (const cRuntimeError&) { refused = true; }
        ASSERT(refused);
        break;
    }
    selector->controlOverride(nullptr);
}
// The full OFDM catalog supplies optional rates for the alternate-rate contract.
auto ofdm = Ieee80211ModeSet::getModeSet("a");
auto primary = ofdm->getMode(Mbps(48));
auto alternate = ofdm->getMode(Mbps(36));
ASSERT(primary->getDuration(B(32)) == alternate->getDuration(B(32)));
mib->setBssRateSet(rates({36, 48}));
selector->configure(ofdm, alternate);
Packet alternatePacket("alternate");
alternatePacket.addTag<Ieee80211ModeInd>()->setMode(ofdm->getMode(Mbps(54)));
auto alternateBar = makeShared<Ieee80211CompressedBlockAckReq>();
ASSERT(selector->computeResponseBlockAckFrameMode(&alternatePacket, alternateBar, ResponseQueryRole::RESPOND) == alternate);
EV << "Compressed response rate checks passed.\n";

%contains: stdout
Compressed response rate checks passed.
