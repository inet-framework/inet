%description:
All originator and recipient ACK policies must suppress ACK for Action No Ack,
while ordinary individually addressed management remains acknowledged.
IEEE 802.11-2024, 10.3.2.11.

%includes:
#include "inet/linklayer/ieee80211/mac/originator/OriginatorAckPolicy.h"
#include "inet/linklayer/ieee80211/mac/originator/OriginatorQosAckPolicy.h"
#include "inet/linklayer/ieee80211/mac/recipient/RecipientAckPolicy.h"
#include "inet/linklayer/ieee80211/mac/recipient/RecipientQosAckPolicy.h"
using namespace inet;
using namespace inet::ieee80211;

%activity:
OriginatorAckPolicy originator;
OriginatorQosAckPolicy qosOriginator;
RecipientAckPolicy recipient;
RecipientQosAckPolicy qosRecipient;
for (auto receiver : {MacAddress("02:00:00:00:00:01"), MacAddress::BROADCAST_ADDRESS}) {
    for (auto subtype : {ST_NOACKACTION, ST_ACTION, ST_AUTHENTICATION}) {
        auto header = makeShared<Ieee80211MgmtHeader>();
        header->setType(subtype);
        header->setReceiverAddress(receiver);
        bool expected = subtype != ST_NOACKACTION && !receiver.isMulticast();
        ASSERT(originator.isAckNeeded(header) == expected);
        ASSERT(qosOriginator.isAckNeeded(header) == expected);
        ASSERT(recipient.isAckNeeded(header) == expected);
        ASSERT(qosRecipient.isAckNeeded(header) == expected);
    }
}
EV << "All four ACK policies honor Action No Ack and preserve ordinary management ACKs.\n";

%contains: stdout
All four ACK policies honor Action No Ack and preserve ordinary management ACKs.
