%description:
Verify IEEE 802.11 rate selection boundaries and atomic MIB rate-state updates.

%includes:
#include <initializer_list>
#include <set>

#include "inet/common/Units.h"
#include "inet/linklayer/ieee80211/mac/rateselection/RateSelectionBase.h"
#include "inet/linklayer/ieee80211/mac/rateselection/QosRateSelection.h"
#include "inet/linklayer/ieee80211/mac/rateselection/RateSelection.h"
#include "inet/linklayer/ieee80211/mib/Ieee80211RateSet.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HrDsssMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

using namespace omnetpp;
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

namespace Ieee80211RateSelection_1 {

static Ieee80211RateSet makeLegacySet(bool known, std::initializer_list<bps> rates)
{
    Ieee80211RateSet result;
    result.known = known;
    result.legacyRates.insert(rates.begin(), rates.end());
    return result;
}

static Ieee80211RateSet makeHtSet(bool known, std::initializer_list<int> mcsIndexes)
{
    Ieee80211RateSet result;
    result.known = known;
    result.htMcs.insert(mcsIndexes.begin(), mcsIndexes.end());
    return result;
}

static Ieee80211RateSetState makeState(const Ieee80211RateSet& supported,
        const Ieee80211RateSet& basic, const Ieee80211RateSet& operational)
{
    Ieee80211RateSetState result;
    result.supported = supported;
    result.basic = basic;
    result.operational = operational;
    return result;
}

static Ieee80211RateSetState makeLegacyState(bool known, std::initializer_list<bps> supported,
        std::initializer_list<bps> basic, std::initializer_list<bps> operational)
{
    return makeState(makeLegacySet(known, supported), makeLegacySet(known, basic), makeLegacySet(known, operational));
}

static Ieee80211RateSetState makeUnknownState()
{
    return Ieee80211RateSetState();
}

static Ieee80211RateSetState makeHtState(std::initializer_list<int> supported,
        std::initializer_list<int> basic, std::initializer_list<int> operational)
{
    return makeState(makeHtSet(true, supported), makeHtSet(true, basic), makeHtSet(true, operational));
}

static const Ieee80211RateSetState makeAllGState()
{
    const auto allRates = {bps(Mbps(1)), bps(Mbps(2)), bps(Mbps(5.5)), bps(Mbps(6)), bps(Mbps(9)), bps(Mbps(11)),
            bps(Mbps(12)), bps(Mbps(18)), bps(Mbps(24)), bps(Mbps(36)), bps(Mbps(48)), bps(Mbps(54))};
    return makeLegacyState(true, allRates, {}, allRates);
}

class TestRateSelectionBase : public RateSelectionBase
{
  protected:
    virtual void initialize(int stage) override
    {
        if (stage == INITSTAGE_LOCAL) {
            mib.reference(this, "mibModule", true);
            modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet(par("modeSetName")));
            fastestMandatoryMode = modeSet->getFastestMandatoryMode();
        }
    }

  public:
    const IIeee80211Mode *allowedMode(const MacAddress& peerAddress, const IIeee80211Mode *mode,
            bool groupAddressed = false) const
    {
        return selectAllowedMode(peerAddress, mode, groupAddressed);
    }

    const IIeee80211Mode *basicMode(const IIeee80211Mode *upperBoundMode,
            const MacAddress& receiver, bool allowHtBasicMcs) const
    {
        return selectBasicMode(upperBoundMode, receiver, allowHtBasicMcs);
    }

    const IIeee80211Mode *groupMode(const IIeee80211Mode *configuredMode, const IIeee80211Mode *preferredMode = nullptr) const
    {
        return selectGroupMode(configuredMode, preferredMode);
    }

    const IIeee80211Mode *responseMode(const IIeee80211Mode *elicitingMode,
            Ieee80211ResponseFrameKind responseKind, const MacAddress& receiver) const
    {
        return computePrimaryResponseMode(elicitingMode, responseKind, receiver);
    }

    const IIeee80211Mode *configuredMode(const IIeee80211Mode *mode,
            const MacAddress& receiver, const char *frameClass) const
    {
        return validateConfiguredMode(mode, receiver, frameClass);
    }

};

Define_Module(TestRateSelectionBase);

class TestQosRateSelection : public QosRateSelection
{
  protected:
    virtual void initialize(int stage) override
    {
        if (stage == INITSTAGE_LOCAL) {
            mib.reference(this, "mibModule", true);
            modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("g(mixed)"));
            fastestMandatoryMode = modeSet->getFastestMandatoryMode();
            perReceiverResolved = true;
        }
    }
  public:
    void setFixedModes(const IIeee80211Mode *data, const IIeee80211Mode *group, const IIeee80211Mode *mgmt = nullptr)
    {
        dataFrameMode = data;
        multicastFrameMode = group;
        mgmtFrameMode = mgmt;
    }
    void setControlMode(const IIeee80211Mode *mode) { controlFrameMode = mode; }
};
Define_Module(TestQosRateSelection);

class TestRateSelection : public RateSelection
{
  protected:
    virtual void initialize(int stage) override
    {
        if (stage == INITSTAGE_LOCAL) {
            mib.reference(this, "mibModule", true);
            modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("g(mixed)"));
            fastestMandatoryMode = modeSet->getFastestMandatoryMode();
            perReceiverResolved = true;
        }
    }
  public:
    void setFixedModes(const IIeee80211Mode *data, const IIeee80211Mode *group, const IIeee80211Mode *mgmt = nullptr)
    {
        dataFrameMode = data;
        multicastFrameMode = group;
        mgmtFrameMode = mgmt;
    }
};
Define_Module(TestRateSelection);

class RateSetObserver : public cListener
{
  protected:
    Ieee80211Mib *mib;
    MacAddress peerAddress;
    Ieee80211RateSetState expectedBss;
    Ieee80211RateSetState expectedPeer;

  public:
    using cListener::finish;
    int bssEvents = 0;
    int peerEvents = 0;

    RateSetObserver(Ieee80211Mib *mib, const MacAddress& peerAddress,
            const Ieee80211RateSetState& expectedBss, const Ieee80211RateSetState& expectedPeer) :
        mib(mib), peerAddress(peerAddress), expectedBss(expectedBss), expectedPeer(expectedPeer) {}

    virtual void receiveSignal(cComponent *source, simsignal_t signalID, cObject *value, cObject *details) override
    {
        ASSERT(source == mib);
        auto change = check_and_cast<Ieee80211RateSetChangeDetails *>(value);
        ASSERT(change->getPeerAddress() == peerAddress);
        ASSERT(mib->getBssRateSet() == expectedBss);
        auto installedPeer = mib->findPeerRateSet(peerAddress);
        ASSERT(installedPeer != nullptr);
        ASSERT(*installedPeer == expectedPeer);
        if (signalID == Ieee80211Mib::bssRateSetChangedSignal) {
            ASSERT(change->getBssChange() != Ieee80211RateSetChangeDetails::Change::UNCHANGED);
            bssEvents++;
        }
        else if (signalID == Ieee80211Mib::peerRateSetChangedSignal) {
            ASSERT(change->getPeerChange() != Ieee80211RateSetChangeDetails::Change::UNCHANGED);
            peerEvents++;
        }
        else
            ASSERT(false);
    }
};

} // namespace Ieee80211RateSelection_1

%file: TestNetwork.ned

import inet.common.SimpleModule;
import inet.linklayer.ieee80211.mib.Ieee80211Mib;

simple TestRateSelectionBase extends SimpleModule
{
    parameters:
        @class(TestRateSelectionBase);
        string modeSetName;
        string mibModule;
}

network TestNetwork
{
    submodules:
        mib: Ieee80211Mib;
        qos: TestQosRateSelection;
        dcf: TestRateSelection;
        selection: TestRateSelectionBase {
            parameters:
                modeSetName = "g(mixed)";
                mibModule = "^.mib";
        }
        htSelection: TestRateSelectionBase {
            parameters:
                modeSetName = "n(mixed-2.4Ghz)";
                mibModule = "^.mib";
        }
        vhtSelection: TestRateSelectionBase {
            parameters:
                modeSetName = "ac";
                mibModule = "^.mib";
        }
        test: Test;
}

simple TestQosRateSelection extends SimpleModule
{
    parameters:
        @class(TestQosRateSelection);
        string mibModule = "^.mib";
}

simple TestRateSelection extends SimpleModule
{
    parameters:
        @class(TestRateSelection);
        string mibModule = "^.mib";
}

%inifile: omnetpp.ini

[General]
network = TestNetwork
ned-path = .;../../../../src;../../lib
record-vector-results = false
record-scalar-results = false

%activity:

using namespace Ieee80211RateSelection_1;

auto mib = check_and_cast<Ieee80211Mib *>(getModuleByPath("mib"));
auto selection = check_and_cast<TestRateSelectionBase *>(getModuleByPath("selection"));
auto htSelection = check_and_cast<TestRateSelectionBase *>(getModuleByPath("htSelection"));
auto vhtSelection = check_and_cast<TestRateSelectionBase *>(getModuleByPath("vhtSelection"));
auto qos = check_and_cast<TestQosRateSelection *>(getModuleByPath("qos"));
auto dcf = check_and_cast<TestRateSelection *>(getModuleByPath("dcf"));
const MacAddress peer("02:00:00:00:00:02");

const auto allG = makeAllGState();
const auto unknown = makeUnknownState();
const auto localAll = allG;
mib->setLocalRateSet(localAll);
mib->setBssRateSet(unknown);
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, unknown);

const auto *gModes = Ieee80211ModeSet::getModeSet("g(mixed)");
const auto *g6 = gModes->getMode(Mbps(6));
const auto *g9 = gModes->getMode(Mbps(9));
const auto *g12 = gModes->getMode(Mbps(12));
const auto *g24 = gModes->getMode(Mbps(24));
ASSERT(g6 != nullptr);
ASSERT(g9 != nullptr);
ASSERT(g12 != nullptr);
ASSERT(g24 != nullptr);

// Real QoS entry points distinguish initial BAR, later BAR, and bounded RTS.
mib->setBssRateSet(makeLegacyState(true, {Mbps(6), Mbps(12), Mbps(24), Mbps(54)},
        {Mbps(6), Mbps(12)}, {Mbps(6), Mbps(12), Mbps(24), Mbps(54)}));
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, makeLegacyState(true, {Mbps(6), Mbps(12), Mbps(24)}, {}, {Mbps(6)}));
auto barHeader = makeShared<Ieee80211BasicBlockAckReq>();
barHeader->setReceiverAddress(peer);
ASSERT(qos->computeMode(nullptr, barHeader, true, nullptr) == g12);
ASSERT(qos->computeMode(nullptr, barHeader, false, g6) == g24);
// Initial BARs must satisfy both the BSS basic set and the peer supported set.
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, makeLegacyState(true, {Mbps(6)}, {}, {Mbps(6)}));
ASSERT(qos->computeMode(nullptr, barHeader, true, nullptr) == g6);
ASSERT(qos->computeMode(nullptr, barHeader, false, g6) == g6);
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, makeLegacyState(true, {Mbps(24)}, {}, {Mbps(24)}));
bool noPeerBasicRateRejected = false;
try { qos->computeMode(nullptr, barHeader, true, nullptr); }
catch (const cRuntimeError&) { noPeerBasicRateRejected = true; }
ASSERT(noPeerBasicRateRejected);
ASSERT(qos->computeMode(nullptr, barHeader, false, g6) == g24);
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, makeLegacyState(true, {Mbps(6), Mbps(12), Mbps(24)}, {}, {Mbps(6)}));
auto rtsHeader = makeShared<Ieee80211RtsFrame>();
rtsHeader->setReceiverAddress(peer);
ASSERT(qos->computeMode(nullptr, rtsHeader, false, g6) == g6);
auto dataHeader = makeShared<Ieee80211DataHeader>();
dataHeader->setReceiverAddress(peer);
ASSERT(qos->computeMode(nullptr, dataHeader, true, nullptr, true) == g24);
qos->setFixedModes(g6, g12);
ASSERT(qos->computeMode(nullptr, dataHeader, true, nullptr, true) == g6);
dataHeader->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
ASSERT(qos->computeMode(nullptr, dataHeader, true, nullptr) == g12);
qos->setFixedModes(nullptr, g24);
bool invalidQosGroupRejected = false;
try { qos->computeMode(nullptr, dataHeader, true, nullptr); }
catch (const cRuntimeError&) { invalidQosGroupRejected = true; }
ASSERT(invalidQosGroupRejected);
qos->setFixedModes(nullptr, nullptr);
mib->setBssRateSet(unknown);
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, unknown);

// Both production selectors preserve a legal frame-class rate for group frames.
auto mixedBasic = allG;
mixedBasic.basic = makeLegacySet(true, {Mbps(2), Mbps(6), Mbps(11), Mbps(12), Mbps(24)});
mib->setBssRateSet(mixedBasic);
auto mgmtHeader = makeShared<Ieee80211MgmtHeader>();
auto checkGroupMode = [&](const Ptr<const Ieee80211DataOrMgmtHeader>& header, const IIeee80211Mode *expected) {
    ASSERT(dcf->computeMode(nullptr, header) == expected);
    ASSERT(qos->computeMode(nullptr, header, true, nullptr) == expected);
    ASSERT(qos->computeMode(nullptr, header, false, g6, true) == expected);
};
for (const auto& address : {MacAddress::BROADCAST_ADDRESS, MacAddress("01:00:5e:00:00:01")}) {
    dataHeader->setReceiverAddress(address);
    mgmtHeader->setReceiverAddress(address);
    for (const auto *fixed : {gModes->getMode(Mbps(2)), gModes->getMode(Mbps(11))}) {
        dcf->setFixedModes(fixed, nullptr, g12);
        qos->setFixedModes(fixed, nullptr, g12);
        checkGroupMode(dataHeader, fixed);
        checkGroupMode(mgmtHeader, g12);
        dcf->setFixedModes(fixed, g6, g12);
        qos->setFixedModes(fixed, g6, g12);
        checkGroupMode(dataHeader, g6);
        checkGroupMode(mgmtHeader, g6);
    }
    // A non-basic preference falls back; an explicit non-basic group override still fails.
    auto g54 = gModes->getMode(Mbps(54));
    dcf->setFixedModes(g54, nullptr, g54);
    qos->setFixedModes(g54, nullptr, g54);
    checkGroupMode(dataHeader, g24);
    checkGroupMode(mgmtHeader, g24);
    dcf->setFixedModes(g6, g54);
    qos->setFixedModes(g6, g54);
    bool dcfRejected = false;
    bool qosRejected = false;
    try { dcf->computeMode(nullptr, dataHeader); }
    catch (const cRuntimeError&) { dcfRejected = true; }
    try { qos->computeMode(nullptr, dataHeader, true, nullptr); }
    catch (const cRuntimeError&) { qosRejected = true; }
    ASSERT(dcfRejected && qosRejected);
}
dcf->setFixedModes(g6, nullptr);
qos->setFixedModes(g6, nullptr);
mib->setLocalRateSet(makeLegacyState(true, {Mbps(12), Mbps(24)}, {}, {Mbps(12), Mbps(24)}));
checkGroupMode(dataHeader, g24); // A basic rate can still violate local operation.
mib->setLocalRateSet(localAll);
mib->setBssRateSet(unknown);
checkGroupMode(dataHeader, g6); // The preferred mandatory rate also works before association.
dcf->setFixedModes(nullptr, nullptr);
qos->setFixedModes(nullptr, nullptr);
checkGroupMode(dataHeader, g24);

// Unknown and known-empty basic sets both use the mandatory legacy fallback.
ASSERT(selection->basicMode(nullptr, peer, false) == g24);
auto knownEmptyBss = makeState(makeLegacySet(false, {}), makeLegacySet(true, {}), makeLegacySet(false, {}));
mib->setBssRateSet(knownEmptyBss);
ASSERT(selection->basicMode(nullptr, peer, false) == g24);

// The BSS basic set can include an optional rate that differs from the mandatory PHY set.
const auto bssBasic69 = makeLegacyState(true,
        {Mbps(1), Mbps(2), Mbps(5.5), Mbps(6), Mbps(9), Mbps(11), Mbps(12), Mbps(18), Mbps(24), Mbps(36), Mbps(48), Mbps(54)},
        {Mbps(6), Mbps(9)},
        {Mbps(1), Mbps(2), Mbps(5.5), Mbps(6), Mbps(9), Mbps(11), Mbps(12), Mbps(18), Mbps(24), Mbps(36), Mbps(48), Mbps(54)});
mib->setBssRateSet(bssBasic69);
ASSERT(selection->basicMode(nullptr, peer, false) == g9);
ASSERT(selection->basicMode(g9, peer, false) == g9);
ASSERT(selection->groupMode(g9) == g9);
bool invalidGroupModeRejected = false;
try {
    selection->groupMode(g24);
}
catch (const cRuntimeError&) {
    invalidGroupModeRejected = true;
}
ASSERT(invalidGroupModeRejected);

// A nonempty BSS basic set with no locally eligible member must not use a mandatory fallback.
const auto localBasic1224 = makeLegacyState(true, {Mbps(12), Mbps(24)}, {Mbps(12), Mbps(24)}, {Mbps(12), Mbps(24)});
const auto bssBasic6 = makeLegacyState(true,
        {Mbps(1), Mbps(2), Mbps(5.5), Mbps(6), Mbps(9), Mbps(11), Mbps(12), Mbps(18), Mbps(24), Mbps(36), Mbps(48), Mbps(54)},
        {Mbps(6)}, {Mbps(6), Mbps(12), Mbps(24)});
mib->setLocalRateSet(localBasic1224);
mib->setBssRateSet(bssBasic6);
bool noEligibleGroupBasicRejected = false;
try {
    selection->groupMode(nullptr);
}
catch (const cRuntimeError&) {
    noEligibleGroupBasicRejected = true;
}
ASSERT(noEligibleGroupBasicRejected);
mib->setLocalRateSet(localAll);
mib->setBssRateSet(bssBasic69);

// A basic rate that local operation rejects must fall back to a mandatory rate.
mib->setLocalRateSet(makeLegacyState(true, {Mbps(6)}, {}, {Mbps(6)}));
ASSERT(selection->basicMode(nullptr, peer, false) == g6);
ASSERT(selection->allowedMode(peer, g9) == g6);
bool locallyRejectedGroupMode = false;
try {
    selection->groupMode(g9);
}
catch (const cRuntimeError&) {
    locallyRejectedGroupMode = true;
}
ASSERT(locallyRejectedGroupMode);

// A peer supported-rate limit applies to unicast selection.
mib->setLocalRateSet(localAll);
auto peerLimited = makeLegacyState(true,
        {Mbps(6), Mbps(12)}, {},
        {Mbps(6), Mbps(12)});
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, peerLimited);
ASSERT(selection->allowedMode(peer, g24) == g12);
ASSERT(selection->allowedMode(peer, g24, true) == g24);

bool invalidConfiguredModeRejected = false;
try {
    selection->configuredMode(g24, peer, "data");
}
catch (const cRuntimeError&) {
    invalidConfiguredModeRejected = true;
}
ASSERT(invalidConfiguredModeRejected);

// MIB installation emits only after both BSS and peer states are committed.
const auto initialBss = makeLegacyState(true,
        {Mbps(1), Mbps(2), Mbps(5.5), Mbps(6), Mbps(9), Mbps(11), Mbps(12), Mbps(18), Mbps(24), Mbps(36), Mbps(48), Mbps(54)},
        {Mbps(6)},
        {Mbps(1), Mbps(2), Mbps(5.5), Mbps(6), Mbps(9), Mbps(11), Mbps(12), Mbps(18), Mbps(24), Mbps(36), Mbps(48), Mbps(54)});
const auto initialPeer = makeLegacyState(true,
        {Mbps(1), Mbps(2), Mbps(5.5), Mbps(6), Mbps(9), Mbps(11), Mbps(12), Mbps(18), Mbps(24), Mbps(36), Mbps(48), Mbps(54)},
        {}, {Mbps(6)});
// Establish a different committed state before the transactional update.
mib->setBssRateSet(initialBss);
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, initialPeer);
const auto nextBss = bssBasic69;
const auto nextPeer = peerLimited;
RateSetObserver observer(mib, peer, nextBss, nextPeer);
mib->subscribe(Ieee80211Mib::bssRateSetChangedSignal, &observer);
mib->subscribe(Ieee80211Mib::peerRateSetChangedSignal, &observer);
const auto revisionBeforeInstall = mib->getRateSetRevision();
mib->installBssAndPeerRateSets(nextBss, peer, nextPeer);
ASSERT(observer.bssEvents == 1);
ASSERT(observer.peerEvents == 1);
ASSERT(mib->getRateSetRevision() == revisionBeforeInstall + 1);
mib->installBssAndPeerRateSets(nextBss, peer, nextPeer);
ASSERT(observer.bssEvents == 1);
ASSERT(observer.peerEvents == 1);
ASSERT(mib->getRateSetRevision() == revisionBeforeInstall + 1);

auto invalidBss = nextBss;
invalidBss.basic = makeLegacySet(true, {Mbps(6), Mbps(12)});
invalidBss.operational = makeLegacySet(true, {Mbps(6)});
bool invalidInstallRejected = false;
try {
    mib->installBssAndPeerRateSets(invalidBss, peer, nextPeer);
}
catch (const cRuntimeError&) {
    invalidInstallRejected = true;
}
ASSERT(invalidInstallRejected);
ASSERT(mib->getBssRateSet() == nextBss);
ASSERT(*mib->findPeerRateSet(peer) == nextPeer);
ASSERT(observer.bssEvents == 1);
ASSERT(observer.peerEvents == 1);
mib->unsubscribe(Ieee80211Mib::bssRateSetChangedSignal, &observer);
mib->unsubscribe(Ieee80211Mib::peerRateSetChangedSignal, &observer);

// ACK and CTS use the highest eligible basic ERP rate within the bound.
const auto *htModes = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
const auto *htMcs0 = htModes->getMode(Mbps(6.5));
ASSERT(htMcs0 != nullptr);
auto responseBss = makeLegacyState(true, {Mbps(6), Mbps(12), Mbps(24)}, {Mbps(6), Mbps(12), Mbps(24)},
        {Mbps(6), Mbps(12), Mbps(24)});
mib->setBssRateSet(responseBss);
mib->installBssAndPeerRateSets(mib->getBssRateSet(), peer, unknown);
ASSERT(selection->responseMode(g9, Ieee80211ResponseFrameKind::ACK, peer) == g6);
ASSERT(selection->responseMode(g9, Ieee80211ResponseFrameKind::CTS, peer) == g6);
ASSERT(selection->responseMode(htMcs0, Ieee80211ResponseFrameKind::ACK, peer) == g6);
ASSERT(g6->getModulationClass() == IIeee80211Mode::ModulationClass::ERP_OFDM);

// Local data-rate limits must not change the predictable primary response.
mib->setLocalRateSet(makeLegacyState(true, {Mbps(6), Mbps(12), Mbps(24)}, {Mbps(24)}, {Mbps(24)}));
ASSERT(selection->responseMode(g9, Ieee80211ResponseFrameKind::ACK, peer) == g6);
ASSERT(selection->responseMode(g9, Ieee80211ResponseFrameKind::CTS, peer) == g6);
mib->setBssRateSet(makeLegacyState(true, {Mbps(6), Mbps(12), Mbps(24)}, {}, {Mbps(24)}));
ASSERT(selection->responseMode(g9, Ieee80211ResponseFrameKind::ACK, peer) == g6);
mib->setLocalRateSet(localAll);

// A Basic BA after a non-HT BAR preserves the BAR rate, class, and preamble.
auto basicBaBss = makeLegacyState(true, {Mbps(6), Mbps(12)}, {Mbps(6)}, {Mbps(6), Mbps(12)});
mib->setBssRateSet(basicBaBss);
ASSERT(selection->responseMode(g12, Ieee80211ResponseFrameKind::BASIC_BLOCK_ACK, peer) == g12);

// A local 20 MHz operation cannot select a 40 MHz mode from an HT-only basic set.
const auto htModeSet = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
mib->updateLocalHtCapabilities(htModeSet, {MHz(20)}, 1);
mib->setPrimaryChannel(1);
const auto htState = makeHtState({0}, {0}, {0});
mib->setLocalRateSet(htState);
mib->setBssRateSet(htState);
const auto *groupHtMode = htSelection->groupMode(nullptr);
ASSERT(groupHtMode != nullptr);
ASSERT(groupHtMode->getDataMode()->getBandwidth() == MHz(20));
ASSERT(htSelection->groupMode(nullptr, groupHtMode) == groupHtMode);
ASSERT(htSelection->groupMode(nullptr, g6) == groupHtMode);

// A VHT preference cannot satisfy a legacy basic-rate entry with the same numeric bitrate.
const auto *vhtModes = Ieee80211ModeSet::getModeSet("ac");
const auto *vhtMode = vhtModes->getMode(Mbps(6.5));
ASSERT(vhtMode->getModulationClass() == IIeee80211Mode::ModulationClass::VHT);
mib->setLocalRateSet(makeLegacyState(true, {Mbps(6), Mbps(6.5)}, {}, {Mbps(6), Mbps(6.5)}));
mib->setBssRateSet(makeLegacyState(true, {Mbps(6), Mbps(6.5)}, {Mbps(6), Mbps(6.5)}, {Mbps(6), Mbps(6.5)}));
ASSERT(vhtSelection->groupMode(nullptr, vhtMode) == vhtModes->getMode(Mbps(6)));

// A response candidate with a different legacy preamble is not a valid fallback.
const auto *shortPreambleBar = &Ieee80211HrDsssCompliantModes::hrDsssMode11MbpsCckShortPreamble;
bool preambleMismatchRejected = false;
try {
    selection->responseMode(shortPreambleBar, Ieee80211ResponseFrameKind::ACK, peer);
}
catch (const cRuntimeError&) {
    preambleMismatchRejected = true;
}
ASSERT(preambleMismatchRejected);

// IEEE Std 802.11-2024, 10.6.6.4 bounds a later RTS without requiring basic-set membership.
mib->setLocalRateSet(localAll);
mib->installBssAndPeerRateSets(makeLegacyState(true, {Mbps(6), Mbps(9), Mbps(12), Mbps(24)},
        {Mbps(24)}, {Mbps(6), Mbps(9), Mbps(12), Mbps(24)}), peer, unknown);
ASSERT(qos->computeMode(nullptr, rtsHeader, false, g6) == g6);
qos->setControlMode(g6);
ASSERT(qos->computeMode(nullptr, rtsHeader, false, g6) == g6);
bool initialFallbackRejected = false;
try { qos->computeMode(nullptr, rtsHeader, true, nullptr); }
catch (const cRuntimeError&) { initialFallbackRejected = true; }
ASSERT(initialFallbackRejected);
qos->setControlMode(g12);
bool aboveBoundRejected = false;
try { qos->computeMode(nullptr, rtsHeader, false, g6); }
catch (const cRuntimeError&) { aboveBoundRejected = true; }
ASSERT(aboveBoundRejected);
qos->setControlMode(g9);
ASSERT(qos->computeMode(nullptr, rtsHeader, false, g12) == g9);
qos->setControlMode(g24);
ASSERT(qos->computeMode(nullptr, rtsHeader, true, nullptr) == g24);
qos->setControlMode(nullptr);

// Outgoing prediction and incoming response selection must resolve the same foreign AP context.
const MacAddress targetAp("02:00:00:00:00:03");
mib->address = MacAddress("02:00:00:00:00:01");
mib->mode = Ieee80211Mib::INFRASTRUCTURE;
mib->bssStationData.stationType = Ieee80211Mib::STATION;
mib->bssStationData.isAssociated = true;
mib->bssData.bssid = peer;
mib->setLocalRateSet(localAll);
auto currentBss = makeLegacyState(true, {Mbps(6), Mbps(12), Mbps(24)}, {Mbps(12)}, {Mbps(6), Mbps(12), Mbps(24)});
auto targetBss = makeLegacyState(true, {Mbps(6), Mbps(24)}, {Mbps(6)}, {Mbps(6), Mbps(24)});
mib->installBssAndPeerRateSets(currentBss, targetAp, targetBss);
for (int direction : {0, 1, 2}) {
    bool outgoing = direction != 0;
    Packet frame("management-response-context");
    if (outgoing)
        frame.addTag<Ieee80211ModeReq>()->setMode(g24);
    else
        frame.addTag<Ieee80211ModeInd>()->setMode(g24);
    auto management = makeShared<Ieee80211MgmtHeader>();
    auto rts = makeShared<Ieee80211RtsFrame>();
    management->setTransmitterAddress(outgoing ? mib->address : targetAp);
    if (direction == 2)
        management->setTransmitterAddress(MacAddress::UNSPECIFIED_ADDRESS);
    management->setReceiverAddress(outgoing ? targetAp : mib->address);
    rts->setTransmitterAddress(management->getTransmitterAddress());
    rts->setReceiverAddress(management->getReceiverAddress());
    ASSERT(dcf->computeResponseAckFrameMode(&frame, management) == g6);
    ASSERT(qos->computeResponseAckFrameMode(&frame, management) == g6);
    ASSERT(dcf->computeResponseCtsFrameMode(&frame, rts) == g6);
    ASSERT(qos->computeResponseCtsFrameMode(&frame, rts) == g6);
}
ASSERT(selection->responseMode(g24, Ieee80211ResponseFrameKind::ACK, peer) == g12);
ASSERT(selection->groupMode(nullptr) == g12);
ASSERT(mib->getBssRateSet() == currentBss);

EV << "IEEE 802.11 rate selection boundaries and atomic MIB updates are correct.\n";

%contains: stdout
IEEE 802.11 rate selection boundaries and atomic MIB updates are correct.
