%description:
Verify both explicit Tx overloads and the completed NAV choice across a callback.

%includes:
#include "inet/linklayer/ieee80211/mac/Tx.h"
#include "inet/linklayer/ieee80211/mac/contract/IRx.h"
using namespace omnetpp;
using namespace inet;
using namespace inet::ieee80211;
namespace Ieee80211TxNavChoice_1 {
class NavRx : public IRx {
    void invalidateInterframeHistory() override {}
  public:
    int updates = 0;
    simtime_t lastDuration;
    bool isReceptionInProgress() const override { return false; }
    bool isMediumFree() const override { return true; }
    simtime_t getTxnavRemaining() const override { return SIMTIME_ZERO; }
    void successfulFrameTransmitted(simtime_t, simtime_t) override {}
    void setContentionBlocked(bool) override {}
    void frameTransmitted(simtime_t duration) override { updates++; lastDuration = duration; }
    void registerContention(IContention *) override {}
    void receptionStateChanged(physicallayer::IRadio::ReceptionState) override {}
    void transmissionStateChanged(physicallayer::IRadio::TransmissionState) override {}
    void receivedSignalPartChanged(physicallayer::IRadioSignal::SignalPart) override {}
    bool lowerFrameReceived(Packet *) override { return false; }
    bool prepareReceivedFrame(Packet *) override { return true; }
};

class ForwardingTx : public Tx {
  public:
    using Tx::transmitFrame;
    bool choice = false;
    simtime_t delay = -1;
    void transmitFrame(Packet *, const Ptr<const Ieee80211MacHeader>&, simtime_t ifs,
            bool updateLocalNav, ITx::ICallback *) override {
        choice = updateLocalNav;
        delay = ifs;
    }
};

class CompletionTx : public Tx {
  public:
    NavRx receiver;
    void prepare(bool choice, ITx::ICallback *callback) {
        auto header = makeShared<Ieee80211AckFrame>();
        header->setDurationField(SimTime(100, SIMTIME_US));
        frame = new Packet("completed-frame", header);
        txCallback = callback;
        transmitting = true;
        updateLocalNav = choice;
        rx = &receiver;
    }
    void replaceChoice(bool choice) { updateLocalNav = choice; }
    void prepareWait(ITx::ICallback *callback) {
        Enter_Method("prepareWait");
        ASSERT(!hasTransmission());
        frame = new Packet("pending-copy", makeShared<Ieee80211AckFrame>());
        txCallback = callback;
        transmitting = false;
        updateLocalNav = true;
        if (!endIfsTimer) endIfsTimer = new cMessage("pending-ifs");
        scheduleAfter(SimTime(16,SIMTIME_US),endIfsTimer);
    }
    bool isIfsScheduled() const { return endIfsTimer && endIfsTimer->isScheduled(); }
    bool hasRetainedFrame() const { return frame != nullptr; }
    bool hasNavChoice() const { return updateLocalNav; }
  protected:
    void initialize(int) override {}
};
Define_Module(CompletionTx);

class CompletionCallback : public ITx::ICallback {
  public:
    CompletionTx *tx;
    bool replacementChoice;
    int completions = 0;
    CompletionCallback(CompletionTx *tx, bool choice) : tx(tx), replacementChoice(choice) {}
    void transmissionComplete(Packet *, const Ptr<const Ieee80211MacHeader>&) override {
        completions++;
        ASSERT(!tx->hasTransmission());
        tx->replaceChoice(replacementChoice);
    }
};
}

%file: TestNetwork.ned
import inet.common.SimpleModule;
simple CompletionTx extends SimpleModule {
    parameters:
        @class(CompletionTx);
}
network TestNetwork {
    submodules:
        test: Test;
        tx: CompletionTx;
}

%inifile: omnetpp.ini
[General]
ned-path = .;../../../../src;../../lib
network = TestNetwork
seed-set = 0

%activity:
auto us = [](double value) { return SimTime(value * 1e-6); };
ForwardingTx forwarding;
ITx *interface = &forwarding;
auto header = makeShared<Ieee80211AckFrame>();
Packet packet("overloads", header);
for (bool choice : {false, true}) {
    interface->transmitFrame(&packet, header, choice, nullptr);
    ASSERT(forwarding.choice == choice && forwarding.delay == 0);
    forwarding.transmitFrame(&packet, header, choice, nullptr);
    ASSERT(forwarding.choice == choice && forwarding.delay == 0);
    interface->transmitFrame(&packet, header, us(16), choice, nullptr);
    ASSERT(forwarding.choice == choice && forwarding.delay == us(16));
    forwarding.transmitFrame(&packet, header, us(16), choice, nullptr);
    ASSERT(forwarding.choice == choice && forwarding.delay == us(16));
}
auto tx = check_and_cast<CompletionTx *>(cSimulation::getActiveSimulation()->getModuleByPath("tx"));
CompletionCallback callback(tx, true);
tx->prepare(false, &callback);
tx->radioTransmissionFinished();
ASSERT(tx->receiver.updates == 0);
callback.replacementChoice = false;
tx->prepare(true, &callback);
tx->radioTransmissionFinished();
ASSERT(tx->receiver.updates == 1);
ASSERT(tx->receiver.lastDuration == us(100));
CompletionCallback otherCallback(tx, false);
ASSERT(!tx->cancelPendingTransmission(&callback));
tx->prepareWait(&callback);
ASSERT(!tx->cancelPendingTransmission(&otherCallback));
ASSERT(tx->hasTransmission() && tx->isIfsScheduled() && tx->hasRetainedFrame());
int completions = callback.completions;
ASSERT(tx->cancelPendingTransmission(&callback));
ASSERT(!tx->hasTransmission() && !tx->isIfsScheduled() && !tx->hasRetainedFrame() && !tx->hasNavChoice());
ASSERT(callback.completions == completions && tx->receiver.updates == 1);
ASSERT(!tx->cancelPendingTransmission(&callback));
tx->prepare(false, &callback);
ASSERT(!tx->cancelPendingTransmission(&callback));
ASSERT(tx->hasTransmission() && tx->hasRetainedFrame());
tx->radioTransmissionFinished();
ASSERT(callback.completions == completions + 1 && tx->receiver.updates == 1);
EV << "Explicit Tx overloads and completed NAV choice passed.\n";

%contains: stdout
Explicit Tx overloads and completed NAV choice passed.
