%description:
PCAPng starts the interface IDs again when one writer object opens a second
file. The first packet of the second file refers to an interface description
in that file.

%includes:
#include <cstdio>
#include <fstream>
#include <iterator>
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/common/packet/recorder/PcapngWriter.h"

%global:
using namespace inet;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

static uint32_t readUint32(const std::vector<uint8_t>& bytes, size_t offset)
{
    uint32_t value = 0;
    for (size_t i = 0; i < 4; i++)
        value |= static_cast<uint32_t>(bytes.at(offset + i)) << (8 * i);
    return value;
}

%activity:
Packet packet("packet", makeShared<BytesChunk>(std::vector<uint8_t>{0, 1, 2, 3}));
NetworkInterface networkInterface;
PcapngWriter writer;
writer.open("reopen-first.pcapng", 0, 6);
writer.writePacket(SIMTIME_ZERO, &packet, b(0), b(0), DIRECTION_INBOUND, &networkInterface, LINKTYPE_ETHERNET);
writer.writePacket(SIMTIME_ZERO, &packet, b(0), b(0), DIRECTION_INBOUND, nullptr, LINKTYPE_ETHERNET);
writer.close();
writer.open("reopen-second.pcapng", 0, 6);
writer.writePacket(SIMTIME_ZERO, &packet, b(0), b(0), DIRECTION_INBOUND, nullptr, LINKTYPE_ETHERNET);
writer.writePacket(SIMTIME_ZERO, &packet, b(0), b(0), DIRECTION_INBOUND, &networkInterface, LINKTYPE_ETHERNET);
writer.close();
std::ifstream file("reopen-second.pcapng", std::ios::binary);
std::vector<uint8_t> bytes(std::istreambuf_iterator<char>(file), {});
std::vector<size_t> blocks;
for (size_t offset = 0; offset < bytes.size(); offset += readUint32(bytes, offset + 4)) {
    REQUIRE(readUint32(bytes, offset + 4) >= 12);
    blocks.push_back(offset);
}
// SHB, IDB without interface, EPB, IDB of the interface, EPB
REQUIRE(blocks.size() == 5);
REQUIRE(readUint32(bytes, blocks[1]) == 1);
REQUIRE(readUint32(bytes, blocks[2]) == 6);
REQUIRE(readUint32(bytes, blocks[2] + 8) == 0);
REQUIRE(readUint32(bytes, blocks[3]) == 1);
REQUIRE(readUint32(bytes, blocks[4]) == 6);
REQUIRE(readUint32(bytes, blocks[4] + 8) == 1);
std::remove("reopen-first.pcapng");
std::remove("reopen-second.pcapng");
EV << "PCAPng interface IDs of a second file verified.\n";

%contains: stdout
PCAPng interface IDs of a second file verified.
