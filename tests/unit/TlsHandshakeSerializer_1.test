%description:
TLS and DTLS ClientHello body encodings and the DTLS legacy cookie field.

%includes:
#include "../DtlsTestAssertions.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/transportlayer/tls/TlsClientHello_m.h"
#include "inet/transportlayer/dtls/DtlsPlaintextHeader_m.h"

using namespace inet;
using namespace inet::tls;
using namespace inet::dtls;

%activity:
auto tls = makeShared<TlsClientHello>();
tls->setCipherSuitesArraySize(1);
tls->setCipherSuites(0, 0x1301);
tls->setCompressionMethodsArraySize(1);
tls->setCompressionMethods(0, 0);
tls->setChunkLength(B(43));
Packet tlsPacket("tls", tls);
auto tlsBytes = tlsPacket.peekAtFront<BytesChunk>(B(43));
DTLS_TEST_CHECK(tlsBytes->getByte(34) == 0);
DTLS_TEST_CHECK(tlsBytes->getByte(35) == 0);
DTLS_TEST_CHECK(tlsBytes->getByte(36) == 2);
auto inconsistentHello = makeShared<TlsClientHello>();
inconsistentHello->setCipherSuitesArraySize(1);
inconsistentHello->setCipherSuites(0, 0x1301);
inconsistentHello->setCompressionMethodsArraySize(1);
inconsistentHello->setCompressionMethods(0, 0);
inconsistentHello->setChunkLength(B(44));
Packet inconsistentHelloPacket("inconsistent native ClientHello", inconsistentHello);
bool nativeHelloRejected = false;
try { inconsistentHelloPacket.peekAtFront<BytesChunk>(B(44)); }
catch (const cRuntimeError&) { nativeHelloRejected = true; }
// Keep this check active under NDEBUG: release serialization must reject it too.
if (!nativeHelloRejected)
    throw cRuntimeError("Native TLS body length mismatch was accepted");

auto dtls = makeShared<DtlsClientHello>();
dtls->setCipherSuitesArraySize(1);
dtls->setCipherSuites(0, 0x1301);
dtls->setCompressionMethodsArraySize(1);
dtls->setCompressionMethods(0, 0);
dtls->setLegacyCookieArraySize(1);
dtls->setLegacyCookie(0, 0x5a);
dtls->setChunkLength(B(45));
Packet dtlsPacket("dtls", dtls);
auto dtlsBytes = dtlsPacket.peekAtFront<BytesChunk>(B(45));
DTLS_TEST_CHECK(dtlsBytes->getByte(34) == 0);
DTLS_TEST_CHECK(dtlsBytes->getByte(35) == 1);
DTLS_TEST_CHECK(dtlsBytes->getByte(36) == 0x5a);
DTLS_TEST_CHECK(dtlsBytes->getByte(37) == 0);
DTLS_TEST_CHECK(dtlsBytes->getByte(38) == 2);
Packet decoded("decoded", dtlsBytes);
auto body = decoded.popAtFront<DtlsClientHello>(B(45));
DTLS_TEST_CHECK(body->getLegacyCookieArraySize() == 1);
DTLS_TEST_CHECK(body->getLegacyCookie(0) == 0x5a);
DTLS_TEST_CHECK(body->getCipherSuites(0) == 0x1301);
auto envelope = makeShared<DtlsHandshakeHeader>();
envelope->setMessageType(1);
envelope->setMessageLength(45);
envelope->setFragmentLength(45);
Packet wire("DTLS handshake", dtls);
wire.insertAtFront(envelope);
auto wireBytes = wire.peekAtFront<BytesChunk>(B(57));
DTLS_TEST_CHECK(wireBytes->getByte(0) == 1);
DTLS_TEST_CHECK(wireBytes->getByte(11) == 45);
DTLS_TEST_CHECK(wireBytes->getByte(12) == 0xfe); // DTLS ClientHello legacy_version
DTLS_TEST_CHECK(wireBytes->getByte(13) == 0xfd);
// An empty CertificateRequest extensions vector has a two-byte zero length.
auto request = makeShared<TlsCertificateRequest>();
request->setChunkLength(B(3));
Packet requestPacket("request", request);
auto requestBytes = requestPacket.peekAtFront<BytesChunk>(B(3));
DTLS_TEST_CHECK(requestBytes->getByte(0) == 0);
DTLS_TEST_CHECK(requestBytes->getByte(1) == 0);
DTLS_TEST_CHECK(requestBytes->getByte(2) == 0);
Packet requestInput("request input", requestBytes);
auto decodedRequest = requestInput.popAtFront<TlsCertificateRequest>(B(3));
DTLS_TEST_CHECK(decodedRequest->getExtensionsArraySize() == 0);
auto phaRequest = makeShared<TlsCertificateRequest>();
phaRequest->setRequestContextArraySize(2);
phaRequest->setRequestContext(0, 0x12);
phaRequest->setRequestContext(1, 0x34);
phaRequest->setChunkLength(B(5));
Packet phaRequestPacket("PHA request", phaRequest);
auto phaRequestBytes = phaRequestPacket.peekAtFront<BytesChunk>(B(5));
DTLS_TEST_CHECK(phaRequestBytes->getBytes() == std::vector<uint8_t>({2,0x12,0x34,0,0}));
Packet phaRequestInput("PHA request input", phaRequestBytes);
DTLS_TEST_CHECK(phaRequestInput.popAtFront<TlsCertificateRequest>(B(5))->getRequestContext(1) == 0x34);
auto server = makeShared<TlsServerHello>();
server->setChunkLength(B(40));
Packet serverPacket("ServerHello", server);
auto serverBytes = serverPacket.peekAtFront<BytesChunk>(B(40));
DTLS_TEST_CHECK(serverBytes->getByte(34) == 0);
DTLS_TEST_CHECK(serverBytes->getByte(35) == 0x13 && serverBytes->getByte(36) == 1);
DTLS_TEST_CHECK(serverBytes->getByte(37) == 0 && serverBytes->getByte(39) == 0);
auto certificate = makeShared<TlsCertificate>();
certificate->setCertificateListArraySize(3);
certificate->setCertificateList(0, 0x11);
certificate->setCertificateList(1, 0x22);
certificate->setCertificateList(2, 0x33);
certificate->setChunkLength(B(7));
Packet certificatePacket("Certificate", certificate);
auto certificateBytes = certificatePacket.peekAtFront<BytesChunk>(B(7));
DTLS_TEST_CHECK(certificateBytes->getBytes() == std::vector<uint8_t>({0, 0, 0, 3, 0x11, 0x22, 0x33}));
Packet certificateInput("Certificate input", certificateBytes);
DTLS_TEST_CHECK(certificateInput.popAtFront<TlsCertificate>(B(7))->getCertificateList(2) == 0x33);
auto declined = makeShared<TlsCertificate>();
declined->setRequestContextArraySize(2);
declined->setRequestContext(0, 0x12);
declined->setRequestContext(1, 0x34);
declined->setChunkLength(B(6));
Packet declinedPacket("declined PHA", declined);
auto declinedBytes = declinedPacket.peekAtFront<BytesChunk>(B(6));
DTLS_TEST_CHECK(declinedBytes->getBytes() == std::vector<uint8_t>({2,0x12,0x34,0,0,0}));
Packet declinedInput("declined PHA input", declinedBytes);
auto decodedDecline = declinedInput.popAtFront<TlsCertificate>(B(6));
DTLS_TEST_CHECK(decodedDecline->getRequestContext(1) == 0x34 && decodedDecline->getCertificateListArraySize() == 0);
auto signature = makeShared<TlsCertificateVerify>();
signature->setSignatureScheme(0x0403);
signature->setSignatureArraySize(1);
signature->setSignature(0, 0xa5);
signature->setChunkLength(B(5));
Packet signaturePacket("CertificateVerify", signature);
DTLS_TEST_CHECK(signaturePacket.peekAtFront<BytesChunk>(B(5))->getBytes() == std::vector<uint8_t>({4, 3, 0, 1, 0xa5}));
auto update = makeShared<TlsKeyUpdate>();
update->setRequestUpdate(1);
Packet updatePacket("KeyUpdate", update);
DTLS_TEST_CHECK(updatePacket.peekAtFront<BytesChunk>(B(1))->getByte(0) == 1);
const std::vector<uint8_t> truncatedRequest = {0, 0, 1};
auto rsa = makeShared<TlsCertificateVerify>();
rsa->setSignatureScheme(0x0804);
rsa->setSignatureArraySize(256);
for (size_t i = 0; i < 256; ++i) rsa->setSignature(i, i);
rsa->setChunkLength(B(260));
Packet rsaPacket("RSA-PSS modeled signature", rsa);
auto rsaBytes = rsaPacket.peekDataAsBytes()->getBytes();
DTLS_TEST_CHECK(rsaBytes.size() == 260 && rsaBytes[0] == 8 && rsaBytes[1] == 4 && rsaBytes[2] == 1 && rsaBytes[3] == 0 && rsaBytes.back() == 255);
Packet rsaInput("RSA input", makeShared<BytesChunk>(rsaBytes));
auto rsaDecoded = rsaInput.popAtFront<TlsCertificateVerify>(B(260));
DTLS_TEST_CHECK(rsaDecoded->getSignatureScheme() == 0x0804 && rsaDecoded->getSignatureArraySize() == 256);
auto sha384Finished = makeShared<TlsFinished>();
sha384Finished->setVerifyDataArraySize(48);
for (size_t i = 0; i < 48; ++i) sha384Finished->setVerifyData(i, i);
sha384Finished->setChunkLength(B(48));
Packet finishedPacket("SHA384 Finished", sha384Finished);
auto finishedBytes = finishedPacket.peekDataAsBytes();
DTLS_TEST_CHECK(finishedBytes->getBytes().size() == 48 && finishedBytes->getByte(47) == 47);
Packet finishedInput("Finished input", finishedBytes);
DTLS_TEST_CHECK(finishedInput.popAtFront<TlsFinished>(B(48))->getVerifyDataArraySize() == 48);
Packet malformedRequest("truncated extensions", makeShared<BytesChunk>(truncatedRequest));
bool rejected = false;
try { malformedRequest.popAtFront<TlsCertificateRequest>(B(3)); }
catch (const cRuntimeError&) { rejected = true; }
DTLS_TEST_CHECK(rejected);
EV << "TLS and DTLS ClientHello bodies PASS\n";

%contains: stdout
TLS and DTLS ClientHello bodies PASS
