%description:
Verify shared sequence-space progression, first allocation, modulo wrap and
receiver/TID separation. IEEE Std 802.11-2024, 10.3.2.14.2 and Table 10-5.

%includes:
#include "inet/linklayer/ieee80211/mac/sequencenumberassignment/LegacySequenceNumberAssignment.h"
#include "inet/linklayer/ieee80211/mac/sequencenumberassignment/NonQoSSequenceNumberAssignment.h"
#include "inet/linklayer/ieee80211/mac/sequencenumberassignment/QoSSequenceNumberAssignment.h"

using namespace inet;
using namespace inet::ieee80211;

%global:
static Ptr<Ieee80211MgmtHeader> management(const MacAddress& receiver)
{
    auto header = makeShared<Ieee80211MgmtHeader>();
    header->setType(ST_AUTHENTICATION);
    header->setReceiverAddress(receiver);
    return header;
}

static Ptr<Ieee80211DataHeader> qos(const MacAddress& receiver, int tid)
{
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(receiver);
    header->setTid(tid);
    return header;
}

%activity:
const MacAddress a("02:00:00:00:00:01"), b("02:00:00:00:00:02");
LegacySequenceNumberAssignment legacy;
NonQoSSequenceNumberAssignment nonQos;
QoSSequenceNumberAssignment shared;
for (int i = 0; i < 4098; i++) {
    for (ISequenceNumberAssignment *allocator : {static_cast<ISequenceNumberAssignment *>(&legacy),
            static_cast<ISequenceNumberAssignment *>(&nonQos), static_cast<ISequenceNumberAssignment *>(&shared)}) {
        auto header = management(i % 2 ? b : a);
        allocator->assignSequenceNumber(header);
        ASSERT(header->getSequenceNumber().get() == i % 4096);
    }
}

// The QoS individual-data SNS is independent of shared management traffic and
// of both the receiver and TID of other individually addressed QoS streams.
for (int i = 0; i < 3; i++) {
    for (const auto& receiver : {a, b}) {
        for (int tid : {0, 5}) {
            auto header = qos(receiver, tid);
            shared.assignSequenceNumber(header);
            ASSERT(header->getSequenceNumber().get() == i);
        }
    }
}

// Table 10-5 TR1: avoid reusing receiver A's last number after the other
// receiver has consumed the remainder of the shared counter's cycle.
for (bool useQos : {false, true}) {
    NonQoSSequenceNumberAssignment nonQosCollision;
    QoSSequenceNumberAssignment qosCollision;
    ISequenceNumberAssignment *allocator = useQos ?
            static_cast<ISequenceNumberAssignment *>(&qosCollision) : &nonQosCollision;
    auto first = management(a);
    allocator->assignSequenceNumber(first);
    ASSERT(first->getSequenceNumber().get() == 0);
    for (int i = 1; i < 4096; i++) {
        auto other = management(b);
        allocator->assignSequenceNumber(other);
        ASSERT(other->getSequenceNumber().get() == i);
    }
    auto collision = management(a);
    allocator->assignSequenceNumber(collision);
    ASSERT(collision->getSequenceNumber().get() == 1);
    auto next = management(b);
    allocator->assignSequenceNumber(next);
    ASSERT(next->getSequenceNumber().get() == 2);
}
EV << "Sequence allocation starts at zero, advances shared spaces and wraps safely.\n";

%contains: stdout
Sequence allocation starts at zero, advances shared spaces and wraps safely.
