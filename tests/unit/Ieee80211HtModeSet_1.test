%description:
Verify that n and ac expose the same 128 HT combinations.
Verify distinct band-specific objects and timing for each HT combination.
The ac catalog retains VHT fixed-rate ties and equal-rate traversal order.
Also verify exact sparse HT MCS and width derivation from typed mode entries.

%includes:
#include <algorithm>
#include <vector>

#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HtMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211VhtMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"

using namespace inet;
using namespace inet::physicallayer;
using namespace inet::units::values;

%global:

class SparseModeSet : public Ieee80211ModeSet
{
  public:
    using Ieee80211ModeSet::Entry;

    SparseModeSet(const std::vector<Entry>& entries, const IIeee80211Mode *referenceMode, bool htOperationSupported = true) :
        Ieee80211ModeSet("sparse", entries, referenceMode, PhyType::HT, htOperationSupported)
    {}
};

static const IIeee80211Mode *findHtMode(const Ieee80211ModeSet *modeSet, int mcsIndex, Hz bandwidth,
        Ieee80211HtModeBase::GuardIntervalType guardIntervalType)
{
    for (int i = 0; i < modeSet->getNumModes(); i++) {
        const auto *mode = modeSet->getMode(i);
        if (mode->getHtMcsIndex() == mcsIndex && mode->getDataMode()->getBandwidth() == bandwidth &&
                mode->isHtShortGuardInterval() == (guardIntervalType == Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT))
            return mode;
    }
    return nullptr;
}

%activity:

const auto *htModeSet = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
const auto *vhtOnlyModeSet = Ieee80211ModeSet::getModeSet("ac");

ASSERT(htModeSet->isHtOperationSupported());
ASSERT(vhtOnlyModeSet->isHtOperationSupported());

// The built-in HT catalog is complete for the advertised MCS, widths, and
// guard intervals. Only long-GI 20 MHz MCS 0-7 are mandatory.
int htModeCount = 0;
for (int i = 0; i < htModeSet->getNumModes(); i++) {
    const auto *mode = htModeSet->getMode(i);
    if (mode->getHtMcsIndex() >= 0) {
        ASSERT(mode->getHtMcsIndex() < 32);
        htModeCount++;
    }
}
ASSERT(htModeCount == 32 * 2 * 2);
for (int mcsIndex = 0; mcsIndex < 32; mcsIndex++) {
    ASSERT(htModeSet->getHtMcsSupported()[mcsIndex]);
    for (auto bandwidth : {MHz(20), MHz(40)}) {
        for (auto guardIntervalType : {Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG, Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT}) {
            const auto *mode = findHtMode(htModeSet, mcsIndex, bandwidth, guardIntervalType);
            ASSERT(mode != nullptr);
            ASSERT(htModeSet->containsMode(mode));
            bool mandatory = bandwidth == MHz(20) && guardIntervalType == Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG && mcsIndex < 8;
            ASSERT(htModeSet->getIsMandatory(mode) == mandatory);
        }
    }
}
ASSERT(htModeSet->getHtSupportedChannelWidths().size() == 2);
ASSERT(htModeSet->isHtShortGuardIntervalSupported(MHz(20)));
ASSERT(htModeSet->isHtShortGuardIntervalSupported(MHz(40)));

std::vector<SparseModeSet::Entry> sparseEntries;
for (int mcsIndex = 0; mcsIndex < 8; mcsIndex++)
    sparseEntries.push_back({true, findHtMode(htModeSet, mcsIndex, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG)});
sparseEntries.push_back({false, findHtMode(htModeSet, 8, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT)});
sparseEntries.push_back({false, findHtMode(htModeSet, 10, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT)});
// IEEE Std 802.11-2024, 9.4.2.3 and 11.1.4.6: an ordinary HT profile
// includes its applicable legacy operational rates in Supported Rates.
sparseEntries.push_back({true, htModeSet->getMode(Mbps(1)), true});
SparseModeSet sparse(sparseEntries, sparseEntries[0].mode);
ASSERT(sparse.isHtOperationSupported());
ASSERT(sparse.getLegacyOperationalModes().size() == 1);
ASSERT(sparse.getFastestLegacyOperationalMode() == sparse.getLegacyOperationalModes().front());

// The peer-HT fallback is the fastest mandatory legacy operational mode, not
// merely the last rate in the complete (mandatory plus optional) list.
SparseModeSet legacyFallback({
        { true, findHtMode(htModeSet, 0, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG) },
        { true, htModeSet->getMode(Mbps(1)), true },
        { true, htModeSet->getMode(Mbps(2)), true },
        { false, htModeSet->getMode(Mbps(5.5)), true },
    }, findHtMode(htModeSet, 0, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG), false);
ASSERT(legacyFallback.getFastestLegacyOperationalMode() == htModeSet->getMode(Mbps(2)));

SparseModeSet optionalOnlyFallback({
        { true, findHtMode(htModeSet, 0, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG) },
        { false, htModeSet->getMode(Mbps(1)), true },
    }, findHtMode(htModeSet, 0, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG), false);
ASSERT(optionalOnlyFallback.getFastestLegacyOperationalMode() == htModeSet->getMode(Mbps(1)));
for (int mcsIndex = 0; mcsIndex < 77; mcsIndex++) {
    bool expected = mcsIndex < 8 || mcsIndex == 8 || mcsIndex == 10;
    ASSERT(sparse.getHtMcsSupported()[mcsIndex] == expected);
    ASSERT(sparse.getHtMcsMandatory()[mcsIndex] == (mcsIndex < 8));
}
ASSERT(sparse.getHtSupportedChannelWidths().size() == 1);
ASSERT(sparse.getHtSupportedChannelWidths().count(MHz(20)) == 1);
ASSERT(sparse.isHtShortGuardIntervalSupported(MHz(20)));

// Guard-interval support is aggregated only from typed HT mode entries. A
// profile may therefore expose a short-GI mode independently of its mandatory
// long-GI MCS entries, while non-HT/VHT modes cannot contribute to HT bits.
SparseModeSet short20({
        { false, findHtMode(htModeSet, 8, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT) },
        { true, htModeSet->getMode(Mbps(1)), true },
    }, findHtMode(htModeSet, 8, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT), false);
ASSERT(short20.isHtShortGuardIntervalSupported(MHz(20)));
ASSERT(!short20.isHtShortGuardIntervalSupported(MHz(40)));

SparseModeSet short40({
        { false, findHtMode(htModeSet, 0, MHz(40), Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT) },
        { true, htModeSet->getMode(Mbps(1)), true },
    }, findHtMode(htModeSet, 0, MHz(40), Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT), false);
ASSERT(!short40.isHtShortGuardIntervalSupported(MHz(20)));
ASSERT(short40.isHtShortGuardIntervalSupported(MHz(40)));

SparseModeSet longOnly({
        { false, findHtMode(htModeSet, 0, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG) },
        { true, htModeSet->getMode(Mbps(1)), true },
    }, findHtMode(htModeSet, 0, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG), false);
ASSERT(!longOnly.isHtShortGuardIntervalSupported(MHz(20)));
ASSERT(vhtOnlyModeSet->getHtShortGuardIntervalChannelWidths() == htModeSet->getHtShortGuardIntervalChannelWidths());

// All mandatory HT MCSs without an eligible legacy operational mode are
// rejected at the mode-set boundary before management serialization.
auto htOnlyEntries = sparseEntries;
for (auto& entry : htOnlyEntries)
    entry.isLegacyOperational = false;
bool htOnlyRejected = false;
try {
    SparseModeSet invalid(htOnlyEntries, htOnlyEntries[0].mode);
}
catch (const cRuntimeError&) {
    htOnlyRejected = true;
}
ASSERT(htOnlyRejected);
bool nonHtOnlyRejected = false;
try {
    SparseModeSet invalid(htOnlyEntries, htOnlyEntries[0].mode, false);
}
catch (const cRuntimeError&) {
    nonHtOnlyRejected = true;
}
ASSERT(nonHtOnlyRejected);

std::vector<SparseModeSet::Entry> missingMandatory;
for (int mcsIndex = 0; mcsIndex < 7; mcsIndex++)
    missingMandatory.push_back({true, findHtMode(htModeSet, mcsIndex, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG)});
missingMandatory.push_back({false, findHtMode(htModeSet, 8, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT)});
missingMandatory.push_back({true, htModeSet->getMode(Mbps(1)), true});
bool missingMandatoryRejected = false;
try {
    SparseModeSet invalid(missingMandatory, missingMandatory[0].mode);
}
catch (const cRuntimeError&) {
    missingMandatoryRejected = true;
}
ASSERT(missingMandatoryRejected);

// The timing reference is explicit and remains stable when lookup entries are
// reordered by bitrate. A reference must also be present exactly once.
auto reorderedEntries = sparseEntries;
std::swap(reorderedEntries.front(), reorderedEntries.back());
SparseModeSet reordered(reorderedEntries, sparseEntries[0].mode);
ASSERT(reordered.getReferenceMode() == sparseEntries[0].mode);
ASSERT(reordered.getSifsTime() == sparseEntries[0].mode->getSifsTime());
ASSERT(reordered.getSlotTime() == sparseEntries[0].mode->getSlotTime());
ASSERT(reordered.getPhyRxStartDelay() == sparseEntries[0].mode->getPhyRxStartDelay());

bool nullReferenceRejected = false;
try {
    SparseModeSet invalid(sparseEntries, nullptr);
}
catch (const cRuntimeError&) {
    nullReferenceRejected = true;
}
ASSERT(nullReferenceRejected);

bool notContainedReferenceRejected = false;
try {
    SparseModeSet invalid(sparseEntries, vhtOnlyModeSet->getMode(0));
}
catch (const cRuntimeError&) {
    notContainedReferenceRejected = true;
}
ASSERT(notContainedReferenceRejected);

int acHtCount = 0;
int acVhtCount = 0;
for (int i = 0; i < vhtOnlyModeSet->getNumModes(); i++) {
    const auto *mode = vhtOnlyModeSet->getMode(i);
    acHtCount += mode->getHtMcsIndex() >= 0;
    if (dynamic_cast<const Ieee80211VhtMode *>(mode)) {
        acVhtCount++;
        const auto *fixed = vhtOnlyModeSet->getMode(mode->getDataMode()->getNetBitrate(),
                mode->getDataMode()->getBandwidth(), mode->getDataMode()->getNumberOfSpatialStreams());
        ASSERT(dynamic_cast<const Ieee80211VhtMode *>(fixed) != nullptr);
    }
}
ASSERT(acHtCount == 128);
ASSERT(acVhtCount == 310);
ASSERT(vhtOnlyModeSet->getHtMcsSupported() == htModeSet->getHtMcsSupported());
ASSERT(vhtOnlyModeSet->getHtMcsMandatory() == htModeSet->getHtMcsMandatory());
ASSERT(vhtOnlyModeSet->getHtSupportedChannelWidths() == htModeSet->getHtSupportedChannelWidths());
for (int mcs = 0; mcs < 32; mcs++) {
    for (auto width : {MHz(20), MHz(40)}) {
        for (auto gi : {Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG, Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT}) {
            const auto *ht = findHtMode(htModeSet, mcs, width, gi);
            const auto *acHt = findHtMode(vhtOnlyModeSet, mcs, width, gi);
            ASSERT(acHt != nullptr);
            const auto *typedHt = dynamic_cast<const Ieee80211HtMode *>(ht);
            const auto *typedAcHt = dynamic_cast<const Ieee80211HtMode *>(acHt);
            ASSERT(typedHt != nullptr);
            ASSERT(typedAcHt != nullptr);
            ASSERT(typedAcHt != typedHt);
            ASSERT(typedHt->getCenterFrequencyMode() == Ieee80211HtMode::BAND_2_4GHZ);
            ASSERT(typedAcHt->getCenterFrequencyMode() == Ieee80211HtMode::BAND_5GHZ);
            // IEEE Std 802.11-2024, Table 19-25: band-specific HT PHY timing.
            ASSERT(typedHt->getSifsTime() == SimTime(10, SIMTIME_US));
            ASSERT(typedHt->getSlotTime() == SimTime(20, SIMTIME_US));
            ASSERT(typedAcHt->getSifsTime() == SimTime(16, SIMTIME_US));
            ASSERT(typedAcHt->getSlotTime() == SimTime(9, SIMTIME_US));
            ASSERT(typedHt->getSignalExtensionTime() == SimTime(6, SIMTIME_US));
            ASSERT(typedAcHt->getSignalExtensionTime() == SIMTIME_ZERO);
            ASSERT(typedHt->getDuration(B(100)) - typedAcHt->getDuration(B(100)) == SimTime(6, SIMTIME_US));
            if (mcs == 0 && width == MHz(20) && gi == Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG) {
                // MCS 0: 36 us preamble + ceil((16 + 800 + 6) / 26) * 4 us + band extension.
                ASSERT(typedHt->getDuration(B(100)) == SimTime(170, SIMTIME_US));
                ASSERT(typedAcHt->getDuration(B(100)) == SimTime(164, SIMTIME_US));
            }
            ASSERT(acHt->getDataMode()->getNetBitrate() == ht->getDataMode()->getNetBitrate());
            ASSERT(acHt->getDataMode()->getNumberOfSpatialStreams() == ht->getDataMode()->getNumberOfSpatialStreams());
            ASSERT(vhtOnlyModeSet->getIsMandatory(acHt) == htModeSet->getIsMandatory(ht));
        }
    }
}
const auto *vht6_5 = vhtOnlyModeSet->getMode(Mbps(6.5), MHz(20), 1);
const auto *vht13 = vhtOnlyModeSet->getMode(Mbps(13), MHz(20), 1);
ASSERT(dynamic_cast<const Ieee80211VhtMode *>(vht6_5) != nullptr);
ASSERT(dynamic_cast<const Ieee80211VhtMode *>(vht13) != nullptr);
const auto *ht6_5 = findHtMode(vhtOnlyModeSet, 0, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG);
ASSERT(vhtOnlyModeSet->getFasterMode(vht6_5) == ht6_5);
ASSERT(vhtOnlyModeSet->getSlowerMode(ht6_5) == vht6_5);
ASSERT(vhtOnlyModeSet->getMode(ht6_5->getDataMode()->getNetBitrate()) == vht6_5);
const auto *htUnique = findHtMode(vhtOnlyModeSet, 0, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_SHORT);
ASSERT(vhtOnlyModeSet->getMode(htUnique->getDataMode()->getNetBitrate(), MHz(20), 1) == htUnique);
const auto *ht8 = findHtMode(vhtOnlyModeSet, 8, MHz(20), Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG);
ASSERT(vhtOnlyModeSet->getMode(Mbps(13), MHz(20), 2) == ht8);
const auto *fastestMandatory = vhtOnlyModeSet->getFastestMandatoryMode();
ASSERT(dynamic_cast<const Ieee80211VhtMode *>(fastestMandatory) != nullptr);
ASSERT(fastestMandatory->getDataMode()->getNetBitrate() == Mbps(78));
ASSERT(vhtOnlyModeSet->getReferenceMode() == vht6_5);
ASSERT(vhtOnlyModeSet->getSifsTime() == SimTime(16, SIMTIME_US));
ASSERT(vhtOnlyModeSet->getSlotTime() == SimTime(9, SIMTIME_US));
ASSERT(vhtOnlyModeSet->getLegacyOperationalModes().size() == 3);
for (int legacyRate : {6, 12, 24}) {
    bool foundLegacy = false;
    for (const auto *legacy : vhtOnlyModeSet->getLegacyOperationalModes())
        foundLegacy |= legacy->getDataMode()->getNetBitrate() == Mbps(legacyRate);
    ASSERT(foundLegacy);
}

EV << "HT mode-set capability and sparse-MCS checks verified.\n";

%contains: stdout
HT mode-set capability and sparse-MCS checks verified.
