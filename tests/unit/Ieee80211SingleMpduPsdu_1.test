%description:
Independent IEEE2024 Figures9-1329--1332 golden delimiters: split14-bit length,
EOF, CRC and signature, followed by bounded single-payload-member parsing.
No production checksum function supplies the expected literal octets.

%includes:
#include "inet/linklayer/ieee80211/mac/aggregation/Ieee80211Psdu.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211OfdmMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

%activity:
const std::vector<std::vector<uint8_t>> literal = {
    {0x00,0x04,0x13,0x4E}, // HT64 EOF0
    {0x01,0x04,0x7E,0x4E}, // VHT64 EOF1
    {0x05,0x00,0x0C,0x4E}, // VHT4096 EOF1
    {0x01,0x00,0x79,0x4E}  // VHT0 EOF1 padding
};
for (int i = 0; i < 4; i++) {
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(i == 2 ? 4096 : i == 3 ? 0 : 64);
    delimiter->setVht(i != 0); delimiter->setEof(i != 0);
    Packet output("delimiter",delimiter);
    ASSERT(output.peekAllAsBytes()->getBytes() == literal[i]);
    Packet input("literal",makeShared<BytesChunk>(literal[i]));
    auto decoded = input.peekAtFront<Ieee80211MpduSubframeHeader>();
    ASSERT(decoded->isCorrect() && decoded->getLength() == delimiter->getLength() && decoded->getEof() == delimiter->getEof());
}
const IIeee80211Mode *mode = nullptr;
auto modes = Ieee80211ModeSet::getModeSet("ac-complete");
for (int i=0;i<modes->getNumModes();i++) {
    auto candidate = modes->getMode(i);
    if (candidate->getVhtMcsIndex() == 7 && candidate->getDataMode()->getBandwidth() == MHz(20)
            && candidate->getDataMode()->getNumberOfSpatialStreams() == 1 && candidate->isVhtShortGuardInterval()) mode = candidate;
}
ASSERT(mode);
ASSERT(getSingleMpduPsduLength(B(58),mode) == B(62));
ASSERT(mode->getDuration(B(62)) == SimTime(48,SIMTIME_US));
ASSERT(mode->getDuration(B(64)) == SimTime(52,SIMTIME_US)); // Old unconditional alignment crossed a raw-symbol boundary.
for (int length : {14,25,58,62,63,64,65,4096,11454,16383}) {
    std::vector<uint8_t> member(length,0);
    member[0] = 0xd4; // complete10-octet ACK header, plus at least4-octet FCS
    Packet packet("single",makeShared<BytesChunk>(member));
    wrapSingleMpdu(&packet,mode);
    ASSERT(packet.getDataLength() == getSingleMpduPsduLength(B(length),mode));
    Ieee80211SingleMpduLayout layout;
    ASSERT(findSingleMpdu(&packet,B(0),B(packet.getDataLength()),layout));
    ASSERT(layout.memberLength == B(length) && layout.suffixLength == packet.getDataLength()-B(4+length));
    ASSERT(mode->getDataMode()->getDuration(B(packet.getDataLength())) == mode->getDataMode()->getDuration(getSingleMpduApepLength(B(length))));
    ASSERT(mode->getDataMode()->getDuration(B(packet.getDataLength())+B(1)) > mode->getDataMode()->getDuration(getSingleMpduApepLength(B(length))));
    auto raw = packet.peekAllAsBytes()->getBytes();
    for (int cut = 0; cut < 4+length; cut++) {
        Packet truncated("truncated",makeShared<BytesChunk>(std::vector<uint8_t>(raw.begin(),raw.begin()+cut)));
        ASSERT(!findSingleMpdu(&truncated,B(0),B(cut),layout));
    }
    raw[2] ^= 0x80;
    Packet badCrc("bad-crc",makeShared<BytesChunk>(raw));
    ASSERT(!findSingleMpdu(&badCrc,B(0),B(raw.size()),layout));
}
std::vector<uint8_t> padding = literal[1];
padding.resize(68,0);
padding[4] = 0xd4;
padding.insert(padding.end(),literal[3].begin(),literal[3].end());
padding.insert(padding.end(),3,0);
Packet padded("eof-padding",makeShared<BytesChunk>(padding));
Ieee80211SingleMpduLayout layout;
ASSERT(findSingleMpdu(&padded,B(0),B(padding.size()),layout) && layout.memberLength == B(64));
padding[68] = literal[1][0]; padding[69] = literal[1][1]; padding[70] = literal[1][2];
Packet multiple("multiple-payloads",makeShared<BytesChunk>(padding));
ASSERT(!findSingleMpdu(&multiple,B(0),B(padding.size()),layout));
for (int headerLength=0;headerLength<32;headerLength++) {
    std::vector<uint8_t> member(headerLength+4,0);
    if (headerLength) member[0] = 0x88; // QoS DATA
    if (headerLength>1) member[1] = 3; // four-address header requires32 octets
    Packet shortHeader("raw-short-member",makeShared<BytesChunk>(member));
    wrapSingleMpdu(&shortHeader,mode);
    ASSERT(!findSingleMpdu(&shortHeader,B(0),B(shortHeader.getDataLength()),layout));
}
Ieee80211TxVector duplicate(&Ieee80211OfdmCompliantModes::ofdmMode6MbpsCS20MHz);
duplicate.format = Ieee80211TxVector::Format::NON_HT_DUPLICATE; duplicate.bandwidth = MHz(160);
ASSERT(duplicate.mode->getDataMode()->getBandwidth() == MHz(20) && !duplicate.singleMpdu);
EV << "Single MPDU golden bytes and bounded PSDU parsing passed.\n";

%contains: stdout
Single MPDU golden bytes and bounded PSDU parsing passed.
