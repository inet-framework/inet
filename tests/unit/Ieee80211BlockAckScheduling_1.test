%description:
Check peer/TID BAR arbitration, window boundaries, cyclic sequence order, and ACK-state isolation.
Check that a below-threshold forecast agrees with live selection after DATA transmission.
Check ordered in-progress selection before and at a projected lifetime deadline.
Check that successor selection after extracting fragments uses the same order as live transmission.
The production policy reads the production ACK handler through an in-progress queue.
These helper checks supplement the HCF module fixture.

%includes:
// Author: Miguel González-López
#include <type_traits>
#include <utility>
#include "inet/linklayer/ieee80211/mac/channelaccess/Edcaf.h"
#include "inet/linklayer/ieee80211/mac/originator/OriginatorQosAckPolicy.h"
#include "inet/linklayer/ieee80211/mac/originator/OriginatorQosMacDataService.h"
#include "inet/linklayer/ieee80211/mac/originator/QosAckHandler.h"
#include "inet/linklayer/ieee80211/mac/originator/QosRecoveryProcedure.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreementHandler.h"
using namespace inet;
using namespace inet::ieee80211;

namespace Ieee80211BlockAckScheduling_1 {
template<typename T, typename = void> struct ImplicitBarQuery : std::false_type {};
template<typename T> struct ImplicitBarQuery<T, std::void_t<decltype(
    std::declval<const T&>().isBlockAckReqNeeded(nullptr, nullptr))>> : std::true_type {};
template<typename T, typename = void> struct ImplicitBarParameters : std::false_type {};
template<typename T> struct ImplicitBarParameters<T, std::void_t<decltype(
    std::declval<const T&>().computeBlockAckReqParameters(nullptr, nullptr))>> : std::true_type {};
template<typename T, typename = void> struct ImplicitBarWindow : std::false_type {};
template<typename T> struct ImplicitBarWindow<T, std::void_t<decltype(
    std::declval<T&>().processTransmittedBlockAckReq(std::declval<Ptr<const Ieee80211BlockAckReq>>()))>> : std::true_type {};

static_assert(!ImplicitBarQuery<IOriginatorQoSAckPolicy>::value, "The interface requires an explicit agreement handler");
static_assert(!ImplicitBarQuery<OriginatorQosAckPolicy>::value, "The concrete policy requires an explicit agreement handler");
static_assert(!ImplicitBarParameters<IOriginatorQoSAckPolicy>::value, "The interface requires an explicit agreement handler");
static_assert(!ImplicitBarParameters<OriginatorQosAckPolicy>::value, "The concrete policy requires an explicit agreement handler");
static_assert(!ImplicitBarWindow<QosAckHandler>::value, "The ACK handler requires an explicit agreement window");

class SchedulingCw : public Edcaf {
  public:
    void configure(int minimum, int maximum, int limit) { cw = cwMin = minimum; cwMax = maximum; edcaRetryLimit = limit; }
};
class SchedulingRecovery : public QosRecoveryProcedure {
  public:
    void configure(IEdcaCwCalculator *calculator, int limit) {
        cwCalculator = calculator;
        shortRetryLimit = limit;
        longRetryLimit = 4;
        rtsThreshold = 500;
    }
    int getStationSrc() const { return cwCalculator->getEdcaRetryCount(); }
    bool hasDataRetry() const { return !shortRetryCounter.empty() || !longRetryCounter.empty(); }
};
class SchedulingPolicy : public OriginatorQosAckPolicy {
  public:
    SchedulingPolicy() { blockAckReqThreshold = 5; }
};
class SchedulingAgreements : public OriginatorBlockAckAgreementHandler {
  public:
    OriginatorBlockAckAgreement *accept(MacAddress peer, Tid tid, int start, int size) {
        auto agreement = new OriginatorBlockAckAgreement(peer, tid, SequenceNumberCyclic(start), size, false, false);
        agreement->setIsAddbaResponseReceived(true);
        blockAckAgreements[{peer, tid}] = agreement;
        return agreement;
    }
};
class SchedulingFrames : public InProgressFrames {
  public:
    Packet *candidate = nullptr;
    void configure(QosAckHandler *handler, IOriginatorMacDataService *service = nullptr) {
        ackHandler = handler;
        dataService = service;
    }
    Packet *peekFrameToTransmit() override { return dataService ? InProgressFrames::peekFrameToTransmit() : candidate; }
    Ptr<const Ieee80211DataHeader> add(MacAddress peer, Tid tid, int sequence, bool sent = true) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(peer);
        header->setTid(tid);
        header->setSequenceNumber(SequenceNumberCyclic(sequence));
        header->setAckPolicy(BLOCK_ACK);
        auto packet = new Packet("data", header);
        take(packet);
        packet->setArrivalTime(simTime());
        inProgressFrames.push_back(packet);
        ackHandler->frameGotInProgress(header);
        if (sent)
            check_and_cast<QosAckHandler *>(ackHandler)->processTransmittedDataOrMgmtFrame(header);
        return header;
    }
};

class EmptyPendingDataService : public OriginatorQosMacDataService {
  public:
    Packet *peekEligibleFrame(queueing::IPacketQueue *) const override { return nullptr; }
};

class FragmentBatchService : public EmptyPendingDataService {
  public:
    std::vector<Packet *> batch;
    std::vector<Packet *> *extractFramesToTransmit(queueing::IPacketQueue *) override {
        if (batch.empty())
            return nullptr;
        auto result = new std::vector<Packet *>();
        result->swap(batch);
        return result;
    }
};

class OrderedPeekFrames : public SchedulingFrames {
  public:
    Packet *peekInProgressFrameToTransmitExcluding(const Packet *excludedFrame, simtime_t time) override {
        for (auto it = inProgressFrames.rbegin(); it != inProgressFrames.rend(); ++it)
            if (*it != excludedFrame && isEligibleToTransmit(*it, time))
                return *it;
        return nullptr;
    }
};
}

%activity:
SchedulingCw cw;
SchedulingRecovery recovery;
cw.configure(15, 63, 3);
recovery.configure(&cw, 3);
auto verifyRecovery = [&](int expectedRetries, int expectedWindow) {
    if (recovery.getStationSrc() != expectedRetries || cw.getCw() != expectedWindow)
        throw cRuntimeError("Expected QSRC %d and CW %d, got QSRC %d and CW %d",
                            expectedRetries, expectedWindow, recovery.getStationSrc(), cw.getCw());
};
recovery.edcaTransmissionFailed();
verifyRecovery(1, 31);
recovery.edcaTransmissionFailed();
verifyRecovery(2, 63);
recovery.edcaTransmissionFailed();
verifyRecovery(3, 63);
recovery.edcaTransmissionFailed();
verifyRecovery(0, 15);

auto shortHeader = makeShared<Ieee80211DataHeader>();
shortHeader->setType(ST_DATA_WITH_QOS);
shortHeader->setTid(5);
shortHeader->setSequenceNumber(SequenceNumberCyclic(1));
auto longHeader = makeShared<Ieee80211DataHeader>(*shortHeader);
longHeader->setSequenceNumber(SequenceNumberCyclic(2));
Packet shortData("short", shortHeader);
shortData.insertAtBack(makeShared<ByteCountChunk>(B(100)));
Packet longData("long", longHeader);
longData.insertAtBack(makeShared<ByteCountChunk>(B(1000)));

recovery.dataFrameTransmissionFailed(&shortData, shortHeader);
verifyRecovery(1, 31);
recovery.dataFrameTransmissionFailed(&longData, longHeader);
verifyRecovery(2, 63);
recovery.ackFrameReceived(&longData, longHeader);
verifyRecovery(2, 63); // This exchange can have a successor in the same TXOP.
recovery.txopCompleted();
verifyRecovery(0, 15);
recovery.edcaTransmissionFailed();
verifyRecovery(1, 31);
if (recovery.getRetryCount(&shortData, shortHeader) != 1)
    throw cRuntimeError("TXOP completion and BAR failure changed the outstanding DATA retry count");
recovery.dropFrame(shortHeader);
if (recovery.hasDataRetry())
    throw cRuntimeError("Both DATA retry entries should have been cleared");

// Resetting the shared window also resets the access-category retry count.
cw.resetCw();
verifyRecovery(0, 15);
recovery.edcaTransmissionFailed();
verifyRecovery(1, 31);
const MacAddress peer("02:00:00:00:00:02");
const MacAddress other("02:00:00:00:00:03");
SchedulingPolicy policy;
SchedulingAgreements agreements;
QosAckHandler ack;
SchedulingFrames frames;
frames.configure(&ack);
agreements.accept(peer, 2, 100, 8);
auto selectedAgreement = agreements.accept(peer, 5, 4094, 4);
auto otherAgreement = agreements.accept(other, 5, 4094, 4);
std::vector<Ptr<const Ieee80211DataHeader>> unrelated;
for (int i = 100; i < 104; i++)
    unrelated.push_back(frames.add(peer, 2, i));
auto selected = frames.add(peer, 5, 4095);
auto wrap = frames.add(peer, 5, 0);
auto outside = frames.add(peer, 5, 2);
auto separatePeer = frames.add(other, 5, 4095);
// A candidate inside TID 2 defers only that group.
frames.add(peer, 2, 104, false);
frames.candidate = frames.getFrames(frames.getLength() - 1);
ASSERT(!policy.isBlockAckReqNeeded(&frames, nullptr, nullptr));
ASSERT(std::get<2>(policy.computeBlockAckReqParameters(&frames, nullptr, nullptr)) == -1);
auto choice = policy.computeBlockAckReqParameters(&frames, nullptr, &agreements);
ASSERT(std::get<0>(choice) == peer && std::get<2>(choice) == 5);
ASSERT(std::get<1>(choice) == SequenceNumberCyclic(4095));
ASSERT(selectedAgreement->containsSequence(SequenceNumberCyclic(1)));
ASSERT(!selectedAgreement->containsSequence(SequenceNumberCyclic(2)));
auto bar = makeShared<Ieee80211BasicBlockAckReq>();
bar->setReceiverAddress(peer);
bar->setTidInfo(5);
bar->setStartingSequenceNumber(SequenceNumberCyclic(4095));
ack.processTransmittedBlockAckReq(bar, selectedAgreement);
ASSERT(ack.getQoSDataAckStatus(selected) == QosAckHandler::Status::WAITING_FOR_BLOCK_ACK);
ASSERT(ack.getQoSDataAckStatus(wrap) == QosAckHandler::Status::WAITING_FOR_BLOCK_ACK);
for (auto header : unrelated)
    ASSERT(ack.getQoSDataAckStatus(header) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
ASSERT(ack.getQoSDataAckStatus(outside) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
ASSERT(ack.getQoSDataAckStatus(separatePeer) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
ack.processFailedBlockAckReq(bar);
ASSERT(ack.isEligibleToTransmit(selected));
ASSERT(ack.isEligibleToTransmit(wrap));
ASSERT(ack.getQoSDataAckStatus(separatePeer) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
frames.candidate = nullptr;
choice = policy.computeBlockAckReqParameters(&frames, nullptr, &agreements);
ASSERT(std::get<0>(choice) == peer && std::get<2>(choice) == 2);
ASSERT(std::get<1>(choice) == SequenceNumberCyclic(100));
ASSERT(otherAgreement->getStartingSequenceNumber() == SequenceNumberCyclic(4094));
{
    QosAckHandler batchAck;
    FragmentBatchService service;
    OrderedPeekFrames orderedFrames;
    orderedFrames.configure(&batchAck, &service);
    auto currentHeader = orderedFrames.add(peer, 5, 10, false);
    auto current = orderedFrames.getFrames(0);
    for (int fragment = 0; fragment < 2; fragment++) {
        auto header = makeShared<Ieee80211DataHeader>(*currentHeader);
        header->setSequenceNumber(SequenceNumberCyclic(11));
        header->setFragmentNumber(fragment);
        header->setMoreFragments(fragment == 0);
        service.batch.push_back(new Packet("fragment", header));
    }
    auto first = service.batch.front();
    auto preferred = service.batch.back();
    ASSERT(orderedFrames.getPendingFrameFor(current, false) == nullptr);
    ASSERT(orderedFrames.getLength() == 1);
    auto successor = orderedFrames.getPendingFrameFor(current);
    ASSERT(service.batch.empty() && orderedFrames.getLength() == 3);
    ASSERT(successor == preferred);
    batchAck.processTransmittedDataOrMgmtFrame(currentHeader);
    ASSERT(orderedFrames.peekFrameToTransmit() == preferred);
    ASSERT(orderedFrames.peekFrameToTransmitExcluding(preferred) == first);
    ASSERT(orderedFrames.getFrameToTransmit() == successor);
    for (auto frame : {current, first, preferred})
        orderedFrames.dropFrame(frame);
    orderedFrames.clearDroppedFrames();
}
{
    QosAckHandler timedAck;
    EmptyPendingDataService emptyPending;
    EdcaTransmitLifetimeHandler lifetime(1, 1, 1, 1);
    SchedulingFrames timedFrames;
    timedFrames.configure(&timedAck, &emptyPending);
    timedFrames.setLifetimeHandler(&lifetime);
    timedFrames.add(peer, 5, 10, false);
    timedFrames.add(peer, 5, 11);
    timedFrames.add(peer, 5, 12, false);
    auto first = timedFrames.getFrames(0);
    auto last = timedFrames.getFrames(2);
    auto deadline = simTime() + SimTime(1, SIMTIME_US);
    lifetime.registerFragments({first}, deadline);
    ASSERT(timedFrames.peekFrameToTransmit() == first);
    ASSERT(timedFrames.peekInProgressFrameToTransmitExcluding(nullptr, deadline - SimTime(1, SIMTIME_NS)) == first);
    ASSERT(timedFrames.peekInProgressFrameToTransmitExcluding(first, simTime()) == last);
    ASSERT(timedFrames.peekInProgressFrameToTransmitExcluding(nullptr, deadline) == last);
    ASSERT(timedFrames.peekInProgressFrameToTransmitExcluding(last, deadline) == nullptr);
    ASSERT(timedFrames.getLength() == 3);
    lifetime.forgetFrame(first->getId());
}
for (bool hasSuccessor : {false, true}) {
    QosAckHandler forecastAck;
    EmptyPendingDataService emptyPendingData;
    SchedulingFrames forecastFrames;
    forecastFrames.configure(&forecastAck, &emptyPendingData);
    auto data = forecastFrames.add(peer, 2, 100, false);
    auto transmitting = forecastFrames.getFrames(0);
    if (hasSuccessor)
        forecastFrames.add(peer, 2, 101, false);

    TxopProcedure txop;
    const IOriginatorQoSAckPolicy& forecastPolicy = policy;
    auto forecast = forecastPolicy.computeBlockAckReqParametersAfterData(&forecastFrames, &txop, &agreements, transmitting, simTime());
    ASSERT(forecastAck.getQoSDataAckStatus(data) == QosAckHandler::Status::FRAME_NOT_YET_TRANSMITTED);
    ASSERT(forecastFrames.getOutstandingFrames().empty());
    ASSERT(forecastFrames.getLength() == (hasSuccessor ? 2 : 1));
    ASSERT(forecastFrames.peekFrameToTransmit() == transmitting);
    forecastAck.processTransmittedDataOrMgmtFrame(data);
    ASSERT(forecast == forecastPolicy.computeBlockAckReqParameters(&forecastFrames, &txop, &agreements));
    if (hasSuccessor)
        ASSERT(std::get<2>(forecast) == -1);
    else
        ASSERT(forecast == std::make_tuple(peer, SequenceNumberCyclic(100), Tid(2)));
}
for (int start : {100, 4094}) {
    for (int responseOffset : {0, 6, 100}) {
        QosAckHandler compressedAck;
        SchedulingFrames compressedFrames;
        compressedFrames.configure(&compressedAck);
        OriginatorBlockAckAgreement active(peer, 5, SequenceNumberCyclic(start), 64, false, false);
        auto earlier = compressedFrames.add(peer, 5, (start + 2) % 4096);
        auto requested = compressedFrames.add(peer, 5, (start + 4) % 4096);
        auto unsent = compressedFrames.add(peer, 5, (start + 5) % 4096, false);
        auto outsideWindow = compressedFrames.add(peer, 5, (start + 64) % 4096);
        auto otherTid = compressedFrames.add(peer, 2, (start + 2) % 4096);
        auto request = makeShared<Ieee80211CompressedBlockAckReq>();
        request->setReceiverAddress(peer);
        request->setTidInfo(5);
        request->setStartingSequenceNumber(SequenceNumberCyclic(start) + 4);
        compressedAck.processTransmittedBlockAckReq(request, &active);
        ASSERT(compressedAck.getQoSDataAckStatus(earlier) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
        ASSERT(compressedAck.getQoSDataAckStatus(requested) == QosAckHandler::Status::WAITING_FOR_BLOCK_ACK);
        auto response = makeShared<Ieee80211CompressedBlockAck>();
        response->setTransmitterAddress(peer);
        response->setTidInfo(5);
        response->setStartingSequenceNumber(SequenceNumberCyclic(start) + responseOffset);
        BitVector bitmap;
        for (int bit = 0; bit < 64; bit++)
            bitmap.appendBit(responseOffset == 0 && (bit == 2 || bit == 5));
        response->setBlockAckBitmap(bitmap);
        compressedAck.processReceivedCompressedBlockAck(response, &active);
        ASSERT(compressedAck.getQoSDataAckStatus(earlier) == (responseOffset == 0 ?
            QosAckHandler::Status::BLOCK_ACK_ARRIVED_ACKED : QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED));
        ASSERT(compressedAck.isEligibleToTransmit(requested));
        ASSERT(compressedAck.getQoSDataAckStatus(unsent) == QosAckHandler::Status::FRAME_NOT_YET_TRANSMITTED);
        ASSERT(compressedAck.getQoSDataAckStatus(otherTid) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
        ASSERT(compressedAck.getQoSDataAckStatus(outsideWindow) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
        response->setStartingSequenceNumber(SequenceNumberCyclic(start) + 4);
        BitVector outsideBitmap;
        for (int bit = 0; bit < 64; bit++)
            outsideBitmap.appendBit(bit == 60);
        response->setBlockAckBitmap(outsideBitmap);
        compressedAck.processReceivedCompressedBlockAck(response, &active);
        ASSERT(compressedAck.getQoSDataAckStatus(outsideWindow) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
    }
}
auto duration = SimTime(1, SIMTIME_US);
EdcaTransmitLifetimeHandler lifetime(duration, duration, duration, duration);
frames.setLifetimeHandler(&lifetime);
for (int i = 0; i < frames.getLength(); i++)
    lifetime.registerFrame(frames.getFrames(i), AC_VI);
ASSERT(policy.isBlockAckReqNeeded(&frames, nullptr, &agreements));
wait(duration);
ASSERT(!policy.isBlockAckReqNeeded(&frames, nullptr, &agreements));
ASSERT(ack.getQoSDataAckStatus(unrelated.front()) == QosAckHandler::Status::BLOCK_ACK_NOT_YET_REQUESTED);
std::cout << "Block Ack scheduling isolation assertions passed.\n";

%contains: stdout
Block Ack scheduling isolation assertions passed.
