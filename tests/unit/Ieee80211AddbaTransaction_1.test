{
    auto makeAggregatePacket = [&](const char *name, SequenceNumberCyclic sequenceNumber) {
        auto header = makeQosHeader(peer1, 1, sequenceNumber);
        header->setTransmitterAddress(peer2);
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(8)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        return packet;
    };
