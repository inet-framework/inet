%description:
Basic Block Ack receipt history distinguishes missing fragments from retired sequence positions, including across wrap.

%includes:
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckAgreement.h"
using namespace inet;
using namespace inet::ieee80211;

%activity:
const MacAddress peer("02:00:00:00:00:01");
SequenceNumberCyclic start(4093);
RecipientBlockAckAgreement agreement(peer, 0, start, 64, SIMTIME_ZERO);
auto record = agreement.getBlockAckRecord();

bool emptyRecordHasNoReceipts = !record->getAckState(start, 0) &&
    !record->getAckState(start + 1, 0) && !record->getAckState(start + 3, 0);
bool retiredPositionIsAcknowledged = record->getAckState(start - 1, 0);

for (int offset : {0, 2, 3}) {
    auto received = makeShared<Ieee80211DataHeader>();
    received->setSequenceNumber(start + offset);
    received->setFragmentNumber(1);
    record->blockAckPolicyFrameReceived(received);
}
ASSERT(!record->getAckState(start + 1, 1)); // 4094 is a hole before 4095 and 0.
ASSERT(emptyRecordHasNoReceipts);
ASSERT(retiredPositionIsAcknowledged);
ASSERT(record->getAckState(start + 2, 1));
ASSERT(record->getAckState(start + 3, 1));
ASSERT(!record->getAckState(start + 3, 0));

record->removeAckStates(start + 3);
ASSERT(record->getAckState(start + 2, 0)); // 4095 is now before the retained range.
ASSERT(!record->getAckState(start + 3, 0)); // Sequence 0 is still tracked by fragment.
ASSERT(record->getAckState(start + 3, 1));
record->removeAckStates(start + 2);
ASSERT(record->getAckState(start + 2, 0)); // A stale boundary cannot move it backward.
ASSERT(!record->getAckState(start + 4, 0));

EV << "Basic Block Ack receipt boundaries passed.\n";

%contains: stdout
Basic Block Ack receipt boundaries passed.
