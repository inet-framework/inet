%description:
Check bounded chunk traversal without a production caller.
Cover lengths, alignment, truncation, final padding, and delimiter error flags.

%includes:
#include <tuple>
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/common/packet/chunk/SequenceChunk.h"
#include "inet/linklayer/ieee80211/mac/aggregation/MpduDeaggregation.h"

using namespace inet;
using namespace inet::ieee80211;

%global:
static void appendMember(Packet& packet, int length)
{
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(length);
    packet.insertAtBack(delimiter);
    if (length)
        packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(length, 0)));
}

// These tuples record callbacks for assertions. Production traversal stores no layout.
static auto inspect(const Packet *packet, B offset, B length)
{
    std::vector<std::tuple<bool, B, B, bool>> chunks;
    bool complete = MpduDeaggregation::visitSubframes(packet, offset, length,
            [&](const auto& delimiter, B position, bool valid) {
                chunks.emplace_back(true, position, B(delimiter->getChunkLength()), valid);
            },
            [&](const auto& mpdu, B position) {
                chunks.emplace_back(false, position, B(mpdu->getChunkLength()), true);
            });
    return std::make_pair(complete, chunks);
}

%activity:
for (int length : {0, 1, 2, 3, 4, 4095}) {
    Packet packet("layout");
    appendMember(packet, 0);
    appendMember(packet, length);
    if (length) {
        int padding = (4 - length % 4) % 4;
        if (padding)
            packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(padding, 0)));
        appendMember(packet, 20);
    }
    auto result = inspect(&packet, B(0), B(packet.getDataLength()));
    ASSERT(result.first);
    ASSERT(result.second.size() == (length ? 5 : 2));
    ASSERT(std::get<0>(result.second.front()));
    for (const auto& chunk : result.second)
        ASSERT(std::get<1>(chunk) + std::get<2>(chunk) <= packet.getDataLength());
    auto bytes = packet.peekAllAsBytes()->getBytes();
    Packet independent("wire", makeShared<BytesChunk>(bytes));
    ASSERT(inspect(&independent, B(0), B(bytes.size())) == result);
    if (length) {
        bytes.pop_back();
        Packet truncated("truncated", makeShared<BytesChunk>(bytes));
        ASSERT(!inspect(&truncated, B(0), B(bytes.size())).first);
    }
}
auto incorrectDelimiter = makeShared<Ieee80211MpduSubframeHeader>();
incorrectDelimiter->setLength(0);
incorrectDelimiter->markIncorrect();
Packet incorrect("incorrect-delimiter", incorrectDelimiter);
appendMember(incorrect, 20);
auto incorrectResult = inspect(&incorrect, B(0), B(incorrect.getDataLength()));
ASSERT(!incorrectResult.first && !std::get<3>(incorrectResult.second.front()));
for (int byte : {2, 3}) {
    Packet good("good");
    appendMember(good, 20);
    auto bytes = good.peekAllAsBytes()->getBytes();
    bytes[byte] ^= 1;
    Packet bad("bad", makeShared<BytesChunk>(bytes));
    auto result = inspect(&bad, B(0), B(bytes.size()));
    ASSERT(!result.first && !std::get<3>(result.second.front()));
}
Packet finalPadding("final-padding");
appendMember(finalPadding, 1);
finalPadding.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(3, 0)));
ASSERT(!inspect(&finalPadding, B(0), B(finalPadding.getDataLength())).first);
auto overrun = makeShared<Ieee80211MpduSubframeHeader>();
overrun->setLength(4095);
Packet missingMember("missing-member", overrun);
auto refused = inspect(&missingMember, B(0), B(4));
ASSERT(!refused.first && refused.second.size() == 1 && !std::get<3>(refused.second.front()));
for (int size : {0, 1, 2, 3}) {
    Packet shortInput("short", makeShared<BytesChunk>(std::vector<uint8_t>(size, 0)));
    ASSERT(inspect(&shortInput, B(0), B(size)).second.empty());
}
auto tooLong = makeShared<Ieee80211MpduSubframeHeader>();
tooLong->setLength(4096);
Packet overflow("overflow", tooLong);
bool refusedEncoding = false;
try { overflow.peekAllAsBytes(); }
catch (const cRuntimeError&) { refusedEncoding = true; }
ASSERT(refusedEncoding);
Packet recovery("recovery", makeShared<BytesChunk>(std::vector<uint8_t>{0, 0, 0, 0}));
appendMember(recovery, 20);
auto recovered = inspect(&recovery, B(0), B(recovery.getDataLength()));
ASSERT(!recovered.first && recovered.second.size() == 3);
ASSERT(!std::get<3>(recovered.second[0]) && std::get<1>(recovered.second[1]) == B(4));
for (int prefixLength : {0, 6}) {
    Packet typed("typed-recovery");
    if (prefixLength)
        typed.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(prefixLength, 0)));
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(2000);
    typed.insertAtBack(delimiter);
    auto member = makeShared<Ieee80211DataHeader>();
    member->setSequenceNumber(SequenceNumberCyclic(0));
    typed.insertAtBack(member);
    typed.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(100 - member->getChunkLength().get<B>(), 0)));
    appendMember(typed, 20);
    auto bytes = typed.peekAllAsBytes()->getBytes();
    Packet independent("byte-recovery", makeShared<BytesChunk>(bytes));
    auto typedResult = inspect(&typed, B(prefixLength), B(128));
    auto byteResult = inspect(&independent, B(prefixLength), B(128));
    ASSERT(!typedResult.first && typedResult == byteResult);
    const auto& last = typedResult.second.back();
    ASSERT(!std::get<0>(last) && std::get<3>(last) && std::get<1>(last) == B(108) && std::get<2>(last) == B(20));
}
ASSERT(!std::get<0>(incorrectResult.second.back()) && std::get<3>(incorrectResult.second.back()));
Packet originalRaw("original-raw");
appendMember(originalRaw, 20);
appendMember(originalRaw, 20);
auto rawBytes = originalRaw.peekAllAsBytes()->getBytes();
auto failedBytes = makeShared<BytesChunk>(rawBytes);
failedBytes->markIncorrect();
Packet failedRaw("failed-raw", failedBytes);
for (int front : {0, 4}) {
    failedRaw.setFrontOffset(B(front));
    auto result = inspect(&failedRaw, B(0), B(failedRaw.getDataLength()));
    ASSERT(!result.first);
    for (const auto& entry : result.second)
        ASSERT(std::get<0>(entry) && !std::get<3>(entry));
}
Packet mixed("mixed", failedBytes);
appendMember(mixed, 20);
auto mixedResult = inspect(&mixed, B(0), B(mixed.getDataLength()));
ASSERT(!mixedResult.first);
ASSERT(!std::get<0>(mixedResult.second.back()) && std::get<1>(mixedResult.second.back()) == B(52));
auto badRegion = makeShared<BytesChunk>(std::vector<uint8_t>(rawBytes.begin() + 4, rawBytes.begin() + 28));
badRegion->markIncorrect();
auto regions = makeShared<SequenceChunk>();
regions->setChunks({makeShared<BytesChunk>(std::vector<uint8_t>(rawBytes.begin(), rawBytes.begin() + 4)),
        badRegion, makeShared<BytesChunk>(std::vector<uint8_t>(rawBytes.begin() + 28, rawBytes.end()))});
Packet crossing("crossing", regions);
int failedMembers = 0;
bool complete = MpduDeaggregation::visitSubframes(&crossing, B(0), B(48),
        [](const auto&, B, bool) {},
        [&](const auto& mpdu, B offset) {
            ASSERT(offset == B(4) && mpdu->isIncorrect());
            failedMembers++;
        });
ASSERT(!complete && failedMembers == 1);
EV << "MPDU traversal checks passed\n";

%contains: stdout
MPDU traversal checks passed
