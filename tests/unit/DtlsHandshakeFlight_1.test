%description:
ACKs identify actually handed-off records and acknowledge their retained ranges.
Reserved-only records cannot complete a flight; retransmission suppresses RTT samples.

%includes:
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/common/packet/chunk/BitCountChunk.h"
#include "inet/transportlayer/dtls/DtlsHandshakeFlight.h"

using namespace inet;
using namespace inet::dtls;

%activity:
auto bytes = makeShared<BytesChunk>(std::vector<uint8_t>{1, 2});
bytes->markImmutable();
DtlsHandshakeFlight flight;
auto mutableBytes = makeShared<BytesChunk>(std::vector<uint8_t>{9});
bool mutableRejected = false;
try { flight.add(11, 1, 1, 0, 2, mutableBytes); }
catch (const cRuntimeError&) { mutableRejected = true; }
ASSERT(mutableRejected && flight.size() == 0);
auto bits = makeShared<BitCountChunk>(b(1));
bits->markImmutable();
bool unalignedRejected = false;
try { flight.add(11, 1, 1, 0, 2, bits); }
catch (const cRuntimeError&) { unalignedRejected = true; }
ASSERT(unalignedRejected && flight.size() == 0);
bool overlongRejected = false;
try { flight.add(11, 1, 0x1000000, 0, 2, bytes); }
catch (const cRuntimeError&) { overlongRejected = true; }
ASSERT(overlongRejected && flight.size() == 0);
auto first = flight.add(11, 2, 4, 0, 2, bytes);
auto second = flight.add(11, 2, 4, 2, 2, bytes);
ASSERT(!flight.reserve(first));
flight.markReady(first);
flight.markReady(second);
ASSERT(flight.reserve(first) && flight.reserve(second));
ASSERT(!flight.acknowledge(2, 10, SimTime(1)).matched);
ASSERT(!flight.isComplete());
flight.handedOff(first, 10, SimTime(0.25));
flight.handedOff(second, 11, SimTime(0.5));
ASSERT(!flight.acknowledge(3, 10, SimTime(0.75)).matched);
auto firstAck = flight.acknowledge(2, 10, SimTime(0.75));
ASSERT(firstAck.matched && !firstAck.flightComplete);
ASSERT(!firstAck.rtt);
ASSERT(flight.get(first).acknowledged && !flight.get(second).acknowledged);
ASSERT(!flight.acknowledge(2, 10, SimTime(1)).matched);
flight.requestRetransmission();
ASSERT(!flight.reserve(first) && flight.reserve(second));
flight.cancelReservation(second);
ASSERT(flight.reserve(second));
flight.handedOff(second, 12, SimTime(1));
auto lateOriginalAck = flight.acknowledge(2, 11, SimTime(1.5));
ASSERT(lateOriginalAck.matched && lateOriginalAck.flightComplete);
ASSERT(!lateOriginalAck.rtt);
ASSERT(!flight.acknowledge(2, 12, SimTime(1.75)).matched);
ASSERT(flight.isComplete());
DtlsHandshakeFlight empty;
ASSERT(empty.size() == 0 && !empty.isComplete());
ASSERT(!empty.acknowledge(2, 10, SimTime(2)).matched);

DtlsHandshakeFlight partial;
first = partial.add(11, 3, 4, 0, 2, bytes);
second = partial.add(11, 3, 4, 2, 2, bytes);
partial.markReady(first);
partial.markReady(second);
ASSERT(partial.reserve(first) && partial.reserve(second));
partial.handedOff(first, 20, SimTime(2));
auto implicitAck = partial.acknowledgeSent(SimTime(2.25));
ASSERT(implicitAck.matched && !implicitAck.flightComplete);
ASSERT(!implicitAck.rtt);
ASSERT(!partial.get(second).acknowledged);
partial.cancelReservation(second);
ASSERT(partial.reserve(second));
ASSERT(!partial.acknowledge(2, 21, SimTime(2.5)).matched);

DtlsHandshakeFlight eligible;
first = eligible.add(11, 4, 4, 0, 2, bytes);
second = eligible.add(11, 4, 4, 2, 2, bytes);
eligible.markReady(first);
eligible.markReady(second);
ASSERT(eligible.reserve(first) && eligible.reserve(second));
eligible.handedOff(first, 30, SimTime(3));
eligible.handedOff(second, 31, SimTime(3.25));
ASSERT(!eligible.acknowledge(2, 31, SimTime(3.5)).rtt);
auto completeMessage = eligible.acknowledge(2, 30, SimTime(3.75));
ASSERT(completeMessage.matched && completeMessage.flightComplete);
ASSERT(completeMessage.rtt && *completeMessage.rtt == SimTime(0.5));
ASSERT(!eligible.acknowledge(2, 30, SimTime(4)).rtt);

auto six = makeShared<BytesChunk>(std::vector<uint8_t>{1,2,3,4,5,6});
six->markImmutable();
DtlsHandshakeFlight split;
auto original = split.add(11, 9, 6, 0, 3, six);
split.markReady(original);
ASSERT(split.reserve(original));
split.handedOff(original, 50, SimTime(5));
ASSERT(split.refragment(2) && split.size() == 4 && split.get(original).superseded);
ASSERT(!split.reserve(original));
for (size_t i = 1; i < 4; ++i) {
    ASSERT(split.get(i).offset == (i - 1) * 2 && split.get(i).messageSequence == 9 && split.get(i).messageLength == 6);
    ASSERT(split.reserve(i));
}
split.handedOff(1, 51, SimTime(5.1));
ASSERT(split.acknowledge(3, 51, SimTime(5.2)).matched && !split.isComplete());
ASSERT(split.get(1).acknowledged && !split.get(2).acknowledged);
auto preSplitAck = split.acknowledge(3, 50, SimTime(5.3));
ASSERT(preSplitAck.matched && preSplitAck.flightComplete && !preSplitAck.rtt);
ASSERT(split.get(2).acknowledged && split.get(3).acknowledged);
split.cancelReservation(2);
split.cancelReservation(3);
ASSERT(!split.reserve(2) && !split.reserve(3) && !split.acknowledge(3, 50, SimTime(5.4)).matched);

DtlsHandshakeFlight pendingGeneration;
original = pendingGeneration.add(11, 10, 6, 0, 3, six);
ASSERT(pendingGeneration.refragment(2));
ASSERT(pendingGeneration.refragment(1));
pendingGeneration.markReady(original); // The original queued logical operation completes after both splits.
size_t leaves = 0;
for (size_t i = 0; i < pendingGeneration.size(); ++i)
    if (!pendingGeneration.get(i).superseded) {
        ASSERT(pendingGeneration.get(i).ready && pendingGeneration.get(i).data->getChunkLength() == B(1));
        ASSERT(pendingGeneration.reserve(i));
        pendingGeneration.handedOff(i, 100 + leaves++, SimTime(6));
    }
ASSERT(leaves == 6 && !pendingGeneration.acknowledge(3, 50, SimTime(6.1)).matched);
for (size_t i = 0; i < leaves; ++i)
    ASSERT(pendingGeneration.acknowledge(3, 100 + i, SimTime(6.2)).matched);
ASSERT(pendingGeneration.isComplete());
DtlsHandshakeFlight ordered;
original = ordered.add(11, 11, 6, 0, 3, six);
auto verifyIndex = ordered.add(15, 12, 2, 0, 3, bytes);
ordered.markReady(original); ordered.markReady(verifyIndex);
ASSERT(ordered.reserve(original) && ordered.reserve(verifyIndex));
ASSERT(ordered.refragment(2) && !ordered.isFirstTransmissionOrdered(verifyIndex));
ordered.cancelReservation(verifyIndex);
ASSERT(!ordered.reserve(verifyIndex));
for (size_t i = 2; i < ordered.size(); ++i) {
    ASSERT(ordered.reserve(i));
    ordered.handedOff(i, 200 + i, SimTime(7));
}
ASSERT(ordered.isFirstTransmissionOrdered(verifyIndex) && ordered.reserve(verifyIndex));
EV << "DTLS handshake flight PASS\n";

%contains: stdout
DTLS handshake flight PASS
