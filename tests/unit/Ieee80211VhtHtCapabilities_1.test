%description:
Verify production MAC assembly for inherited HT modes in the ac catalog.
Operational width 20 MHz excludes HT40 and its short GI capability.
Stream limits 1, 2, 3, 4, and 8 expose exact MCS sets through MCS 31.
The fixture uses configured radio antennas and receiver contributions; no frames are exchanged.

%includes:
// Author: Miguel González-López
#include <algorithm>
#include "inet/linklayer/ieee80211/mib/Ieee80211Mib.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Receiver.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

%global:
class Ht20Receiver : public Ieee80211Receiver
{
  public:
    bool isHtChannelWidthSupported(Hz width) const override { return width == MHz(20); }
    bool isHtShortGuardIntervalSupported(Hz width) const override { return width == MHz(20); }
};
Define_Module(Ht20Receiver);

%file: TestNetwork.ned
import inet.node.wireless.AccessPoint;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211Receiver;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;
module Ht20Receiver extends Ieee80211Receiver { parameters: @class(Ht20Receiver); }
network TestNetwork
{
    submodules:
        radioMedium: Ieee80211ScalarRadioMedium;
        ap[5]: AccessPoint;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
ned-path = .;../../../../src;../../lib
seed-set = 0
record-vector-results = false
record-scalar-results = false
**.wlan[*].mgmt.typename = "Ieee80211MgmtApSimplified"
**.wlan[*].opMode = "ac"
**.wlan[*].radio.receiver.typename = "Ht20Receiver"
*.ap[0].wlan[*].radio.antenna.numAntennas = 1
*.ap[1].wlan[*].radio.antenna.numAntennas = 2
*.ap[2].wlan[*].radio.antenna.numAntennas = 3
*.ap[3].wlan[*].radio.antenna.numAntennas = 4
*.ap[4].wlan[*].radio.antenna.numAntennas = 8
**.wlan[*].radio.bandName = "5 GHz (mapped 20 MHz)"
**.wlan[*].radio.channelNumber = 0
**.wlan[*].bitrate = 6Mbps
**.wlan[*].radio.transmitter.power = 100mW
**.wlan[*].radio.receiver.sensitivity = -85dBm
**.wlan[*].radio.receiver.snirThreshold = 4dB
**.mobility.initFromDisplayString = false
**.mobility.initialX = 10m
**.mobility.initialY = 10m
**.mobility.initialZ = 0m

%activity:
int index = 0;
for (int streamLimit : {1, 2, 3, 4, 8}) {
    auto path = std::string("ap[") + std::to_string(index++) + "].wlan[0].mib";
    auto mib = check_and_cast<Ieee80211Mib *>(getModuleByPath(path.c_str()));
    ASSERT(mib->isLocalHtCapable());
    const auto& capabilities = mib->getLocalHtCapabilities();
    int supportedStreams = std::min(streamLimit, 4);
    ASSERT(capabilities.supportedChannelWidths.size() == 1);
    ASSERT(capabilities.supportedChannelWidths.count(MHz(20)) == 1);
    ASSERT(capabilities.supportedChannelWidths.count(MHz(40)) == 0);
    ASSERT(capabilities.shortGi20);
    ASSERT(!capabilities.shortGi40);
    ASSERT(capabilities.txMcsSetDefined);
    ASSERT(!capabilities.txRxMcsSetNotEqual);
    for (int mcs = 0; mcs < 77; mcs++) {
        ASSERT(capabilities.rxMcsSupported[mcs] == (mcs < 8 * supportedStreams));
        ASSERT(mib->getHtOperation().basicMcsSupported[mcs] == (mcs < 8));
    }
    for (int stream = 0; stream < 4; stream++)
        ASSERT(capabilities.txMcsNss.maxMcsPerNss[stream] == (stream < supportedStreams ? 7 : -1));
    ASSERT(mib->getHtOperation().operatingChannelWidth == MHz(20));
    ASSERT(mib->getHtOperation().secondaryChannelOffset == 0);
}
EV << "VHT catalog HT capability assembly checks passed.\n";

%contains: stdout
VHT catalog HT capability assembly checks passed.
