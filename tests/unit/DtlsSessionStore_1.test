%description:
DTLS session storage shares a bounded capacity between client and server roles,
expires at the boundary, preserves original expiry on duplicate delivery, and
selects only a compatible peer context.

%includes:
#include "../DtlsTestAssertions.h"
#include "inet/transportlayer/dtls/DtlsSessionStore.h"
using namespace inet;
using namespace inet::dtls;

%activity:
DtlsSessionStore store;
DtlsSessionStore::Entry a;
a.ticket = {1};
a.peerIdentity = "peer";
a.peerPort = 4433;
a.issuedAt = 0;
a.expiresAt = 10;
DTLS_TEST_CHECK(!store.insert(a, 0));
store.configure(2);
DTLS_TEST_CHECK(store.insert(a, 0));
auto duplicate = a;
duplicate.expiresAt = 100;
DTLS_TEST_CHECK(!store.insert(duplicate, 1));
duplicate.peerCertificateAuthenticated = true;
duplicate.authenticatedPeerIdentity = "new identity";
DTLS_TEST_CHECK(!store.insert(duplicate, 1));
DTLS_TEST_CHECK(!store.find({1}, false, 1)->peerCertificateAuthenticated && store.find({1}, false, 1)->authenticatedPeerIdentity.empty());
DTLS_TEST_CHECK(store.find({1}, false, 9)->expiresAt == SimTime(10));
DTLS_TEST_CHECK(!store.find({1}, true, 0));
DTLS_TEST_CHECK(!store.find({1}, false, 10));
DTLS_TEST_CHECK(store.select(L3Address(), 4433, "peer", 0xfefc, 9));
DTLS_TEST_CHECK(!store.select(L3Address(), 4434, "peer", 0xfefc, 9));
DTLS_TEST_CHECK(!store.select(L3Address(), 4433, "other", 0xfefc, 9));
DTLS_TEST_CHECK(!store.select(L3Address(), 4433, "peer", 0xfefd, 9));
auto b = a;
b.ticket = {2};
b.serverSide = true;
DTLS_TEST_CHECK(store.insert(b, 0));
auto c = a;
c.ticket = {3};
DTLS_TEST_CHECK(store.insert(c, 0));
DTLS_TEST_CHECK(store.size() == 2);
DTLS_TEST_CHECK(!store.find({1}, false, 0));
DTLS_TEST_CHECK(store.find({2}, true, 0));
DTLS_TEST_CHECK(store.select(L3Address(), 4433, "peer", 0xfefc, 0)->ticket == c.ticket);
c.ticket = {4};
c.expiresAt = 20;
DTLS_TEST_CHECK(store.insert(c, 10));
DTLS_TEST_CHECK(store.size() == 1); // expired entries release both roles' capacity
store.clear();
DTLS_TEST_CHECK(store.size() == 0 && !store.find({4}, false, 10));
auto early = a;
early.ticket = {5};
early.serverSide = true;
early.earlyDataBytes = 64;
std::vector<uint8_t> random(32, 0x11);
DTLS_TEST_CHECK(store.insert(early, 0));
DTLS_TEST_CHECK(store.consumeEarly({5}, random, 7, 0));
DTLS_TEST_CHECK(store.consumeEarly({5}, random, 7, 1)); // same live owning attempt
DTLS_TEST_CHECK(!store.consumeEarly({5}, random, 8, 1)); // replacement cannot reuse admission
random[0] = 0x22;
DTLS_TEST_CHECK(!store.consumeEarly({5}, random, 7, 1));
DTLS_TEST_CHECK(store.find({5}, true, 1)->earlyConsumed);
DTLS_TEST_CHECK(!store.insert(early, 1)); // duplicate issuance cannot restore admission
DTLS_TEST_CHECK(!store.consumeEarly({5}, random, 8, 1));
DTLS_TEST_CHECK(!store.consumeEarly({5}, random, 7, 10)); // exact expiry
store.configure(1);
DTLS_TEST_CHECK(store.insert(early, 0));
DTLS_TEST_CHECK(store.consumeEarly({5}, random, 7, 0));
early.ticket = {6};
DTLS_TEST_CHECK(store.insert(early, 0));
DTLS_TEST_CHECK(!store.consumeEarly({5}, random, 8, 1)); // evicted identity is unknown
DTLS_TEST_CHECK(store.consumeEarly({6}, random, 8, 1));
store.clear();
DTLS_TEST_CHECK(!store.consumeEarly({6}, random, 9, 1));
store.configure(2);
a.ticket = {7}; a.hashBytes = 32;
DTLS_TEST_CHECK(store.insert(a, 0));
a.ticket = {8}; a.hashBytes = 48;
DTLS_TEST_CHECK(store.insert(a, 0));
DTLS_TEST_CHECK(store.select(L3Address(), 4433, "peer", 0xfefc, 0, {32})->ticket == std::vector<uint8_t>{7});
DTLS_TEST_CHECK(store.select(L3Address(), 4433, "peer", 0xfefc, 0, {48})->ticket == std::vector<uint8_t>{8});
DTLS_TEST_CHECK(!store.select(L3Address(), 4433, "peer", 0xfefc, 0, {64}));
EV << "DTLS session store PASS\n";

%contains: stdout
DTLS session store PASS
