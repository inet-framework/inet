%description:
PB94-SELECT, PB94-LOSS: independent choice trace and arithmetic boundaries.
Model profile: fixed network-order encoding oracle and atomic input validation.

%includes:
#include "inet/routing/dsdv/DsdvTable.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
using namespace inet;
using namespace inet::dsdv;

%global:
static DsdvEntry entry(const char *address, uint64_t sequence, uint32_t metric)
{
    DsdvEntry e; e.destination = Ipv4Address(address); e.sequence = sequence; e.metric = metric; return e;
}
static Ptr<DsdvHeader> update(const char *sender, std::vector<DsdvEntry> entries)
{
    auto h = makeShared<DsdvHeader>(); h->setSender(Ipv4Address(sender));
    h->setEntriesArraySize(entries.size()); h->setChunkLength(B(16 + 16 * entries.size()));
    for (size_t i = 0; i < entries.size(); i++) h->setEntries(i, entries[i]);
    return h;
}

%activity:
DsdvTable table;
table.configure(Ipv4Address("10.0.0.1"), 1, 10, 12); table.start(0);
auto destination = Ipv4Address("10.0.0.4");
auto accept = [&](const char *sender, uint64_t seq, uint32_t metric, double time) {
    table.receive(*update(sender, {entry("10.0.0.4", seq, metric)}), SimTime(time));
};
accept("10.0.0.2", 10, 1, .1);
accept("10.0.0.3", 8, 0 + 1, .2);
ASSERT(table.getRouteEntries().at(destination).current.sequence == 10);
accept("10.0.0.3", 12, 3, .3);
ASSERT(table.getRouteEntries().at(destination).current.metric == 4);
accept("10.0.0.2", 12, 1, .4);
accept("10.0.0.3", 12, 1, .5);
accept("10.0.0.2", 12, 2, .6);
const auto& r = table.getRouteEntries().at(destination);
ASSERT(r.current.metric == 2 && r.successor == Ipv4Address("10.0.0.2"));
ASSERT(r.refreshed == SimTime(.4));
ASSERT(table.invalidate(destination, .7));
ASSERT(!table.invalidate(destination, .8));
accept("10.0.0.2", 12, 1, .9);
ASSERT(table.getRouteEntries().at(destination).current.sequence == 13);
accept("10.0.0.2", 14, 1, 1);
ASSERT(table.getRouteEntries().at(destination).current.metric == 2);
ASSERT(DsdvTable::isValidEntry(entry("10.0.0.4", 2, INT_MAX)));
ASSERT(!DsdvTable::isValidHeader(*update("10.0.0.2", {entry("10.0.0.4", 2, INT_MAX)})));
ASSERT(DsdvTable::isValidHeader(*update("10.0.0.2", {entry("10.0.0.4", 2, INT_MAX-1)})));
ASSERT(!DsdvTable::isValidEntry(entry("10.0.0.4", 2, uint32_t(INT_MAX)+1)));
ASSERT(!DsdvTable::isValidEntry(entry("10.0.0.4", 3, 1)));
ASSERT(!DsdvTable::isValidEntry(entry("10.0.0.4", 2, UINT32_MAX)));
ASSERT(DsdvTable::advance(UINT64_MAX-2, 2) == UINT64_MAX);
bool exhausted = false;
try { DsdvTable::advance(UINT64_MAX-1, 2); } catch (cRuntimeError&) { exhausted = true; }
ASSERT(exhausted);

auto h = update("10.0.0.2", {entry("10.0.0.4", 0x0102030405060708ULL, 2)});
h->setSelfSequence(0x0807060504030200ULL);
Packet output("wire", h);
auto bytes = output.peekAllAsBytes()->getBytes();
std::vector<uint8_t> expected = {1,1,0,1,10,0,0,2,8,7,6,5,4,3,2,0,
                               10,0,0,4,1,2,3,4,5,6,7,8,0,0,0,2};
ASSERT(bytes == expected);
Packet input("read", makeShared<BytesChunk>(bytes));
auto decoded = input.peekAtFront<DsdvHeader>(B(32));
ASSERT(DsdvTable::isValidHeader(*decoded));
ASSERT(DsdvTable::equal(decoded->getEntries(0), h->getEntries(0)));
for (int offset : {0, 1, 3, 4, 27}) {
    auto bad = expected; bad[offset] = 255;
    Packet packet("malformed", makeShared<BytesChunk>(bad));
    auto result = packet.peekAtFront<DsdvHeader>(B(32), Chunk::PF_ALLOW_INCORRECT);
    ASSERT(!result->isCorrect());
}
for (size_t size : {size_t(15), size_t(31), size_t(33)}) {
    auto bad = expected; bad.resize(size);
    Packet packet("length", makeShared<BytesChunk>(bad));
    auto result = packet.peekAtFront<DsdvHeader>(B(size), Chunk::PF_ALLOW_INCORRECT);
    ASSERT(!result->isCorrect());
}
auto duplicate = update("10.0.0.2", {entry("10.0.0.4", 2, 1),entry("10.0.0.4", 2, 1)});
ASSERT(!DsdvTable::isValidHeader(*duplicate));
for (const char *address : {"0.0.0.0", "127.0.0.1", "224.0.0.1", "255.255.255.255"})
    ASSERT(!DsdvTable::isHost(Ipv4Address(address)));
// Independent v2 oracle: the v1 fields stay in order, then one flags byte.
auto capability = entry("10.0.0.4",0x0102030405060708ULL,2);
capability.defaultCapability = true;
auto second = update("10.0.0.2",{capability});
second->setVersion(2); second->setSelfSequence(0x0807060504030200ULL); second->setChunkLength(B(33));
Packet output2("wire v2",second);
auto expected2 = expected; expected2[0]=2; expected2.push_back(1);
ASSERT(output2.peekAllAsBytes()->getBytes() == expected2);
Packet input2("read v2",makeShared<BytesChunk>(expected2));
auto decoded2 = input2.peekAtFront<DsdvHeader>(B(33));
ASSERT(DsdvTable::isValidHeader(*decoded2) && decoded2->getEntries(0).defaultCapability);
ASSERT(DsdvTable::equal(decoded2->getEntries(0),capability));
for (uint8_t flag : {uint8_t(2),uint8_t(3),uint8_t(255)}) {
    auto bad=expected2; bad[32]=flag;
    Packet packet("reserved flags",makeShared<BytesChunk>(bad));
    ASSERT(!packet.peekAtFront<DsdvHeader>(B(33),Chunk::PF_ALLOW_INCORRECT)->isCorrect());
}
for (size_t size : {size_t(32),size_t(34)}) {
    auto bad=expected2; bad.resize(size);
    Packet packet("v2 length",makeShared<BytesChunk>(bad));
    ASSERT(!packet.peekAtFront<DsdvHeader>(B(size),Chunk::PF_ALLOW_INCORRECT)->isCorrect());
}
auto impossible=expected2;
impossible[27]=9;
for (int i=28;i<32;i++) impossible[i]=255;
Packet invalidCapability("infinite capability",makeShared<BytesChunk>(impossible));
ASSERT(!invalidCapability.peekAtFront<DsdvHeader>(B(33),Chunk::PF_ALLOW_INCORRECT)->isCorrect());
bool rejectedCapability=false;
try {
    Packet legacy("legacy capability",update("10.0.0.2",{capability}));
    legacy.peekAllAsBytes();
}
catch (cRuntimeError&) { rejectedCapability=true; }
ASSERT(rejectedCapability);
ASSERT(DsdvTable::getEntryBytes(1)==16 && DsdvTable::getEntryBytes(2)==17 && DsdvTable::getEntryBytes(99)==0);
EV << "DSDV foundation PASS\n";

%contains: stdout
DSDV foundation PASS
