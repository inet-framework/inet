%description:
Check pure NIST and Yans HT20 range probabilities before receiver activation.
The matrix uses the existing DATA calculation as an independent result.
Mode support, minimum and mean SNIR, and random draw counts remain explicit.

%includes:
#include "inet/physicallayer/wireless/ieee80211/packetlevel/errormodel/Ieee80211NistErrorModel.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/errormodel/Ieee80211YansErrorModel.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"
#include "inet/physicallayer/wireless/common/base/packetlevel/SnirBase.h"

using namespace inet;
using namespace inet::physicallayer;

class ProbabilitySnir : public SnirBase {
    double value;
  public:
    ProbabilitySnir(double value) : SnirBase(nullptr, nullptr), value(value) {}
    double getMin() const override { return value; }
    double getMax() const override { return 2 * value; }
    double getMean() const override { return 1.5 * value; }
};

template<typename Base> class ProbabilityProbe : public Base {
  public:
    void check() {
        Enter_Method("check");
        auto draws = this->getRNG(0)->getNumbersDrawn();
        auto catalog = Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)");
        int checked = 0;
        ASSERT(!this->supportsAmpduMode(nullptr));
        for (bool mean : {false, true}) {
            this->snirMode = mean ? Base::SnirMode::SM_MEAN : Base::SnirMode::SM_MIN;
            for (int i = 0; i < catalog->getNumModes(); i++) {
                auto mode = catalog->getMode(i);
                bool supported = mode->getHtMcsIndex() >= 0 && mode->getHtMcsIndex() <= 31 && mode->getDataMode()->getBandwidth() == MHz(20);
                ASSERT(this->supportsAmpduMode(mode) == supported);
                if (!supported) continue;
                for (double value : {0.01, 0.1, 1.0, 3.0, 10.0, 100.0, 1000.0}) {
                    ProbabilitySnir snir(value);
                    for (int length : {4, 100, 101, 102, 4095, 65535}) {
                        double expected = Base::getDataSuccessRate(mode, length * 8, mean ? 1.5 * value : value);
                        double actual = Base::computeAmpduRangeSuccessRate(&snir, mode, B(length));
                        ASSERT(actual == expected && actual >= 0 && actual <= 1);
                        checked++;
                    }
                }
            }
        }
        ASSERT(checked == 2 * 64 * 7 * 6);
        ASSERT(this->getRNG(0)->getNumbersDrawn() == draws);
    }
};
class PureNist : public ProbabilityProbe<Ieee80211NistErrorModel> {};
class PureYans : public ProbabilityProbe<Ieee80211YansErrorModel> {};
Define_Module(PureNist);
Define_Module(PureYans);

%file: TestNetwork.ned
import inet.physicallayer.wireless.ieee80211.packetlevel.errormodel.Ieee80211NistErrorModel;
import inet.physicallayer.wireless.ieee80211.packetlevel.errormodel.Ieee80211YansErrorModel;
module PureNist extends Ieee80211NistErrorModel { parameters: @class(::PureNist); }
module PureYans extends Ieee80211YansErrorModel { parameters: @class(::PureYans); }
network TestNetwork {
    submodules:
        test: Test;
        nist: PureNist;
        yans: PureYans;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
ned-path = .;../../../../src;../../lib
seed-set = 0
record-vector-results = false
record-scalar-results = false

%activity:
check_and_cast<PureNist *>(getModuleByPath("nist"))->check();
check_and_cast<PureYans *>(getModuleByPath("yans"))->check();
EV << "Pure probability checks passed.\n";

%contains: stdout
Pure probability checks passed.
