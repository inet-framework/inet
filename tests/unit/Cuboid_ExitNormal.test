%description:
Test the entry and exit normals of Cuboid::computeIntersection. Both are outward
normals of the faces where the segment enters and leaves the box. The exit normal
used the formula of the entry normal, so it was the zero vector for a segment with
a zero direction component and the unit vector of a wrong face otherwise.

%includes:
#include <cmath>
#include "inet/common/geometry/object/LineSegment.h"
#include "inet/common/geometry/shape/Cuboid.h"

%global:

using namespace inet;

static int failures = 0;

static bool same(const Coord& a, const Coord& b)
{
    return std::fabs(a.x - b.x) < 1e-9 && std::fabs(a.y - b.y) < 1e-9 && std::fabs(a.z - b.z) < 1e-9;
}

static void check(const char *name, const Coord& size, const Coord& p1, const Coord& p2,
                  const Coord& expectedIntersection1, const Coord& expectedNormal1,
                  const Coord& expectedIntersection2, const Coord& expectedNormal2)
{
    Cuboid cuboid(size);
    LineSegment segment(p1, p2);
    Coord intersection1, intersection2, normal1, normal2;
    bool hit = cuboid.computeIntersection(segment, intersection1, intersection2, normal1, normal2);
    bool ok = hit && same(intersection1, expectedIntersection1) && same(normal1, expectedNormal1) &&
              same(intersection2, expectedIntersection2) && same(normal2, expectedNormal2);
    if (!ok) {
        EV << "FAILED: " << name << ": hit=" << hit << " intersection1=" << intersection1 << " normal1=" << normal1
           << " intersection2=" << intersection2 << " normal2=" << normal2 << endl;
        failures++;
    }
}

static void checkMiss(const char *name, const Coord& size, const Coord& p1, const Coord& p2)
{
    Cuboid cuboid(size);
    Coord intersection1, intersection2, normal1, normal2;
    if (cuboid.computeIntersection(LineSegment(p1, p2), intersection1, intersection2, normal1, normal2)) {
        EV << "FAILED: " << name << ": unexpected hit" << endl;
        failures++;
    }
}

%activity:

const Coord box(2, 2, 2);
const Coord NIL = Coord::NIL;

// axis-aligned segments (zero direction components)
check("along +x", box, Coord(-3, 0, 0), Coord(3, 0, 0), Coord(-1, 0, 0), Coord(-1, 0, 0), Coord(1, 0, 0), Coord(1, 0, 0));
check("along -x", box, Coord(3, 0, 0), Coord(-3, 0, 0), Coord(1, 0, 0), Coord(1, 0, 0), Coord(-1, 0, 0), Coord(-1, 0, 0));
check("along +y", box, Coord(0.2, -3, 0.3), Coord(0.2, 3, 0.3), Coord(0.2, -1, 0.3), Coord(0, -1, 0), Coord(0.2, 1, 0.3), Coord(0, 1, 0));
check("along -z", box, Coord(0, 0, 3), Coord(0, 0, -3), Coord(0, 0, 1), Coord(0, 0, 1), Coord(0, 0, -1), Coord(0, 0, -1));

// horizontal segments (zero z component), entry and exit on the same and on different faces
check("horizontal, x face in, x face out", box, Coord(-3, -0.5, 0), Coord(3, 0.5, 0),
      Coord(-1, -1.0 / 6, 0), Coord(-1, 0, 0), Coord(1, 1.0 / 6, 0), Coord(1, 0, 0));
check("horizontal, x face in, y face out", box, Coord(-3, -0.5, 0), Coord(0.5, 2, 0),
      Coord(-1, 13.0 / 14, 0), Coord(-1, 0, 0), Coord(-0.9, 1, 0), Coord(0, 1, 0));
check("horizontal, y face in, x face out", box, Coord(-0.5, -3, 0.4), Coord(2, 2, 0.4),
      Coord(0.5, -1, 0.4), Coord(0, -1, 0), Coord(1, 0, 0.4), Coord(1, 0, 0));

// diagonal segments (all direction components nonzero)
check("diagonal, z face in, z face out", box, Coord(-0.5, -0.2, -3), Coord(0.5, 0.3, 3),
      Coord(-0.5 + 2.0 / 6, -0.2 + 2.0 / 6 * 0.5, -1), Coord(0, 0, -1), Coord(-0.5 + 4.0 / 6, -0.2 + 4.0 / 6 * 0.5, 1), Coord(0, 0, 1));
check("diagonal, x face in, y face out", box, Coord(-3, -0.5, -0.2), Coord(0.5, 2, 0.2),
      Coord(-1, 13.0 / 14, -0.2 + 0.4 * (2.0 / 3.5)), Coord(-1, 0, 0), Coord(-0.9, 1, -0.2 + 0.4 * (2.1 / 3.5)), Coord(0, 1, 0));
check("diagonal, x face in, x face out", box, Coord(-3, -0.5, -0.3), Coord(3, 0.5, 0.3),
      Coord(-1, -1.0 / 6, -0.1), Coord(-1, 0, 0), Coord(1, 1.0 / 6, 0.1), Coord(1, 0, 0));
check("diagonal through a wall, y face in, y face out", Coord(10, 0.3, 3), Coord(-2, -5, -0.5), Coord(3, 5, 1.0),
      Coord(0.425, -0.15, 0.2275), Coord(0, -1, 0), Coord(0.575, 0.15, 0.2725), Coord(0, 1, 0));
check("diagonal, all negative", box, Coord(3, 2, 1), Coord(-3, -2, -1),
      Coord(1, 2.0 / 3, 1.0 / 3), Coord(1, 0, 0), Coord(-1, -2.0 / 3, -1.0 / 3), Coord(-1, 0, 0));

// a segment that starts or ends inside has no normal at that end
{
    Cuboid cuboid(box);
    Coord i1, i2, n1, n2;
    bool hit = cuboid.computeIntersection(LineSegment(Coord(0, 0, 0), Coord(3, 0, 0)), i1, i2, n1, n2);
    if (!hit || !same(i1, Coord(0, 0, 0)) || !n1.isUnspecified() || !same(i2, Coord(1, 0, 0)) || !same(n2, Coord(1, 0, 0))) {
        EV << "FAILED: segment starting inside" << endl;
        failures++;
    }
    hit = cuboid.computeIntersection(LineSegment(Coord(-3, 0, 0), Coord(0, 0, 0)), i1, i2, n1, n2);
    if (!hit || !same(i1, Coord(-1, 0, 0)) || !same(n1, Coord(-1, 0, 0)) || !same(i2, Coord(0, 0, 0)) || !n2.isUnspecified()) {
        EV << "FAILED: segment ending inside" << endl;
        failures++;
    }
}

checkMiss("segment beside the box", box, Coord(-3, 2, 0), Coord(3, 2, 0));
checkMiss("segment too short", box, Coord(-5, 0, 0), Coord(-3, 0, 0));

EV << "failures=" << failures << endl;
EV << "done" << endl;

%contains: stdout
failures=0
done

%not-contains: stdout
FAILED
