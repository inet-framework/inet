%description:
Check explicit Compressed receipt state independently of the delivery buffer.
Absent positions remain zero after delivery, window movement, and sequence wrap.
The preceding receipt remains available for the individual-MPDU release condition.
These checks do not establish HCF interframe recognition.

%includes:
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckAgreement.h"
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckProcedure.h"
#include "inet/linklayer/ieee80211/mac/blockackreordering/BlockAckReordering.h"

using namespace inet;
using namespace inet::ieee80211;

class ReceiptProcedure : public RecipientBlockAckProcedure {
  public:
    using RecipientBlockAckProcedure::buildBlockAck;
};

%activity:
const MacAddress peer("02:00:00:00:00:02");
for (int start : {100, 4094}) {
    RecipientBlockAckAgreement agreement(peer, 5, SequenceNumberCyclic(start), 4, SIMTIME_ZERO);
    agreement.setVariant(BlockAckVariant::COMPRESSED);
    auto record = agreement.getBlockAckRecord();
    auto bar = makeShared<Ieee80211CompressedBlockAckReq>();
    bar->setTransmitterAddress(peer);
    bar->setTidInfo(5);
    bar->setStartingSequenceNumber(SequenceNumberCyclic(start));
    ReceiptProcedure procedure;
    auto response = dynamicPtrCast<Ieee80211CompressedBlockAck>(procedure.buildBlockAck(bar, &agreement));
    ASSERT(response != nullptr && response->getChunkLength() == B(28));
    ASSERT(response->getBlockAckBitmap().getSize() == 64);
    for (int bit = 0; bit < 64; bit++)
        ASSERT(!response->getBlockAckBitmap().getBit(bit));
    auto data = makeShared<Ieee80211DataHeader>();
    data->setType(ST_DATA_WITH_QOS);
    data->setTransmitterAddress(peer);
    data->setTid(5);
    data->setAckPolicy(NORMAL_ACK);
    data->setSequenceNumber(SequenceNumberCyclic(start));
    record->compressedFrameReceived(data);
    ASSERT(record->getCompressedAckState(SequenceNumberCyclic(start)));
    ASSERT(!record->getCompressedAckState(SequenceNumberCyclic(start) - 1));
    // Delivery and Basic compatibility cleanup must not erase Compressed receipt truth.
    record->removeAckStates(SequenceNumberCyclic(start) + 1);
    ASSERT(record->getCompressedAckState(SequenceNumberCyclic(start)));
    data->setSequenceNumber(SequenceNumberCyclic(start) + 4);
    record->compressedFrameReceived(data);
    ASSERT(record->getWindowStart() == SequenceNumberCyclic(start) + 1);
    ASSERT(record->hasCompleteReceipt(SequenceNumberCyclic(start)));
    ASSERT(!record->getCompressedAckState(SequenceNumberCyclic(start)));
    response = dynamicPtrCast<Ieee80211CompressedBlockAck>(procedure.buildBlockAck(bar, &agreement));
    ASSERT(response->getStartingSequenceNumber() == SequenceNumberCyclic(start) + 1);
    for (int bit = 0; bit < 64; bit++)
        ASSERT(response->getBlockAckBitmap().getBit(bit) == (bit == 3));
    record->advanceCompressedWindow(SequenceNumberCyclic(start) + 5);
    ASSERT(record->hasCompleteReceipt(SequenceNumberCyclic(start) + 4));
    ASSERT(!record->hasCompleteReceipt(SequenceNumberCyclic(start)));
    record->advanceCompressedWindow(SequenceNumberCyclic(start) + 8);
    ASSERT(!record->hasCompleteReceipt(SequenceNumberCyclic(start) + 4));
    for (int bit = 0; bit < 64; bit++)
        ASSERT(!record->getCompressedAckState(SequenceNumberCyclic(start) + 8 + bit));
    // An old BAR must preserve the current scoreboard start.
    record->advanceCompressedWindow(SequenceNumberCyclic(start));
    ASSERT(record->getWindowStart() == SequenceNumberCyclic(start) + 8);
}
EV << "Compressed receipt state checks passed.\n";

%contains: stdout
Compressed receipt state checks passed.
