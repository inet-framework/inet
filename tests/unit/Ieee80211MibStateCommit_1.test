%description:
Check combined HT and rate publication, duplicate updates, HT removal,
unknown peer rates, invalid input, local-state retention, and replacement
records installed by a callback.

%includes:
#include <functional>
#include "inet/linklayer/ieee80211/mib/Ieee80211Mib.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;
namespace Ieee80211MibStateCommit_1 {
class Observer : public cListener {
  public:
    int notifications = 0;
    std::function<void()> check;
    void receiveSignal(cComponent *, simsignal_t id, bool value, cObject *details) override {
        ASSERT(id == Ieee80211Mib::rateStateChangedSignal && value && details == nullptr);
        notifications++;
        if (check)
            check();
    }
};
}

%file: TestNetwork.ned
import inet.linklayer.ieee80211.mib.Ieee80211Mib;
network TestNetwork { submodules: mib: Ieee80211Mib; test: Test; }

%inifile: omnetpp.ini
[General]
network = TestNetwork
ned-path = .;../../../../src;../../lib
seed-set = 0
record-vector-results = false
record-scalar-results = false

%activity:
using namespace Ieee80211MibStateCommit_1;
auto mib = check_and_cast<Ieee80211Mib *>(getModuleByPath("mib"));
mib->setPrimaryChannel(1);
mib->updateLocalHtCapabilities(Ieee80211ModeSet::getModeSet("n(mixed-2.4Ghz)"), {MHz(20)}, 1);
auto capabilities = mib->localHtCapabilities;
auto operation = mib->getHtOperation();
const MacAddress peer("02:00:00:00:00:01");
Ieee80211RateSetState rates;
rates.supported.known = true;
rates.supported.legacyRates.insert(Mbps(6));
rates.basic = rates.operational = rates.supported;
mib->setLocalRateSet(rates);
Observer observer;
mib->subscribe(Ieee80211Mib::rateStateChangedSignal, &observer);
bool expectHt = true;
Ieee80211RateSetState expectedRates = rates;
observer.check = [&]() {
    ASSERT(mib->getLocalRateSet() == rates);
    ASSERT(mib->getBssRateSet() == expectedRates);
    ASSERT(mib->findPeerRateSet(peer) != nullptr);
    ASSERT(*mib->findPeerRateSet(peer) == expectedRates);
    auto ht = mib->findPeerHtState(peer);
    ASSERT((ht != nullptr) == expectHt);
    if (ht != nullptr)
        ASSERT(ht->advertisedCapabilities == capabilities);
};
auto install = [&]() {
    mib->installBssAndPeerState(expectedRates, peer, expectedRates, expectHt ? &capabilities : nullptr, operation);
};
install();
ASSERT(observer.notifications == 1);
install();
ASSERT(observer.notifications == 1);
capabilities.shortGi20 = !capabilities.shortGi20;
install();
ASSERT(observer.notifications == 2);
expectedRates.supported.legacyRates.insert(Mbps(12));
expectedRates.operational = expectedRates.supported;
install();
ASSERT(observer.notifications == 3);
expectHt = false;
install();
ASSERT(observer.notifications == 4);
install();
ASSERT(observer.notifications == 4);
expectedRates = Ieee80211RateSetState();
install();
ASSERT(observer.notifications == 5);
ASSERT(!mib->findPeerRateSet(peer)->operational.known);

auto invalid = rates;
invalid.operational.legacyRates.insert(Mbps(0));
bool rejected = false;
try {
    mib->installBssAndPeerState(rates, peer, invalid, &capabilities, operation);
}
catch (const cRuntimeError&) { rejected = true; }
ASSERT(rejected && observer.notifications == 5);
observer.check();
mib->localHtCapabilitiesValid = false;
rejected = false;
try {
    mib->installBssAndPeerState(rates, peer, rates, &capabilities, operation);
}
catch (const cRuntimeError&) { rejected = true; }
ASSERT(rejected && observer.notifications == 5);
observer.check();
mib->localHtCapabilitiesValid = true;

bool replaced = false;
observer.check = [&]() {
    if (replaced)
        return;
    ASSERT(mib->findPeerHtState(peer) != nullptr);
    ASSERT(mib->getBssRateSet() == rates);
    ASSERT(*mib->findPeerRateSet(peer) == rates);
    replaced = true;
    mib->installBssAndPeerState(Ieee80211RateSetState(), peer, Ieee80211RateSetState(), nullptr, operation);
};
mib->installBssAndPeerState(rates, peer, rates, &capabilities, operation);
ASSERT(mib->findPeerHtState(peer) == nullptr);
ASSERT(mib->findPeerRateSet(peer) != nullptr && !mib->findPeerRateSet(peer)->operational.known);
ASSERT(mib->getBssRateSet() == Ieee80211RateSetState());
mib->unsubscribe(Ieee80211Mib::rateStateChangedSignal, &observer);
EV << "Combined HT and rate state commit checks passed.\n";

%contains: stdout
Combined HT and rate state commit checks passed.
